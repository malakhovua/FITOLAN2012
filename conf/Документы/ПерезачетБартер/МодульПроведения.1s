Перем тбПерезачет;
Перем ФлагОтгрузкиПоставщиков, ФлагОтгрузкиПокупателей;
Перем СчетАвансаПоставщика, СчетАвансаПокупателя;
Перем тбДолгиПокупателей, тбДолгиПоставщиков;
Перем ВремРегистрыПоставщика, ВремРегистрыПокупателя, РегПокупатели, РегПоставщики;

// ===========================
Функция ПроверкаШапки()
    глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
	глВыбранЛи(Валюта,               "Валюта");
    глВыбранЛи(Поставщик,            "Поставщик");
	глВыбранЛи(Покупатель,           "Покупатель");
    глВыбранЛи(РегистрПоставщика,    "Регистр долга поставщика");
    глВыбранЛи(РегистрПокупателя,    "Регистр долга покупателя");
	Если глВсеВыбрано = 1 Тогда
		глВсеВыбрано = глПроверкаДублейСтрок(Контекст,1);
	КонецЕсли;
    Если Итог("СуммаВалПоставщик") <> Итог("СуммаВалПокупатель") Тогда
        глКомментарий("Не совпадают суммы долга поставщика и покупателя. Перезачет невозможен.");
		глВсеВыбрано = 0;
	КонецЕсли;
    Возврат глВсеВыбрано;
КонецФункции

// ===========================
Функция ПроверкаСтроки()
    глВсеВыбрано = 1;
	глВыбранЛи(ВидКонтрагента,"Вид контрагента",НомерСтроки);
	глВыбранЛи(СчетУчета,     "Счет учета",     НомерСтроки);
	глВыбранЛи(ВидНДССтроки,  "СтавкаНДС",      НомерСтроки);
    
	Если глВсеВыбрано = 1 Тогда
	    Если ВидКонтрагента = Перечисление.ВидыКлиентов.Поставщик Тогда
			глВыбранЛи(СуммаВалПоставщик,"Сумма поставщика в валюте",НомерСтроки);
			глВыбранЛи(СуммаГрнПоставщик,"Сумма поставщика в гривнях",НомерСтроки);
		ИначеЕсли ВидКонтрагента = Перечисление.ВидыКлиентов.Покупатель Тогда
			глВыбранЛи(СуммаВалПокупатель,"Сумма покупателя в валюте",НомерСтроки);
			глВыбранЛи(СуммаГрнПокупатель,"Сумма покупателя в гривнях",НомерСтроки);
	    КонецЕсли;
	КонецЕсли;
	
    Возврат глВсеВыбрано;
КонецФункции

// ===============================
Процедура РассчитатьШапку()
	глТаблицаСчетов.УдалитьСтроки();
	//для распределения заказов
	тбПерезачет = СоздатьОбъект("ТаблицаЗначений");

	тбПерезачет.НоваяКолонка("НомерСтрокиПоставщика");
	тбПерезачет.НоваяКолонка("ДоговорПоставщика");
	тбПерезачет.НоваяКолонка("СчетПоставщика");
	тбПерезачет.НоваяКолонка("СчетУчетаПоставщика");
	тбПерезачет.НоваяКолонка("ВидНДСПоставщика");
	
	тбПерезачет.НоваяКолонка("НомерСтрокиПокупателя");
	тбПерезачет.НоваяКолонка("ДоговорПокупателя");
	тбПерезачет.НоваяКолонка("СчетПокупателя");
	тбПерезачет.НоваяКолонка("СчетУчетаПокупателя");
	тбПерезачет.НоваяКолонка("ВидНДСПокупателя");

	тбПерезачет.НоваяКолонка("СуммаВал");
	тбПерезачет.НоваяКолонка("СуммаГрн");
	тбПерезачет.НоваяКолонка("СуммаНДСПоставщика");
	тбПерезачет.НоваяКолонка("СуммаНДСПокупателя");
КонецПроцедуры

// Перераспределяет заказы поставщика и покупателя между собой
// ===============================
Процедура РаспределитьЗаказы(тбПерезачет)	                      

	тбПоставщик = СоздатьОбъект("ТаблицаЗначений");
	тбПоставщик.НоваяКолонка("НомерСтрокиПоставщика");
	тбПоставщик.НоваяКолонка("ДоговорПоставщика");
	тбПоставщик.НоваяКолонка("СчетПоставщика");
	тбПоставщик.НоваяКолонка("СчетУчетаПоставщика");
	тбПоставщик.НоваяКолонка("ВидНДСПоставщика");
	тбПоставщик.НоваяКолонка("СуммаВал");
	тбПоставщик.НоваяКолонка("СуммаГрн");

	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		//разделим заказы покупателя и поставщика
		Если ВидКонтрагента = Перечисление.ВидыКлиентов.Покупатель Тогда
		    тбПерезачет.НоваяСтрока();
		    тбПерезачет.НомерСтрокиПокупателя = НомерСтроки;
		    тбПерезачет.ДоговорПокупателя     = Договор;
		    тбПерезачет.СчетПокупателя        = Счет;
		    тбПерезачет.СчетУчетаПокупателя   = СчетУчета;
			тбПерезачет.ВидНДСПокупателя      = ВидНДССтроки;
			тбПерезачет.СуммаВал              = СуммаВалПокупатель;
			тбПерезачет.СуммаГрн              = СуммаГрнПокупатель;
		Иначе
			тбПоставщик.НоваяСтрока();
			тбПоставщик.НомерСтрокиПоставщика = НомерСтроки;
			тбПоставщик.ДоговорПоставщика     = Договор;
			тбПоставщик.СчетПоставщика        = Счет;
		    тбПоставщик.СчетУчетаПоставщика   = СчетУчета;
			тбПоставщик.ВидНДСПоставщика      = ВидНДССтроки;
			тбПоставщик.СуммаВал              = СуммаВалПоставщик;
			тбПоставщик.СуммаГрн              = СуммаГрнПоставщик;
		КонецЕсли;
	КонецЦикла;      

	НомСтрПоставщик = 1;
	НомСтрПерезачет = 1;
	
	//теперь "разбросаем" заказы поставщика по заказам покупателя
	Пока НомСтрПоставщик <= тбПоставщик.КоличествоСтрок() Цикл
		тбПоставщик.ПолучитьСтрокуПоНомеру(НомСтрПоставщик);
		тбПерезачет.ПолучитьСтрокуПоНомеру(НомСтрПерезачет);
		
		СуммаЗачета    = Мин(тбПерезачет.СуммаВал,тбПоставщик.СуммаВал);
		СуммаЗачетаГрн = Окр(тбПерезачет.СуммаГрн * СуммаЗачета/тбПерезачет.СуммаВал,2);
		
		// делаем зачет
		Если СуммаЗачета < тбПерезачет.СуммаВал Тогда
			
			_НомерСтрокиПокупателя = тбПерезачет.НомерСтрокиПокупателя;
			_ДоговорПокупателя     = тбПерезачет.ДоговорПокупателя;
			_СчетПокупателя        = тбПерезачет.СчетПокупателя;
			_СчетУчетаПокупателя   = тбПерезачет.СчетУчетаПокупателя;
			_ВидНДСПокупателя      = тбПерезачет.ВидНДСПокупателя;
		    _СуммаВал              = тбПерезачет.СуммаВал - СуммаЗачета;
		    _СуммаГрн              = тбПерезачет.СуммаГрн - СуммаЗачетаГрн;
			
			тбПерезачет.НомерСтрокиПоставщика = тбПоставщик.НомерСтрокиПоставщика;
			тбПерезачет.ДоговорПоставщика     = тбПоставщик.ДоговорПоставщика;
			тбПерезачет.СчетПоставщика        = тбПоставщик.СчетПоставщика;
			тбПерезачет.СчетУчетаПоставщика   = тбПоставщик.СчетУчетаПоставщика;
			тбПерезачет.ВидНДСПоставщика      = тбПоставщик.ВидНДСПоставщика;
			тбПерезачет.СуммаВал              = СуммаЗачета;
			тбПерезачет.СуммаГрн              = СуммаЗачетаГрн;
			
			тбПерезачет.НоваяСтрока(НомСтрПерезачет + 1);
			тбПерезачет.НомерСтрокиПокупателя = _НомерСтрокиПокупателя;
			тбПерезачет.ДоговорПокупателя     = _ДоговорПокупателя;
			тбПерезачет.СчетПокупателя        = _СчетПокупателя;
			тбПерезачет.СчетУчетаПокупателя   = _СчетУчетаПокупателя;
			тбПерезачет.ВидНДСПокупателя      = _ВидНДСПокупателя;
			тбПерезачет.СуммаВал              = _СуммаВал;
			тбПерезачет.СуммаГрн              = _СуммаГрн;
			
		Иначе
			тбПерезачет.НомерСтрокиПоставщика = тбПоставщик.НомерСтрокиПоставщика;
			тбПерезачет.ДоговорПоставщика     = тбПоставщик.ДоговорПоставщика;
			тбПерезачет.СчетПоставщика        = тбПоставщик.СчетПоставщика;
			тбПерезачет.СчетУчетаПоставщика   = тбПоставщик.СчетУчетаПоставщика;
			тбПерезачет.ВидНДСПоставщика      = тбПоставщик.ВидНДСПоставщика;
		КонецЕсли;
		
		тбПоставщик.СуммаВал = тбПоставщик.СуммаВал - СуммаЗачета;
		тбПоставщик.СуммаГрн = тбПоставщик.СуммаГрн - СуммаЗачетаГрн;
		
	    НомСтрПерезачет = НомСтрПерезачет + 1;
		Если НомСтрПерезачет > тбПерезачет.КоличествоСтрок() Тогда
		    Прервать;
		КонецЕсли;
		
		Если тбПоставщик.СуммаВал = 0 Тогда
		    НомСтрПоставщик = НомСтрПоставщик + 1;
		КонецЕсли;
	КонецЦикла;       
	
	//теперь рассчитаем суммы НДС
	НомСтрПерезачет = 1;
	Пока НомСтрПерезачет <= тбПерезачет.КоличествоСтрок() Цикл
		тбПерезачет.ПолучитьСтрокуПоНомеру(НомСтрПерезачет);
		тбПерезачет.СуммаНДСПокупателя = Окр(тбПерезачет.СуммаВал * глПроцентНДС(тбПерезачет.ВидНДСПокупателя,ДатаДок) / (100 + глПроцентНДС(тбПерезачет.ВидНДСПокупателя,ДатаДок)),2);
		тбПерезачет.СуммаНДСПоставщика = Окр(тбПерезачет.СуммаВал * глПроцентНДС(тбПерезачет.ВидНДСПоставщика,ДатаДок) / (100 + глПроцентНДС(тбПерезачет.ВидНДСПоставщика,ДатаДок)),2);
	    НомСтрПерезачет = НомСтрПерезачет + 1;
	КонецЦикла;       
	
КонецПроцедуры

// ===============================
// Назначение:
// Подготавливает регистры взаиморасчетов для проведения
Процедура РассчитатьВзаиморасчеты()
	тбДолгиПоставщиков = 0;
	тбДолгиПокупателей = 0;
	
	// Заполняем списки
	спДоговора = СоздатьОбъект("СписокЗначений");
	ВыгрузитьТабличнуюЧасть(спДоговора,"Договор");

	ВремРегистрыПоставщика = СоздатьОбъект("Регистры");	
	Если РегистрПоставщика = Перечисление.ВидыКлиентов.Поставщик Тогда
		РегПоставщики=ВремРегистрыПоставщика.ВзаиморасчетыПоставщиков;
	Иначе
		РегПоставщики=ВремРегистрыПоставщика.ВзаиморасчетыПокупателей;
	КонецЕсли;	
	РегПоставщики.УстановитьЗначениеФильтра("Фирма",		Фирма,	 		1);
	РегПоставщики.УстановитьЗначениеФильтра("Контрагент",	Поставщик,		1);
	РегПоставщики.УстановитьЗначениеФильтра("Договор",		спДоговора,		2);
	РегПоставщики.УстановитьЗначениеФильтра("Валюта",		Валюта,			1);
	                           
	ВремРегистрыПокупателя = СоздатьОбъект("Регистры");	
	Если РегистрПокупателя = Перечисление.ВидыКлиентов.Поставщик Тогда
		РегПокупатели=ВремРегистрыПокупателя.ВзаиморасчетыПоставщиков;
	Иначе     
		РегПокупатели=ВремРегистрыПокупателя.ВзаиморасчетыПокупателей;
	КонецЕсли;	
	РегПокупатели.УстановитьЗначениеФильтра("Фирма",		Фирма,			1);	
	РегПокупатели.УстановитьЗначениеФильтра("Контрагент",	Покупатель,		1);
	РегПокупатели.УстановитьЗначениеФильтра("Договор",		спДоговора,		2);
	РегПокупатели.УстановитьЗначениеФильтра("Валюта",		Валюта,			1);
	
	Если ИтогиАктуальны()=0 Тогда
		РегПокупатели.ВременныйРасчет();
		РегПоставщики.ВременныйРасчет();
		ВремРегистрыПоставщика.РассчитатьРегистрыНа(ТекущийДокумент());
		ВремРегистрыПокупателя.РассчитатьРегистрыНа(ТекущийДокумент());
	КонецЕсли;
	
	РегПоставщики.УстановитьЗначениеФильтра("Фирма",		Фирма,			1);
	РегПоставщики.УстановитьЗначениеФильтра("Контрагент",	Поставщик,		1);
	РегПоставщики.УстановитьЗначениеФильтра("Договор",		спДоговора,		2);
	РегПоставщики.УстановитьЗначениеФильтра("Валюта",		Валюта,			1);
	РегПоставщики.ВыгрузитьИтоги(тбДолгиПоставщиков,1,1);
	
	РегПокупатели.УстановитьЗначениеФильтра("Фирма",		Фирма,			1);
	РегПокупатели.УстановитьЗначениеФильтра("Контрагент",	Покупатель,		1);
	РегПокупатели.УстановитьЗначениеФильтра("Договор",		спДоговора,		2);
	РегПокупатели.УстановитьЗначениеФильтра("Валюта",		Валюта,			1);
	РегПокупатели.ВыгрузитьИтоги(тбДолгиПокупателей,1,1);
	
КонецПроцедуры //РассчитатьВзаиморасчеты

// ===============================
Процедура РассчитатьСтроку()      
	Если Валюта <> Гривня Тогда
		Если ВидКонтрагента = Перечисление.ВидыКлиентов.Поставщик Тогда
			// переоценим заказ поставщика
			глТаблицаСчетов.НоваяСтрока();
			глТаблицаСчетов.Счет            = СчетУчета;
			глТаблицаСчетов.Субконто1       = Поставщик;
			глТаблицаСчетов.Субконто2       = Договор;
			глТаблицаСчетов.Субконто3       = 0;
			глТаблицаСчетов.Валюта          = Валюта;
			глТаблицаСчетов.ОперационнаяКР  = 0;
			глТаблицаСчетов.ВидДеятельности = ПолучитьПустоеЗначение("Справочник.ВидыДеятельности");
			глТаблицаСчетов.СуммаОпер = СуммаВалПоставщик;
			глТаблицаСчетов.ДтКт = 1;
		Иначе
			// переоценим заказ покупателя
			глТаблицаСчетов.НоваяСтрока();
			глТаблицаСчетов.Счет            = СчетУчета;
			глТаблицаСчетов.Субконто1       = Покупатель;
			глТаблицаСчетов.Субконто2       = Договор;
			глТаблицаСчетов.Субконто3       = 0;
			глТаблицаСчетов.Валюта          = Валюта;
			глТаблицаСчетов.ОперационнаяКР  = 0;
			глТаблицаСчетов.ВидДеятельности = ПолучитьПустоеЗначение("Справочник.ВидыДеятельности");
			глТаблицаСчетов.СуммаОпер = СуммаВалПокупатель;
			глТаблицаСчетов.ДтКт = 2;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Функция ДвиженияВзаиморасчеты()
				
	глСохранитьЗначение(Контекст,"НомерСтроки",тбПерезачет.НомерСтроки);		
	СчетАвансаПоставщика = тбПерезачет.СчетУчетаПоставщика;		
	Если РегистрПоставщика = Перечисление.ВидыКлиентов.Поставщик Тогда
		ЗнакОплатыПоставщика = 1;
		ВидОплатыПоставщика  = ?(ВидДвиженияПоставщика=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                         Перечисление.ВидыОплаты.Возврат, Перечисление.ВидыОплаты.Оплата);
		КодыОперацийПоставщика = ?(ВидДвиженияПоставщика=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                           ВозвратАвансовойОплаты+ВозвратПостОплаты, АвансоваяОплата+ПостОплата);
		Если глВыделятьЛиАвансыПоСчету(тбПерезачет.СчетУчетаПоставщика) = 1 Тогда		
			СчетАвансаПоставщика = СчетПоКоду(?(Валюта=Гривня,"3711","3712"));
		КонецЕсли;      
	Иначе
		ЗнакОплатыПоставщика = -1;
		ВидОплатыПоставщика  = ?(ВидДвиженияПоставщика=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                         Перечисление.ВидыОплаты.Оплата,  Перечисление.ВидыОплаты.Возврат);
		КодыОперацийПоставщика = ?(ВидДвиженияПоставщика=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                           АвансоваяОплата+ПостОплата, ВозвратАвансовойОплаты+ВозвратПостОплаты);
		Если глВыделятьЛиАвансыПоСчету(тбПерезачет.СчетУчетаПоставщика) = 1 Тогда		
			СчетАвансаПоставщика = СчетПоКоду(?(Валюта=Гривня,"6811","6812"));
		КонецЕсли;
	КонецЕсли;
	ВДебетСчетаУчетаПоставщика = ЗнакОплатыПоставщика * ?(ВидОплатыПоставщика=Перечисление.ВидыОплаты.Возврат,1,-1);
	ПолучитьСтрокуПоНомеру(тбПерезачет.НомерСтрокиПоставщика);
	глПогашениеДолга(Контекст,ЗнакОплатыПоставщика,тбДолгиПоставщиков,Фирма,Поставщик,ВидОплатыПоставщика,
		тбПерезачет.СчетПоставщика,тбПерезачет.ДоговорПоставщика,
		?(ПустоеЗначение(тбПерезачет.СчетПоставщика)=1,Перечисление.РежимыОплаты.ПоДоговору,Перечисление.РежимыОплаты.ПоСчету),
		тбПерезачет.СуммаВал,тбПерезачет.СуммаНДСПоставщика,Валюта,тбПерезачет.ВидНДСПоставщика);
		
	СчетАвансаПокупателя = тбПерезачет.СчетУчетаПокупателя;		
	глСохранитьЗначение(Контекст,"НомерСтроки",тбПерезачет.НомерСтроки);		
	Если РегистрПокупателя = Перечисление.ВидыКлиентов.Поставщик Тогда
		ЗнакОплатыПокупателя = 1;
		ВидОплатыПокупателя  = ?(ВидДвиженияПокупателя=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                         Перечисление.ВидыОплаты.Возврат, Перечисление.ВидыОплаты.Оплата);
		КодыОперацийПокупателя = ?(ВидДвиженияПокупателя=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                           ВозвратАвансовойОплаты+ВозвратПостОплаты, АвансоваяОплата+ПостОплата);
		Если глВыделятьЛиАвансыПоСчету(тбПерезачет.СчетУчетаПокупателя) = 1 Тогда		
			СчетАвансаПокупателя = СчетПоКоду(?(Валюта=Гривня,"3711","3712"));
		КонецЕсли;
	Иначе
		ЗнакОплатыПокупателя = -1;
		ВидОплатыПокупателя  = ?(ВидДвиженияПокупателя=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
								 Перечисление.ВидыОплаты.Оплата,  Перечисление.ВидыОплаты.Возврат);
		КодыОперацийПокупателя = ?(ВидДвиженияПокупателя=Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,
		                           АвансоваяОплата+ПостОплата, ВозвратАвансовойОплаты+ВозвратПостОплаты);
		Если глВыделятьЛиАвансыПоСчету(тбПерезачет.СчетУчетаПокупателя) = 1 Тогда		
			СчетАвансаПокупателя = СчетПоКоду(?(Валюта=Гривня,"6811","6812"));
		КонецЕсли;
	КонецЕсли;
	ВДебетСчетаУчетаПокупателя = ЗнакОплатыПокупателя * ?(ВидОплатыПокупателя=Перечисление.ВидыОплаты.Возврат,1,-1);
	ПолучитьСтрокуПоНомеру(тбПерезачет.НомерСтрокиПокупателя);
	глПогашениеДолга(Контекст,ЗнакОплатыПокупателя,тбДолгиПокупателей,Фирма,Покупатель,ВидОплатыПокупателя,
		тбПерезачет.СчетПокупателя,тбПерезачет.ДоговорПокупателя,
		?(ПустоеЗначение(тбПерезачет.СчетПокупателя)=1,Перечисление.РежимыОплаты.ПоДоговору,Перечисление.РежимыОплаты.ПоСчету),
		тбПерезачет.СуммаВал,тбПерезачет.СуммаНДСПокупателя,Валюта,тбПерезачет.ВидНДСПокупателя);
		
	// для проверки одновременного возникновения первого события
	ПервоеСобытиеПоставщик  = 0; СуммаДолгаПоставщик  = 0;
	ПервоеСобытиеПокупатель = 0; СуммаДолгаПокупатель = 0;
	ПроводкаПоНДСПоставщик  = 0;
	
	// формирование проводок на основании движений по регистру		
	РегПоставщики.ВыбратьДвиженияДокумента(ТекущийДокумент());
	Пока РегПоставщики.ПолучитьДвижение() = 1 Цикл		
		// выбираем движения только по текущей строке перезачета по поставщику
		Если     (РегПоставщики.НомерСтроки() <> тбПерезачет.НомерСтроки)
		     Или (Найти(КодыОперацийПоставщика,РегПоставщики.КодОперации)=0) Тогда
			Продолжить;
		КонецЕсли;
		
		// Выбираем аналитику из регистра
		Если РегПоставщики.Валюта <> Гривня Тогда
			ВалютаПроводки = РегПоставщики.Валюта;
			СуммаВал       = РегПоставщики.Долг;
			СуммаГрн       = РегПоставщики.ДолгОсн;
		Иначе
			ВалютаПроводки = ПолучитьПустоеЗначение("Справочник.Валюты");
			СуммаВал       = 0;
			СуммаГрн       = РегПоставщики.Долг;
		КонецЕсли;
		Если ВидОплатыПоставщика = Перечисление.ВидыОплаты.Возврат Тогда
			СуммаВал = - СуммаВал;
			СуммаГрн = - СуммаГрн;
		КонецЕсли;	
		
		// подчиненная корреспонденция сложной проводки
		Если (РегПоставщики.КодОперации = АвансоваяОплата) Или (РегПоставщики.КодОперации = ВозвратПостОплаты) Тогда
			Если ВДебетСчетаУчетаПоставщика = 1 Тогда
				глПроводка(Контекст,,СчетАвансаПоставщика,СуммаГрн,"Перезачет",, ,,,
				РегПоставщики.Контрагент,РегПоставщики.Договор, ,ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,1);
			Иначе
				глПроводка(Контекст,СчетАвансаПоставщика,,СуммаГрн,"Перезачет",,РегПоставщики.Контрагент,РегПоставщики.Договор,,
				,,, ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,1);
			КонецЕсли;
		ИначеЕсли (РегПоставщики.КодОперации = ПостОплата) Или (РегПоставщики.КодОперации = ВозвратАвансовойОплаты) Тогда
			Если ВДебетСчетаУчетаПоставщика = 1 Тогда
				глПроводка(Контекст,,тбПерезачет.СчетУчетаПоставщика,СуммаГрн,"Перезачет",, ,,,
				РегПоставщики.Контрагент,РегПоставщики.Договор,, ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,1);
			Иначе
				глПроводка(Контекст,тбПерезачет.СчетУчетаПоставщика,,СуммаГрн,"Перезачет",,РегПоставщики.Контрагент,РегПоставщики.Договор,,
				,,, ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,1);
			КонецЕсли;
		КонецЕсли;

		Если (РегПоставщики.КодОперации = АвансоваяОплата) Или (РегПоставщики.КодОперации = ВозвратАвансовойОплаты) Тогда
			// возникает первое событие у поставщика
			ПервоеСобытиеПоставщик = 1;
			СуммаДолгаПоставщик = СуммаДолгаПоставщик + ?(Валюта = Гривня, СуммаГрн, СуммаВал);
		КонецЕсли;
		
	КонецЦикла; // по движениям регистра

	// формирование проводок на основании движений по регистру		
	РегПокупатели.ВыбратьДвиженияДокумента(ТекущийДокумент());
	Пока РегПокупатели.ПолучитьДвижение() = 1 Цикл		
		// выбираем движения только по текущей строке перезачета по покупателю
		Если     (РегПокупатели.НомерСтроки() <> тбПерезачет.НомерСтроки)
		     Или (Найти(КодыОперацийПокупателя,РегПокупатели.КодОперации)=0) Тогда
			Продолжить;
		КонецЕсли;
		
		// Выбираем аналитику из регистра
		Если РегПокупатели.Валюта <> Гривня Тогда
			ВалютаПроводки = РегПокупатели.Валюта;
			СуммаВал       = РегПокупатели.Долг;
			СуммаГрн       = РегПокупатели.ДолгОсн;
		Иначе
			ВалютаПроводки = ПолучитьПустоеЗначение("Справочник.Валюты");
			СуммаВал       = 0;
			СуммаГрн       = РегПокупатели.Долг;
		КонецЕсли;
		Если ВидОплатыПокупателя = Перечисление.ВидыОплаты.Возврат Тогда
			СуммаВал = - СуммаВал;
			СуммаГрн = - СуммаГрн;        
		КонецЕсли;	
		
		// подчиненная корреспонденция сложной проводки
		Если (РегПокупатели.КодОперации = АвансоваяОплата) Или (РегПокупатели.КодОперации = ВозвратПостОплаты) Тогда
			Если ВДебетСчетаУчетаПокупателя = 1 Тогда
				глПроводка(Контекст,,СчетАвансаПокупателя,СуммаГрн,"Перезачет",, ,,,
				РегПокупатели.Контрагент,РегПокупатели.Договор, ,ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,0);
			Иначе
				глПроводка(Контекст,СчетАвансаПокупателя,,СуммаГрн,"Перезачет",,РегПокупатели.Контрагент,РегПокупатели.Договор,,
				,,, ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,0);
			КонецЕсли;
		ИначеЕсли (РегПокупатели.КодОперации = ПостОплата) Или (РегПокупатели.КодОперации = ВозвратАвансовойОплаты) Тогда
			Если ВДебетСчетаУчетаПокупателя = 1 Тогда
				глПроводка(Контекст,,тбПерезачет.СчетУчетаПокупателя,СуммаГрн,"Перезачет",, ,,,
				РегПокупатели.Контрагент,РегПокупатели.Договор,, ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,0);
			Иначе
				глПроводка(Контекст,тбПерезачет.СчетУчетаПокупателя,,СуммаГрн,"Перезачет",,РегПокупатели.Контрагент,РегПокупатели.Договор,,
				,,, ВалютаПроводки,СуммаВал,"ВЗ",1,тбПерезачет.НомерСтроки,0);
			КонецЕсли;
		КонецЕсли;

		Если (РегПокупатели.КодОперации = АвансоваяОплата) Или (РегПокупатели.КодОперации = ВозвратАвансовойОплаты) Тогда
			// возникает первое событие у покупателя
			ПервоеСобытиеПокупатель = 1; 
			СуммаДолгаПокупатель = СуммаДолгаПокупатель + ?(Валюта = Гривня, СуммаГрн, СуммаВал);
		КонецЕсли;
		
	КонецЦикла; // по движениям регистра
	
	Если ПервоеСобытиеПоставщик = 1 Тогда
		глКомментарий(Шаблон("Сумма в строке [тбПерезачет.НомерСтрокиПоставщика] не распределилась по остаткам взаиморасчетов с поставщиком. Нераспределенный остаток  [СуммаДолгаПоставщик] [Валюта.Кратко]."),0,,"!");
		// это ошибка
		Возврат 0;
	ИначеЕсли ПервоеСобытиеПокупатель = 1 Тогда
	    Если РегистрПоставщика = РегистрПокупателя Тогда
			глКомментарий(Шаблон("Сумма в строке [тбПерезачет.НомерСтрокиПокупателя] не распределилась по остаткам взаиморасчетов с покупателем. Нераспределенный остаток [СуммаДолгаПокупатель] [Валюта.Кратко]."),0,,".");
			// это не ошибка
			Возврат 1;      
		Иначе
			глКомментарий(Шаблон("Сумма в строке [тбПерезачет.НомерСтрокиПокупателя] не распределилась по остаткам взаиморасчетов с покупателем. Нераспределенный остаток [СуммаДолгаПокупатель] [Валюта.Кратко]."),0,,"!");
			// это ошибка
			Возврат 0;      
	    КонецЕсли;
	Иначе
		Возврат 1;
	КонецЕсли;
	    
КонецФункции

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);
	глТбОперация.УдалитьСтроки();

	Если ПроверкаШапки()=0 Тогда
	    глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли;
	
	РассчитатьШапку();

	ВыбратьСтроки();
	Пока ПолучитьСтроку()=1 Цикл
		Если ПроверкаСтроки()=0 Тогда
		    глНеПроводить(Контекст);
		    Возврат;
		КонецЕсли;
		РассчитатьСтроку();
	КонецЦикла;
	
	РаспределитьЗаказы(тбПерезачет);		
    РассчитатьВзаиморасчеты();
	фОшибка = 0;
	тбПерезачет.ВыбратьСтроки();
	Пока тбПерезачет.ПолучитьСтроку()=1 Цикл
		Если ДвиженияВзаиморасчеты() = 0 Тогда
			фОшибка = 1;
		КонецЕсли;
	КонецЦикла;        
	Если фОшибка = 1 Тогда
		глНеПроводить(Контекст,"В заполнении табличной части документа обнаружены ошибки.");
	    Возврат;
	КонецЕсли;

	глЗаписатьПроводкиВОперацию(Контекст);
	
	Если Валюта <> Гривня Тогда
		Если (Константа.ДатаНачалаПереоценкиВалютыВПределахСуммыОперации > ДатаДок) Тогда
		    глПереоценкаСчетов(Контекст, глТаблицаСчетов);
		Иначе	
			// переоценка с учетом изменений в ПСБО №21 от 09.08.13   
		    глПереоценкаСчетовВПределахСуммыОперации(Контекст, глТаблицаСчетов);
		КонецЕсли;
	КонецЕсли;
	
	Операция.СуммаОперации = Итог("СуммаВалПоставщик");
	Операция.Содержание = Примечание;
	Операция.Записать();
	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры