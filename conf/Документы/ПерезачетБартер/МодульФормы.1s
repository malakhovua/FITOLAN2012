Перем ВидПокупатель, ВидПоставщик;
Перем НачальнаяДатаДокумента;
Перем ПрежнВидКонтрагента, ПрежнПокупатель, ПрежнПоставщик, ПрежнВиНДС;

// ===============================
Функция УстДоступность()
	
	Если ВидКонтрагента = ВидПоставщик Тогда
	    Форма.СуммаВалПоставщик.Доступность(1);
	    Форма.СуммаВалПокупатель.Доступность(0);
	Иначе
	    Форма.СуммаВалПоставщик.Доступность(0);
	    Форма.СуммаВалПокупатель.Доступность(1);
	КонецЕсли;         
	
	Если ВидНДС.Выбран() = 0 Тогда
	    Форма.ВидНДССтроки.Доступность(1);
	Иначе
	    Форма.ВидНДССтроки.Доступность(0);
	КонецЕсли;
	
    Форма.Заголовок(глЗаголовок(Контекст,"Взаимозачет"));	
	Возврат "";
КонецФункции
    
// ===============================
Процедура ВзаиморасчетыПоставщик()
	Если      РегистрПоставщика = ВидПокупатель Тогда
		глПоказатьДолг(Контекст, Поставщик, "Продажа");
	Иначе
		глПоказатьДолг(Контекст, Поставщик, "Закупка");
	КонецЕсли;
КонецПроцедуры     

// ===============================
Процедура ВзаиморасчетыПокупатель()
	Если      РегистрПокупателя = ВидПокупатель Тогда
		глПоказатьДолг(Контекст, Покупатель, "Продажа");
	Иначе
		глПоказатьДолг(Контекст, Покупатель, "Закупка");
	КонецЕсли;
КонецПроцедуры     

// ===============================
Процедура УстСчетПоВалюте(СчетУчета)                                                 
	Если СчетУчета.Выбран() = 1 Тогда
		КодСчета = СчетУчета.Код;
		Если Валюта = Гривня Тогда
		    Если      КодСчета = "362" Тогда
				СчетУчета = СчетПоКоду("361");
			ИначеЕсли КодСчета = "3774" Тогда
				СчетУчета = СчетПоКоду("3772");
			ИначеЕсли КодСчета = "632" Тогда
				СчетУчета = СчетПоКоду("631");
			ИначеЕсли КодСчета = "6854" Тогда
				СчетУчета = СчетПоКоду("6852");
			КонецЕсли;                   
		Иначе
		    Если      (КодСчета = "361") Или (КодСчета = "363") Тогда
				СчетУчета = СчетПоКоду("362");
			ИначеЕсли КодСчета = "3772" Тогда
				СчетУчета = СчетПоКоду("3774");
			ИначеЕсли (КодСчета = "631") Или (КодСчета = "633") Тогда
				СчетУчета = СчетПоКоду("632");
			ИначеЕсли КодСчета = "6852" Тогда
				СчетУчета = СчетПоКоду("6854");
			КонецЕсли;                   
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмСуммаВалПоставщик()                                                 
	Если Счет.Выбран() = 1 Тогда
		СуммаГрнПоставщик = глПересчет(СуммаВалПоставщик,Валюта,Гривня,Счет.ДатаДок);
	Иначе
		СуммаГрнПоставщик = глПересчет(СуммаВалПоставщик,Валюта,Гривня,Курс,ДатаДок);
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмСуммаВалПокупатель()
	Если Счет.Выбран() = 1 Тогда
		СуммаГрнПокупатель = глПересчет(СуммаВалПокупатель,Валюта,Гривня,Счет.ДатаДок);
	Иначе                                                                              
		СуммаГрнПокупатель = глПересчет(СуммаВалПокупатель,Валюта,Гривня,Курс,ДатаДок);
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура ОпределитьСуммыВал()
	Если ВидКонтрагента = ВидПоставщик Тогда
		СуммаВалПоставщик  = ?(ВидДвиженияПоставщика = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление,1,-1)
		                     * глДолгКонтрагента(Контекст, ?(РегистрПоставщика = ВидПоставщик,1,-1), Фирма, Поставщик, Договор, Счет, 1, ВидНДССтроки);
		СуммаВалПокупатель = 0;
	Иначе
		СуммаВалПоставщик  = 0;
		СуммаВалПокупатель = ?(ВидДвиженияПокупателя = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание,-1,1)
		                     * глДолгКонтрагента(Контекст, ?(РегистрПокупателя = ВидПоставщик,1,-1), Фирма, Покупатель, Договор, Счет, 1, ВидНДССтроки);
	КонецЕсли;
	ИзмСуммаВалПоставщик();
	ИзмСуммаВалПокупатель();
КонецПроцедуры

// ===============================
Процедура ИзмВидКонтрагента() 
	Если ВидКонтрагента = ПрежнВидКонтрагента Тогда
	    Возврат;
	КонецЕсли;
    СуммаВалПоставщик  = 0;
	СуммаГрнПоставщик  = 0;
    СуммаВалПокупатель = 0;
	СуммаГрнПокупатель = 0;
	Договор            = 0;
	Счет               = 0;
    СчетУчета             = ?(ВидКонтрагента=ВидПоставщик,СчетПоставщика,СчетПокупателя);
КонецПроцедуры
                                 
// ===============================
Процедура ИзмВидНДС()
	Если ВидНДС.Выбран()=0 Тогда
		ПрежнВиНДС = 0;
		Форма.ВидНДССтроки.Доступность(1);
		Возврат;
	КонецЕсли;

	Если ВидНДС = ПрежнВиНДС Тогда
		Возврат;
	КонецЕсли;

	Если КоличествоСтрок()>0 Тогда
		Если Вопрос("Вид НДС в табличной части будет изменен!","Да+Нет")="Нет" Тогда
			ВидНДС = ПрежнВиНДС;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВыбратьСтроки();
	Пока ПолучитьСтроку()=1 Цикл
		ВидНДССтроки = ВидНДС;
	КонецЦикла;
	ПрежнВиНДС = ВидНДС;   
	
	Форма.ВидНДССтроки.Доступность(0);
КонецПроцедуры

// ===============================
Процедура ПриРедактированииНовойСтроки()
	ПрежнВидКонтрагента = 0;
	ВидКонтрагента = ВидПокупатель;
	ИзмВидКонтрагента();      
	ВидНДССтроки = ВидНДС;
КонецПроцедуры

// ===============================
Процедура ПриНачалеРедактированияСтроки()
	глСохранитьЗначение(Контекст,"ВидКонтрагента", ВидКонтрагента);
КонецПроцедуры

// ===============================
Процедура ИзмПокупатель()
	Если Покупатель = ПрежнПокупатель Тогда
	    Возврат;
	КонецЕсли;
	
	Если ПустоеЗначение(Поставщик)=1 Тогда
	    Поставщик = Покупатель;
	КонецЕсли;
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если ВидКонтрагента = ВидПокупатель Тогда
			УдалитьСтроку();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// ===============================
Процедура ИзмПоставщик()
	Если Поставщик = ПрежнПоставщик Тогда
	    Возврат;
	КонецЕсли;
	
	Если ПустоеЗначение(Покупатель)=1 Тогда
	    Покупатель = Поставщик;
	КонецЕсли;
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если ВидКонтрагента = ВидПоставщик Тогда
			УдалитьСтроку();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры                  

// ===============================
Процедура ИзмВидВзаимозачета()
	
	Если ВидВзаимозачета.ТекущаяСтрока()=1 Тогда
		// Увеличить долг поставщика перед фирмой за счет уменьшения долга покупателя
		ВидДвиженияПоставщика = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание;
		ВидДвиженияПокупателя = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление;
	Иначе
		// Уменьшить долг поставщика перед фирмой за счет увеличения долга покупателя
		ВидДвиженияПоставщика = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление;
		ВидДвиженияПокупателя = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание;
	КонецЕсли;
	
КонецПроцедуры                  

// ===============================
Процедура ВыборОплаты()
	// Процедура по кнопке редактирования валюты в документе
	// Теперь запомним промежуточные переменные
	Валюта_Прежн    = Валюта;
	Курс_Прежн      = Курс;
	ДатаКурса_Прежн = Дата_Курса;
	ОткрытьФормуМодально("Обработка.ИнформацияОВалюте", Контекст);
	Если Валюта_Прежн <> Валюта Тогда
		Если КоличествоСтрок() > 0 Тогда
		    Если Вопрос("Очистить строки?","Да+Нет") = "Да" Тогда
				// удаляем все строки
		        УдалитьСтроки();
			Иначе
				Валюта     = Валюта_Прежн;
				Курс       = Курс_Прежн;
				Дата_Курса = ДатаКурса_Прежн;
				Возврат;
		    КонецЕсли;
		КонецЕсли;
		УстСчетПоВалюте(СчетПоставщика);
		УстСчетПоВалюте(СчетПокупателя);
	ИначеЕсли Курс_Прежн <> Курс Тогда
		ВыбратьСтроки();
		Пока ПолучитьСтроку() = 1 Цикл
			ИзмСуммаВалПокупатель();
			ИзмСуммаВалПоставщик();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	глПроверкаДатыДок(Контекст,"Открытие");
	НачальнаяДатаДокумента = ДатаДок;
	ПриЗаписиПерепроводить(1);
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кФирма.Доступность(0);               		
		Форма.кВалюта.Доступность(0);               		
		Форма.кХВидНДС.Доступность(0);
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли;                            
	Если ВидДвиженияПоставщика = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание Тогда
		ВидВзаимозачета.ТекущаяСтрока(1);
	Иначе
		ВидВзаимозачета.ТекущаяСтрока(2);
	КонецЕсли;          
КонецПроцедуры

// ======================================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
		глУстановитьНомер(Контекст);
		Возврат;
	КонецЕсли;
	глУстановитьФирму(Контекст);
	Валюта     = Гривня;
	Дата_Курса = ДатаДок;
	Курс       = глКурсДляВалюты(Валюта,Дата_Курса);
	ВидНДС     = ОсновнаяСтавкаНДС;
	
	СчетПоставщика        = СчетПоКоду("631");
	РегистрПоставщика     = Перечисление.ВидыКлиентов.Поставщик;
	ВидДвиженияПоставщика = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание;

	СчетПокупателя        = СчетПоКоду("361");
	РегистрПокупателя     = Перечисление.ВидыКлиентов.Покупатель;
	ВидДвиженияПокупателя = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление;
КонецПроцедуры 

// ===============================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр) 
	Если      Рекв = "Договор" Тогда
		Контрагент = ?(ВидКонтрагента=ВидПоставщик,Поставщик,Покупатель);
		Если ПустоеЗначение(Контрагент) = 1 Тогда
		    Предупреждение("Сначала укажите " + ?(ВидКонтрагента=ВидПоставщик,"поставщика","покупателя") + "!");
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		
		Фрм = СоздатьОбъект("СписокЗначений");
		Фрм.ДобавитьЗначение(Контрагент,            "Контрагент");			
		Фрм.ДобавитьЗначение(1,                     "фРазрешатьПустогоКонтрагента");
		Фрм.ДобавитьЗначение("ДоговораКонтрагентов","ГрафаОтбора");
		ОткрытьФормуМодально("Журнал.ПолныйЖурнал.ДляВыбораДоговоровИСчетов",Фрм,);
		
		ВремДоговор = Фрм.Получить("Документ");                                
		Если глПроверитьФирму(Контекст,ВремДоговор,"Договор") = 0 Тогда
			СтатусВозврата(0);
			Возврат;
		ИначеЕсли глПроверитьДокументыВзаиморасчетов(Валюта,Контрагент,ВремДоговор,Счет,"Договор") = 0 Тогда
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		Договор = ВремДоговор;
		ОпределитьСуммыВал();
		ФлагСтандОбр = 0;

	ИначеЕсли Рекв = "Счет" Тогда 
		Контрагент = ?(ВидКонтрагента=ВидПоставщик,Поставщик,Покупатель);
		Если ПустоеЗначение(Контрагент) = 1 Тогда
		    Предупреждение("Сначала укажите " + ?(ВидКонтрагента=ВидПоставщик,"поставщика","покупателя") + "!");
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		
		Фрм=СоздатьОбъект("СписокЗначений");
		Фрм.ДобавитьЗначение(Контрагент,            "Контрагент");			
		Фрм.ДобавитьЗначение(1,                     "фРазрешатьПустогоКонтрагента");
		Фрм.ДобавитьЗначение("СчетаКонтрагентов",   "ГрафаОтбора");
		ОткрытьФормуМодально("Журнал.ПолныйЖурнал.ДляВыбораДоговоровИСчетов",Фрм,);

		ВремСчет = Фрм.Получить("Документ");
		Если глПроверитьФирму(Контекст,ВремСчет) = 0 Тогда
			СтатусВозврата(0);
			Возврат;
		ИначеЕсли глПроверитьДокументыВзаиморасчетов(Валюта,Контрагент,,ВремСчет,"ДокументОснование")=0 Тогда
			СтатусВозврата(0);
			Возврат;              
		КонецЕсли;
		Счет = ВремСчет;
		
		фЗаполнитьДоговор = 0;
		Если ПустоеЗначение(Договор) = 1 Тогда
		    ФЗаполнитьДоговор = 1
		ИначеЕсли глПроверитьДокументыВзаиморасчетов(,,Договор,Счет,"ДокументОснование")=0 Тогда
		    ФЗаполнитьДоговор = 1
		КонецЕсли;
		
		Если фЗаполнитьДоговор = 1 Тогда
			Попытка
				Договор = Счет.Договор;
			Исключение
				Договор = 0;
			КонецПопытки;
		КонецЕсли;
		
		ОпределитьСуммыВал();
		ФлагСтандОбр = 0;
	
	ИначеЕсли Рекв="СчетПоставщика" Тогда 
		ФлагСтандОбр = 0;             
		ВыбСчет = СчетПоставщика;
		Если глСчетаПоставщиковПокупателей.ВыбратьЗначение(ВыбСчет,"Выберите счет",1,,2) = 1 Тогда
			СчетПоставщика = СчетПоКоду(ВыбСчет);
			УстСчетПоВалюте(СчетПоставщика);
		КонецЕсли;
		
	ИначеЕсли Рекв="СчетПокупателя" Тогда 
		ФлагСтандОбр = 0;             
		ВыбСчет = СчетПокупателя;
		Если глСчетаПоставщиковПокупателей.ВыбратьЗначение(ВыбСчет,"Выберите счет",1,,2) = 1 Тогда
			СчетПокупателя = СчетПоКоду(ВыбСчет);	
			УстСчетПоВалюте(СчетПокупателя);
		КонецЕсли;	

	ИначеЕсли Рекв="СчетУчета" Тогда 
		ФлагСтандОбр = 0;             
		ВыбСчет = СчетУчета;
		Если глСчетаПоставщиковПокупателей.ВыбратьЗначение(ВыбСчет,"Выберите счет",1,,2) = 1 Тогда
			СчетУчета = СчетПоКоду(ВыбСчет);	
			УстСчетПоВалюте(СчетУчета);
		КонецЕсли;	

	ИначеЕсли Рекв="ВидКонтрагента" Тогда 
		ПрежнВидКонтрагента = ВидКонтрагента;
		
	ИначеЕсли Рекв="Поставщик" Тогда 
		ПрежнПоставщик      = Поставщик;
	
	ИначеЕсли Рекв="Покупатель" Тогда 
		ПрежнПокупатель     = Покупатель;
	
	ИначеЕсли Рекв="ВидНДС" Тогда 
		ПрежнВиНДС = ВидНДС;
		глВыбратьНДС(Контекст,Рекв,1);
		ИзмВидНДС();
		ФлагСтандОбр = 0;             
		
	ИначеЕсли Рекв="ВидНДССтроки" Тогда 
	    глВыбратьНДС(Контекст,Рекв,1);
		ФлагСтандОбр = 0;             
	КонецЕсли;
КонецПроцедуры            

ВидПокупатель = Перечисление.ВидыКлиентов.Покупатель;
ВидПоставщик  = Перечисление.ВидыКлиентов.Поставщик;

// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|СтруктураПодчиненности,
	|ДвиженияДокумента,
	|ОткрытьВЖурнале");

// инициализация списка видов перезачета
ВидВзаимозачета.УдалитьВсе();
ВидВзаимозачета.ДобавитьЗначение("Увеличить долг поставщика перед фирмой за счет уменьшения долга покупателя");
ВидВзаимозачета.ДобавитьЗначение("Уменьшить долг поставщика перед фирмой за счет увеличения долга покупателя");
