Перем НачальнаяДатаДокумента;

// ===============================
Функция УстДоступность()
	Форма.Заголовок(глЗаголовок(Контекст,"Начисление амортизации ОС и НМА"));
	Форма.КПечать.Доступность(Проведен()*(1-Модифицированность()));
	Форма.Фирма.Видимость(0);
	Возврат "";
КонецФункции

// ===============================
Функция Период()
	// за месяц
	Возврат "За "+ПериодСтр(НачМесяца(ДатаДок),КонМесяца(ДатаДок));
КонецФункции

// ===============================
Процедура ПриОткрытии()
	глПроверкаДатыДок(Контекст,"Открытие");
	ПриЗаписиПерепроводить(1);
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кПровести.Доступность(0);
		Форма.кФирма.Доступность(0);
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли; 
	НачальнаяДатаДокумента = ДатаДок;
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	УстДоступность();
КонецПроцедуры

// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
		глУстановитьНомер(Контекст);
		Возврат;
	КонецЕсли;
	глУстановитьФирму(Контекст);
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
КонецПроцедуры                    
// ===============================
Функция РассчитатьСрокИспользования(ДатаВвода,СрокИспользования)
	Если ПустоеЗначение(ДатаВвода) = 0 Тогда 
		Если ДатаВвода < '01.04.11' Тогда   
			ДатаНачНУ = '31.03.11';
			//учет в НУ ведется с 01.04.2011, пересчитаем Срок использования
			Годы = ДатаГод(ДатаНачНУ)-ДатаГод(ДатаВвода);
			Если Годы < 0 Тогда
				Годы = Годы + 100;
			КонецЕсли;
			Разн = ДатаМесяц(ДатаНачНУ) - ДатаМесяц(ДатаВвода) + Годы*12;
			Если ДатаЧисло(ДатаНачНУ) < ДатаЧисло(ДатаВвода) Тогда
				Разн = Разн-1;
			КонецЕсли;
			Возврат ?(СрокИспользования > Разн,СрокИспользования - Разн,0);
		КонецЕсли; 
	КонецЕсли;    
	Возврат  СрокИспользования;
КонецФункции
// ===============================
Процедура Печать()
	Перем ВидПФ;
	
	Меню = СоздатьОбъект("СписокЗначений");
	Меню.ДобавитьЗначение(1,"Ведомость бух.уч.");
	Меню.ДобавитьЗначение(2,"Ведомость нал.уч.");
	Если Меню.ВыбратьЗначение(ВидПФ,"",,3,1) <> 1 Тогда
	    Возврат;
	КонецЕсли;

	глУстПропись(Гривня);

	Таб = СоздатьОбъект("Таблица");
	
	// главный бухгалтер
	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить ("Дата",ДатаДок);
	Расшифровка.Установить ("Фирма",Фирма);
	Расшифровка.Установить("ГлавныйБухгалтер","");
	
	глПолучитьДанные(Расшифровка);

	ГлавныйБухгалтер = глФИО(Расшифровка.Получить("ГлавныйБухгалтер"),1);

	    
	ПонижающийКоэффициент = 0;
	
	Если ВидПФ = 2 Тогда
		// налоговый учет
		Таб.ПараметрыСтраницы(1); // портрет
		Если Константа.ФормыНаУкраинском = Да Тогда
			Таб.ИсходнаяТаблица("НалоговыйУчет_Укр");
		Иначе
			Таб.ИсходнаяТаблица("НалоговыйУчет");
		КонецЕсли;
		
		// подготовим данные для формирования запроса
		// счет износа и период
		ТекПериодСтр = ПериодСтр(НачМесяца(ДатаДок),КонМесяца(ДатаДок));
		
		Если ДатаДок > КонецРассчитанногоПериодаБИ() Тогда
			Предупреждение("Дата документа больше даты конца периода бухгалтерских итогов. Установите период!");
			Возврат;
		КонецЕсли;
		
		Ит = СоздатьОбъект("БухгалтерскиеИтоги");
		Ит.ИспользоватьРазделительУчета(Фирма);
		Ит.ВключатьСубсчета(-1,1); // без групп
		Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		Если ПустоеЗначение(Подразделение) = 0 Тогда
			// фильтр по подразделению
			Ит.ИспользоватьКорСубконто(ВидыСубконто.Подразделения, Подразделение, 2);
		КонецЕсли;
		Ит.ВыполнитьЗапрос(НачМесяца(ДатаДок),КонМесяца(ДатаДок),"Н13");
		
		ИтМ = СоздатьОбъект("БухгалтерскиеИтоги");
		ИтМ.ИспользоватьРазделительУчета(Фирма);
		ИтМ.ВключатьСубсчета(1); // без групп
		ИтМ.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		ИтМ.ВыполнитьЗапрос(НачМесяца(ДатаДок),КонМесяца(ДатаДок),"Н10,Н11,Н12,Н13,11,12");
		
		ИтСумма = 0;
		Ит.ВыбратьСчета(1,2);
		Пока Ит.ПолучитьСчет() = 1 Цикл
			СчетИзноса = Ит.Счет.Код;
			Если СчетИзноса = "Н131" Тогда
				Ит.ВыбратьСубконто(1,,2,,,"ИнвенНомер"); // по инвентарным номерам
				Ит.ВыбратьСубконто(1,,2,,,"Группа"); // по группам
				ВидНеоборотныхАктивовСтр = "Основные средства";
				СчетНА = "Н10";
			ИначеЕсли СчетИзноса = "Н135" Тогда
				Ит.ВыбратьСубконто(1,,2,,,"ИнвенНомер"); // по инвентарным номерам
				Ит.ВыбратьСубконто(1,,2,,,"Группа"); // по группам 
				ВидНеоборотныхАктивовСтр = "Инвестиционная недвижимость";
				СчетНА = "Н100";
			ИначеЕсли СчетИзноса = "Н132" Тогда
				Ит.ВыбратьСубконто(1,,2);
				ВидНеоборотныхАктивовСтр = "Другие необоротные материальные активы";
				СчетНА = "11";
				СчетНУ = "Н11";
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ИтСумма <> 0 Тогда
				// уже был минимум один проход
				Таб.НоваяСтраница();
				ИтСумма = 0;
			КонецЕсли;
			
			ИтМ.ВыбратьСубконто(1);
			
			ГруппаПред = 0; 
			Пока Ит.ПолучитьСубконто(1) = 1 Цикл
			
				НА = Ит.Субконто(1);
				НомерГруппы = НА.Группа;
				Если (НомерГруппы <> ГруппаПред) Тогда
					Если (ГруппаПред <> 0) Тогда
						Таб.ВывестиСекцию("ОСДно");
						Таб.НоваяСтраница();
						ИтСумма = 0;
					КонецЕсли;
					ГруппаПред = НомерГруппы; 
					Группа = ?(Константа.ФормыНаУкраинском = Да,"Група ","Группа ")+НомерГруппы;
					Таб.ВывестиСекцию("ОСШапка");
				КонецЕсли;
				НА.ИспользоватьДату(НачМесяца(ДатаДок),1);
				
				// определим перв. стоимость, к-во и износ
				ПервСтоимость = 0;
				Кво			  = 1;
				Износ         = 0;
				
				Если ИтМ.ПолучитьСубконто(1,,НА) = 1 Тогда
					ИтМ.ВыбратьСчета();
					// перв. стоимость и к-во
					Если ИтМ.ПолучитьСчет(,СчетНА) = 1 Тогда
						Если (НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц)
						 ИЛИ (НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц) Тогда
							ПервСтоимость = ИтМ.СКД()    + ИтМ.КО();
							// износ
							Если ИтМ.ПолучитьСчет(,СчетИзноса) = 1 Тогда
								Износ = ИтМ.СНК();
							КонецЕсли;
						Иначе
							//Производственный метод после 01.11.2009, месяц ввода в эксплуатацию
							ПервСтоимость = ИтМ.СКД();
							НА.ИспользоватьДату(КонМесяца(ДатаДок),1);
						КонецЕсли;
					КонецЕсли;
					// износ
					Если ИтМ.ПолучитьСчет(,СчетИзноса) = 1 Тогда
						Износ = ИтМ.СНК();
					КонецЕсли;
				КонецЕсли;
					
				БалСтоимость = ПервСтоимость - Износ;
				Сумма        = Ит.КО();
							
				Наименование = "Инв. № "+Сокрлп(НА.ИнвенНомер)+", "+НА.ПолнНаименование;
				ЛиквидационнаяСтоимость = НА.ЛиквидационнаяСтоимость;
				СрокИспользования = РассчитатьСрокИспользования(НА.ДатаВвода,НА.СрокИспользования);  
				           
				Таб.ВывестиСекцию("ОССтрока");
				ИтСумма = ИтСумма + Сумма;
			КонецЦикла;
			Таб.ВывестиСекцию("ОСДно");
		КонецЦикла;

		//НМА
		ИтСумма = 0;
		Ит.ВыбратьСчета(1,2);
		флПерв = 1;
		Пока Ит.ПолучитьСчет() = 1 Цикл
			СчетИзноса = Ит.Счет.Код;
			Если СчетИзноса = "Н133" Тогда
				Ит.ВыбратьСубконто(1,,2);
				ВидНеоборотныхАктивовСтр = "Нематериальные активы";
				СчетНА = "12";    
				СчетНУ = "Н12";
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ИтСумма <> 0 Тогда
				// уже был минимум один проход
				Таб.НоваяСтраница();
				ИтСумма = 0;
			КонецЕсли;
			
			ИтМ.ВыбратьСубконто(1);
			
			ГруппаПред = 0; 
			Пока Ит.ПолучитьСубконто(1) = 1 Цикл
				Если флПерв = 1 Тогда
					Таб.ВывестиСекцию("НМАШапка");
					флПерв = 0;
				КонецЕсли;
		
				НА = Ит.Субконто(1);
				НА.ИспользоватьДату(НачМесяца(ДатаДок),1);
				
				// определим перв. стоимость, к-во и износ
				ПервСтоимость = 0;
				Кво			  = 0;
				Износ         = 0;
				
				Если ИтМ.ПолучитьСубконто(1,,НА) = 1 Тогда
					ИтМ.ВыбратьСчета();
					// перв. стоимость и к-во
					Если ИтМ.ПолучитьСчет(,СчетНУ) = 1 Тогда
						Если (НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц)
						 ИЛИ (НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц) Тогда
							ПервСтоимость = ИтМ.СКД()    + ИтМ.КО();
							Если ИтМ.ПолучитьСчет(,СчетНА) = 1 Тогда
								Кво			  = ИтМ.СКД("К") + ИтМ.КО("К");
							КонецЕсли;
							// износ
							Если ИтМ.ПолучитьСчет(,СчетИзноса) = 1 Тогда
								Износ = ИтМ.СНК();
							КонецЕсли;
						Иначе
							//Производственный метод после 01.11.2009, месяц ввода в эксплуатацию
							ПервСтоимость = ИтМ.СКД();
							Если ИтМ.ПолучитьСчет(,СчетНА) = 1 Тогда
								Кво	          = ИтМ.СКД("К");
							КонецЕсли;
							НА.ИспользоватьДату(КонМесяца(ДатаДок),1);
						КонецЕсли;
					КонецЕсли;
					// износ
					Если ИтМ.ПолучитьСчет(,СчетИзноса) = 1 Тогда
						Износ = ИтМ.СНК();
					КонецЕсли;
				КонецЕсли;
					
				БалСтоимость = ПервСтоимость - Износ;
				Сумма        = Ит.КО();
							
				Наименование = НА.ПолнНаименование;
				           
				Таб.ВывестиСекцию("НМАСтрока");
				ИтСумма = ИтСумма + Сумма;
			КонецЦикла;
		КонецЦикла;
		Если ИтСумма <> 0 Тогда
			Таб.ВывестиСекцию("НМАДно");
		КонецЕсли;
	Иначе
		// бухгалтерский учет
		Таб.ПараметрыСтраницы(2,,,,,,,,,1); // ландшафт
		Если Константа.ФормыНаУкраинском = Да Тогда
			Таб.ИсходнаяТаблица("БухгалтерскийУчет_Укр");
		Иначе
			Таб.ИсходнаяТаблица("БухгалтерскийУчет");
		КонецЕсли;
		
		// подготовим данные для формирования запроса
		// счет износа и период
		ТекПериодСтр = ПериодСтр(НачМесяца(ДатаДок),КонМесяца(ДатаДок));
		
		Если ДатаДок > КонецРассчитанногоПериодаБИ() Тогда
			Предупреждение("Дата документа больше даты конца периода бухгалтерских итогов. Установите период!");
			Возврат;
		КонецЕсли;
		
		Ит = СоздатьОбъект("БухгалтерскиеИтоги");
		Ит.ИспользоватьРазделительУчета(Фирма);
		Ит.ВключатьСубсчета(-1,1); // без групп
		Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		Если ПустоеЗначение(Подразделение) = 0 Тогда
			// фильтр по подразделению
			Ит.ИспользоватьКорСубконто(ВидыСубконто.Подразделения, Подразделение, 2);
		КонецЕсли;
		Ит.ВыполнитьЗапрос(НачМесяца(ДатаДок),КонМесяца(ДатаДок),"13","15,23,39,79,83,91,92,93,94,97",,2);
		
		ИтМ = СоздатьОбъект("БухгалтерскиеИтоги");
		ИтМ.ИспользоватьРазделительУчета(Фирма);
		ИтМ.ВключатьСубсчета(1); // без групп
		ИтМ.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		ИтМ.ВыполнитьЗапрос(НачМесяца(ДатаДок),КонМесяца(ДатаДок),"10,11,12,13");
		
		ИтКво = 0;ИтСумма = 0;ИтПерв = 0;ИтОст = 0;
		Ит.ВыбратьСчета(1,2);
		Пока Ит.ПолучитьСчет() = 1 Цикл
			СчетИзноса = Ит.Счет.Код;
			Если СчетИзноса = "131" Тогда
				Ит.ВыбратьСубконто(1,,2,,,"ИнвенНомер"); // по инвентарным номерам
				ВидНеоборотныхАктивовСтр = "Основные средства";
				СчетНА = "10";
			ИначеЕсли СчетИзноса = "135" Тогда
				Ит.ВыбратьСубконто(1,,2,,,"ИнвенНомер"); // по инвентарным номерам
				ВидНеоборотныхАктивовСтр = "Инвестиционная недвижимость";
				СчетНА = "100";
			ИначеЕсли СчетИзноса = "132" Тогда
				Ит.ВыбратьСубконто(1,,2);
				ВидНеоборотныхАктивовСтр = "Другие необоротные материальные активы";
				СчетНА = "11";
			Иначе
				Ит.ВыбратьСубконто(1,,2);
				ВидНеоборотныхАктивовСтр = "Нематериальные активы";
				СчетНА = "12";
			КонецЕсли;
			
			Если ИтСумма <> 0 Тогда
				// уже был минимум один проход
				Таб.НоваяСтраница();
				ИтКво = 0;
				ИтСумма = 0;
				ИтПерв = 0;
				ИтОст = 0;
			КонецЕсли;
			Таб.ВывестиСекцию("Шапка");
			
			ИтМ.ВыбратьСубконто(1);
			
			Пока Ит.ПолучитьСубконто(1) = 1 Цикл
			
				НА = Ит.Субконто(1);
				НА.ИспользоватьДату(НачМесяца(ДатаДок),1);
				
				// определим перв. стоимость, к-во и износ
				ПервСтоимость = 0;
				Кво			  = 0;
				Износ         = 0;
				
				Если ИтМ.ПолучитьСубконто(1,,НА) = 1 Тогда
					ИтМ.ВыбратьСчета();
					// перв. стоимость и к-во
					Если ИтМ.ПолучитьСчет(,СчетНА) = 1 Тогда
						Если (НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц)
						 ИЛИ (НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц) Тогда
							ПервСтоимость = ИтМ.СКД()    + ИтМ.КО();
							Кво			  = ИтМ.СКД("К") + ИтМ.КО("К");
							// износ
							Если ИтМ.ПолучитьСчет(,СчетИзноса) = 1 Тогда
								Износ = ИтМ.СНК();
							КонецЕсли;
						Иначе
							//Производственный метод после 01.11.2009, месяц ввода в эксплуатацию
							ПервСтоимость = ИтМ.СКД();
							Кво	          = ИтМ.СКД("К");
							НА.ИспользоватьДату(КонМесяца(ДатаДок),1);
						КонецЕсли;
					КонецЕсли;
					// износ
					Если ИтМ.ПолучитьСчет(,СчетИзноса) = 1 Тогда
						Износ = ИтМ.СНК();
					КонецЕсли;
				КонецЕсли;
					
				ОстСтоимость = ПервСтоимость - Износ;
				Сумма        = Ит.КО();
							
				Если (СчетНА = "10") или (СчетНА = "100") Тогда
					Наименование = "Инв. № "+Сокрлп(НА.ИнвенНомер)+", "+НА.ПолнНаименование;
					Кво = 1;
				Иначе
					Наименование = НА.ПолнНаименование;
				КонецЕсли;
				           
				МетодРасчетаИзноса = НА.МетодРасчетаИзноса; 
				ЛиквидационнаяСтоимость = "-";
				СрокИспользования = "-";
				НормаАмортизации = "-";
				РасчетныйОбъемПроизводства = "-";
				ТекущийОбъемПроизводства = "-";
				
				Если МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПрямолинейноеСписание Тогда
					ЛиквидационнаяСтоимость = НА.ЛиквидационнаяСтоимость;
					СрокИспользования = НА.СрокИспользования;
				ИначеЕсли (МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.УменьшениеОстатка) или
			              (МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.УскоренноеУменьшениеОстатка) Тогда
					НормаАмортизации = НА.НормаАмортизации * 12;
					ЛиквидационнаяСтоимость = НА.ЛиквидационнаяСтоимость;
					СрокИспользования = НА.СрокИспользования;
				ИначеЕсли МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.СуммЕдиниц Тогда
					ЛиквидационнаяСтоимость = НА.ЛиквидационнаяСтоимость;
					РасчетныйОбъемПроизводства = НА.РасчетныйОбъемПроизводства;
					//ТекущийОбъемПроизводства = НА.ТекущийОбъемПроизводства.Получить(КонМесяца(ДатаДок));
					ТекущийОбъемПроизводства = НА.ТекущийОбъемПроизводства;
				ИначеЕсли МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц Тогда
					НормаАмортизации = 1;
				ИначеЕсли МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц Тогда
					НормаАмортизации = 0.5;
				КонецЕсли;	
			    
				Таб.ВывестиСекцию("Строка");
				ИтКво   = ИтКво   + Кво;
				ИтСумма = ИтСумма + Сумма;
				ИтПерв  = ИтПерв  + ПервСтоимость;
				ИтОст   = ИтОст   + ОстСтоимость;
			КонецЦикла;
			
			Таб.ВывестиСекцию("Дно");
		КонецЦикла;
	КонецЕсли;
	
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Опции(0,0,0,0);
	Таб.Показать("ПЕЧАТЬ: Ведомость начисления амортизации","");
КонецПроцедуры

// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|ДвиженияДокумента,
	|ОткрытьВЖурнале");
