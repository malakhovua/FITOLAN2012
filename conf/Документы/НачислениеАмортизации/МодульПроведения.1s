Перем СпрНА, ДатаНачНУ;
Перем ОбщаяСуммаИзноса, СуммаИзноса, СуммаИзносаНУ;

// ===============================
// возвращает корень от числа Основание со степенью Степень
Функция Корень(Основание,Степень)
	Если Степень = 1 Тогда
		Возврат(Основание);
	КонецЕсли;
	Факториал = 1; Степень_ = 1; Сум = 0;
	СтепеньЕ = 1/Степень*Лог(Основание);
	Для ии = 1 по 28 Цикл             
		Факториал = Факториал * ии;
		Степень_ = Степень_ * СтепеньЕ;
		Сум = Сум + Степень_/Факториал 
	КонецЦикла;
	Возврат(1+Сум);
КонецФункции

// ===============================
Функция ПроверкаШапки()
	глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
	глВыбранЛи(Фирма,"Фирма");
	Возврат глВсеВыбрано;    
КонецФункции

// ===============================
Функция РассчитатьСрокИспользования(ДатаВвода,СрокИспользования)
	Если ПустоеЗначение(ДатаВвода) = 0 Тогда 
		Если ДатаВвода < '01.04.11' Тогда 
			//учет в НУ ведется с 01.04.2011, пересчитаем Срок использования
			Годы = ДатаГод(ДатаНачНУ)-ДатаГод(ДатаВвода);
			Если Годы < 0 Тогда
				Годы = Годы + 100;
			КонецЕсли;
			Разн = ДатаМесяц(ДатаНачНУ) - ДатаМесяц(ДатаВвода) + Годы*12;
			Если ДатаЧисло(ДатаНачНУ) < ДатаЧисло(ДатаВвода) Тогда
				Разн = Разн-1;
			КонецЕсли;
			Возврат ?(СрокИспользования > Разн,СрокИспользования - Разн,0);
		КонецЕсли; 
	КонецЕсли;    
	Возврат  СрокИспользования;
КонецФункции

// ===============================
// рассчитывает износ по конкретному ОС, НМА, необоротному активу
// по установленному в нем методу
Функция РассчитатьИзносПоЭлементу(Элемент,ПервСтоимость,ОстСтоимость,ПервСтоимостьНУ,ОстСтоимостьНУ,СчИзноса,Сч,СчИзносаНУ,СчНУ)
	СуммаИзноса = 0; СуммаИзносаНУ = 0;
	Если Элемент.МетодРасчетаИзноса.Выбран() = 0 Тогда
	    глКомментарий(Строка(Элемент)+": не задан метод расчета износа. Износ не начислен!",0,,"!");
		Возврат 0;
	КонецЕсли;
	ИзношеноПолностью = 0;
	//налоговый учет
	ИзношеноПолностьюНУ = 0;

	Если Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц Тогда
		// Установим признак "ИзношеноПолностью" если применяется метод "100%"
	Иначе
		// Установим признак "ИзношеноПолностью" если для всех остальных методов
		Если ((ОстСтоимость) < 0) или (ОстСтоимость<=Элемент.ЛиквидационнаяСтоимость) Тогда
			ИзношеноПолностью = 1;
		КонецЕсли;
		Если (ОстСтоимостьНУ < 0) или (ОстСтоимостьНУ<=Элемент.ЛиквидационнаяСтоимость) Тогда
			ИзношеноПолностьюНУ = 1;
		КонецЕсли;
	КонецЕсли;
	
	Если (ИзношеноПолностью = 0) или (ИзношеноПолностьюНУ = 0) Тогда
		//ПрямолинейноеСписание
		Если Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПрямолинейноеСписание Тогда
			Если Элемент.СрокИспользования = 0 Тогда
				глКомментарий(Строка(Элемент)+": не задан срок полезного использования. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли;    
			Если (ИзношеноПолностью = 0) Тогда
				СуммаИзноса = Макс(Окр((ПервСтоимость - Элемент.ЛиквидационнаяСтоимость)/Элемент.СрокИспользования,2),0);
			КонецЕсли;    
			//налоговый учет 
			Если (ИзношеноПолностьюНУ = 0) Тогда
				СрокИспользованияНУ = РассчитатьСрокИспользования(Элемент.ДатаВвода,Элемент.СрокИспользования);
				СуммаИзносаНУ = 0;
				Если (СрокИспользованияНУ<>0) Тогда
					СуммаИзносаНУ = Макс(Окр((ПервСтоимостьНУ - Элемент.ЛиквидационнаяСтоимость)/СрокИспользованияНУ,2),0);
				КонецЕсли;    
			КонецЕсли;    
			
			//УменьшениеОстатка
			//большая погрешность в случае,если ликвидационная стоимость много больше первоначальной
		ИначеЕсли Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.УменьшениеОстатка Тогда
			Если Элемент.СрокИспользования = 0 Тогда
				глКомментарий(Строка(Элемент)+": не задан срок полезного использования. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли; 
			Если Элемент.СрокИспользования < 12 Тогда
				глКомментарий(Строка(Элемент)+": срок полезного использования меньше 1 года. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли; 
			Если (ПервСтоимость = 0) и (ИзношеноПолностью <> 0) Тогда
				глКомментарий(Строка(Элемент)+": первоначальная стоимость равна 0. Износ не начислен!",0,,"!");    
				Возврат 0;
			КонецЕсли;                  
			Если (ПервСтоимостьНУ = 0) и (ИзношеноПолностьюНУ <> 0) Тогда
				глКомментарий(Строка(Элемент)+": первоначальная стоимость в НУ равна 0. Износ в НУ не начислен!",0,,"!");    
			КонецЕсли;                  
			Если Элемент.ЛиквидационнаяСтоимость = 0 Тогда
				глКомментарий(Строка(Элемент)+": ликвидационная стоимость равна 0. Износ не начислен!",0,,"!");    
				Возврат 0;
			КонецЕсли;
			
			// для данного метода расчитывается коэф. аморт. за год, поэтому при начислении 
			// аморт помесячно необходимо брать остаточную стоимость и износ на начало года
			Ит = СоздатьОбъект("БухгалтерскиеИтоги");
			Ит.ИспользоватьРазделительУчета(Фирма);
			Ит.ПериодМ(Макс(ДобавитьМесяц(Элемент.ДатаВвода, 1), НачГода(ДатаДок)));
			ИзносГод = Ит.СНК(СчИзноса,"С",,Элемент);
			ОстСтоимостьГод = ПервСтоимость - ИзносГод;
			
			Если (ИзношеноПолностью = 0) Тогда
				ГодоваяНормаАмортизации = (1-Корень(Элемент.ЛиквидационнаяСтоимость/ПервСтоимость,Элемент.СрокИспользования/12));
				МесячнаяНормаАмортизации = ГодоваяНормаАмортизации/12;
				СуммаИзноса = Макс(ОстСтоимостьГод*МесячнаяНормаАмортизации,0);
				
				Если СпрНА.НайтиЭлемент(Элемент)=1 Тогда
					СпрНА.НормаАмортизации = МесячнаяНормаАмортизации;
					СпрНА.Записать();    
				КонецЕсли;     
			КонецЕсли;     

			//налоговый учет
			Если (ИзношеноПолностьюНУ = 0) Тогда
				ИзносГодНУ = Ит.СНК(СчИзносаНУ,"С",,Элемент);                   
				ОстСтоимостьГодНУ = ПервСтоимостьНУ - ИзносГодНУ;   
				
				ГодоваяНормаАмортизацииНУ = 0;
				СрокИспользованияНУ = РассчитатьСрокИспользования(Элемент.ДатаВвода,Элемент.СрокИспользования);
				Если (ПервСтоимостьНУ <> 0) и (СрокИспользованияНУ<>0) Тогда
					ГодоваяНормаАмортизацииНУ  = (1-Корень(Элемент.ЛиквидационнаяСтоимость/ПервСтоимостьНУ,СрокИспользованияНУ/12));
				КонецЕсли;
				
				ГодоваяСуммаИзносаНУ = Макс(0, ОстСтоимостьГодНУ*ГодоваяНормаАмортизацииНУ);
				СуммаИзносаНУ        = ГодоваяСуммаИзносаНУ / 12;  
			КонецЕсли;

			//УскоренноеУменьшениеОстатка
		ИначеЕсли Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.УскоренноеУменьшениеОстатка Тогда
			Если Элемент.СрокИспользования = 0 Тогда
				глКомментарий(Строка(Элемент)+": не задан срок полезного использования. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли; 
			Если Элемент.СрокИспользования < 12 Тогда
				глКомментарий(Строка(Элемент)+": срок полезного использования меньше 1 года. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли; 
			Если (ПервСтоимость = 0) и (ИзношеноПолностью <> 0) Тогда
				глКомментарий(Строка(Элемент)+": первоначальная стоимость равна 0. Износ не начислен!",0,,"!");    
				Возврат 0;
			КонецЕсли;
			Если (ПервСтоимостьНУ = 0) и (ИзношеноПолностьюНУ <> 0) Тогда
				глКомментарий(Строка(Элемент)+": первоначальная стоимость в НУ равна 0. Износ в НУ не начислен!",0,,"!");    
			КонецЕсли;
			Если ПустоеЗначение(Элемент.ДатаВвода) = 1 Тогда
				глКомментарий(Строка(Элемент)+": Не задана дата ввода в эксплуатацию. Износ не начислен!",0,,"!");    
				Возврат 0;
			КонецЕсли;
			
			// для данного метода расчитывается коэф. аморт. за год, поэтому при начислении 
			// аморт помесячно необходимо брать остаточную стоимость и износ на начало года
			Ит = СоздатьОбъект("БухгалтерскиеИтоги");
			Ит.ИспользоватьРазделительУчета(Фирма);
			
			ДатаЛиквидации = ДобавитьМесяц(Элемент.ДатаВвода, Элемент.СрокИспользования);
			
			ДокументАбсМесяц   = ДатаГод(ДатаДок)*12        + ДатаМесяц(ДатаДок);
			ЛиквидацияАбсМесяц = ДатаГод(ДатаЛиквидации)*12 + ДатаМесяц(ДатаЛиквидации);
						
			// если это не последний год эксплуатации...
			Если ДокументАбсМесяц <= ЛиквидацияАбсМесяц-12 Тогда
				// ...то применяем алгоритм Double declining balance depreciation method
				Ит.ПериодМ(Макс(ДобавитьМесяц(Элемент.ДатаВвода, 1), НачГода(ДатаДок)));

				ИзносГод = Ит.СНК(СчИзноса,"С",,Элемент);                   
				ОстСтоимостьГод = ПервСтоимость - ИзносГод;
				
				Если (ИзношеноПолностью = 0) Тогда
					ГодоваяНормаАмортизации = (1/Элемент.СрокИспользования*12) * 2;
					МесячнаяНормаАмортизации = ГодоваяНормаАмортизации/12;
					СуммаИзноса = ОстСтоимостьГод*МесячнаяНормаАмортизации;
					
					Если СпрНА.НайтиЭлемент(Элемент)=1 Тогда
						СпрНА.НормаАмортизации = МесячнаяНормаАмортизации;
						СпрНА.Записать();		
					КонецЕсли;  
				КонецЕсли;  

				//налоговый учет 
				Если (ИзношеноПолностьюНУ = 0) Тогда
					СрокИспользованияНУ = РассчитатьСрокИспользования(Элемент.ДатаВвода,Элемент.СрокИспользования);
					ГодоваяНормаАмортизацииНУ = 0;
					Если (СрокИспользованияНУ<>0) Тогда
						ГодоваяНормаАмортизацииНУ = (1/СрокИспользованияНУ*12) * 2;
					КонецЕсли;	
					МесячнаяНормаАмортизацииНУ = ГодоваяНормаАмортизацииНУ/12;
					ИзносГодНУ = Ит.СНК(СчИзносаНУ,"С",,Элемент);                   
					ОстСтоимостьГодНУ = ПервСтоимостьНУ - ИзносГодНУ;
					
					СуммаИзносаНУ = ОстСтоимостьГодНУ*МесячнаяНормаАмортизацииНУ;  
				КонецЕсли;	
				
			Иначе // ...линейно списываем до ликвидационной стоимости
				Ит.ПериодМ(ДатаДок);
				ИзносГод = Ит.СНК(СчИзноса,"С",,Элемент);
				ОстСтоимостьГод = ПервСтоимость - ИзносГод;
								
				ОсталосьМесяцев = Макс(1, ЛиквидацияАбсМесяц - ДокументАбсМесяц + 1);
				Если (ИзношеноПолностью = 0) Тогда
					СуммаИзноса = (ОстСтоимостьГод-Элемент.ЛиквидационнаяСтоимость)/ОсталосьМесяцев;
				КонецЕсли;

				//налоговый учет 
				Если (ИзношеноПолностьюНУ = 0) Тогда
					ИзносГодНУ = Ит.СНК(СчИзносаНУ,"С",,Элемент);
					ОстСтоимостьГодНУ = ПервСтоимостьНУ - ИзносГодНУ;
					
					СуммаИзносаНУ = (ОстСтоимостьГодНУ-Элемент.ЛиквидационнаяСтоимость)/ОсталосьМесяцев;
				КонецЕсли;
			КонецЕсли;
			
			СуммаИзноса = Макс(0, СуммаИзноса);
			СуммаИзносаНУ = Макс(0, СуммаИзносаНУ);
			
			//СуммЕдиниц
		ИначеЕсли Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.СуммЕдиниц Тогда
			// Перечисление.МетодыРасчетаИзноса.СуммЕдиниц
			РасчетныйОбъемПроизводства = Элемент.РасчетныйОбъемПроизводства;
			ЛиквидационнаяСтоимость    = Элемент.ЛиквидационнаяСтоимость;
			Если РасчетныйОбъемПроизводства = 0 Тогда
				глКомментарий(Строка(Элемент)+": не задан расчетный объем производства. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли;
			Элемент.ИспользоватьДату(КонМесяца(ДатаДок),1);
			ТекущийОбъемПроизводства = Элемент.ТекущийОбъемПроизводства;
			Элемент.ИспользоватьДату(НачМесяца(ДатаДок) - 1,1);
			Если ТекущийОбъемПроизводства = 0 Тогда
				глКомментарий(Строка(Элемент)+": не задан текущий объем производства. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли;
			Если (ИзношеноПолностью = 0) Тогда
				СуммаИзноса = Макс(ТекущийОбъемПроизводства*(ПервСтоимость - ЛиквидационнаяСтоимость)/РасчетныйОбъемПроизводства,0);
			КонецЕсли;
			Если (ИзношеноПолностьюНУ = 0) Тогда
				СуммаИзносаНУ = Макс(ТекущийОбъемПроизводства*(ПервСтоимостьНУ - ЛиквидационнаяСтоимость)/РасчетныйОбъемПроизводства,0);
			КонецЕсли;
			// Кумулятивный
		ИначеЕсли Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.Кумулятивный Тогда
			Если Элемент.СрокИспользования = 0 Тогда
				глКомментарий(Строка(Элемент)+": не задан срок полезного использования. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли; 
			Если Элемент.СрокИспользования < 12 Тогда
				глКомментарий(Строка(Элемент)+": срок полезного использования меньше 1 года. Износ не начислен!",0,,"!");
				Возврат 0;
			КонецЕсли; 
			Если (ПервСтоимость = 0) и (ИзношеноПолностью <> 0) Тогда
				глКомментарий(Строка(Элемент)+": первоначальная стоимость равна 0. Износ не начислен!",0,,"!");    
				Возврат 0;
			КонецЕсли;
			Если (ПервСтоимостьНУ = 0) и (ИзношеноПолностьюНУ <> 0) Тогда
				глКомментарий(Строка(Элемент)+": первоначальная стоимость в НУ равна 0. Износ в НУ не начислен!",0,,"!");    
			КонецЕсли;
			Если Элемент.ЛиквидационнаяСтоимость = 0 Тогда
				глКомментарий(Строка(Элемент)+": ликвидационная стоимость равна 0. Износ не начислен!",0,,"!");    
				Возврат 0;
			КонецЕсли;
			// определим срок использования в целых годах
			ЛетИспользования = Цел(Элемент.СрокИспользования/12);
			// определим число лет, остающееся до конца срока службы объекта
			ДатаНачала = ДобавитьМесяц(Элемент.ДатаВвода,12);
			ПрошлоЛет = 0;
			Пока ДатаНачала < ДатаДок Цикл
				ПрошлоЛет = ПрошлоЛет + 1;
				ДатаНачала = ДобавитьМесяц(ДатаНачала,12);
			КонецЦикла;
			ОсталосьЛет = ЛетИспользования - ПрошлоЛет;
			// определим сумму лет срока использования объекта
			СуммаЛет = 0;
			Пока ЛетИспользования > 0 Цикл
				СуммаЛет = СуммаЛет + ЛетИспользования;
				ЛетИспользования = ЛетИспользования - 1;
			КонецЦикла;
			// определим кумулятивный коэффициент и сумму износа
			КумулятивныйКоэффициент = ?(СуммаЛет = 0, 0, ОсталосьЛет / СуммаЛет);
			Если (ИзношеноПолностью = 0) Тогда
				СуммаИзноса = Макс(КумулятивныйКоэффициент*(ПервСтоимость-Элемент.ЛиквидационнаяСтоимость)/12,0);
			КонецЕсли;                       
			Если (ИзношеноПолностьюНУ = 0) Тогда
				СуммаИзносаНУ = Макс(КумулятивныйКоэффициент*(ПервСтоимостьНУ-Элемент.ЛиквидационнаяСтоимость)/12,0);
			КонецЕсли;                       
			//ПервыйМесяц (100%)
		ИначеЕсли Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц Тогда
			// начисление первого месяца (100 %) в документе ВводВЭксплуатацию
		ИначеЕсли Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц Тогда
			// начисление первого месяца (первые 50 %) в документе ВводВЭксплуатацию
		КонецЕсли;                       
	КонецЕсли;

	Если (Элемент.Производственное = 1) и (Константа.АмортизацияБУизНУ = Да) Тогда 
		//Сумму амортизации в БУ определять по данным НУ
		Если СуммаИзносаНУ <> 0 Тогда
			 СуммаИзноса = СуммаИзносаНУ;
		КонецЕсли;
	КонецЕсли;
	
	// копейки
	Если ОстСтоимость - СуммаИзноса < Элемент.ЛиквидационнаяСтоимость Тогда
	    СуммаИзноса = Макс(0, ОстСтоимость - Элемент.ЛиквидационнаяСтоимость);
	КонецЕсли;
	Если ОстСтоимостьНУ - СуммаИзносаНУ < Элемент.ЛиквидационнаяСтоимость Тогда
	    СуммаИзносаНУ = Макс(0, ОстСтоимостьНУ - Элемент.ЛиквидационнаяСтоимость);
	КонецЕсли;
	
	Если Элемент.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйМесяц Тогда
		// Установим признак "ИзношеноПолностью" если применяется метод "100%"
		//ИзношеноПолностью = 1;
	Иначе
		// Установим признак "ИзношеноПолностью" если для всех остальных методов
		Если ((ОстСтоимость-СуммаИзноса) < 0) или (ОстСтоимость-СуммаИзноса<=Элемент.ЛиквидационнаяСтоимость) Тогда
			ИзношеноПолностью = 1;
		КонецЕсли;
		Если ((ОстСтоимостьНУ-СуммаИзносаНУ) < 0) или (ОстСтоимостьНУ-СуммаИзносаНУ<=Элемент.ЛиквидационнаяСтоимость) Тогда
			ИзношеноПолностьюНУ = 1;
		КонецЕсли;
	КонецЕсли;
	
	Если (ИзношеноПолностью = 1) и (ОстСтоимость > 0) Тогда
		глКомментарий(СокрЛП(Элемент)+" : износ начислен полностью !",2,,"I");
	КонецЕсли;
	Если (ИзношеноПолностьюНУ = 1) и (ОстСтоимостьНУ > 0) Тогда
		глКомментарий(СокрЛП(Элемент)+" : износ в налоговом учете начислен полностью !",2,,"I");
	КонецЕсли;
	Возврат СуммаИзноса;
КонецФункции

// ===============================
// рассчитывает износ по всем субконто на одном счете - ОС, НМА, необоротные активы
Процедура РассчитатьИзносПоСчету(Сч, СчИзноса)
	Сч = ?(ТипЗначенияСтр(Сч)="Строка",СчетПоКоду(Сч),Сч);
	СчИзноса = ?(ТипЗначенияСтр(СчИзноса)="Строка",СчетПоКоду(СчИзноса),СчИзноса);
	СчНУ = СчетПоКоду("Н"+Сч);
	СчИзносаНУ = СчетПоКоду("Н"+СчИзноса);
	
	СуммаИзноса = 0; СуммаИзносаНУ = 0;

	СпрНА = СоздатьОбъект("Справочник.НеоборотныеАктивы");
	// отберем по подразделениею только те ОС, НМА, необоротные активы 
	// по которым есть остатки по количеству
	ИтПоКоличеству = СоздатьОбъект("БухгалтерскиеИтоги");
	ИтПоКоличеству.ИспользоватьРазделительУчета(Фирма);
	Если ПустоеЗначение(Подразделение)=0 Тогда
		// фильтр по подразделению
		ИтПоКоличеству.ИспользоватьСубконто(ВидыСубконто.Подразделения,Подразделение,2);
	Иначе
		ИтПоКоличеству.ИспользоватьСубконто(ВидыСубконто.Подразделения);
	КонецЕсли;
	ИтПоКоличеству.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы); // ОС, НМА 
	Если НачКвартала(ДатаДок) = НачМесяца(ДатаДок) Тогда
		ИтПоКоличеству.ВыполнитьЗапрос(НачКвартала(ДатаДок),,Сч,,,,,"К");
	Иначе
		ИтПоКоличеству.ВыполнитьЗапрос(НачКвартала(ДатаДок),КонМесяца(ДобавитьМесяц(ДатаДок,-1)),Сч,,,,,"К");
	КонецЕсли;
    
	спНА = СоздатьОбъект("СписокЗначений");
	ИтПоКоличеству.ВыбратьСубконто(2);
	Пока ИтПоКоличеству.ПолучитьСубконто(2) = 1 Цикл
		НА = ИтПоКоличеству.Субконто(2);
		
		Если НачКвартала(ДатаДок) = НачМесяца(ДатаДок) Тогда
			// месяц - начало квартала
			Кво = ИтПоКоличеству.СНД("К");
		Иначе
			//на начало месяца
			Кво = ИтПоКоличеству.СКД("К");
		КонецЕсли;
		Если Кво > 0 Тогда
			спНА.ДобавитьЗначение(НА); 
		КонецЕсли;
		
	КонецЦикла;	
	
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.Подразделения);
	
	// если подразделеение задано то накладываем фильтр по списку НА
	// принадлежащих этому подразделеению
	Если ПустоеЗначение(Подразделение)=0 Тогда
		Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы,спНА,2); // ОС, НМА 
	Иначе	
		Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы); // ОС, НМА 
	КонецЕсли;
	
	Если НачКвартала(ДатаДок) = НачМесяца(ДатаДок) Тогда
		Ит.ВыполнитьЗапрос(НачКвартала(ДатаДок),,Строка(Сч.Код)+";"+Строка(СчНУ.Код));
	Иначе
		Ит.ВыполнитьЗапрос(НачКвартала(ДатаДок),КонМесяца(ДобавитьМесяц(ДатаДок,-1)),Строка(Сч.Код)+";"+Строка(СчНУ.Код));
	КонецЕсли;
	
	ИтИзн = СоздатьОбъект("БухгалтерскиеИтоги");
	ИтИзн.ИспользоватьРазделительУчета(Фирма);
	ИтИзн.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
	Если НачКвартала(ДатаДок) = НачМесяца(ДатаДок) Тогда
		ИтИзн.ВыполнитьЗапрос(НачКвартала(ДатаДок),,Строка(СчИзноса.Код)+";"+Строка(СчИзносаНУ.Код));
	Иначе
		ИтИзн.ВыполнитьЗапрос(НачКвартала(ДатаДок),КонМесяца(ДобавитьМесяц(ДатаДок,-1)),Строка(СчИзноса.Код)+";"+Строка(СчИзносаНУ.Код));
	КонецЕсли;
	
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1) = 1 Цикл

		ТекПодразделение = Ит.Субконто(1);
		
		Ит.ВыбратьСубконто(2);
		Пока Ит.ПолучитьСубконто(2) = 1 Цикл
			Если Сч = СчетПоКоду("10") Тогда      
				// Для счета 100 износ начисляем отдельно     
				СпрНА.ИспользоватьДату(ДатаДок,1);
				СпрНА.НайтиПоКоду(Ит.Субконто(2).Код);    
				Если СпрНА.Счет = СчетПоКоду("100") Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;	
			
			НА = Ит.Субконто(2);
			
			НА.ИспользоватьДату(НачМесяца(ДатаДок) - 1,1); 
			
			Если (НА.Состояние = Перечисление.СостоянияНеоборАктивов.НаКонсервации) 
			 или (НА.Состояние = Перечисление.СостоянияНеоборАктивов.НаМодернизации)
			 или (НА.Состояние = Перечисление.СостоянияНеоборАктивов.Подготовка)
			 Тогда
			    Продолжить;
			КонецЕсли;
			Кво = 0;
			ПервСтоимость = 0;
			ПервСтоимостьНУ = 0;
			
			ДатаЗначения = ПолучитьПустоеЗначение("Дата");
			Если ДатаЗначения >= НачКвартала(ДатаДок) Тогда
				
				ИтДатЗнач = СоздатьОбъект("БухгалтерскиеИтоги");
				ИтДатЗнач.ИспользоватьРазделительУчета(Фирма); 
				ИтДатЗнач.ИспользоватьСубконто(ВидыСубконто.Подразделения,ТекПодразделение,2);
				ИтДатЗнач.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы,НА,2); // ОС, НМА
				Если НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)) = НачМесяца(ДатаДок) Тогда
					ИтДатЗнач.ВыполнитьЗапрос(НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)),,Строка(Сч.Код)+";"+Строка(СчНУ.Код));
				Иначе
					ИтДатЗнач.ВыполнитьЗапрос(НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)),КонМесяца(ДобавитьМесяц(ДатаДок,-1)),Строка(Сч.Код)+";"+Строка(СчНУ.Код));
				КонецЕсли;
				
				Если ИтДатЗнач.ПолучитьСчет(,Сч) = 1 Тогда
					Кво = ИтДатЗнач.СНД("К");
					ПервСтоимость = ИтДатЗнач.СНД("С");
				КонецЕсли;
				Если НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)) = НачМесяца(ДатаДок) Тогда
					// месяц - начало применения метода
					Если ИтДатЗнач.ПолучитьСчет(,СчНУ) = 1 Тогда
						ПервСтоимостьНУ = ИтДатЗнач.СНД("С");
					КонецЕсли;
				Иначе
					//на начало месяца
					Если ИтДатЗнач.ПолучитьСчет(,Сч) = 1 Тогда
						ПервСтоимость = ИтДатЗнач.СКД("С");
						Кво = ИтДатЗнач.СКД("К");
					КонецЕсли;
					Если ИтДатЗнач.ПолучитьСчет(,СчНУ) = 1 Тогда
						ПервСтоимостьНУ = ИтДатЗнач.СКД("С");
					КонецЕсли;
				КонецЕсли;
				
				ИтИзнДатЗнач = СоздатьОбъект("БухгалтерскиеИтоги");
				ИтИзнДатЗнач.ИспользоватьРазделительУчета(Фирма);
				ИтИзнДатЗнач.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы,НА,2);
				Если НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)) = НачМесяца(ДатаДок) Тогда
					ИтИзнДатЗнач.ВыполнитьЗапрос(НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)),,Строка(СчИзноса.Код)+";"+Строка(СчИзносаНУ.Код));
				Иначе
					ИтИзнДатЗнач.ВыполнитьЗапрос(НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)),КонМесяца(ДобавитьМесяц(ДатаДок,-1)),Строка(СчИзноса.Код)+";"+Строка(СчИзносаНУ.Код));
				КонецЕсли;
				
				Износ = 0;
				Если НачМесяца(ДобавитьМесяц(ДатаЗначения,+1)) = НачМесяца(ДатаДок) Тогда
					// месяц - начало применения метода
					Если ИтИзнДатЗнач.ПолучитьСчет(,СчИзноса) = 1 Тогда
						Износ = ИтИзнДатЗнач.СНК("С");
					КонецЕсли;
					Если ИтИзнДатЗнач.ПолучитьСчет(,СчИзносаНУ) = 1 Тогда
						ИзносНУ = ИтИзнДатЗнач.СНК("С");
					КонецЕсли;
				Иначе
					//на начало месяца
					Если ИтИзнДатЗнач.ПолучитьСчет(,СчИзноса) = 1 Тогда
						Износ = ИтИзнДатЗнач.СКК("С");
					КонецЕсли;
					Если ИтИзнДатЗнач.ПолучитьСчет(,СчИзносаНУ) = 1 Тогда
						ИзносНУ = ИтИзнДатЗнач.СКК("С");
					КонецЕсли;
				КонецЕсли;
					
			Иначе
				
				Если Ит.ПолучитьСчет(,Сч) = 1 Тогда
					ПервСтоимость = Ит.СНД("С");
					Кво = Ит.СНД("К");
				КонецЕсли;
				// на начало квартала (для метода "Налоговый")
				Если НачКвартала(ДатаДок) = НачМесяца(ДатаДок) Тогда
					// месяц - начало квартала
					Если Ит.ПолучитьСчет(,СчНУ) = 1 Тогда
						ПервСтоимостьНУ = Ит.СНД("С");
					КонецЕсли;
				Иначе
					//на начало месяца
					Если Ит.ПолучитьСчет(,Сч) = 1 Тогда
						ПервСтоимость = Ит.СКД("С");
						Кво = Ит.СКД("К");
					КонецЕсли;
					Если Ит.ПолучитьСчет(,СчНУ) = 1 Тогда
						ПервСтоимостьНУ = Ит.СКД("С");
					КонецЕсли;
				КонецЕсли;
				
				Износ = 0; ИзносНУ = 0;
				Если ИтИзн.ПолучитьСубконто(1,,НА)=1 Тогда
					// на начало квартала (для метода "Налоговый")
					Если НачКвартала(ДатаДок) = НачМесяца(ДатаДок) Тогда
						// месяц - начало квартала
						Если ИтИзн.ПолучитьСчет(,СчИзноса) = 1 Тогда
							Износ = ИтИзн.СНК("С");
						КонецЕсли;
						Если ИтИзн.ПолучитьСчет(,СчИзносаНУ) = 1 Тогда
							ИзносНУ = ИтИзн.СНК("С");
						КонецЕсли;
					Иначе
						//на начало месяца
						Если ИтИзн.ПолучитьСчет(,СчИзноса) = 1 Тогда
							Износ = ИтИзн.СКК("С");
						КонецЕсли;
						Если ИтИзн.ПолучитьСчет(,СчИзносаНУ) = 1 Тогда
							ИзносНУ = ИтИзн.СКК("С");
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если (Сч = СчетПоКоду("10")) или (Сч = СчетПоКоду("100")) Тогда                                     
			    Если (Кво = 0) И (ПервСтоимость = 0) Тогда
			    	Если (ПервСтоимостьНУ = 0) и (НА.Группа = 17) Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли (Кво <> 1) Тогда
					глНеПроводить(Контекст,Строка(Ит.Субконто(1))+": остаток количества на счете "+Сч+" не может быть отличным от 1!");
					Возврат;
			    КонецЕсли;
			КонецЕсли;
			
			ОстСтоимость = ПервСтоимость - Износ;
			ОстСтоимостьНУ = ПервСтоимостьНУ - ИзносНУ;
			СуммаИзноса = РассчитатьИзносПоЭлементу(НА,ПервСтоимость,ОстСтоимость,ПервСтоимостьНУ,ОстСтоимостьНУ,СчИзноса,Сч,СчИзносаНУ,СчНУ);
			
			ТекСчетЗатрат = НА.СчетЗатрат;
			ТекВидЗатрат = НА.ВидЗатрат;
			Если ПустоеЗначение(ТекВидЗатрат)=1 Тогда
			    ТекВидЗатрат = ВидЗатрат;
			КонецЕсли;
			
			фАналитикаОК = 1;
			Если (ПустоеЗначение(ТекВидЗатрат)=1) или (ПустоеЗначение(ТекСчетЗатрат)=1) Тогда
				глКомментарий(Строка(НА)+": не задан счет затрат или вид затрат",0,,"!");
				фАналитикаОК = 0;
			КонецЕсли;
			Если Сред(ТекСчетЗатрат.Код,1,2) = "23" Тогда
				Если глПроверитьАналитикуПоЗатратам(ТекПодразделение,НА.ВидДеятельности,,НА.Продукция,
					"а аналитика ""Подразделение"" для "+НА," реквизит ""Вид деятельности"" для "+НА," реквизит ""Заказ"" для "+НА," реквизит ""Продукция"" для "+НА)=0 Тогда
					фАналитикаОК = 0;
				КонецЕсли;
			КонецЕсли;
			Если фАналитикаОК = 0 Тогда
				глКомментарий("Износ по "+НА+" не начислен!",0,,"!");
				Продолжить;
			КонецЕсли;
			
			СуммаИзносаПроизв = 0;
			//Если  счет затрат равен "23" и суммы износа БУ и НУ отличаются - разницу списываем на 79 счет
			Если (Лев(ТекСчетЗатрат.Код, 2)="23") и (НА.Производственное = 1) и (СуммаИзноса <>0)  и (ДатаДок<'01.01.2015') Тогда
				глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,СчИзноса,СуммаИзносаНУ,"Начислен износ",,НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат,
				НА,,, ,,"НА");
				//разница
				глПроводкаПоЗатратам(Контекст,"791",СчИзноса,СуммаИзноса-СуммаИзносаНУ,"Начислен износ",, НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат,
				НА,,, ,,"НА");
				СуммаИзносаПроизв = СуммаИзносаНУ;
			Иначе	
				глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,СчИзноса,СуммаИзноса,"Начислен износ",, НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат,
				НА,,, ,,"НА");
				СуммаИзносаПроизв = СуммаИзноса;
			КонецЕсли;
			
			//налоговый учет
			Если НА.Производственное = 1 Тогда
				//начисленный износ
				глПровНУ(Контекст,,СчИзноса,СуммаИзносаНУ,"Начислен износ (НУ)",, ,,, НА,,, ,,"НА", СуммаИзносаНУ);
			КонецЕсли;
			Если (Константа.АмортизацияБУизНУ = Нет) Тогда  
				//корректировка затрат в НУ
				глПровНУ(Контекст,ТекСчетЗатрат,,СуммаИзносаНУ-СуммаИзноса,"Начислены затраты (НУ)",,НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат, ,,, ,,"НА",СуммаИзносаНУ-СуммаИзноса);
			КонецЕсли;
			
			ОбщаяСуммаИзноса = ОбщаяСуммаИзноса + СуммаИзноса;
			Если (Сред(ТекСчетЗатрат.Код,1,2) = "23") и (СуммаИзносаПроизв<>0) Тогда
			    // нужно отразить затраты в регистре 
				Рег  = Регистр.ПроизводственныеЗатраты;
				Рег.Фирма			 = Фирма;
				Рег.ВидДеятельности	 = НА.ВидДеятельности;
				Рег.Подразделение	 = ТекПодразделение;
				Рег.Продукция		 = НА.Продукция;
				Рег.ВидЗатрат		 = ТекВидЗатрат;
				Рег.Сумма			 = СуммаИзносаПроизв;
				Рег.КодОперации		 = ОтражениеЗатрат;
				Рег.ДвижениеПриходВыполнить();
			КонецЕсли;
		КонецЦикла; // ОС, НМА ...
	КонецЦикла; // Подразделения 
	//Для производственного метода с 01.11.09 износ начисляется со следующего дня

	// отберем по подразделениею только те ОС, НМА, необоротные активы 
	// по которым есть остатки по количеству
	ИтПоКоличеству = СоздатьОбъект("БухгалтерскиеИтоги");
	ИтПоКоличеству.ИспользоватьРазделительУчета(Фирма);
	Если ПустоеЗначение(Подразделение)=0 Тогда
		// фильтр по подразделению
		ИтПоКоличеству.ИспользоватьСубконто(ВидыСубконто.Подразделения,Подразделение,2);
	Иначе
		ИтПоКоличеству.ИспользоватьСубконто(ВидыСубконто.Подразделения);
	КонецЕсли;
	ИтПоКоличеству.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы); // ОС, НМА 
	ИтПоКоличеству.ВыполнитьЗапрос(НачМесяца(ДатаДок),КонМесяца(ДатаДок),Сч,,,,,"К");
	    
	спНА = СоздатьОбъект("СписокЗначений");
	ИтПоКоличеству.ВыбратьСубконто(2);
	Пока ИтПоКоличеству.ПолучитьСубконто(2) = 1 Цикл
		НА = ИтПоКоличеству.Субконто(2);
		НА.ИспользоватьДату(КонМесяца(ДатаДок),1); 
		Если НА.ДатаВвода < НачМесяца(ДатаДок) Тогда
			Продолжить;
		КонецЕсли;
		Если НА.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.СуммЕдиниц Тогда
			//на начало месяца
			Кво = ИтПоКоличеству.СКД("К");
			Если Кво > 0 Тогда
				спНА.ДобавитьЗначение(НА);    
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
		
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.Подразделения);
	
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы,спНА,2); // ОС, НМА 
	
	Ит.ВыполнитьЗапрос(НачМесяца(ДатаДок),КонМесяца(ДатаДок),Строка(Сч.Код)+";"+Строка(СчНУ.Код));
	
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1) = 1 Цикл

		ТекПодразделение = Ит.Субконто(1);
		
		Ит.ВыбратьСубконто(2);
		Пока Ит.ПолучитьСубконто(2) = 1 Цикл
			Если Сч = СчетПоКоду("10") Тогда      
				// Для счета 100 износ начисляем отдельно     
				СпрНА.ИспользоватьДату(ДатаДок,1);
				СпрНА.НайтиПоКоду(Ит.Субконто(2).Код);    
				Если СпрНА.Счет = СчетПоКоду("100") Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;	
			
			НА = Ит.Субконто(2);
			
			НА.ИспользоватьДату(КонМесяца(ДатаДок),1); 
			
			Если (НА.Состояние = Перечисление.СостоянияНеоборАктивов.НаКонсервации) 
			или (НА.Состояние = Перечисление.СостоянияНеоборАктивов.НаМодернизации)
			или (НА.Состояние = Перечисление.СостоянияНеоборАктивов.Подготовка)
			Тогда
				Продолжить;
			КонецЕсли;
				
			ДатаЗначения = ПолучитьПустоеЗначение("Дата");
			
			//на начало месяца
			Если Ит.ПолучитьСчет(,Сч) = 1 Тогда
				ПервСтоимость = Ит.СКД("С");
				Кво = Ит.СКД("К");
			КонецЕсли;
			ПервСтоимостьНУ = 0;
			Если Ит.ПолучитьСчет(,СчНУ) = 1 Тогда
				ПервСтоимостьНУ = Ит.СКД("С");
			КонецЕсли;
			Износ = 0;
			ИзносНУ = 0;
			
			Если (Сч = СчетПоКоду("10")) или (Сч = СчетПоКоду("100")) Тогда                                     
			    Если (Кво = 0) И (ПервСтоимость = 0) Тогда
			    	Если (ПервСтоимостьНУ = 0) и (НА.Группа = 17) Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли Кво <> 1 Тогда
					глНеПроводить(Контекст,Строка(Ит.Субконто(1))+": остаток количества на счете "+Сч+" не может быть отличным от 1!");
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			ОстСтоимость = ПервСтоимость - Износ;
			ОстСтоимостьНУ = ПервСтоимостьНУ - ИзносНУ;
			СуммаИзноса = РассчитатьИзносПоЭлементу(НА,ПервСтоимость,ОстСтоимость,ПервСтоимостьНУ,ОстСтоимостьНУ,СчИзноса,Сч,СчИзносаНУ,СчНУ);
				
			НА.ИспользоватьДату(КонМесяца(ДатаДок),1); 
			ТекСчетЗатрат = НА.СчетЗатрат;
			ТекВидЗатрат = НА.ВидЗатрат;
			Если ПустоеЗначение(ТекВидЗатрат)=1 Тогда
				ТекВидЗатрат = ВидЗатрат;
			КонецЕсли;
			
			фАналитикаОК = 1;
			Если (ПустоеЗначение(ТекВидЗатрат)=1) или (ПустоеЗначение(ТекСчетЗатрат)=1) Тогда
				глКомментарий(Строка(НА)+": не задан счет затрат или вид затрат",0,,"!");
				фАналитикаОК = 0;
			КонецЕсли;
			Если Сред(ТекСчетЗатрат.Код,1,2) = "23" Тогда
				Если глПроверитьАналитикуПоЗатратам(ТекПодразделение,НА.ВидДеятельности,,НА.Продукция,
				"а аналитика ""Подразделение"" для "+НА," реквизит ""Вид деятельности"" для "+НА," реквизит ""Заказ"" для "+НА," реквизит ""Продукция"" для "+НА)=0 Тогда
					фАналитикаОК = 0;
				КонецЕсли;
			КонецЕсли;
			Если фАналитикаОК = 0 Тогда
				глКомментарий("Износ по "+НА+" не начислен!",0,,"!");
				Продолжить;
			КонецЕсли;
			
			СуммаИзносаПроизв = 0;
			//Если  счет затрат равен "23" и суммы износа БУ и НУ отличаются - разницу списываем на 79 счет
			Если (Лев(ТекСчетЗатрат.Код, 2)="23") и (НА.Производственное = 1) и (СуммаИзноса <>0)  и (ДатаДок<'01.01.2015') Тогда
				глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,СчИзноса,СуммаИзносаНУ,"Начислен износ",,НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат,
				НА,,, ,,"НА");
				//разница
				глПроводкаПоЗатратам(Контекст,"791",СчИзноса,СуммаИзноса-СуммаИзносаНУ,"Начислен износ",, НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат,
				НА,,, ,,"НА"); 
				СуммаИзносаПроизв = СуммаИзносаНУ;
			Иначе	
				глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,СчИзноса,СуммаИзноса,"Начислен износ",, НА.ВидДеятельности,ТекПодразделение,ТекВидЗатрат,
				НА,,, ,,"НА");
				СуммаИзносаПроизв = СуммаИзноса;
			КонецЕсли;
			
			//налоговый учет
			Если НА.Производственное = 1 Тогда
				//начисленный износ
				глПровНУ(Контекст,,СчИзноса,СуммаИзносаНУ,"Начислен износ (НУ)",, ,,, НА,,, ,,"НА", СуммаИзносаНУ);
			КонецЕсли;

			ОбщаяСуммаИзноса = ОбщаяСуммаИзноса + СуммаИзноса;
			Если (Сред(ТекСчетЗатрат.Код,1,2) = "23") и (СуммаИзносаПроизв<>0) Тогда
				// нужно отразить затраты в регистре 
				Рег  = Регистр.ПроизводственныеЗатраты;
				Рег.Фирма			 = Фирма;
				Рег.ВидДеятельности	 = НА.ВидДеятельности;
				Рег.Подразделение	 = ТекПодразделение;
				Рег.Продукция		 = НА.Продукция;
				Рег.ВидЗатрат		 = ТекВидЗатрат;
				Рег.Сумма			 = СуммаИзносаПроизв;
				Рег.КодОперации		 = ОтражениеЗатрат;
				Рег.ДвижениеПриходВыполнить();
			КонецЕсли;
		КонецЦикла; // ОС, НМА ...
	КонецЦикла; // Подразделения 
КонецПроцедуры

// ===============================
Процедура ПроводкиБухгалтерскийУчет()
	ОбщаяСуммаИзноса = 0;
	// по основным средствам
	РассчитатьИзносПоСчету("10","13.1");
	// по инвестиционной недвижимости
	РассчитатьИзносПоСчету("100","13.5");        
	// по другим необоротным материальным активам
	РассчитатьИзносПоСчету("11","13.2");
	// по нематериальным активам
	РассчитатьИзносПоСчету("12","13.3");
	
	глПроводка(Контекст,"09",,ОбщаяСуммаИзноса,"Начислен износ",, ,,,
	,,, ,,"НА");
	
КонецПроцедуры

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);
	ДатаНачНУ = '31.03.11'; 

	Если ПроверкаШапки()=0 Тогда
	    глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли;
	
	ПроводкиБухгалтерскийУчет();
	
	Операция.СуммаОперации = 0; 
	Операция.Содержание = Примечание;	
	Операция.Записать();
	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры
