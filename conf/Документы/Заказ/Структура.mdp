Заказ: 
{
	Комментарий: "Заказ на продукцию от покупателя, или внутренний заказ на производство продукции"
	Синоним: "Заказ"
	Длина номера: 10
	Периодичность: В пределах года
	Тип номера: Текстовый
	Журнал документов: Журнал.Заказы
	Контроль уникальности номеров: Да
	Создавать операцию: Выборочно
	Автонумерация строк: Да
	Автоудаление движений: Да
	Разрешить проведение: Да
	Является основанием для: 
	{
		Ссылки: 
		{
			Документ.ВыпускПродукции
			Документ.ОказаниеУслуг
			Документ.РасходнаяНакладная
			Документ.СписаниеТМЦВПроизводство
			Документ.Счет
			Документ.ПриходнаяНакладнаяЗапасы
		}
	}
	Атрибуты шапки: 
	{
		Контрагент: 
		{
			Комментарий: "Заказчик продукции"
			Синоним: "Контрагент"
			Тип: Справочник
			Агрегатный тип: Справочник.Контрагенты
		}
		ПереработкаДавальческогоСырья: 
		{
			Комментарий: "Если = 1, то заказ на производство продукции из давальческого сырья"
			Синоним: "Переработка давальческого сырья"
			Тип: Число
			Длина: 1
			Неотрицательный: Да
		}
		СпособФормированияНалоговыхДокументов: 
		{
			Комментарий: "Если =  1 - налоговый накладные на каждый документ, 2 - налоговые документы за период"
			Синоним: "Способ формирования налоговых документов"
			Тип: Число
			Длина: 1
			Неотрицательный: Да
		}
	}
	Атрибуты табличной части: 
	{
		Продукция: 
		{
			Комментарий: "Заказываемая продукция"
			Синоним: "Продукция"
			Тип: Справочник
			Агрегатный тип: Справочник.ТМЦ
		}
		Ед: 
		{
			Комментарий: "Единица измерения"
			Синоним: "Ед"
			Тип: Справочник
			Агрегатный тип: Справочник.Единицы
		}
		Коэффициент: 
		{
			Комментарий: "Коэффициент пересчета в базовую единицу"
			Синоним: "К."
			Тип: Число
			Длина: 10
			Точность: 3
			Неотрицательный: Да
		}
		Кво: 
		{
			Комментарий: "Количество заказываемой продукции"
			Синоним: "Кол-во"
			Тип: Число
			Длина: 10
			Точность: 3
			Неотрицательный: Да
			Разделять триады: Да
		}
		НормыЗатрат: 
		{
			Комментарий: "Индивидуальные нормы затрат на продукцию выпускаемую по данному заказу"
			Синоним: "Нормы затрат"
			Тип: Документ
			Агрегатный тип: Документ.НормыЗатрат
		}
	}
}
