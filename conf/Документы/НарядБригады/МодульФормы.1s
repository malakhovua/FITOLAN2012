Перем СписокДействий;      
Перем НачальнаяДатаДокумента;

// ===============================
Процедура ОбработкаВыбораЗначения(ВыбЗнач,ИдентЭлемДиалога,ФлагСтандОбр)
	Если ИдентЭлемДиалога = "Заказ" Тогда
		Если глПроверитьФирму(Контекст,ВыбЗнач) = 0 Тогда
			ФлагСтандОбр = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ВводНового()
	глЗаполнитьШапку(Контекст);
КонецПроцедуры //ВводНового

Процедура ПриОткрытии()
	НачальнаяДатаДокумента = ДатаДок;
	глПроверкаДатыДок(Контекст,"Открытие");
	ПриЗаписиПерепроводить(1);

	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кЗаполнить.Доступность(0);
		Форма.кРассчитать.Доступность(0);
		Форма.кФирма.Доступность(0);               		
		Форма.кОчиститьПодразделение.Доступность(0);               		
		Форма.кОчиститьПродукция.Доступность(0);               		
		Форма.кОчиститьВидДеятельности.Доступность(0);               		
		Форма.кОчиститьЗаказ.Доступность(0);               		
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли;	

КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
КонецПроцедуры //ПриЗаписи

// ===============================
Процедура Заполнить()
	ТолькоПо23 = 0;
	Если Подразделение.Выбран() = 0 Тогда
		спВидЗаполнения = СоздатьОбъект("СписокЗначений");
		спВидЗаполнения.ДобавитьЗначение("ПоВсем","По всем сотрудникам");
		спВидЗаполнения.ДобавитьЗначение("ТолькоПроизводственный","Только по производственному персоналу");
		ВидЗаполнения = "";
		Если спВидЗаполнения.ВыбратьЗначение(ВидЗаполнения,,,,1) > 0 Тогда
			Если ВидЗаполнения = "ПоВсем" Тогда
				ТолькоПо23 = 0;
			ИначеЕсли ВидЗаполнения = "ТолькоПроизводственный" Тогда
				ТолькоПо23 = 1;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если КоличествоСтрок() > 0 Тогда
		Если Вопрос("Все существующие строки будут удалены. Продолжить?","Да+Нет") = "Да" Тогда
			УдалитьСтроки();
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекстЗапр = "//{{ЗАПРОС(ПоСотрудникам)
	|Сот = Справочник.Сотрудники.ТекущийЭлемент;
	|Под = Справочник.Сотрудники.ТекущийЭлемент.Подразделение;
	|Группировка Сот без групп;
	|Условие (Сот.Фирма = Фирма);
	|Условие (ДатаДок >= Сот.ДатаПриема);
	|Условие ((ПустоеЗначение(Сот.ДатаУвольнения)=1) ИЛИ (Сот.ДатаУвольнения >= ДатаДок));";
	Если Подразделение.Выбран() = 1 Тогда
	    ТекстЗапр = ТекстЗапр + "
		|Условие (Под = Подразделение);";
	КонецЕсли;
	ТекстЗапр = ТекстЗапр + "
	|";//}}ЗАПРОС
	
	Запр = СоздатьОбъект("Запрос");
	Если Запр.Выполнить(ТекстЗапр) = 0 Тогда
	    Предупреждение("Не выполнился запрос по сотрудникам!");
		Возврат;
	КонецЕсли;
	
	Пока Запр.Группировка("Сот") = 1 Цикл
		Сотр = Запр.Сот;
		Если ТолькоПо23 = 1 Тогда
			СчетЗатрат = Сотр.СчетЗатрат.Получить(ДатаДок);
			Если ПустоеЗначение(СчетЗатрат) = 1 Тогда
				Продолжить;
			ИначеЕсли Лев(СчетЗатрат.Код,2) <> "23" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока();
		Сотрудник = Сотр;
	КонецЦикла;
	Запр = 0;
КонецПроцедуры //Заполнить

// ===============================
Процедура Рассчитать()
	// определим веса
	чТарифВсего = 0; // сколько всего нужно для оплаты бригаде по тарифу

	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если Сотрудник.Выбран() = 0 Тогда
			глКомментарий("В строке " + НомерСтроки + " не выбран сотрудник!", 0);
			Вес = 0;
			Возврат;
		КонецЕсли;
		
		чКТУ = ?(УчитыватьКТУ = 1, КТУ, 1);
		чТариф = 1;
		чЧасы = ?(УчитыватьЧасы = 1, Часы, 1);
		Если (УчитыватьТариф = 1) или (ТолькоПриработок = 1) Тогда
		    чТариф = Сотрудник.Тариф.Получить(ДатаДок);
			чТарифВсего = чТарифВсего + чТариф*чЧасы;
			глКомментарий("Сотрудник "+Сотрудник+" (строка "+НомерСтроки+"). Всего по тарифу полагается "+чТариф*чЧасы, 3);
			Если УчитыватьТариф = 0 Тогда
			    чТариф = 1;
			КонецЕсли;
		КонецЕсли;
		
		Вес = чКТУ * чТариф * чЧасы;
	КонецЦикла;

	чСуммаКРаспределению = Сумма - ?(ТолькоПриработок = 1, чТарифВсего, 0);
	Если чСуммаКРаспределению <= 0  Тогда
	    глКомментарий("Для оплаты по тарифу необходимо " + СокрЛП(Формат(чТарифВсего,"Ч12.2"))+ " грн. Нечего распределять! Правильно заполните документ!",0);
		Возврат;
	Иначе
		глКомментарий("Сумма к распределению: " + СокрЛП(Формат(чСуммаКРаспределению,"Ч12.2"))+ " грн",3);
	КонецЕсли;

	// рассчитаем заработанные суммы
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		КоэфСотр = ?(Итог("Вес") = 0, 0, Вес/Итог("Вес"));
		Результат = КоэфСотр * чСуммаКРаспределению;
		Если НомерСтроки = КоличествоСтрок() Тогда
		    Результат = чСуммаКРаспределению - Итог("Результат") + Результат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры //Рассчитать

// ===============================
Функция УстДоступность()
	Форма.кОчиститьПодразделение.Доступность(Подразделение.Выбран());
	Форма.кОчиститьПродукция.Доступность(Продукция.Выбран());
	Форма.кОчиститьВидДеятельности.Доступность(ВидДеятельности.Выбран());
	Форма.кОчиститьЗаказ.Доступность(Заказ.Выбран());
	
	Форма.ТолькоПриработок.Видимость(УчитыватьЧасы);
	
	Форма.КТУ.Видимость(УчитыватьКТУ);
	Форма.Часы.Видимость(УчитыватьЧасы);

	Если Подразделение.Выбран() = 1 Тогда
		Форма.кЗаполнить.Заголовок("Заполнить");
	Иначе
		Форма.кЗаполнить.Заголовок("Заполнить...");
	КонецЕсли;
	
	Форма.кРассчитать.Доступность(Мин(КоличествоСтрок(),1)*?(Сумма = 0,0,1));
	Форма.Фирма.Видимость(0);
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	Форма.Заголовок(глЗаголовок(Контекст,"Наряд бригады"));

	Возврат "";
КонецФункции //УстДоступность

// ===============================
Процедура ИзмУчитыватьЧасы()
	Если УчитыватьЧасы = 0 Тогда
		ТолькоПриработок = 0;
	КонецЕсли;
КонецПроцедуры //ИзмУчитыватьЧасы

// ===============================
Процедура Печать()
	Таб = СоздатьОбъект("Таблица");
	СуффиксТаблицы = ?(глВосстановитьЗначение(,"ФормыНаУкраинском")= Да, "_Укр", "");
	Таб.ИсходнаяТаблица("Таблица"+СуффиксТаблицы);
	глУстПропись(Гривня);
	
	Таб.ВывестиСекцию("Шапка");

    ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Таб.ВывестиСекцию("Строка");
	КонецЦикла;

	Таб.ВывестиСекцию("Дно");
	
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.Опции(0,0,,);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Наряд бригады",);
	Таб = 0;
КонецПроцедуры //Печать

// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|ДвиженияДокумента,
	|СтруктураПодчиненности,
	|ОткрытьВЖурнале");