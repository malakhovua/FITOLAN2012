Перем СтарЧтоПродаем;
Перем СтарНалоговаяНакладная;
Перем СтарыйКонтрагент;
Перем НачальнаяДатаДокумента;
Перем СтараяДата,ЛьготаКод;

// ===============================
Процедура РассчитатьБазуНДС()
	НачВалюта = ?(ПустоеЗначение(Валюта)=1,Гривня,Валюта);
	НовИзмСуммыНДС = Окр(Окр(глПересчет(Итог("ИзмНДС"),        НачВалюта,Гривня,Курс,ДатаДок),3),2);
	НовИзмБазыНДС  = Окр(Окр(глПересчет(Итог("ИзмСуммыБезНДС"),НачВалюта,Гривня,Курс,ДатаДок),3),2);
	Если (НовИзмСуммыНДС <> ИзмСуммыНДС) Или (НовИзмБазыНДС <> ИзмБазыНДС) Тогда
		ИзмСуммыНДС = НовИзмСуммыНДС;
		ИзмБазыНДС  = НовИзмБазыНДС;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ВводНового()
	Предупреждение("Этот документ можно вводить только на основании Налоговой накладной!");
	СтатусВозврата(0);
КонецПроцедуры

// ===============================
Процедура ВводНаОсновании(ДокОсн)
	Если ДокОсн.Вид() <> "НалоговаяНакладная" Тогда
		// вводить документ можно только на основании НалоговойНакладной
		// остальные документы, отмеченные в "вводить на основании" используются
		// при выборе реквизита ДокументОснование
		Предупреждение("Документ """+Вид()+""" нельзя вводить на основании документа """+ДокОсн.Вид()+"""."+РазделительСтрок+"Возможно только выбирать его в качестве документа-основания в диалоге !");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;
		
	ВидНДС = ДокОсн.ВидНДС;
	ТолькоНулевыеСтавки = 0;
	Если ДокОсн.ЕстьНулевыеСтавкиНДС = 1 Тогда
		Спис = СоздатьОбъект("СписокЗначений");
		НДС20 = 0;
		НДС0  = 0;
		Если глПолучитьНиО(НДС20,"НДС20","о ставке НДС 20%") = 1 Тогда
			Спис.ДобавитьЗначение(НДС20);
		КонецЕсли;
		Если глПолучитьНиО(НДС0,"НДС0","о ставке НДС 0%") = 1 Тогда
			Спис.ДобавитьЗначение(НДС0);
		КонецЕсли;
		Спис.ВыбратьЗначение(ВидНДС,"Выберите вид НДС для ""приложения 1""",,,0);
		Если ВидНДС = НДС0 Тогда
			ТолькоНулевыеСтавки = 1;
		Иначе
			ТолькоНулевыеСтавки = 2;
		КонецЕсли;
	КонецЕсли;
	
	Фирма = ДокОсн.Фирма;
	глУстановитьНомер(Контекст);
	
	Договор = ДокОсн.Договор;
	ДокументОснование = ДокОсн.ДокументОснование;
	НалоговаяНакладная = ДокОсн;
	СпецРежимНалогообложения = ?(ДокОсн.СпецРежимНалогообложения = 7,0,ДокОсн.СпецРежимНалогообложения);
	УсловиеПродажи = ДокОсн.УсловиеПродажи;
	КатегорияЦен = ДокОсн.КатегорияЦен;
	ЧтоПродаем = ДокОсн.ЧтоПродаем;
	
	Валюта = ДокОсн.Валюта;
	Дата_Курса= ДокОсн.Дата_Курса;
	Курс = ДокОсн.Курс;
	
	Контрагент = ДокОсн.Контрагент;
	ФормаРасчетов = ДокОсн.ФормаРасчетов;
	Выписал = глВосстановитьЗначение(,"БазВыписалНН");
	ИтоговоеРозница = ДокОсн.ИтоговаяРозница;
	СпособПодгонки = ДокОсн.СпособПодгонки;
	НомСтр = 1;
	ДокОсн.ВыбратьСтроки();
	Пока ДокОсн.ПолучитьСтроку() <> 0 Цикл 
		Если (ТолькоНулевыеСтавки = 1) и (ДокОсн.НулеваяСтавкаНДС <> Да) Тогда
			Продолжить
		ИначеЕсли (ТолькоНулевыеСтавки = 2) и (ДокОсн.НулеваяСтавкаНДС = Да) Тогда
			Продолжить
		КонецЕсли;
		НоваяСтрока();
		НомерСтрокиНН = НомСтр;
		НомСтр = НомСтр + 1;
		ТМЦ = ДокОсн.ТМЦ;
		КодУКТВЭД = ДокОсн.КодУКТВЭД;
		НомерГТД = ДокОсн.НомерГТД;
		КодВидаСХ = ДокОсн.КодВидаСХ;
		Ед = ДокОсн.Ед;
		Кво = ДокОсн.Кво;
		ЦенаБезНДС = ДокОсн.ЦенаБезНДС;
		Коэффициент = ДокОсн.Коэффициент;
		СуммаБезНДС = ДокОсн.СуммаБезНДС;
		Если (ДокОсн.Кво <> 0) и (ДокОсн.Скидка <> 0) Тогда
			//будем пересчитывать цену только при наличии скидки
			ЦенаБезНДС = ДокОсн.СуммаБезНДС / (ДокОсн.Кво);
		Иначе	  
			ЦенаБезНДС = ДокОсн.ЦенаБезНДС;
		КонецЕсли;
	КонецЦикла; 
	Если (ДатаДок >= '01.01.2015') Тогда
		ЭлектронныйДокумент = 1;
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
	Если (ДатаДок >= '01.07.2015') Тогда
		ДатаРегВЕдРеестрНН = ДатаДок;
	КонецЕсли;
	//ДатаОплаты = ДокОсн.ДатаДок;
КонецПроцедуры
                         
// ===============================
Процедура ВыборОснования()
	// Процедура по кнопке редактирования основания в документе
	глРасшифровка = 0;
	ОткрытьФормуМодально("Обработка.ОснованиеДокумента", Контекст);
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()
	глПроверкаДатыДок(Контекст,"Открытие");
	ПриЗаписиПерепроводить(1);
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кФирма.Доступность(0);
		Форма.кВалюта.Доступность(0);
		Форма.кОснование.Доступность(0);
		Форма.кОчиститьРодительскийДокумент.Доступность(0);
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли; 
	НачальнаяДатаДокумента = ДатаДок;СтараяДата = ДатаДок;
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	СтарЧтоПродаем = ЧтоПродаем;	
	СтарыйКонтрагент = Контрагент;
	глУстВидимостьЦен(Контекст);
	Если (ДатаДок >= '01.01.2015') и (ЭлектронныйДокумент = 0) Тогда
		ЭлектронныйДокумент = 1;
	КонецЕсли;
	Если (ДатаДок >= '01.01.2015') и (ТребуетВклВЕдРеестрНН = 0) Тогда
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
КонецПроцедуры
// ======================================
Процедура ПроверкаТребуетВклВЕдРеестрНН()
	РегистрируетсяВЕРННПокупателем = 0;
	Если (ДатаДок >= '01/01/2015') Тогда
		// все налоговые должны регистрироваться в Едином реестре
		НДСРегл = Итог("ИзмНДС");
		Если ПустоеЗначение(НалоговаяНакладная) = 0 Тогда
			Если (НалоговаяНакладная.Оставляем = 0) и (НалоговаяНакладная.ДатаДок >= '01/02/2015') и (НДСРегл < 0) Тогда
				РегистрируетсяВЕРННПокупателем = 1;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли (НалоговаяНакладная.Оставляем = 1) или (ЕРНН = 1) Тогда
		// мы не управляем флажком ТребуетВключенияВЕдиныйРеестрНалоговыхНакладных
		// для налоговых накладных, которые не выдаются покупателю
		// согласно разъяснению ЕБНЗ такие налоговые не должны регистрироваться в Едином реестре
	ИначеЕсли (ЭлектронныйДокумент = 1)  и (ДатаДок >= '01/03/2014') Тогда	
		ТребуетВклВЕдРеестрНН = 1; 
		Сообщить("Требуется включение документа Приложение 2 № "+ СокрЛП(НомерДок)+" от "+ ДатаДок  + " в единый реестр налоговых накладных!", "!"); 
	Иначе	
		// поставим флаг "Требует регистрация в реестре"
		ТребуетВклВЕдРеестрНН = 0; 
		Если НалоговаяНакладная.ТребуетВклВЕдРеестрНН = 1 Тогда
			ТребуетВклВЕдРеестрНН = 1; 
		Иначе
			НДСРегл = Итог("ИзмНДС");
			Если ДатаДок >= '01.01.12' Тогда
				// или сумма НДС в документе больше 10 000 грн
				Если НДСРегл > 10000 Тогда
					ТребуетВклВЕдРеестрНН = 1;
					
				// или имеются подакцизные/импортированные товары
				// этот факт определим так - если в строке указан код УКТЗЭД - считаем что условие выполняется.
				Иначе   
					ВыбратьСтроки();
					Пока ПолучитьСтроку() = 1 Цикл
						Если ПустоеЗначение(КодУКТВЭД) = 0 Тогда
							ТребуетВклВЕдРеестрНН = 1;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			ИначеЕсли ДатаДок >= '01.07.11' Тогда
				// сумма НДС в документе больше 100 000 грн
				Если НДСРегл > 100000 Тогда
					ТребуетВклВЕдРеестрНН = 1;
				КонецЕсли;
			ИначеЕсли ДатаДок >= '01.04.11' Тогда
				// сумма НДС в документе больше 500 000 грн
				Если НДСРегл > 500000 Тогда
					ТребуетВклВЕдРеестрНН = 1;
				КонецЕсли;
			ИначеЕсли ДатаДок >= '01.01.11' Тогда
				// сумма НДС в документе больше 1 000 000 грн
				Если НДСРегл > 1000000 Тогда
					ТребуетВклВЕдРеестрНН = 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ТребуетВклВЕдРеестрНН = 1 Тогда
			Сообщить("Требуется включение документа Приложение 2 № "+ СокрЛП(НомерДок)+" от "+ ДатаДок  + " в единый реестр налоговых накладных!", "!"); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 
// ===============================
Процедура ИзмДатаДок()
	Если  (Константа.ВестиМесячнуюНумерациюНалоговыхДокументов.Получить(ДатаДок) = 1) 
	  ИЛИ (Константа.ВестиМесячнуюНумерациюНалоговыхДокументов.Получить(СтараяДата) = 1) Тогда
		Если (ДатаГод(ДатаДок) * 12 +  ДатаМесяц(ДатаДок)) <> (ДатаГод(СтараяДата) * 12 +  ДатаМесяц(СтараяДата)) Тогда
			глУстановитьНомер(Контекст);
		КонецЕсли;
	КонецЕсли;	
	глПриИзмененииДатыДокумента(Контекст, СтараяДата); 
	Если (ДатаДок >= '01.01.2015') Тогда
		ЭлектронныйДокумент = 1;
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
	Если (ДатаДок >= '01.07.2015') Тогда
		ДатаРегВЕдРеестрНН = ДатаДок;
	КонецЕсли;
КонецПроцедуры //

// ===============================
Процедура ИзмИзмКво()
	// При изменении количества
	Если ИзмКво <> 0 Тогда
		Если ИзмЦены <> 0 Тогда
		    ИзмЦены = 0;
		    Предупреждение("Разрешается корректировать или цену или количество!");
		КонецЕсли;
	КонецЕсли;
	глВыч_суммы_накл(Контекст,0);
КонецПроцедуры

// ===============================
Процедура ИзмИзмЦены()
	Если ИзмЦены <> 0 Тогда
		Если ИзмКво <> 0 Тогда
		    ИзмКво = 0;
		    Предупреждение("Разрешается корректировать или цену или количество!");
		КонецЕсли;
	КонецЕсли;
	глВыч_суммы_накл(Контекст,0);
КонецПроцедуры

// ===============================
Процедура ИзмТМЦ()
	Если ТМЦ.Вид()="ТМЦ" Тогда
		глПриИзмененииТовара(Контекст);
	Иначе // необоротные активы
		глУстановкаБазЕд(Контекст, , ТМЦ.БазЕдиница);
		ЦенаБезНДС = глПересчет(ТМЦ.Цена_Прих,Гривня,Валюта,ДатаДок);
		глВыч_суммы_накл(Контекст,-1);		
	КонецЕсли;
КонецПроцедуры //
                                           
// ======================================
Процедура ИзмВидНДС()
	// пересчитаем суммы НДС в строках табличной части
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаБезНДС Тогда
			глВыч_Суммы_Накл(Контекст,-1);
		Иначе
			глВыч_Суммы_Накл(Контекст,1);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

// ======================================
Процедура ИзмНалоговаяНакладная()
	Если ПустоеЗначение(НалоговаяНакладная) = 0 Тогда
		ВводНаОсновании(НалоговаяНакладная);
	Иначе
		НалоговаяНакладная = СтарНалоговаяНакладная;
	КонецЕсли;	
КонецПроцедуры                                                      

// ===============================
Процедура ИзмДоговор()
	Если Договор.Выбран() = 1 Тогда
		Если Договор.Вид() = "Договор" Тогда
			Валюта_Прежн = Валюта;
			Валюта = Договор.Валюта;
			Если Валюта <> Валюта_Прежн Тогда
				Дата_Курса=ДатаДок;
				Курс_Прежн = Курс;
				Курс = глКурсДляВалюты(Валюта,ДатаДок);
				Если ((Валюта_Прежн <> Валюта) Или (Курс_Прежн <> Курс)) Тогда
					// что-то изменилось, надо пересчитать цены
					глУстан_Вал(Контекст, Валюта, Валюта_Прежн, Курс, Курс_Прежн);
				КонецЕсли;
			КонецЕсли;
			ВидТорговли = Договор.ВидТорговли;
			ВидНДС = Договор.ВидНДС;
		КонецЕсли;
	КонецЕсли;    
КонецПроцедуры

// ======================================
Процедура ИзмКонтрагент()
	Если Контрагент.Выбран() = 0 Тогда
	    Возврат;
	КонецЕсли;	
	Если СтарыйКонтрагент <> Контрагент Тогда
		// изменили Контрагента
		Если Договор.Выбран() = 1 Тогда
			Если Договор.Контрагент <> Контрагент Тогда
				Договор = 0;
			КонецЕсли;
		КонецЕсли;    
		Если Договор.Выбран() = 0 Тогда
			Если (Фирма = Контрагент.БазДоговор.Фирма) и (глВосстановитьЗначение(,"ПодставлятьОсновнойДоговор")=Да) Тогда
				Договор = Контрагент.БазДоговор;
			КонецЕсли;
			Если ПустоеЗначение(Контрагент.ВидТорговли) = 0 Тогда
				ВидТорговли = Контрагент.ВидТорговли;
			ИначеЕсли ПустоеЗначение(ВидТорговли) = 1 Тогда
				ВидТорговли = глВосстановитьЗначение(,"ОсновнойВидТорговли");
			КонецЕсли;	
			ИзмДоговор();
		КонецЕсли;       
		// проверим документ-основание
		Если ПустоеЗначение(ДокументОснование) = 0 Тогда
			Если ДокументОснование.Контрагент <> Контрагент Тогда
				ДокументОснование = 0;
			КонецЕсли;	
		КонецЕсли;
		// проверим налоговую
		Если ПустоеЗначение(НалоговаяНакладная) = 0 Тогда
			Если НалоговаяНакладная.Контрагент <> Контрагент Тогда
				НалоговаяНакладная = 0;
				ИзмНалоговаяНакладная();
			КонецЕсли;	
		КонецЕсли;
		Если ПустоеЗначение(Контрагент.КатегорияЦен) = 0 Тогда
			КатегорияЦен = Контрагент.КатегорияЦен;
		Иначе
			КатегорияЦен = глВосстановитьЗначение(,"ОсновнаяКатегорияЦен");
		КонецЕсли;
	КонецЕсли;     
	СтарыйКонтрагент = Контрагент;
КонецПроцедуры
// ======================================
Процедура ИзмУточняющийРасчет()  
	Если УточняющийРасчет = 1 Тогда
		Сообщить("При установленном флажке ""Включено в уточняющий расчет к Декларации по НДС"""
		"документ не будет отражаться в отчете ""Декларация по НДС"". ", "!"); 
		Сообщить("Необходимо вручную заполнить отчет ""Уточняющий расчет к Декларации по НДС"".", "!"); 
	КонецЕсли;
КонецПроцедуры
// ===============================
Функция ФРМЦена(ЧислЗнач)
	// без разделения на триады, не меньше двух и не больше пяти знаков после запятой
	Стр=СокрЛ(Формат(Окр(ЧислЗнач,5),"Ч15.5"));
	Для Инд=1 по 3 Цикл
		Если Прав(Стр,1)="0" Тогда
		    Стр = Лев(Стр,СтрДлина(Стр)-1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Стр;
КонецФункции
// ===============================
Функция ДатаДляПечати(ДатаД)
	Возврат Формат(ДатаЧисло(ДатаД),"Ч(0)2")+Формат(ДатаМесяц(ДатаД),"Ч(0)2")+Строка(ДатаГод(ДатаД))
КонецФункции
//============================
Функция ПолучитьЛьготу(ТекТМЦ = "", ЛьготаНДС, КодЛьготы)
	Если ПустоеЗначение(ЛьготаНДС) = 0 Тогда
		Льгота = ЛьготаНДС.Наименование;
		ЛьготаКод = КодЛьготы;
	ИначеЕсли ТекТМЦ.Вид() = "ТМЦ" Тогда   
		Льгота = ТекТМЦ.ЛьготаНДС.Наименование;
		ЛьготаКод = ТекТМЦ.КодЛьготы;
	КонецЕсли;
	Если ПустоеЗначение(ЛьготаКод) = 1 Тогда
		ЛьготаКод = "99999999";
	КонецЕсли;
	
	Поз = Найти(Льгота, "(");
	Если Поз>0 Тогда
		Льгота = Лев(Льгота, Поз-1)
	КонецЕсли;
	
	Возврат Льгота;		
КонецФункции
// ===============================
Процедура Печать2016() 
	Перем ТипФормы;
	
	НеДополнятьНазваниеНомеромГТД = Да; 
	ТипыФорм = СоздатьОбъект("СписокЗначений");
	ТипыФорм.ДобавитьЗначение(1,"Приложение 2");
	ТипыФорм.ДобавитьЗначение(2,"Приложение 2 (портрет)");
	Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
		Возврат;
	КонецЕсли;          
	Если ДатаДок >= '01/03/2017' Тогда  
		Суффикс = "_2017"; 
		Если ТипФормы = 2 Тогда
			Суффикс = "_17"; 
		КонецЕсли;  
	Иначе
		Суффикс = "_2016"; 
		Если ТипФормы = 2 Тогда
			Суффикс = "_16"; 
		КонецЕсли;
	КонецЕсли;
	ПечататьДатыСРазделителями = Нет;  
	Если (Модифицированность() = 1) или (Проведен()=0) Тогда
		ПроверкаТребуетВклВЕдРеестрНН(); 
	КонецЕсли;
	ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия);
	СотрИНН = Выписал.ИНН; 

  	ФирмаНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
	ФирмаПолнНаименование = Фирма.ПолнНаименование;
	НомерНН = глНомерБезПрефикса(НалоговаяНакладная.НомерДок);
	НомерНН = Прав("      "+НомерНН,7); 
	НомДок = глНомерБезПрефикса(НомерДок);
	НомДок = Прав("       "+НомДок,7);         
	ПечСпецРежимНалогообложения = ?(НалоговаяНакладная.СоглашениеОРазделеПродукции = 1,5,СпецРежимНалогообложения);
	КонтрагентПолнНаименование = ?(НалоговаяНакладная.КорГрафы5 = 1,НалоговаяНакладная.Графа5,Контрагент.ПолнНаименование);        
	КонтрагентКодФил = ?(Контрагент.КодФилиала = 0,"",Прав("    "+СокрЛП(Контрагент.КодФилиала),4));

	Сводная = 0;  
	ТипПричиныИнд = ?(НалоговаяНакладная.Оставляем = 1,Число(Сред(НалоговаяНакладная.ТипПричины,2,2)),0);
	Если (НалоговаяНакладная.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
		//тип причины: 14
		ФирмаПолнНаименование = СокрЛП(?(НалоговаяНакладная.КорГрафы5 = 1,НалоговаяНакладная.Графа5,Контрагент.ПолнНаименование))+ ", " + СокрЛП(Контрагент.Регион);        
		ФирмаНалогНомер = "500000000000";
		КонтрагентПолнНаименование = Фирма.ПолнНаименование;
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 12) Тогда
		//Дипломатическое представительство, тип причины 12 
		КонтрагентНалогНомер = "200000000000";
		
	ИначеЕсли (ТипПричиныИнд = 2) или (ТипПричиныИнд = 11) или (ТипПричиныИнд = 1) Тогда
		//тип причины: 02, 11
		КонтрагентПолнНаименование = "Неплатник";
		КонтрагентНалогНомер = "100000000000";
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 7) Тогда
		//тип причины: 07, Экспорт
		КонтрагентПолнНаименование = СокрЛП(КонтрагентПолнНаименование) + ", " + СокрЛП(Контрагент.Регион);
		КонтрагентНалогНомер = "300000000000";
		
	ИначеЕсли (ТипПричиныИнд = 10) Тогда
		//тип причины: 10
		КонтрагентНалогНомер = ?(ДатаДок >= '01/03/2017',"600000000000","400000000000");
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 15) Тогда
		//тип причины: 15
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 4) или (ТипПричиныИнд = 8) или (ТипПричиныИнд = 9) или (ТипПричиныИнд = 13) Тогда
		//тип причины: 04, 08, 09, 13  Зведена
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентНалогНомер = "600000000000";
		ПечСводная = "X";  
		Сводная = 1;  
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд > 2) Тогда
		//тип причины: 03, 05, 06
		КонтрагентНалогНомер = "400000000000";
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	Иначе
		КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, "100000000000",  Прав("           " + СокрЛП(Контрагент.ИНН),12));
	КонецЕсли;
	
	ТекстДополненияГр3 = ?(НалоговаяНакладная.СоглашениеОРазделеПродукции = 1," розподіл сум податкового кредиту за багатосторонньою угодою про розподіл продукції","");

	ПечОсвоб = ""; ПечСтавка = "";
	Если (Сводная = 0) и (НалоговаяНакладная.СоглашениеОРазделеПродукции = 0) Тогда
		Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
			ПечСтавка = "903";
			ПечОсвоб = "Без ПДВ";
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС20") Тогда	
			ПечСтавка = "20";
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") Тогда	
			ПечСтавка = "7";
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС0") Тогда	
			ПечСтавка = ?(ТипПричиныИнд = 7,"901","902");
		КонецЕсли;	
	КонецЕсли;	
	ПечСводная = ?(НалоговаяНакладная.Итоговая = 1,"X",ПечСводная);  

	Таб = СоздатьОбъект("Таблица");
	ИмяФайлаПечатнойФормы = КаталогИБ()+"ExtForms\PrnForms\P2_ukr"+Суффикс+".mxl";
	Если ФС.СуществуетФайл(ИмяФайлаПечатнойФормы) = 1 Тогда
		Таб.ИсходнаяТаблица(ИмяФайлаПечатнойФормы);
	Иначе
		Таб.ИсходнаяТаблица("Таблица_Укр"+Суффикс);
	КонецЕсли;
	
	РегистрПост = ?(РегистрируетсяВЕРННПокупателем = 1, "","Х");
	РегистрПокупатель = ?(РегистрируетсяВЕРННПокупателем = 1, "Х","");
	ОстаетсяПеч = ?(НалоговаяНакладная.Оставляем = 1, "Х","");  
	ТипПричиныПеч = ?(НалоговаяНакладная.Оставляем = 1,Сред(НалоговаяНакладная.ТипПричины,2,2),"");
	Таб.ВывестиСекцию( "Оригинал" );

	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));
	// инициализация алгоритмов корректого округления
	глОчиститьКлючОкр("ИзмСуммыБезНДС");
	глОчиститьКлючОкр("ИзмНДС");

	ПечИтогНДС = Формат(глПересчет(Итог("ИзмНДС"),Валюта,Курс,Гривня,ДатаДок,Дата_Курса),"Ч013.2");
	ПечИтогБезНДС = ""; ПечИтогБезНДС03 = ""; ПечИтогБезНДС02 = "";
	ПечИтогБезНДС02 = ""; ПечИтогБезНДС20 = ""; ПечИтогНДС20 = ""; 
	ПечИтогБезНДС7 = ""; ПечИтогНДС7 = ""; ПечИтогБезНДС01 = "";  
	Если НалоговаяНакладная.СоглашениеОРазделеПродукции = 0 Тогда
		ИтогСуммаБезНДС = глПересчет(Итог("ИзмСуммыБезНДС"),Валюта,Курс,Гривня,ДатаДок,Дата_Курса);
		ПечИтогБезНДС = Формат(ИтогСуммаБезНДС,"Ч013.2");
		Если (Сокрлп(ВидНДС.Код) = "БезНДС") и (Сводная = 0) Тогда	
			ПечИтогБезНДС03 = ПечИтогБезНДС;
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС20") Тогда	
			ПечИтогБезНДС20 = ПечИтогБезНДС;
			ПечИтогНДС20 = ПечИтогНДС;
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") Тогда	
			ПечИтогБезНДС7 = ПечИтогБезНДС;
			ПечИтогНДС7 = ПечИтогНДС;
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС0") и (Сводная = 0) Тогда
			Если ТипПричиныИнд = 7 Тогда
				ПечИтогБезНДС01 = ПечИтогБезНДС;
			Иначе	
				ПечИтогБезНДС02 = ПечИтогБезНДС;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
		
	Таб.ВывестиСекцию( "Шапка" );   
	Таб.ВывестиСекцию( "Шапка2" ); 
		
	НомСтр = 1;
	ИтогПоЛьготам = "";
	ВыбратьСтроки();
	Пока ( ПолучитьСтроку() > 0 ) Цикл
		Ст2 = Причина;
		ТекстГТД = "";
		Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(НомерГТД) = 0) Тогда 
			//дополняем текст ГТД  
			Если ПечататьДатыСРазделителями = Да Тогда
				ДатаГ = НомерГТД.ДатаГТД;
			Иначе //по умолчанию без разделителей
				ДатаГ = ДатаДляПечати(НомерГТД.ДатаГТД);
			КонецЕсли; 
			ТекстГТД = ". ВМД №: " + НомерГТД + ", ВМД дата: " + ДатаГ;  
		КонецЕсли;
		Ст3 = СокрЛП(ТМЦ.ПолнНаименование) + ТекстГТД;  
		КодДляНН = КодУКТВЭД;
		ВидКода = КодДляНН.Вид;
		Ст4 = ?(ВидКода <> Перечисление.ВидыКодовДляНН.Услуга,СтрЗаменить(КодДляНН,".",""),""); 
		Ст42 = ?(ВидКода = Перечисление.ВидыКодовДляНН.ИмпортированныйТовар,"X",""); 
		Ст43 = ?(ВидКода = Перечисление.ВидыКодовДляНН.Услуга,КодДляНН,"");
		Ст14 = ?(НалоговаяНакладная.СпецРежимНалогообложения = 2, КодВидаСХ, "");

		Ст5 = ?(ТМЦ.Вид()="ТМЦ",Ед.Единица, "шт");
		Ст5 = ?(Сводная = 1,"грн",Ст5);
		Ст6 = ?(ТМЦ.Вид()="ТМЦ",Ед.Единица.КодЕдИзмерения,"2009");
		Ст6 = ?(Сводная = 1,"",Ст6);
		Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
			СтатьяЛьготы = ПолучитьЛьготу(ТМЦ, НалоговаяНакладная.ЛьготаНДС,НалоговаяНакладная.КодЛьготы);
			Если ЛьготаКод = "99999999" Тогда
				Если ИтогПоЛьготам = "" Тогда
					ИтогПоЛьготам = СтатьяЛьготы;
				ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
					ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	

		КвоТМЦ = ФРМЦена(Кво);
			
		Ст7 = "";   
		Ст8 = "";   
		Ст9 = "";
		Ст10 = "";
		Если НалоговаяНакладная.СоглашениеОРазделеПродукции = 0 Тогда
			Если ИзмКво <> 0 Тогда
				ТекКво = ИзмКво;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда       
					ТекЦенаБезНДС = ЦенаСНДС * КоэфБезНДС;
				Иначе
					ТекЦенаБезНДС = ЦенаБезНДС;
				КонецЕсли;                  
			Иначе
				ТекКво = Кво;
				ТекЦенаБезНДС = ИзмЦены;
			КонецЕсли;
			ЦенаБезНДСГрн	  = Окр(                       глПересчет(ТекЦенаБезНДС, Валюта,Курс,Гривня,ДатаДок,Дата_курса),3);
			// рассчитываем суммы с учетом накопленных погрешностей округления
			ИзмСуммыБезНДСГрн = глОкрКорр("ИзмСуммыБезНДС",глПересчет(ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаДок,Дата_Курса),3);
			ИзмНДСГрн         = глОкрКорр("ИзмНДС",        глПересчет(ИзмНДС,        Валюта,Курс,Гривня,ДатаДок,Дата_Курса),3);
			
			// подберем цену и количество по указанному в шапке способу
			глПодогнатьЦенаКоличество(ИзмСуммыБезНДСГрн, ЦенаБезНДСГрн, ТекКво, СпособПодгонки);
		
			Если Сводная = 1 Тогда
				ЛьготаКод = ""; ИтогПоЛьготам = "";
			Иначе	
				Если ИзмКво<>0 Тогда
					Ст7  = ФРМЦена(ТекКво);
					Ст8  = ФРМЦена(ЦенаБезНДСГрн);
				Иначе
					Ст9  = ФРМЦена(ЦенаБезНДСГрн);
					Ст10 = КвоТМЦ;
				КонецЕсли;
			КонецЕсли;
			Ст13 = Формат(ИзмСуммыБезНДСГрн,"Ч12.2");
		Иначе //СоглашениеОРазделеПродукции = 1	
			ЛьготаКод = ""; ИтогПоЛьготам = ""; 
			Ст5 = ""; Ст6 = ""; Ст4 = "";
		КонецЕсли;

		Таб.ВывестиСекцию("Строка");
		НомСтр = НомСтр+1;
	КонецЦикла;  
		
	Таб.ВывестиСекцию("Подвал");
	Если НомСтр > 9999 Тогда
		Сообщить("Документ должен содержать не более 9999 строк.В данном документе ограничение превышено.","!");
	КонецЕсли;


	Таб.Опции(0, 0, 0, 0); 
	Если ТипФормы = 1 Тогда
		Таб.ПараметрыСтраницы(2,,,,,,,,);
	Иначе	
		Таб.ПараметрыСтраницы(1,,,,,,,,);
	КонецЕсли;
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Печать расчета корректировки", "");
КонецПроцедуры
// ===============================
Процедура Печать2011() 
	Перем ТипФормы;
	НеДополнятьНазваниеНомеромГТД = Да; 
	ПечКодУКТВЭДбезПробелов = 1;
	ПустойИНН = ?(ДатаДок >= '01/03/2014',"400000000000","           0");
	КолСтр = 2;
	Если ДатаДок >= '01/01/2015' Тогда
		Суффикс = "_2015"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Приложение 2");
		ТипыФорм.ДобавитьЗначение(2,"Приложение 2 (портрет)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_15"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Нет;  
		Если (Модифицированность() = 1) или (Проведен()=0) Тогда
			ПроверкаТребуетВклВЕдРеестрНН(); 
		КонецЕсли;
		ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия);
		КолСтр = 1;
	ИначеЕсли ДатаДок >= '01/12/2014' Тогда
		Суффикс = "_1412l"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Приложение 2");
		ТипыФорм.ДобавитьЗначение(2,"Приложение 2 (портрет)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_1412"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Нет;  
		Если (Модифицированность() = 1) или (Проведен()=0) Тогда
			ПроверкаТребуетВклВЕдРеестрНН(); 
		КонецЕсли;
		ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия);
	ИначеЕсли ДатаДок >= '01/03/2014' Тогда
		Суффикс = "_2014"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Приложение 2");
		ТипыФорм.ДобавитьЗначение(2,"Приложение 2 (портрет)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_14"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Нет;  
		Если (Модифицированность() = 1) или (Проведен()=0) Тогда
			ПроверкаТребуетВклВЕдРеестрНН(); 
		КонецЕсли;
		ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия);
	ИначеЕсли ДатаДок >= Константа.ДатаННДек2011 Тогда
		Суффикс = "_2012"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Приложение 2");
		ТипыФорм.ДобавитьЗначение(2,"Приложение 2 (портрет)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_12"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Константа.ПечататьДатыВННСРазд;
		НеДополнятьНазваниеНомеромГТД = Константа.НеДополнНаимНомГТДВНН; 
	Иначе	
		Суффикс = "_2011";
		ТипФормы = 1;
		ПечататьДатыСРазделителями = Да;
	КонецЕсли;

  	ФирмаНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
	ФирмаПолнНаименование = Фирма.ПолнНаименование;
	ФирмаАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
	КонтрагентНалогНомер = ?((ПустоеЗначение(Контрагент.ИНН)=1) ИЛИ ((НалоговаяНакладная.Оставляем = 1) И (Сред(НалоговаяНакладная.ТипПричины, 2, 2) = "02")),  ПустойИНН, Прав("           " + СокрЛП(Контрагент.ИНН),12));
	КонтрагентНомСвид = ?((ПустоеЗначение(Контрагент.НомерСвидетельства)=1) ИЛИ ((НалоговаяНакладная.Оставляем = 1) И (Сред(НалоговаяНакладная.ТипПричины, 2, 2) = "02")),  "        0", Контрагент.НомерСвидетельства);
	ФирмаТел = Фирма.Телефоны.Получить(ДатаДок);
	Если Найти(ФирмаТел,",") <> 0 Тогда
		ФирмаТел = Лев(ФирмаТел,Найти(ФирмаТел,",")-1);
	ИначеЕсли Найти(ФирмаТел,";") <> 0 Тогда	
		ФирмаТел = Лев(ФирмаТел,Найти(ФирмаТел,";")-1);  
	КонецЕсли;
	ФирмаТел = СтрЗаменить(ФирмаТел,"-","");
	ФирмаТел = СтрЗаменить(ФирмаТел," ","");
	ФирмаТел = СтрЗаменить(ФирмаТел,")","");
	ФирмаТел = СтрЗаменить(ФирмаТел,"(","");
	ФирмаТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
	Если Найти(Контрагент.Телефоны,",") <> 0 Тогда
		КонтрТел = Лев(Контрагент.Телефоны,Найти(Контрагент.Телефоны,",")-1);
	ИначеЕсли Найти(Контрагент.Телефоны,";") <> 0 Тогда	
		КонтрТел = Лев(Контрагент.Телефоны,Найти(Контрагент.Телефоны,";")-1);  
	Иначе	
		КонтрТел = Контрагент.Телефоны;  
	КонецЕсли;
	КонтрТел = СтрЗаменить(КонтрТел,"-","");
	КонтрТел = СтрЗаменить(КонтрТел," ","");
	КонтрТел = СтрЗаменить(КонтрТел,")","");
	КонтрТел = СтрЗаменить(КонтрТел,"(","");
	КонтрагентТелефоны = Прав("         " + СокрЛП(КонтрТел),10);
	КонтрагентПолнНаименование = ?(НалоговаяНакладная.КорГрафы5 = 1,НалоговаяНакладная.Графа5,Контрагент.ПолнНаименование);        
	КонтрагентАдрес = Контрагент.ЮридическийАдрес;
	                           
	НН_НомерДок = глНомерБезПрефикса(НалоговаяНакладная.НомерДок);
	НН_ДатаДок  = НалоговаяНакладная.ДатаДок;
	НомерНН = Прав("      "+НН_НомерДок,7); 
	П2_НомерДок = глНомерБезПрефикса(НомерДок);
	НомДок = Прав("       "+П2_НомерДок,8);         
	НомерДог =  НалоговаяНакладная.НомДог;    
	ДатаДог = НалоговаяНакладная.ДатаДог; 
	
	Таб = СоздатьОбъект("Таблица");
	Таб.ИсходнаяТаблица("Таблица_Укр"+Суффикс);
	ВидНомДогов = Константа.ВидНомДоговНН;
	ПустаяЯчейка = ?(ДатаДок >= '01/03/2014',"",Константа.ПустаяЯчейкаНалДок);
	
	// переменные-акселераторы
	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));

	ТипПричиныИнд = ?(НалоговаяНакладная.Оставляем = 1,Число(Сред(НалоговаяНакладная.ТипПричины,2,2))-1,0);
	Если (НалоговаяНакладная.ДатаДок < '01/12/2014')  Тогда 
		Если (НалоговаяНакладная.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента)  Тогда 
			ФирмаПолнНаименование = ?(НалоговаяНакладная.КорГрафы5 = 1,НалоговаяНакладная.Графа5,Контрагент.ПолнНаименование);        
			ФирмаАдрес = КонтрагентАдрес;
			ФирмаТелефоны = КонтрагентТелефоны; 
			Если НалоговаяНакладная.ДатаДок >= Константа.ДатаННДек2011 Тогда
				Если НалоговаяНакладная.УслугиДляНеХозДеят = 1 Тогда
					ФирмаНалогНомер = "200000000000";
				Иначе	
					ФирмаНалогНомер = "300000000000";
				КонецЕсли;
				КолСтр = 1;
			КонецЕсли;
			ФирмаНомСвид    = "         0";  
			
			КонтрагентПолнНаименование = Фирма.ПолнНаименование;
			КонтрагентАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
			КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
			КонтрагентНомСвид = Прав("         " + СокрЛП(Фирма.НомерСвидетельства),10); 
	
		ИначеЕсли (ТипПричиныИнд < 7) и (ТипПричиныИнд > 0) Тогда
		 	//тип причины: 02, 03, 07, 04, 05, 06
			КонтрагентНалогНомер = ПустойИНН;
			КонтрагентНомСвид    = "         0";
		Иначе
			КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,  Прав("           " + СокрЛП(Контрагент.ИНН),12));
			КонтрагентНомСвид = ?(ПустоеЗначение(Контрагент.НомерСвидетельства)=1,  "         0", Прав("         " + СокрЛП(Контрагент.НомерСвидетельства),10));
		КонецЕсли;
	 Иначе
		Если (НалоговаяНакладная.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
			ФирмаПолнНаименование = ?(НалоговаяНакладная.КорГрафы5 = 1,НалоговаяНакладная.Графа5,Контрагент.ПолнНаименование);        
			ФирмаАдрес = СокрЛП(Контрагент.Регион);;
			КонтрагентТелефоны = "         ";
			Если НалоговаяНакладная.УслугиДляНеХозДеят = 1 Тогда
				ФирмаНалогНомер = "200000000000";
			Иначе	
				ФирмаНалогНомер = ?(ДатаДок >= '01/01/2015', "500000000000", "300000000000");
			КонецЕсли;
			КолСтр = 1;
			КонтрагентПолнНаименование = Фирма.ПолнНаименование;
			КонтрагентАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
			КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);

		ИначеЕсли (НалоговаяНакладная.ДипломатПредст = 1) Тогда
		 	//Дипломатическое представительство
			КонтрагентПолнНаименование = ФирмаПолнНаименование;
			КонтрагентНалогНомер = ПустойИНН;
			КонтрагентАдрес = ФирмаАдрес;
			КонтрагентТелефоны = "         ";
	
		ИначеЕсли (ТипПричиныИнд = 1) или (ТипПричиныИнд = 10) Тогда
		 	//тип причины: 02, 11
			КонтрагентПолнНаименование = "Неплатник";
			КонтрагентНалогНомер = ?(ДатаДок >= '01/01/2015', "100000000000", ПустойИНН);
			КонтрагентАдрес = "";
			КонтрагентТелефоны = "         ";
		
		ИначеЕсли (ТипПричиныИнд = 6) Тогда
		 	//тип причины: 07, Экспорт
			КонтрагентНалогНомер = "300000000000";
			КонтрагентАдрес = СокрЛП(Контрагент.Регион);
			КонтрагентТелефоны = "         ";
	
		ИначеЕсли (ТипПричиныИнд > 1) Тогда
		 	//тип причины: 03, 04, 05, 06, 08, 09, 10, 13
			КонтрагентНалогНомер = ПустойИНН;
			КонтрагентПолнНаименование = ФирмаПолнНаименование;
			КонтрагентАдрес = ФирмаАдрес;
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
	
		Иначе
			КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,  Прав("           " + СокрЛП(Контрагент.ИНН),12));
			Если (ПустоеЗначение(Контрагент.ИНН)=1) Тогда 
				//данные покупателя не заполняем
				КонтрагентАдрес = "";
				КонтрагентТелефоны = "         ";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Для Страница = 1 По КолСтр Цикл
		// инициализация алгоритмов корректого округления
		глОчиститьКлючОкр("ИзмСуммыБезНДС");
		глОчиститьКлючОкр("ИзмНДС");
		
		ЕРПН = ?(ЕРНН = 1, "Х","");
		Электр = ?(ЭлектронныйДокумент = 1, "Х","");
		РегЕРНН = ?((ТребуетВклВЕдРеестрНН = 1) или (ЕРНН = 1), "Х","");
		Если Страница = 1 Тогда  
			Таб.ВывестиСекцию( "Пустота" );
			Оригинал = ?((НалоговаяНакладная.Оставляем = 1) или ((ЭлектронныйДокумент = 1)и(ДатаДок >= '01/03/2014')), "","Х");;
			Копия = "";
			ОстаетсяПеч = ?(НалоговаяНакладная.Оставляем = 1, "Х","");  
			ТипПричиныПеч = ?(НалоговаяНакладная.Оставляем = 1,Сред(НалоговаяНакладная.ТипПричины,2,2),"");
			РегистрПокупатель = ?(РегистрируетсяВЕРННПокупателем = 1, "Х","");
			Электр = ?(ЭлектронныйДокумент = 1, "Х","");
			СоглОРазделеПрод = ?(НалоговаяНакладная.СоглашениеОРазделеПродукции = 1, "Х","");
		ИначеЕсли Страница = 2 Тогда
			Таб.ВывестиСекцию( "Пустота" );
			Если ЭлектронныйДокумент = 1 Тогда
				Прервать;	
			КонецЕсли;
			Копия = "Х";
			Оригинал = "";
			ТипПричиныПеч = "";
			ОстаетсяПеч = "";  
		КонецЕсли;
		Таб.ВывестиСекцию( "Оригинал" );
		Таб.ВывестиСекцию( "Шапка" );
		Если Суффикс = "_2011" Тогда
			Если ВидНомДогов = 2 Тогда          
				Таб.ВывестиСекцию( "Договор2" ); 
			Иначе
				Таб.ВывестиСекцию( "Договор1" ); 
			КонецЕсли; 
		ИначеЕсли ТипФормы = 1 Тогда	
			Таб.НоваяСтраница();
		КонецЕсли;	
		Таб.ВывестиСекцию( "Шапка2" ); 

		Итог9 = 0; Итог10 = 0; Итог_11 = 0; Итог_12 = 0;

		ВыбратьСтроки();
		Пока ПолучитьСтроку() > 0 Цикл

			Если ПечататьДатыСРазделителями = Да Тогда
				Ст1 = ДатаДок;
			Иначе //по умолчанию без разделителей
				Ст1 = ДатаДляПечати(ДатаДок);
			КонецЕсли; 
			Ст2  = Причина;
			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(НомерГТД) = 0) Тогда 
			    //дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			Ст3 = СокрЛП(ТМЦ.ПолнНаименование) + ТекстГТД;  
			Ст4  = ?(ТМЦ.Вид()="ТМЦ",Ед.Единица,?(ДатаДок >= '01/01/2015', "шт", ТМЦ.БазЕдиница));
			Ст4к = ?(ТМЦ.Вид()="ТМЦ",Ед.Единица.КодЕдИзмерения,"2009");
			Ст4н = СтрЗаменить(КодУКТВЭД,".",?(ПечКодУКТВЭДбезПробелов = 1,""," "));
			
			Если ИзмКво <> 0 Тогда
				ТекКво = ИзмКво;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда       
					ТекЦенаБезНДС = ЦенаСНДС * КоэфБезНДС;
				Иначе
					ТекЦенаБезНДС = ЦенаБезНДС;
				КонецЕсли;                  
			Иначе
				ТекКво = Кво;
				ТекЦенаБезНДС = ИзмЦены;
			КонецЕсли;
			ЦенаБезНДСГрн	  = Окр(                       глПересчет(ТекЦенаБезНДС, Валюта,Курс,Гривня,ДатаДок,Дата_курса),3);
			// рассчитываем суммы с учетом накопленных погрешностей округления
			ИзмСуммыБезНДСГрн = глОкрКорр("ИзмСуммыБезНДС",глПересчет(ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаДок,Дата_Курса),3);
			ИзмНДСГрн         = глОкрКорр("ИзмНДС",        глПересчет(ИзмНДС,        Валюта,Курс,Гривня,ДатаДок,Дата_Курса),3);
			
			// подберем цену и количество по указанному в шапке способу
			глПодогнатьЦенаКоличество(ИзмСуммыБезНДСГрн, ЦенаБезНДСГрн, ТекКво, СпособПодгонки);

			Ст5  = ПустаяЯчейка;
			Ст6  = ПустаяЯчейка;
			Ст7  = ПустаяЯчейка;
			Ст8  = ПустаяЯчейка;   

			КвоТМЦ = ФРМЦена(Кво);
			Если (ТМЦ.Вид() = "ТМЦ") и (ДатаДок < '01/03/2014') Тогда
				Если ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Услуга Тогда
					КвоТМЦ = ?(ПустоеЗначение(ТМЦ.КвоДляНН) = 0, ТМЦ.КвоДляНН, КвоТМЦ); 
				КонецЕсли;
			КонецЕсли;
			
			Если ИзмКво<>0 Тогда
				Ст5  = ФРМЦена(ТекКво);
				Ст6  = ФРМЦена(ЦенаБезНДСГрн);
			Иначе
				Ст7  = ФРМЦена(ЦенаБезНДСГрн);
				Ст8 = КвоТМЦ;
			КонецЕсли;
			
			Ст9  = ПустаяЯчейка;
			Ст10 = ПустаяЯчейка;
			Ст11 = ПустаяЯчейка;
			Ст12 = ПустаяЯчейка;   
			Если  СокрЛП(ВидНДС.Код) = "НДС20" Тогда
				Ст9 = Формат(ИзмСуммыБезНДСГрн,"Ч12.2");
				Итог9 = Итог9 + ИзмСуммыБезНДСГрн; 
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС0")Тогда
				Ст10 = Формат(ИзмСуммыБезНДС,"Ч12.2");
				Итог10 = Итог10 + ИзмСуммыБезНДС ; 
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7")Тогда
				Ст12 = Формат(ИзмСуммыБезНДС,"Ч12.2");
				Итог_12 = Итог_12 + ИзмСуммыБезНДС ; 
			ИначеЕсли СокрЛП(ВидНДС.Код) = "БезНДС" Тогда
				Ст11 = Формат(ИзмСуммыБезНДСГрн,"Ч12.2");
				Итог11 = Итог11 + ИзмСуммыБезНДСГрн;
			КонецЕсли;
			
			Таб.ВывестиСекцию("Строка");
		КонецЦикла;
		Ст9 = Формат(Итог9,"Ч12.2");
		Ст10 = Формат(Итог10,"Ч12.2");
		Ст11 = Формат(Итог11,"Ч12.2");
		Ст12 = Формат(Итог_12,"Ч13.2");
		Итог_1112 = Формат(ИзмСуммыНДС,"Ч12.2");
		Итог11 = "";
		Если Сокрлп(ВидНДС.Код) = "НДС7" Тогда
			Итог11 = Итог_1112;  
			Итог12 = "";
		Иначе
			Итог12 = Итог_1112; 
			Итог11 = "";
		КонецЕсли;
		Таб.ВывестиСекцию("Итоги");
		НомерННСРежимом = НомерНН + ?(СпецРежимНалогообложения = 0, "", "/"+СпецРежимНалогообложения);
		НомДокСРежимом  = НомДок  + ?(СпецРежимНалогообложения = 0, "", "/"+СпецРежимНалогообложения);
		Таб.ВывестиСекцию("Подвал");

		Если Страница <> 2 Тогда
			Таб.НоваяСтраница();
		КонецЕсли;

	КонецЦикла;

	Таб.Опции(0, 0, 0, 0);
	Если ТипФормы = 1 Тогда
		Таб.ПараметрыСтраницы(2,,,,,,,,);
	Иначе	
		Таб.ПараметрыСтраницы(1,,,,,,,,);
	КонецЕсли;
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Печать расчета корретировки", "");
КонецПроцедуры
// ===============================
Процедура Печать()
	ФирмаНалогНомер      = Фирма.ИНН;
	КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1,                "XXXXXXXXXXXX", Контрагент.ИНН);
	КонтрагентНомСвид    = ?(ПустоеЗначение(Контрагент.НомерСвидетельства)=1, "XXXXXXXXXXXX", Контрагент.НомерСвидетельства);
	                           
	НН_НомерДок = глНомерБезПрефикса(НалоговаяНакладная.НомерДок);
	НН_ДатаДок  = НалоговаяНакладная.ДатаДок;
	П2_НомерДок = глНомерБезПрефикса(НомерДок);
	П2_НомерДок = Строка(П2_НомерДок)+"/"+Строка(НН_НомерДок);
	Если Договор.Вид() = "Договор" Тогда       
		НомерДог = Договор.НомерДоговора;
		ДатаДог = Договор.ДатаДок;
	Иначе
		НомерДог =  "_____";    
		ДатаДог = "________";
      КонецЕсли;
	
	Если (ДатаДок >= '01.04.2016') или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016')) Тогда
		Печать2016();   
		Возврат;
	ИначеЕсли ДатаДок >= '10.01.2011' Тогда
		Печать2011();   
		Возврат;
	ИначеЕсли ДатаДок >= '29.07.2005' Тогда 
		Суффикс = "_2005";
	Иначе
		Суффикс = "";
	КонецЕсли;
	Таб = СоздатьОбъект("Таблица");
	Таб.ИсходнаяТаблица("Таблица_Укр"+Суффикс);
	
	// переменные-акселераторы
	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));

	Для Страница = 1 По 2 Цикл
		// инициализация алгоритмов корректого округления
		глОчиститьКлючОкр("ИзмСуммыБезНДС");
		глОчиститьКлючОкр("ИзмНДС");
		
		Таб.ВывестиСекцию( "Пустота" );
		Таб.ВывестиСекцию( ?(Страница=1,"Оригинал","Копия") );
		Таб.ВывестиСекцию( "Шапка" );
		
		ВыбратьСтроки();
		Пока ПолучитьСтроку() > 0 Цикл

			Ст1  = ДатаДок;
			Ст2  = Причина;
			Ст3  = ТМЦ.ПолнНаименование;
			Ст4  = ?(ТМЦ.Вид()="ТМЦ",Ед,ТМЦ.БазЕдиница);
			
			Если ИзмКво <> 0 Тогда
				ТекКво = ИзмКво;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда       
					ТекЦенаБезНДС = ЦенаСНДС * КоэфБезНДС;
				Иначе
					ТекЦенаБезНДС = ЦенаБезНДС;
				КонецЕсли;                  
			Иначе
				ТекКво = Кво;
				ТекЦенаБезНДС = ИзмЦены;
			КонецЕсли;
			ЦенаБезНДСГрн	  = Окр(                       глПересчет(ТекЦенаБезНДС, Валюта,Курс,Гривня,ДатаДок,Дата_курса),3);
			// рассчитываем суммы с учетом накопленных погрешностей округления
			ИзмСуммыБезНДСГрн = глОкрКорр("ИзмСуммыБезНДС",глПересчет(ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаДок,Дата_Курса),3);
			ИзмНДСГрн         = глОкрКорр("ИзмНДС",        глПересчет(ИзмНДС,        Валюта,Курс,Гривня,ДатаДок,Дата_Курса),3);
			
			// подберем цену и количество по указанному в шапке способу
			глПодогнатьЦенаКоличество(ИзмСуммыБезНДСГрн, ЦенаБезНДСГрн, ТекКво, СпособПодгонки);

			Ст5  = "Х";
			Ст6  = "Х";
			Ст7  = "Х";
			Ст8  = "Х";   

			КвоТМЦ = ФРМЦена(Кво);
			Если ТМЦ.Вид() = "ТМЦ" Тогда
				Если ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Услуга Тогда
					КвоТМЦ = ?(ПустоеЗначение(ТМЦ.КвоДляНН) = 0, ТМЦ.КвоДляНН, КвоТМЦ); 
				КонецЕсли;
			КонецЕсли;
			
			Если ИзмКво<>0 Тогда
				Ст5  = ФРМЦена(ТекКво);
				Ст6  = ФРМЦена(ЦенаБезНДСГрн);
			Иначе
				Ст7  = ФРМЦена(ЦенаБезНДСГрн);
				Ст8 = КвоТМЦ;
			КонецЕсли;
			
			Ст9  = "Х";
			Ст10 = "Х";
			Ст11 = "Х";
			Если      СокрЛП(ВидНДС.Код) = "НДС20"  Тогда
				Ст9 = глФРМ3(ИзмСуммыБезНДСГрн,Гривня,0);
			ИначеЕсли СокрЛП(ВидНДС.Код) = "НДС0"   Тогда
				Ст10 = глФРМ3(ИзмСуммыБезНДСГрн,Гривня,0);
			ИначеЕсли СокрЛП(ВидНДС.Код) = "БезНДС" Тогда
				Ст11 = глФРМ3(ИзмСуммыБезНДСГрн,Гривня,0);
			КонецЕсли;
			
			Ст12 = "Х";
			Ст13 = "Х";
			Ст14 = "Х";
			Ст15 = "Х";
			Если      (СокрЛП(ВидНДС.Код) = "НДС20") И (ИзмСуммыБезНДС<0) Тогда
				Ст12 = глФРМ3(ИзмНДСГрн,Гривня,0);
				Ст13 = глФРМ3(ИзмНДСГрн,Гривня,0);
			ИначеЕсли (СокрЛП(ВидНДС.Код) = "НДС20") И (ИзмСуммыБезНДС>0) Тогда
				Ст14 = глФРМ3(ИзмНДСГрн,Гривня,0);
				Ст15 = глФРМ3(ИзмНДСГрн,Гривня,0);
			КонецЕсли;

			Таб.ВывестиСекцию("Строка");
		КонецЦикла;
		Таб.ВывестиСекцию("Подвал");

		Если Страница <> 2 Тогда
			Таб.НоваяСтраница();
		КонецЕсли;

	КонецЦикла;

	Таб.Опции(0, 0, 0, 0);
	Таб.ПараметрыСтраницы(2,,,,,,,,);
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Печать расчета корретировки", "");
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
	// пустой договор должен строго иметь тип "Документ", важно для отчета АнализНДС
	Если ПустоеЗначение(Договор) = 1 Тогда
		Договор = ПолучитьПустоеЗначение("Документ");
	КонецЕсли;
	РассчитатьБазуНДС();
	ПроверкаТребуетВклВЕдРеестрНН();
КонецПроцедуры

// ===============================
Функция УстДоступность()
	Форма.Заголовок(глЗаголовок(Контекст,"Приложение № 2 к налоговой накладной"));
	Если (ЧтоПродаем = Перечисление.ЧтоПродаем.НеоборотныеАктивы) Тогда
		НазначитьВид(ТМЦ,"НеоборотныеАктивы");
	Иначе
		НазначитьВид(ТМЦ,"ТМЦ");
	КонецЕсли;
	Форма.кОчиститьРодительскийДокумент.Доступность(РодительскийДокумент.Выбран());
	Форма.ТМЦ.НеИзменятьВид(1);
	НеИтоговоеРозница = 1 - ИтоговоеРозница;
	//Форма.Кво.Видимость(НеИтоговоеРозница);
	//Форма.Ед.Видимость(НеИтоговоеРозница);
	Форма.ЦенаБезНДС.Видимость(НеИтоговоеРозница);
	Форма.ЦенаСНДС.Видимость(НеИтоговоеРозница);
	Форма.ИзмКво.Доступность(НеИтоговоеРозница);
	//Форма.ИзмКво.Видимость(НеИтоговоеРозница);
	//Форма.ИзмЦены.Видимость(НеИтоговоеРозница);
	//Форма.Коэффициент.Видимость(НеИтоговоеРозница);
	Форма.Коэффициент.Доступность(НеИтоговоеРозница);
	Форма.кЭкспорт.Доступность(Проведен()*(1-Модифицированность()));
	Форма.ДатаПолученияПокупателем.Видимость(ДатаПолучПокупНеРавнаДатеДокумента);
	Форма.тДатаПолучения.Видимость(ДатаПолучПокупНеРавнаДатеДокумента);
	РассчитатьБазуНДС();
	Если ДатаДок >= '01/03/2014' Тогда 
		Форма.НомерГТД.Видимость(0);  
	Иначе	
		Форма.НомерГТД.Видимость(1);  
	КонецЕсли;	
	Форма.РегистрируетсяВЕРННПокупателем.Доступность(0);
	Если (ДатаДок >= '01.07.2015') Тогда
		Форма.ДатаРегВЕдРеестрНН.Видимость(ЕРНН+РегистрируетсяВЕРННПокупателем-1);
		Форма.тДатаЕРНН.Видимость(ЕРНН+РегистрируетсяВЕРННПокупателем-1);
	Иначе	
		Форма.ДатаРегВЕдРеестрНН.Видимость(0);
		Форма.тДатаЕРНН.Видимость(0);
	КонецЕсли;	
	Если ДатаДок >= '01/01/2015' Тогда  
		Форма.ТребуетВклВЕдРеестрНН.Доступность(0);
		Форма.ЭлектронныйДокумент.Доступность(0);
	Иначе	
		Форма.ТребуетВклВЕдРеестрНН.Доступность(НалоговаяНакладная.Оставляем);
	КонецЕсли;	
	СпецРежСХ = ?(НалоговаяНакладная.СпецРежимНалогообложения=2,1,0);
	Форма.КодВидаСХ.Видимость(СпецРежСХ);
	Возврат "";
КонецФункции
                                                   
// ===============================
Процедура ИзмЧтоПродаем()
	Если (КоличествоСтрок()<>0) и (СтарЧтоПродаем<>ЧтоПродаем) и (СокрЛП(СтарЧтоПродаем)<>"") Тогда
		Рез = Вопрос("Для изменения нужно очистить табличную часть. Удалить строки?","Да+Нет");
		Если Рез = "Да" Тогда
		    УдалитьСтроки();
		Иначе
			ЧтоПродаем = СтарЧтоПродаем;
		КонецЕсли;
	КонецЕсли;
	СтарЧтоПродаем = ЧтоПродаем;
КонецПроцедуры

// ===============================
Процедура ЭкспортНН()
	спВариантЭкспорта = СоздатьОбъект("СписокЗначений");
	спВариантЭкспорта.ДобавитьЗначение("Экспорт в XML");
	спВариантЭкспорта.ДобавитьЗначение("Экспорт и проверка состояния регистрации в ""FREDO Звіт""");
	
	Результат = ПолучитьПустоеЗначение();
	Если спВариантЭкспорта.ВыбратьЗначение(Результат, , , , 1) <> 1 Тогда
		Возврат;
	КонецЕсли;

	глРасшифровка = СоздатьОбъект("СписокЗначений");
	глРасшифровка.Установить("ТекущийДокумент", ТекущийДокумент());
	
	Если Результат = "Экспорт в XML" Тогда
		глФлагРасшифровки = 1;
		ОткрытьФорму("Отчет.ЭкспортНалоговойНакладной", глРасшифровка);
		глФлагРасшифровки = 0;
	Иначе							
		// Выведем причины невозможности использования FREDO Звіт, в случае если менеджер не инициализирован
		Если глПодключитьМенеджерЗвит1С() = 0 Тогда
			Возврат;
		КонецЕсли;
	
		// Концепция механизма выгрузки НН и П2 изменена начиная с "11q1001"
		// в связи с этим необходима информация о том что встроенный в конфигурацию
		// отчет "ЭкспортНалоговойНакладной" обновлен
		глРасшифровка.Установить("ИспользоватьОтчет_ЭкспортНалоговойНакладной", 1); 
		глРасшифровка.Установить("КонтекстФормыДокумента", Контекст); 
		
		глВыполнитьКомандуЗвит1С("ВыгрузитьДокумент", глРасшифровка);

	КонецЕсли;
	
КонецПроцедуры
// ===============================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр)
	Если Рекв = "ВидНДС" Тогда
	    глВыбратьНДС(Контекст);
		ИзмВидНДС();
		ФлагСтандОбр = 0;
	ИначеЕсли Рекв = "Выписал" Тогда
		ФлагСтандОбр = 0;
		КонтФирма = Фирма;
		ОткрытьФорму("Справочник.Сотрудники.ДляВыбора",КонтФирма);
	ИначеЕсли Рекв = "НалоговаяНакладная" Тогда
		СтарНалоговаяНакладная = НалоговаяНакладная;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ВыборОплаты()
	// Процедура по кнопке редактирования параметров оплаты в документе
	ОткрытьФормуМодально("Обработка.ИнформацияОВалюте", Контекст);
КонецПроцедуры	

// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|СтруктураПодчиненности,
	|ОткрытьВЖурнале");
