Перем итСуммаЗатратБУ, итСуммаНУСтоим;
// ===============================

Функция ПроверкаШапки()
    глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
    глВыбранЛи(Фирма,"Фирма");
    глВыбранЛи(НеоборотныйАктив,"НеоборотныйАктив");
    глВыбранЛи(СчетМодернизации,"СчетМодернизации");
    глВыбранЛи(МестоХранения,"МестоХранения");   
	Если НеоборотныйАктив.Производственное = 1 Тогда
	    глВыбранЛи(СчетЗатрат,"СчетЗатрат");   
	    глВыбранЛи(ВидЗатрат,"ВидЗатрат");   
	КонецЕсли;
	Если НеоборотныйАктив.Состояние.Получить(ТекущийДокумент()) <> Перечисление.СостоянияНеоборАктивов.ВОперативнойАренде Тогда
	    глВыбранЛи(Подразделение,"Подразделение");
	КонецЕсли;
	
	Возврат глВсеВыбрано;
КонецФункции

// ===============================
Функция ПроверкаСтроки()
	глВсеВыбрано = 1;
    глВыбранЛи(Инвестиция,"Инвестиция",НомерСтроки);
    Возврат глВсеВыбрано;
КонецФункции

// ===============================
Процедура ПроводкиШапка()
	Если НеоборотныйАктив.Производственное = 0 Тогда
		Возврат;
	КонецЕсли;
	//на затраты
	СчетЗатрНУ = ?(СчетЗатрат.Код = "231","791",СчетЗатрат);
	Если ДатаДок >= '01.01.2015' Тогда  
		глПровНУ(Контекст,СчетЗатрНУ,,0,"Разн:Модернизация НА",,НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА", 0); 
	Иначе	
		глПровНУ(Контекст,СчетЗатрНУ,,0,"Разн:Модернизация НА",,НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА", Итог("СуммаНУ")-итСуммаНУСтоим-итСуммаЗатратБУ); 
	КонецЕсли;
		
КонецПроцедуры

// ===============================
Процедура ПроводкиСтрока()   
	// как и в налоговом учете на затраты списываем сумму в пределах нормы
	// превышение списываем на счет ОС
	СуммаЗатратБУ = 0; СуммаНаУвеличСтоимБух = 0; 
	СуммаНА = Сумма;
	СуммаНУСтоим  = СуммаНУ;
	Если НеоборотныйАктив.Производственное = 1 Тогда
		//налоговый учет 
		Если ДатаДок >= '01.01.2015' Тогда 
			Если Ремонт = 1 Тогда  //все на затраты
				СуммаНУСтоим  = 0;
				СуммаЗатратБУ   = СуммаНА; 
			Иначе //все на стоимость ОС	
				СуммаНУСтоим  = СуммаНА;
				СуммаНаУвеличСтоимБух = СуммаНА;
			КонецЕсли;
		Иначе
			СуммаНУСтоим = Макс(0, СуммаНУ - СуммаВПредНормы);
			СуммаЗатратБУ = СуммаНА - СуммаНУСтоим;
			СуммаНаУвеличСтоимБух = СуммаНУСтоим;
		КонецЕсли;
	КонецЕсли;
	//увеличение стоимости НА
	глПроводка(Контекст,НеоборотныйАктив.Счет.Получить(ТекущийДокумент()),СчетМодернизации,СуммаНаУвеличСтоимБух,"Модернизация НА",,
		Подразделение,МестоХранения,НеоборотныйАктив,Инвестиция,,,,,"НА");  
	глПровНУ(Контекст,НеоборотныйАктив.Счет.Получить(ТекущийДокумент()),,0,"Модернизация НА",,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,,,,"НА", СуммаНУСтоим); 
	//на затраты
	глПроводкаПоЗатратам(Контекст,СчетЗатрат,СчетМодернизации,СуммаЗатратБУ,"Модернизация НА",,НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
	Инвестиция,,, ,,"НА");
	//спишим разницу НУ со счета инвестиций
	глПровНУ(Контекст,,СчетМодернизации,,"Разн: Модернизация НА",, ,,, Инвестиция,,,,,"НА",СуммаНУ-Сумма);  
	итСуммаНУСтоим = итСуммаНУСтоим + СуммаНУСтоим;
	итСуммаЗатратБУ = итСуммаЗатратБУ + СуммаЗатратБУ;
КонецПроцедуры

// ===============================
Процедура ЗаписатьИзмененияПараметров()
	Если НеоборотныйАктив.Состояние.Получить(ТекущийДокумент()) = Перечисление.СостоянияНеоборАктивов.НаМодернизации Тогда
	    УстановитьРеквизитСправочника(НеоборотныйАктив,"Состояние",Перечисление.СостоянияНеоборАктивов.ВЭксплуатации,ТекущийДокумент());
	КонецЕсли;
КонецПроцедуры //

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);

	Если ПроверкаШапки()=0 Тогда
	    глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли; 
	итСуммаЗатратБУ = 0; итСуммаНУСтоим = 0;	
	ВыбратьСтроки();
	Пока ПолучитьСтроку()=1 Цикл
		Если ПроверкаСтроки()=0 Тогда
		    глНеПроводить(Контекст);
		    Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		ПроводкиСтрока();
	КонецЦикла;
	ПроводкиШапка();
	
	Операция.СуммаОперации = Итог("Сумма");
	Операция.Содержание = Примечание;
	Операция.Записать();

	ЗаписатьИзмененияПараметров();
	
	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры

