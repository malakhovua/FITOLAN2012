Перем ЭтоНМА, СчетНУ, ОстСтоимость, БалСтоимость;
Перем Ит, ТаблВиды;
Перем ТаблицаБалСтоимость;

// ===========================
Функция ПроверкаШапки()
	глВсеВыбрано = 1;
	глВыбранЛи(Фирма,"Фирма");
	глВыбранЛи(НеобАктивРазница,"Необоротный актив для учета разницы БУ и НУ на 01.04.11");
	глВыбранЛи(МестоХраненияРазн,"Место хранения необ.актива для учета разницы БУ и НУ на 01.04.11");
	глВыбранЛи(ПодразделениеРазн,"Подразделение необ.актива для учета разницы БУ и НУ на 01.04.11");
	глВыбранЛи(ВидЗатрат,"Вид затрат для необ.актива для учета разницы БУ и НУ на 01.04.11");
	Возврат глВсеВыбрано;
КонецФункции

// ===========================
Функция ПроверкаСтроки()
	глВсеВыбрано = 1;
	глВыбранЛи(НеоборотныйАктив,"Необоротный актив",НомерСтроки);
	глВыбранЛи(МестоХранения,"Место хранения",НомерСтроки); 
	Если МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.Налоговый Тогда 
	    глКомментарий(Строка(НомерСтроки)+": задан метод расчета износа ""Налоговый"". Этот метод не используется с 01.04.2011!",0,,"!");
	ИначеЕсли (Производственное = Да) и (ОстаточнаяСтоимостьНУ > 0) Тогда
		глВыбранЛи(МетодРасчетаИзноса,"Метод расчета износа",НомерСтроки); 
		Если ((МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.УменьшениеОстатка) или 
			(МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.УскоренноеУменьшениеОстатка) или 
			(МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.Кумулятивный)) и 
			(ЛиквидационнаяСтоимость = 0) Тогда
			// обязательно для заполнения Срок, ЛиквидационнаяСтоимость
		    глКомментарий(Строка(НомерСтроки)+": не задан новый срок использования или ликвидационная стоимость!",0,,"!");
			глВсеВыбрано = 0;
		ИначеЕсли (МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.СуммЕдиниц) и (РасчетныйОбъемПроизводства=0) Тогда
			// обязательно для заполнения РасчетныйОбъемПроизводства
		    глКомментарий(Строка(НомерСтроки)+": не задан расчетный объем производства!",0,,"!");
			глВсеВыбрано = 0;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат глВсеВыбрано;
КонецФункции

// ===============================
Процедура ПроводкиШапка()       
	
	глПровНУ(Контекст,"Н109",,,"Разница НУ корр. остат. необ. активов",, ПодразделениеРазн,МестоХраненияРазн,НеобАктивРазница,
	,,, ,,"НА",СуммаРазницы);
	
КонецПроцедуры

// ===============================
Функция ПроводкиСтрокаНУ()
	// для налогового учета
	СчетНУ = "Н" + Счет;
	глПровНУ(Контекст,СчетНУ,,БалСтоимость,"Стоим.НУ корр. остат. необ. активов",, Подразделение,МестоХранения,НеоборотныйАктив,
	,,, ,,"НА",ОстаточнаяСтоимостьНУ);

КонецФункции

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);
	СпрНА = СоздатьОбъект("Справочник.НеоборотныеАктивы");

	Если ПроверкаШапки() = 0 Тогда
	    глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли;

	ПроводкиШапка();
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если ПроверкаСтроки() = 0 Тогда
		    глНеПроводить(Контекст);
		    Возврат;
		КонецЕсли;
        
		Если ПроводкиСтрокаНУ() = 0 Тогда
		    глНеПроводить(Контекст);
		    Возврат;
		КонецЕсли;
		//обновим данные в справочнике  
		Если СпрНА.НайтиЭлемент(НеоборотныйАктив) = 1 Тогда
			СпрНА.Группа = Группа;		
			СпрНА.Записать();
		КонецЕсли;
		НеоборотныйАктив.ИспользоватьДату(ДатаДок-1);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"МетодРасчетаИзноса",МетодРасчетаИзноса);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"ЛиквидационнаяСтоимость",ЛиквидационнаяСтоимость);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"СрокИспользования",СрокИспользования);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"РасчетныйОбъемПроизводства",РасчетныйОбъемПроизводства);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"Счет",Счет);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"СчетЗатрат",НеоборотныйАктив.СчетЗатрат);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"ВидЗатрат",НеоборотныйАктив.ВидЗатрат);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"Состояние",НеоборотныйАктив.Состояние);
		УстановитьРеквизитСправочника(НеоборотныйАктив,"ВидДеятельности",НеоборотныйАктив.ВидДеятельности);
	КонецЦикла;
    //разница БУ и НУ
	Если СпрНА.НайтиЭлемент(НеобАктивРазница) = 1 Тогда
		СпрНА.Группа = 17;		
		СпрНА.ДатаВвода = ДатаДок;		
		СпрНА.Записать();
	КонецЕсли;
	УстановитьРеквизитСправочника(НеобАктивРазница,"ЛиквидационнаяСтоимость",0);
	УстановитьРеквизитСправочника(НеобАктивРазница,"СрокИспользования",36);
	УстановитьРеквизитСправочника(НеобАктивРазница,"Счет",СчетПоКоду("109"));
	УстановитьРеквизитСправочника(НеобАктивРазница,"СчетЗатрат",?(Константа.ИспользоватьСчетаРасходов = Класс8, СчетПоКоду("80"), СчетПоКоду("94.9")));
	УстановитьРеквизитСправочника(НеобАктивРазница,"ВидЗатрат",ВидЗатрат);
	УстановитьРеквизитСправочника(НеобАктивРазница,"МетодРасчетаИзноса",Перечисление.МетодыРасчетаИзноса.ПрямолинейноеСписание);
	УстановитьРеквизитСправочника(НеобАктивРазница,"Состояние",Перечисление.СостоянияНеоборАктивов.ВЭксплуатации);

	Операция.СуммаОперации = 0;
	Операция.Содержание = "Корр. остатков НА на 01.04.11";
	Операция.Записать();
	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры

