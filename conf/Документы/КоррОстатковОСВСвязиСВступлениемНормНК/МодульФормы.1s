Перем Таб;

// ===============================
Процедура РассчитатьБухгалтерскиеОстатки(ОстПервСтоимость, ОстИзнос, ОстКво)
	ОстПервСтоимость = 0;
	ОстИзнос = 0;
	ОстКво = 0;
	
	Если НеоборотныйАктив.Выбран() = 0 Тогда
	    Возврат;
	КонецЕсли;
	НеоборотныйАктив.ИспользоватьДату(ДатаДок,1);
		
	// определим первичную стоимость, количество и место хранения
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы, НеоборотныйАктив, 2);
	Ит.ИспользоватьСубконто(ВидыСубконто.МестаХранения);
	КонечнаяДата = ?(Выбран()=1,СформироватьПозициюДокумента(ТекущийДокумент(),-1),ДатаДок); 

	Ит.ВыполнитьЗапрос(КонечнаяДата,КонечнаяДата,Счет);
	Ит.ВыбратьСубконто(1);
	Если Ит.ПолучитьСубконто(1) = 1 Тогда
		КвоВсего = Ит.СКД("К");
		Ит.ВыбратьСубконто(2);
		Пока Ит.ПолучитьСубконто(2) = 1 Цикл
			Если (ПустоеЗначение(МестоХранения) = 1) или (МестоХранения = Ит.Субконто(2)) Тогда
				МестоХранения = Ит.Субконто(2);
				ОстПервСтоимость = Ит.СКД();
				ОстКво = Ит.СКД("К");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// определим износ объекта в бухгалтерском учете
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы, НеоборотныйАктив, 2);
	СчетИзноса = СчетПоКоду("13."+Строка(Число(Сред(НеоборотныйАктив.Счет.Код,1,2))-9)); 

	Если НеоборотныйАктив.Счет.Код = "100" Тогда
		СчетИзноса = СчетПоКоду("13.5");
	КонецЕсли;	

	Ит.ВыполнитьЗапрос(КонечнаяДата,КонечнаяДата,СчетИзноса);
	ОстИзнос = Ит.СКК();
	Если ОстПервСтоимость = 0 Тогда
		ОстИзнос = 0;
		ОстКво   = 0;
	Иначе
		КвоВсего = ?(КвоВсего = 0, 1, КвоВсего);
		ОстКво = ?(ОстКво = 0, 1, ОстКво);
		ОстИзнос = ОстИзнос * ОстКво/КвоВсего;
	КонецЕсли;
	
КонецПроцедуры

// ===============================
Процедура ИзмГруппа()  
	КолГрупп = 16;
	Если НеоборотныйАктив.ВидНеоборотногоАктива = НМА Тогда 
		КолГрупп = 6;
	КонецЕсли;	
	Если Группа > КолГрупп Тогда
		Группа = 2;
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура ИзмМетод()  
	Если МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.Налоговый Тогда 
		глКомментарий(" ""Налоговый"" метод расчета износа с 01.04.2011 не используется!",0,,"!");
	КонецЕсли;	
КонецПроцедуры
// ===============================
Процедура ЗаполнитьГруппу()  
	Если НеоборотныйАктив.ВидНеоборотногоАктива = НМА Тогда 
		Если Лев(Счет.Код,3) = "121" Тогда
			Группа = 1;
		ИначеЕсли Лев(Счет.Код,3) = "122" Тогда
			Группа = 2;
		ИначеЕсли Лев(Счет.Код,3) = "123" Тогда
			Группа = 3;
		ИначеЕсли Лев(Счет.Код,3) = "124" Тогда
			Группа = 4;
		ИначеЕсли Лев(Счет.Код,3) = "125" Тогда
			Группа = 5;
		ИначеЕсли Лев(Счет.Код,3) = "127" Тогда
			Группа = 6;
		КонецЕсли;
	Иначе
		Если Лев(Счет.Код,3) = "101" Тогда
			Группа = 1;
		ИначеЕсли Лев(Счет.Код,3) = "102" Тогда
			Группа = 2;
		ИначеЕсли Лев(Счет.Код,3) = "103" Тогда
			Группа = 3;
		ИначеЕсли Лев(Счет.Код,3) = "104" Тогда
			Группа = 4;
		ИначеЕсли Лев(Счет.Код,3) = "105" Тогда
			Группа = 5;
		ИначеЕсли Лев(Счет.Код,3) = "106" Тогда
			Группа = 6;
		ИначеЕсли Лев(Счет.Код,3) = "107" Тогда
			Группа = 7;
		ИначеЕсли Лев(Счет.Код,3) = "108" Тогда
			Группа = 8;
		ИначеЕсли Лев(Счет.Код,3) = "109" Тогда
			Группа = 9;
		ИначеЕсли Лев(Счет.Код,3) = "111" Тогда
			Группа = 10;
		ИначеЕсли Лев(Счет.Код,3) = "112" Тогда
			Группа = 11;
		ИначеЕсли Лев(Счет.Код,3) = "113" Тогда
			Группа = 12;
		ИначеЕсли Лев(Счет.Код,3) = "114" Тогда
			Группа = 13;
		ИначеЕсли Лев(Счет.Код,3) = "115" Тогда
			Группа = 14;
		ИначеЕсли Лев(Счет.Код,3) = "116" Тогда
			Группа = 15;
		ИначеЕсли Лев(Счет.Код,2) = "16" Тогда
			Группа = 16;
		КонецЕсли; 
	КонецЕсли;	
КонецПроцедуры
// ===============================
Процедура ИзмНеоборотныйАктив()
	Перем ОстПервСтоимость, ОстИзнос, ОстКво;
	
	Счет = НеоборотныйАктив.Счет;
	ИнвенНомер = НеоборотныйАктив.ИнвенНомер;
	ДатаВвода = НеоборотныйАктив.ДатаВвода; 
	СрокИспользования = НеоборотныйАктив.СрокИспользования; 
	Производственное  = ?(НеоборотныйАктив.Производственное = 1, Да, Нет); 
	МетодРасчетаИзноса = НеоборотныйАктив.МетодРасчетаИзноса;
	ЛиквидационнаяСтоимость = НеоборотныйАктив.ЛиквидационнаяСтоимость;
	РасчетныйОбъемПроизводства = НеоборотныйАктив.РасчетныйОбъемПроизводства;
	
	МестоХранения = ПолучитьПустоеЗначение("Справочник.МестаХранения"); // чтобы склад автоматически определился
	РассчитатьБухгалтерскиеОстатки(ОстПервСтоимость, ОстИзнос, ОстКво);
	
	ПервСтоимость = ОстПервСтоимость;
	Износ = ОстИзнос;
	ОстаточнаяСтоимостьБУ	= ОстПервСтоимость - ОстИзнос;
	ОстаточнаяСтоимостьНУ	= ОстаточнаяСтоимостьБУ;
	Кво	  = ОстКво;
	ЗаполнитьГруппу();
	
КонецПроцедуры
// ===============================
Процедура ИзмМестоХранения()
	Перем ОстПервСтоимость, ОстИзнос, ОстКво;
	
	Если ПустоеЗначение(НеоборотныйАктив) = 0 Тогда
		Счет = НеоборотныйАктив.Счет;
		ИнвенНомер = НеоборотныйАктив.ИнвенНомер;
		ДатаВвода = НеоборотныйАктив.ДатаВвода; 
		СрокИспользования = НеоборотныйАктив.СрокИспользования; 
		Производственное  = ?(НеоборотныйАктив.Производственное = 1, Да, Нет); 
		МетодРасчетаИзноса = НеоборотныйАктив.МетодРасчетаИзноса;
		ЛиквидационнаяСтоимость = НеоборотныйАктив.ЛиквидационнаяСтоимость;
		РасчетныйОбъемПроизводства = НеоборотныйАктив.РасчетныйОбъемПроизводства;
	
		РассчитатьБухгалтерскиеОстатки(ОстПервСтоимость, ОстИзнос, ОстКво);
		
		ПервСтоимость = ОстПервСтоимость;
		Износ = ОстИзнос;
		ОстаточнаяСтоимостьБУ	= ОстПервСтоимость - ОстИзнос;
		ОстаточнаяСтоимостьНУ	= ОстаточнаяСтоимостьБУ;
		Кво	  = ОстКво;
		ЗаполнитьГруппу();
	КонецЕсли;
	
КонецПроцедуры

// ===============================
Процедура Заполнить()
	Перем ИтОстаток;
	Если КоличествоСтрок() > 0 Тогда
		Рез = Вопрос("Удалить строки?","Да+Нет+Отмена");
		Если Рез ="Да" Тогда
			УдалитьСтроки();
		ИначеЕсли Рез = "Отмена" Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Выбран() = 0 Тогда
		Если Вопрос("Документ не записан. Записать?", "Да+Нет") = "Да" Тогда
			Записать();
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
    ИтогОстСтоимБУ = 0;

	// определим износ в бухгалтерском учете
	ИтАм = СоздатьОбъект("БухгалтерскиеИтоги");
	ИтАм.ИспользоватьРазделительУчета(Фирма);
	ИтАм.ПериодКВН('31.03.11');

	ИтОстаток = СоздатьОбъект("БухгалтерскиеИтоги");
	ИтОстаток.ИспользоватьРазделительУчета(Фирма);
	ИтОстаток.ИспользоватьСубконто(ВидыСубконто.Подразделения);
	ИтОстаток.ИспользоватьСубконто(ВидыСубконто.МестаХранения);
	ИтОстаток.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
	ИтОстаток.Опции(0,0);
	ИтОстаток.ВключатьСубсчета(-1,1); // без групп
	ИтОстаток.ВыполнитьЗапрос('01.04.11','01.04.11',"10,11,12,16",,,,,"СК");
	ИтОстаток.ВыбратьСубконто(1);
	//подразделение
	Пока ИтОстаток.ПолучитьСубконто(1)=1 Цикл
		ИтОстаток.ВыбратьСубконто(2);
		//место хранения
		Пока ИтОстаток.ПолучитьСубконто(2)=1 Цикл      
			ИтОстаток.ВыбратьСубконто(3); 
			//НМА
			Пока ИтОстаток.ПолучитьСубконто(3)=1 Цикл      
				// Заполняем по НА
				ИтОстаток.ВыбратьСчета();
				Пока ИтОстаток.ПолучитьСчет()=1 Цикл
					ОстПервСтоимость =  ИтОстаток.СНД("С");
					//износ
					СчетИзноса = СчетПоКоду("13."+Строка(Число(Сред(ИтОстаток.Счет.Код,1,2))-9)); 
				    Если ИтОстаток.Счет.Код = "100" Тогда
						СчетИзноса = СчетПоКоду("13.5");
					КонецЕсли;
					НА = ИтОстаток.Субконто(3);
					НА.ИспользоватьДату(ДатаДок-1,1);
				    ОстИзнос = ИтАм.СКК(СчетИзноса,,,НА);
					ЛиквСтоим = ?(ПустоеЗначение(НА.ЛиквидационнаяСтоимость)=1,0,НА.ЛиквидационнаяСтоимость);
					Если (НА.МетодРасчетаИзноса <> Перечисление.МетодыРасчетаИзноса.ПервыйМесяц) И
					 	((ОстПервСтоимость - ОстИзнос < ЛиквСтоим) или (ОстПервСтоимость - ОстИзнос<0)) Тогда
					 		//полностью изношенные нас не интересуют
						Продолжить;	
					КонецЕсли;
					//запишем строку
					НоваяСтрока();
					НеоборотныйАктив = ИтОстаток.Субконто(3);   
					Кво = ИтОстаток.СНД("К");
					Кво = ?(Кво =0, 1, Кво);
					ПервСтоимость =  ОстПервСтоимость;
					Износ = ОстИзнос;
					Счет = ИтОстаток.Счет;
					ИнвенНомер = НА.ИнвенНомер;
					ДатаВвода = НА.ДатаВвода; 
					СрокИспользования = НА.СрокИспользования; 
					Производственное  = ?(НА.Производственное = 1, Да, Нет); 
					МетодРасчетаИзноса = НА.МетодРасчетаИзноса;
					Если МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.Налоговый Тогда 
						МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПрямолинейноеСписание;
					КонецЕсли;
					ЛиквидационнаяСтоимость = НА.ЛиквидационнаяСтоимость;
					РасчетныйОбъемПроизводства = НА.РасчетныйОбъемПроизводства;
					
					Подразделение = ИтОстаток.Субконто(1); 
					МестоХранения = ИтОстаток.Субконто(2); 
					
					ОстаточнаяСтоимостьБУ	= ПервСтоимость - Износ;
					ОстаточнаяСтоимостьНУ	= ОстаточнаяСтоимостьБУ;
					ЗаполнитьГруппу();
					Если НА.Производственное = 1 Тогда
						ИтогОстСтоимБУ = ИтогОстСтоимБУ + ОстаточнаяСтоимостьБУ;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ОстСтоимостьНУ = 0;
	Для НомерГруппы = 1 По 4 Цикл
		Ит = СоздатьОбъект("БухгалтерскиеИтоги");
		Ит.ИспользоватьРазделительУчета(Фирма);
		СчетГруппы = "ОС."+НомерГруппы;
		Ит.ИспользоватьСубконто(ВидыСубконто.ШкалаСтавок);
		Ит.ВыполнитьЗапрос('01.04.2011','01.04.2011',СчетГруппы);
		//Возьмем остатки в целом по группе
		ОстСтоимостьГруппы = Ит.СНД("С");
		ОстСтоимостьНУ = ОстСтоимостьНУ + ОстСтоимостьГруппы;
	КонецЦикла;
	
	// НМА
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
	Ит.ВыполнитьЗапрос('01.04.2011','01.04.2011',"НА.1,НА.2");
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1) = 1 Цикл
		ПервСтоим = 0;
		Если Ит.ПолучитьСчет(,СчетПоКоду("НА.1")) = 1 Тогда
			ПервСтоим = Ит.СНД("С");
		КонецЕсли;
		ОстСтоимость = ПервСтоим;
		Если Ит.ПолучитьСчет(,СчетПоКоду("НА.2")) = 1 Тогда
			ОстСтоимость = ПервСтоим - Ит.СНК("С");
		КонецЕсли;
		ОстСтоимостьНУ = ОстСтоимостьНУ + ОстСтоимость;
				
	КонецЦикла; 
	РазницаБУНУ = ИтогОстСтоимБУ -  ОстСтоимостьНУ;
	СуммаРазницы = ?(РазницаБУНУ>0,0,-РазницаБУНУ);
КонецПроцедуры

// ======================================
Процедура ИзмФирма()
	глУстановитьНомер(Контекст);
КонецПроцедуры 
// ===============================
Процедура ВводНового(ПризнакКопирования)
	Фирма = глВосстановитьЗначение(,"БазФирма");      
	ДатаДок = '31.03.11';
	глУстановитьНомер(Контекст);
КонецПроцедуры

// ===============================
Процедура ПриОткрытии() 
	ПриЗаписиПерепроводить(1);
	Форма.НеоборотныйАктив.ВыполнятьФормулуТолькоПриИзменении(1);
	Форма.ИспользоватьЗакладки(1);
	Форма.Закладки.ДобавитьЗначение("Основной","Основные");

	Форма.ИспользоватьСлой("Основной, Общий",2);      
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	Автор = глПользователь;
КонецПроцедуры


// ===============================
Функция УстДоступность()  
	Перем фПодготовка, Инд, Инд1;
	// доступность в зависимости от слоя
	Закл = Форма.Закладки.ПолучитьЗначение(Форма.Закладки.ТекущаяСтрока());
	
КонецФункции;