Перем Списание, Реализация, Подготовка, ПервыйДок;
Перем СуммаГрнСНДС, СумГрнБезНДС;
Перем ЭтоНМА, СчетУчета, СчетЗатрат, СчетИзноса, ОстСтоимость;
Перем Ит, ТаблВиды;
Перем ВремРег;       
Перем ТаблицаБалСтоимость;
Перем ИспользоватьСчетНДС;
Перем НДСПервоеСобытие, НДСВтороеСобытие, ВзаиморасчетыГрн; // для исправления ошибок при округлениях
Перем тбПартии, тбОстаткиПартий;
Перем ИзносНУ, ПервСтоимНУ, СчетНУ, СчетИзносаНУ;

Функция СтоимостьИзТаблицы(СчетНА, Объект=0, МестоХр=0)
    
	//Ищем строку с данными объекта
	ТаблицаБалСтоимость.ВыбратьСтроки();
	Пока ТаблицаБалСтоимость.ПолучитьСтроку()=1 Цикл
		Если (ТаблицаБалСтоимость.Счет.Код = СчетНА)
		и (ТаблицаБалСтоимость.МестоХранения = МестоХр) 
		и (ТаблицаБалСтоимость.Объект = Объект) Тогда
			Возврат ТаблицаБалСтоимость.СтоимостьНУ;
		КонецЕсли;  	
	КонецЦикла;
	Возврат 0;

КонецФункции	

// ===========================
Функция ПроверкаШапки()
	глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
	глВыбранЛи(Фирма,			"Фирма");
	глВыбранЛи(ВидНДС,			"Вид НДС");
	глВыбранЛи(Подразделение,	"Подразделение");

	Если ВидЛиквидации = Списание Тогда
		глВыбранЛи(ВидЗатрат,"Вид затрат");
		Если (ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ВынужденнаяЗаменаЕслиВиновныйУстановлен) Тогда
			Если Виновный.Выбран() = 0 Тогда
				глКомментарий("При списании необоротного актива не выбрано виновное лицо!",0,,"!");
				глВсеВыбрано = 0;
			ИначеЕсли ВидДеятельности.Выбран() = 0 Тогда
				глКомментарий("При списании необоротного актива не выбран вид деятельности для компенсации ущерба!",0,,"!");
				глВсеВыбрано = 0;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ВидЛиквидации = Реализация Тогда
	    глВыбранЛи(Контрагент,		"Контрагент");
	    глВыбранЛи(СчетКонтрагента,"Счет контрагента");
		глВыбранЛи(ВидЗатрат,"Вид затрат");
		Если глПроверитьСчетВзаиморасчетов(СчетКонтрагента) = 0 Тогда
			глКомментарий("Счет контрагента ("+СчетКонтрагента+") не является счетом учета взаиморасчетов!",1,,"!");
		    глВсеВыбрано = 0;
		ИначеЕсли СчетКонтрагента.Валютный = ?(Валюта=Гривня,1,0) Тогда
			глКомментарий("Счет взаиморасчетов не соответствует валюте документа!",1,,"!");
		    глВсеВыбрано = 0;
		КонецЕсли;
		глВыбранЛи(Валюта,			"Валюта");
		глВыбранЛи(ВидТорговли,		"Вид торговли");
		Если ВидТорговли = Перечисление.ВидыТорговли.Бартер Тогда
			глКомментарий("Нельзя продавать необоротные активы на условиях бартера!",0,,"!");
			глВсеВыбрано = 0;
		ИначеЕсли ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
			глВыбранЛи(Касса, "Касса");
		КонецЕсли;
		Если Валюта <> Гривня Тогда
			Если (ВидТорговли = Перечисление.ВидыТорговли.Нал) Или (ВидТорговли = Перечисление.ВидыТорговли.Бартер) Тогда
				глКомментарий("При продаже за валюту нельзя использовать вид торговли """ + ВидТорговли + """!",0,,"!");
				глВсеВыбрано = 0;
			КонецЕсли;               		
			Если (ВидНДС = ОсновнаяСтавкаНДС) или (ВидНДС = СтавкаНДС7) Тогда
				// это явная ошибка, запрещаем проведение 
				глКомментарий("При продаже за валюту нельзя указывать НДС!",0,,"!");
				глВсеВыбрано = 0;
			ИначеЕсли ВидНДС <> ЛьготнаяСтавкаНДС Тогда
				// просто предупредим, но жестко не запрещаем
				глКомментарий("Отгрузка за валюту вероятно должна проходить по ставке НДС """+ЛьготнаяСтавкаНДС+"""!",2)
			КонецЕсли;	
		КонецЕсли;    
		//Если (ПодготовкаКРеализации = 0) и (ПустоеЗначение(ДокументПодготовки) = 1) Тогда
		//	глВыбранЛи(СтатьяНалоговойДекларации,"Статья налоговой декларации");
		//КонецЕсли;  
		глВсеВыбрано = ?(глВсеВыбрано = 0, 0, глПроверкаНДСВДокументе(Контекст, Итог("СуммаБезНДС"), Итог("СуммаСНДС"), Итог("НДС")));
	КонецЕсли;
	Возврат глВсеВыбрано;
КонецФункции

// ===========================
Функция ПроверкаСтроки()

	глВсеВыбрано = 1;
	НеоборотныйАктив.ИспользоватьДату(ДатаДок,1);
	глВыбранЛи(НеоборотныйАктив, "Необоротный актив", НомерСтроки);
	глВыбранЛи(НеоборотныйАктив.ВидДеятельности,	"Вид деятельности для необоротного актива",	НомерСтроки);
	глВыбранЛи(МестоХранения,						"Место хранения",							НомерСтроки);

	Если ВидЛиквидации = Подготовка Тогда
		глВыбранЛи(МестоХраненияПодготовки,         "Новое место хранения",                     НомерСтроки);  
	КонецЕсли;
	Если	(НеоборотныйАктив.ВидНеоборотногоАктива <> НМА)
	И		(НеоборотныйАктив.ВидНеоборотногоАктива <> Перечисление.ВидыНеоборотныхАктивов.ДругиеНеоборотныеМатериальныеАктивы)
	И		(Кво <> 1)   Тогда
		глКомментарий(Шаблон("В строке [НомерСтроки] для необоротного актива [НеоборотныйАктив] количество должно быть равно 1"),0,,"!");
		глВсеВыбрано = 0;
	КонецЕсли;
	Если (ПустоеЗначение(ДокументПодготовки) = 0) Тогда  
		//проверим наличие НМА в документе подготовки
		флПоиск = 0;
		ДокументПодготовки.ВыбратьСтроки();
		Пока (ДокументПодготовки.ПолучитьСтроку() = 1) и (флПоиск = 0) Цикл
			Если ДокументПодготовки.НеоборотныйАктив.Код = НеоборотныйАктив.Код Тогда
				флПоиск = 1;
			КонецЕсли;
		КонецЦикла;     
		Если флПоиск = 0 Тогда
			глКомментарий("Необоротный актив " + НеоборотныйАктив.Наименование + " не найден в выбранном документе подготовки!",0,,"!");
			глВсеВыбрано = 0;
		КонецЕсли;
	КонецЕсли;
	Возврат глВсеВыбрано;

КонецФункции

// ===============================
Процедура РассчитатьШапку()
	ВремРег = СоздатьОбъект("Регистры");
	
	Если ВидЛиквидации = Реализация Тогда
		СуммаГрнСНДС = глПересчет(Итог("СуммаСНДС"),Валюта,ДатаДок,Гривня,ДатаДок);
		Если ПустоеЗначение(Договор) = 1 Тогда
			ПервыйДок = ПолучитьПустоеЗначение("Документ");
		ИначеЕсли Найти("Договор,Заказ",Договор.Вид()) <> 0 Тогда
			ПервыйДок = Договор;
		Иначе
			ПервыйДок = ПолучитьПустоеЗначение("Документ");
		КонецЕсли;
		// взаиморасчеты
		ФлагОтгрузки = 1;
		ЗнакОплаты = -1; 

		// если выбран договор, проводим по нему, иначе по пустому договору
		глРассчитатьИтогиВзаиморасчетов(Контекст,ВремРег,Фирма,ЗнакОплаты,Контрагент, ПервыйДок, Валюта, 0);
	КонецЕсли;
	
КонецПроцедуры

// ===========================
Функция ДвиженияВзаиморасчеты()
	
	// взаиморасчеты
	ФлагОтгрузки = 1;
	ЗнакОплаты = -1;

	тбСуммыПогашения = глПолучитьСуммыДляПогашения(Контекст, Фирма, Валюта);
	тбДолги = глПолучитьИтогиВзаиморасчетов(Контекст,ВремРег, Фирма, ЗнакОплаты, Контрагент, ПервыйДок, Валюта);
	// Проверяем возможность кредита
	Если (ВидТорговли = Перечисление.ВидыТорговли.Кредит) И (Константа.РазрешитьПревышениеКредита = Нет) Тогда
		глКомментарий("Проверяется возможность кредита",2);
		// получим таблицу долгов для определения суммы задолженности
		тбДолгиКред = глПолучитьИтогиВзаиморасчетов(Контекст, ВремРег, Фирма,ЗнакОплаты, Контрагент, 0);
		ДолгКонтрагента = 0;
		Просрочено = 0;
		ПросроченныйДолг = 0;
		тбДолгиКред.ВыбратьСтроки();
		Пока тбДолгиКред.ПолучитьСтроку()=1 Цикл
			ДолгКонтрагента = ДолгКонтрагента + глПересчет(тбДолгиКред.ДолгОсн,Гривня,ДатаДок,Контрагент.ВалютаКредита,ДатаДок,);
			Если тбДолгиКред.ДолгОсн <= 0 Тогда
				Продолжить;
			КонецЕсли;
			текКредДок = тбДолгиКред.КредДокумент;
			ВидДокКред = текКредДок.Вид();
			Если глЕстьРеквизитШапки("ВидТорговли",ВидДокКред)=Да Тогда              
				// учитываем только документы по торговому кредиту
				Если текКредДок.ВидТорговли <> Перечисление.ВидыТорговли.Кредит Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			// расчитаем дату оплаты долга по ткущему документу из таблицы долгов
			Если глЕстьРеквизитШапки("ДатаОплаты",ВидДокКред)=Да Тогда
				ДатаОплаты = текКредДок.ДатаОплаты;
				Если ПустоеЗначение(ДатаОплаты)=1 Тогда
					ДатаОплаты = текКредДок.ДатаДок;
				КонецЕсли;
			Иначе 
				ДатаОплаты = текКредДок.ДатаДок + Контрагент.Глубина.Получить(текКредДок.ДатаДок);
			КонецЕсли;                                 
			// рассчитаем на сколько просрочен долг
			Если ДатаДок > ДатаОплаты Тогда
				ПросроченныйДолг = ПросроченныйДолг + тбДолгиКред.ДолгОсн;
				Если Просрочено<(ДатаДок-ДатаОплаты) Тогда
				    Просрочено = ДатаДок-ДатаОплаты;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ДолгКонтрагента = ДолгКонтрагента + глПересчет(Итог("СуммаСНДС"),Валюта,ДатаДок,Контрагент.ВалютаКредита,ДатаДок,);
		СуммаКредита = Контрагент.СуммаКредита.Получить(ДатаДок);
		глКомментарий("Долг контрагента составляет "+глФРМ(ДолгКонтрагента,Контрагент.ВалютаКредита,1)+", сумма кредита "+ глФРМ(СуммаКредита,Контрагент.ВалютаКредита,1) +".",3);
		Если ПустоеЗначение(СуммаКредита) = 0 Тогда 
			Если ДолгКонтрагента > СуммаКредита Тогда
				глКомментарий(Шаблон("Сумма накладной вместе с текущим долгом клиента ([глФРМ(ДолгКонтрагента,Контрагент.ВалютаКредита,1)]) превышает сумму кредита ([глФРМ(СуммаКредита,Контрагент.ВалютаКредита,1)]). "),0,,"!");
				Возврат 0;
			КонецЕсли;
		КонецЕсли;
		Если Просрочено>0 Тогда
			глКомментарий(Шаблон("Просрочена оплата [глФРМ(ПросроченныйДолг,Гривня,1)] на [Просрочено] дней."),0,,"!");
			Возврат 0;
		КонецЕсли;
		глКомментарий("Отпуск в кредит разрешен",3);
	КонецЕсли;		       
	глПровестиПоВзаиморасчетам(Контекст, ФлагОтгрузки, ЗнакОплаты, 0, Фирма, тбДолги, тбСуммыПогашения, Валюта,Контрагент, ПервыйДок, ВидТорговли, ДокументОснование);
	НДСПервоеСобытие = 0;
	НДСВтороеСобытие = 0;
	ВзаиморасчетыГрн = 0; // накапливаем сумму гривневого покрытия
	РегПоставщики=ВремРег.ВзаиморасчетыПоставщиков;
	РегПокупатели=ВремРег.ВзаиморасчетыПокупателей;
	РегПокупатели.ВыбратьДвиженияДокумента(ТекущийДокумент());
	Пока РегПокупатели.ПолучитьДвижение() = 1 Цикл
		
		// При оплате наличными формируются 2 движения, надо взять только одно. Возьмем приход.
		Если (Константа.ПроводкиПоКассеТолькоОрдерами = Нет) И 
				(ВидТорговли = Перечисление.ВидыТорговли.Нал) И (РегПокупатели.Расход = 1) Тогда
			Продолжить;
		КонецЕсли;
		Если Найти(АвансоваяОтгрузка+ПостОтгрузка+ПостОплата,РегПокупатели.КодОперации) = 0 Тогда
			// для формирования проводок по взаиморасчетам нам нужны только эти коды операций
			Продолжить;
		КонецЕсли;
		
		ВзаиморасчетыГрн = ВзаиморасчетыГрн + РегПокупатели.ДолгОсн;
		// проводки по кассе при оплате наличными
		Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
			// сформируем проводки по кассе, если они нужны
			Если Константа.ПроводкиПоКассеТолькоОрдерами = Нет Тогда
				глПроводка(Контекст,Касса.СчетУчета,СчетКонтрагента,РегПокупатели.Долг,"Оплата наличными",, 
					Касса,,, Контрагент,ПервыйДок,, ,,"НК",1,"Реализация необ. активов",1);
			КонецЕсли;
		КонецЕсли;
		// проводки по взаиморасчетам
		Если Валюта = Гривня Тогда
			глПроводка(Контекст,СчетКонтрагента,,РегПокупатели.Долг,"Реализация: необ. активы",, 
				Контрагент,ПервыйДок,, ,,, ,,"НК",1,"Реализация необ. активов",1);					
		Иначе	
			глПроводка(Контекст,СчетКонтрагента,,РегПокупатели.ДолгОсн,"Реализация: необ. активы",, 
				Контрагент,ПервыйДок,, ,,, РегПокупатели.Валюта,РегПокупатели.Долг,"НК",1,"Реализация необ. активов",1);					
		КонецЕсли;	  
		
		Если РегПокупатели.КодОперации = АвансоваяОтгрузка Тогда     					
			// сформируем проводки по НДС
			Если глДелатьПроводкиПоНалогам(РегПокупатели,"НДС") = 1 Тогда
				// для первого события
				глПроводка(Контекст,,"6415",РегПокупатели.НДС,"НДС: первое событие",, 
					,,, ВидНДС,,, ,,"НК",1,"НДС первого события",1);                                                     
				НДСПервоеСобытие = НДСПервоеСобытие + РегПокупатели.НДС;
			КонецЕсли;	
		// погашение аванса
		ИначеЕсли РегПокупатели.КодОперации = ПостОтгрузка Тогда     					
			Если глВыделятьЛиАвансыПоСчету(СчетКонтрагента) = 1 Тогда
				Если Валюта=Гривня Тогда
					глПроводка(Контекст,"6811",СчетКонтрагента,РегПокупатели.Долг,"Реализация: необ. активы: погашен авансовый платеж",, 
						Контрагент,ПервыйДок,, Контрагент,ПервыйДок,, ,,"НК",1,"Реализация необ. активов",1);
				Иначе
					глПроводка(Контекст,"6812",СчетКонтрагента,РегПокупатели.ДолгОсн,"Реализация за валюту: необ. активы: погашен авансовый платеж",, 
						Контрагент,ПервыйДок,, Контрагент,ПервыйДок,, РегПокупатели.Валюта,РегПокупатели.Долг,"НК",1,"Реализация необ. активов",1);
				КонецЕсли;
			КонецЕсли;      
			// сформируем проводки по НДС
			Если глДелатьПроводкиПоНалогам(РегПокупатели,"НДС") = 1 Тогда
				// для второго события
				глПроводка(Контекст,,"64.3",РегПокупатели.НДС,"НДС: второе событие",, 
					,,, Контрагент,ПервыйДок,, ,,"НК",1,"НДС второго события",1);
				// посчитаем НДС предварительной оплаты
				НДСВтороеСобытие = НДСВтороеСобытие + РегПокупатели.НДС;
			КонецЕсли;                                                                        
		КонецЕсли;                                                                        
	КонецЦикла;
	
	Возврат 1;
КонецФункции

// ===============================
Процедура РассчитатьРеализацию()
	
	КурсРеализация = ?(ПустоеЗначение(Итог("СуммаБезНДС"))=1,0,ВзаиморасчетыГрн/Итог("СуммаБезНДС"));
	// таблица значений для разделения проводок по видам деятельности
	ТаблВиды = СоздатьОбъект("ТаблицаЗначений");
	ТаблВиды.НоваяКолонка("ВидДеятельности","Справочник.ВидыДеятельности");
	ТаблВиды.НоваяКолонка("СуммаСНДС"      ,"Число",12,2);
	ТаблВиды.НоваяКолонка("НДСПерв"        ,"Число",13,3);
	ТаблВиды.НоваяКолонка("НДСВтор"        ,"Число",13,3);
	ТаблВиды.НоваяКолонка("СуммаГрнСНДС"   ,"Число",12,2);
	ТаблВиды.НоваяКолонка("ГрнНДСПерв"     ,"Число",13,3);
	ТаблВиды.НоваяКолонка("ГрнНДСВтор"     ,"Число",13,3);

	// инициализация алгоритмов корректого распределения
	глОчиститьКлючОкр("Взаим");
	глОчиститьКлючОкр("ВзаимГрн");
	глОчиститьКлючОкр("НДС");
	глОчиститьКлючОкр("НДСперв");
	глОчиститьКлючОкр("НДСГрн");
	глОчиститьКлючОкр("НДСГрнперв");
	НДСпоВзаиморасчетам	= НДСПервоеСобытие + НДСВтороеСобытие;
	ИтогНДС = Итог("НДС");
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		ТаблВиды.НоваяСтрока();
		ТаблВиды.ВидДеятельности = НеоборотныйАктив.ВидДеятельности;
		ТаблВиды.СуммаСНДС	 	 = глОкрКорр("Взаим", СуммаСНДС,2);
		ТаблВиды.СуммаГрнСНДС	 = глОкрКорр("ВзаимГрн", СуммаСНДС * КурсРеализация, 2);
		
		ПострНДС		= глОкрКорр("НДС", ?(ИтогНДС = 0, 0, НДСпоВзаиморасчетам * НДС / ИтогНДС),2);
		ПострНДСПерв	= глОкрКорр("НДСперв", ?(НДСпоВзаиморасчетам = 0, 0, НДСПервоеСобытие * ПострНДС / НДСпоВзаиморасчетам),2);
		ПострНДСГрн		= глОкрКорр("НДСГрн", ?(ИтогНДС = 0, 0, КурсРеализация * НДСпоВзаиморасчетам * НДС / ИтогНДС),2);
		ПострНДСГрнПерв	= глОкрКорр("НДСГрнперв", ?(НДСпоВзаиморасчетам = 0, 0, НДСПервоеСобытие * ПострНДСГрн / НДСпоВзаиморасчетам),2);
		
		ТаблВиды.НДСПерв	 	 = ПострНДСПерв;
		ТаблВиды.НДСВтор	 	 = ПострНДС - ПострНДСПерв;
		ТаблВиды.ГрнНДСПерв		 = ПострНДСГрнПерв;
		ТаблВиды.ГрнНДСВтор		 = ПострНДСГрн - ПострНДСГрнПерв;
	КонецЦикла;

	// свернем по видам деятельности
	ТаблВиды.Свернуть("ВидДеятельности","СуммаСНДС,НДСПерв,НДСВтор,СуммаГрнСНДС,ГрнНДСПерв, ГрнНДСВтор");
КонецПроцедуры //

// ===============================
Процедура ПроводкиШапка()
	Если ПодготовкаКРеализации = 1 Тогда
		СчетНМА = "71.2";
		СубСтатья = "";
	Иначе
		СчетНМА = "74.6";
		СубСтатья = СтатьяНалоговойДекларации;
	КонецЕсли;
	Если ВидЛиквидации = Списание Тогда

		Если ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ВынужденнаяЗаменаЕслиВиновныйУстановлен Тогда
			// списываем на виновное лицо
			глПроводка(Контекст,"37.5",СчетНМА,СуммаВозмещения,"Подлежит возмещению виновным",, 
				Виновный,,, ВидДеятельности,,, ,,"НА");
			Если СуммаВозмещения > Итог("ПервСтоимость")-Итог("Износ") Тогда
				// сумму превышения должны перечислить в бюджет
				// согласно ст 10. Порядка, утвержденного 22.01.96 № 116
				глПроводка(Контекст,СчетНМА,"64.2.6",СуммаВозмещения-(Итог("ПервСтоимость")-Итог("Износ")),"Превышение возмещения над убытком",, 
					ВидДеятельности,,, ВидНДС,,, ,,"НА");
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ВидЛиквидации = Реализация Тогда 

		ТаблВиды.ВыбратьСтроки();
		Пока ТаблВиды.ПолучитьСтроку()=1 Цикл
			Если Валюта = Гривня  Тогда
				глПроводка(Контекст,,СчетНМА,ТаблВиды.СуммаСНДС,"Реализация: необ. активы: "+ТаблВиды.ВидДеятельности,, 
					,,, ТаблВиды.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",1,"Реализация необ. активов");
				глПроводка(Контекст,СчетНМА,,ТаблВиды.НДСПерв,"НДС",, ТаблВиды.ВидДеятельности,Подразделение,СубСтатья,
					,,, ,,"НК",1,"НДС первого события");
				глПроводка(Контекст,СчетНМА,,ТаблВиды.НДСВтор,"НДС",, ТаблВиды.ВидДеятельности,Подразделение,СубСтатья,
					,,, ,,"НК",1,"НДС второго события");
				Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
					Если (Константа.ПроводкиПоКассеТолькоОрдерами = Нет) и (ИспользоватьСчетНДС = 1) Тогда
						глПроводка(Контекст, "СН.Н",,ТаблВиды.НДСПерв + ТаблВиды.НДСВтор,"НДС к зачислению на спец счет",, Контрагент, ПервыйДок,,
				    	,,, ,,"НА",1);
					КонецЕсли;
				КонецЕсли;	
	
			Иначе
				глПроводка(Контекст,,СчетНМА,ТаблВиды.СуммаГрнСНДС,"Реализация за валюту: необ. активы: "+ТаблВиды.ВидДеятельности,, 
					,,, ТаблВиды.ВидДеятельности,Подразделение,СубСтатья, Валюта,ТаблВиды.СуммаСНДС,"НА",1,"Реализация необ. активов");
				глПроводка(Контекст,СчетНМА,,ТаблВиды.ГрнНДСПерв,"НДС",, ТаблВиды.ВидДеятельности,Подразделение,СубСтатья,
					,,, Валюта,,"НК",1,"НДС первого события");
				глПроводка(Контекст,СчетНМА,,ТаблВиды.ГрнНДСВтор,"НДС",, ТаблВиды.ВидДеятельности,Подразделение,СубСтатья,
					,,, Валюта,,"НК",1,"НДС второго события");
				Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
					Если (Константа.ПроводкиПоКассеТолькоОрдерами = Нет) и (ИспользоватьСчетНДС = 1) Тогда
						глПроводка(Контекст, "СН.Н",,ТаблВиды.ГрнНДСПерв + ТаблВиды.ГрнНДСВтор,"НДС к зачислению на спец счет",, Контрагент, ПервыйДок,,
				    	,,, ,,"НА",1);
					КонецЕсли;
				КонецЕсли;		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// ===============================
Функция КоэффициентСписания()
	// возвращает отношение списываемого кол-ва к остаточному по бухучету
	Перем	Ит, ОстКво;
	
	ОстКво = 0;
			
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы, НеоборотныйАктив, 2);
	Ит.ИспользоватьСубконто(ВидыСубконто.МестаХранения, МестоХранения, 2);
	Ит.ВыполнитьЗапрос(ТекущийДокумент(),,НеоборотныйАктив.Счет);
	
	ОстКво = Ит.СКД("К");
	ОстКво = ?(ОстКво = 0, 1, ОстКво);
	
	Возврат Кво/ОстКво;
КонецФункции
// ===============================
Функция БалСтоимостьНУ()
	ПервСтоимНУ = СтоимостьИзТаблицы(СчетНУ,НеоборотныйАктив,МестоХранения);
	Если СчетНУ = "Н286" Тогда
		ИзносНУ = 0;
	Иначе	
		ИзносНУ   = Ит.СКК(СчетИзносаНУ,,,НеоборотныйАктив);
	КонецЕсли;
	
	КоэфСпис = КоэффициентСписания();
	
	ПервСтоимНУ = ПервСтоимНУ*КоэфСпис;
	ИзносНУ   = ИзносНУ*КоэфСпис;
	
	БалСтоимость = ПервСтоимНУ - ИзносНУ;
	
	Возврат БалСтоимость;
КонецФункции

// ===============================
// проводки по бухгалтерскому учету при списании
Процедура ПроводкиСписаниеБух()
    
	ИзносПроводка = Износ;
	Если  (НеоборотныйАктив.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц)
		И (ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ПоРешениюНалогоплательщикаИлиКМУ) Тогда
		// доначисляем оставшиеся 50% износа
		глПроводкаПоЗатратам(Контекст,СчетЗатрат,СчетИзноса,ПервСтоимость - Износ,"Начислен износ",, НеоборотныйАктив.ВидДеятельности,Подразделение,НеоборотныйАктив.ВидЗатрат, 
		НеоборотныйАктив,,, ,,"НА");
		глПроводка(Контекст,"09",,ПервСтоимость - Износ,"Начислен износ",, ,,,
		,,, ,,"НА");
		
		Если СчетЗатрат.Код = "231" Тогда
			// нужно отразить затраты в регистре
			Регистр.ПроизводственныеЗатраты.ПривязыватьСтроку(НомерСтроки);
			Регистр.ПроизводственныеЗатраты.ДвижениеПриход(Фирма,НеоборотныйАктив.ВидДеятельности,Подразделение,НеоборотныйАктив.Продукция,НеоборотныйАктив.ВидЗатрат,,,,ПервСтоимость - Износ,,ОтражениеЗатрат,);
		КонецЕсли;
		ИзносПроводка = ПервСтоимость;
		ОстСтоимость = 0;
	КонецЕсли;
	
	глПроводка(Контекст,СчетИзноса,СчетУчета,ИзносПроводка,"Износ ликвидированных необ. активов",, 
				НеоборотныйАктив,,, Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");
	
	СчетЗатр = ?(ИспользоватьСчетаРасходов = Класс8, "85", "97.6");
	глПроводка(Контекст,СчетЗатр,СчетУчета,ОстСтоимость,"Остат. стоим. ликвид. необ. активов",Кво, 
	НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат, Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");
	Если (ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ПоРешениюНалогоплательщикаИлиКМУ) Тогда
		Если (НеоборотныйАктив.Производственное = 1) И (ЭтоНМА = 0) Тогда
			БалСтоимость = БалСтоимостьНУ();
			ОстСтоимостьНДС = БалСтоимость * ВидНДС.Ставка.Получить(ДатаДок);
		Иначе
			ОстСтоимостьНДС = ОстСтоимость * ВидНДС.Ставка.Получить(ДатаДок);
		КонецЕсли;
		глПроводка(Контекст,СчетЗатр,"64.1.5",ОстСтоимостьНДС,"НДС от остат. стоим. ликвид. необ. активов",, 
					НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат, ВидНДС,,, ,,"НА");
	КонецЕсли;
КонецПроцедуры
    
// ===============================
// проводки по налоговому учету при списании
Процедура ПроводкиСписаниеНал()
	// пообъектно
	БалСтоимость = БалСтоимостьНУ();

	СчетЗатрНУ = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "Н85", "Н97.6");
	
	Если НеоборотныйАктив.Производственное = 1 Тогда
		Если НеоборотныйАктив.МетодРасчетаИзноса = Перечисление.МетодыРасчетаИзноса.ПервыйИПоследнийМесяц Тогда
			// доначисляем 50% износа 
			// разница на затраты    
			ИзносБУ = ПервСтоимость - Износ;
			глПровНУ(Контекст,СчетЗатрНУ,,ИзносБУ-БалСтоимость,"Разн:Начислен износ НУ",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат
			,,, ,,"НА",ИзносБУ-БалСтоимость);
			//износ
			глПровНУ(Контекст,,СчетИзносаНУ,БалСтоимость,"Начислен износ НУ",, ,,, НеоборотныйАктив,,, ,,"НА",БалСтоимость);  
			// теперь делаем проводку с учетом доначисленного износа
			глПровНУ(Контекст,СчетИзносаНУ,СчетНУ,ИзносНУ + БалСтоимость,"Износ ликвидированных необ. активов НУ",, НеоборотныйАктив,,,
			Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",ИзносНУ + БалСтоимость);
			ОстСтоимость = 0;
		Иначе
			// списываем балансовую стоимость
			глПровНУ(Контекст,,СчетНУ,БалСтоимость, "НУ: Списание "+НеоборотныйАктив,, ,,, Подразделение,МестоХранения,НеоборотныйАктив,
			,, "НА",БалСтоимость); 
		
			глПровНУ(Контекст,СчетИзносаНУ,СчетНУ,ИзносНУ,"Износ ликвидированных необ. активов НУ",, НеоборотныйАктив,,,
			Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",ИзносНУ);
		КонецЕсли;
		Если	(ТипСписания <> Перечисление.ТипыСписанияНеоборАктивов.ПоРешениюНалогоплательщикаИлиКМУ) 
		    	И (ТипСписания <> Перечисление.ТипыСписанияНеоборАктивов.ПоДругойПричине) Тогда
			    // вынужденная замена
				// разница
				глПровНУ(Контекст,СчетЗатрНУ,, БалСтоимость - ОстСтоимость,"Разн:Списание необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,
				,,, ,,"НА",БалСтоимость - ОстСтоимость);  
				
		КонецЕсли;
	Иначе
		//для непроизводственных НМА мы должны списать Балансовую стоимость в НУ 
		глПровНУ(Контекст,,СчетНУ,БалСтоимость, "НУ: Списание "+НеоборотныйАктив,, ,,, Подразделение,МестоХранения,НеоборотныйАктив,
		,, "НА",БалСтоимость); 
			
	КонецЕсли;

КонецПроцедуры
              
// ===============================
// проводки по бухгалтерскому учету при продаже
Процедура ПроводкиПродажаБух()

	//Подготовка к реализации     
	Если ВидЛиквидации = Подготовка Тогда
		СчетЗатр = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "84", "94.3");   
		глПроводка(Контекст, "28.6",СчетУчета,ПервСтоимость - Износ,"Остат. стоим. подготовка к реализ. необ. активов",Кво, МестоХраненияПодготовки,НеоборотныйАктив,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");
		глПроводка(Контекст,СчетИзноса, СчетУчета,Износ,"Износ подготовка к реализ. необ. активов",, НеоборотныйАктив,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");

	ИначеЕсли ПустоеЗначение(ДокументПодготовки)=0 Тогда   
		//реализация после подготовки
		СчетЗатр = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "84", "94.3");  
		глПроводка(Контекст,СчетЗатр,"28.6",ПервСтоимость,"Остат. стоим. реализованных необ. активов",Кво, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
		МестоХранения,НеоборотныйАктив,, ,,"НА");
	ИначеЕсли ПодготовкаКРеализации = 1 Тогда   
		//реализация вместе с подготовкой к реализации
		СчетЗатр = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "84", "94.3");  
		глПроводка(Контекст,"28.6",СчетУчета,ПервСтоимость - Износ,"Остат. стоим. подготовка к реализ. необ. активов",Кво, 
		МестоХранения,НеоборотныйАктив,, Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");       
		глПроводка(Контекст,СчетИзноса, СчетУчета,Износ,"Износ подготовка к реализ. необ. активов",, 
		НеоборотныйАктив,,,Подразделение, МестоХранения,НеоборотныйАктив, ,,"НА");
		глПроводка(Контекст,СчетЗатр,"28.6",ПервСтоимость - Износ,"Остат. стоим. реализованных необ. активов",Кво, 
		НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат ,МестоХранения,НеоборотныйАктив,, ,,"НА");       
	Иначе
		//просто реализация
		СчетЗатр = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "85", "97.7");
		глПроводка(Контекст,СчетИзноса,СчетУчета,Износ,"Износ реализованных необ. активов",, 
		НеоборотныйАктив,,, Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");
		
		глПроводка(Контекст,СчетЗатр,СчетУчета,ОстСтоимость,"Остат. стоим. реализованных необ. активов",Кво, 
		НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат, Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА");       
	КонецЕсли;
КонецПроцедуры
// ===============================
// проводки по налоговому учету при продаже
Процедура ПроводкиПродажаНал()
	СчетНУ = ?(ПустоеЗначение(ДокументПодготовки)=0, "Н286",СчетНУ);
	ПервСтоимНУ = СтоимостьИзТаблицы(СчетНУ,НеоборотныйАктив,МестоХранения);
	Если СчетНУ = "Н286" Тогда
		ИзносНУ = 0;
	Иначе	
		ИзносНУ   = Ит.СКК(СчетИзносаНУ,,,НеоборотныйАктив);
	КонецЕсли;
	
	КоэфСпис = КоэффициентСписания();
	
	ПервСтоимНУ = ПервСтоимНУ*КоэфСпис;
	ИзносНУ   = ИзносНУ*КоэфСпис;
	
	СчетДохНУ = ?((ПодготовкаКРеализации = 1) или (ПустоеЗначение(ДокументПодготовки) = 0), "Н71.2", "Н74.6");
	СубСтатья = ?((ПодготовкаКРеализации = 1) или (ПустоеЗначение(ДокументПодготовки) = 0), "", СтатьяНалоговойДекларации);

	БалСтоимость = ПервСтоимНУ - ИзносНУ; 
	//затраты 
	СуммаПрод = глПересчет(СуммаБезНДС,Валюта,Гривня,Курс,ДатаДок);
	ЗатратыНУ = 0; ДоходНУ = 0; 
	Если ВидЛиквидации = Подготовка Тогда  
		Если (ДатаДок<'01.01.2015') Тогда
			//разница
			глПровНУ(Контекст, "Н28.6",,0,"Разн:Стоим.НУ подготовка к реализ. необ. активов",, МестоХраненияПодготовки,НеоборотныйАктив,,
			,,, ,,"НА",БалСтоимость - ОстСтоимость); 
		КонецЕсли;
		//остаточная стоимость
		глПровНУ(Контекст, ,СчетНУ,0,"Стоим.НУ подготовка  к реализ. необ. активов",, ,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",БалСтоимость);   
		// износ
		глПровНУ(Контекст,СчетИзносаНУ,СчетНУ,ИзносНУ,"Износ НУ ликвидированных необ. активов",, НеоборотныйАктив,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",ИзносНУ);

	ИначеЕсли ПустоеЗначение(ДокументПодготовки)=0 Тогда   
		//реализация после подготовки    
		СчетЗатрНУ = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "80", "94.3"); 
		Если (ДатаДок<'01.01.2015') Тогда
			//разница
			глПровНУ(Контекст,,"Н28.6",БалСтоимость,"Разн:Стоим.НУ реализованных необ. активов",, ,,,
			МестоХранения,НеоборотныйАктив,, ,,"НА",БалСтоимость);
		КонецЕсли;
		ОстСтоимНУ = ОстСтоимость + БалСтоимость;
		Если ОстСтоимНУ - СуммаПрод > 0 Тогда
			глПровНУ(Контекст,СчетЗатрНУ,,ОстСтоимНУ - СуммаПрод - ОстСтоимость,"Разн:Затраты НУ реализ. необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА",ОстСтоимНУ - СуммаПрод - ОстСтоимость);
			глПровНУ(Контекст,,СчетДохНУ,-СуммаБезНДС,"Разн:Доход НУ реализ. необ. активов ",, ,,,
			НеоборотныйАктив.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",-СуммаБезНДС);
		Иначе	
			//доходы
			глПровНУ(Контекст,,СчетДохНУ,-ОстСтоимНУ,"Разн:Доход НУ реализ. необ. активов ",, ,,,
			НеоборотныйАктив.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",-ОстСтоимНУ);
			глПровНУ(Контекст,СчетЗатрНУ,, - ПервСтоимость,"Разн:Затраты НУ реализ. необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА", - ПервСтоимость);
		КонецЕсли;
	ИначеЕсли ПодготовкаКРеализации = 1 Тогда   
		//реализация вместе с подготовкой к реализации
		СчетЗатрНУ = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "80", "94.3");
		Если (ДатаДок<'01.01.2015') Тогда
			// разница
			глПровНУ(Контекст, "Н28.6",,БалСтоимость - ОстСтоимость,"Разн:Стоим.НУ подготовка к реализ. необ. активов",, МестоХранения,НеоборотныйАктив,,
			,,, ,,"НА",БалСтоимость-ОстСтоимость);  
		КонецЕсли;
		//остаточная стоимость
		глПровНУ(Контекст,,СчетНУ,БалСтоимость,"Стоим.НУ подготовка к реализ. необ. активов",, ,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",БалСтоимость);
		// износ
		глПровНУ(Контекст,СчетИзносаНУ, СчетНУ,ИзносНУ,"Износ НУ подготовка к реализ. необ. активов",, НеоборотныйАктив,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",ИзносНУ);
		Если (ДатаДок<'01.01.2015') Тогда
			//разница
			глПровНУ(Контекст,,"Н28.6",БалСтоимость-ОстСтоимость,"Разн:Стоим. реализованных необ. активов",, ,,,
			МестоХранения,НеоборотныйАктив,, ,,"НА",БалСтоимость-ОстСтоимость);
		КонецЕсли;
		Если БалСтоимость - СуммаПрод > 0 Тогда
			//затраты 
			глПровНУ(Контекст,СчетЗатрНУ,,БалСтоимость - СуммаПрод - ОстСтоимость,"Разн:Затраты НУ реализ. необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА",БалСтоимость - СуммаПрод - ОстСтоимость);
			глПровНУ(Контекст,,СчетДохНУ,-СуммаБезНДС,"Разн:Доход НУ реализ. необ. активов ",, ,,,
			НеоборотныйАктив.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",-СуммаБезНДС);
		Иначе	
			//доходы
			глПровНУ(Контекст,,СчетДохНУ,-БалСтоимость,"Разн:Доход НУ реализ. необ. активов ",, ,,,
			НеоборотныйАктив.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",-БалСтоимость);
			глПровНУ(Контекст,СчетЗатрНУ,, Износ - ПервСтоимость,"Разн:Затраты НУ реализ. необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА", - ПервСтоимость);
		КонецЕсли;
	Иначе    
		//просто реализация
		СчетЗатрНУ = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "80", "97.7");
		глПровНУ(Контекст,СчетИзносаНУ,СчетНУ,ИзносНУ,"Износ НУ реализованных необ. активов",, НеоборотныйАктив,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",ИзносНУ);
		//разница
		Если БалСтоимость - СуммаПрод > 0 Тогда
			глПровНУ(Контекст,СчетЗатрНУ,,БалСтоимость - СуммаПрод-ОстСтоимость,"Разн:Затраты НУ реали. необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА",БалСтоимость - СуммаПрод-ОстСтоимость);
			глПровНУ(Контекст,,СчетДохНУ,-СуммаБезНДС,"Разн:Доход НУ реализ. необ. активов ",, ,,,
			НеоборотныйАктив.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",-СуммаБезНДС);
		Иначе	
			//доходы
			глПровНУ(Контекст,,СчетДохНУ,-БалСтоимость,"Разн:Доход НУ реализ. необ. активов ",, ,,,
			НеоборотныйАктив.ВидДеятельности,Подразделение,СубСтатья, ,,"НА",-БалСтоимость);
			глПровНУ(Контекст,СчетЗатрНУ,, Износ - ПервСтоимость,"Разн:Затраты НУ реализ. необ. активов",, НеоборотныйАктив.ВидДеятельности,Подразделение,ВидЗатрат,
			,,, ,,"НА", - ПервСтоимость);
		КонецЕсли;
		//остаточная стоимость
		глПровНУ(Контекст,,СчетНУ,БалСтоимость,"Стоим.НУ реализованных необ. активов",, ,,,
		Подразделение,МестоХранения,НеоборотныйАктив, ,,"НА",БалСтоимость);
	КонецЕсли;  
КонецПроцедуры

// ===============================
Процедура ПроводкиСтрока()
	// для бухгалтерского учета
	СумГрнБезНДС = глПересчет(СуммаБезНДС,Валюта,ДатаДок,Гривня,ДатаДок);
	ОстСтоимость = ПервСтоимость - Износ;
	
	// для налогового учета
	ЭтоНМА = 0;

	Если (ВидЛиквидации = Реализация) и (ПустоеЗначение(ДокументПодготовки) = 0) Тогда
		СчетУчета 	= СчетПоКоду("28.6");   
		Если Сред(НеоборотныйАктив.Счет.Код,1,2) = "12" Тогда
			ЭтоНМА = 1;
			СчетИзноса = СчетПоКоду("133");
		КонецЕсли;
	Иначе
		СчетУчета 	= НеоборотныйАктив.Счет;   
	КонецЕсли;
	СчетЗатрат	= НеоборотныйАктив.СчетЗатрат;

	Если Сред(СчетУчета.Код,1,2) = "10" Тогда
		Если НеоборотныйАктив.Счет.Код = "100" Тогда
			СчетИзноса = СчетПоКоду("135");
		Иначе	
			СчетИзноса = СчетПоКоду("131");
		КонецЕсли;
	ИначеЕсли Сред(СчетУчета.Код,1,2) = "12" Тогда
		ЭтоНМА = 1;
		СчетИзноса = СчетПоКоду("133");
	Иначе
		СчетИзноса = СчетПоКоду("132");
	КонецЕсли;
	СчетНУ = "Н" + НеоборотныйАктив.Счет; 
	СчетИзносаНУ = "Н" + СчетИзноса;
	
	Если ВидЛиквидации = Списание Тогда
		// списание
		ПроводкиСписаниеБух();
		//Если НеоборотныйАктив.Производственное = 1 Тогда
			// производственное, амортизировалось в налоговом учете
			ПроводкиСписаниеНал();
		//КонецЕсли;
	Иначе
		// продажа
		ПроводкиПродажаБух();
		ПроводкиПродажаНал();
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ЗаписатьИзмененияПараметров()
	Если (ВидЛиквидации = Подготовка) Тогда
		Сост = Перечисление.СостоянияНеоборАктивов.Подготовка;
	Иначе     
		Сост = Перечисление.СостоянияНеоборАктивов.Выбыл;
	КонецЕсли;
    УстановитьРеквизитСправочника(НеоборотныйАктив,"Состояние",Сост,ТекущийДокумент());
КонецПроцедуры //

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);
	ИспользоватьСчетНДС = глИспользоватьСчетНДС(Контекст);
	глТбОперация.УдалитьСтроки();

	Списание = Перечисление.ВидыЛиквидацииНеоборАктивов.Списание;
	Реализация = Перечисление.ВидыЛиквидацииНеоборАктивов.Реализация;
	Подготовка = Перечисление.ВидыЛиквидацииНеоборАктивов.ПодготовкаКРеализации;
	
	Если ПроверкаШапки() = 0 Тогда
	    глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли;

	ВыбратьСтроки();
	Пока ПолучитьСтроку()=1 Цикл
		Если ПроверкаСтроки()=0 Тогда
		    глНеПроводить(Контекст);
		    Возврат;
		КонецЕсли;
	КонецЦикла;	
	
	РассчитатьШапку();
	Если ВидЛиквидации = Реализация Тогда
		Если ДвиженияВзаиморасчеты() = 0 Тогда	
			глТбОперация.УдалитьСтроки();
			глНеПроводить(Контекст);
			Возврат;
		КонецЕсли;	   
		РассчитатьРеализацию();
	КонецЕсли;
	ПроводкиШапка();
	
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ВключатьСубсчета(-1,1); // без групп
	ТаблицаБалСтоимость = СоздатьОбъект("ТаблицаЗначений");
	ТаблицаБалСтоимость.НоваяКолонка("Счет");
	ТаблицаБалСтоимость.НоваяКолонка("Объект"); 
	ТаблицаБалСтоимость.НоваяКолонка("МестоХранения"); 
	ТаблицаБалСтоимость.НоваяКолонка("СтоимостьНУ"); 
	
	Если (ВидЛиквидации = Реализация) и (ПустоеЗначение(ДокументПодготовки)=0) Тогда 
		//реализация после подготовки
		Ит.ИспользоватьСубконто(ВидыСубконто.МестаХранения);
		Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		Ит.ВыполнитьЗапрос(,ТекущийДокумент(),"Н286"); 
		НомСуб = 1;
	Иначе
		Ит.ИспользоватьСубконто(ВидыСубконто.Подразделения,Подразделение);
		Ит.ИспользоватьСубконто(ВидыСубконто.МестаХранения);
		Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		Ит.ВыполнитьЗапрос(,ТекущийДокумент(),"Н10,Н11,Н12");
		НомСуб = 2;
	КонецЕсли;
    
		
	//Перенесем итоги в таблицу значений
	Ит.ВыбратьСчета();
	Пока Ит.ПолучитьСчет()=1 Цикл
		Ит.ВыбратьСубконто(НомСуб);//место хранения
		Пока Ит.ПолучитьСубконто(НомСуб) = 1 Цикл
			Ит.ВыбратьСубконто(НомСуб+1); //НМА
			Пока Ит.ПолучитьСубконто(НомСуб+1) = 1 Цикл
				ТаблицаБалСтоимость.НоваяСтрока();
				ТаблицаБалСтоимость.Счет = Ит.Счет;
				ТаблицаБалСтоимость.МестоХранения = Ит.Субконто(НомСуб);
				ТаблицаБалСтоимость.Объект = Ит.Субконто(НомСуб+1);
				ТаблицаБалСтоимость.СтоимостьНУ = Ит.СКД();
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла;
	
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");  
	Ит.Рассчитать(,ТекущийДокумент(),"Н131,Н132,Н133,Н135",,,Фирма);

	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		ПроводкиСтрока();
		Операция.ЗаписатьПроводки();
	КонецЦикла;

	глЗаписатьПроводкиВОперацию(Контекст);
	Операция.СуммаОперации = ?(ВидЛиквидации = Списание, 0, Итог("СуммаСНДС"));
	Операция.Содержание = ?(ВидЛиквидации = Списание, "Списание", "Реализация") + " " + Примечание;
	Операция.Записать();

	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		ЗаписатьИзмененияПараметров();
	КонецЦикла;

	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры

