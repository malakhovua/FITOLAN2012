// ===============================
// ОПИСАНИЕ МОДУЛЬНЫХ ПЕРЕМЕННЫХ
// ===============================
Перем Списание, Реализация, Подготовка, Таб;
Перем СписокДействий;        
Перем НачальнаяДатаДокумента;
Перем СтараяДата;
                          

// ===============================
Функция УстДоступность()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	Форма.Фирма.Видимость(0);
	Форма.Заголовок(глЗаголовок(Контекст,"Ликвидация (списание, реализация) необоротных активов"));
	// доступность в зависимости от слоя
	Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
		Форма.тКасса.Заголовок("Касса");
	Иначе
		Форма.тКасса.Заголовок("Р/счет:");
	КонецЕсли;
	Закл = Форма.Закладки.ПолучитьЗначение(Форма.Закладки.ТекущаяСтрока());
	Если Закл = "Основной" Тогда
		фРеализация = ?(ВидЛиквидации = Реализация, 1, 0);

		Форма.ДокументПодготовки.Видимость(фРеализация); 
		Форма.ТекстДокПодг.Видимость(фРеализация); 
		Форма.ЦенаБезНДС.Видимость(фРеализация);
		Форма.СуммаБезНДС.Видимость(фРеализация);
		Форма.НДС.Видимость(фРеализация);
		Форма.СуммаСНДС.Видимость(фРеализация);

		фПодготовка = ?(ВидЛиквидации = Подготовка, 1, 0);
		Форма.МестоХраненияПодготовки.Видимость(фПодготовка); 
		Форма.кПечать.Видимость(1 - фПодготовка); 
	ИначеЕсли Закл = "Списание" Тогда
		Если ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ВынужденнаяЗаменаЕслиВиновныйУстановлен Тогда
			Доступность = 1;
		Иначе
			Доступность = 0;
		КонецЕсли;
		Форма.Виновный.			Доступность(Доступность);
		Форма.СуммаВозмещения.	Доступность(Доступность);
		Форма.ВидДеятельности.	Доступность(Доступность);
	ИначеЕсли Закл = "Реализация" Тогда
		Видимость = 0;
		Если ВидТорговли = Перечисление.ВидыТорговли.Кредит Тогда
			// нет кредита - нет глубины
			Если Контрагент.Глубина.Получить(ДатаДок) > 0 Тогда
				Видимость = 1;
			КонецЕсли;
		КонецЕсли;
		Форма.тДатаОплаты.	Видимость(Видимость);
		Форма.тГлубина.		Видимость(Видимость);
		Форма.Глубина.		Видимость(Видимость);

		Форма.тСерия.Заголовок(?(ПолучилПоДругомуДокументу=0,"Серия:","Документ:"));
		Форма.ДовСерия.Видимость(1-ПолучилПоДругомуДокументу);
		Форма.тНомер.Видимость(1-ПолучилПоДругомуДокументу);
		Форма.ДовНомер.Видимость(1-ПолучилПоДругомуДокументу);
		Форма.тОт.Видимость(1-ПолучилПоДругомуДокументу);
		Форма.ДовДата.Видимость(1-ПолучилПоДругомуДокументу);
		Форма.ДокументПолучил.Видимость(ПолучилПоДругомуДокументу);
	КонецЕсли;
	Если	(НеоборотныйАктив.ВидНеоборотногоАктива <> НМА)
	И		(НеоборотныйАктив.ВидНеоборотногоАктива <> Перечисление.ВидыНеоборотныхАктивов.ДругиеНеоборотныеМатериальныеАктивы)
	Тогда
		Форма.Кво.Доступность(0);
	Иначе
		Форма.Кво.Доступность(1);
	КонецЕсли;
	Если ДатаГод (ДатаДок) < 2008 Тогда
		ПодготовкаКРеализации = 0;
		Форма.ПодготовкаКРеализации.Доступность(0);     
	Иначе
		Форма.ПодготовкаКРеализации.Доступность(1);     
	КонецЕсли;            

	//закладки
   	Если ВидЛиквидации = Подготовка Тогда
		Инд = Форма.Закладки.НайтиЗначение("Дополнительный");
		Инд = ?(Инд <> 0, Инд,Форма.Закладки.НайтиЗначение("Реализация"));
		Инд = ?(Инд <> 0, Инд,Форма.Закладки.НайтиЗначение("Списание"));  
		Если (Инд <> 0) Тогда
			// удалим закладку
			Форма.Закладки.УдалитьЗначение(Инд); 
		КонецЕсли;
	Иначе
		Инд = Форма.Закладки.НайтиЗначение("Дополнительный");
		Инд = ?(Инд <> 0, Инд,Форма.Закладки.НайтиЗначение("Реализация"));
		Инд = ?(Инд <> 0, Инд,Форма.Закладки.НайтиЗначение("Списание"));  
		Если (Инд = 0) Тогда
			// добавим закладку
			//Дополнительный = ?(ВидЛиквидации = Списание,"Списание","Реализация");
			Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
		КонецЕсли;
	КонецЕсли;

КонецФункции

// ===============================
Процедура Накладная()
	глУстПропись(Валюта);
	Таб.ПараметрыСтраницы(1); // портрет
	НомДок = Сред(НомерДок,1,3)+"НА/"+Сред(НомерДок,4);
	ПечОснование=глСтрокаОснование(Контекст,Договор,ДокументОснование);
	РС = ?(ВидТорговли = Перечисление.ВидыТорговли.Нал, глПолучитьРСчет(Фирма, Валюта), Касса);
	
	Таб.ВывестиСекцию("Шапка");
	Ном = 1;
	ВыбратьСтроки();
	Пока ПолучитьСтроку()=1 Цикл
		Таб.ВывестиСекцию("Строка");
		Ном = Ном+1;
	КонецЦикла;
	ПечДоверенн = ?(ПолучилПоДругомуДокументу = 0,
				  	?(Константа.ФормыНаУкраинском = Да,"по дов. "+ДовСерия+" № "+ДовНомер+" от "+ДовДата,"за дов. "+ДовСерия+" № "+ДовНомер+" від "+ДовДата)
				  	,СокрЛП(ДокументПолучил));
	Таб.ВывестиСекцию("Дно");
КонецПроцедуры

// ===============================
Процедура АктСписания()
	глУстПропись(Гривня,"украинский");          
	
	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить ("Дата",ДатаДок);
	Расшифровка.Установить ("Фирма",Фирма);

	Расшифровка.Установить("ГлавныйБухгалтер","");
	
	глПолучитьДанные(Расшифровка);

	Таб.ПараметрыСтраницы(2); // ландшафт
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Попытка
			Если Сред(НеоборотныйАктив.Счет.Получить(ДатаДок).Код,1,2) = "12" Тогда
				// акт списания только для ОСов
				Продолжить;
			Иначе
				Если Сред(НеоборотныйАктив.Счет.Получить(ДатаДок).Код,1,2) = "10" Тогда
					Если НеоборотныйАктив.Счет.Получить(ДатаДок).Код = "100" Тогда
						СчетИзноса = СчетПоКоду("135");
					Иначе	
						СчетИзноса = СчетПоКоду("131");
					КонецЕсли;
				Иначе
					СчетИзноса = СчетПоКоду("132");
				КонецЕсли;
			КонецЕсли;
		Исключение
			Если Сред(НеоборотныйАктив.Счет.Код,1,2) = "12" Тогда
				// акт списания только для ОСов
				Продолжить;
			Иначе
				Если Сред(НеоборотныйАктив.Счет.Код,1,2) = "10" Тогда
					Если НеоборотныйАктив.Счет.Код = "100" Тогда
						СчетИзноса = СчетПоКоду("135");
					Иначе	
						СчетИзноса = СчетПоКоду("131");
					КонецЕсли;
				Иначе
					СчетИзноса = СчетПоКоду("132");
				КонецЕсли;
			КонецЕсли;
		КонецПопытки;	
		Попытка
			СчетЗатрат = НеоборотныйАктив.СчетЗатрат.Получить(ДатаДок).Код;
		Исключение
			СчетЗатрат = НеоборотныйАктив.СчетЗатрат.Код;
		КонецПопытки;	
		СчетЗатр = ?(Константа.ИспользоватьСчетаРасходов = Класс8, "85", "97.6");    
		Ставка = 0;
		МетодыРасчетаИзноса = Перечисление.МетодыРасчетаИзноса;
		Попытка
			МетодРасчИзнНеобАктива = НеоборотныйАктив.МетодРасчетаИзноса.Получить(ДатаДок);
		Исключение
			МетодРасчИзнНеобАктива = НеоборотныйАктив.МетодРасчетаИзноса;
		КонецПопытки;	
		Если (МетодРасчИзнНеобАктива = МетодыРасчетаИзноса.УменьшениеОстатка) 
			Или (МетодРасчИзнНеобАктива = МетодыРасчетаИзноса.УскоренноеУменьшениеОстатка) Тогда
			// только для этого метода имеет смысл норма амортизации
			Ставка = НеоборотныйАктив.НормаАмортизации;
		ИначеЕсли (МетодРасчИзнНеобАктива = МетодыРасчетаИзноса.ПервыйМесяц) Тогда 
			Ставка = 1;
		ИначеЕсли (МетодРасчИзнНеобАктива = МетодыРасчетаИзноса.ПервыйИПоследнийМесяц) Тогда
			Ставка = 0.5;
		КонецЕсли;
		Норма = Строка(Ставка*100) + " %";

		Таб.ВывестиСекцию("Страница11");   
		Если Износ > 0 Тогда
			Таб.ВывестиСекцию("Износ");   
		КонецЕсли;
		Таб.ВывестиСекцию("Страница12");   
		Таб.НоваяСтраница();
		Таб.ВывестиСекцию("Страница2");
		Таб.НоваяСтраница();
	КонецЦикла;
КонецПроцедуры

// ===============================
Процедура АктСписанияНМА()
	глУстПропись(Гривня,"украинский");          
	
	Таб.ПараметрыСтраницы(1); // портрет
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Попытка
			Если Сред(НеоборотныйАктив.Счет.Получить(ДатаДок).Код,1,2) <> "12" Тогда
				// акт списания только для НМА
				Продолжить;
			КонецЕсли;
		Исключение
			Если Сред(НеоборотныйАктив.Счет.Код,1,2) <> "12" Тогда
				// акт списания только для НМА
				Продолжить;
			КонецЕсли;
		КонецПопытки;	
		КвоНМА = ?(Кво = 0, 1, Кво);
		Для Н=1 По Кво Цикл
			ПервСтоимостьОдного = ПервСтоимость / КвоНМА;
			ИзносОдного = Износ / КвоНМА;
			Таб.ВывестиСекцию("Страница1");
			Таб.НоваяСтраница();
			Таб.ВывестиСекцию("Страница2");
			Таб.НоваяСтраница();
		КонецЦикла;                    
	КонецЦикла;
КонецПроцедуры

// ===============================
Процедура Печать(ОС = 1)

	Если (ВидЛиквидации = Подготовка) Тогда
		Возврат;
	КонецЕсли;
	Таб = СоздатьОбъект("Таблица");
	ПечатьНМА = 0;
	Если ВидЛиквидации = Списание Тогда
		Если ОС = 0 Тогда
			ПрефиксТаблицы = "АктСписанияНМА";
			СуффиксТаблицы = "_Укр";
			СуффиксФайла = "_ukr";
			ПрефиксФайла = "LNMA";
		Иначе
			ПрефиксТаблицы = "АктСписания";
			СуффиксТаблицы = "_Укр";
			СуффиксФайла = "_ukr";
			ПрефиксФайла = "LNAa";
			ПечатьНМА = 1;
		КонецЕсли;
	Иначе
		ПрефиксТаблицы = "Накладная";
		СуффиксТаблицы = ?(Константа.ФормыНаУкраинском = Да, "_Укр", "");
		СуффиксФайла = ?(Константа.ФормыНаУкраинском = Да, "_ukr", "");
		ПрефиксФайла = "LNAn";
	КонецЕсли;	
	
	ИмяФайлаПечатнойФормы = КаталогИБ()+"ExtForms\PrnForms\"+ПрефиксФайла+СуффиксФайла+".mxl";
	Если ФС.СуществуетФайл(ИмяФайлаПечатнойФормы) = 1 Тогда
		Таб.ИсходнаяТаблица(ИмяФайлаПечатнойФормы);
	Иначе
		Таб.ИсходнаяТаблица(ПрефиксТаблицы+СуффиксТаблицы);
	КонецЕсли;

	Если ПрефиксТаблицы = "Накладная" Тогда
		Накладная();
	ИначеЕсли ОС = 0 Тогда
		АктСписанияНМА();
	Иначе
		АктСписания();
	КонецЕсли;
	Если Таб.ВысотаТаблицы() > 0 Тогда
		Таб.Защита(Константа.ФлагЗащитыТаблиц);
		Таб.ТолькоПросмотр(1);
		Таб.Опции(0,0,,);
		Таб.Показать("ПЕЧАТЬ:"+ПрефиксТаблицы,"");
	КонецЕсли;
	Если ПечатьНМА = 1 Тогда
		Печать(0);
	КонецЕсли;
	глУстПропись(Гривня); 
КонецПроцедуры

// ===============================
Процедура ИзмСчетКонтрагента()
	Если СчетКонтрагента.Выбран()=0 Тогда
	    Возврат;
	КонецЕсли;
	Если глПроверитьСчетВзаиморасчетов(СчетКонтрагента) = 0 Тогда
		глКомментарий("Выбранный счет не является счетом учета взаиморасчетов!",1,,"!");
	ИначеЕсли СчетКонтрагента.Валютный = ?(Валюта=Гривня,1,0) Тогда
		глКомментарий("Счет взаиморасчетов не соответствует валюте документа!",1,,"!");
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура УстЦенаБезНДС()
	СумПерв = глПересчет(ПервСтоимость-Износ,Гривня,Валюта,ДатаДок,Курс);
	Если СумПерв = 0 Тогда
		ЦенаБезНДС = глПересчет(НеоборотныйАктив.Цена_Прих,Гривня,Валюта,ДатаДок,Курс);
	Иначе
		ЦенаБезНДС = ?(Кво=0,СумПерв,СумПерв/Кво);
	КонецЕсли;
	глВыч_суммы_накл(Контекст,-1);
КонецПроцедуры

// ===============================
Процедура РассчитатьБухгалтерскиеОстатки(ОстПервСтоимость, ОстИзнос, ОстКво)
	ОстПервСтоимость = 0;
	ОстИзнос = 0;
	ОстКво = 0;
	
	Попытка
		СчетУчета		= НеоборотныйАктив.Счет.Получить(?(Выбран()=1,ТекущийДокумент(),ДатаДок));
	Исключение
		СчетУчета		= НеоборотныйАктив.Счет;
	КонецПопытки;	

	//для НМА на подготовке к продаже
	СчетУчета = ?(ПустоеЗначение(ДокументПодготовки)=0, СчетПоКоду("28.6"),СчетУчета);  
	
	СчетИзноса 		= СчетПоКоду( "13."+Строка( Число(Сред(СчетУчета.Код,1,2))-9 ) );
	Если СчетУчета.Код = "100" Тогда
		СчетИзноса = СчетПоКоду("13.5");
	КонецЕсли;	
	
	// определим первичную стоимость, количество и место хранения
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы, НеоборотныйАктив, 2);  

	Если ПустоеЗначение(ДокументПодготовки)=1 Тогда
		Если Подразделение.Выбран()=1 Тогда
			Ит.ИспользоватьСубконто(ВидыСубконто.Подразделения, Подразделение, 2);
		Иначе
			Сообщить("Не выбрано подразделение");
			Ит.ИспользоватьСубконто(ВидыСубконто.Подразделения,,,0);
		КонецЕсли;           
		КолСубконто = 3;
	Иначе
		КолСубконто = 2;
	КонецЕсли;
	Если МестоХранения.Выбран() = 1 Тогда
		Ит.ИспользоватьСубконто(ВидыСубконто.МестаХранения, МестоХранения);
	Иначе
		Ит.ИспользоватьСубконто(ВидыСубконто.МестаХранения);
	КонецЕсли;
	Ит.Опции(0,0);
	Ит.ВключатьСубсчета(-1);
	КонечнаяДата = ?(Выбран()=1,СформироватьПозициюДокумента(ТекущийДокумент(),-1),ДатаДок);
	Если Ит.ВыполнитьЗапрос(КонечнаяДата,КонечнаяДата,СчетУчета) = 0 Тогда
		Предупреждение ("Запрос по бухгалтерским итогам (первоначальная стоимость НА) не выполнен!");
		Возврат;
	КонецЕсли;

	Ит.ВыбратьСубконто(1);
	Если Ит.ПолучитьСубконто(1) = 1 Тогда
		ОстПервСтоимость = Ит.СКД();
		ОстКво = Ит.СКД("К");
		ОстКво = ?(ОстКво = 0, 1, ОстКво);
		МестоХранения = 0;
		Ит.ВыбратьСубконто(КолСубконто);
		Пока Ит.ПолучитьСубконто(КолСубконто)=1 Цикл
			Если МестоХранения.Выбран()=1 Тогда
				Сообщить("Необоротный актив "+НеоборотныйАктив+" по бухгалтерским итогам числится на нескольких местах хранения:
				|""" + МестоХранения + """ и """ + Ит.Субконто(КолСубконто)+"""!");
			Иначе
				МестоХранения = Ит.Субконто(КолСубконто);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// определим износ объекта в бухгалтерском учете
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы, НеоборотныйАктив, 2);
	Ит.Опции(0,0);
	Ит.ВключатьСубсчета(-1);
	Если Ит.ВыполнитьЗапрос(КонечнаяДата,КонечнаяДата,СчетИзноса) = 0 Тогда
		Предупреждение ("Запрос по бухгалтерским итогам (износ НА) не выполнен!");
		Возврат;
	КонецЕсли;

	Ит.ВыбратьСубконто(1);
	Если Ит.ПолучитьСубконто(1) = 1 Тогда
		ОстИзнос = Ит.СКК();
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмДокументПодготовки()  
	Перем флПроверка;
	флПроверка = 0;

	Если ПустоеЗначение(ДокументПодготовки) = 0 Тогда
		Если ДокументПодготовки.ВидЛиквидации <> Подготовка Тогда    
			глКомментарий("Нельзя выбирать документ с Видом ликвидации не равным Подготовка к реализации!",0,,"!");
			ДокументПодготовки = глВосстановитьЗначение(Контекст,"ДокументПодготовки");
			флПроверка = 1;
		ИначеЕсли (ДокументПодготовки.Проведен() = 0) или (ДокументПодготовки.ПометкаУдаления() = 1) Тогда
			глКомментарий("Нельзя выбирать непроведенный или помеченный на удаление документ!",0,,"!");
			ДокументПодготовки = глВосстановитьЗначение(Контекст,"ДокументПодготовки");
			флПроверка = 1;
		КонецЕсли;
	КонецЕсли;  
	//При изменении надо очистить ТЧ
	Если (КоличествоСтрок() > 0) и (флПроверка = 0) Тогда
		Рез = Вопрос("Для изменения нужно очистить табличную часть. Удалить строки?","Да+Нет");
		Если Рез = "Да" Тогда
			УдалитьСтроки();
			ПодготовкаКРеализации = 0;   
		Иначе
			ДокументПодготовки = глВосстановитьЗначение(Контекст,"ДокументПодготовки");
		КонецЕсли;
	КонецЕсли;
	глСохранитьЗначение(Контекст,"ДокументПодготовки",ДокументПодготовки);
КонецПроцедуры
// ===============================
Процедура ИзмКво()
	Перем ОстПервСтоимость, ОстИзнос, ОстКво;
	
	РассчитатьБухгалтерскиеОстатки(ОстПервСтоимость, ОстИзнос, ОстКво);
	// реквизиты на формы рассчитываем пропорционально указанному кол-во
	Если ОстКво>0 Тогда
		ПервСтоимость	= ОстПервСтоимость*Кво/ОстКво;
		Износ			= ОстИзнос*Кво/ОстКво;
	Иначе
		ПервСтоимость	= 0;
		Износ			= 0;
	КонецЕсли;

	глВыч_суммы_накл(Контекст);
КонецПроцедуры

// ===============================
Процедура ИзмНеоборотныйАктив()
	Перем ОстПервСтоимость, ОстИзнос, ОстКво;
	
	РассчитатьБухгалтерскиеОстатки(ОстПервСтоимость, ОстИзнос, ОстКво);
	
	Если ОстКво <> 0 Тогда
		ПервСтоимость = ОстПервСтоимость / ОстКво;
		Износ		  = ОстИзнос / ОстКво;
	Иначе
		ПервСтоимость = 0;
		Износ		  = 0;
	КонецЕсли;
	Кво = 1;
		
	Если ВидЛиквидации = Реализация Тогда
		УстЦенаБезНДС();
		глВыч_суммы_накл(Контекст);
	КонецЕсли;
	
КонецПроцедуры

// ===============================
Процедура ИзмГлубина()
	Если ПустоеЗначение(Глубина) = 1 Тогда              
		Глубина = 0;
	КонецЕсли;
	Если Контрагент.ГлубинаВКалендарныхДнях	= 1 Тогда
		ДатаОплаты = ДатаДок + Глубина;	
	Иначе	
		ДатаОплаты = глБанковскаяДата(ДатаДок,Глубина);	
	КонецЕсли;	
КонецПроцедуры

// ===============================
Процедура УстГлубина()
	// Формирует и показывает дату оплаты
	Если (ВидТорговли = Перечисление.ВидыТорговли.Кредит) И (Контрагент.Выбран() = 1) Тогда
		Если ПустоеЗначение(Глубина) = 1 Тогда
			Глубина = Контрагент.Глубина.Получить(ДатаДок);
		КонецЕсли;	
	Иначе
		Глубина=0;
	КонецЕсли;
	ИзмГлубина();
КонецПроцедуры	

// ===============================
Процедура ИзмДатаДок()
	глПриИзмененииДатыДокумента(Контекст, СтараяДата);

	Если ВидЛиквидации = Реализация Тогда
		УстГлубина(); 
	КонецЕсли;
КонецПроцедуры
         

// ===============================
Процедура ИзмВидЛиквидации()

	Если ВидЛиквидации = Реализация Тогда
		УстГлубина(); 
		Отпустил = глВосстановитьЗначение(Контекст,"БазОтпустил");
	Иначе
		Отпустил = 0;
	КонецЕсли;
КонецПроцедуры

// ======================================
Процедура ИзмВидНДС()
	// пересчитаем суммы НДС в строках табличной части
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		глВыч_суммы_накл(Контекст,-1);	
	КонецЦикла;
КонецПроцедуры 

// ======================================
Процедура ИзмКасса(БезКом = 0)
	Если Касса.Выбран() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
		Если Касса.Владелец <> Фирма Тогда
			глКомментарий("Касса принадлежит другой фирме!");
			Касса = 0;
		ИначеЕсли Касса.БезНал = 1 Тогда
			Если БезКом = 0 Тогда
				глКомментарий("Вместо кассы был выбран безналичный расчетный счет.");
			КонецЕсли;
			Касса = 0;
		ИначеЕсли (Валюта <> Касса.Валюта) и (ПустоеЗначение(Валюта) = 0) Тогда 
			глКомментарий("Валюта кассы не соответствует валюте документа.");
			Касса = 0;
		КонецЕсли;
		Если Касса.Выбран() = 0 Тогда
			Касса = глПолучитьКассу(Фирма,Валюта);
			Если БезКом = 0 Тогда
				Если Касса.Выбран() = 0 Тогда
					глКомментарий("Касса очищена.");
				Иначе
					глКомментарий("Касса изменена.");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Касса.Владелец <> Фирма Тогда
			глКомментарий("Расчетный счет не соответствует фирме.");
			Касса = 0;
		ИначеЕсли Касса.БезНал = 0 Тогда
			Если БезКом = 0 Тогда
				глКомментарий("Вместо безналичного расчетного счета была выбрана касса.");
			КонецЕсли;
			Касса = 0;
		ИначеЕсли (Валюта <> Касса.Валюта) и (ПустоеЗначение(Валюта) = 0) Тогда
			глКомментарий("Валюта расчетного счета не соответствует валюте документа.");
			Касса = 0;
		КонецЕсли;
		Если Касса.Выбран() = 0 Тогда
			Касса = глПолучитьРСчет(Фирма,Валюта);
			Если БезКом = 0 Тогда
				Если Касса.Выбран() = 0 Тогда
					глКомментарий("Расчетный счет очищен.");
				Иначе
					глКомментарий("Расчетный счет изменен.");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура УстКасса()
	Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
		Касса = глПолучитьКассу(Фирма,Валюта);
	ИначеЕсли ПустоеЗначение(ВидТорговли) = 0 Тогда
		Касса = глПолучитьРСчет(Фирма,Валюта);
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмВидТорговли(Сообщать = 1)
	Если ВидТорговли = Перечисление.ВидыТорговли.Бартер Тогда
		Если Сообщать = 1 Тогда
			глКомментарий("Нельзя продавать необоротные активы на условиях бартера!",0,,"!");
		КонецЕсли;
		ВидТорговли = 0;
	КонецЕсли;
	Если Касса.Выбран() = 0 Тогда
		УстКасса()
	КонецЕсли;
	ИзмКасса(1);
	УстГлубина();		
КонецПроцедуры

// ===============================
Процедура ВыборОплаты()
	// Процедура по кнопке редактирования валюты в документе
	ОткрытьФормуМодально("Обработка.ИнформацияОВалюте", Контекст);
	СчетКонтрагента = СчетПоКоду(?(Валюта = Гривня, "3772", "3774"));
	Если Касса.Выбран() = 0 Тогда
		УстКасса();
	Иначе
		ИзмКасса();
	КонецЕсли;
КонецПроцедуры	

// ===============================
Процедура УстВидТорговли()
	ВидТорговли = ?(Контрагент.Выбран()=1,Контрагент.ВидТорговли,0);      
	Если ПустоеЗначение(ВидТорговли) = 1 Тогда
		ВидТорговли = глВосстановитьЗначение(,"ОсновнойВидТорговли");
	КонецЕсли;                  
	ИзмВидТорговли(0);
КонецПроцедуры
// ===============================
Процедура ИзмВидДокумента()
	Инд = спВидДокумента.ТекущаяСтрока();
	Если Инд <> 0 Тогда
		ТекВидДокумента = спВидДокумента.ПолучитьЗначение(Инд);
		ПолучилПоДругомуДокументу = 1;
		Если СокрЛП(ТекВидДокумента) = "Доверенность" Тогда
		    ПолучилПоДругомуДокументу = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
// ===============================
Функция ПриВыбореОснования(Док,СтарДок=0)
	Если ПустоеЗначение(Док) = 1 Тогда
	    Возврат 0;
	ИначеЕсли Док = СтарДок Тогда
	    Возврат -1;
	КонецЕсли;

	Если глЕстьРеквизитШапки("ВидТорговли",Док.Вид()) = Да Тогда    
		Если ПустоеЗначение(Док.ВидТорговли) = 0 Тогда
			ВидТорговли = Док.ВидТорговли;
			ИзмВидТорговли(0);
		КонецЕсли;
	КонецЕсли;

	Если глЕстьРеквизитШапки("Валюта",Док.Вид()) = Да Тогда    
		Валюта_Прежн 	= Валюта;
		Валюта 			= Док.Валюта;
		Курс_Прежн = Курс;
		Если глЕстьРеквизитШапки("Курс",Док.Вид()) = Да Тогда    
			Курс = Док.Курс;
		Иначе
			Курс = глКурсДляВалюты(Валюта,ДатаДок);
		КонецЕсли;
		Если (Валюта_Прежн <> Валюта) Или (Курс_Прежн <> Курс) Тогда // надо пересчитать цены
			глУстан_Вал(Контекст, Валюта, Валюта_Прежн, Курс, Курс_Прежн);
			УстКасса();
		КонецЕсли;
		Если Валюта_Прежн <> Валюта Тогда
			СчетКонтрагента = СчетПоКоду(?(Док.Валюта = Гривня, "3772", "3774"));
		КонецЕсли;
		ИзмВидНДС();
	КонецЕсли;
	Возврат 1;
КонецФункции

// ===============================
Процедура ИзмКонтрагент()
	ДокументОснование 	= 0;
	Договор 			= 0;
	УстВидТорговли();
	Если Контрагент.Выбран() = 1 Тогда
		Если (глВосстановитьЗначение(,"ПодставлятьОсновнойДоговор") = Да) 
				И (ПустоеЗначение(Контрагент.БазДоговор)=0) Тогда
			Если Фирма = Контрагент.БазДоговор.Фирма Тогда
				Договор = Контрагент.БазДоговор;
				ПриВыбореОснования(Договор);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	УстГлубина();		
КонецПроцедуры

// ===============================
Процедура ЗаполнитьПоУмолчанию()
	ВидЗатрат		= глВосстановитьЗначение(Контекст,	"ВидЗатрат");
	Подразделение 	= глВосстановитьЗначение(,			"БазПодразделениеПродажи");
	Валюта 			= Гривня;
	Курс			= глКурсДляВалюты(Валюта,ДатаДок);
	Дата_Курса		= ДатаДок;
	ПодготовкаКРеализации = 1;
	СчетКонтрагента = СчетПоКоду("3772");
КонецПроцедуры

// ===============================
Функция ПроверкаОснования(Док)	
	Если Док.Вид() = "Счет" Тогда
		Если Док.ЧтоПродаем <> Перечисление.ЧтоПродаем.НеоборотныеАктивы Тогда
			глКомментарий("Для реализации ТМЦ используйте документ ""Расходная Накладная"".",1);
			Возврат 0;
		КонецЕсли;	
	КонецЕсли;
	Возврат 1;
КонецФункции

// ===============================
Процедура ВыборОснования()  
	СтарДоговор 	= Договор;
	СтарОснование 	= ДокументОснование;
	
	глРасшифровка = 0;
	ОткрытьФормуМодально("Обработка.ОснованиеДокумента", Контекст);
	Если ПроверкаОснования(ДокументОснование) = 0 Тогда 
		ДокументОснование = СтарОснование;              		
		Возврат;
	КонецЕсли;			
	Если ПриВыбореОснования(ДокументОснование,СтарОснование) = 0 Тогда
		ПриВыбореОснования(Договор,СтарДоговор);
	КонецЕсли;
КонецПроцедуры	


// ===============================
// ПРЕДОПРЕДЕЛЕННЫЕ ПРОЦЕДУРЫ
// ===============================

// ===============================
Процедура ПриВыбореЗакладки(Номер,Значение)
	Если Номер = 2 Тогда
		Значение = ?(ВидЛиквидации = Списание,"Списание","Реализация");
		Форма.Закладки.УстановитьЗначение(2,Значение,"Дополнительно");
		ОтображаемыеСлои = "Общий," + Значение + ",Затраты";   
	Иначе	
		ОтображаемыеСлои = "Общий," + Значение;           
	КонецЕсли;                          
	Форма.ИспользоватьСлой(ОтображаемыеСлои,2);
КонецПроцедуры

// ===============================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр)

	Если Рекв = "ВидНДС" Тогда
		глВыбратьНДС(Контекст);
		ИзмВидНДС();
		ФлагСтандОбр = 0;

	ИначеЕсли Рекв = "Отпустил" Тогда
		ФлагСтандОбр = 0;
		КонтФирмы = Фирма;
		ОткрытьФорму("Справочник.Сотрудники.ДляВыбора",КонтФирмы);

	ИначеЕсли Рекв = "НеоборотныйАктив" Тогда
		ФлагСтандОбр = 0;
		КонтФирмы = Фирма;
		ОткрытьФорму("Справочник.НеоборотныеАктивы.ФормаСписка",КонтФирмы);
		ИзмНеоборотныйАктив();
	КонецЕсли;	
КонецПроцедуры

// ======================================
Процедура ОбработкаВыбораЗначения(Значение, Рекв, Флаг)
	Если Рекв="Отпустил" Тогда
		Если Значение.Фирма<>Фирма Тогда
			Предупреждение("Можно выбирать только тех сотрудников, которые работают в этой фирме");
			Флаг = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()

	глПроверкаДатыДок(Контекст,"Открытие");
	НачальнаяДатаДокумента = ДатаДок;
	ПриЗаписиПерепроводить(1);

	Форма.ИспользоватьЗакладки(1);
	Форма.Закладки.ДобавитьЗначение("Основной","Основные");

	Если (ВидЛиквидации <> Подготовка) Тогда  
		Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
	КонецЕсли;
	Форма.ИспользоватьСлой("Основной, Общий",2);

	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.		Доступность(0);
		Форма.кФирма.	Доступность(0);               		
		Форма.кОсн.		Доступность(0);
		Форма.кВалюта.	Доступность(0);
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли;	
	Валюта_Прежн 	= Валюта;
	Курс_Прежн 		= Курс;  
	СтараяДата 		= ДатаДок;

	Форма.Контрагент.		ВыполнятьФормулуТолькоПриИзменении(1);
	Форма.НеоборотныйАктив.	ВыполнятьФормулуТолькоПриИзменении(1);

	спВидДокумента.ДобавитьЗначение("Доверенность");
	спВидДокумента.ДобавитьЗначение("Другой документ");
	спВидДокумента.ТекущаяСтрока(ПолучилПоДругомуДокументу+1);

КонецПроцедуры

// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
		глУстановитьНомер(Контекст);
		Возврат;
	КонецЕсли;
	глЗаполнитьШапку(Контекст);
	ЗаполнитьПоУмолчанию();
	Контрагент 		= глВосстановитьЗначение(,"ОсновнойПокупатель");
	ВидЛиквидации 	= Перечисление.ВидыЛиквидацииНеоборАктивов.Списание;
	ТипСписания		= Перечисление.ТипыСписанияНеоборАктивов.ПоРешениюНалогоплательщикаИлиКМУ;
	ИзмКонтрагент();
КонецПроцедуры
               
// ===============================
Процедура ВводНаОсновании(Док)
	Если ПустоеЗначение(Док) = 1 Тогда
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;	
		
	Если ПроверкаОснования(Док) = 0 Тогда
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;	

	Если Док.Вид() = "ЛиквидацияНеоборАктивов" Тогда
		Если Док.ВидЛиквидации <> Перечисление.ВидыЛиквидацииНеоборАктивов.ПодготовкаКРеализации Тогда
			Предупреждение("Ввести Ликвидацию НМА можно только на основании документа с видом операции ""Подготовка к ликвидации!""");
			СтатусВозврата(0);
			Возврат; 
		Иначе
			ДокументПодготовки = Док;
		КонецЕсли;	
	КонецЕсли;  
	
	глЗаполнитьШапкуНаОсн(Контекст,Док);
	ЗаполнитьПоУмолчанию();
	ВидЛиквидации 	= Перечисление.ВидыЛиквидацииНеоборАктивов.Реализация;
	Реализация = Перечисление.ВидыЛиквидацииНеоборАктивов.Реализация;
	Если Док.Вид() <> "ЛиквидацияНеоборАктивов" Тогда
		Валюта 			= Док.Валюта;
		Курс 			= Док.Курс;	
		Дата_Курса		= ДатаДок;
		Если (Док.Вид() = "Счет") и (ВидТорговли <> Перечисление.ВидыТорговли.Нал) Тогда
			Касса = Док.РСчет
		КонецЕсли;
		Если Касса.Выбран() = 0 Тогда
			УстКасса()
		КонецЕсли;
		СчетКонтрагента = СчетПоКоду(?(Док.Валюта = Гривня, "3772", "3774"));  
	КонецЕсли;
	
	Если Док.Вид() = "ЛиквидацияНеоборАктивов" Тогда 
		ДокументПодготовки = Док;
		Док.ВыбратьСтроки();
		Пока Док.ПолучитьСтроку()=1 Цикл
			НоваяСтрока();
			НеоборотныйАктив = Док.НеоборотныйАктив;
			ИзмНеоборотныйАктив();
		КонецЦикла;
	ИначеЕсли Док.Вид() < "Договор" Тогда
		
		Док.ВыбратьСтроки();
		Пока Док.ПолучитьСтроку()=1 Цикл
			НоваяСтрока();
			НеоборотныйАктив = Док.ТМЦ;
			ИзмНеоборотныйАктив();
			ЦенаБезНДС = Док.ЦенаБезНДС;
			СуммаБезНДС = Док.СуммаБезНДС;
			НДС = Док.НДС;
			СуммаСНДС = Док.СуммаСНДС;
		КонецЦикла;
	КонецЕсли;	  
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
	Если ВидЛиквидации = Реализация Тогда
		ОтборСчетаКонтрагент = ?(ПустоеЗначение(ДокументОснование)=1, Контрагент, 0);
		глСохранитьЗначение(Контекст,"Отпустил",Отпустил);
	КонецЕсли;
	глСохранитьЗначение(Контекст,"ВидЗатрат",		ВидЗатрат);
КонецПроцедуры

// ===============================
// Инициализируем список действий по кнопке "Действия"
Списание = Перечисление.ВидыЛиквидацииНеоборАктивов.Списание;
Реализация = Перечисление.ВидыЛиквидацииНеоборАктивов.Реализация;
Подготовка = Перечисление.ВидыЛиквидацииНеоборАктивов.ПодготовкаКРеализации;
СписокДействий = глПолучитьСписокДействий("
	|СтруктураПодчиненности,
	|ДвиженияДокумента,
	|ВводНаОсновании,
	|ОткрытьВЖурнале,
	|Подчиненные");

