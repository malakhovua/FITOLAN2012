Перем НачальнаяДатаДокумента;
Перем СтарыйКонтрагент;
Перем ДатаРеестра, тДатаРеестра;

// ===============================
Процедура ВыборОснования()
	// Процедура по кнопке редактирования основания в документе
	глРасшифровка = 0;
	ОткрытьФормуМодально("Обработка.ОснованиеДокумента", Контекст);
КонецПроцедуры	

// ===============================
Процедура ВыбратьФормуОплаты()
Перем Выб;
	Спис = СоздатьОбъект("СписокЗначений");
	Спис.ДобавитьЗначение("Готівка");
	Спис.ДобавитьЗначение("Оплата з поточного рахунку");
	Спис.ДобавитьЗначение("Бартер");
	Спис.ДобавитьЗначение("Чек");
	Выб = ФормаОплаты; 
	Если Спис.ВыбратьЗначение(Выб,,,,2) = 1 Тогда
		ФормаОплаты = Выб;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ЗаполнитьВидыОпераций()
	спВидОперации.УдалитьВсе();
	Если Импорт = 1 Тогда
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.Импорт);
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.ИмпортПоВекселю);
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.РаботыОтНерезидента);
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.РаботыОтНерезидентаПрошлогоПериода);
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.ВексельПрошлогоПериода);
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.ПогашениеНалоговогоВекселя);
	Иначе
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.ПокупкаВУкраине);
		спВидОперации.ДобавитьЗначение(Перечисление.ВидыОперацийКнигиПриобретения.РасчетКорректировки);
	КонецЕсли;
	// если вид операции есть в новом списке - спозиционируемся на него
	Инд = спВидОперации.НайтиЗначение(ВидОперации);
	Если Инд = 0 Тогда
		// нет такого в списке
		спВидОперации.ТекущаяСтрока(1);
		ВидОперации = спВидОперации.ПолучитьЗначение(1);
	Иначе
		спВидОперации.ТекущаяСтрока(Инд);
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура УстНалоговыйКредит()
	фНалоговыйКредит = 1;
	Если ВидНДС.Код = "БезНДС" Тогда
		// приобретение без НДС - нет налогового кредита
		фНалоговыйКредит = 0;
	КонецЕсли;
	Если (ВаловыеРасходы = 0) и (ДатаДок<'01.07.2015') Тогда
		// не относятся на валовые расходы и не подлежат амортизации - нет налогового кредита
		фНалоговыйКредит = 0;
	КонецЕсли;
	Если (ДляОблагаемыхОпераций = 0) и (ДатаДок<'01.07.2015') Тогда
		// для совершения операций, кот. не подлежат или освобождены от налогообложения - нет налогового кредита
		фНалоговыйКредит = 0;
	КонецЕсли;
	Если фНалоговыйКредит <> НалоговыйКредит Тогда
		НалоговыйКредит = фНалоговыйКредит;
	КонецЕсли;
КонецПроцедуры

// ===============================
Функция УстДоступность()
	Форма.Заголовок(глЗаголовок(Контекст,"Запись книги приобретения"));
	    
	Слои = "Основной,";
	Если Импорт = 1 Тогда
		Слои = Слои + "Импорт";
	Иначе
		Слои = Слои + "НеИмпорт";
	КонецЕсли;
	Форма.ИспользоватьСлой(Слои);
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	Если ДатаДок >= '29.07.2005' Тогда
		Форма.ДляПоставкиуслуг.Видимость(1);
		Если (ВаловыеРасходы=1) и (ДляОблагаемыхОпераций=0) Тогда
			Форма.ДляПоставкиуслуг.Доступность(1);
		Иначе
			Форма.ДляПоставкиуслуг.Доступность(0);
			Если ДляПоставкиуслуг = 1 Тогда
				ДляПоставкиуслуг = 0;
			КонецЕсли;
		Конецесли;	
		Форма.ВаловыеРасходы.Заголовок("Для использования в хозяйственной деятельности"); 
	Иначе
		Форма.ДляПоставкиуслуг.Видимость(0);
		Форма.ВаловыеРасходы.Заголовок("Товары относятся к валовым расходам или подлежат амортизации"); 
	КонецЕсли;

	Если ВидОперации = Перечисление.ВидыОперацийКнигиПриобретения.РасчетКорректировки Тогда
		Форма.РамКорНакладная.Видимость(1);
		Форма.ТекстДатаКорДокумента.Видимость(1);
		Форма.ДатаКорДокумента.Видимость(1);
		Форма.ТекстНомерКорДокумента.Видимость(1);
		Форма.НомерКорДокумента.Видимость(1);  
	Иначе
		Форма.РамКорНакладная.Видимость(0);
		Форма.ТекстДатаКорДокумента.Видимость(0);
		Форма.ДатаКорДокумента.Видимость(0);
		Форма.ТекстНомерКорДокумента.Видимость(0);
		Форма.НомерКорДокумента.Видимость(0);
	КонецЕсли;	
	Если ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.Прочее Тогда
		Форма.спВидДокументаПрочее.Видимость(1);
	Иначе
		Форма.спВидДокументаПрочее.Видимость(0);
	КонецЕсли;	
	Форма.ДокументЗвит1С.Заголовок(?(ПустоеЗначение(Звит1С_DOC_ID) = 0, "Открыть в FREDO Звіт", "Загрузить из FREDO Звіт"));
	
	Форма.кЭкспорт.Доступность(Проведен()*(1-Модифицированность()));  
КонецФункции

// ===============================
Процедура ИзмВидОперации()
	Инд = спВидОперации.ТекущаяСтрока();
	Если Инд <> 0 Тогда
		ТекВидОперации = спВидОперации.ПолучитьЗначение(Инд);
		Если ТекВидОперации <> ВидОперации Тогда
		    ВидОперации = ТекВидОперации;
		КонецЕсли;
	КонецЕсли;
	УстНалоговыйКредит();
КонецПроцедуры
// ======================================
Процедура ИзмУточняющийРасчет()  
	Если УточняющийРасчет = 1 Тогда
		Сообщить("При установленном флажке ""Включено в уточняющий расчет к Декларации по НДС"""
		"документ не будет отражаться в отчете ""Декларация по НДС"". ", "!"); 
		Сообщить("Необходимо вручную заполнить отчет ""Уточняющий расчет к Декларации по НДС"".", "!"); 
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура ПриОткрытии()
	глПроверкаДатыДок(Контекст,"Открытие");
	ПриЗаписиПерепроводить(1);
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кФирма.Доступность(0);
		Форма.кОснование.Доступность(0);
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли; 
	НачальнаяДатаДокумента = ДатаДок;
	СтарыйКонтрагент = Контрагент;
	ЗаполнитьВидыОпераций();
	Инд = спВидОперации.НайтиЗначение(ВидОперации);
	Если Инд <> 0 Тогда
	    спВидОперации.ТекущаяСтрока(Инд);
	КонецЕсли;          
	ИзмВидОперации();
	спВидДокументаПрочее.ДобавитьЗначение("Транспортный билет");
	спВидДокументаПрочее.ДобавитьЗначение("Счет из отеля");
	спВидДокументаПрочее.ДобавитьЗначение("За услуги связи");
	спВидДокументаПрочее.ДобавитьЗначение("Услуги по приборам");
	спВидДокументаПрочее.ДобавитьЗначение("Товарный чек");
	спВидДокументаПрочее.ДобавитьЗначение("Заявление");
	спВидДокументаПрочее.ДобавитьЗначение("Бух.операция");
	спВидДокументаПрочее.ДобавитьЗначение("Прочее");
	Инд = спВидДокументаПрочее.НайтиЗначение(СокрЛП(ВидДокументаПрочее));
	Если Инд <> 0 Тогда
	    спВидДокументаПрочее.ТекущаяСтрока(Инд);
	КонецЕсли;
	УстДоступность();
	ДатаРеестра = ?(ПустоеЗначение(ДатаРегВЕдРеестрНН)=0, ДатаРегВЕдРеестрНН, ДатаДок);
	тДатаРеестра = "Дата получения, отображаемая в реестре: "+Формат(ДатаРеестра, "ДДММГГ");
КонецПроцедуры
                                                              
// ===============================
Процедура ИзмДатаДок()
	ДатаДокумента = ДатаДок;
	ДатаРеестра = ?(ПустоеЗначение(ДатаРегВЕдРеестрНН)=0, ДатаРегВЕдРеестрНН, ДатаДок);
	тДатаРеестра = "Дата получения, отображаемая в реестре: "+Формат(ДатаРеестра, "ДДММГГ");
КонецПроцедуры
	
// ===============================
Процедура ИзмДляОблагаемыхОпераций()
	УстНалоговыйКредит();
КонецПроцедуры

// ===============================
Процедура ИзмИмпорт()
	ЗаполнитьВидыОпераций();
	УстНалоговыйКредит();
КонецПроцедуры
// ===============================
Процедура ИзмДатаРегВЕдРеестре()
	ДатаРеестра = ?((ПустоеЗначение(ДатаРегВЕдРеестрНН)=0) и (ДатаРегВЕдРеестрНН>ДатаДок), ДатаРегВЕдРеестрНН, ДатаДок);
	тДатаРеестра = "Дата получения, отображаемая в реестре: "+Формат(ДатаРеестра, "ДДММГГ");
КонецПроцедуры
// ===============================
Процедура ИзмВаловыеРасходы()
	УстНалоговыйКредит();
КонецПроцедуры

// ===============================
Процедура ИзмНДС()
	СуммаСНДС = СуммаБезНДС + НДС;
КонецПроцедуры

// ===============================
Процедура ИзмСуммаБезНДС()
	Если ВидНДС.Выбран() = 0 Тогда
		НДС = 0;
	Иначе
		Ставка = ВидНДС.Ставка.Получить(ДатаДок);
		НДС = СуммаБезНДС * Ставка;
	КонецЕсли;
	ИзмНДС();
КонецПроцедуры

// ===============================
Процедура ИзмВидНДС()
	Если ДатаДок < '01/12/2014' Тогда
		Если СокрЛП(ВидНДС.Код) = "НДС7" Тогда
			СпецРежимНалогообложения = 7;
		Иначе
			СпецРежимНалогообложения = ?(СпецРежимНалогообложения = 7,0,СпецРежимНалогообложения);
		КонецЕсли;
	КонецЕсли;
	УстНалоговыйКредит();
	ИзмСуммаБезНДС();
КонецПроцедуры

// ===============================
Процедура ИзмДоговор()
	Если Договор.Выбран() = 1 Тогда
		Если Договор.Вид() = "Договор" Тогда
			ВидТорговли = Договор.ВидТорговли;
			ВидНДС = Договор.ВидНДС;
			ИзмВидНДС();
		КонецЕсли;
	КонецЕсли;    
КонецПроцедуры

// ======================================
Процедура ИзмКонтрагент()
	Если Контрагент.Выбран() = 0 Тогда
		Возврат;
	КонецЕсли;	
	Если СтарыйКонтрагент <> Контрагент Тогда
		// изменили Контрагента
		Если Договор.Выбран() = 1 Тогда
			Если Договор.Контрагент <> Контрагент Тогда
				Договор = 0;
			КонецЕсли;
		КонецЕсли;    
		Если Договор.Выбран() = 0 Тогда
			Если (Фирма = Контрагент.БазДоговор.Фирма) и (глВосстановитьЗначение(,"ПодставлятьОсновнойДоговор")=Да) Тогда
				Договор = Контрагент.БазДоговор;
			КонецЕсли;
			Если ПустоеЗначение(Контрагент.ВидТорговли) = 0 Тогда
				ВидТорговли = Контрагент.ВидТорговли;
			ИначеЕсли ПустоеЗначение(ВидТорговли) = 1 Тогда
				ВидТорговли = глВосстановитьЗначение(,"ОсновнойВидТорговли");
			КонецЕсли;	
			ИзмДоговор();
		КонецЕсли;       
		// проверим документ-основание
		Если ПустоеЗначение(ДокументОснование) = 0 Тогда
			Если глЕстьРеквизитШапки("Контрагент",ДокументОснование.Вид()) = Да Тогда
				Если ДокументОснование.Контрагент <> Контрагент Тогда
					ДокументОснование = 0;
				КонецЕсли; 
			ИначеЕсли глЕстьРеквизитШапки("Субконто1",ДокументОснование.Вид()) = Да Тогда
				Если ДокументОснование.Субконто1 <> Контрагент Тогда
					ДокументОснование = 0;
				КонецЕсли; 
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;     
	СтарыйКонтрагент = Контрагент;
КонецПроцедуры

// ======================================
Процедура ИзмВидДокумента()
	Если ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.РасчетКорректировки Тогда
		Импорт = 0;
		ВидОперации = Перечисление.ВидыОперацийКнигиПриобретения.РасчетКорректировки;
	ИначеЕсли (ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.Чек)
	или (ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.НалоговаяНакладная) Тогда
		Импорт = 0;
		ВидОперации = Перечисление.ВидыОперацийКнигиПриобретения.ПокупкаВУкраине;
	ИначеЕсли ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.ГТД Тогда
		Импорт = 1;
		ВидОперации = Перечисление.ВидыОперацийКнигиПриобретения.Импорт;
	КонецЕсли;
	ИзмИмпорт();
	ИзмВидОперации();
КонецПроцедуры 

// ======================================
Процедура ИзмНомерДокумента()
	ПозицияСпецСимвола = Найти(НомерДокумента, "\");
	Если ПозицияСпецСимвола = 0 Тогда
		ПозицияСпецСимвола = Найти(НомерДокумента, "/");
	КонецЕсли;
	
	Если ПозицияСпецСимвола > 0 Тогда
		НомерКорДокумента = Сред(НомерДокумента, ПозицияСпецСимвола + 1);
	КонецЕсли;		
КонецПроцедуры

// ======================================
Процедура ИзмВидДокументаПрочее()  
	Инд = спВидДокументаПрочее.ТекущаяСтрока();
	ВидДокументаПрочее = спВидДокументаПрочее.ПолучитьЗначение(Инд);
КонецПроцедуры
// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
		глУстановитьНомер(Контекст);
		Возврат;
	КонецЕсли;
	          
	глУстановитьФирму(Контекст);
	Контрагент = глВосстановитьЗначение(,"ОсновнойПоставщик");
	ИзмКонтрагент();
	ВидНДС = глВосстановитьЗначение(,"БазНДС");
	ДатаДокумента = ДатаДок;
	
	ДляОблагаемыхОпераций = 1;
	ВаловыеРасходы = 1;
	Импорт = 0;
	ИзмИмпорт();
	
	ВидОперации = спВидОперации.ПолучитьЗначение(1);
	ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.НалоговаяНакладная;
	ИзмВидДокумента();
КонецПроцедуры

// ===============================
Процедура ВводНаОсновании(ДокОснование)
	Если ДокОснование.Вид() = "РасходныйКассовый" Тогда
		Если ДокОснование.ВидОплаты = Перечисление.ВидыОплаты.Возврат Тогда
			Предупреждение("По документу " + ДокОснование +  " не возникают налоговые обязательства!");
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	ДляОблагаемыхОпераций = 1;
	
	ДокументОснование = глПолучитьДокументВзаиморасчетов(ДокОснование);
	ДатаДокумента = ДокОснование.ДатаДок;
	
	глЗаполнитьШапкуНаОсн(Контекст,ДокОснование);
	// в зависимости от вида документа основания
	Если (ДокОснование.Вид() = "РасходыНаПриобретение")
	ИЛИ (ДокОснование.Вид() = "БанковскаяВыписка") Тогда
		// в документе несколько строк, предложим выбор, по какому 
		// контрагенту/Договору формировать запись книги приобретения
		Табл = СоздатьОбъект("ТаблицаЗначений");
		Табл.НоваяКолонка("Счет",,,,"Счет",10);
		Табл.НоваяКолонка("Контрагент",,,,"Контрагент",20);
		Табл.НоваяКолонка("Договор",,,,"Договор",40);
		Табл.НоваяКолонка("ДокументОснование",,,,"Документ-основание",40);
		Табл.НоваяКолонка("СуммаСНДС",,,,"Сумма с НДС");
		Табл.НоваяКолонка("НомерСтрокиДок");
		Табл.ВидимостьКолонки("НомерСтрокиДок",0);
		ДокОснование.ВыбратьСтроки();
		Пока ДокОснование.ПолучитьСтроку()=1 Цикл
			Если ДокОснование.Счет.ВидСубконто(2) = ВидыСубконто.Договора Тогда
				Табл.НоваяСтрока();
				Табл.Счет = ДокОснование.Счет;
				Табл.Контрагент = ДокОснование.Субконто1;
				Табл.Договор = ДокОснование.Субконто2;
				Табл.ДокументОснование = ДокОснование.ДокументОснование;
				Табл.СуммаСНДС = ДокОснование.СуммаСНДС;
				Табл.НомерСтрокиДок = ДокОснование.НомерСтроки;
			КонецЕсли;
		КонецЦикла;
		Если Табл.КоличествоСтрок() = 0 Тогда
			глКомментарий("В документе-основании "+ДокОснование+" нет строк, которые проводятся по взаиморасчетам. Сформировать документ ""Запись книги приобретения"" невозможно.",1);
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		// выберем строку
		ВыбСтрока = 0;
		Пока ВыбСтрока = 0 Цикл
			Если Табл.ВыбратьСтроку(ВыбСтрока,"Выберите строку для заполнения книги приобретения") <> 1 Тогда
				// не выбрана строка
				СтатусВозврата(0);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Табл.ПолучитьСтрокуПоНомеру(ВыбСтрока);
		ДокОснование.ПолучитьСтрокуПоНомеру(Табл.НомерСтрокиДок);
			
		// контрагент и договор из выбранной строки документа
		Контрагент = ДокОснование.Субконто1;
		Договор = ДокОснование.Субконто2;
		ДокументОснование = ДокОснование.ДокументОснование;
	Иначе
		// все остальные виды документов
		Попытка 
			Контрагент = ДокОснование.Контрагент;
		Исключение КонецПопытки;
		
		Если ДокОснование.Вид() = "РасходныйКассовый" Тогда
			Если ДокОснование.Субконто1.Вид() = "Контрагенты" Тогда
				Контрагент = ДокОснование.Субконто1;
			КонецЕсли;
		КонецЕсли;

		// определим договор, если он не заполнен
		Если ПустоеЗначение(Договор) = 1 Тогда
			Если глЕстьРеквизитШапки("Договор",ДокОснование.Вид()) = Да Тогда
				Если ДокОснование.Договор.Выбран() = 1 Тогда
					Договор = ДокОснование.Договор;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
    Если глЕстьРеквизитШапки("ВидНДС",ДокОснование.Вид()) = Да Тогда 
		ВидНДС = ДокОснование.ВидНДС;
	Иначе
		ВидНДС = глВосстановитьЗначение(,"БазНДС");
	КонецЕсли;
	
    Если глЕстьРеквизитШапки("Валюта",ДокОснование.Вид()) = Да Тогда 
		Валюта = ДокОснование.Валюта
	Иначе
		Валюта = Гривня;
	КонецЕсли;
	
    Если глЕстьРеквизитШапки("Курс",ДокОснование.Вид()) = Да Тогда 
		Курс = ДокОснование.Курс
	Иначе
		Курс = 1;
	КонецЕсли;
	
    Если глЕстьРеквизитШапки("Дата_Курса",ДокОснование.Вид()) = Да Тогда 
		Дата_Курса = ДокОснование.Дата_Курса
	Иначе
		Дата_Курса = ДокОснование.ДатаДок;
	КонецЕсли;
	
	// вид операции
	Если Валюта <> Гривня Тогда
		Импорт = 1;
		ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.ГТД;
	ИначеЕсли ДокОснование.Вид() = "ВозвратПоставщику" Тогда
		ВаловыеРасходы = 1;
		ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.РасчетКорректировки
	ИначеЕсли ДокОснование.Вид()="ПриходнаяНакладнаяГТД" Тогда
	    Импорт = 1;
		ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.ГТД;
	Иначе
		ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.НалоговаяНакладная;
	КонецЕсли;

	ЗаполнитьВидыОпераций();
	ИзмВидДокумента();
	ВаловыеРасходы = 1;
	Если (Найти(ДокОснование.Вид(),"ПриходнаяНакладная")>0) Или (ДокОснование.Вид() = "УслугиСтороннихОрганизаций") Или (ДокОснование.Вид() = "УслугиСтороннихОрганизацийПроизвХарактера") Тогда
		// если НДС за счет прибыли, то это не налоговый кредит
		ВаловыеРасходы = ВаловыеРасходы - ДокОснование.НДСнаЗатраты;
	КонецЕсли;
	Если ДокОснование.Вид() = "РасходыНаПриобретение" Тогда
		// если в приходной накладной НДС за счет прибыли, то это не налоговый кредит
		// в РасходыНаПриобретение нет нужного реквизита, возьмем его из ПН:
		ВаловыеРасходы = ВаловыеРасходы - ДокОснование.ПриходнаяНакладная.НДСнаЗатраты;
	КонецЕсли;
	УстНалоговыйКредит();
		
	Если ДокОснование.Вид() = "ВозвратПоставщику" Тогда
		ВидОперации = Перечисление.ВидыОперацийКнигиПриобретения.РасчетКорректировки;
	Иначе
		ВидОперации = спВидОперации.ПолучитьЗначение(1);
	КонецЕсли;
	// дата оплаты
	Если глЕстьРеквизитШапки("ВидТорговли",ДокОснование.Вид()) = Да Тогда
		Если ДокОснование.ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
			ДатаОплаты = Формат(ДокОснование.ДатаДок,"ДДДММГГ");
			ФормаОплаты = "Оплата готівкою";
		КонецЕсли;
	КонецЕсли;
	
	Если ДокОснование.Вид() = "АвансовыйОтчет" Тогда
		ДатаОплаты  = Формат(ДокОснование.ДатаДок,"ДДДММГГ");
		ФормаОплаты = "Готівка";
	КонецЕсли;
	
	Если ПустоеЗначение(ДатаОплаты) = 1 Тогда
		// если документ - не приходная накладная за наличные
		СписокДат = СоздатьОбъект("СписокЗначений");
		
		Рег = СоздатьОбъект("Регистр.ВзаиморасчетыПоставщиков");
		Если ПустоеЗначение(ДокументОснование) = 0 Тогда
			Рег.УстановитьЗначениеФильтра("Счет",ДокументОснование,1);
		Иначе
			Рег.УстановитьЗначениеФильтра("КредДокумент",ДокОснование,1);
		КонецЕсли;
		Рег.ВыбратьДвижения(,,);
		Пока Рег.ПолучитьДвижение()=1 Цикл
			Если (Рег.Приход = 1) и (Найти(АвансоваяОплата+ПостОплата+ВтороеСобытиеБартерРасход,Рег.КодОперации)<>0) Тогда
				// нашли оплату
				Док = Рег.ТекущийДокумент();
				Если (Док.Вид() = "БанковскаяВыписка") Тогда
					СписокДат.ДобавитьЗначение(Док.ДатаДок);
					ФормаОплаты = "Оплата з поточного рахунку";
				ИначеЕсли (Док.Вид() = "ПриходныйКассовый") Тогда
					СписокДат.ДобавитьЗначение(Док.ДатаДок);
					ФормаОплаты = "Оплата готівкою";
				ИначеЕсли (Док.Вид() = "РасходныйКассовый") Тогда
					СписокДат.ДобавитьЗначение(Док.ДатаДок);
					ФормаОплаты = "Оплата готівкою";
				ИначеЕсли (Док.Вид() = "РасходнаяНакладная") Тогда
					// бартерный документ, расходная накладная - вместо оплаты
					СписокДат.ДобавитьЗначение(Док.ДатаДок);
					ФормаОплаты = "Бартер";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СтрокаДат = "";
		Если СписокДат.РазмерСписка() = 3 Тогда
			СписокДат.УдалитьЗначение(3);
			СтрокаДат = СписокДат.ВСтрокуСРазделителями()+" ...";
		Иначе
			СтрокаДат = СписокДат.ВСтрокуСРазделителями();
		КонецЕсли;
		ДатаОплаты = СтрЗаменить(СтрокаДат,"""","");
	КонецЕсли;
	
	// определим сумму
	Если (ДокОснование.Вид() = "ПриходнаяНакладнаяЗапасы") или (ДокОснование.Вид() = "ПриходнаяНакладнаяПрочие")
		или (ДокОснование.Вид() = "СчетВходящий") Тогда
		СуммаБезНДС = ДокОснование.Итог("СуммаБезНДС");
		НДС = ДокОснование.Итог("НДС");
		СуммаСНДС = СуммаБезНДС + НДС;
	ИначеЕсли (ДокОснование.Вид() = "ПриходнаяНакладнаяГТД") Тогда
		СуммаБезНДС = ДокОснование.Итог("СуммаБезНДС")+ДокОснование.Итог("Акциз")+ДокОснование.Итог("Пошлина")+ДокОснование.Итог("Перевозка");
		НДС = ДокОснование.Итог("НДС") + ДокОснование.ДопНДС;
		СуммаСНДС = СуммаБезНДС + НДС;
	ИначеЕсли Найти("УслугиСтороннихОрганизаций, УслугиСтороннихОрганизацийПроизвХарактера, АвансовыйОтчет",ДокОснование.Вид()) > 0 Тогда
		СуммаБезНДС = ДокОснование.Итог("СуммаБезНДС");
		НДС = ДокОснование.Итог("НДС");
		СуммаСНДС = Окр(ДокОснование.Итог("СуммаСНДС"),2);
	ИначеЕсли ДокОснование.Вид() = "ВозвратПоставщику" Тогда
		// берем отрицательную сумму - проводки "сторно"
		СуммаБезНДС = -ДокОснование.Итог("СуммаБезНДС");
		НДС = -ДокОснование.Итог("НДС");
		СуммаСНДС = -Окр(ДокОснование.Итог("СуммаСНДС"),2);
	ИначеЕсли ДокОснование.Вид() = "РасходыНаПриобретение" Тогда
		// определим сумму по документу 
		// отбираем только те строки документа, которые содержат Контрагента, Договор и ДокументОснование
		СуммаБезНДС = 0;
		НДС = 0;
		СуммаСНДС = 0;
		ДокОснование.ВыбратьСтроки();
		Пока ДокОснование.ПолучитьСтроку()=1 Цикл
			Если (ДокОснование.Субконто1 = Контрагент) и (ДокОснование.Субконто2 = Договор) и 
				(ДокОснование.ДокументОснование = ДокументОснование) Тогда
				СуммаБезНДС = СуммаБезНДС + ДокОснование.СуммаБезНДС;
				НДС = НДС + ДокОснование.НДС;
				СуммаСНДС = СуммаСНДС + ДокОснование.СуммаСНДС;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ДокОснование.Вид() = "БанковскаяВыписка" Тогда
	    // требуемая строка в банковской выписке уже выбрана выше
		Если ДокОснование.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание Тогда
			Если ДокОснование.ВидОплаты = Перечисление.ВидыОплаты.Оплата Тогда
				Знак = 1;   
				ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.НалоговаяНакладная;
			Иначе // на всякий случай
				Предупреждение("Выбран возврат денежных средств покупателю. Документ ""Запись книги приобретения"" сформировать невозможно!");
				СтатусВозврата(0);
				Возврат;
			КонецЕсли
		Иначе
			Если ДокОснование.ВидОплаты = Перечисление.ВидыОплаты.Оплата Тогда // на всякий случай
				Предупреждение("Выбрана оплата заказа покупателем. Документ ""Запись книги приобретения"" сформировать невозможно!");
				СтатусВозврата(0);
				Возврат;
			Иначе
				Знак = -1;
				ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.РасчетКорректировки;
			КонецЕсли
		КонецЕсли;
		НДС 		= Знак * ДокОснование.НДС;
		СуммаСНДС 	= Знак * ДокОснование.СуммаСНДС;
		СуммаБезНДС = СуммаСНДС 	- НДС;
	ИначеЕсли ДокОснование.Вид() = "РасходныйКассовый" Тогда
		СуммаБезНДС = ДокОснование.СуммаВал - ДокОснование.НДС;
		НДС = ДокОснование.НДС;
		СуммаСНДС = ДокОснование.СуммаВал;
	КонецЕсли;

	ОсновныеФонды  = 0;
	Если  (ДокОснование.Вид() = "ПриходнаяНакладнаяПрочие") или (ДокОснование.Вид() = "СчетВходящий") Тогда
		 Если  (ДокОснование.ЧтоПриходуем = Перечисление.ЧтоПриходуем.ОСиНМАиДрНеобМатАктивы) Тогда
		 	     ОсновныеФонды  = 1;
		 КонецЕсли;;        
	ИначеЕсли ДокОснование.Вид() = "РасходыНаПриобретение" Тогда
		// в РасходыНаПриобретение нет нужного реквизита, возьмем его из ПН:
		Если  (ДокОснование.ПриходнаяНакладная.Вид() = "ПриходнаяНакладнаяПрочие") Тогда
			Если  (ДокОснование.ПриходнаяНакладная.ЧтоПриходуем = Перечисление.ЧтоПриходуем.ОСиНМАиДрНеобМатАктивы)  Тогда
				ОсновныеФонды  = 1;
			КонецЕсли;;        
		КонецЕсли;;        
	КонецЕсли;
	
	  //В документе ГТД есть реквизит Валюта, но все суммы уже переведены в грн, поэтому для него не делаем пересчет.
	  Если (Валюта <> Гривня) И  (ДокОснование.Вид() <> "ПриходнаяНакладнаяГТД") Тогда
	  	СуммаБезНДС = глПересчет(СуммаБезНДС,Валюта,Гривня,Курс,Дата_Курса);
	  	НДС = глПересчет(НДС,Валюта,Гривня,Курс,Дата_Курса);
	  	СуммаСНДС = глПересчет(СуммаСНДС,Валюта,Гривня,Курс,Дата_Курса);
	  КонецЕсли;
	
КонецПроцедуры //ВводНаОсновании 

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
	// пустой договор должен строго иметь тип "Документ", важно для отчета АнализНДС
	Если ПустоеЗначение(Договор) = 1 Тогда
		Договор = ПолучитьПустоеЗначение("Документ");
	КонецЕсли;    
    ИзмВидДокументаПрочее(); 
КонецПроцедуры

// ===============================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр)
	Если Рекв = "ВидНДС" Тогда
		глВыбратьНДС(Контекст);
		ИзмВидНДС();
		ФлагСтандОбр = 0;
	ИначеЕсли Рекв = "ФормаОплаты" Тогда
		ВыбратьФормуОплаты();
		ФлагСтандОбр = 0;	
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ЭкспортЗКП()
	спВариантЭкспорта = СоздатьОбъект("СписокЗначений");
	спВариантЭкспорта.ДобавитьЗначение("Отправить запрос и проверить состояние регистрации в ""FREDO Звіт""");
	
	Результат = ПолучитьПустоеЗначение();
	Если спВариантЭкспорта.ВыбратьЗначение(Результат, , , , 1) <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	// Выведем причины невозможности использования FREDO Звіт, в случае если менеджер не инициализирован
	Если глПодключитьМенеджерЗвит1С() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глМенеджерЗвит1С.Получить("АктуальныйРелизРегОтчетов") < "12q1002" Тогда
		Предупреждение("Для отправки запроса и проверки состояние регистрации в ""FREDO Звіт""
		               |необходимо установить комплект регламентированных отчетов за I квартал 2012(2) или позже");
		Возврат;
	КонецЕсли;
	глРасшифровка = СоздатьОбъект("СписокЗначений");
	глРасшифровка.Установить("ИспользоватьОтчет_ЭкспортНалоговойНакладной", 1); 
	глРасшифровка.Установить("ТекущийДокумент", ТекущийДокумент());
	глРасшифровка.Установить("КонтекстФормыДокумента", Контекст); 		

	глВыполнитьКомандуЗвит1С("ВыгрузитьДокумент", глРасшифровка);

КонецПроцедуры
// ===============================
Функция ПолучитьКомпонентыНомераВходящейНакладной(НомерДокументаБезСуффиксов, СпецРежим, Филиал)
		
	ТекстОшибкиФормата = "Номер входящего документа не соответсвует формату: Н, Н/С, Н/СФ или  Н/С/Ф, где Н - порядковый номер документа, С - спец.режим или пробел (один символ), Ф - номер филиала (от одного до четырех символов)";
							  
	ПозицияСпецСимвола = Найти(НомерДокумента, "\");
	Если ПозицияСпецСимвола = 0 Тогда
		ПозицияСпецСимвола = Найти(НомерДокумента, "/");
	КонецЕсли;
	
	Если ПозицияСпецСимвола > 0 Тогда
		НомерДокументаБезСуффиксов = СокрЛП(Лев(НомерДокумента, ПозицияСпецСимвола-1));
		СпецРежимФилиал = СокрП(Сред(НомерДокумента, ПозицияСпецСимвола + 1)); // Слева может быть пробел спец.режима
	Иначе
		НомерДокументаБезСуффиксов = СокрЛП(НомерДокумента);
		СпецРежимФилиал = "";
	КонецЕсли;
	
	Если 0 = ПустоеЗначение(НомерДокументаБезСуффиксов) Тогда
		Попытка
			НомерДокументаБезСуффиксов = Число(НомерДокументаБезСуффиксов);
		Исключение
			Сообщить(ТекстОшибкиФормата);
			Возврат 1;
		КонецПопытки;
		Если НомерДокументаБезСуффиксов = 0 Тогда
			Сообщить(ТекстОшибкиФормата);
			Возврат 1;
		КонецЕсли;
	КонецЕсли;
	
	Если 0 = ПустоеЗначение(СпецРежимФилиал) Тогда					
		// формат номеров налоговых с 03.2014, с двумя слэшами
		Если Найти(СпецРежимФилиал, "/") > 0 Тогда
			
			СпецРежим = СокрЛП(Сред(СпецРежимФилиал, 1, Найти(СпецРежимФилиал, "/")-1));
			Филиал    = СокрЛП(Сред(СпецРежимФилиал,    Найти(СпецРежимФилиал, "/")+1));
			
		Иначе
			// Номер должен быть в формате ПорядковыйНомер[/СпецРежим[НомерФилиала]] где
			//  СпецРежим - число или пробел
			//  НомерФилиала - строка приводимая к числу c длиной не более 4-х символов
			Если СтрДлина(СпецРежимФилиал) > 5 Тогда
				Сообщить(ТекстОшибкиФормата);
				Возврат 1;
			КонецЕсли;
			
			СпецРежим = СокрЛП(Лев(СпецРежимФилиал, 1)); // Если без спец.режима, то указан пробел, убираем				
			Если СпецРежим = "0" Тогда
				Сообщить(ТекстОшибкиФормата);
				Возврат 1;
			КонецЕсли;
		
			Филиал = СокрЛП(Сред(СпецРежимФилиал, 2));
		
		КонецЕсли;
		
		Если ПустаяСтрока(СпецРежим) = 0 Тогда
			Попытка
				СпецРежим = Число(СпецРежим);
			Исключение
				Сообщить(ТекстОшибкиФормата);
				Возврат 1;
			КонецПопытки;
		Иначе
			СпецРежим = 0;
		КонецЕсли;
		
		Если ПустаяСтрока(Филиал) = 0 Тогда
			Попытка
				Филиал = Число(Филиал);
			Исключение
				Сообщить(ТекстОшибкиФормата);
				Возврат 1;
			КонецПопытки;
		Иначе
			Филиал = 0;
		КонецЕсли;
	Иначе
		
		СпецРежим = 0;
		Филиал 	  = 0;	
		
	КонецЕсли;	
	
	Возврат 0;
	
КонецФункции
// ===============================
Процедура ВыполнитьДействиеЗвит1С(Открывать= 0,Загружать= 0, ПроверятьРеквизиты = 0)

	Компонента = глМенеджерЗвит1С.Получить("Компонента");

	XML = Компонента.GetDocXml(СокрЛП(Звит1С_DOC_ID)); 
	Если ПустаяСтрока(XML) = 1 Тогда
		Сообщить("Ошибка подключения к FREDO Звіт.");
		Возврат;
	КонецЕсли;

	Если (Загружать = 1) ИЛИ (ПроверятьРеквизиты = 1) Тогда
		
		// проверим, соответствую ли параметры документа (номер, дата, ИНН контрагента, сумма по ставке НДС документу из Звит
		// если имеются расхождения - очистим ссылку на документ Звит
		Если ЗагрузитьВнешнююКомпоненту(КаталогИБ()+"ExtForms\v7plus.dll")=0 Тогда
			Если ЗагрузитьВнешнююКомпоненту("v7plus.dll")=0 Тогда
				глКомментарий("Не удалось обнаружить компоненту V7Plus.dll!",0,,"!"); 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		РеквизитыXML = СоздатьОбъект("СписокЗначений");
		
		XMLАнализатор = СоздатьОбъект("AddIn.XMLParser");
		
		ЧтениеXML = XMLАнализатор.СоздатьПоследовательноСчитываемыйДокумент();
		ЧтениеXML.СвязатьСоСтрокой(XML);
		
		Пока 1 = 1 Цикл
			
			РезультатЧтения = ЧтениеXML.Спуститься();
			//конец документа
			Если РезультатЧтения = 4 Тогда
				Прервать;
			КонецЕсли;
			// начало элемента
			Если РезультатЧтения = 1 Тогда
				
				СвойстваТекущегоУзла = ЧтениеXML.СвойстваТекущегоУзла;
				
				ТекУзел = ВРЕГ(СвойстваТекущегоУзла.Имя);    
				
				Если(ТекУзел = "DECLAR")
				ИЛИ (ТекУзел = "DECLARHEAD")
				ИЛИ (ТекУзел = "DECLARBODY")
				ИЛИ (ТекУзел = "LINKED_DOCS") Тогда
					Продолжить;
				ИначеЕсли Найти(ТекУзел, "XXXX") > 0 Тогда
					Продолжить;
				Иначе
					
					Реквизит = ЧтениеXML.ТекущийЭлементВВидеОбъекта();
					
					Если ВРЕГ(Реквизит.ПолучитьАтрибут("xsi:nil")) = "TRUE" Тогда
						Продолжить;
					КонецЕсли;
					
					РеквизитыXML.ДобавитьЗначение(Реквизит.Значение, ТекУзел);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;		
		
		// Проверим параметры документа, при необходимости очистим ссылку
		Если ПроверятьРеквизиты = 1 Тогда
			
			Номер 		 	 = РеквизитыXML.Получить( "HNUM");
			НомерДокЗвит1С_2 = РеквизитыXML.Получить( "HNUM1");
			Если ПустоеЗначение(НомерДокЗвит1С_2) = 0 Тогда
				Номер = Номер + "/" + НомерДокЗвит1С_2;
			КонецЕсли;
			НомерДокЗвит1С_3 = РеквизитыXML.Получить( "HNUM2");
			Если ПустоеЗначение(НомерДокЗвит1С_3) = 0 Тогда
				Если Найти(Номер, "/") > 0 Тогда
					Номер = Номер + "/" + НомерДокЗвит1С_3;
				Иначе	
					Номер = Номер + "//"+ НомерДокЗвит1С_3;
				КонецЕсли;
			КонецЕсли;
			НомерДокументаЗвит1С = СокрЛП(Номер);
			
			ДатаДокументаЗвит1С  = РеквизитыXML.Получить("HFILL");
			Если ПустоеЗначение(ДатаДокументаЗвит1С) = 0 Тогда
				ДатаДокументаЗвит1С = СокрЛП(ДатаДокументаЗвит1С);
				ДатаДокументаЗвит1С = Дата(Сред(ДатаДокументаЗвит1С, 5, 4), Сред(ДатаДокументаЗвит1С, 3, 2), Сред(ДатаДокументаЗвит1С, 1, 2));
			КонецЕсли;
			
			КонтрагентИНН = РеквизитыXML.Получить("HKSEL");
			КонтрагентИНН = СокрЛП(КонтрагентИНН);
			
			ФирмаИНН = РеквизитыXML.Получить("HKBUY");
			ФирмаИНН = СокрЛП(ФирмаИНН);
			
			Если (НомерДокументаЗвит1С <> СокрЛП(НомерДокумента))
			ИЛИ (ДатаДокументаЗвит1С  <> ДатаДокумента) 
			ИЛИ (СокрЛП(Контрагент.ИНН)  <> КонтрагентИНН)
			//ИЛИ (СокрЛП(Фирма.ИНН)  <> ФирмаИНН)
			Тогда
				Если Вопрос("Реквизиты документа не соответствуют входящему налоговому документу из ""FREDO Звіт""
				| Номер: " + НомерДокументаЗвит1С + ", в ""FREDO Звіт"": "+ СокрЛП(НомерДокумента) + "
				| Дата:  " + ДатаДокументаЗвит1С + ", в ""FREDO Звіт"": "+ ДатаДокумента + "
				| ИНН продавца:"   + СокрЛП(Контрагент.ИНН) + ", в ""FREDO Звіт"": "+ КонтрагентИНН + "
				//| ИНН покупателя:" + СокрЛП(Фирма.ИНН) + ", в "FREDO Звіт"": "+ ФирмаИНН+ "
				|Очистить ссылку на документ из ""FREDO Звіт""?", 4) = 6  Тогда			
					Звит1С_DOC_ID = "";
					УстДоступность();
					Возврат;
				КонецЕсли;
			КонецЕсли; 
			
		КонецЕсли;
	
		// сверим суммы документа по ставке и исправим при необходимости
		C_DOC     = РеквизитыXML.Получить("C_DOC");
		C_DOC_SUB = РеквизитыXML.Получить("C_DOC_SUB");
		C_DOC_VER = РеквизитыXML.Получить("C_DOC_VER");
		
		БазаНДС20  = 0; СуммаНДС20 = 0;
		БазаНДС7   = 0; СуммаНДС7  = 0;
		БазаНДС0   = 0;
		БазаБезНДС = 0;
		Тара = 0;
		
		// 20%
		Если C_DOC_SUB = "010" Тогда
			БазаНДС20  = РеквизитыXML.Получить("R01G7");
			СуммаНДС20 = РеквизитыXML.Получить("R03G7");
		Иначе
			БазаНДС20  = РеквизитыXML.Получить("R01G9");
			СуммаНДС20 = РеквизитыXML.Получить("R02G9");
		КонецЕсли;
		
		// 7% и 0%
		Если РеквизитыXML.Получить( "HNUM1") = "7" Тогда
			
			Если C_DOC_SUB = "010" Тогда
				БазаНДС7  = РеквизитыXML.Получить("R01G8");
				СуммаНДС7 = РеквизитыXML.Получить("R03G8");
				// В сумме НДС по ставке 7 могут находиться ошибочно разделители триад
				СуммаНДС7 = СтрЗаменить(СуммаНДС7, " ", "");
			Иначе
				БазаНДС7  = РеквизитыXML.Получить("R01G10");
				СуммаНДС7 =РеквизитыXML.Получить("R02G9");
			КонецЕсли;
			
		Иначе
			
			Если C_DOC_SUB = "010" Тогда
				БазаНДС7  = РеквизитыXML.Получить("R01G109");
				СуммаНДС7 = РеквизитыXML.Получить("R03G109");
				
				R01G8 = РеквизитыXML.Получить("R01G8");
				Если ПустоеЗначение(R01G8) = 0 Тогда
					БазаНДС0 = БазаНДС0 + R01G8;
				КонецЕсли;
				
				R01G9 = РеквизитыXML.Получить("R01G9");
				Если  ПустоеЗначение(R01G9) = 0 Тогда
					БазаНДС0 = БазаНДС0 + R01G9;
				КонецЕсли;
			Иначе
				БазаНДС7  = РеквизитыXML.Получить("R01G111");
				СуммаНДС7 = РеквизитыXML.Получить("R02G111");
				
				БазаНДС0 = РеквизитыXML.Получить("R01G10");
			КонецЕсли;
			
		КонецЕсли;
		
		// БезНДС
		Если C_DOC_SUB = "010" Тогда
			БазаБезНДС = РеквизитыXML.Получить("R01G10");
		Иначе
			БазаБезНДС = РеквизитыXML.Получить("R01G11");
		КонецЕсли;
		
		Если ВидНДС.Код = "НДС20" Тогда
			БазаНДС  = БазаНДС20;
			СуммаНДС = СуммаНДС20;
		ИначеЕсли ВидНДС.Код = "НДС7" Тогда
			БазаНДС  = БазаНДС7;
			СуммаНДС = СуммаНДС7;
		ИначеЕсли ВидНДС.Код = "НДС0" Тогда
			БазаНДС  = БазаНДС0;
			СуммаНДС = 0;
		ИначеЕсли ВидНДС.Код = "БезНДС" Тогда
			БазаНДС  = БазаБезНДС;
			СуммаНДС = 0;
		КонецЕсли;
		
		БазаНДС  = Число(БазаНДС);
		СуммаНДС = Число(СуммаНДС);
		
		Если (СуммаБезНДС <> БазаНДС) ИЛИ (НДС <> СуммаНДС) Тогда
			
			Если Загружать = 1 Тогда
				Если БазаНДС = 0 Тогда
					Предупреждение("В документе из ""FREDO Звіт"" нет данных по ставке НДС: " + ВидНДС +"
									|В документ Предприятия будут загружены нулевые суммы!");	
				КонецЕсли;
				
				СуммаБезНДС = БазаНДС;
				НДС		 	= СуммаНДС;
				СуммаСНДС 	= НДС + СуммаБезНДС
			КонецЕсли;
			
			Если ПроверятьРеквизиты = 1 Тогда
				Если Вопрос("Суммы документа не соответствуют входящему налоговому документу из ""FREDO Звіт"" (вид НДС: " + ВидНДС + ")
								|  Сумма б/НДС: " + СуммаБезНДС + ", в ""FREDO Звіт"": "+ БазаНДС + "
								|  НДС: " + НДС + ", в ""FREDO Звіт"": "+ СуммаНДС + "
								|Исправить суммы в документе?", 4) = 6  Тогда
			
					СуммаБезНДС = БазаНДС;
					НДС		 	= СуммаНДС;
					СуммаСНДС 	= НДС + СуммаБезНДС
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если Открывать = 1 Тогда

		Результат = Компонента.ShowReport(СокрЛП(Звит1С_DOC_ID));
		
		Если Результат = 0 Тогда
			Компонента.Bring1CToFront();		
			Возврат;
		КонецЕсли;
	
		Компонента.BringZvitToFront();		
		
	КонецЕсли;
	
КонецПроцедуры	

// ===============================
Функция ПроверитьДанныеЗвит1С(ТаблицаДокЗвит1С, КодОрганизации, ИННКонтрагента, Номер_1, Номер_2, Номер_3)

	КодОрганизацииЗвит1С = ТаблицаДокЗвит1С.GetValue( "MAIN", "FIRM_EDRPOU" );
	
	НомерДокЗвит1С_1 = ТаблицаДокЗвит1С.GetValue( "MAIN", "DOC_NUM" );
	НомерДокЗвит1С_1 = Число(НомерДокЗвит1С_1);
	
	НомерДокЗвит1С_2 = ТаблицаДокЗвит1С.GetValue( "MAIN", "DOC_VD" );
	Если 1 = ПустоеЗначение(НомерДокЗвит1С_2) Тогда
		НомерДокЗвит1С_2 = 0;
	Иначе
		НомерДокЗвит1С_2 = Число(НомерДокЗвит1С_2);
	КонецЕсли;
	
	НомерДокЗвит1С_3 = ТаблицаДокЗвит1С.GetValue( "MAIN", "DOC_DEPT" );
	Если 1 = ПустоеЗначение(НомерДокЗвит1С_3) Тогда
		НомерДокЗвит1С_3 = 0;
	Иначе
		НомерДокЗвит1С_3 = Число(НомерДокЗвит1С_3);		
	КонецЕсли;
	
	ДатаДокЗвит1С  			= ТаблицаДокЗвит1С.GetValue( "MAIN", "DOC_DATE" );
    ИННКонтрагентаЗвит1С	= ТаблицаДокЗвит1С.GetValue( "MAIN", "FIRM_IPN" );;
	КодОрганизацииЗвит1С    = ТаблицаДокЗвит1С.GetValue( "MAIN", "FIRM_EDRPOU" );
	Если 	(СокрЛП(ИННКонтрагента) <> СокрЛП(ИННКонтрагентаЗвит1С) )
	 	ИЛИ (СокрЛП(КодОрганизации) <> СокрЛП(КодОрганизацииЗвит1С) )
		ИЛИ (ДатаДокумента <> ДатаДокЗвит1С)
	 	ИЛИ (Номер_1 <> НомерДокЗвит1С_1)
	 	ИЛИ (Номер_2 <> НомерДокЗвит1С_2)
	 	ИЛИ (Номер_3 <> НомерДокЗвит1С_3) Тогда
	 
		Возврат 0
		
	КонецЕсли;
	
	Возврат 1;

КонецФункции

// ===============================
Процедура ДействиеДокументЗвит1С()

	Перем Номер_1, Номер_2, Номер_3, КодОрганизации, ИННКонтрагента; 
	
	// открываем в FREDO Звіт
	// при этом контролируем соответствие сумм и ключевых полей
	спПараметры = СоздатьОбъект("СписокЗначений");
	спПараметры.Установить("НаПереднийПлан", 0);
	спПараметры.Установить("Фирма", Фирма);
	глВыполнитьКомандуЗвит1С("ЗапуситьЗвит1С", спПараметры);

	Результат = спПараметры.Получить("Результат");
	Если Результат <> 1 Тогда
		Предупреждение("Не удалось запустить ""FREDO Звіт""");
		Возврат;
	КонецЕсли;

	Если ПустоеЗначение(Звит1С_DOC_ID) = 1 Тогда
		// загружаем из Звита
		
		// будем искать в Звите входящую налоговую по указанным реквизитам
		Если    (1 = ПустоеЗначение(ДатаДокумента))
			ИЛИ (1 = ПустоеЗначение(НомерДокумента)) 
			ИЛИ (1 = ПустоеЗначение(Контрагент) )
			ИЛИ (1 = ПустоеЗначение(Контрагент.ИНН))
			ИЛИ НЕ (    (ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.НалоговаяНакладная)
			        ИЛИ (ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.РасчетКорректировки)) Тогда
		
			Предупреждение("Для загрузки документа из ""FREDO Звіт"" необходимо указать контрагента, дату, номер входящего документа, а также вид документа (налоговая накладная или расчет корректировки)
							|			   
							|Для групповой загрузки документов из ""FREDO Звіт"" необходимо воспользоваться комадной ""Загрузить документы из FREDO Звіт"" в Журнале ""Книга приобретений""");
		    Возврат;
			
		КонецЕсли;
		
		// получим необходимые реквизиты - номер накладной, код организации и контрагента
		ОшибкаРазбораНомера = ПолучитьКомпонентыНомераВходящейНакладной(Номер_1, Номер_2, Номер_3);
		Если ОшибкаРазбораНомера = 1 Тогда
			Возврат;
		КонецЕсли;
		
		ИННКонтрагента = Контрагент.ИНН;
		КодОрганизации = Фирма.ЕДРПОУ;
	
		Компонента = глМенеджерЗвит1С.Получить("Компонента");
		
		Если ВидДокумента = Перечисление.ВидыДокументовКнигиПриобретения.НалоговаяНакладная Тогда
			Звит1С_docType = 1;
		Иначе
			Звит1С_docType = 2;
		КонецЕсли;	
		
		// очистим код документа Звита перед поиском (если не найдем в Звите XML образ никуда не денется)
		ТаблицаДокЗвит1С = Компонента.GetPrimaryReestr( Звит1С_docType, 2, ДатаДокумента, ДатаДокумента + 1);
		
		Если ПустоеЗначение(ТаблицаДокЗвит1С) = 1 Тогда
			Предупреждение("Документ с указанными параметрами не найден в ""FREDO Звіт""");
			Возврат;
		КонецЕсли;
		
		Если ТаблицаДокЗвит1С.First("MAIN") = 1 Тогда
			
			Если ПроверитьДанныеЗвит1С(ТаблицаДокЗвит1С, КодОрганизации, ИННКонтрагента, Номер_1, Номер_2, Номер_3) = 1 Тогда
				
				Звит1С_DOC_ID = ТаблицаДокЗвит1С.GetValue( "MAIN", "DOC_ID" );
				
			Иначе
				
				Пока ТаблицаДокЗвит1С.Next("MAIN") = 1 Цикл
					
					Если ПроверитьДанныеЗвит1С(ТаблицаДокЗвит1С, КодОрганизации, ИННКонтрагента, Номер_1, Номер_2, Номер_3) = 1 Тогда
						Звит1С_DOC_ID = ТаблицаДокЗвит1С.GetValue( "MAIN", "DOC_ID" );
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
				
		КонецЕсли; 
	
		УстДоступность();
		
		Если ПустаяСтрока(Звит1С_DOC_ID) = 1 Тогда
			Предупреждение("Документ с указанными параметрами не найден в ""FREDO Звіт""");
			Возврат;
		КонецЕсли;

		ЭлектронныйДокумент = 1;
		
		ВыполнитьДействиеЗвит1С(0,1,0);
		
		Если Вопрос("Документ успешно загружен из ""FREDO Звіт"" (вид НДС: " + ВидНДС + ").
					|			
					|Открыть входящий документ в ""FREDO Звіт""?", 4) = 6 Тогда
    	    
			ВыполнитьДействиеЗвит1С(1,0,0);
			
		КонецЕсли;		
		
	Иначе
	
        ВыполнитьДействиеЗвит1С(1, 0, 1);
		
	КонецЕсли;
	
КонецПроцедуры




// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|СтруктураПодчиненности,
	|ДвиженияДокумента,
	|ОткрытьВЖурнале");
