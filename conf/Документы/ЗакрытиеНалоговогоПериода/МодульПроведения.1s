Перем  ОбъектныйУчет[4];

// ===============================
Функция ЭтоНоваяНорма(Норма)
	
	Если Найти(Норма.Код,"-04")>0 Тогда
		Возврат 1;
	Иначе
		Возврат 0;
	КонецЕсли;	
	
КонецФункции	

// ===============================
Функция ПроверкаШапки()
    глВсеВыбрано = 1;
 	глПроверкаДатыДок(Контекст,"Проведение");
 	глВыбранЛи(Фирма,"Фирма");

 	ноАмортГр = 0;
	Спис = СоздатьОбъект("СписокЗначений");
	Для Инд = 1 По 4 Цикл
		Если глПолучитьНиО(ноАмортГр,"АмортГр"+Инд,"о ставках амортизации "+Инд+" группы!") = 0 Тогда
			Возврат 0;
		КонецЕсли;
		глПарсить(ноАмортГр.Дополнительно.Получить(ДатаДок),Спис);
		ОбъектныйУчет[Инд] = Число(Спис.Получить("Пообъектно"));
	КонецЦикла;
	Возврат глВсеВыбрано;    
КонецФункции

// ===============================
Функция НачалоНалоговогоПериода()
	Перем	Док;
	
	Док = СоздатьОбъект("Документ.ЗакрытиеНалоговогоПериода");
	Док.ОбратныйПорядок(1);
	Док.ВыбратьДокументы(,ДатаДок-1);
	Пока Док.ПолучитьДокумент() = 1 Цикл
		Если (Док.Проведен() = 0) или (Док.Фирма <> Фирма) Тогда
			Продолжить;
		КонецЕсли;
		Возврат НачМесяца(ДобавитьМесяц(Док.ДатаДок, 1));
	КонецЦикла;
	Возврат НачКвартала(ДатаДок);
КонецФункции

// ===============================
Функция ОстатокПоОС(Ит)
	Перем	Ост, ОстК;
	
	Ост  = Ит.СНД();
	ОстК = Ит.СКД();
	Если ОстК <= 0 Тогда
		Ост = 0;
	КонецЕсли;
	
	Возврат Ост;
КонецФункции

// ===============================
Функция РаспределитьМодернизациюОС()
	Перем	БИ, НачДата, КонДата;
	Перем	ноОСНаЗатраты, СубконтоВР;
	Перем	МаксСуммаНаВР,СуммаМодернизации, ОтнесеноНаВР;
	Перем	СуммаНаВР, СуммаНаОС;
	Перем	СуммаОстатковОС, Остаток, Распределяем;
	
	// расчет вспомогательных параметров
	Если глПолучитьНиО(ноОСНаЗатраты,"ОСНаЗатраты","о величине суммы, которую можно отнести на затраты при модернизации необ. активов!") = 0 Тогда
		глКомментарий("Распределение суммы модернизации не будет выполнено!",0,,"!");
		Возврат 0;
	КонецЕсли;
	СубконтоВР = Константа.ВаловыйРасходМодернизацияОС;
	НачДата = НачКвартала(ДатаДок);
	КонДата = СформироватьПозициюДокумента(ТекущийДокумент(), -1);
	
	// расчет итогов
	БИ = СоздатьОбъект("БухгалтерскиеИтоги");
	БИ.ИспользоватьРазделительУчета(Фирма);
	
	БИ.ВыполнитьЗапрос(НачГода(ДатаДок),,"ОС");
	МаксСуммаНаВР = Окр(БИ.СНД() * ноОСНаЗатраты.Ставка.Получить(ДатаДок), 2);
	
	тбМодернизации = СоздатьОбъект("ТаблицаЗначений");
	тбМодернизации.НоваяКолонка("Объект");
	тбМодернизации.НоваяКолонка("СуммаМодернизации");
	тбМодернизации.НоваяКолонка("ОтнесеноВР");
	тбМодернизации.НоваяКолонка("МаксВР");
	тбМодернизации.НоваяКолонка("ВР");
	
	БИм = СоздатьОбъект("БухгалтерскиеИтоги");
	БИм.ИспользоватьРазделительУчета(Фирма);
	БИм.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
	БИм.ИспользоватьСубконто(ВидыСубконто.ШкалаСтавок);
	БИм.Опции(1);
	БИм.ВыполнитьЗапрос(КонДата,КонДата,"ОСМ");
	СуммаМодернизации = БИм.СКД();
	СуммаМодернизацииСтарые = 0;
	СуммаМодернизацииНовые = 0;
	БИм.ВыбратьСубконто(1);
	Пока БИм.ПолучитьСубконто(1) = 1 Цикл
		БИм.ВыбратьСубконто(2);
		Пока БИм.ПолучитьСубконто(2) = 1 Цикл
			Если ЭтоНоваяНорма(БИм.Субконто(2)) = 0 Тогда
				СуммаМодернизацииСтарые = СуммаМодернизацииСтарые + БИм.СКД();
			Иначе
				СуммаМодернизацииНовые = СуммаМодернизацииНовые + БИм.СКД();
			КонецЕсли;
			Если БИм.Субконто(1).Группа = 1 Тогда
				тбМодернизации.НоваяСтрока();
				тбМодернизации.Объект = БИм.Субконто(1);
				тбМодернизации.СуммаМодернизации = БИм.СКД();
				тбМодернизации.ОтнесеноВР = 0;
				тбМодернизации.МаксВР = 0;
			Иначе
				тбМодернизации.НоваяСтрока();
				тбМодернизации.Объект = ПолучитьПустоеЗначение("Справочник.НеоборотныеАктивы");
				тбМодернизации.СуммаМодернизации = БИм.СКД();
				тбМодернизации.ОтнесеноВР = 0;
				тбМодернизации.МаксВР = 0;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	БИ = СоздатьОбъект("БухгалтерскиеИтоги");
	БИ.ИспользоватьРазделительУчета(Фирма);
	БИ.ИспользоватьСубконто(ВидыСубконто.ВалДоходыРасходы, СубконтоВР, 2);
	БИ.ВыполнитьЗапрос(НачГода(ДатаДок),КонДата,"ВР");
	ОтнесеноНаВР = БИ.ДО();
	
	// учтем ограничение по отнесению модернизации на ВР
	СуммаНаВР = Мин(СуммаМодернизации, Макс(0, МаксСуммаНаВР-ОтнесеноНаВР));
	СуммаНаОС = СуммаМодернизации - СуммаНаВР;
	
		Если (ДатаГод(ДатаДок) = 2005) Тогда
		//Порядок отнесения на ВР суммы модернизации в 2005-ом году установлен Законом Украины от 25.03.2005 г. № 2505-IV 
		//«О внесении изменений в Закон Украины «О Государственном бюджете Украины на 2005 год» и некоторые другие законодательные акты Украины» 
		
		СтавкаНаВР = ноОСНаЗатраты.Ставка.Получить(ДатаДок);
		
		//Определим суммы, на которые уже модернизировались эти ОС в предыдущих периодах
		//Из них рассчитаем сколько уже отнесено на ВР по каждому
		БИ = СоздатьОбъект("БухгалтерскиеИтоги");
		БИ.ИспользоватьРазделительУчета(Фирма);
		БИ.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		БИ.ВыполнитьЗапрос(НачГода(ДатаДок),НачДата,"ОСМ");
		БИ.ВыбратьСубконто(1);
		Пока БИ.ПолучитьСубконто(1) = 1 Цикл
			Если БИ.Субконто(1).Группа = 1 Тогда
				тбМодернизации.НоваяСтрока();
				тбМодернизации.Объект = БИ.Субконто(1);
				тбМодернизации.ОтнесеноВР = БИ.КО();
				тбМодернизации.СуммаМодернизации = 0;
				тбМодернизации.МаксВР = 0;
			Иначе
				тбМодернизации.НоваяСтрока();
				тбМодернизации.Объект = ПолучитьПустоеЗначение("Справочник.НеоборотныеАктивы");
				тбМодернизации.ОтнесеноВР = БИ.КО();
				тбМодернизации.СуммаМодернизации = 0;
				тбМодернизации.МаксВР = 0;
			КонецЕсли;	
		КонецЦикла;
		
		//Определим балансовую стоимость каждого ОС на начало года
		БИ = СоздатьОбъект("БухгалтерскиеИтоги");
		БИ.ИспользоватьРазделительУчета(Фирма);
		БИ.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		БИ.ВыполнитьЗапрос(НачГода(ДатаДок),,"ОС");
		БИ.ВыбратьСубконто(1);
		Пока БИ.ПолучитьСубконто(1) = 1 Цикл
			Если БИ.Субконто(1).Группа = 1 Тогда
				тбМодернизации.НоваяСтрока();
				тбМодернизации.Объект = БИ.Субконто(1);
				тбМодернизации.МаксВР = БИ.СНД()*СтавкаНаВР;
				тбМодернизации.СуммаМодернизации = 0;
				тбМодернизации.ОтнесеноВР = 0;
			Иначе
				тбМодернизации.НоваяСтрока();
				тбМодернизации.Объект = ПолучитьПустоеЗначение("Справочник.НеоборотныеАктивы");
				тбМодернизации.МаксВР = БИ.СНД()*СтавкаНаВР;
				тбМодернизации.СуммаМодернизации = 0;
				тбМодернизации.ОтнесеноВР = 0;
			КонецЕсли;	
		КонецЦикла;
		
		//Свернем по объектам. Для групп 2-4 получим общую
		тбМодернизации.Свернуть("Объект","СуммаМодернизации,ОтнесеноВР,МаксВР");
		
		//Определим сумму на ВР
		тбМодернизации.НоваяКолонка("ВР");
        тбМодернизации.ВыбратьСтроки();
		Пока тбМодернизации.ПолучитьСтроку()=1 Цикл
			тбМодернизации.ВР = Мин(тбМодернизации.СуммаМодернизации, Макс(0, тбМодернизации.МаксВР-тбМодернизации.ОтнесеноВР));
		КонецЦикла;
		
		СуммаНаВР = тбМодернизации.Итог("ВР");
		СуммаНаОС = СуммаМодернизации - СуммаНаВР;
	    
	КонецЕсли;	
	
	
	//Распределим СуммаНаОС между старыми и новыми нормами
	Если СуммаМодернизацииНовые = 0 Тогда
		СуммаНаОСстарые = СуммаНаОС;
		СуммаНаОСновые = 0;
	Иначе
		СуммаНаОСстарые = СуммаНаОС*СуммаМодернизацииСтарые/СуммаМодернизации;
		СуммаНаОСновые = СуммаНаОС-СуммаНаОСстарые;
	КонецЕсли;	
	
	// проводка по ВР
	глПроводка(Контекст,"ВР","ВР",СуммаНаВР,"Модернизация: Валовые расходы",, ,,СубконтоВР,
	,,СубконтоВР, ,,"НА");
	
	// распределим СуммаНаОС равномерно по остаткам необ. активов
	Если (ДатаДок < '01.07.2004') Тогда
		БИ = СоздатьОбъект("БухгалтерскиеИтоги");
		БИ.ИспользоватьРазделительУчета(Фирма);
		БИ.ИспользоватьСубконто(ВидыСубконто.НеоборотныеАктивы);
		БИ.ИспользоватьСубконто(ВидыСубконто.ШкалаСтавок);
		БИ.Опции(1); // итоги по заб. счетам
		БИ.ВыполнитьЗапрос(НачДата,КонДата,"ОС1,ОС2,ОС3,ОС4");
		
		// подсчитаем итоговую сумму остатков по ОС
		СуммаОстатковОСстарые = 0;
		CуммаОстатковОСновые = 0;
		
		БИ.ВыбратьСчета();
		Пока БИ.ПолучитьСчет()=1 Цикл
			БИ.ВыбратьСубконто(1);
			Пока БИ.ПолучитьСубконто(1) = 1 Цикл
				БИ.ВыбратьСубконто(2);
				Пока БИ.ПолучитьСубконто(2) = 1 Цикл
					Если ЭтоНоваяНорма(БИ.Субконто(2))=0 Тогда
						СуммаОстатковОСстарые = СуммаОстатковОСстарые + ОстатокПоОС(БИ);
					Иначе
						CуммаОстатковОСновые = CуммаОстатковОСновые + ОстатокПоОС(БИ);
					КонецЕсли;	
				КонецЦикла;	
			КонецЦикла;
		КонецЦикла;
		
		Если ((СуммаОстатковОСстарые + CуммаОстатковОСновые) <> 0) и (СуммаНаОС > 0) Тогда
			// распределение
			глСписокОшибокОкругления.Установить("МодНаОС", 0);
			глСписокОшибокОкругления.Установить("МодНаОСновые", 0);
			БИ.ВыбратьСчета();
			Пока БИ.ПолучитьСчет()=1 Цикл
				БИ.ВыбратьСубконто(1);
				Пока БИ.ПолучитьСубконто(1) = 1 Цикл
					БИ.ВыбратьСубконто(2);
					Пока БИ.ПолучитьСубконто(2) = 1 Цикл
						Остаток = ОстатокПоОС(БИ);
						Если ЭтоНоваяНорма(БИ.Субконто(2))=0 Тогда
							Если СуммаОстатковОСстарые=0 Тогда
								Продолжить;
							КонецЕсли;	
							Распределяем = Остаток / СуммаОстатковОСстарые * СуммаНаОСстарые;
							Распределяем = глОкрКорр("МодНаОС", Распределяем, 2);
						Иначе
							Если CуммаОстатковОСновые=0 Тогда
								Продолжить;
							КонецЕсли;	
							Распределяем = Остаток / CуммаОстатковОСновые * СуммаНаОСновые;
							Распределяем = глОкрКорр("МодНаОСновые", Распределяем, 2);
						КонецЕсли;	
						глПроводка(Контекст,БИ.Счет,,Распределяем,"Модернизация: увел. бал. стоим. ОС",, БИ.Субконто(1), БИ.Субконто(2),,
						,,, ,,"НА");
					КонецЦикла; // по нормам	
				КонецЦикла; // по НА
			КонецЦикла; // по счетам
		КонецЕсли;
		
		// "закрываем" модернизацию 
		БИ = СоздатьОбъект("БухгалтерскиеИтоги");
		БИ.ИспользоватьРазделительУчета(Фирма);
		БИ.ИспользоватьСубконто(ВидыСубконто.ШкалаСтавок);
		БИ.ВыполнитьЗапрос(КонДата,КонДата,"ОСМ");
		БИ.ВыбратьСубконто();
		Пока БИ.ПолучитьСубконто() = 1 Цикл
			Если ЭтоНоваяНорма(БИ.Субконто(1))=0 Тогда
				Если СуммаОстатковОСстарые=0 Тогда
					глПроводка(Контекст,,"ОСМ",БИ.СКД()-СуммаНаОСстарые,"",, ,,, , БИ.Субконто(1),, ,,"НА");
					Продолжить;
				КонецЕсли;
			Иначе
				Если CуммаОстатковОСновые=0 Тогда
					глПроводка(Контекст,,"ОСМ",БИ.СКД()-СуммаНаОСновые,"",, ,,, , БИ.Субконто(1),, ,,"НА");
					Продолжить;
				КонецЕсли;
			КонецЕсли;	
			глПроводка(Контекст,,"ОСМ",БИ.СКД(),"",, ,,, , БИ.Субконто(1),, ,,"НА");
		КонецЦикла;
	Иначе //после 01.07.2004
		
		Таб=СоздатьОбъект("ТаблицаЗначений");
		Таб.НоваяКолонка("СчетОС");
		Таб.НоваяКолонка("Субк1");
		Таб.НоваяКолонка("Субк2");
		Таб.НоваяКолонка("Сумма");
		
		БИм.ВыбратьСубконто(1);
		Пока БИм.ПолучитьСубконто(1) = 1 Цикл //по объектам
			БИм.ВыбратьСубконто(2);
			Пока БИм.ПолучитьСубконто(2) = 1 Цикл //по нормам
				Если ПустоеЗначение(БИм.Субконто(1)) = 1 Тогда
					//при проведении модернизации указание аналитики по НА - обязательно
					глКомментарий("На счете ОСМ обнаружены остатки по пустой аналитике ""Необоротные активы"". Невозможно провести распределение затрат на модернизацию основных средств!",0,,"!");
					Возврат 0;	
				КонецЕсли;
				
				Модернизация = БИм.СКД();			
				
				Если СуммаНаОС > 0 Тогда
					Распределяем = глОкрКорр("МодНаОС", Модернизация / СуммаМодернизации * СуммаНаОС, 2);
					
					АморГр = БИм.Субконто(1).Группа;
					
					//накапливаем суммы модернизации, которые идут на увеличение стоимости группы(объекта)
					Таб.НоваяСтрока();
					Таб.СчетОС = СчетПоКоду("ОС"+АморГр);
					Таб.Субк1 = ?(ОбъектныйУчет[АморГр] = 1, БИм.Субконто(1), ПолучитьПустоеЗначение("Справочник.НеоборотныеАктивы"));
					Таб.Субк2 = БИм.Субконто(2); 
					Таб.Сумма = Распределяем;
				КонецЕсли;
				
				//закрвыем счет модернизации
				глПроводка(Контекст,,"ОСМ",Модернизация,"Модернизация: закрытие счета",, ,,, 
				БИм.Субконто(1), БИм.Субконто(2),, ,,"НА");
			КонецЦикла;
		КонецЦикла;
		
		Таб.Свернуть("СчетОС,Субк1,Субк2","Сумма");
		Таб.ВыбратьСтроки();
		Пока Таб.ПолучитьСтроку() = 1 Цикл
			//увеличиваем баллансовую стоимость группы (объекта)
			глПроводка(Контекст,Таб.СчетОС,,Таб.Сумма,"Модернизация: увел. бал. стоим. ОС",, Таб.Субк1,Таб.Субк2,,
			,,, ,,"НА");
		КонецЦикла;
	КонецЕсли;
	
	Возврат 1;	
КонецФункции // РаспределитьМодернизациюОС()

// ===============================
Процедура ЗабТМЦ_РассчитатьБухИтогиПоТМЦ(Таб, НачДата, КонДата)
	СпСчета = СоздатьОбъект("СписокЗначений");
	СпСчета.ДобавитьЗначение(СчетПоКоду("20"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("22"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("26"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("281"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2821"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2822"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("283"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2841"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2842"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2843"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2851"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("2852"));
	СпСчета.ДобавитьЗначение(СчетПоКоду("289"));
	
	Таб = СоздатьОбъект("ТаблицаЗначений");
	Таб.НоваяКолонка("ТипИтога");	// отладочная
	Таб.НоваяКолонка("ТМЦ",		"Справочник.ТМЦ");
	Таб.НоваяКолонка("СчетЗА",	"Строка", 3);
	Таб.НоваяКолонка("НачОстК",	"Число");
	Таб.НоваяКолонка("ПриходК",	"Число");
	Таб.НоваяКолонка("РасходК",	"Число");
	Таб.НоваяКолонка("КонОст",	"Число", 15, 2);
		
	// 1.1) Запрос по остаткам и общим оборотам
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.ТМЦ);
	Ит.ВключатьСубсчета(-1,-1);
	Ит.ВыполнитьЗапрос(НачДата,КонДата,СпСчета,,,3);
	
	// по ТМЦ
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1)=1 Цикл
		
		// по Счетам
		Ит.ВыбратьСчета();
		Пока Ит.ПолучитьСчет()=1 Цикл

			// добавление остатков
			Таб.НоваяСтрока();
			Таб.ТипИтога= "Остатки";
			Таб.ТМЦ		= Ит.Субконто(1);
			Таб.СчетЗА	= глСчетВСчетЗА(Ит.Счет);
			Таб.НачОстК	= Ит.СНД("К");
			Таб.КонОст	= Ит.СКД("С")-Ит.СКК("С");
			
			// по КорСчетам
			Ит.ВыбратьКорСчета();
			Пока Ит.ПолучитьКорСчет()=1 Цикл
				// добавление оборотов
				Таб.НоваяСтрока();
				Таб.ТипИтога= "Обороты";
				Таб.ТМЦ		= Ит.Субконто(1);
				Таб.ПриходК	= Ит.КорДО("К");
				Таб.РасходК	= Ит.КорКО("К");
			КонецЦикла; // КорСчета
		
		КонецЦикла; // Счета
		
	КонецЦикла; // ТМЦ
	
	// 1.2) Запрос по остаткам и общим оборотам ТЗР
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ВключатьСубсчета(-1,-1);
	Ит.ВыполнитьЗапрос(НачДата,КонДата,"2092,289",,,3);
	
	Ит.ВыбратьСчета();
	Пока Ит.ПолучитьСчет()=1 Цикл
		
		// добавление остатков
		Таб.НоваяСтрока();
		Таб.ТипИтога= "Остатки";
		Таб.ТМЦ		= ?(Ит.Счет = СчетПоКоду("2092"),Константа.НалоговыйТЗРМатериалы,Константа.НалоговыйТЗРТовары);
		Таб.СчетЗА	= глСчетВСчетЗА(Ит.Счет);
		Таб.НачОстК	= Ит.СНД("С");
		Таб.КонОст	= Ит.СКД("С")-Ит.СКК("С");

		// по КорСчетам
		Ит.ВыбратьКорСчета();
		Пока Ит.ПолучитьКорСчет()=1 Цикл
			// добавление оборотов
			Таб.НоваяСтрока();
			Таб.ТипИтога= "Обороты";
			Таб.ТМЦ		= ?(Ит.Счет = СчетПоКоду("2092"),Константа.НалоговыйТЗРМатериалы,Константа.НалоговыйТЗРТовары);
			Таб.ПриходК	= Ит.КорДО("С");
			Таб.РасходК	= Ит.КорКО("С");
		КонецЦикла; // КорСчета 
	КонецЦикла; // Счета

	// 2) Запрос по оборотам между счетами запасов
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.ТМЦ);
	Ит.ИспользоватьКорСубконто(ВидыСубконто.ТМЦ);
	Ит.ВключатьСубсчета(-1,-1);
	Ит.ВыполнитьЗапрос(НачДата,КонДата,СпСчета,СпСчета,,3);
	
	// по ТМЦ
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1)=1 Цикл
		// по ТМЦ (кор.)
		Ит.ВыбратьКорСубконто(1);
		Пока Ит.ПолучитьКорСубконто(1)=1 Цикл
			Если (Ит.Субконто(1)=Ит.КорСубконто(1)) 
			Тогда
				Таб.НоваяСтрока();
				Таб.ТипИтога= "Перемещения";
				Таб.ТМЦ		= Ит.Субконто(1);
				Таб.ПриходК	= -Ит.КорДО("К");
				Таб.РасходК	= -Ит.КорКО("К");
			КонецЕсли;
		КонецЦикла; // КорТМЦ
	КонецЦикла; // ТМЦ
	
	// 3) Запрос по остаткам незавершенного пр-ва
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ВыполнитьЗапрос(НачДата,КонДата,"23");
	Ит.ВыбратьСчета();
	Пока Ит.ПолучитьСчет()=1 Цикл
		// добавление остатков
		Таб.НоваяСтрока();
		Таб.ТипИтога= "Остатки";
		Таб.ТМЦ		= ПолучитьПустоеЗначение("Справочник.ТМЦ");
		Таб.СчетЗА	= глСчетВСчетЗА(Ит.Счет);
		Таб.КонОст	= Ит.СКД("С");
	КонецЦикла;
	// 3а) полуфабрикаты туда же
	Ит.ВыполнитьЗапрос(НачДата,КонДата,"25");
	Ит.ВыбратьСчета();
	Пока Ит.ПолучитьСчет()=1 Цикл
		// добавление остатков
		Таб.НоваяСтрока();
		Таб.ТипИтога= "Остатки";
		Таб.ТМЦ		= ПолучитьПустоеЗначение("Справочник.ТМЦ");
		Таб.СчетЗА	= глСчетВСчетЗА(Ит.Счет);
		Таб.КонОст	= Ит.СКД("С");
	КонецЦикла;
КонецПроцедуры


// ===============================
Процедура ЗабТМЦ_РассчитатьДанныеБухУчета(Таб, НачДата, КонДата)
	Перем	ТабБух;
	
	Таб.Выгрузить(ТабБух);
	ТабБух.Свернуть("СчетЗА","КонОст");
	
	// 1) в колонке КонОст сформируем разницу
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ВыполнитьЗапрос(НачДата,КонДата,"ЗАТБ,ЗАМБ,ЗАПБ,ЗАРБ,ЗАББ,ЗАНБ");
	
	// по Счетам
	Ит.ВыбратьСчета();
	Пока Ит.ПолучитьСчет()=1 Цикл

			ТабБух.НоваяСтрока();
			ТабБух.СчетЗА	= Лев(Ит.Счет.Код,3);
			ТабБух.КонОст	= -Ит.СКД("С");
			
	КонецЦикла;

	ТабБух.Свернуть("СчетЗА", "КонОст");
	
	// 2) формирование проводок на разницу (по ЗАхБ на суммы ТабБух.КонОст)
    ТабБух.ВыбратьСтроки();
	Пока ТабБух.ПолучитьСтроку() = 1 Цикл
		Если ПустоеЗначение(ТабБух.СчетЗА) = 0 Тогда
			глПровестиПоЗабалансовомуУчетуЗапасов(Контекст, ТабБух.СчетЗА, "Б", ТабБух.КонОст, "");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


// ===============================
Процедура ЗабТМЦ_РассчитатьДанныеНалУчета(Таб, НачДата, КонДата)
	Перем	ТабНал, ТабИт;
	Перем	ДельтаВсегоОтклонений, ВсегоНовыхОтклонений, НовоеОтклонение;
	Перем	СтрокаИтогов;
	
	Таб.Выгрузить(ТабНал);
	ТабНал.НоваяКолонка("Отклонение", "Число");
	ТабНал.Выгрузить(ТабИт);
		
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.ТМЦ);
	Ит.ВыполнитьЗапрос(НачДата,КонДата,"ЗАТО,ЗАМО,ЗАПО,ЗАРО,ЗАБО");
	
	// 1) Заполним колонку Отклонение	
	
	// по ТМЦ
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1)=1 Цикл
			// по Счетам
			Ит.ВыбратьСчета();
			Пока Ит.ПолучитьСчет()=1 Цикл
		        
				// детально по счетам
				ТабНал.НоваяСтрока();
				ТабНал.ТМЦ				= Ит.Субконто(1);
				ТабНал.СчетЗА			= Лев(Ит.Счет.Код, 3);
				ТабНал.Отклонение		= Ит.СКД("С");
				
				// для итогового отклонения
				ТабИт.НоваяСтрока();
				ТабИт.ТМЦ				= Ит.Субконто(1);
				ТабИт.Отклонение		= Ит.СКД("С");
	
			КонецЦикла;
			
	КонецЦикла;

	ТабНал.Свернуть("ТМЦ,СчетЗА","КонОст,Отклонение");
	ТабИт.Свернуть("ТМЦ",		"НачОстК,ПриходК,РасходК,КонОст,Отклонение");
	
	// 2) Рассчитаем новое итоговое отклонение
	

	ТабИт.ВыбратьСтроки();
	Пока ТабИт.ПолучитьСтроку() = 1 Цикл

		Попытка
			ДельтаВсегоОтклонений = ТабИт.Отклонение *
			                        ТабИт.РасходК / (ТабИт.НачОстК + ТабИт.ПриходК);
		Исключение
			ДельтаВсегоОтклонений = 0;
		КонецПопытки;
		
		ТабИт.Отклонение = ТабИт.Отклонение - ДельтаВсегоОтклонений;
		
	КонецЦикла;
	
	ТабИт.Свернуть("ТМЦ",	"КонОст,Отклонение");
	
	// 3) Распределим новое итоговое отклонение по счетам
	//    пропорционально суммовому остатку по бух. учету
	
	ТабНал.ВыбратьСтроки();
	Пока ТабНал.ПолучитьСтроку() = 1 Цикл
		// пропустим строки с пустым счетом
		Если ПустоеЗначение(ТабНал.СчетЗА) = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		// спозиционируемся в ТабИт
		СтрокаИтогов = 0;
		Если ТабИт.НайтиЗначение(ТабНал.ТМЦ, СтрокаИтогов, "ТМЦ") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ТабИт.ПолучитьСтрокуПоНомеру(СтрокаИтогов);
		
		// пропорциональное распределение
		Попытка
			НовоеОтклонение = ТабИт.Отклонение * (ТабНал.КонОст/ТабИт.КонОст);
		Исключение
			НовоеОтклонение = 0;
		КонецПопытки;
		
		// рассчитаем дельту и запишем в колонку Отклонение
		ТабНал.Отклонение = НовоеОтклонение - ТабНал.Отклонение;
	КонецЦикла;
	
	// 4) формирование проводок на разницу (по ЗАхО на суммы ТабНал.Отклонение)
	ТабНал.ВыбратьСтроки();
	Пока ТабНал.ПолучитьСтроку() = 1 Цикл
		Если ПустоеЗначение(ТабНал.СчетЗА) = 0 Тогда
			глПровестиПоЗабалансовомуУчетуЗапасов(Контекст, ТабНал.СчетЗА, "О", ТабНал.Отклонение, ТабНал.ТМЦ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


// ===============================
Процедура РассчитатьЗабалансовыеОстаткиЗапасов()
	Перем	Таб, НачДата, КонДата;
	
	НачДата = НачалоНалоговогоПериода();
	КонДата = КонМесяца(ДатаДок);
	
	ЗабТМЦ_РассчитатьБухИтогиПоТМЦ(Таб, НачДата, КонДата);
	ЗабТМЦ_РассчитатьДанныеБухУчета(Таб, НачДата, КонДата);
	ЗабТМЦ_РассчитатьДанныеНалУчета(Таб, НачДата, КонДата)

КонецПроцедуры


