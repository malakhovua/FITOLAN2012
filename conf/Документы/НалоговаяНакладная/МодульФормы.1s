Перем НачальнаяДатаДокумента;
Перем СтарЧтоПродаем;
Перем СтарыйКонтрагент;
Перем СписокДействий;
Перем СтараяДата;            
Перем СтарВидНДС;
Перем СтарКатегорияЦен;
Перем СтарыйВидОперации;
Перем РеализацияВУкраине;
Перем НоваяНакладная;
Перем ОбновитьБазуНДС;
Перем спВидДоговора;
Перем ЛьготаКод;

// ===============================
Процедура ВыбратьЛьготу()
Перем Выб;
	Спр = СоздатьОбъект("Справочник.ШкалаСтавок");
	Спис = СоздатьОбъект("СписокЗначений");
	ГрЛьгот = ?(ДатаДок >= '10.01.2011', "ЛьготыНДС2011","ЛьготыНДС");
	Если Спр.НайтиПоКоду(ГрЛьгот) = 1 Тогда
		Льготы = Спр.ТекущийЭлемент();
		Спр.ИспользоватьРодителя(Льготы);
		Спр.ВыбратьЭлементы(); 
		Пока Спр.ПолучитьЭлемент() = 1 Цикл 
			Спис.ДобавитьЗначение(Спр.ТекущийЭлемент());	
		КонецЦикла;
		Выб = ПолучитьПустоеЗначение("Справочник.ШкалаСтавок");
		Выб = ЛьготаНДС; // справочник ТМЦ
		Если Спис.ВыбратьЗначение(Выб,,,,2) = 1 Тогда
			ЛьготаНДС = Выб;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура ИзмОстав()    
	Если Оставляем = 1 Тогда
		Если (ДатаДок < '01/01/2015') Тогда
			ТребуетВклВЕдРеестрНН = 0;  
			ЭлектронныйДокумент = 0; 
		КонецЕсли;	
		ДипломатПредст = 0;
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура ИзмОставляем()    
	Инд = 0;
	Если (ПродажаНижеОЦ = 1) Тогда  
		Если (ДатаДок >= '01/04/2016') Тогда
			Оставляем = 1;
			Инд = 15;
		ИначеЕсли (ДатаДок >= '01/01/2015') Тогда
			Оставляем = 1;
			Инд = 13;
		Иначе
			Оставляем = 0;
		КонецЕсли;	
	ИначеЕсли (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт) Тогда 
		Инд = 7;     
		Оставляем = 1;
	ИначеЕсли (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.УсловнаяПродажа) Тогда  
		Инд = 2;
		Оставляем = 1;
	ИначеЕсли (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда	
		Инд = 14;
		Оставляем = 1;
	ИначеЕсли (ИтоговаяРозница = 1) Тогда  
		Инд = 11;
		Оставляем = 1;
	ИначеЕсли (ПустоеЗначение(Контрагент.ИНН)=1) Тогда  
		Инд = 2;
		Оставляем = 1;
	Иначе	
		Оставляем = 0;  
	КонецЕсли;
	Если (Инд <> 0) и (Оставляем = 1) Тогда
		спТипПричины.ТекущаяСтрока(Инд); 
		ТипПричины = спТипПричины.ПолучитьЗначение(Инд);
	КонецЕсли;
	ИзмОстав();

КонецПроцедуры
// ===============================
Процедура РассчитатьБазуНДС()
	НачВалюта = ?(ПустоеЗначение(Валюта)=1,Гривня,Валюта);
	
	Если ЕстьНулевыеСтавкиНДС = 0 Тогда
		Если ПродажаНижеОЦ = 0 Тогда
			СуммаНДС = Окр(Окр(глПересчет(Итог("НДС"),        НачВалюта,Гривня,Курс,ДатаДок),3),2);
			БазаНДС  = Окр(Окр(глПересчет(Итог("СуммаБезНДС"),НачВалюта,Гривня,Курс,ДатаДок),3),2);
		Иначе
			СуммаНДС = Окр(Окр(глПересчет(Итог("НДС")+Итог("НДСПревышения"),        НачВалюта,Гривня,Курс,ДатаДок),3),2);
			БазаНДС  = Окр(Окр(глПересчет(Итог("СуммаБезНДС")+Итог("СуммаПревышения"),НачВалюта,Гривня,Курс,ДатаДок),3),2);
		КонецЕсли;
	Иначе
		ГруппировочныеКолонки = "НулеваяСтавкаНДС";
		СуммируемыеКолонки    = "НДС, СуммаБезНДС";
		Если ПродажаНижеОЦ = 1 Тогда
			СуммируемыеКолонки = СуммируемыеКолонки + ", НДСПревышения, СуммаПревышения"; 
		КонецЕсли;
		ТЗ = СоздатьОбъект("ТаблицаЗначений");
		ВыгрузитьТабличнуюЧасть(ТЗ, ГруппировочныеКолонки + ", " + СуммируемыеКолонки);
		ТЗ.Свернуть(ГруппировочныеКолонки, СуммируемыеКолонки);
		БазаНДС  = 0;
		СуммаНДС = 0;
		БазаНДС0 = 0;
		ТЗ.ВыбратьСтроки();
		Пока ТЗ.ПолучитьСтроку() = 1 Цикл
			Если ПродажаНижеОЦ = 0 Тогда
				СумНДС   = ТЗ.НДС;
				База     = ТЗ.СуммаБезНДС;
			Иначе
				СумНДС   = ТЗ.НДС + ТЗ.НДСПревышения;
				База     = ТЗ.СуммаБезНДС + ТЗ.СуммаПревышения;
			КонецЕсли;
			Если ТЗ.НулеваяСтавкаНДС = Да Тогда
				БазаНДС0  = глПересчет(База,НачВалюта,Гривня,Курс,ДатаДок);
			Иначе
				СуммаНДС  = глПересчет(СумНДС,НачВалюта,Гривня,Курс,ДатаДок);
				БазаНДС   = глПересчет(База,НачВалюта,Гривня,Курс,ДатаДок);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если (ПродажаНижеОЦ = 1) Тогда
		Если (ДатаДок >= '01/04/2016') и (Оставляем = 0) Тогда
			Оставляем = 1;
			Инд = 15;
			спТипПричины.ТекущаяСтрока(Инд); 
			ТипПричины = спТипПричины.ПолучитьЗначение(Инд); 
		ИначеЕсли (ДатаДок >= '01/01/2015') и (Оставляем = 0) Тогда
			Оставляем = 1;
			Инд = 13;
			спТипПричины.ТекущаяСтрока(Инд); 
			ТипПричины = спТипПричины.ПолучитьЗначение(Инд); 
		ИначеЕсли (ДатаДок < '01/01/2015') Тогда
			Оставляем=0;
			ИзмОставляем();
		КонецЕсли;
	КонецЕсли; 
КонецПроцедуры

// ===============================
// Назначение: Пересчет сумм в строке документа
//		
// Аргументы: НоваяЦена - новая цена для текущей строки документа
//		
Процедура ПересчетСтроки(НоваяЦена=0)
	Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаБезНДС Тогда
		Если ПустоеЗначение(НоваяЦена) = 0 Тогда                                  
			// определим ставку НДС
			Если ВидНДС = ОсновнаяСтавкаНДС Тогда
				СтавкаНДС = ТМЦ.СтавкаНДС;
			Иначе
				СтавкаНДС = ВидНДС;
			КонецЕсли;
			// устанавливаем цену без НДС
			ЦенаБезНДС = НоваяЦена*100/(глПроцентНДС(СтавкаНДС,ДатаДок)+100);
		КонецЕсли;
		глВыч_Суммы_Накл(Контекст,-1);
	Иначе                     
		Если ПустоеЗначение(НоваяЦена) = 0 Тогда
			ЦенаСНДС = НоваяЦена;
		КонецЕсли;
		глВыч_Суммы_Накл(Контекст,1);
	КонецЕсли;
КонецПроцедуры //ПересчетСтроки

// ===============================
// Назначение: пересчитывает цену и суммы в строке документа по категори цен
//		
Процедура ПресчитатьЦенуПоКатегории()
	ЦенаТовара = глВернутьЦену(ТМЦ, КатегорияЦен);
	Если ПустоеЗначение(ЦенаТовара) = 0 Тогда
		// получим параметры цены
		ЦенаТовара.ИспользоватьДату(ДатаДок);
		ЦенаЦены   = ЦенаТовара.Цена;
		ВалютаЦены = ЦенаТовара.Валюта;
		ЕдЦены	   = ЦенаТовара.Единица;
		ЦенаЦены   = ЦенаЦены * Коэффициент / ЕдЦены.Коэффициент;			
		ЦенаЦены   = глПересчет(ЦенаЦены,ВалютаЦены,ДатаДок,Валюта,Курс,Дата_курса);
		ПересчетСтроки(ЦенаЦены);                                                   
	Иначе
		ПересчетСтроки();
	КонецЕсли;
КонецПроцедуры //ПресчитатьЦенуПоКатегории

// Назначение: пересчитывает суммы в строках документа при изменении реквизитов шапки
//		
// Аргументы: Реквизит - наименование измененного реквизита
//		
// ===============================
Процедура ИзмРеквизитШапки(Реквизит)
	// пересчитаем суммы НДС в строках табличной части
	Если (СтарВидНДС=ВидНДС) И (СтарКатегорияЦен=КатегорияЦен) Тогда
		// ничего не изменилось
		Возврат;     
	Иначе
		СтарВидНДС		=ВидНДС;
		СтарКатегорияЦен=КатегорияЦен;
	КонецЕсли;
	Если КоличествоСтрок() = 0 Тогда
	    Возврат;
	КонецЕсли;
	текОтвет = Вопрос("В документе изменен реквизит """+Реквизит+""". Перезаполнить цены заново?","Да+Нет");
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если текОтвет = "Да" Тогда
			// изменим цены
			ПресчитатьЦенуПоКатегории();
		ИначеЕсли Реквизит = "ВидНДС" Тогда
			ПересчетСтроки();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 
// ===============================
Процедура ИзмВидТорговли()
	Если ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
		ФормаРасчетов = "готівка";
	ИначеЕсли ВидТорговли = Перечисление.ВидыТорговли.Бартер Тогда
		ФормаРасчетов = "бартер";
	Иначе
		Если ДатаДок >= Константа.ДатаННДек2011 Тогда
			ФормаРасчетов = ?((ДатаДок >= '01.03.2014') и (ДатаДок < '01.01.2015'), "оплата з поточного рахунку", "оплата з поточного рахунка");   
		Иначе
			ФормаРасчетов = ?(ДатаДок >= '10.01.2011', "оплата з поточного рахунку", "оплата з розрахункового рахунку");   
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
// ===============================  
Процедура ИзмГТД() 
	ЭлектронныйГТД = ?(ГТД = 0,0,ЭлектронныйГТД);
КонецПроцедуры
// ===============================
Процедура ИзмДоговор()
	Если Договор.Выбран() = 1 Тогда
		Если Договор.Вид() = "Договор" Тогда
			Валюта_Прежн = Валюта;
			Валюта = Договор.Валюта;
			Если Валюта <> Валюта_Прежн Тогда
				Дата_Курса=ДатаДок;
				Курс_Прежн = Курс;
				Курс = глКурсДляВалюты(Валюта,ДатаДок);
				Если ((Валюта_Прежн <> Валюта) Или (Курс_Прежн <> Курс)) Тогда
					// что-то изменилось, надо пересчитать цены
					глУстан_Вал(Контекст, Валюта, Валюта_Прежн, Курс, Курс_Прежн);
				КонецЕсли;
			КонецЕсли;
			ВидТорговли = Договор.ВидТорговли;
			ИзмВидТорговли();
			ВидНДС = Договор.ВидНДС;
			ИзмРеквизитШапки("ВидНДС");
			ДатаДог = Договор.ДатаДок;
			НомДог = Договор.НомерДоговора; 
			ВидДоговора = Договор.ВидДоговора;
		КонецЕсли;
	КонецЕсли;    
КонецПроцедуры
// ======================================
Процедура ИзмУточняющийРасчет()  
	Если УточняющийРасчет = 1 Тогда
		Сообщить("При установленном флажке ""Включено в уточняющий расчет к Декларации по НДС"""
		"документ не будет отражаться в отчете ""Декларация по НДС"". ", "!"); 
		Сообщить("Необходимо вручную заполнить отчет ""Уточняющий расчет к Декларации по НДС"".", "!"); 
	КонецЕсли;
КонецПроцедуры
// ===============================
Функция ФРМЦена(ЧислЗнач)
	// без разделения на триады, не меньше двух и не больше пяти знаков после запятой
	Стр=СокрЛ(Формат(Окр(ЧислЗнач,5),"Ч15.5"));
	Для Инд=1 по 3 Цикл
		Если Прав(Стр,1)="0" Тогда
		    Стр = Лев(Стр,СтрДлина(Стр)-1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Стр;
КонецФункции

// ===============================
Функция ФРМСумма(ЧислЗнач)
	// без разделения на Триады
	Возврат СокрЛ(Формат(ЧислЗнач,"Ч15.2"));
КонецФункции

// ===============================
Процедура ВыборОплаты()
	// Процедура по кнопке редактирования параметров оплаты в документе
	ОткрытьФормуМодально("Обработка.ИнформацияОВалюте", Контекст);
КонецПроцедуры	

// ===============================
// Назначение: определяет признак розничной продажи конечному потребителю
// Аргументы:	КонечныйПотребитель -  признак продажи в розницу конечному потребителю из документа
//				Док - документ продажи в розницу
// Возвращает: 	1 - продажа конечному потребителю
//				0 - продажа не конечному потрбителю
Функция ЭтоКонечныйПотребитель(КонечныйПотребитель,Док)
	Если (ПустоеЗначение(КонечныйПотребитель) = 1) 
	И (Док.Вид() = "ОтчетКА") Тогда
		Возврат 1;
	Иначе
		Возврат КонечныйПотребитель;
	КонецЕсли;    
КонецФункции //ЭтоКонечныйПотребитель

// ======================================
Процедура ЗаполнитьРозница()
    
	Предоплата = Перечисление.ВидыТорговли.Предоплата;
	Розн = СоздатьОбъект("Запрос");
	ТекстЗапр = 	"//{{ЗАПРОС(Розн)
		|Период с ДатаДок по ДатаДок;
		|ОбрабатыватьДокументы Проведенные;
		|Док 				= Документ.РасходнаяРозничная.ТекущийДокумент, 		   Документ.ОтчетКА.ТекущийДокумент;
		|Дат 				= Документ.РасходнаяРозничная.ТекущийДокумент.ДатаДок, Документ.ОтчетКА.ТекущийДокумент.ДатаДок;
		|Фрм 				= Документ.РасходнаяРозничная.Фирма, 				   Документ.ОтчетКА.Фирма;
		|ВидНДСРозн			= Документ.РасходнаяРозничная.ВидНДС, 				   Документ.ОтчетКА.ВидНДС;
		|Скидка				= Документ.РасходнаяРозничная.Скидка;
		
		|КонечныйПотребитель= Документ.РасходнаяРозничная.КонечныйПотребитель;
		|ВидТорговли		= Документ.РасходнаяРозничная.ВидТорговли;	

		|ДокБазаНДС_БезНДС	= Документ.РасходнаяРозничная.БазаНДС1, Документ.ОтчетКА.БазаНДС1;
		|ДокБазаНДС_0		= Документ.РасходнаяРозничная.БазаНДС2, Документ.ОтчетКА.БазаНДС2;
		|ДокБазаНДС_20		= Документ.РасходнаяРозничная.БазаНДС3, Документ.ОтчетКА.БазаНДС3;

		|ДокНДС_БезНДС		= Документ.РасходнаяРозничная.НДС1, Документ.ОтчетКА.НДС1;
		|ДокНДС_0			= Документ.РасходнаяРозничная.НДС2,	Документ.ОтчетКА.НДС2;
		|ДокНДС_20			= Документ.РасходнаяРозничная.НДС3,	Документ.ОтчетКА.НДС3;

		|Функция БазаНДС_БезНДС 	= Сумма(ДокБазаНДС_БезНДС) 	Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция БазаНДС_0 			= Сумма(ДокБазаНДС_0) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция БазаНДС_20 		= Сумма(ДокБазаНДС_20) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);

		|Функция НДС_БезНДС 		= Сумма(ДокНДС_БезНДС) 	Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция НДС_0	 			= Сумма(ДокНДС_0) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция НДС_20 			= Сумма(ДокНДС_20) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		
		|Условие(Фрм = Фирма);
		|Условие(ВидНДСРозн = ВидНДС); 
		|Условие(ВидТорговли <> Предоплата);
		|"//}}ЗАПРОС
		;         

	Если Розн.Выполнить(ТекстЗапр)=0 Тогда
		Предупреждение("Не выполнился запрос по розничным накладным!");
		Возврат;
	КонецЕсли;
	
	Если КоличествоСтрок() > 0 Тогда
		Если Вопрос("Очистить табличную часть?","Да+Нет")="Нет" Тогда
			Возврат;
		КонецЕсли;
		УдалитьСтроки();
	КонецЕсли;	
	
	НоваяСтрока();
	
	ТМЦ = Константа.НоменклатураДляННПоРознице;
	НулеваяСтавкаНДС = Нет;
	Кво 			 = 1;
	глУстановкаБазЕд(Контекст,ТМЦ);
	
	Если ВидНДС = БезНДС тогда
		СуммаСНДС = Розн.БазаНДС_БезНДС;
		НДС = Розн.НДС_БезНДС;
		СуммаБезНДС = СуммаСНДС-НДС;
		СуммаБезСкидки =СуммаСНДС;
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			СуммаБезСкидки = СуммаСНДС;
		Иначе
			СуммаБезСкидки = СуммаСНДС/ (1 + ВидНДС.Ставка.Получить(ДатаДок));
		КонецЕсли;	
	ИначеЕсли ВидНДС = ЛьготнаяСтавкаНДС тогда
		СуммаСНДС = Розн.БазаНДС_0;
		НДС = Розн.НДС_0;
		СуммаБезНДС = СуммаСНДС-НДС;
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			СуммаБезСкидки = СуммаСНДС;
		Иначе
			СуммаБезСкидки = СуммаСНДС/ (1 + ВидНДС.Ставка.Получить(ДатаДок));
		КонецЕсли;	
	Иначе
		СуммаСНДС = Розн.БазаНДС_20;
		НДС = Розн.НДС_20;
		СуммаБезНДС = СуммаСНДС-НДС;
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			СуммаБезСкидки = СуммаСНДС;
		Иначе
			СуммаБезСкидки = СуммаСНДС/ (1 + ВидНДС.Ставка.Получить(ДатаДок));
		КонецЕсли;	
	КонецЕсли;
	
	ЦенаСНДС = СуммаСНДС;
	ЦенаБезНДС = СуммаБезНДС;
		                     
	Если ЕстьНулевыеСтавкиНДС = 1 Тогда
		НоваяСтрока();
		ТМЦ = Константа.НоменклатураДляННПоРознице;
		НулеваяСтавкаНДС = Да;
		СуммаСНДС = Розн.БазаНДС_0;
		НДС = Розн.НДС_0;
		СуммаБезНДС = СуммаСНДС-НДС;
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			СуммаБезСкидки = СуммаСНДС;
		Иначе
			СуммаБезСкидки = СуммаСНДС/ (1 + ВидНДС.Ставка.Получить(ДатаДок));
		КонецЕсли; 
		ЦенаСНДС = СуммаСНДС;
		ЦенаБезНДС = СуммаБезНДС;
	КонецЕсли;
	
	РассчитатьБазуНДС();
	
КонецПроцедуры	


// ======================================
Процедура Заполнить(Док=0)
	ДокОснование = Док;
	
	Если ПустоеЗначение(Док) = 1 Тогда
		Если (РодительскийДокумент.Выбран() = 1) И (Найти("Счет,РасходнаяНакладная,ЛиквидацияНеоборАктивов,ОказаниеУслуг",РодительскийДокумент.Вид()) > 0) Тогда
			ДокОснование = РодительскийДокумент;
		Иначе
			ДокОснование = ДокументОснование;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустоеЗначение(ДокОснование) = 1 Тогда
		// не удалось выбрать основание для заполнения
		Возврат;
	КонецЕсли;
	
	Если Вопрос("Заполнить накладную номенклатурой из документа-основания?","Да+Нет") = "Нет" Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьСтроки();
	ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ;
	Если ДокОснование.Вид() = "Счет" Тогда
		ЧтоПродаем = ДокОснование.ЧтоПродаем;
	ИначеЕсли ДокОснование.Вид() = "ЛиквидацияНеоборАктивов" Тогда
		ЧтоПродаем = Перечисление.ЧтоПродаем.НеоборотныеАктивы;
	КонецЕсли; 
	
	Попытка
	    ВидНДС = ДокОснование.ВидНДС;
	Исключение
	КонецПопытки;
	НДС20 = ?(СокрЛП(ВидНДС.Код) = "НДС20", 1, 0);
	
	ДокОснование.ВыбратьСтроки();
	// пересчитаем возвратную тару
	СуммаВозвратнойТары = 0;
	Пока ДокОснование.ПолучитьСтроку() = 1 Цикл
		// добавим строку
		НоваяСтрока();
		Если ЧтоПродаем = Перечисление.ЧтоПродаем.НеоборотныеАктивы Тогда
			НазначитьВид(ТМЦ,"НеоборотныеАктивы");
		Иначе
			НазначитьВид(ТМЦ,"ТМЦ");
		КонецЕсли;
		Форма.ТМЦ.НеИзменятьВид(1);
		Если ДокОснование.Вид() = "ЛиквидацияНеоборАктивов" Тогда
			ТМЦ = ДокОснование.НеоборотныйАктив;
			КодУКТВЭД = "";
		ИначеЕсли ДокОснование.Вид() = "ОказаниеУслуг" Тогда
			ТМЦ = ДокОснование.Услуга;
			КодУКТВЭД = ТМЦ.КодУКТВЭД;
		Иначе
			ТМЦ = ДокОснование.ТМЦ;
			КодУКТВЭД = ТМЦ.КодУКТВЭД;
		КонецЕсли;
		Если ТМЦ.Вид() = "ТМЦ" Тогда
			Если ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Тара Тогда
				Если (глЕстьРеквизитШапки("ВидТары",ДокОснование.Вид()) = Да) Тогда
					Если (ДокОснование.ВидТары <> Перечисление.ВидыТары.Покупная) Тогда
						// возвратная тара не должна попадать в табличную часть
						СуммаВозвратнойТары = СуммаВозвратнойТары + ДокОснование.СуммаБезНДС;
						УдалитьСтроку();
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		СуммаСНДС = ДокОснование.СуммаСНДС; 
		НулеваяСтавкаНДС = Нет;
		Если ДокОснование.Вид() = "ЛиквидацияНеоборАктивов" Тогда
			ЦенаБезНДС = ДокОснование.ЦенаБезНДС;
			ЦенаСНДС = ЦенаБезНДС * (1 + ВидНДС.Ставка.Получить(ДатаДок));
			СуммаБезНДС = ДокОснование.СуммаБезНДС;
			СуммаБезСкидки = СуммаБезНДС;
			НДС = ДокОснование.НДС;
			Кво = 1;
			глУстановкаБазЕд(Контекст,,ТМЦ.БазЕдиница);
		Иначе
			// счета и накладные
			Кво = ДокОснование.Кво;
			Ед = ДокОснование.Ед;
			Коэффициент = ДокОснование.Коэффициент;
			Если ДокОснование.Вид() = "РасходнаяНакладная" Тогда
				ЦенаБезНДС = ДокОснование.ЦенаБезНДС;
				ЦенаСНДС = ДокОснование.ЦенаСНДС;
				Скидка = ДокОснование.Скидка;
				СуммаБезСкидки = ДокОснование.СуммаБезСкидки;
				СуммаБезНДС = ДокОснование.СуммаБезНДС;
				НДС = СуммаСНДС - СуммаБезНДС;
			ИначеЕсли ДокОснование.Вид() = "РасходнаяРозничная" Тогда
				ЦенаСНДС = ДокОснование.ЦенаСНДС;
				Если ДокОснование.ВидНДС = ОсновнаяСтавкаНДС Тогда
					СтНДС = ТМЦ.СтавкаНДС.Ставка.Получить(ДатаДок);
				Иначе
					СтНДС = ДокОснование.ВидНДС.Ставка.Получить(ДатаДок);
				КонецЕсли;
				ЦенаБезНДС = ЦенаСНДС - ЦенаСНДС*СтНДС/(1+СтНДС);
				НДС = СуммаСНДС*СтНДС/(1+СтНДС);
				СуммаБезНДС = СуммаСНДС - НДС;
				СуммаБезСкидки = СуммаБезНДС;
			Иначе
				ЦенаБезНДС = ДокОснование.ЦенаБезНДС;
				ЦенаСНДС = ДокОснование.ЦенаСНДС;
				Скидка = ДокОснование.Скидка;
				СуммаБезСкидки = ДокОснование.СуммаБезСкидки;
				СуммаБезНДС = ДокОснование.СуммаБезНДС;
				НДС = ДокОснование.НДС;
			КонецЕсли;
		КонецЕсли;
		Если НДС20 = 1 Тогда
			Если НДС = 0 Тогда
				ЕстьНулевыеСтавкиНДС = 1;
				НулеваяСтавкаНДС = Да; 
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

// ===============================
Процедура ВыборОснования()
	// Процедура по кнопке редактирования основания в документе
	глРасшифровка = 0;
	ОткрытьФормуМодально("Обработка.ОснованиеДокумента", Контекст);
	Если (ДокументОснование.Выбран() = 1) и (Найти("Счет,РасходнаяНакладная,РасходнаяРозничная",ДокументОснование.Вид()) > 0) Тогда
		Заполнить(ДокументОснование);
	КонецЕсли;               
КонецПроцедуры 
// ===============================
Процедура ИзмСуммаПревышения()
	НДСПревышения = СуммаПревышения * ?(НулеваяСтавкаНДС = Да, 0, ВидНДС.Ставка.Получить(ДатаДок));
КонецПроцедуры

// ===============================
Процедура ИзмНулеваяСтавкаНДС()
	Если НулеваяСтавкаНДС = Да Тогда
		НДС = 0
	Иначе
		НДС = СуммаБезНДС*ВидНДС.Ставка.Получить(ДатаДок);
	КонецЕсли;
	СуммаСНДС = СуммаБезНДС+НДС;
	ИзмСуммаПревышения();
КонецПроцедуры

// ===============================
Процедура ПересчитатьНДС()
	Если КоличествоСтрок() > 0 Тогда
		Если Вопрос("Пересчитать НДС?", "Да+Нет") = "Нет" Тогда
			РассчитатьБазуНДС();
			Возврат
		КонецЕсли;
		ВыбратьСтроки();
		Пока ПолучитьСтроку() = 1 Цикл
			Если ЕстьНулевыеСтавкиНДС = 0 Тогда
				НулеваяСтавкаНДС = Нет;
			КонецЕсли;
			ИзмНулеваяСтавкаНДС();
		КонецЦикла;
		РассчитатьБазуНДС();
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура ИзмВидНДС()
	Если СтарВидНДС <> ВидНДС Тогда
		Если СокрЛП(ВидНДС.Код) <> "НДС20" Тогда
			 ЕстьНулевыеСтавкиНДС = 0;
			 ПродажаНижеОЦ        = 0;
			 ОЦВключаетПроценты   = 0;
		КонецЕсли;
		Если ДатаДок < '01/12/2014' Тогда
			Если СокрЛП(ВидНДС.Код) = "НДС7" Тогда
				СпецРежимНалогообложения = 7;
			Иначе
				СпецРежимНалогообложения = ?(СпецРежимНалогообложения = 7,0,СпецРежимНалогообложения);
			КонецЕсли;
		КонецЕсли;
		ПересчитатьНДС();
		СтарВидНДС = ВидНДС;
	КонецЕсли;
КонецПроцедуры

// ======================================
Процедура ИзмЕстьНулевыеСтавкиНДС()
	Если ЕстьНулевыеСтавкиНДС = 1 Тогда
		ВыбратьСтроки();
		Пока ПолучитьСтроку() = 1 Цикл
			Если ПустоеЗначение(НулеваяСтавкаНДС) = 1 Тогда
				НулеваяСтавкаНДС = Нет;
			КонецЕсли;
		КонецЦикла;
		РассчитатьБазуНДС();
	Иначе
		ПересчитатьНДС();
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура ИзмДатаДок()
	НоваяНакладная = ?(ДатаДок >= '29.07.2005', 1, 0);
	НоваяНакладная = ?(ДатаДок >= '10.01.2011', 2, НоваяНакладная);
	Если НоваяНакладная = 0 Тогда
		ПродажаНижеОЦ      = 0;
		ОЦВключаетПроценты = 0;
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			ЕстьНулевыеСтавкиНДС = 0;
			ИзмЕстьНулевыеСтавкиНДС();
		Иначе
			РассчитатьБазуНДС()
		КонецЕсли;
	КонецЕсли;
	Если  (Константа.ВестиМесячнуюНумерациюНалоговыхДокументов.Получить(ДатаДок) = 1) 
	  ИЛИ (Константа.ВестиМесячнуюНумерациюНалоговыхДокументов.Получить(СтараяДата) = 1) Тогда
		Если (ДатаГод(ДатаДок) * 12 +  ДатаМесяц(ДатаДок)) <> (ДатаГод(СтараяДата) * 12 +  ДатаМесяц(СтараяДата)) Тогда
			глУстановитьНомер(Контекст);
		КонецЕсли;
	КонецЕсли;
	глПриИзмененииДатыДокумента(Контекст, СтараяДата);
	Если (ДатаДок >= '01.01.2015') Тогда
		ЭлектронныйДокумент = 1;
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
КонецПроцедуры //



// ===============================
Процедура ИзмОбычнаяЦена()
	СуммаПревышения = Макс(ОбычнаяЦена*Коэффициент*Кво-СуммаБезНДС,0);	
	ИзмСуммаПревышения();
КонецПроцедуры	

// ===============================
Процедура ИзмТМЦ()
	Если ТМЦ.Выбран() = 1 Тогда
		Если ТМЦ.Вид()="ТМЦ" Тогда
			глПриИзмененииТовара(Контекст);
			Если ПустоеЗначение(ТМЦ) = 0 Тогда
			   КодУКТВЭД = ТМЦ.КодУКТВЭД; 
			КонецЕсли;
		Иначе
			// необоротные активы
			глУстановкаБазЕд(Контекст, , ТМЦ.БазЕдиница);
			ЦенаБезНДС = глПересчет(ТМЦ.Цена_Прих,Гривня,Валюта,ДатаДок,Курс);
			глВыч_Суммы_Накл(Контекст,-1);
		КонецЕсли;                       
	Иначе
		глПриИзмененииТовара(Контекст);
	КонецЕсли;
	ИзмОбычнаяЦена();
КонецПроцедуры
// ======================================
Процедура ЗаполнитьГрафу5()
	Если (КорГрафы5 = 0) Тогда
		Если (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) или (ДипломатПредст = 1) Тогда 
				Графа5 = СокрЛП(Фирма.ПолнНаименование); 
		ИначеЕсли ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда	
			Графа5 = СокрЛП(Контрагент.Регион)+" " + СокрЛП(Контрагент.ПолнНаименование);  
		ИначеЕсли (ИтоговаяРозница = 1) Тогда
			Графа5 = "Підсумкова податкова накладна";
		Иначе
			Графа5 = СокрЛП(Контрагент.ПолнНаименование); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 
// ======================================
Процедура ПроверкаТребуетВклВЕдРеестрНН()
	Если (ДатаДок >= '01/01/2015') Тогда 
		// все налоговые должны регистрироваться в Едином реестре
	ИначеЕсли (Оставляем = 1) или (ЕРНН = 1) Тогда
		// мы не управляем флажком ТребуетВключенияВЕдиныйРеестрНалоговыхНакладных
		// для налоговых накладных, которые не выдаются покупателю
		// согласно разъяснению ЕБНЗ такие налоговые не должны регистрироваться в Едином реестре
	ИначеЕсли (ЭлектронныйДокумент = 1)  и (ДатаДок >= '01/03/2014') Тогда	
		ТребуетВклВЕдРеестрНН = 1; 
		Сообщить("Требуется включение документа Налоговая накладная № "+ СокрЛП(НомерДок)+" от "+ ДатаДок  + " в единый реестр налоговых накладных!", "!"); 
	Иначе	
		// поставим флаг "Требует регистрация в реестре"
		ТребуетВклВЕдРеестрНН = 0;
		Если Валюта = Гривня Тогда
			НДСРегл = Итог("НДС");
		Иначе
			НДСРегл = глПересчет(Итог("НДС"),Валюта,Гривня,Курс,ДатаДок);
		КонецЕсли;
		Если ДатаДок >= '01.01.12' Тогда
			// или сумма НДС в документе больше 10 000 грн
			Если НДСРегл > 10000 Тогда
				ТребуетВклВЕдРеестрНН = 1;
				
			// или имеются подакцизные/импортированные товары
			// этот факт определим так - если в строке указан код УКТЗЭД - считаем что условие выполняется.
			Иначе   
				ВыбратьСтроки();
				Пока ПолучитьСтроку() = 1 Цикл
					Если ПустоеЗначение(КодУКТВЭД) = 0 Тогда
						ТребуетВклВЕдРеестрНН = 1;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли ДатаДок >= '01.07.11' Тогда
			// сумма НДС в документе больше 100 000 грн
			Если НДСРегл > 100000 Тогда
				ТребуетВклВЕдРеестрНН = 1;
			КонецЕсли;
		ИначеЕсли ДатаДок >= '01.04.11' Тогда
			// сумма НДС в документе больше 500 000 грн
			Если НДСРегл > 500000 Тогда
				ТребуетВклВЕдРеестрНН = 1;
			КонецЕсли;
		ИначеЕсли ДатаДок >= '01.01.11' Тогда
			// сумма НДС в документе больше 1 000 000 грн
			Если НДСРегл > 1000000 Тогда
				ТребуетВклВЕдРеестрНН = 1;
			КонецЕсли;
		КонецЕсли;
		Если ТребуетВклВЕдРеестрНН = 1 Тогда
			Сообщить("Требуется включение документа Налоговая накладная № "+ СокрЛП(НомерДок)+" от "+ ДатаДок  + " в единый реестр налоговых накладных!", "!"); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 
// ===============================
Процедура ИзмКонтрагент()
	Если Контрагент.Выбран() = 0 Тогда
	    Возврат;
	КонецЕсли;	
	Если СтарыйКонтрагент <> Контрагент Тогда
		// изменили Контрагента
		Если Договор.Выбран() = 1 Тогда
			Если Договор.Контрагент <> Контрагент Тогда
				Договор = 0;
			КонецЕсли;
		КонецЕсли;    
		Если Договор.Выбран() = 0 Тогда
			Если (Фирма = Контрагент.БазДоговор.Фирма) и (глВосстановитьЗначение(,"ПодставлятьОсновнойДоговор")=Да) Тогда
				Договор = Контрагент.БазДоговор;
			КонецЕсли;
			Если ПустоеЗначение(Контрагент.ВидТорговли) = 0 Тогда
				ВидТорговли = Контрагент.ВидТорговли;
				ИзмВидТорговли();
			ИначеЕсли ПустоеЗначение(ВидТорговли) = 1 Тогда
				ВидТорговли = глВосстановитьЗначение(,"ОсновнойВидТорговли");
				ИзмВидТорговли();
			КонецЕсли;	
			ИзмДоговор();
		КонецЕсли;       
		// проверим документ-основание
		Если ПустоеЗначение(ДокументОснование) = 0 Тогда
			Если ДокументОснование.Контрагент <> Контрагент Тогда
				ДокументОснование = 0;
			КонецЕсли;	
		КонецЕсли;	
		Если ПустоеЗначение(Контрагент.КатегорияЦен) = 0 Тогда
			КатегорияЦен = Контрагент.КатегорияЦен;
		Иначе	
			КатегорияЦен = глВосстановитьЗначение(,"ОсновнаяКатегорияЦен");
		КонецЕсли;    
		Если КатегорияЦен<>СтарКатегорияЦен Тогда
			// изменилась категория цен
			Если КоличествоСтрок() <> 0 Тогда
			    текОтвет = Вопрос("У покупателя установлена категория цен "+КатегорияЦен+". Изменить категорию цен в документе и пересчитать суммы в табличной части?","Да+Нет");
				Если текОтвет = "Да" Тогда
					СтарКатегорияЦен = КатегорияЦен;
					ВыбратьСтроки();
					Пока ПолучитьСтроку() = 1 Цикл  
						ПресчитатьЦенуПоКатегории();
					КонецЦикла;	
				Иначе
					КатегорияЦен = СтарКатегорияЦен;	
				КонецЕсли;
			Иначе
				СтарКатегорияЦен = КатегорияЦен;
			КонецЕсли;      
		КонецЕсли;
	КонецЕсли;	
	СтарыйКонтрагент = Контрагент;
	ЗаполнитьГрафу5(); 
	ИзмОставляем();
КонецПроцедуры

// ===============================
Процедура ИзмВидОперации()
	Если СтарыйВидОперации <> ВидОперации Тогда
		Если (ВидОперации <> Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине)
		   и (ВидОперации <> Перечисление.ВидыОперацийНалоговойНакладной.Экспорт) Тогда
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				ЕстьНулевыеСтавкиНДС = 0;
				ПересчитатьНДС();
			КонецЕсли;
		КонецЕсли;
		Если ВидОперации <> Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине Тогда
			Если ПродажаНижеОЦ = 1 Тогда
				ПродажаНижеОЦ      = 0;
				ОЦВключаетПроценты = 0;
				РассчитатьБазуНДС();
			КонецЕсли;
		КонецЕсли;
		Если (ВидОперации <> Перечисление.ВидыОперацийНалоговойНакладной.Экспорт) Тогда
			ГТД = 0;
		КонецЕсли;
		Если (ВидОперации <> Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда
			УслугиДляНеХозДеят = 0;
		КонецЕсли;
		ЗаполнитьГрафу5();
		ИзмОставляем();
	КонецЕсли;
КонецПроцедуры

// ===============================
Функция УстДоступность()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	Форма.Заголовок(глЗаголовок(Контекст,"Налоговая накладная"));

	Если (ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ) Тогда
		НазначитьВид(ТМЦ,"ТМЦ");
	Иначе
		НазначитьВид(ТМЦ,"НеоборотныеАктивы");
	КонецЕсли;

	Форма.ТМЦ.НеИзменятьВид(1);
	
	Если (ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ) Тогда
		Форма.Ед.Доступность(1);
		Форма.кПодбор.Доступность(1-Форма.ТолькоПросмотр());
	Иначе
		Форма.Ед.Доступность(0);
		Форма.кПодбор.Доступность(0);
	КонецЕсли;

	Если РодительскийДокумент.Выбран() = 1 Тогда
		// накладная выписана документом, значит не итоговая
		Если Итоговая = 1 Тогда
		    Итоговая = 0;
		КонецЕсли;
		Форма.Итоговая.Доступность(0);
		Форма.кОчиститьРодительскийДокумент.Доступность(1);
	Иначе
		Форма.Итоговая.Доступность(1);
		Форма.кОчиститьРодительскийДокумент.Доступность(0);
	КонецЕсли;

	Если ((РодительскийДокумент.Выбран() = 1) И (Найти("Счет,РасходнаяНакладная,ЛиквидацияНеоборАктивов,ОказаниеУслуг,РасходнаяРозничная",РодительскийДокумент.Вид()) > 0))
	Или ((ДокументОснование.Выбран() = 1) И (Найти("Счет,РасходнаяНакладная,ЛиквидацияНеоборАктивов,ОказаниеУслуг,РасходнаяРозничная",ДокументОснование.Вид()) > 0)) Тогда
		Форма.кЗаполнить.Доступность(1);
	Иначе
		Форма.кЗаполнить.Доступность(0);
	КонецЕсли;

	Если ЧтоПродаем=Перечисление.ЧтоПродаем.НеоборотныеАктивы Тогда
		Форма.Скидка.Доступность(0);
	ИначеЕсли глВосстановитьЗначение(,"ИспользоватьСкидку") = Да Тогда
		Форма.Скидка.Доступность(1);
	КонецЕсли;

	Если ВидНДС.Код = "БезНДС" Тогда
		Форма.ЛьготаНДС.Доступность(1);
		Форма.тЛьготаНДС.Доступность(1);
		Форма.КодЛьготы.Видимость(1);
	Иначе
		Форма.ЛьготаНДС.Доступность(0);
		Форма.тЛьготаНДС.Доступность(0);
		Форма.КодЛьготы.Видимость(0);
		Если (ПустоеЗначение(ЛьготаНДС) = 0) или (ПустоеЗначение(КодЛьготы) = 0) Тогда
			ЛьготаНДС = ПолучитьПустоеЗначение("Справочник.ШкалаСтавок");
			КодЛьготы = "";
		КонецЕсли;
	КонецЕсли;
	
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кПодбор.Доступность(0);
		Форма.кЗаполнить.Доступность(0);
		Форма.кВалюта.Доступность(0);
		Форма.кОснование.Доступность(0);
		Форма.кОчиститьРодительскийДокумент.Доступность(0);
		Форма.кФирма.Доступность(0);
		Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли; 

	РеализацияВУкраине = ?(ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине, 1, 0);
	ЭкспортнаяОперация = ?(ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт, 1, 0);
	РаботыОтНер		   = ?(ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента, 1, 0);
	НДС20              = ?(СокрЛП(ВидНДС.Код) = "НДС20", 1, 0);
	НДС7              = ?(СокрЛП(ВидНДС.Код) = "НДС7", 1, 0);
	
	Форма.ПродажаНижеОЦ.Доступность(Мин(РеализацияВУкраине, НДС20+НДС7, Мин(НоваяНакладная,1)));
	Форма.ОЦВключаетПроценты.Доступность(ПродажаНижеОЦ);
	Форма.ОбычнаяЦена.Видимость(ПродажаНижеОЦ);
	Форма.СуммаПревышения.Видимость(ПродажаНижеОЦ);
	Форма.НДСПревышения.Видимость(ПродажаНижеОЦ);
	
	Форма.ЕстьНулевыеСтавкиНДС.Доступность(Мин(Макс(РеализацияВУкраине, ЭкспортнаяОперация), НДС20, Мин(НоваяНакладная,1)));
	
	Форма.НулеваяСтавкаНДС.Видимость(ЕстьНулевыеСтавкиНДС);
	Форма.НадписьБазаНДС0.Видимость(ЕстьНулевыеСтавкиНДС);
	Форма.БазаНДС0.Видимость(ЕстьНулевыеСтавкиНДС);

	Если СпецРежимНалогообложения = 2 Тогда
	    Форма.КодВидаСХ.Видимость(1);
	Иначе
		Форма.КодВидаСХ.Видимость(0);
	КонецЕсли;
	
	Если ДатаДок >= '01/03/2014' Тогда 
		Форма.НомерГТД.Видимость(0);  
	Иначе	
		Форма.НомерГТД.Видимость(1);  
	КонецЕсли;	

	Если Форма.Закладки.ТекущаяСтрока() = 2 Тогда
		Форма.ГТД.Видимость(ЭкспортнаяОперация);
		Форма.НомГТД.Видимость(ГТД);
		Форма.тНомерГТД.Видимость(ГТД);
		Форма.ЭлектронныйГТД.Видимость(ГТД);
	
		Форма.Графа5.Доступность(КорГрафы5);
		Если ДатаДок >= '01/01/2015' Тогда  
			Форма.ТребуетВклВЕдРеестрНН.Доступность(0);
			Форма.ЭлектронныйДокумент.Доступность(0);
		Иначе	
			Форма.ТребуетВклВЕдРеестрНН.Доступность(Оставляем);
		КонецЕсли;	
	ИначеЕсли Форма.Закладки.ТекущаяСтрока() = 3 Тогда
		Форма.спТипПричины.Доступность(Оставляем);
		Если ДатаДок >= '01/04/2016' Тогда  
			Форма.ДипломатПредст.Видимость(0);
			Форма.УслугиДляНеХозДеят.Видимость(0);
		Иначе	
			Форма.ДипломатПредст.Видимость(1);
			Форма.ДипломатПредст.Доступность(1-Оставляем);
			Форма.УслугиДляНеХозДеят.Видимость(РаботыОтНер);
		КонецЕсли;	
		Если ДатаДок >= '01/03/2017' Тогда 
			Форма.спТекстДоп.Доступность(0);
			Форма.НомерОсновнойНН.Доступность(0);
		Иначе	
			Форма.спТекстДоп.Доступность(ПродажаНижеОЦ);
			Форма.НомерОсновнойНН.Доступность(ПродажаНижеОЦ);
		КонецЕсли;	
	КонецЕсли;
		
	Если ЕстьНулевыеСтавкиНДС = 1 Тогда
		Форма.НадписьБазаНДС.Заголовок("База НДС 20%:");
	Иначе	
		Форма.НадписьБазаНДС.Заголовок("База НДС (грн):"); 
	КонецЕсли;
	
	Если ОбновитьБазуНДС = 1 Тогда
		ОбновитьБазуНДС = 2;
	ИначеЕсли ОбновитьБазуНДС = 2 Тогда
		РассчитатьБазуНДС();
		ОбновитьБазуНДС = 0;
	КонецЕсли;

	Форма.ОперДата.Видимость(Итоговая);
	Форма.кРозница.Доступность(ИтоговаяРозница);
	Форма.кЭкспорт.Доступность(Проведен()*(1-Модифицированность()));
	Возврат "";
КонецФункции

// ===============================
Процедура ИзмИтоговаяРозница()
	Если ИтоговаяРозница = 0 Тогда
		глУстВидимостьЦен(Контекст);
	КонецЕсли;	
	ЗаполнитьГрафу5();
	ИзмОставляем();
КонецПроцедуры

// ===============================
Процедура ИзмЧтоПродаем()
	Если (КоличествоСтрок()<>0) и (СтарЧтоПродаем<>ЧтоПродаем) и (СокрЛП(СтарЧтоПродаем)<>"") Тогда
		Рез = Вопрос("Для изменения нужно очистить табличную часть. Удалить строки?","Да+Нет");
		Если Рез = "Да" Тогда
		    УдалитьСтроки();
		Иначе
			ЧтоПродаем = СтарЧтоПродаем;
		КонецЕсли;
	КонецЕсли;
	СтарЧтоПродаем = ЧтоПродаем;
КонецПроцедуры

// ===============================
Процедура ЗаполнитьПоУмолчанию()
	Валюта = Гривня;
	Дата_Курса = ДатаДок;
	Курс = глКурсДляВалюты(Валюта,Дата_Курса);
	Контрагент=глВосстановитьЗначение(,"ОсновнойПокупатель");
	ИзмКонтрагент();
	ВидНДС = глВосстановитьЗначение(,"БазНДС");
	ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ;
	Выписал = глВосстановитьЗначение(,"БазВыписалНН");
	СпособПодгонки = Перечисление.СпособыПодгонкиСумм.НеПодгонять;
	ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине;

	ГТД = 0;
	КорГрафы5 = 0;
КонецПроцедуры

// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
		глУстановитьНомер(Контекст);
		ЕРНН = 0;
	Иначе
		глУстановитьФирму(Контекст);
		глЗаполнитьШапку(Контекст);
		ЗаполнитьПоУмолчанию();
		ВидДоговора = "Договір поставки";   
	КонецЕсли;
	Если (ДатаДок >= '01.01.2015') Тогда
		ЭлектронныйДокумент = 1;
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ПриВводеСтроки()
	РассчитатьБазуНДС();
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
    // пустой договор должен строго иметь тип "Документ", важно для отчета АнализНДС
	Если ПустоеЗначение(Договор) = 1 Тогда
		Договор = ПолучитьПустоеЗначение("Документ");
	КонецЕсли;
	РассчитатьБазуНДС();
	Если ЕстьНулевыеСтавкиНДС = 0 Тогда
		БазаНДС0 = 0;
		ВыбратьСтроки();
		Пока ПолучитьСтроку() = 1 Цикл
			Если НулеваяСтавкаНДС = Да Тогда
				НулеваяСтавкаНДС = Нет;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ПродажаНижеОЦ = 0 Тогда
		ВыбратьСтроки();
		Пока ПолучитьСтроку() = 1 Цикл
			ОбычнаяЦена     = 0;
			СуммаПревышения = 0;
			НДСПревышения   = 0;
		КонецЦикла;
	КонецЕсли;
	ПроверкаТребуетВклВЕдРеестрНН();
КонецПроцедуры

// ===============================
Процедура Подбор()
	глПодбор(Контекст,"ТМЦ","ДляПодбора");
КонецПроцедуры

// ===============================
Процедура ОбработкаПодбора(Выб)
	глПриОбработкеПодбора(Выб,Контекст);
КонецПроцедуры

// ===============================
Процедура ВводНаОсновании(ДокОснование)
	
	Если (ДатаДок >= '01.01.2015') Тогда
		ЭлектронныйДокумент = 1;
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
	ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине;
	//условные продажи обработаем отдельно 
	Если ДокОснование.Вид() = "СписаниеТМЦ" Тогда	
		
		//условная продажа при списании на собственные нужды
		
		Если ДокОснование.НаСобственныеНужды = 0 Тогда
			Предупреждение("Выписать налоговую накладную можно только на основании списания на собственные нужды!");
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		Фирма = ДокОснование.Фирма;
		ДатаДок = ДокОснование.ДатаДок;
		Автор = глПользователь;
		Выписал = глВосстановитьЗначение(,"БазВыписалНН");
		ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ;
		СпособПодгонки = Перечисление.СпособыПодгонкиСумм.НеПодгонять;
		Валюта = Гривня;
		Курс = 1;
		ВидНДС = ДокОснование.ВидНДС;
		УсловиеПродажи = "Акт № "+ДокОснование.НомерДок+" вiд "+ДокОснование.ДатаДок; 
		ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.УсловнаяПродажа;
		
		Спр = СоздатьОбъект("Справочник.Контрагенты");
		Спр.НайтиПоНаименованию(Фирма.Наименование);
		Контрагент = Спр.ТекущийЭлемент();
			
		ДокОснование.ВыбратьСтроки();
		Пока ДокОснование.ПолучитьСтроку() = 1 Цикл
			НоваяСтрока();
			ТМЦ = ДокОснование.ТМЦ;
			КодУКТВЭД = ТМЦ.КодУКТВЭД;
			ЦенаБезНДС = ДокОснование.ЦенаБезНДС;
			ЦенаСНДС = ЦенаБезНДС+ЦенаБезНДС*ВидНДС.Ставка.Получить(ДатаДок);
			СуммаБезНДС = ДокОснование.СуммаБезНДС;
			НДС = ДокОснование.НДС;
			СуммаСНДС = ДокОснование.СуммаСНДС;
			Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
				СуммаБезСкидки = СуммаСНДС;
			Иначе
				СуммаБезСкидки = СуммаБезНДС;
			КонецЕсли;	
			Кво = ДокОснование.Кво;
			Ед = ДокОснование.Ед;
			Коэффициент = ДокОснование.Коэффициент;
		КонецЦикла; 
		
		СуммаНДС = Итог("НДС");
		БазаНДС  = Итог("СуммаБезНДС");
		
		РодительскийДокумент = ДокОснование;
		
		глУстановитьНомер(Контекст);
		
		Возврат;
		
	ИначеЕсли ДокОснование.Вид() = "ЛиквидацияНеоборАктивов" Тогда		
		Если (ДокОснование.ВидЛиквидации = Перечисление.ВидыЛиквидацииНеоборАктивов.Списание) И
		     (ДокОснование.ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ПоРешениюНалогоплательщикаИлиКМУ) Тогда
		     
			 //условная продажа при ликвидации по решению налогоплательщика
			Фирма = ДокОснование.Фирма;
			ДатаДок = ДокОснование.ДатаДок;
			Автор = глПользователь;
			Выписал = глВосстановитьЗначение(,"БазВыписалНН");
			ЧтоПродаем = Перечисление.ЧтоПродаем.НеоборотныеАктивы;
			СпособПодгонки = Перечисление.СпособыПодгонкиСумм.НеПодгонять;
			Валюта = Гривня;
			Курс = 1;
			ВидНДС = ДокОснование.ВидНДС;
			УсловиеПродажи = "Акт № "+ДокОснование.НомерДок+" вiд "+ДокОснование.ДатаДок;
			ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.УсловнаяПродажа;
			
			Спр = СоздатьОбъект("Справочник.Контрагенты");
			Спр.НайтиПоНаименованию(Фирма.Наименование);
			Контрагент = Спр.ТекущийЭлемент();
			
			
			ДокОснование.ВыбратьСтроки();
			Пока ДокОснование.ПолучитьСтроку() = 1 Цикл
				НоваяСтрока();
				ОстСтоимость = ДокОснование.ПервСтоимость - ДокОснование.Износ;
				ТМЦ = ДокОснование.НеоборотныйАктив;
				СуммаБезНДС = ОстСтоимость;
				ЦенаБезНДС = СуммаБезНДС;
				НДС = ОстСтоимость * ВидНДС.Ставка.Получить(ДатаДок);
				СуммаСНДС = СуммаБезНДС+НДС;
				ЦенаСНДС = СуммаСНДС;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
				СуммаБезСкидки = СуммаСНДС;
				Иначе
					СуммаБезСкидки = СуммаБезНДС;
				КонецЕсли;	
				Кво = 1;
				глУстановкаБазЕд(Контекст,,ТМЦ.БазЕдиница);
			КонецЦикла; 
			
			СуммаНДС = Итог("НДС");
			БазаНДС  = Итог("СуммаБезНДС");
			
			РодительскийДокумент = ДокОснование;
			
			глУстановитьНомер(Контекст);
			
			Возврат;
		
		КонецЕсли;
	ИначеЕсли (ДокОснование.Вид() = "УслугиСтороннихОрганизаций") или (ДокОснование.Вид() = "УслугиСтороннихОрганизацийПроизвХарактера") Тогда		
		Если ДокОснование.Контрагент.ВидКонтрагента <> Перечисление.ВидыКонтрагентов.Нерезидент Тогда
			 Сообщить("Налоговую накладную можно выписывать только на основании услуг, полученных от нерезидента!");
			 СтатусВозврата(0);
			 Возврат;
		КонецЕсли;

		//услуги, полученные от нерезидента
		
		НДС20 = 0;
		Ставка = 0;
		Если глПолучитьНиО(НДС20,"НДС20","о ставке НДС 20%") = 1 Тогда
			ВидНДС = НДС20;
			Ставка = НДС20.Ставка.Получить(ДатаДок);
		Иначе
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		
		Если ДокОснование.ВидНДС = НДС20 Тогда
			Предупреждение("Выписать налоговую накладную можно только"
			                + " на основании услуг сторонних организаций с видом НДС, отличным от """ + НДС20 + """!");
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		
		Фирма = ДокОснование.Фирма;
		ДатаДок = ДокОснование.ДатаДок;
		Контрагент = ДокОснование.Контрагент;
		СчетКонтрагента = ДокОснование.СчетКонтрагента;
		ДокументОснование = ДокОснование.ДокументОснование;
		Если ДокументОснование.Выбран() = 0 Тогда
		    ДокументОснование = ДокОснование;
		КонецЕсли;
		ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента;
		Автор = глПользователь;
		Выписал = глВосстановитьЗначение(,"БазВыписалНН");
		ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ;
		СпособПодгонки = Перечисление.СпособыПодгонкиСумм.НеПодгонять;
		ВидТорговли = ДокОснование.ВидТорговли;
		Валюта = ДокОснование.Валюта;
		Курс = ДокОснование.Курс;
		Дата_Курса = ДокОснование.Дата_Курса;
		УсловиеПродажи = "Акт № "+ ДокументОснование.НомерАктаВыполненныхРабот + " вiд " + ДокОснование.ДатаДок;
		ИзмВидТорговли();
		ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента;
		
		ДокОснование.ВыбратьСтроки();
		Пока ДокОснование.ПолучитьСтроку() = 1 Цикл
			НоваяСтрока();
			ТМЦ = ДокОснование.Услуга;
			КодУКТВЭД = ТМЦ.КодУКТВЭД;
			Кво = ДокОснование.Кво;
			Ед = ДокОснование.Ед;
			Коэффициент = ДокОснование.Коэффициент;
			ЦенаБезНДС = ДокОснование.ЦенаБезНДС;
			глВыч_Суммы_Накл(Контекст,-1);
		КонецЦикла; 
		
		СуммаНДС = Итог("НДС");
		БазаНДС  = Итог("СуммаБезНДС");
		
		РодительскийДокумент = ДокОснование;
		
		глУстановитьНомер(Контекст);
		
		Возврат; 
		
	КонецЕсли;
	ВидДоговора = "Договір поставки";   
	Если Договор.Вид() = "Договор" Тогда
		ДатаДог = Договор.ДатаДок;
		НомДог = Договор.НомерДок; 
		ВидДоговора = Договор.ВидДоговора;
	Иначе
		ДогКонтр = Контрагент.БазДоговор;
		Если (ПустоеЗначение(ДогКонтр) = 0) Тогда
			НомДог = ДогКонтр.НомерДоговора;
			ДатаДог  = ДогКонтр.ДатаДок; 
			ВидДоговора = ДогКонтр.ВидДоговора;
		КонецЕсли;
	КонецЕсли;
	
	Параметр = СоздатьОбъект("СписокЗначений");
	Параметр.ДобавитьЗначение(ДокОснование,"ДокументОснование");
	Параметр.ДобавитьЗначение(Контекст,"Контекст");
	ОткрытьФормуМодально("Обработка.ФормированиеНалоговыхДокументов#",Параметр);
	СтатусВозврата(Параметр.Получить("СтатусВозврата"));
	РассчитатьБазуНДС();
КонецПроцедуры

// ===============================
Процедура ПриВыбореЗакладки(Номер,Значение)
	Форма.ИспользоватьСлой("Общий,"+Значение);
	Если Значение = "Основной" Тогда
		Если Константа.ИспользоватьСкидку <> Да Тогда
			Форма.СуммаБезСкидки.Видимость(0);
			Форма.Скидка.Видимость(0);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
                                
//============================
Функция ПолучитьЛьготу(ТекТМЦ = "")
	Если ПустоеЗначение(ЛьготаНДС) = 0 Тогда
		Льгота = ЛьготаНДС.Наименование;
		ЛьготаКод = КодЛьготы;
	ИначеЕсли ТекТМЦ.Вид() = "ТМЦ" Тогда   
		Льгота = ТекТМЦ.ЛьготаНДС.Наименование;
		ЛьготаКод = ТекТМЦ.КодЛьготы;
	КонецЕсли;
	Если ПустоеЗначение(ЛьготаКод) = 1 Тогда
		ЛьготаКод = "99999999";
	КонецЕсли;
	
	Поз = Найти(Льгота, "(");
	Если Поз>0 Тогда
		Льгота = Лев(Льгота, Поз-1)
	КонецЕсли;
	
	Возврат Льгота;		
КонецФункции

// ===============================
Функция СуммаДляПечати(Сумма)
	Если Валюта = Гривня  Тогда
		СуммаПеч = СокрЛ(Формат(Сумма,"Ч017.2."))
	Иначе
		СуммаПеч = СокрЛ(Формат(глПересчет(Сумма,Валюта,Гривня,Курс,ДатаДок),"Ч017.2."))
	КонецЕсли;
	Возврат СуммаПеч
КонецФункции

// ===============================
Процедура ЗаполнитьСкидкуНадбавку(Сумма, Скидка, Надбавка)
	Если Сумма < 0 Тогда
		Надбавка = Надбавка - Сумма;
	Иначе
		Скидка = Скидка + Сумма;
	КонецЕсли;
КонецПроцедуры
// ===============================
Функция ДатаДляПечати(ДатаД)
	Возврат Формат(ДатаЧисло(ДатаД),"Ч(0)2")+Формат(ДатаМесяц(ДатаД),"Ч(0)2")+Строка(ДатаГод(ДатаД))
КонецФункции
//============================
Процедура Печать2016()
Перем ПечИтогСНДС, ПечИтогНДС, ПечИтогНДС20, ПечИтогНДС7, НомСтр, буфКодУКТВЭД;
Перем ТипФормы, ПечИтогБезНДС20, ПечИтогБезНДС7,ПечИтогБезНДС01,ПечИтогБезНДС02, ПечИтогБезНДС03, ПечВозвТара; 

	НеДополнятьНазваниеНомеромГТД = Да; 

	ТипыФорм = СоздатьОбъект("СписокЗначений");
	ТипыФорм.ДобавитьЗначение(1,"Налоговая накладная");
	ТипыФорм.ДобавитьЗначение(2,"Налоговая накладная (альбом.ориент.)");
	Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
		Возврат;
	КонецЕсли;          
	Если ДатаДок >= '01/03/2017' Тогда  
		Суффикс = "_2017"; 
		Если ТипФормы = 2 Тогда
			Суффикс = "_17"; 
		КонецЕсли;
	Иначе	
		Суффикс = "_2016"; 
		Если ТипФормы = 2 Тогда
			Суффикс = "_16"; 
		КонецЕсли;
	КонецЕсли;
	ПечататьДатыСРазделителями = Нет;
	ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия); 
	СотрИНН = Выписал.ИНН; 
	
	Таб = СоздатьОбъект( "Таблица" );
	ИмяФайлаПечатнойФормы = КаталогИБ()+"ExtForms\PrnForms\NN"+Суффикс+".mxl";
	Если ФС.СуществуетФайл(ИмяФайлаПечатнойФормы) = 1 Тогда
		Таб.ИсходнаяТаблица(ИмяФайлаПечатнойФормы);
	Иначе
		Таб.ИсходнаяТаблица("НДС"+Суффикс);
	КонецЕсли;
	Если ТипФормы = 2 Тогда
		Таб.ПараметрыСтраницы(2); //ландшафт
	Иначе
		Таб.ПараметрыСтраницы(1); //портрет
	КонецЕсли;
	  
	НомерДокумента = глНомерБезПрефикса(НомерДок); 
	НомерДокумента = Прав("      "+НомерДокумента,7); 
	ПечСпецРежимНалогообложения = ?(СоглашениеОРазделеПродукции = 1,5,СпецРежимНалогообложения);
	
	ТипПричиныПеч = ""; ТипПричиныИнд = 0;
	Если Оставляем = 1 Тогда
		ТипПричиныИнд = спТипПричины.НайтиЗначение(СокрЛП(ТипПричины));
		Если (ТипПричиныИнд <> 0) Тогда
			ТипПричиныПеч = Сред(ТипПричины,2,2);
		КонецЕсли;
	КонецЕсли;
	
	ФирмаПолнНаименование = Фирма.ПолнНаименование;
	ФирмаНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
	КонтрагентПолнНаименование = ?(КорГрафы5 = 1,Графа5,Контрагент.ПолнНаименование); 
	КонтрагентКодФил = ?(Контрагент.КодФилиала = 0,"",Прав("    "+СокрЛП(Контрагент.КодФилиала),4));
	
	Сводная = 0;  
	Если (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
		//тип причины: 14
		ФирмаПолнНаименование = СокрЛП(?(КорГрафы5 = 1,Графа5,Контрагент.ПолнНаименование))+ ", " + СокрЛП(Контрагент.Регион);        
		ФирмаНалогНомер = "500000000000";
		КонтрагентПолнНаименование = Фирма.ПолнНаименование;
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 12) Тогда
		//Дипломатическое представительство, тип причины 12 
		КонтрагентНалогНомер = "200000000000";
		
	ИначеЕсли (ТипПричиныИнд = 2) или (ТипПричиныИнд = 11) или (ТипПричиныИнд = 1) Тогда
		//тип причины: 02, 11, 01
		КонтрагентПолнНаименование = "Неплатник";
		КонтрагентНалогНомер = "100000000000";
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 7) Тогда
		//тип причины: 07, Экспорт
		КонтрагентПолнНаименование = СокрЛП(КонтрагентПолнНаименование) + ", " + СокрЛП(Контрагент.Регион);
		КонтрагентНалогНомер = "300000000000";
		
	ИначеЕсли (ТипПричиныИнд = 10) Тогда
		//тип причины: 10
		КонтрагентНалогНомер = ?(ДатаДок >= '01/03/2017',"600000000000","400000000000");
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 15) Тогда
		//тип причины: 15
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 4) или (ТипПричиныИнд = 8) или (ТипПричиныИнд = 9) или (ТипПричиныИнд = 13) Тогда
		//тип причины: 04, 08, 09, 13  Зведена
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентНалогНомер = "600000000000";
		ПечСводная = "X";  
		Сводная = 1;  
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд > 2) Тогда
		//тип причины: 03, 05, 06
		КонтрагентНалогНомер = "400000000000";
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	Иначе
		КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, "100000000000",  Прав("           " + СокрЛП(Контрагент.ИНН),12));
	КонецЕсли;
	
	ТекстДополненияГр3 = ?(СоглашениеОРазделеПродукции = 1," розподіл сум податкового кредиту за багатосторонньою угодою про розподіл продукції","");
	
	ПечОсвоб = ""; ПечСтавка = "";
	Если (Сводная = 0) и (СоглашениеОРазделеПродукции = 0) Тогда
		Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
			ПечСтавка = "903";
			ПечОсвоб = "Без ПДВ";
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС20") Тогда	
			ПечСтавка = "20";
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") Тогда	
			ПечСтавка = "7";
		ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС0") Тогда	
			ПечСтавка = ?(ТипПричиныИнд = 7,"901","902");
		КонецЕсли;	
	КонецЕсли;	
	ПечСводная = ?(Итоговая = 1,"X",ПечСводная);  

	ДопКолонка = ?(ЕстьНулевыеСтавкиНДС = 1, "НулеваяСтавкаНДС,","");
	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));
    

	НомСтр = 1;
	Если (ПродажаНижеОЦ=0) Тогда // обычная НН
		ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
		ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
		ТаблТМЦ.Свернуть(ДопКолонка + "ТМЦ,"+
	  			?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
	  			",Ед,Коэффициент,ОперДата,КодУКТВЭД,НомерГТД,КодВидаСХ","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");

	  	ОстаетсяПеч = ?(Оставляем = 1, "Х","");  
			
		Таб.ВывестиСекцию( "Оригинал" );
		
		ПечИтогСНДС = СуммаДляПечати(Итог("СуммаСНДС"));
		ПечИтогНДС = СуммаДляПечати(Итог("НДС"));
		ПечВозвТара = СуммаДляПечати(СуммаВозвратнойТары);
		ПечИтогБезНДС = ""; ПечИтогБезНДС03 = ""; ПечИтогБезНДС02 = "";
		ПечИтогБезНДС02 = ""; ПечИтогБезНДС20 = ""; ПечИтогНДС20 = ""; 
		ПечИтогБезНДС7 = ""; ПечИтогНДС7 = ""; ПечИтогБезНДС01 = "";  
		Если СоглашениеОРазделеПродукции = 0 Тогда
			ИтогСуммаБезНДС = Итог("СуммаБезНДС");
			ПечИтогБезНДС = СуммаДляПечати(ИтогСуммаБезНДС);
			Если (Сокрлп(ВидНДС.Код) = "БезНДС") и (Сводная = 0) Тогда	
				ПечИтогБезНДС03 = ПечИтогБезНДС;
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС20") Тогда	
				Если ТипПричиныИнд = 7 Тогда
					ПечИтогБезНДС01 =  СокрЛ(Формат(Итог("БазаНДС0"),"Ч017.2."));
				Иначе	
					ПечИтогБезНДС02 =  СокрЛ(Формат(Итог("БазаНДС0"),"Ч017.2."));
				КонецЕсли;
				ПечИтогБезНДС20 = СокрЛ(Формат(глПересчет(ИтогСуммаБезНДС,Валюта,Гривня,Курс,ДатаДок)-Итог("БазаНДС0"),"Ч017.2."));
				ПечИтогНДС20 = ПечИтогНДС;
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") Тогда	
				ПечИтогБезНДС7 = ПечИтогБезНДС;
				ПечИтогНДС7 = ПечИтогНДС;
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС0") и (Сводная = 0) Тогда
				Если ТипПричиныИнд = 7 Тогда
					ПечИтогБезНДС01 = ПечИтогБезНДС;
				Иначе	
					ПечИтогБезНДС02 = ПечИтогБезНДС;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		
		Таб.ВывестиСекцию( "Шапка" );
		
		ИтогПоЛьготам = "";
		ПечСтавка1 = ПечСтавка;
		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл  
			Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
				СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ);
				Если ЛьготаКод = "99999999" Тогда
					Если ИтогПоЛьготам = "" Тогда
						ИтогПоЛьготам = СтатьяЛьготы;
					ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
						ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
				//дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			ЕдИзм = ""; ПечЦенаБезНДС = ""; КодЕдИзм = ""; 
			ПечСуммаБезНДС = ""; ПечКво = "";
			Если (ТаблТМЦ.Кво <> 0) и (ТаблТМЦ.Скидка <> 0) Тогда
				//будем пересчитывать цену только при наличии скидки
				ТекЦенаБезНДС = ТаблТМЦ.СуммаБезНДС/ (ТаблТМЦ.Кво);
			ИначеЕсли Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда 
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * ?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
				Иначе
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС; 
				КонецЕсли;
			Иначе
				ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
			КонецЕсли;
			КодДляНН = ТаблТМЦ.КодУКТВЭД;
			ВидКода = КодДляНН.Вид;
			буфКодУКТВЭД = ?(ВидКода <> Перечисление.ВидыКодовДляНН.Услуга,СтрЗаменить(КодДляНН,".",""),""); 
			ПрИмп = ?(ВидКода = Перечисление.ВидыКодовДляНН.ИмпортированныйТовар,"X",""); 
			буфКодДКПП = ?(ВидКода = Перечисление.ВидыКодовДляНН.Услуга,КодДляНН,"");
			КодСХ = ?(СпецРежимНалогообложения = 2, ТаблТМЦ.КодВидаСХ, "");
			Если СоглашениеОРазделеПродукции = 0 Тогда
				Если Сводная = 1 Тогда
					ЕдИзм = "грн";
					ЛьготаКод = ""; ИтогПоЛьготам = "";
				Иначе	
					ПечКво = ТаблТМЦ.Кво;
					ПечЦенаБезНДС = СуммаДляПечати(ТекЦенаБезНДС);
					Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда 
						ЕдИзм = ТаблТМЦ.Ед.Единица;
						КодЕдИзм = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
					Иначе
						ЕдИзм = "шт";
						КодЕдИзм = "2009";
					КонецЕсли;
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда 
							Если ТипПричиныИнд = 7 Тогда
								ПечСтавка = "901";
							Иначе	
								ПечСтавка = "902";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли; 
				ПечСуммаБезНДС = СуммаДляПечати(ТаблТМЦ.СуммаБезНДС);
			Иначе //СоглашениеОРазделеПродукции = 1	
				ЛьготаКод = ""; ИтогПоЛьготам = "";
			КонецЕсли;
			
			Таб.ВывестиСекцию("СтрокаТаблицы");
			НомСтр = НомСтр+1;
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда   //вернем ставку
				ПечСтавка = ПечСтавка1;
			КонецЕсли;

		КонецЦикла;
		
		Таб.ВывестиСекцию( "Подвал" );
		
	КонецЕсли;
    
	Если (ПродажаНижеОЦ=1) Тогда
		
		Таб.НоваяСтраница();
		
		ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
		ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
		
		ИтСумБНДС = Итог("СуммаБезНДС");
		
		Если ДатаДок >= '01/03/2017' Тогда
			ТекстДополненияГр3 = " (" + СокрЛП(ТекстДоп) + ")";
		Иначе	
			ТекстДополненияГр3 = " (" + СокрЛП(ТекстДоп) + " в податковій накладній №" + СокрЛП(НомерОсновнойНН);
			ТекстДополненияГр3 = ТекстДополненияГр3 + ?((ОЦВключаетПроценты=1) и (ИтСумБНДС <> 0),", сума процентів, нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
		КонецЕсли;	
		ТипПричиныПеч = Сред(ТипПричины,2,2);
		
		НомерДокумента = Строка(НомерДокумента);
		КонтрагентПолнНаименование = Фирма.ПолнНаименование;
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
	
		ОстаетсяПеч = "Х";
		Таб.ВывестиСекцию( "Оригинал" );
		ИтогСуммаБезНДС = Итог("СуммаПревышения");
		//ПечИтогБезНДС20 = СуммаДляПечати(ИтогСуммаБезНДС);
		
		ПечИтогНДС = СуммаДляПечати(Итог("НДСПревышения"));
		ПечИтогСНДС = СуммаДляПечати(ИтогСуммаБезНДС + Итог("НДСПревышения"));
		ПечВозвТара = СуммаДляПечати(СуммаВозвратнойТары);
		Если СоглашениеОРазделеПродукции = 0 Тогда
			ИтогСуммаБезНДС = Итог("СуммаПревышения");
			ПечИтогБезНДС = СуммаДляПечати(ИтогСуммаБезНДС);
			Если (Сокрлп(ВидНДС.Код) = "НДС20") Тогда	
				ПечИтогБезНДС20 = ПечИтогБезНДС;
				ПечИтогНДС20 = ПечИтогНДС;
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") Тогда	
				ПечИтогБезНДС7 = ПечИтогБезНДС;
				ПечИтогНДС7 = ПечИтогНДС;
			КонецЕсли;	
		КонецЕсли;	
		Таб.ВывестиСекцию( "Шапка" ); 
		
		ЛьготаКод = "";
		ПечСтавка1 = ПечСтавка;
		ИтогПоЛьготам = ""; 

		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
				//дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			Если ТаблТМЦ.СуммаПревышения > 0 Тогда
				ЕдИзм = ""; ПечЦенаБезНДС = ""; КодЕдИзм = ""; ПечСуммаБезНДС = "";
				Если СоглашениеОРазделеПродукции = 0 Тогда
					буфКодУКТВЭД = ?(ДатаДок >= '01/03/2017',"",СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",""));
					Если Сводная = 1 Тогда
						ЕдИзм = "грн";
					Иначе	
						Если ДатаДок < '01/03/2017' Тогда
							Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
								ЕдИзм = ТаблТМЦ.Ед.Единица;
								КодЕдИзм = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
							Иначе
								ЕдИзм = "шт";
								КодЕдИзм = "2009";
							КонецЕсли;	
						КонецЕсли;	
						ПечКво = ТаблТМЦ.Кво;
						ПечЦенаБезНДС = ?((ТаблТМЦ.Кво=0), "", СуммаДляПечати(ТаблТМЦ.СуммаПревышения/ТаблТМЦ.Кво));
					КонецЕсли;
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда 
							Если ТипПричиныИнд = 7 Тогда
								ПечСтавка = "901";
							Иначе	
								ПечСтавка = "902";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					ПечСуммаБезНДС = СуммаДляПечати(ТаблТМЦ.СуммаПревышения)
				Иначе //СоглашениеОРазделеПродукции = 1	
					ЛьготаКод = ""; ИтогПоЛьготам = "";
				КонецЕсли;
				Таб.ВывестиСекцию("СтрокаТаблицы");
				НомСтр = НомСтр+1;
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда   //вернем ставку
					ПечСтавка = ПечСтавка1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Таб.ВывестиСекцию( "Подвал" );
			
	КонецЕсли;	
	Если НомСтр > 9999 Тогда
		Сообщить("Документ должен содержать не более 9999 строк.В данном документе ограничение превышено.","!");
	КонецЕсли;
	
	Таб.Опции(0, 0, 0, 0, "НН");
	Если ТипФормы = 1 Тогда
		Таб.ПараметрыСтраницы(1,,,,,,,,);
	Иначе	
		Таб.ПараметрыСтраницы(2,,,,,,,,);
	КонецЕсли;
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Печать налоговой накладной","");
КонецПроцедуры

//============================
Процедура Печать2011()
Перем ПечЦенаБезНДС, ПечСуммаБезСкидки, ПечСуммаБезТранс, ПечВозвТара,
	ПечИтогСуммаБезНДС, ПечИтогНДС, ПечВсего, Ст[5], Ск[5], ТипФормы;
    
	НеДополнятьНазваниеНомеромГТД = Да; 
	ПечКодУКТВЭДбезПробелов = 1;
	ПустойИНН = ?(ДатаДок >= '01/03/2014',"400000000000","           0");

	Если ДатаДок >= '01/01/2015' Тогда
		Суффикс = "_2015"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Налоговая накладная");
		ТипыФорм.ДобавитьЗначение(2,"Налоговая накладная (альбом.ориент.)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_15"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Нет;
		ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия); 
	
	ИначеЕсли ДатаДок >= '01/12/2014' Тогда
		Суффикс = "201412"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Налоговая накладная");
		ТипыФорм.ДобавитьЗначение(2,"Налоговая накладная (альбом.ориент.)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_1412"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Нет;
		Если (Модифицированность() = 1) или (Проведен()=0) Тогда
			ПроверкаТребуетВклВЕдРеестрНН(); 
		КонецЕсли;
		ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия); 
	
	ИначеЕсли ДатаДок >= '01/03/2014' Тогда
		Суффикс = "_2014"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Налоговая накладная");
		ТипыФорм.ДобавитьЗначение(2,"Налоговая накладная (альбом.ориент.)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_14"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Нет;  
		Если (Модифицированность() = 1) или (Проведен()=0) Тогда
			ПроверкаТребуетВклВЕдРеестрНН(); 
		КонецЕсли;
		ПечВыписал = Сред(Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(Выписал.Отчество) = 1,"",Сред(Выписал.Отчество,1,1)) + "." + " " + Сокрлп(Выписал.Фамилия);
	ИначеЕсли ДатаДок >= Константа.ДатаННДек2011 Тогда
		Суффикс = "_2012"; 
		ТипыФорм = СоздатьОбъект("СписокЗначений");
		ТипыФорм.ДобавитьЗначение(1,"Налоговая накладная");
		ТипыФорм.ДобавитьЗначение(2,"Налоговая накладная (альбом.ориент.)");
		Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Выберите тип формы",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;          
		Если ТипФормы = 2 Тогда
			Суффикс = "_12"; 
		КонецЕсли;
		ПечататьДатыСРазделителями = Константа.ПечататьДатыВННСРазд;
		НеДополнятьНазваниеНомеромГТД = Константа.НеДополнНаимНомГТДВНН; 
		ПроверкаТребуетВклВЕдРеестрНН();
		ПечКодУКТВЭДбезПробелов = Константа.ПечататьКодУКТВЭДбезПробелов;
	Иначе	
		Суффикс = "_2011";
		ТипФормы = 1;
		ПечататьДатыСРазделителями = Да;
		НеДополнятьНазваниеНомеромГТД = Да; 
	КонецЕсли;
	
	Таб = СоздатьОбъект( "Таблица" );
	ИмяФайлаПечатнойФормы = КаталогИБ()+"ExtForms\PrnForms\NN"+Суффикс+".mxl";
	Если ФС.СуществуетФайл(ИмяФайлаПечатнойФормы) = 1 Тогда
		Таб.ИсходнаяТаблица(ИмяФайлаПечатнойФормы);
	Иначе
		Таб.ИсходнаяТаблица("НДС"+Суффикс);
	КонецЕсли;
	Если ТипФормы = 2 Тогда
		Таб.ПараметрыСтраницы(2); //ландшафт
	Иначе
		Таб.ПараметрыСтраницы(1); //портрет
	КонецЕсли;

	НомерДокумента = глНомерБезПрефикса(НомерДок);
	НомерДокумента = Прав("      "+НомерДокумента,7); 
	
	ТипПричиныПеч = ""; ТипПричиныИнд = 0;
	Если Оставляем = 1 Тогда
		ТипПричиныИнд = спТипПричины.НайтиЗначение(СокрЛП(ТипПричины));
		Если ТипПричиныИнд <> 0 Тогда
			ТипПричиныПеч = Сред(ТипПричины,2,2);
		КонецЕсли;
	КонецЕсли;
	
	ФирмаПолнНаименование = Фирма.ПолнНаименование;
	ФирмаАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
	ФирмаТел = Фирма.Телефоны.Получить(ДатаДок);
	Если Найти(ФирмаТел,",") <> 0 Тогда
		ФирмаТел = Лев(ФирмаТел,Найти(ФирмаТел,",")-1);
	ИначеЕсли Найти(ФирмаТел,";") <> 0 Тогда	
		ФирмаТел = Лев(ФирмаТел,Найти(ФирмаТел,";")-1);  
	КонецЕсли;
	ФирмаТел = СтрЗаменить(ФирмаТел,"-","");
	ФирмаТел = СтрЗаменить(ФирмаТел," ","");
	ФирмаТел = СтрЗаменить(ФирмаТел,")","");
	ФирмаТел = СтрЗаменить(ФирмаТел,"(","");
	ФирмаТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
	ФирмаНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
	ФирмаНомСвид = Прав("         " + СокрЛП(Фирма.НомерСвидетельства),10);
	КонтрагентПолнНаименование = ?(КорГрафы5 = 1,Графа5,Контрагент.ПолнНаименование);
	КонтрагентАдрес = Контрагент.ЮридическийАдрес;
	Если Найти(Контрагент.Телефоны,",") <> 0 Тогда
		КонтрТел = Лев(Контрагент.Телефоны,Найти(Контрагент.Телефоны,",")-1);
	ИначеЕсли Найти(Контрагент.Телефоны,";") <> 0 Тогда	
		КонтрТел = Лев(Контрагент.Телефоны,Найти(Контрагент.Телефоны,";")-1);  
	Иначе	
		КонтрТел = Контрагент.Телефоны;  
	КонецЕсли;
	КонтрТел = СтрЗаменить(КонтрТел,"-","");
	КонтрТел = СтрЗаменить(КонтрТел," ","");
	КонтрТел = СтрЗаменить(КонтрТел,")","");
	КонтрТел = СтрЗаменить(КонтрТел,"(","");
	КонтрагентТелефоны = Прав("         " + СокрЛП(КонтрТел),10);

	КолСтр = ?(ДатаДок >= '01/01/2015',1,2);
	Если (ДатаДок < '01/12/2014')  Тогда 
		Если (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента)  Тогда 
			ФирмаПолнНаименование = ?(КорГрафы5 = 1,Графа5,Контрагент.ПолнНаименование);        
			ФирмаАдрес = КонтрагентАдрес;
			ФирмаТелефоны = КонтрагентТелефоны;
			Если ДатаДок >= Константа.ДатаННДек2011 Тогда
				Если УслугиДляНеХозДеят = 1 Тогда
					ФирмаНалогНомер = "200000000000";
				Иначе	
					ФирмаНалогНомер = "300000000000";
				КонецЕсли;
				КолСтр = 1;
			КонецЕсли;
			ФирмаНомСвид    = "         0";  
			
			КонтрагентПолнНаименование = Фирма.ПолнНаименование;
			КонтрагентАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
			КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
			КонтрагентНомСвид = Прав("         " + СокрЛП(Фирма.НомерСвидетельства),10);
		ИначеЕсли (ТипПричиныИнд < 7) и (ТипПричиныИнд > 0) Тогда
		 	//тип причины: 02, 03, 07, 04, 05, 06
			КонтрагентНалогНомер = ПустойИНН;
			КонтрагентНомСвид    = "         0";
		Иначе
			КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,  Прав("           " + СокрЛП(Контрагент.ИНН),12));
			КонтрагентНомСвид = ?(ПустоеЗначение(Контрагент.НомерСвидетельства)=1,  "         0", Прав("         " + СокрЛП(Контрагент.НомерСвидетельства),10));
		КонецЕсли;
	Иначе
		Если (ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
			ФирмаПолнНаименование = ?(КорГрафы5 = 1,Графа5,Контрагент.ПолнНаименование);        
			ФирмаАдрес = СокрЛП(Контрагент.Регион);;
			ФирмаТелефоны = "         ";
			Если УслугиДляНеХозДеят = 1 Тогда
				ФирмаНалогНомер = "200000000000";
			Иначе	
				ФирмаНалогНомер = ?(ДатаДок >= '01/01/2015', "500000000000", "300000000000");
			КонецЕсли;
			КолСтр = 1;
			КонтрагентПолнНаименование = Фирма.ПолнНаименование;
			КонтрагентАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);;
			КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);

		ИначеЕсли (ДипломатПредст = 1) Тогда
		 	//Дипломатическое представительство
			КонтрагентПолнНаименование = ФирмаПолнНаименование;
			КонтрагентНалогНомер = ПустойИНН;
			КонтрагентАдрес = ФирмаАдрес;
			КонтрагентТелефоны = "         ";
	
		ИначеЕсли (ТипПричиныИнд = 1) или (ТипПричиныИнд = 10) Тогда
		 	//тип причины: 02, 11
			КонтрагентПолнНаименование = "Неплатник";
			КонтрагентНалогНомер = ?(ДатаДок >= '01/01/2015', "100000000000", ПустойИНН);
			КонтрагентАдрес = "";
			КонтрагентТелефоны = "         ";
		
		ИначеЕсли (ТипПричиныИнд = 6) Тогда
		 	//тип причины: 07, Экспорт
			КонтрагентНалогНомер = "300000000000";
			КонтрагентАдрес = СокрЛП(Контрагент.Регион);
			КонтрагентТелефоны = "         ";
	
		ИначеЕсли (ТипПричиныИнд > 1) Тогда
		 	//тип причины: 03, 04, 05, 06, 08, 09, 10, 13
			КонтрагентНалогНомер = ПустойИНН;
			КонтрагентПолнНаименование = ФирмаПолнНаименование;
			КонтрагентАдрес = ФирмаАдрес;
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
	
		Иначе
			КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,  Прав("           " + СокрЛП(Контрагент.ИНН),12));
			Если (ПустоеЗначение(Контрагент.ИНН)=1) Тогда 
				//данные покупателя не заполняем
				КонтрагентАдрес = "";
				КонтрагентТелефоны = "         ";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПустаяЯчейка = ?(ДатаДок < '01/12/2014',Константа.ПустаяЯчейкаНалДок + Симв(160),Симв(160));
	ВидНомДогов = Константа.ВидНомДоговНН;
	ТекстДополненияГр3 = "";
	
	Если Сокрлп(ВидНДС.Код) = "БезНДС" Тогда
		ТекущийСтолбец = 4
	ИначеЕсли Сокрлп(ВидНДС.Код) = "НДС0" Тогда
		Если ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			ТекущийСтолбец = 3
		Иначе
			ТекущийСтолбец = 2
		КонецЕсли;
	ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") и (ДатаДок >= '01/12/2014') Тогда
		ТекущийСтолбец = 5
	ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7")  Тогда
		ТекущийСтолбец = 2
	Иначе
		ТекущийСтолбец = 1;
		Если ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			НулевойСтолбец = 3
		Иначе
			НулевойСтолбец = 2
		КонецЕсли;
	КонецЕсли;
	
	ДопКолонка = ?(ЕстьНулевыеСтавкиНДС = 1, "НулеваяСтавкаНДС,","");
    
	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));
	
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	ТаблТМЦ.Свернуть(ДопКолонка + "ТМЦ,"+
  			?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
  			",Ед,Коэффициент,ОперДата,КодУКТВЭД,НомерГТД","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");
  			
	Если (ПродажаНижеОЦ=0) или (ДатаДок < '01/01/2015') Тогда
		Для Страница = 1 По КолСтр Цикл
			ЕРПН = ?(ЕРНН = 1, "Х","");
			Электр = ?(ЭлектронныйДокумент = 1, "Х","");
			РегЕРНН = ?((ТребуетВклВЕдРеестрНН = 1) или (ЕРНН = 1), "Х","");
			СоглОРазделеПрод = ?(СоглашениеОРазделеПродукции = 1, "Х","");
			Если Страница = 1 Тогда  
				Таб.ВывестиСекцию( "Пробел" );
				Оригинал = ?((Оставляем = 1) или ((ЭлектронныйДокумент = 1)и(ДатаДок >= '01/03/2014')), "","Х"); 
				Копия = "";
				ОстаетсяПеч = ?(Оставляем = 1, "Х","");  
			ИначеЕсли Страница = 2 Тогда
				Если ЭлектронныйДокумент = 1 Тогда
					Прервать;	
				КонецЕсли;
				Таб.ВывестиСекцию( "Пробел" );
				Копия = "Х";
				Оригинал = "";
				ТипПричиныПеч = "";
				ОстаетсяПеч = "";  
			КонецЕсли;
			Таб.ВывестиСекцию( "Оригинал" );
			Таб.ВывестиСекцию( "Шапка" );
			Если Суффикс = "_2011" Тогда
				Если ВидНомДогов = 2 Тогда          
					Таб.ВывестиСекцию( "Договор2" ); 
				Иначе
					Таб.ВывестиСекцию( "Договор1" ); 
				КонецЕсли;
				Таб.ВывестиСекцию( "Шапка2" ); 
			КонецЕсли;
	
			ПерваяСтрока = 1;
	
			СуммаБезСкидки0 = 0;
			СуммаБезСкидки20 = 0;
			ИтогПоЛьготам = "";
			
			Для Н = 1 По 4 Цикл
				Если Н = ТекущийСтолбец Тогда
					Ст[Н] = 0;
				Иначе
					Ст[Н] = ПустаяЯчейка;
				КонецЕсли;	
			КонецЦикла;                    
			        		
			ТаблТМЦ.ВыбратьСтроки();
			Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
				Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
					СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ);
					
					Если ИтогПоЛьготам = "" Тогда
						ИтогПоЛьготам = СтатьяЛьготы;
					ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
						ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
					КонецЕсли;	
				КонецЕсли;	
				Если Итоговая=1 Тогда
					Дата21 = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаДок);
				Иначе
					Дата21 = ДатаДок;
				КонецЕсли;
				Если ПечататьДатыСРазделителями = Да Тогда
					Дата2 = Дата21;
				Иначе //по умолчанию без разделителей
					Дата2 = ДатаДляПечати(Дата21);
				КонецЕсли; 
				ТекстГТД = "";
				Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
				    //дополняем текст ГТД  
					Если ПечататьДатыСРазделителями = Да Тогда
						ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
					Иначе //по умолчанию без разделителей
						ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
					КонецЕсли; 
					ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
				КонецЕсли;
				
				Если (ТаблТМЦ.Кво <> 0) и (ТаблТМЦ.Скидка <> 0) Тогда
					//будем пересчитывать цену только при наличии скидки
					ТекЦенаБезНДС = ТаблТМЦ.СуммаБезНДС/ (ТаблТМЦ.Кво);
				ИначеЕсли Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда 
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * ?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
					Иначе
						ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС; 
					КонецЕсли;
				Иначе
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
				КонецЕсли;
				ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезНДС;
				
				буфКодУКТВЭД = СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",?(ПечКодУКТВЭДбезПробелов = 1,""," "));
				Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
					ЕдИзм = ТаблТМЦ.Ед.Единица;
					КодЕдИзм = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
					ПечЦенаБезНДС = СуммаДляПечати(ТекЦенаБезНДС);
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = ПустаяЯчейка;
							Ст[НулевойСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
							СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
							Ст[НулевойСтолбец] = ПустаяЯчейка;
							
							СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
						
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
					Таб.ВывестиСекцию("РазделI2");
				Иначе
					ЕдИзм = ?(ДатаДок >= '01/01/2015', "шт", ТаблТМЦ.ТМЦ.БазЕдиница);
					КодЕдИзм = "2009";
					ПечЦенаБезНДС = СуммаДляПечати(ТекЦенаБезНДС);
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = ПустаяЯчейка;
							Ст[НулевойСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
							СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
							Ст[НулевойСтолбец] = ПустаяЯчейка; 
							СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки); 
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
					Таб.ВывестиСекцию("РазделI2");
				КонецЕсли;
				ПерваяСтрока = 0;
			КонецЦикла;
			
			СуммаБезТранс = СуммаБезСкидки20 + СуммаБезСкидки0;
			ПечСуммаБезТранс = СуммаДляПечати(СуммаБезТранс);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаБезТранс - СуммаБезСкидки0);
				Ст[НулевойСтолбец] = СуммаДляПечати(СуммаБезСкидки0);
			Иначе
				Ст[ТекущийСтолбец] = ПечСуммаБезТранс;
			КонецЕсли;
			Таб.ВывестиСекцию( "РазделIВсего" );
			
			ПечВозвТара = ?(СуммаВозвратнойТары=0,ПустаяЯчейка,СуммаДляПечати(СуммаВозвратнойТары));
			Таб.ВывестиСекцию( "ВозврТара" );
			
			Для Н = 1 По 4 Цикл
				Ст[Н] = "";
				Ск[Н] = "";
			КонецЦикла;
			
			
			ИтогСуммаБезНДС = Итог("СуммаБезНДС");
			ПечИтогСуммаБезНДС = СуммаДляПечати(ИтогСуммаБезНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				ИтогСуммаБезНДС0 = СуммаБезСкидки0;
			КонецЕсли;
			
			ПечИтогНДС = СуммаДляПечати(Итог("НДС"));
			Если Сокрлп(ВидНДС.Код) = "НДС0" Тогда
				//по п.11 порядка заполнения НН
				Ст[2] = "0";
				Ст[3] = "0";
			ИначеЕсли ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = ПечИтогНДС;
				Ст[НулевойСтолбец] = "0";
			ИначеЕсли (Сокрлп(ВидНДС.Код) = "НДС7") и (ДатаДок < '01/12/2014') Тогда
				Ст[ТекущийСтолбец] = ПечИтогНДС;
			ИначеЕсли Найти("2,3", ТекущийСтолбец) > 0 Тогда
				Ст[ТекущийСтолбец] = "0";
			ИначеЕсли ТекущийСтолбец = 4 Тогда
				Ст[ТекущийСтолбец] = "Без ПДВ "; 
			Иначе
				Ст[ТекущийСтолбец] = ПечИтогНДС;
			КонецЕсли;
			Таб.ВывестиСекцию( "НДС" );
			//теперь очистим
			Ст[2] = "";
			Ст[3] = "";
			
			ИтогСуммаСНДС = Итог("СуммаСНДС");
			ПечВсего = СуммаДляПечати(ИтогСуммаСНДС + СуммаВозвратнойТары);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
				Ст[НулевойСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаСНДС);
			КонецЕсли;
			Таб.ВывестиСекцию( "ОбщаяСумма" );
			
			Таб.ВывестиСекцию( "Подвал" );
	
			Если Страница <> 2 Тогда
				Таб.НоваяСтраница();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
    
	Если (ПродажаНижеОЦ=1) Тогда
		
		Таб.НоваяСтраница();
		
		ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
		ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	    
		
		ИтогПоЛьготам = "";
		ИтСумБНДС = Итог("СуммаБезНДС");
		
		Если (ДатаДок >= '01/01/2015') Тогда  
			ТекстДополненияГр3 = " (" + СокрЛП(ТекстДоп) + " в податковій накладній №" + СокрЛП(НомерОсновнойНН);
			ТекстДополненияГр3 = ТекстДополненияГр3 + ?((ОЦВключаетПроценты=1) и (ИтСумБНДС <> 0),", сума процентів, нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
			ТипПричиныПеч = Сред(ТипПричины,2,2);
		Иначе		
			Если ИтСумБНДС = 0 Тогда
				ТекстДополненияГр3 = " (звичайна ціна за товарами, послугами, указаними в податковій накладній №"+ Строка(НомерДокумента) + ?(СпецРежимНалогообложения=0,"","/"+ СпецРежимНалогообложения)+")";
			Иначе	
				ТекстДополненияГр3 = " (перевищення звичайної ціни над фактичною за товарами, послугами, указаними в податковій накладній №"+ Строка(НомерДокумента) + ?(СпецРежимНалогообложения=0,"","/"+ СпецРежимНалогообложения);
				ТекстДополненияГр3 = ТекстДополненияГр3 + ?(ОЦВключаетПроценты=1,", сума процентів нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
			КонецЕсли;
		КонецЕсли;
		
		НомерДокумента = Строка(НомерДокумента);
		Если (ДатаДок >= '01/12/2014') Тогда
			КонтрагентПолнНаименование = Фирма.ПолнНаименование;
			КонтрагентАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
			КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
			КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонецЕсли;
		
		Для Страница = 1 По КолСтр Цикл
			Таб.ВывестиСекцию( "Пробел" );
			ЕРПН = "";
			РегЕРНН = "";
			Электр  = "";
			СоглОРазделеПрод = ?(СоглашениеОРазделеПродукции = 1, "Х","");
			Если Страница = 1 Тогда  
				Оригинал = "";
				Копия = "";
				ОстаетсяПеч = "Х";
				ТипПричиныПеч = ?(ДатаДок >= '01/01/2015',ТипПричиныПеч,?(ИтСумБНДС = 0,"12","01"));
			ИначеЕсли Страница = 2 Тогда
				Копия = "Х";
				Оригинал = "";
				ТипПричиныПеч = "";
				ОстаетсяПеч = "";  
			КонецЕсли;
			Таб.ВывестиСекцию( "Оригинал" );
			Таб.ВывестиСекцию( "Шапка" ); 
			Если Суффикс = "_2011" Тогда
				Если ВидНомДогов = 2 Тогда          
					Таб.ВывестиСекцию( "Договор2" ); 
				Иначе	
					Таб.ВывестиСекцию( "Договор1" ); 
				КонецЕсли;
				Таб.ВывестиСекцию( "Шапка2" ); 
			КонецЕсли;
			
			ПерваяСтрока = 1;
			СуммаПревышения0 = 0;
			ТрансСуммаБезНДС = 0;
			ТрансСуммаБезНДС0 = 0;
	
			Для Н = 1 По 4 Цикл
				Если Н = ТекущийСтолбец Тогда
					Ст[Н] = 0;
				Иначе
					Ст[Н] = ПустаяЯчейка;
				КонецЕсли;	
			КонецЦикла;                    
				        		
			ТаблТМЦ.ВыбратьСтроки();
			Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
				Если Итоговая=1 Тогда
					Дата21 = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаДок);
				Иначе
					Дата21 = ДатаДок;
				КонецЕсли;
				Если ПечататьДатыСРазделителями = Да Тогда
					Дата2 = Дата21;
				Иначе //по умолчанию без разделителей
					Дата2 = ДатаДляПечати(Дата21);
				КонецЕсли;
				ТекстГТД = "";
				Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
				    //дополняем текст ГТД  
					Если ПечататьДатыСРазделителями = Да Тогда
						ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
					Иначе //по умолчанию без разделителей
						ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
					КонецЕсли; 
					ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
				КонецЕсли;
				
				буфКодУКТВЭД = СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",?(ПечКодУКТВЭДбезПробелов = 1,""," "));
				Если ТаблТМЦ.СуммаПревышения > 0 Тогда
					Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
						ЕдИзм = ТаблТМЦ.Ед.Единица;
						КодЕдИзм = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
						ПечЦенаБезНДС = ?((ДатаДок < '01/01/2015')или(ТаблТМЦ.Кво=0), "", СуммаДляПечати(ТаблТМЦ.СуммаПревышения/ТаблТМЦ.Кво));
						Если ЕстьНулевыеСтавкиНДС = 1 Тогда
							Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
								Ст[ТекущийСтолбец] = ПустаяЯчейка;
								Ст[НулевойСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
								СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
							Иначе
								Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
								Ст[НулевойСтолбец] = ПустаяЯчейка;
							КонецЕсли;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения)
						КонецЕсли;
						Таб.ВывестиСекцию("РазделI2");
					Иначе
						ЕдИзм = ?(ДатаДок >= '01/01/2015', "шт", ТаблТМЦ.ТМЦ.БазЕдиница);
						КодЕдИзм = "2009";
						ПечЦенаБезНДС = ?((ДатаДок < '01/01/2015')или(ТаблТМЦ.Кво=0), "", СуммаДляПечати(ТаблТМЦ.СуммаПревышения/ТаблТМЦ.Кво));
						Если ЕстьНулевыеСтавкиНДС = 1 Тогда
							Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
								Ст[ТекущийСтолбец] = ПустаяЯчейка;
								Ст[НулевойСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
								СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
							Иначе
								Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
								Ст[НулевойСтолбец] = ПустаяЯчейка;
							КонецЕсли;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения)
						КонецЕсли;
						Таб.ВывестиСекцию("РазделI2");
					КонецЕсли;
					ПерваяСтрока = 0;
				КонецЕсли;	
			КонецЦикла;
			
			СуммаБезТранс = Итог("СуммаПревышения") - ТрансСуммаБезНДС;
			ПечСуммаБезТранс = СуммаДляПечати(СуммаБезТранс);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаБезТранс - СуммаПревышения0);
				Ст[НулевойСтолбец] = СуммаДляПечати(СуммаПревышения0);
			Иначе
				Ст[ТекущийСтолбец] = ПечСуммаБезТранс;
			КонецЕсли;
			Таб.ВывестиСекцию( "РазделIВсего" );

			ПечВозвТара = ПустаяЯчейка;
			Таб.ВывестиСекцию( "ВозврТара" );
			
			Для Н = 1 По 4 Цикл
				Ст[Н] = "";
				Ск[Н] = "";
			КонецЦикла;
			
			ИтогСуммаБезНДС = Итог("СуммаПревышения");
			ПечИтогСуммаБезНДС = СуммаДляПечати(ИтогСуммаБезНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				ИтогСуммаБезНДС0 = СуммаПревышения0;
			КонецЕсли;
			
			ИтогНДС = Итог("НДСПревышения");
			ПечИтогНДС = СуммаДляПечати(ИтогНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = ПечИтогНДС;
				Ст[НулевойСтолбец] = "0";
			Иначе
				Ст[ТекущийСтолбец] = ПечИтогНДС;
			КонецЕсли;
			Таб.ВывестиСекцию( "НДС" );
			
			ИтогСуммаСНДС = ИтогСуммаБезНДС + ИтогНДС;
			ПечВсего = СуммаДляПечати(ИтогСуммаСНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
				Ст[НулевойСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС0);
			Иначе
				Ст[ТекущийСтолбец] = ПечВсего;
			КонецЕсли;
			Таб.ВывестиСекцию( "ОбщаяСумма" );
			
			Таб.ВывестиСекцию( "Подвал" );
			
			Если Страница <> 2 Тогда
				Таб.НоваяСтраница();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	Таб.Опции(0, 0, 0, 0, "НН");
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Печать налоговой накладной","");
КонецПроцедуры
//============================
Процедура Печать2005()
Перем ПечЦенаБезНДС, ПечСуммаБезСкидки, ПечСуммаБезТранс, ПечСуммаТранс, ПечВозвТара,
	ПечСуммаНадбавки, ПечСуммаСкидки, ПечИтогСуммаБезНДС, ПечИтогНДС, 
	ПечВсего, Ст[4], Ск[4];
    
	НомерДокумента = глНомерБезПрефикса(НомерДок);
	
	Если ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента Тогда
		ФирмаПолнНаименование = Контрагент.ПолнНаименование;
		ФирмаАдрес = Контрагент.ЮридическийАдрес;
		ФирмаТелефоны = Контрагент.Телефоны;
		ФирмаНалогНомер = "XXXXXXXXXXXX";
		ФирмаНомСвид = "XXXXXXXXXXXX";
		КонтрагентПолнНаименование = Фирма.ПолнНаименование;
		КонтрагентАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
		КонтрагентТелефоны = Фирма.Телефоны.Получить(ДатаДок);
		КонтрагентНалогНомер = Фирма.ИНН;
		КонтрагентНомСвид = Фирма.НомерСвидетельства;
	Иначе
		ФирмаПолнНаименование = Фирма.ПолнНаименование;
		ФирмаАдрес = Фирма.ЮридическийАдрес.Получить(ДатаДок);
		ФирмаТелефоны = Фирма.Телефоны.Получить(ДатаДок);
		ФирмаНалогНомер = Фирма.ИНН;
		ФирмаНомСвид = Фирма.НомерСвидетельства;
		КонтрагентПолнНаименование = Контрагент.ПолнНаименование;
		КонтрагентАдрес = Контрагент.ЮридическийАдрес;
		КонтрагентТелефоны = Контрагент.Телефоны;
		КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, "XXXXXXXXXXXX", Контрагент.ИНН);
		КонтрагентНомСвид = ?(ПустоеЗначение(Контрагент.НомерСвидетельства)=1, "XXXXXXXXXXXX", Контрагент.НомерСвидетельства);
	КонецЕсли;
	
	Суффикс = "_2005";
	ПустаяЯчейка = "Х        " + Симв(160);
	ТекстДополненияГр3 = "";
	
	Таб = СоздатьОбъект( "Таблица" );
	ИмяФайлаПечатнойФормы = КаталогИБ()+"ExtForms\PrnForms\NN"+Суффикс+".mxl";
	Если ФС.СуществуетФайл(ИмяФайлаПечатнойФормы) = 1 Тогда
		Таб.ИсходнаяТаблица(ИмяФайлаПечатнойФормы);
	Иначе
		Таб.ИсходнаяТаблица("НДС"+Суффикс);
	КонецЕсли;
	
	Если Сокрлп(ВидНДС.Код) = "БезНДС" Тогда
		ТекущийСтолбец = 4
	ИначеЕсли Сокрлп(ВидНДС.Код) = "НДС0" Тогда
		Если ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			ТекущийСтолбец = 3
		Иначе
			ТекущийСтолбец = 2
		КонецЕсли;
	Иначе
		ТекущийСтолбец = 1;
		Если ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			НулевойСтолбец = 3
		Иначе
			НулевойСтолбец = 2
		КонецЕсли;
	КонецЕсли;
	
	ДопКолонка = ?(ЕстьНулевыеСтавкиНДС = 1, "НулеваяСтавкаНДС,","");
    
	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));
	
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	ТаблТМЦ.Свернуть(ДопКолонка + "ТМЦ,"+
  			?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
  			",Ед,Коэффициент,ОперДата","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");
  			
	Для Страница = 1 По 2 Цикл
		Таб.ВывестиСекцию( "Пробел" );
		Если Страница = 1 Тогда
			Таб.ВывестиСекцию( "Оригинал" );
		ИначеЕсли Страница = 2 Тогда
			Таб.ВывестиСекцию( "ПерваяКопия" );
		КонецЕсли;
		Таб.ВывестиСекцию( "Шапка" );

		ПерваяСтрока = 1;

		СуммаБезСкидки0 = 0;
		СуммаБезСкидки20 = 0;
		СуммаНадбавки = 0;
		СуммаСкидки = 0;
		СуммаНадбавки0 = 0;
		СуммаСкидки0 = 0;
		ТрансСуммаБезНДС = 0;
		ТрансСуммаБезНДС0 = 0;
		ТрансСуммаБезНДС20 = 0;
		ИтогПоЛьготам = "";
		
		Для Н = 1 По 4 Цикл
			Если Н = ТекущийСтолбец Тогда
				Ст[Н] = 0;
			Иначе
				Ст[Н] = ПустаяЯчейка;
			КонецЕсли;	
		КонецЦикла;                    
		        		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
				СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ);
				
				Если ИтогПоЛьготам = "" Тогда
					ИтогПоЛьготам = СтатьяЛьготы;
				ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
					ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
				КонецЕсли;	
			КонецЕсли;	
			Если Итоговая=1 Тогда
				Дата2 = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаДок);
			Иначе
				Дата2 = ДатаДок;
			КонецЕсли;
			
			Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда 
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки*?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС),ТаблТМЦ.СуммаБезНДС);
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * ?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
				Иначе
					ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки*КоэфБезНДС,ТаблТМЦ.СуммаБезНДС);
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС; 
				КонецЕсли;
			Иначе
				ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки,ТаблТМЦ.СуммаБезНДС);
				ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
			КонецЕсли;
			
			Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
				Если ТаблТМЦ.ТМЦ.Транспорт = 0 Тогда
					ЕдИзм = ТаблТМЦ.Ед;
					ПечЦенаБезНДС = СуммаДляПечати(ТекЦенаБезНДС);
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = ПустаяЯчейка;
							Ст[НулевойСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
							ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки0, СуммаНадбавки0);
							СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
							Ст[НулевойСтолбец] = ПустаяЯчейка;
							
							СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
						
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
					ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки, СуммаНадбавки);
					Таб.ВывестиСекцию("РазделI2");
				Иначе
					ТрансСуммаБезНДС = ТрансСуммаБезНДС + ТаблТМЦ.СуммаБезНДС; 
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							ТрансСуммаБезНДС0 = ТрансСуммаБезНДС0 + ТаблТМЦ.СуммаБезНДС; 
							ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки0, СуммаНадбавки0);
						КонецЕсли;
					Иначе
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
					ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки, СуммаНадбавки);
				КонецЕсли;
			Иначе
				ЕдИзм = ТаблТМЦ.ТМЦ.БазЕдиница;
				ПечЦенаБезНДС = СуммаДляПечати(ТекЦенаБезНДС);
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
						Ст[ТекущийСтолбец] = ПустаяЯчейка;
						Ст[НулевойСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
						ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки0, СуммаНадбавки0);
						СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки);
						Ст[НулевойСтолбец] = ПустаяЯчейка; 
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
				Иначе
					Ст[ТекущийСтолбец] = СуммаДляПечати(ТекСуммаБезСкидки); 
					СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
				КонецЕсли;
				ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки, СуммаНадбавки);
				Таб.ВывестиСекцию("РазделI2");
			КонецЕсли;
			ПерваяСтрока = 0;
		КонецЦикла;
		
		СуммаБезТранс = СуммаБезСкидки20 + СуммаБезСкидки0 - ТрансСуммаБезНДС;
		ПечСуммаБезТранс = СуммаДляПечати(СуммаБезТранс);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаБезТранс - СуммаБезСкидки0);
			Ст[НулевойСтолбец] = СуммаДляПечати(СуммаБезСкидки0);
		Иначе
			Ст[ТекущийСтолбец] = ПечСуммаБезТранс;
		КонецЕсли;
		Таб.ВывестиСекцию( "РазделIВсего" );
		
		ПечСуммаТранс = СуммаДляПечати(ТрансСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляПечати(ТрансСуммаБезНДС - ТрансСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляПечати(ТрансСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = ПечСуммаТранс;
		КонецЕсли;
		Таб.ВывестиСекцию( "ТовТранс" );
		
		ПечВозвТара = СуммаДляПечати(СуммаВозвратнойТары);
		Таб.ВывестиСекцию( "ВозврТара" );
		
		Для Н = 1 По 4 Цикл
			Ст[Н] = "";
			Ск[Н] = "";
		КонецЦикла;
		
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			ПечСуммаНадбавки = СуммаДляПечати((СуммаНадбавки - СуммаНадбавки0) * КоэфБезНДС + СуммаНадбавки0);
			ПечСуммаСкидки   = СуммаДляПечати((СуммаСкидки - СуммаСкидки0) * КоэфБезНДС + СуммаСкидки0);
		Иначе			
			ПечСуммаНадбавки = СуммаДляПечати(СуммаНадбавки + СуммаНадбавки0);
			ПечСуммаСкидки   = СуммаДляПечати(СуммаСкидки + СуммаСкидки0);
		КонецЕсли;
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати((СуммаНадбавки - СуммаНадбавки0) * КоэфБезНДС);
				Ст[НулевойСтолбец] = СуммаДляПечати(СуммаНадбавки0);
				Ск[ТекущийСтолбец] = СуммаДляПечати((СуммаСкидки - СуммаСкидки0) * КоэфБезНДС);
				Ск[НулевойСтолбец] = СуммаДляПечати(СуммаСкидки0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаНадбавки * КоэфБезНДС);
				Ск[ТекущийСтолбец] = СуммаДляПечати(СуммаСкидки * КоэфБезНДС);
			КонецЕсли;	
		Иначе
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаНадбавки - СуммаНадбавки0);
				Ст[НулевойСтолбец] = СуммаДляПечати(СуммаНадбавки0);
				Ск[ТекущийСтолбец] = СуммаДляПечати(СуммаСкидки - СуммаСкидки0);
				Ск[НулевойСтолбец] = СуммаДляПечати(СуммаСкидки0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаНадбавки);
				Ск[ТекущийСтолбец] = СуммаДляПечати(СуммаСкидки);
			КонецЕсли;	
		КонецЕсли;	
		
		Таб.ВывестиСекцию( "Надбавка" );
		
		ИтогСуммаБезНДС = Итог("СуммаБезНДС");
		ПечИтогСуммаБезНДС = СуммаДляПечати(ИтогСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			ИтогСуммаБезНДС0 = СуммаБезСкидки0 + ТрансСуммаБезНДС0 + СуммаНадбавки0 - СуммаСкидки0;
			Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = ПечИтогСуммаБезНДС;
		КонецЕсли;
		Таб.ВывестиСекцию( "ВсегоПоI_II_IV" );
		
		ПечИтогНДС = СуммаДляПечати(Итог("НДС"));
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = ПечИтогНДС;
			Ст[НулевойСтолбец] = "0";
		ИначеЕсли Найти("2,3", ТекущийСтолбец) > 0 Тогда
			Ст[ТекущийСтолбец] = "0";
		ИначеЕсли ТекущийСтолбец = 4 Тогда
			Ст[ТекущийСтолбец] = "Без ПДВ " + ИтогПоЛьготам
		Иначе
			Ст[ТекущийСтолбец] = ПечИтогНДС;
		КонецЕсли;
		Таб.ВывестиСекцию( "НДС" );
		
		ИтогСуммаСНДС = Итог("СуммаСНДС");
		ПечВсего = СуммаДляПечати(ИтогСуммаСНДС + СуммаВозвратнойТары);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаСНДС);
		КонецЕсли;
		Таб.ВывестиСекцию( "ОбщаяСумма" );
		
		Таб.ВывестиСекцию( "Подвал" );

		Если Страница <> 2 Тогда
			Таб.НоваяСтраница();
		КонецЕсли;
	КонецЦикла;
    
	Если (ПродажаНижеОЦ=1) И (Сокрлп(ВидНДС.Код) = "НДС20") Тогда
		
		Таб.НоваяСтраница();
		
		ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
		ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	    
		
		ИтогПоЛьготам = "";
		
		ТекстДополненияГр3 = " (перевищення звичайної ціни над фактичною за товарами, послугами, указаними в податковій накладній №"+ Строка(НомерДокумента);
		ТекстДополненияГр3 = ТекстДополненияГр3 + ?(ОЦВключаетПроценты=1,", сума процентів нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
		
		НомерДокумента = Строка(НомерДокумента)+"/ЗЦ";
		
		
		
		Для Страница = 1 По 2 Цикл
			Таб.ВывестиСекцию( "Пробел" );
			Если Страница = 1 Тогда
				Таб.ВывестиСекцию( "Оригинал" );
			ИначеЕсли Страница = 2 Тогда
				Таб.ВывестиСекцию( "ПерваяКопия" );
			КонецЕсли;	
		    
			Таб.ВывестиСекцию( "Шапка" );
			
			ПерваяСтрока = 1;
			СуммаПревышения0 = 0;
			ТрансСуммаБезНДС = 0;
			ТрансСуммаБезНДС0 = 0;
	
			Для Н = 1 По 4 Цикл
				Если Н = ТекущийСтолбец Тогда
					Ст[Н] = 0;
				Иначе
					Ст[Н] = ПустаяЯчейка;
				КонецЕсли;	
			КонецЦикла;                    
				        		
			ТаблТМЦ.ВыбратьСтроки();
			Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
				Если Итоговая=1 Тогда
					Дата2 = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаДок);
				Иначе
					Дата2 = ДатаДок;
				КонецЕсли;
				Если ТаблТМЦ.СуммаПревышения > 0 Тогда
					Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
						Если ТаблТМЦ.ТМЦ.Транспорт = 0 Тогда
							ЕдИзм = ТаблТМЦ.Ед;
							ПечЦенаБезНДС = "";
							Если ЕстьНулевыеСтавкиНДС = 1 Тогда
								Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
									Ст[ТекущийСтолбец] = ПустаяЯчейка;
									Ст[НулевойСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
									СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
								Иначе
									Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
									Ст[НулевойСтолбец] = ПустаяЯчейка;
								КонецЕсли;
							Иначе
								Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения)
							КонецЕсли;
							Таб.ВывестиСекцию("РазделI2");
						Иначе
							ТрансСуммаБезНДС = ТрансСуммаБезНДС + ТаблТМЦ.СуммаПревышения; 
							Если ЕстьНулевыеСтавкиНДС = 1 Тогда
								Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
									ТрансСуммаБезНДС0 = ТрансСуммаБезНДС0 + ТаблТМЦ.СуммаПревышения; 
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					Иначе
						ЕдИзм = ТаблТМЦ.ТМЦ.БазЕдиница;
						ПечЦенаБезНДС = "";
						Если ЕстьНулевыеСтавкиНДС = 1 Тогда
							Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
								Ст[ТекущийСтолбец] = ПустаяЯчейка;
								Ст[НулевойСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
								СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
							Иначе
								Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения);
								Ст[НулевойСтолбец] = ПустаяЯчейка;
							КонецЕсли;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляПечати(ТаблТМЦ.СуммаПревышения)
						КонецЕсли;
						Таб.ВывестиСекцию("РазделI2");
					КонецЕсли;
					ПерваяСтрока = 0;
				КонецЕсли;	
			КонецЦикла;
			
			СуммаБезТранс = Итог("СуммаПревышения") - ТрансСуммаБезНДС;
			ПечСуммаБезТранс = СуммаДляПечати(СуммаБезТранс);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(СуммаБезТранс - СуммаПревышения0);
				Ст[НулевойСтолбец] = СуммаДляПечати(СуммаПревышения0);
			Иначе
				Ст[ТекущийСтолбец] = ПечСуммаБезТранс;
			КонецЕсли;
			Таб.ВывестиСекцию( "РазделIВсего" );

		
			ПечСуммаТранс = СуммаДляПечати(ТрансСуммаБезНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(ТрансСуммаБезНДС - ТрансСуммаБезНДС0);
				Ст[НулевойСтолбец] = СуммаДляПечати(ТрансСуммаБезНДС0);
			Иначе
				Ст[ТекущийСтолбец] = ПечСуммаТранс;
			КонецЕсли;
			Таб.ВывестиСекцию( "ТовТранс" );
			
			ПечВозвТара = 0;
			Таб.ВывестиСекцию( "ВозврТара" );
			
			Для Н = 1 По 4 Цикл
				Ст[Н] = "";
				Ск[Н] = "";
			КонецЦикла;
			
			ПечСуммаНадбавки = СуммаДляПечати(0);
			ПечСуммаСкидки   = СуммаДляПечати(0);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(0);
				Ст[НулевойСтолбец] = СуммаДляПечати(0);
				Ст[ТекущийСтолбец] = СуммаДляПечати(0);
				Ст[НулевойСтолбец] = СуммаДляПечати(0);
			Иначе
				Ст[ТекущийСтолбец] = ПечСуммаНадбавки;
				Ск[ТекущийСтолбец] = ПечСуммаСкидки;
			КонецЕсли;
			Таб.ВывестиСекцию( "Надбавка" );
			
			ИтогСуммаБезНДС = Итог("СуммаПревышения");
			ПечИтогСуммаБезНДС = СуммаДляПечати(ИтогСуммаБезНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				ИтогСуммаБезНДС0 = СуммаПревышения0 + ТрансСуммаБезНДС0;
				Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС - ИтогСуммаБезНДС0);
				Ст[НулевойСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС0);
			Иначе
				Ст[ТекущийСтолбец] = ПечИтогСуммаБезНДС;
			КонецЕсли;
			Таб.ВывестиСекцию( "ВсегоПоI_II_IV" );
			
			ИтогНДС = Итог("НДСПревышения");
			ПечИтогНДС = СуммаДляПечати(ИтогНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = ПечИтогНДС;
				Ст[НулевойСтолбец] = "0";
			Иначе
				Ст[ТекущийСтолбец] = ПечИтогНДС;
			КонецЕсли;
			Таб.ВывестиСекцию( "НДС" );
			
			ИтогСуммаСНДС = ИтогСуммаБезНДС + ИтогНДС;
			ПечВсего = СуммаДляПечати(ИтогСуммаСНДС);
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляПечати(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
				Ст[НулевойСтолбец] = СуммаДляПечати(ИтогСуммаБезНДС0);
			Иначе
				Ст[ТекущийСтолбец] = ПечВсего;
			КонецЕсли;
			Таб.ВывестиСекцию( "ОбщаяСумма" );
			
			Таб.ВывестиСекцию( "Подвал" );
			
			Если Страница <> 2 Тогда
				Таб.НоваяСтраница();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	
	Таб.ПараметрыСтраницы(1,,,,,,,,);
	Таб.Опции(0, 0, 0, 0, "НН");
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	Таб.Показать("Печать налоговой накладной","");
КонецПроцедуры


// ===============================
Процедура Печать(Режим=0)
	
	глПроверкаНДСВДокументе(Контекст, Итог("СуммаБезНДС"), Итог("СуммаСНДС"), Итог("НДС"));
	Если (ДатаДок >= '01.04.2016') или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016')) Тогда
		Печать2016();
		Возврат
	ИначеЕсли ДатаДок >= '10.01.2011' Тогда
		Печать2011();
		Возврат
	ИначеЕсли ДатаДок >= '29.07.2005' Тогда
		Печать2005();
		Возврат
	КонецЕсли;
	
	НомерДокумента = глНомерБезПрефикса(НомерДок);
	ФирмаНалогНомер      = Фирма.ИНН;
	ФирмаНомСвид         = Фирма.НомерСвидетельства;
	КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1,               "ХХХХХХХХХХХХ",Контрагент.ИНН);
	КонтрагентНомСвид    = ?(ПустоеЗначение(Контрагент.НомерСвидетельства)=1,"ХХХХХХХХХХХХ",Контрагент.НомерСвидетельства);

	Таб = СоздатьОбъект("Таблица");
	
	Если  СокрЛП(ВидНДС.Код) = "БезНДС" Тогда
		Таб.ИсходнаяТаблица("БезНДС");
	ИначеЕсли СокрЛП(ВидНДС.Код) = "НДС0"   Тогда
		Таб.ИсходнаяТаблица("НДС0");
	Иначе
		Таб.ИсходнаяТаблица("НДС20");
	КонецЕсли;
	
	Если Валюта <> Гривня Тогда
		// экспорт
		Таб.ИсходнаяТаблица("НДСЭкспорт");
	КонецЕсли;
    
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	ТаблТМЦ.Свернуть("ТМЦ,"+
  			?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
  			",Ед,Коэффициент,ОперДата","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");
	
	// переменные-акселераторы
	КоэфБезНДС = 100/(100 + глПроцентНДС(ВидНДС,ДатаДок));

	Для Страница = 1 По 2 Цикл
		// инициализация алгоритмов корректого округления
		глОчиститьКлючОкр("БезСкидки");
		
		Таб.ВывестиСекцию( "Пробел" );
		Таб.ВывестиСекцию( ?(Страница=1,"Оригинал","ПерваяКопия") );
		Таб.ВывестиСекцию( "Шапка" );
		ПерваяСтрока = 1;
		
		ТрансСуммаБезСкидкиГрн = 0;
		ИтСуммаБезСкидкиГрн    = 0;
		ИтогПоЛьготам = "";
		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если (Сокрлп(ВидНДС.Код) = "БезНДС") Тогда	
				СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ);
				
				Если ИтогПоЛьготам = "" Тогда
					ИтогПоЛьготам = СтатьяЛьготы;
				ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
					ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
				КонецЕсли;	
			КонецЕсли;	
			Если Итоговая=1 Тогда
				Дата2 = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаДок);
			Иначе
				Дата2 = ДатаДок;
			КонецЕсли;
			
			Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
				ПечТМЦ = ТаблТМЦ.ТМЦ.ПолнНаименование;
				ЕдИзм  = ТаблТМЦ.Ед;
				ЭтоТранспортнаяУслуга = ТаблТМЦ.ТМЦ.Транспорт;
			Иначе
				ПечТМЦ = ТаблТМЦ.ТМЦ.ПолнНаименование;
				ЕдИзм  = ТаблТМЦ.ТМЦ.БазЕдиница;
				ЭтоТранспортнаяУслуга = 0;
			КонецЕсли;
			
			ТекКво = ТаблТМЦ.Кво;
			Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
				ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки*КоэфБезНДС,ТаблТМЦ.СуммаБезНДС);
				ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС;
			Иначе
				ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки,ТаблТМЦ.СуммаБезНДС);
				ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
			КонецЕсли;
			ЦенаБезНДСГрн	  = Окр(                   глПересчет(ТекЦенаБезНДС,    Валюта,Курс,Гривня,Дата_курса,Дата_курса),3);
			// рассчитываем с учетом накопленных погрешностей округления
			СуммаБезСкидкиГрн = глОкрКорр("БезСкидки", глПересчет(ТекСуммаБезСкидки,Валюта,Курс,Гривня,Дата_курса,Дата_курса),3);
			
			// подберем цену и количество по указанному в шапке способу
			глПодогнатьЦенаКоличество(СуммаБезСкидкиГрн, ЦенаБезНДСГрн, ТекКво, СпособПодгонки);
			
			ПечКво			    = ФРМЦена(ТекКво);
			Попытка
				Если ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0 Тогда
					ПечКво	= ТаблТМЦ.ТМЦ.КвоДляНН;
				КонецЕсли;	
			Исключение
				ПечКво			    = ФРМЦена(ТекКво);	
			КонецПопытки;	
				
			Если ИтоговаяРозница = 0 Тогда
				ПечЦенаБезНДС	    = ФРМЦена(ЦенаБезНДСГрн);
			Иначе
				ПечЦенаБезНДС	    = "";
			КонецЕсли;
			
			ПечСуммаБезСкидки   = глФРМ3(СуммаБезСкидкиГрн,Гривня,0);
			
			Если ЭтоТранспортнаяУслуга = 1 Тогда
				// по транспортной услуге выводить строку не нужно
				ТрансСуммаБезСкидкиГрн = ТрансСуммаБезСкидкиГрн + СуммаБезСкидкиГрн;
				Продолжить;              
			Иначе
				ИтСуммаБезСкидкиГрн    = ИтСуммаБезСкидкиГрн    + СуммаБезСкидкиГрн;						
				Таб.ВывестиСекцию( "РазделI2" );
			КонецЕсли;
            ПерваяСтрока = 0;
		КонецЦикла;

		ПечСуммаБезТранс   = ФРМСумма(ИтСуммаБезСкидкиГрн);
		ПечСуммаТранс      = ФРМСумма(ТрансСуммаБезСкидкиГрн);
		
		Если Итог("Скидка") = 0 Тогда
			// нет скидок
			ОбщСуммаНадбавки = 0;
			ОбщСуммаСкидки   = 0;
			ПечИтогСуммаБезНДС = ФРМСумма(Число(ПечСуммаБезТранс) + Число(ПечСуммаТранс));
		Иначе
			ПечИтогСуммаБезНДС = ФРМСумма(глПересчет(Итог("СуммаБезНДС"),Валюта,Курс,Гривня,Дата_курса,Дата_курса));
			// рассчитаем общую сумму скидки с учетом погрешности округлений
			ИтогСкидка = Число(ПечСуммаБезТранс) + Число(ПечСуммаТранс) - Число(ПечИтогСуммаБезНДС);

			ОбщСуммаНадбавки = ?(ИтогСкидка <  0, -ИтогСкидка, 0);
			ОбщСуммаСкидки   = ?(ИтогСкидка >= 0,  ИтогСкидка, 0);
		КонецЕсли;
		ПечСуммаНадбавки   = ФРМСумма(ОбщСуммаНадбавки);
		ПечСуммаСкидки     = ФРМСумма(ОбщСуммаСкидки);
		
		ПечВозвТара        = ФРМСумма(глПересчет(СуммаВозвратнойТары,Валюта,Курс,Гривня,Дата_курса,Дата_курса));
		
		Если СокрЛП(ВидНДС.Код) = "НДС0" Тогда
		    ПечИтогНДС = "0";
		Иначе  	
			ПечИтогНДС         = ФРМСумма(глПересчет(Итог("НДС"),        Валюта,Курс,Гривня,Дата_курса,Дата_курса));
		Конецесли;
		
		ПечИтогНДСГр11         = ФРМСумма(глПересчет(Итог("НДС"),        Валюта,Курс,Гривня,Дата_курса,Дата_курса));
		
		ПечИтогСуммаСНДС   = ФРМСумма(Число(ПечИтогСуммаБезНДС) + Число(ПечИтогНДС));
		ПечВсего           = ФРМСумма(Число(ПечИтогСуммаСНДС)   + Число(ПечВозвТара));
		
		Таб.ВывестиСекцию( "РазделIВсего" );
		Таб.ВывестиСекцию( "ТовТранс" );
		Таб.ВывестиСекцию( "ВозврТара" );
		Таб.ВывестиСекцию( "Надбавка" );
		Таб.ВывестиСекцию( "ВсегоПоI_II_IV" );
		Таб.ВывестиСекцию( "НДС" );
		Таб.ВывестиСекцию( "ОбщаяСумма" );
		Таб.ВывестиСекцию( "Подвал" );
		
		Если Страница <> 2 Тогда
			Таб.НоваяСтраница();
		КонецЕсли;
	КонецЦикла;
	
	Если ПродажаНижеОЦ = 1 Тогда
		
		ТекстДополненияГр3 = " (перевищення звичайної ціни над фактичною за товарами, послугами, указаними в податковій накладній №"+ Строка(НомерДокумента);
		ТекстДополненияГр3 = ТекстДополненияГр3 + ?(ОЦВключаетПроценты=1,", сума процентів нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
		
		ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
		ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
		ТаблТМЦ.Свернуть("ТМЦ,ОперДата","Кво,СуммаПревышения,НДСПревышения");
				
		НомерДокумента = НомерДокумента + "/ЗЦ";
		Таб.НоваяСтраница();
		
		Для Страница = 1 По 2 Цикл
			// инициализация алгоритмов корректого округления
			глОчиститьКлючОкр("БезСкидки");
			
			Таб.ВывестиСекцию( "Пробел" );
			Если Страница = 1 Тогда
				Таб.ВывестиСекцию( "Оригинал" );
			ИначеЕсли Страница = 2 Тогда
				Таб.ВывестиСекцию( "ПерваяКопия" );
			КонецЕсли;	
			Таб.ВывестиСекцию( "Шапка" );
			ПерваяСтрока = 1;
			
			ТаблТМЦ.ВыбратьСтроки();
			Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл 
				Если Итоговая=1 Тогда
					Дата2 = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаДок);
				Иначе
					Дата2 = ДатаДок;
				КонецЕсли;
				
				ПечТМЦ = СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование)+ТекстДополненияГр3;
				ТекКво = ТаблТМЦ.Кво;
				ПечКво = ФРМЦена(ТекКво);
				Если ТекКво = 0 Тогда
					ПечКво	= ТаблТМЦ.ТМЦ.КвоДляНН;
				КонецЕсли;	
				ПечЦенаБезНДС	    = "";
				ПечСуммаБезСкидки   = глФРМ3(ТаблТМЦ.СуммаПревышения,Гривня,0);
				
				Если ТаблТМЦ.СуммаПревышения > 0 Тогда 
					Таб.ВывестиСекцию("РазделI2");
					ПерваяСтрока = 0;
				КонецЕсли;	
			КонецЦикла;	
	        
			
			ПечСуммаБезТранс   = ФРМСумма(ТаблТМЦ.Итог("СуммаПревышения"));
			ПечСуммаТранс      = ФРМСумма(0);
			
			ПечСуммаНадбавки   = ФРМСумма(0);
			ПечСуммаСкидки     = ФРМСумма(0);
			ПечИтогСуммаБезНДС = ПечСуммаБезТранс;
			
			ПечВозвТара        = ФРМСумма(0);
			ПечИтогНДС         = ФРМСумма(ТаблТМЦ.Итог("НДСПревышения"));
			
			ПечИтогСуммаСНДС   = ФРМСумма(Число(ПечИтогСуммаБезНДС) + Число(ПечИтогНДС));
			ПечВсего           = ФРМСумма(Число(ПечИтогСуммаСНДС)   + Число(ПечВозвТара));
			
			Таб.ВывестиСекцию( "РазделIВсего" );
			Таб.ВывестиСекцию( "ТовТранс" );
			Таб.ВывестиСекцию( "ВозврТара" );
			Таб.ВывестиСекцию( "Надбавка" );
			Таб.ВывестиСекцию( "ВсегоПоI_II_IV" );
			Таб.ВывестиСекцию( "НДС" );
			Таб.ВывестиСекцию( "ОбщаяСумма" );
			Таб.ВывестиСекцию( "Подвал" );
			
			Если Страница <> 2 Тогда
				Таб.НоваяСтраница();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	Таб.Опции(0, 0, 0, 0) ;
	Таб.ПараметрыСтраницы(1,,,,,,,,);
	Если Режим = 1 Тогда
		Таб.КоличествоЭкземпляров(глВосстановитьЗначение(,"ПечКолЭкзННПриБыстройПродаже"));
		Таб.Напечатать(0);
	Иначе	
		Таб.Защита(Константа.ФлагЗащитыТаблиц);
		Таб.ТолькоПросмотр(1);
		Таб.Показать("Печать налоговой накладной","");
	КонецЕсли;	
КонецПроцедуры
// ===============================
Процедура ЗаполнитьВидДоговора()
	Если спВидДоговора.ВыбратьЗначение(ВидДоговора,"Выберите вид договора",2,0,1) = 0 Тогда
		Возврат;
	КонецЕсли;          
КонецПроцедуры

// ===============================
Процедура ИзмТипПричины()
	Инд = спТипПричины.ТекущаяСтрока();
	Если ДатаДок >= '01/03/2017' Тогда
		Если (ПродажаНижеОЦ=1) и (Инд <> 15) Тогда 
			Сообщить("При продаже по цене ниже обычной тип причины ""Оставляем у себя"" должен быть 15!", "!"); 
			Инд = 15;
		ИначеЕсли (ПродажаНижеОЦ=0) и (Инд >= 15) Тогда
			Сообщить("Тип причины 15 используется при продаже по цене ниже обычной!", "!"); 
		КонецЕсли;	
	ИначеЕсли (ДатаДок >= '01/04/2016') Тогда
		Если (ПродажаНижеОЦ=1) и (Инд < 15) Тогда 
			Сообщить("При продаже по цене ниже обычной тип причины ""Оставляем у себя"" должен быть 15, 16 или 17!", "!"); 
			Инд = 15;
		ИначеЕсли (ПродажаНижеОЦ=0) и (Инд > 15) Тогда
			Сообщить("Типы причины 15, 16 или 17 используются при продаже по цене ниже обычной!", "!"); 
		КонецЕсли;	
	ИначеЕсли (ДатаДок >= '01/01/2015') Тогда
		Если (ПродажаНижеОЦ=1) и (Инд < 13) Тогда 
			Сообщить("При продаже по цене ниже обычной тип причины ""Оставляем у себя"" должен быть 01, 12, 15, или 16!", "!"); 
			Инд = 13;
		ИначеЕсли (ПродажаНижеОЦ=0) и (Инд > 12) Тогда
			Сообщить("Типы причины 01, 12, 15, или 16 используются при продаже по цене ниже обычной!", "!"); 
		КонецЕсли;	
	КонецЕсли;
	Если Инд <> 0 Тогда
		ТекТипПричины = спТипПричины.ПолучитьЗначение(Инд);
		Если ТекТипПричины <> ТипПричины Тогда
		    ТипПричины = ТекТипПричины;
		КонецЕсли;
	КонецЕсли;
	Если ДатаДок >= '01/03/2017' Тогда
		спТекстДоп.ТекущаяСтрока(6);
		ТекстДоп = спТекстДоп.ПолучитьЗначение(6);
	ИначеЕсли (ДатаДок >= '01/04/2016') Тогда
		Если Инд = 15 Тогда	
			спТекстДоп.ТекущаяСтрока(3);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(3);
		ИначеЕсли Инд = 16 Тогда	
			спТекстДоп.ТекущаяСтрока(4);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(4);
		ИначеЕсли Инд = 17 Тогда	
			спТекстДоп.ТекущаяСтрока(5);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(5);
		КонецЕсли; 
	Иначе	
		Если Инд = 13 Тогда  
			спТекстДоп.ТекущаяСтрока(1);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(1);
		ИначеЕсли Инд = 14 Тогда	
			спТекстДоп.ТекущаяСтрока(2);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(2);
		ИначеЕсли Инд = 15 Тогда	
			спТекстДоп.ТекущаяСтрока(3);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(3);
		ИначеЕсли Инд = 16 Тогда	
			спТекстДоп.ТекущаяСтрока(4);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(4);
		ИначеЕсли Инд = 17 Тогда	
			спТекстДоп.ТекущаяСтрока(5);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(5);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура ЗаполнитьТипыПричин()
	спТипПричины.УдалитьВсе();
	спТипПричины.ДобавитьЗначение("(01)Сума увел. компенс. стоимости товаров/услуг после анул.");
	спТипПричины.ДобавитьЗначение("(02)Поставка неплательщику налога");
	спТипПричины.ДобавитьЗначение("(03)Натуральная выплата в счет оплаты труда физлицам");
	спТипПричины.ДобавитьЗначение("(04)Поставка для непроизв.использования в пределах баланса");
	спТипПричины.ДобавитьЗначение("(05)Ликвидация ОФ по самост.решению плательщика налога");
	спТипПричины.ДобавитьЗначение("(06)Перевод ОФ в состав непроизводственных");
	спТипПричины.ДобавитьЗначение("(07)Экспортные поставки");
	спТипПричины.ДобавитьЗначение("(08)Поставка для операций, кот. не облагается НДС");
	спТипПричины.ДобавитьЗначение("(09)Поставка для операций, кот. освобождены от НДС");
	спТипПричины.ДобавитьЗначение("(10)Условная продажа, при анулир.регистр.плательщика налога");
	спТипПричины.ДобавитьЗначение("(11)Выписана по ежедневным итогам операций");  
	спТипПричины.ДобавитьЗначение("(12)Поставка неплательщику налога, указывается наим. покупателя");  
	спТипПричины.ДобавитьЗначение("(13)Использование произв. и непр. средств в нехоз. деят.");  
	спТипПричины.ДобавитьЗначение("(14)Выписана покупателем услуг у нерезидента");  
	Если ДатаДок >= '01/03/2017' Тогда
		спТипПричины.ДобавитьЗначение("(15)Выписана на суму превышения бази оподаткування");  
	Иначе	
		спТипПричины.ДобавитьЗначение("(15)Выписана на суму превышения цены приобр. товаров над факт.ценой");  
		спТипПричины.ДобавитьЗначение("(16)Выписана на суму превышения балансовой стоимости необ.активов");
		спТипПричины.ДобавитьЗначение("(17)Выписана на суму превышения себестоимости самостоят.изгот.товаров");  
	КонецЕсли;
	
	// если ТипПричины есть в новом списке - спозиционируемся на него
	Инд = спТипПричины.НайтиЗначение(СокрЛП(ТипПричины));
	Если Инд = 0 Тогда
	    // нет такого в списке
		спТипПричины.ТекущаяСтрока(1);
		ТипПричины = спТипПричины.ПолучитьЗначение(1);
	Иначе
		спТипПричины.ТекущаяСтрока(Инд);
	КонецЕсли;
	спТекстДоп.УдалитьВсе();
	спТекстДоп.ДобавитьЗначение("перевищення звичайної ціни над фактичною за товарами/послугами, указаними");
	спТекстДоп.ДобавитьЗначение("звичайна ціна за товарами/послугами, указаними");
	спТекстДоп.ДобавитьЗначение("перевищення ціни придбання над фактичною ціною постачання товарів/послуг, указаних");
	спТекстДоп.ДобавитьЗначение("перевищення балансової (залишкової) вартості над фактичною ціною постачання необоротних активів, указаних");
	спТекстДоп.ДобавитьЗначение("перевищення звичайної ціни самостійно виготовлених товарів/послуг, указаних");
	спТекстДоп.ДобавитьЗначение("перевищення бази оподаткування, визначеної відповідно до статей 188 і 189 Податкового кодексу України, над фактичною ціною постачання");
	Если ДатаДок >= '01/03/2017' Тогда
		ИндТек = спТекстДоп.НайтиЗначение(СокрЛП(ТекстДоп));
		Если ИндТек = 0 Тогда
			спТекстДоп.ТекущаяСтрока(6);
			ТекстДоп = спТекстДоп.ПолучитьЗначение(6);
		КонецЕсли;
	Иначе	
		ИндТек = спТекстДоп.НайтиЗначение(СокрЛП(ТекстДоп));
		Если ИндТек = 0 Тогда
		    // нет такого в списке
			Если Инд = 15 Тогда	
				спТекстДоп.ТекущаяСтрока(3);
				ТекстДоп = спТекстДоп.ПолучитьЗначение(3);
			ИначеЕсли Инд = 16 Тогда	
				спТекстДоп.ТекущаяСтрока(4);
				ТекстДоп = спТекстДоп.ПолучитьЗначение(4);
			ИначеЕсли Инд = 17 Тогда	
				спТекстДоп.ТекущаяСтрока(5);
				ТекстДоп = спТекстДоп.ПолучитьЗначение(5);
			КонецЕсли;
		Иначе
			спТекстДоп.ТекущаяСтрока(ИндТек);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()
	НачальнаяДатаДокумента = ДатаДок;
	СтараяДата = ДатаДок;
	глПроверкаДатыДок(Контекст,"Открытие");
	ПриЗаписиПерепроводить(1);
	
	Форма.ИспользоватьЗакладки(1);
	Форма.Закладки.ДобавитьЗначение("Основной","Основные");
	Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
	Форма.Закладки.ДобавитьЗначение("Экспорт","Экспорт");
	//Форма.ИспользоватьСлой("Общий,Основной",2);
	Форма.ИспользоватьСлой("Общий,Основной");
	                          
	Если Константа.ИспользоватьСкидку <> Да Тогда
		Форма.СуммаБезСкидки.Видимость(0);
		Форма.Скидка.Видимость(0);
	КонецЕсли;
	
	глУстВидимостьЦен(Контекст);
		
	Если ПустоеЗначение(Форма.Параметр)=0 Тогда
		Если ТипЗначенияСтр(Форма.Параметр)="Строка" Тогда
			Если ВРег(Форма.Параметр)="БЫСТРАЯПЕЧАТЬ" Тогда
				Печать(1);
				СтатусВозврата(0); 
				Возврат;                            
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;

	ЗаполнитьТипыПричин();
	Если Оставляем = 1 Тогда
		Инд = спТипПричины.НайтиЗначение(СокрЛП(ТипПричины));
		Если Инд <> 0 Тогда
		    спТипПричины.ТекущаяСтрока(Инд);
		КонецЕсли;
	КонецЕсли;
	спВидДоговора = СоздатьОбъект("СписокЗначений"); 
	спВидДоговора.ДобавитьЗначение("Договір поставки");
	спВидДоговора.ДобавитьЗначение("Договір купівлі-продажу");
	спВидДоговора.ДобавитьЗначение("Договір комісії");
	спВидДоговора.ДобавитьЗначение("Договір оренди");
	спВидДоговора.ДобавитьЗначение("Договір бартерної поставки");
	спВидДоговора.ДобавитьЗначение("Договір консигнації");
	спВидДоговора.ДобавитьЗначение("Договір поруки");
	спВидДоговора.ДобавитьЗначение("Договір доручення");
	спВидДоговора.ДобавитьЗначение("Договір довірчого управління");
	спВидДоговора.ДобавитьЗначение("Договір відповідального зберігання");
	спВидДоговора.ДобавитьЗначение("Договір складського зберігання");
	спВидДоговора.ДобавитьЗначение("Договір про надання посередницьких послуг");
	спВидДоговора.ДобавитьЗначение("Договір про виконання роботи");
	спВидДоговора.ДобавитьЗначение("Договір про надання послуг");
	спВидДоговора.ДобавитьЗначение("Договір про інформаційно-довідкове обслуговування");
	спВидДоговора.ДобавитьЗначение("Договір поставки оптової партії");

	СтарЧтоПродаем = ЧтоПродаем;
	СтарыйКонтрагент = Контрагент;
	СтарВидНДС		=ВидНДС;
	СтарКатегорияЦен=КатегорияЦен;
	УстДоступность();
	НоваяНакладная = ?(ДатаДок >= '29.07.2005', 1, 0);
	
	Если (ДатаДок >= '01.01.2015') и (ЭлектронныйДокумент = 0) Тогда
		ЭлектронныйДокумент = 1;
	КонецЕсли;
	Если (ДатаДок >= '01.01.2015') и (ТребуетВклВЕдРеестрНН = 0) Тогда
		ТребуетВклВЕдРеестрНН = 1; 
	КонецЕсли;
КонецПроцедуры // ПриОткрытии()
                                  
// ===============================
Процедура ПриРедактированииНовойСтроки()
	Если ПустоеЗначение(ОперДата) = 1 Тогда
		ОперДата = ДатаДок;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ПриУдаленииСтроки()
	ОбновитьБазуНДС = 1;
КонецПроцедуры

// ===============================
Процедура ПриОкончанииРедактированияСтроки()
	РассчитатьБазуНДС();
КонецПроцедуры                             

// ===============================
Процедура ЭкспортНН()
	спВариантЭкспорта = СоздатьОбъект("СписокЗначений");
	спВариантЭкспорта.ДобавитьЗначение("Экспорт в XML");
	спВариантЭкспорта.ДобавитьЗначение("Экспорт и проверка состояния регистрации в ""FREDO Звіт""");
	
	Результат = ПолучитьПустоеЗначение();
	Если спВариантЭкспорта.ВыбратьЗначение(Результат, , , , 1) <> 1 Тогда
		Возврат;
	КонецЕсли;
		
	глРасшифровка = СоздатьОбъект("СписокЗначений");
	глРасшифровка.Установить("ТекущийДокумент", ТекущийДокумент());
	
	Если Результат = "Экспорт в XML" Тогда
		глФлагРасшифровки = 1;
		ОткрытьФорму("Отчет.ЭкспортНалоговойНакладной", глРасшифровка);
		глФлагРасшифровки = 0;
	Иначе							
		// Выведем причины невозможности использования FREDO Звіт, в случае если менеджер не инициализирован
		Если глПодключитьМенеджерЗвит1С() = 0 Тогда
			Возврат;
		КонецЕсли;
	
		// Концепция механизма выгрузки НН и П2 изменена начиная с "11q1001"
		// в связи с этим необходима информация о том что встроенный в конфигурацию
		// отчет "ЭкспортНалоговойНакладной" обновлен
		глРасшифровка.Установить("ИспользоватьОтчет_ЭкспортНалоговойНакладной", 1); 
		глРасшифровка.Установить("КонтекстФормыДокумента", Контекст); 
		
		глВыполнитьКомандуЗвит1С("ВыгрузитьДокумент", глРасшифровка);

	КонецЕсли;
	
КонецПроцедуры
// ===============================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр)
	СтарВидНДС      = ВидНДС;
	СтарыйВидОперации = ВидОперации;
	Если Рекв = "ВидНДС" Тогда
		глВыбратьНДС(Контекст);
		ИзмВидНДС();
		ИзмРеквизитШапки("ВидНДС");
		ФлагСтандОбр = 0;
	ИначеЕсли Рекв = "Выписал" Тогда
		ФлагСтандОбр = 0;
		КонтФирма = Фирма;
		ОткрытьФорму("Справочник.Сотрудники.ДляВыбора",КонтФирма);
	ИначеЕсли  Рекв = "ЛьготаНДС" Тогда
		ВыбратьЛьготу();
		ФлагСтандОбр = 0;	
	ИначеЕсли Рекв = "ВидДоговора" Тогда
	    ЗаполнитьВидДоговора();
		ФлагСтандОбр = 0;
	КонецЕсли;
КонецПроцедуры

// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|СтруктураПодчиненности,
	|ВводНаОсновании,
	|ОткрытьВЖурнале,
	|Подчиненные");  
	
ОбновитьБазуНДС = 0;