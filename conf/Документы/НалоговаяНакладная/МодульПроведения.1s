// ===============================
Функция ПроверкаШапки()
	глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
	глВыбранЛи(Фирма,"Фирма");
	Если ИтоговаяРозница = 0 Тогда
		глВыбранЛи(Контрагент,"Контрагент");
	КонецЕсли;	
	глВыбранЛи(ЧтоПродаем,"Что продаем");
	глВыбранЛи(ВидНДС,"Вид НДС");
	глВыбранЛи(Валюта,"Валюта");
	глВыбранЛи(Выписал,"Кто выписал накладную");
	Если ДатаДок >= '29.07.2005' Тогда
		глВыбранЛи(ВидОперации,"Вид операции");
	КонецЕсли;
	глВсеВыбрано = ?(глВсеВыбрано = 0, 0, глПроверкаНДСВДокументе(Контекст, Итог("СуммаБезНДС"), Итог("СуммаСНДС"), Итог("НДС")));
	Если ДатаДок >= '01/01/2015' Тогда
		Если ПродажаНижеОЦ=1 Тогда
			Инд = Сред(ТипПричины,2,2);
			Если (Инд = "01") и (БазаНДС = 0) Тогда   //01
				Сообщить("Указано неверное значение реквизита ""Тип причины"". Значение должно быть 12!'", "!"); 
			ИначеЕсли (Инд = "12") и (БазаНДС <> 0) Тогда   //12	                                                                                                                                       // разрешаем проводить
				Сообщить("Указано неверное значение реквизита ""Тип причины"". Значение должно быть 1!'", "!"); 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат глВсеВыбрано;
КонецФункции

// ===============================
Функция ПроверкаСтроки()
	глВсеВыбрано = 1;
	глВыбранЛи(ТМЦ,"ТМЦ",НомерСтроки);
	глВсеВыбрано = ?(глПроверкаТовараВДокументе(Контекст,ТМЦ,НомерСтроки,1)=Да, глВсеВыбрано, 0);
	Возврат глВсеВыбрано;
КонецФункции

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);

	Если ПроверкаШапки() = 0 Тогда
	    глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если ПроверкаСтроки() = 0 Тогда
		    глНеПроводить(Контекст);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
		
	Если (ПродажаНижеОЦ = 1) и (Валюта = Гривня) Тогда
		
		// сформируем проводки по НДС
		тбВидыТМЦ = СоздатьОбъект("ТаблицаЗначений"); 
		ВыгрузитьТабличнуюЧасть(тбВидыТМЦ);
		тбВидыТМЦ.НоваяКолонка("ВидДеятельности","Справочник.ВидыДеятельности");
		
		тбВидыТМЦ.ВыбратьСтроки();
		Пока тбВидыТМЦ.ПолучитьСтроку()=1 Цикл
			тбВидыТМЦ.ВидДеятельности = тбВидыТМЦ.ТМЦ.ВидДеятельности;
		КонецЦикла; 
		
		тбВидыТМЦ.Свернуть("ВидДеятельности","НДСПревышения");
		
		тбВидыТМЦ.УстановитьПараметрыКолонки("НДСПревышения","Число",13,2,,,,);   
		Разница = Окр(Итог("НДСПревышения"),2) - тбВидыТМЦ.Итог("НДСПревышения");
		    
		// распределим разницу, возникшую при округлении НДС по проводкам так, чтобы 
		// общая сумма проводок по НДС совпала с суммой НДС в табличной части документа
		Если Разница <> 0 Тогда
			тбВидыТМЦ.ВыбратьСтроки();
			Пока тбВидыТМЦ.ПолучитьСтроку() = 1 Цикл
				Если тбВидыТМЦ.НДСПревышения <>  0  Тогда
					Если (Разница < 0) и (тбВидыТМЦ.НДСПревышения + Разница < 0) Тогда
						Разница = Разница + тбВидыТМЦ.НДСПревышения;
						тбВидыТМЦ.НДСПревышения = 0;
					Иначе
						тбВидыТМЦ.НДСПревышения = тбВидыТМЦ.НДСПревышения + Разница;
						Прервать;
					КонецЕсли;
				КонецЕсли;          
			КонецЦикла;
		КонецЕсли;
		
		тбВидыТМЦ.ВыбратьСтроки();
		Пока тбВидыТМЦ.ПолучитьСтроку() = 1 Цикл
			глПроводка(Контекст,"70.4","64.1.5",тбВидыТМЦ.НДСПревышения,"НДС: доначисление по обычным ценам",, тбВидыТМЦ.ВидДеятельности,,,
					   ВидНДС,,, ,,"НК");
		КонецЦикла;			             
				
		Операция.СуммаОперации = Итог("НДСПревышения");
		Операция.Содержание = Примечание;
		Операция.Записать();
		
	ИначеЕсли ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента Тогда
		
		ПервыйДок = ?(ДокументОснование.Выбран() = 1,ДокументОснование,
		              ?(РодительскийДокумент.Выбран() = 1,РодительскийДокумент, ТекущийДокумент()));
		глПроводка(Контекст,"64.4.1","64.1.5",СуммаНДС,"НДС: работы, полученные от нерезидента",, Контрагент,ПервыйДок,,
		           ВидНДС,,, ,,"НК");
				   
		Операция.СуммаОперации = СуммаНДС;
		Операция.Содержание = Примечание;
		Операция.Записать(); 
		
	КонецЕсли;
	
	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры