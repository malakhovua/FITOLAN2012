
// ===============================
Функция ПроверкаШапки()
    глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
    глВыбранЛи(Фирма,"Фирма");
	Возврат глВсеВыбрано;    
КонецФункции

//=========================================
Функция СписатьОстаткиПоСчету(Счет);
	// Списывает остатки по любому счету. 
	
	СуммовойУчет1 = ?(Счет.КоличествоСубконто() > 0, Счет.УчетПоСумме(1), 0);
	СуммовойУчет2 = ?(Счет.КоличествоСубконто() > 1, Счет.УчетПоСумме(2), 0);
	СуммовойУчет3 = ?(Счет.КоличествоСубконто() > 2, Счет.УчетПоСумме(3), 0);
	
	КоличествоУровней = 0;
	КоличествоУровней = КоличествоУровней + ?(Счет.КоличествоСубконто() > 0, 1, 0);
	КоличествоУровней = КоличествоУровней + ?(Счет.КоличествоСубконто() > 1, 1, 0);
	КоличествоУровней = КоличествоУровней + ?(Счет.КоличествоСубконто() > 2, 1, 0);
	
	БухИт = СоздатьОбъект("БухгалтерскиеИтоги");
	БухИт.ИспользоватьРазделительУчета(Фирма);
	Если КоличествоУровней > 0 Тогда
		БухИт.ИспользоватьСубконто(Счет.ВидСубконто(1));
	КонецЕсли;
	
	Если КоличествоУровней > 1 Тогда
		БухИт.ИспользоватьСубконто(Счет.ВидСубконто(2));
	КонецЕсли;
	
	Если КоличествоУровней > 2 Тогда
		БухИт.ИспользоватьСубконто(Счет.ВидСубконто(3));
	КонецЕсли;
	
	БухИт.ВключатьСубсчета(-1);
	БухИт.ВыполнитьЗапрос(ДатаДок, ДатаДок, Счет);
	БухИт.ВыбратьСчета(1);
	Пока БухИт.ПолучитьСчет() = 1 Цикл
		
		ОстатокДтС = БухИт.СКД(1);
		ОстатокКтС = БухИт.СКК(1);
		Если (ОстатокДтС = 0) и (ОстатокКтС = 0) Тогда
			Продолжить;
		КонецЕсли;
			
		Если КоличествоУровней = 0 Тогда
			Если (ОстатокДтС <> 0) Тогда
				глПровНУ(Контекст,,БухИт.Счет,0,"НУ: закрытие остатков",, ,,, ,,, ,,"ЗО",ОстатокДтС);
				ОстатокДтС = 0;
			КонецЕсли;
			Если (ОстатокКтС <> 0) Тогда
				глПровНУ(Контекст,БухИт.Счет,,0,"НУ: закрытие остатков",, ,,, ,,, ,,"ЗО",ОстатокКтС);
				ОстатокКтС = 0;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
			
		флЦк = 0; флЦк2 = 0; флЦк3 = 0;
		Если (КоличествоУровней > 0) и ((ОстатокДтС<>0) или (ОстатокКтС<>0))  Тогда
			БухИт.ВыбратьСубконто(1); 
			флЦк = 1;
			Пока БухИт.ПолучитьСубконто(1) = 1 Цикл
				Если ТипЗначенияСтр(БухИт.Субконто(1)) = "Справочник" Тогда
					Если БухИт.Субконто(1).ЭтоГруппа() = 1 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				ОстатокДтС = БухИт.СКД(1);
				ОстатокКтС = БухИт.СКК(1);
				Если ((СуммовойУчет1 = 1) и (СуммовойУчет2 = 0)) или (КоличествоУровней = 1) Тогда
					Если (ОстатокДтС <> 0) Тогда
					    глПровНУ(Контекст,,БухИт.Счет,0,"НУ: закрытие остатков",, ,,, БухИт.Субконто(1),,, ,,"ЗО",ОстатокДтС);
						ОстатокДтС = 0;
					КонецЕсли;
					
					Если (ОстатокКтС <> 0) Тогда
					    глПровНУ(Контекст,БухИт.Счет,,0,"НУ: закрытие остатков",, БухИт.Субконто(1),,, ,,, ,,"ЗО",ОстатокКтС);
						ОстатокКтС = 0;
					КонецЕсли;
				КонецЕсли;
				
				Если КоличествоУровней > 1 Тогда
					БухИт.ВыбратьСубконто(2);
					флЦк2 = 1;
					Пока БухИт.ПолучитьСубконто(2) = 1 Цикл
						Если ТипЗначенияСтр(БухИт.Субконто(2)) = "Справочник" Тогда
							Если БухИт.Субконто(2).ЭтоГруппа() = 1 Тогда
								Продолжить;
							КонецЕсли;
						КонецЕсли;
						
						ОстатокДтС = БухИт.СКД(1);
						ОстатокКтС = БухИт.СКК(1);
						Если ((СуммовойУчет2 = 1) и (СуммовойУчет3 = 0)) или (КоличествоУровней = 2) Тогда
							Если (ОстатокДтС <> 0) Тогда
							    глПровНУ(Контекст,,БухИт.Счет,0,"НУ: закрытие остатков",, ,,, БухИт.Субконто(1),БухИт.Субконто(2),, ,,"ЗО",ОстатокДтС);
								ОстатокДтС = 0;
							КонецЕсли;
							
							Если (ОстатокКтС <> 0) Тогда
							    глПровНУ(Контекст,БухИт.Счет,0,,"НУ: закрытие остатков",, БухИт.Субконто(1),БухИт.Субконто(2),, ,,, ,,"ЗО",ОстатокКтС);
								ОстатокКтС = 0;
							КонецЕсли;
						КонецЕсли;	
						
						Если КоличествоУровней > 2 Тогда
							БухИт.ВыбратьСубконто(3);
							флЦк3 = 1;
							Пока БухИт.ПолучитьСубконто(3) = 1 Цикл
								Если ТипЗначенияСтр(БухИт.Субконто(3)) = "Справочник" Тогда
									Если БухИт.Субконто(3).ЭтоГруппа() = 1 Тогда
										Продолжить;
									КонецЕсли;
								КонецЕсли;
								
								ОстатокДтС = БухИт.СКД(1);
								ОстатокКтС = БухИт.СКК(1);
								Если (ОстатокДтС <> 0) Тогда
								    глПровНУ(Контекст,,БухИт.Счет,0,"НУ: закрытие остатков",, ,,, БухИт.Субконто(1),БухИт.Субконто(2),БухИт.Субконто(3), ,,"ЗО",ОстатокДтС);
									ОстатокДтС = 0;
								КонецЕсли;
								
								Если (ОстатокКтС <> 0) Тогда
								    глПровНУ(Контекст,БухИт.Счет,,0,"НУ: закрытие остатков",, БухИт.Субконто(1),БухИт.Субконто(2),БухИт.Субконто(3), ,,, ,,"ЗО",ОстатокКтС);
									ОстатокКтС = 0;
								КонецЕсли;
							КонецЦикла;
							Если (флЦк3 = 1) и ((ОстатокДтС<>0) или (ОстатокКтС<>0)) Тогда //Субконто 3 не заполнено
								ОстатокДтС = БухИт.СКД(1);
								ОстатокКтС = БухИт.СКК(1);
								Если (ОстатокДтС <> 0) Тогда
								    глПровНУ(Контекст,,БухИт.Счет,0,"НУ: закрытие остатков",, ,,, БухИт.Субконто(1),БухИт.Субконто(2),, ,,"ЗО",ОстатокДтС);
									ОстатокДтС = 0;
								КонецЕсли;
								
								Если (ОстатокКтС <> 0) Тогда
								    глПровНУ(Контекст,БухИт.Счет,,0,"НУ: закрытие остатков",, БухИт.Субконто(1),БухИт.Субконто(2),, ,,, ,,"ЗО",ОстатокКтС);
									ОстатокКтС = 0;
								КонецЕсли;
							КонецЕсли;	
						КонецЕсли;	
					КонецЦикла;
					Если (флЦк2 = 1) и ((ОстатокДтС<>0) или (ОстатокКтС<>0)) Тогда //Субконто 2 не заполнено
						ОстатокДтС = БухИт.СКД(1);
						ОстатокКтС = БухИт.СКК(1);
						Если (СуммовойУчет2 = 1) и (СуммовойУчет3 = 1) Тогда
							Если (ОстатокДтС <> 0) Тогда
							    глПровНУ(Контекст,,БухИт.Счет,0,"НУ: закрытие остатков",, ,,, БухИт.Субконто(1),,, ,,"ЗО",ОстатокДтС);
								ОстатокДтС = 0;
							КонецЕсли;
							
							Если (ОстатокКтС <> 0) Тогда
							    глПровНУ(Контекст,БухИт.Счет,,0,"НУ: закрытие остатков",, БухИт.Субконто(1),,, ,,, ,,"ЗО",ОстатокКтС);
								ОстатокКтС = 0;
							КонецЕсли;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;
			Если (флЦк = 1) и ((ОстатокДтС<>0) или (ОстатокКтС<>0))  Тогда //Субконто не заполнено
				ОстатокДтС = БухИт.СКД(1);
				ОстатокКтС = БухИт.СКК(1);
				Если (СуммовойУчет1 = 1) и (СуммовойУчет2 = 1) Тогда
					Если (ОстатокДтС <> 0) Тогда
						глПровНУ(Контекст,,БухИт.Счет,,"НУ: закрытие остатков",, ,,, ,,, ,,"ЗО",ОстатокДтС);
						ОстатокДтС = 0;
					КонецЕсли;
					
					Если (ОстатокКтС <> 0) Тогда
						глПровНУ(Контекст,БухИт.Счет,,,"НУ: закрытие остатков",, ,,, ,,, ,,"ЗО",ОстатокКтС);
						ОстатокКтС = 0;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
КонецФункции // ВыгрузитьОстаткиПоСчету()
// ===============================
Процедура ПолучитьИтогиПоСчетам()
	
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ВключатьСубсчета(-1);
	Ит.ВыполнитьЗапрос(,ДатаДок);
	Ит.ВыбратьСчета();
	Пока Ит.ПолучитьСчет() = 1 Цикл
		Если (Лев(Ит.Счет.Код,1) <> "Н") или (Лев(Ит.Счет.Код,2) = "НА") Тогда
			Продолжить;
		КонецЕсли;
		Если  (Лев(Ит.Счет.Код,3) = "Н10") или (Лев(Ит.Счет.Код,3) = "Н11") или (Лев(Ит.Счет.Код,3) = "Н12") или 
			  (Лев(Ит.Счет.Код,3) = "Н13") Тогда
			Продолжить;
		КонецЕсли;
		СписатьОстаткиПоСчету (Ит.Счет);
	КонецЦикла;
КонецПроцедуры
// ===============================
Процедура ПолучитьОстаткиПоПартиям()
	
	ЗапросПартии = СоздатьОбъект("Запрос");
	ТекстЗапрПарт = 	"//{{ЗАПРОС()
	|С ДатаДок По ДатаДок;
	|Обрабатывать НеПомеченныеНаУдаление;
	|_Фирма			= Регистр.Партии.Фирма;
	|_Счет			= Регистр.Партии.Счет;
	|_МестоХранения	= Регистр.Партии.МестоХранения;
	|_ТМЦ			= Регистр.Партии.ТМЦ;
	|_ПрихДокумент	= Регистр.Партии.ПрихДокумент;
	|Пост			= Регистр.Партии.Поставщик;
	|Поставка		= Регистр.Партии.Поставка;
	|_ОтклонНУ = Регистр.Партии.ОтклонениеНУ;
	|Функция ОтклонНУ = КонОст(_ОтклонНУ);
	|Группировка _ТМЦ;
	|Группировка _Счет;
	|Группировка _ПрихДокумент;
	|Условие(_Фирма = Фирма);
	|Условие(_ОтклонНУ <> 0);
	|"//}}ЗАПРОС
	;
	Если ЗапросПартии.Выполнить(ТекстЗапрПарт) = 0 Тогда
		глКомментарий("Не выполнился запрос по регистру Производственные затраты!",0);
		Возврат; 
	КонецЕсли;  
	
	Пока ЗапросПартии.Группировка("_ТМЦ") = 1 Цикл
		Пока ЗапросПартии.Группировка("_Счет") = 1 Цикл
			Пока ЗапросПартии.Группировка("_ПрихДокумент") = 1 Цикл
				глПровестиПартию(Контекст, 0,0, Фирма, ЗапросПартии._ТМЦ, ЗапросПартии._Счет, ЗапросПартии._МестоХранения, ЗапросПартии.Пост,
				ЗапросПартии.Поставка, ЗапросПартии._ПрихДокумент,0,0,0, "Закрытие остатков",0,0,0,0,ЗапросПартии.ОтклонНУ);
			КонецЦикла;          
		КонецЦикла;          
	КонецЦикла;          

КонецПроцедуры
// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);

	Если ПроверкаШапки() = 0 Тогда
	    глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли;
	
	Если (ДатаДок>='01.01.2015') и (ДатаДок<='31.12.2015') Тогда
		ПолучитьИтогиПоСчетам(); 
		ПолучитьОстаткиПоПартиям();
	Иначе	
        глКомментарий("Документ предназначен для закрытия остатков по налоговым счетам только в 2015 году!",0,,"!");
	КонецЕсли;
	
	Операция.СуммаОперации = 0;	
	Операция.Содержание = "Закрытие остатков по налоговым счетам"+Примечание;
	Операция.Записать();
	глКомментарий("Окончание",2,Контекст);
КонецПроцедуры
