Перем ноНДФЛ, ноНДФЛ2, ноНДФЛШахт, ноЛьготаНДФЛ, ноПрожМинимум, ноВоенСбор;
Перем Таб, Пк1, Пк2, Пк3, Пк4, Пк5, Пк6, Пк7, Пк8, ДатаВед, Директор, ГлавБух;
Перем ТаблСотр;
Перем НиО, НМ, НачалоПериода, КонецПериода, Спис, стПрофсоюзный, МаксБазаБезр;
Перем Надо, ФИОПолностью;
Перем СписокДействий;
Перем НачальнаяДатаДокумента;
Перем СуммаЛьготыНДФЛ, ПорогЛьготыНДФЛ, КоэфЛьготыНДФЛ;
Перем КоэфИндексации, фПерваяИндексация, ДатаНачалаРасчетаИндексацииПоФирме;
Перем Организация, ЕДРПОУ, КвоДнейНач, КвоДнейРаб;
Перем ноЕСВСотр, ноЕСВБольн, МаксБазаЕСВ, стЕСВБолн, стЕСВ,ПрожМинимум;

// Служебная переменная, используется для корректной установки видимости/доступности при 
// открытии документа
Перем УстДоступностьПоВидуНачисления;


//*******************************************************************************************************
// Индексация

// ===============================
Процедура СоздатьТбИндексИнфляции(НП)
	Перем ноИндексИнфляции;

	спДоп = СоздатьОбъект("СписокЗначений");
	глПолучитьНиО(ноИндексИнфляции, "ИндексИнфл", "о индексе инфляции");
	
	глТбИндексИнфляции = СоздатьОбъект("ТаблицаЗначений");
	глТбИндексИнфляции.НоваяКолонка("Месяц","Дата");
	глТбИндексИнфляции.НоваяКолонка("Коэф","Число",7,4);
	глТбИндексИнфляции.НоваяКолонка("Порог","Число",7,4);
	глТбИндексИнфляции.НоваяКолонка("Контролька","Число",1,0);
	
	Периодический = СоздатьОбъект("Периодический");
	Периодический.ИспользоватьОбъект("Ставка",ноИндексИнфляции); 
	Периодический.ВыбратьЗначения();
	Пока Периодический.ПолучитьЗначение() = 1 Цикл
		глПарсить(ноИндексИнфляции.Дополнительно.Получить(НачМесяца(Периодический.ДатаЗнач)),спДоп);
		ПорогИндексации = Число(спДоп.Получить("ПорогИндексации"));
		глТбИндексИнфляции.НоваяСтрока();
		глТбИндексИнфляции.Месяц = НачМесяца(Периодический.ДатаЗнач);
		глТбИндексИнфляции.Порог = ПорогИндексации;
		глТбИндексИнфляции.Коэф = Периодический.Значение;
		глТбИндексИнфляции.Контролька = 1;
	КонецЦикла; 
КонецПроцедуры

// =============================== 
// проверить корректно ли заполнен периодический реквизит
Процедура ПроверитьТбИндексИнфляции(знач НачМесяц = '01.03.03', ОкПериода)
	Если ПустоеЗначение(НачМесяц) = 1  Тогда
		НачМесяц = глДатаНачалаРасчетаИндексации;
	КонецЕсли;           
	тб = СоздатьОбъект("ТаблицаЗначений");
	глТбИндексИнфляции.Выгрузить(тб);
	тб.Свернуть("Месяц","Контролька");
	тб.Сортировать("Месяц");
	
	ОкПериодаДляПроверки = НачМесяца( ДобавитьМесяц(ОкПериода,-2) );
	тб.ВыбратьСтроки();    
	Пока тб.ПолучитьСтроку() = 1 Цикл  
		Если НачМесяц > тб.Месяц Тогда 
			Продолжить;
		КонецЕсли;
		Если НачМесяц > ОкПериодаДляПроверки Тогда   
			Прервать;
		КонецЕсли;
		Если (тб.Месяц <= НачМесяца(ОкПериода)) Тогда 
			Пока (тб.Месяц <> НачМесяц) и (НачМесяц  <= ОкПериодаДляПроверки) Цикл
				глКомментарий("За " + Формат(НачМесяц,"ДММММГГ") + " нет информации об индексе инфляции",0);
				НачМесяц = ДобавитьМесяц(НачМесяц, 1);
			КонецЦикла;
			Если тб.Контролька > 1 Тогда
				глКомментарий("За " + Формат(НачМесяц,"ДММММГГ") + " обнаружено " + тб.Контролька + " знач. индекса инфляции",0);
			КонецЕсли;
		КонецЕсли; 
		НачМесяц = ДобавитьМесяц(НачМесяц, 1);
	КонецЦикла; 
	
	КонПериода = НачМесяца(ДобавитьМесяц(ОкПериода,-2));

	Если НачМесяц < КонПериода Тогда
		глКомментарий("За период " + ПериодСтр(НачМесяца(НачМесяц),КонМесяца(КонПериода)) + " нет информации об индексе инфляции",0);
	КонецЕсли;
	
	Пока НачМесяц = КонПериода Цикл
		глКомментарий("За " + Формат(НачМесяц,"ДММММГГ") + " нет информации об индексе инфляции",0);
		НачМесяц = ДобавитьМесяц(НачМесяц, 1);
	КонецЦикла;
	
	тб = "";
КонецПроцедуры
                                           
//=====================================
//ОкПериода  - дата на которую делается расчет
Функция ПолучитьКоэффициентИндексации(знач НачПериода, знач ОкПериода)
	Перем ПорогИндексацииТек,ноИндексИнфляции;  
	
	Если ОкПериода < НачПериода Тогда
	    Возврат 0;
	КонецЕсли;
	
	Коэф = 1; 
	ТекКоэф = 1; //для перемножения коэф до достижения порога индексации  

	спДоп = СоздатьОбъект("СписокЗначений");
	глПолучитьНиО(ноИндексИнфляции, "ИндексИнфл", "о индексе инфляции");
	глПарсить(ноИндексИнфляции.Дополнительно.Получить(ОкПериода),спДоп);
	ПорогИндексацииТек = Число(спДоп.Получить("ПорогИндексации"));
	
	СоздатьТбИндексИнфляции(НачПериода);
	ПроверитьТбИндексИнфляции(НачПериода, ОкПериода);
	                                   
	НачПериода = НачМесяца(НачПериода); 
	НачИнд = "";
	глТбИндексИнфляции.НайтиЗначение(НачПериода, НачИнд,"Месяц");  
	ОкПериода = НачМесяца(ДобавитьМесяц(ОкПериода, -2)); 
	КонИнд = "";                 

	глТбИндексИнфляции.НайтиЗначение(ОкПериода, КонИнд,"Месяц");  
	Если (НачИнд > 0) и (КонИнд > 0) Тогда
		Для Инд = НачИнд По КонИнд Цикл  
			глТбИндексИнфляции.ПолучитьСтрокуПоНомеру(Инд); 
			ТекКоэф = ТекКоэф * глТбИндексИнфляции.Коэф;
			глКомментарий("---За "+ глТбИндексИнфляции.Месяц + " Текущий коэф = " + ТекКоэф,3);
			Если Константа.ПорогИндексацииПомесячно = Да Тогда
				ПорогИндексацииТек = глТбИндексИнфляции.Порог;
			КонецЕсли;
			Если Окр(ТекКоэф, 3) > ПорогИндексацииТек Тогда
				Коэф = Коэф * Окр(ТекКоэф, 3); 
				ТекКоэф = 1;
			КонецЕсли;  
			глКомментарий("За "+ глТбИндексИнфляции.Месяц + " Коэф = "+ Окр(Коэф,3),3);

		КонецЦикла;
	КонецЕсли;
	
	Сообщить("Для сотрудника " + Сотрудник + " итоговый коэффициент индексации равен "+Окр(Коэф,3));
	
	Возврат Окр(Коэф,3) - 1;
КонецФункции

//********************************************************************************************************

// ===============================
// Назначение:
//		Определяет к-во произвольных начислений
// Аргументы:
//		Режим = 0	- к-во непустых произвольных начислений
//		Режим = 1	- общее к-во произвольных начислений
// Возвращает:
//		для режима 1 - количество произвольных начислений, 
//		для режима 0 - фактически номер последнего непустого 
// 		произвольного начисления 
Функция ПолучитьКвоПроизвольныхНачислений(Режим=0)
Перем КвоНач, КвоНепустыхНач;
	КвоНач = 0; 
	КвоНепустыхНач = 0;
	
	Пока глЕстьРеквизитШапки("Начисл"+(КвоНач+1), "НачислениеЗП") = Да Цикл
		// в документе есть реквизит НачислХХХ
		КвоНач = КвоНач + 1;
		
		Если ПустоеЗначение(ПолучитьАтрибут("Начисл"+КвоНач)) = 0 Тогда
			// очередное произв. начисление оказалось непустым
			// запомним номер этого начисления, 
			// (кво начислений будем считать равным номеру последнего непустого 
			//  начисления, при этом могут быть начисления с меньшим номером,
			//  которые не выбраны)
			КвоНепустыхНач = КвоНач;
		КонецЕсли;
	КонецЦикла;
	
	Если Режим = 0 Тогда
		Возврат КвоНепустыхНач;
	Иначе
		Возврат КвоНач;
	КонецЕсли;
КонецФункции //ПолучитьКвоПроизвольныхНачислений()

// ===============================
Процедура УстВидНачисления()
	// доступность/видимость в зависимости от вида начисления
	фОсн = ?(ВидНачисления = ОсновнаяЗП, 1, 0);
	Форма.колНеРассчитан.Видимость(фОсн);
	Форма.Дней.Доступность(фОсн);
	Форма.Часов.Доступность(фОсн);
	Форма.кРассчитать.Доступность(фОсн);
	Форма.ОтработаноДней.Видимость(фОсн);
	Форма.Оклад.Видимость(фОсн);
	Форма.Тариф.Видимость(фОсн);
	Форма.Сдельно.Видимость(фОсн);
	Форма.Премия.Видимость(фОсн);
	Форма.Больничные.Видимость(фОсн);
	Форма.БольничныеЗаСчетПредприятия.Видимость(фОсн);
	Форма.ОблагаемаяМатПомощь.Видимость(фОсн);
	Форма.НеоблагаемаяМатПомощь.Видимость(фОсн);
	Форма.Отпускные.Видимость(фОсн);
	Форма.Начислено.Видимость(фОсн);
	Форма.НачисленоПоДругимВыплатам.Видимость(фОсн);
	Форма.Подоходный.Видимость(фОсн);
	Если ДатаДок < глДатаПереходаНаЕСВ Тогда
		Форма.Пенсионный.Видимость(фОсн);
		Форма.Безработица.Видимость(фОсн);
		Форма.СтрахНетрудосп.Видимость(фОсн);  
		Форма.ЕдиныйВзнос.Видимость(0); 
	Иначе
		Форма.ЕдиныйВзнос.Видимость(фОсн);  
		Форма.Пенсионный.Видимость(0);
		Форма.Безработица.Видимость(0);
		Форма.СтрахНетрудосп.Видимость(0);  
	КонецЕсли;
	Если (ДатаДок < Дата('01.08.14')) Тогда
		Форма.ВоенныйСбор.Видимость(0);
		Форма.ВоенныйСборПоДругимВыплатам.Видимость(0);
	Иначе
		Форма.ВоенныйСбор.Видимость(фОсн);  
		Форма.ВоенныйСборПоДругимВыплатам.Видимость(фОсн);
	КонецЕсли;
	Если (ДатаДок < Дата('01.01.16')) и (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда
		Форма.ЕдиныйВзнос.Видимость(1);
		Форма.ЕСВПоДругимВыплатам.Видимость(1);
	ИначеЕсли (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда
		Форма.ЕдиныйВзнос.Видимость(0);  
		Форма.ЕСВПоДругимВыплатам.Видимость(0);  
	КонецЕсли;
	Если (ДатаДок < Дата('01.01.17')) или (ВидНачисления <> Перечисление.ВидыНачисленияЗП.ОсновнаяЗП) Тогда
		Форма.ДоплДоМнЗП.Видимость(0);  
	Иначе
		Форма.ДоплДоМнЗП.Видимость(1);
	КонецЕсли;
	Форма.Профсоюзный.Видимость(фОсн);
	Форма.Удержано.Видимость(фОсн);
	Форма.КВыплате.Видимость(фОсн);
	Форма.КВыплатеПоДругимВыплатам.Видимость(фОсн);
	Форма.Начислено.Доступность(1-фОсн);
	Форма.КВыплате.Доступность(1-фОсн);
	Форма.ОсталосьВыплатить.Видимость(0);
	Форма.НачисленоПоДругимВыплатам.Доступность(1-фОсн);
	Форма.КВыплатеПоДругимВыплатам.Доступность(1-фОсн);
	Форма.ОсталосьВыплатитьПоДругимВыплатам.Видимость(0);
	Если ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс Тогда
		Форма.КВыплате.Видимость(1);
		Форма.КВыплатеПоДругимВыплатам.Видимость(1);
		Форма.Дней.Доступность(1);
		Форма.Часов.Доступность(1);
		Форма.кРассчитать.Доступность(1);
		Форма.ОтработаноДней.Видимость(1);
	ИначеЕсли ВидНачисления = Перечисление.ВидыНачисленияЗП.Остатки Тогда
		Форма.Начислено.Видимость(1);
		Форма.Подоходный.Видимость(1);
		Форма.КВыплате.Видимость(1);
		Форма.ОсталосьВыплатить.Видимость(1);
		Форма.НачисленоПоДругимВыплатам.Видимость(1);
		Форма.КВыплатеПоДругимВыплатам.Видимость(1);
		Форма.ОсталосьВыплатитьПоДругимВыплатам.Видимость(1);
	КонецЕсли;
	Если фОсн = 0 Тогда
		Инд = Форма.Закладки.НайтиЗначение("Дополнительный");
		Если Инд <> 0 Тогда
			// удалим закладку
			Форма.Закладки.УдалитьЗначение(Инд);
		КонецЕсли;
		Инд = Форма.Закладки.НайтиЗначение("ПроизвольныеНачисления");
		Если Инд <> 0 Тогда
			// удалим закладку
			Форма.Закладки.УдалитьЗначение(Инд);
		КонецЕсли;
	Иначе
		Если Форма.Закладки.НайтиЗначение("Дополнительный") = 0 Тогда
			// добавим закладку
			Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
		КонецЕсли;
		Если Форма.Закладки.НайтиЗначение("ПроизвольныеНачисления") = 0 Тогда
			// добавим закладку
			Форма.Закладки.ДобавитьЗначение("ПроизвольныеНачисления","Произвольные начисления");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Функция УстДоступность()
	Форма.кОчиститьПодразделение.Доступность(Подразделение.Выбран());
	Форма.кОчиститьВидДеятельности.Доступность(ВидДеятельности.Выбран());
	
	КвоНач = ПолучитьКвоПроизвольныхНачислений(1); // к-во всех начислений
	Для НомНач = 1 по КвоНач Цикл
		Начисл = ПолучитьАтрибут("Начисл"+НомНач);
		Форма.ПолучитьАтрибут("кОчиститьНачисл"+НомНач).Доступность(Начисл.Выбран());
		Форма.ПолучитьАтрибут("тВидЗатратНачисл"+НомНач).Доступность(Начисл.Выбран());
		Форма.ПолучитьАтрибут("ВидЗатратНачисл"+НомНач).Доступность(Начисл.Выбран());
		Форма.ПолучитьАтрибут("СуммаНачисл"+НомНач).Доступность(Начисл.Выбран());
		Форма.ПолучитьАтрибут("СуммаНачисл"+НомНач).Заголовок(?(Начисл.Выбран()=1,Начисл.Наименование,""));
	КонецЦикла;

	Если (Итог("НеРассчитан")>0) И (ВидНачисления = ОсновнаяЗП) Тогда
		НуженРасчет = 1;
	Иначе // не надо
		НуженРасчет = 0;
	КонецЕсли;
	Форма.фНуженРасчет.Видимость(НуженРасчет);
	Форма.кОК.Доступность(1-НуженРасчет);
	Форма.кПровести.Доступность(1-НуженРасчет);

	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);

	Если ВидНачисления = ОсновнаяЗП Тогда
		Форма.Индексация.Видимость(1);
		Форма.кПечатьОсн.Видимость(1);
		Форма.кПечатьПроч.Видимость(0);
		Форма.кПечатьОсн.Доступность(Проведен()*(1 - Модифицированность()));
	Иначе
		Форма.Индексация.Видимость(0);
		Форма.кПечатьОсн.Видимость(0);
		Форма.кПечатьПроч.Видимость(1);
	КонецЕсли;
	
	Если УстДоступностьПоВидуНачисления = 1 Тогда
		УстВидНачисления();
		УстДоступностьПоВидуНачисления = 0;
	КонецЕсли;
	Форма.Фирма.Видимость(0);
	Форма.Заголовок(глЗаголовок(Контекст,"Начисление з/п")); 
	
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кПровести.Доступность(0);
		Форма.кЗаполнить.Доступность(0);
		Форма.кРассчитать.Доступность(0);
		Форма.кПечатьОсн.Доступность(0);
		Форма.кПечатьПроч.Доступность(0);
		Форма.кФирма.Доступность(0);               		
		Форма.кОчиститьПодразделение.Доступность(0);
		Форма.кОчиститьВидДеятельности.Доступность(0);
		КвоНач = ПолучитьКвоПроизвольныхНачислений(1); // к-во всех начислений
		Для НомНач = 1 по КвоНач Цикл
			Форма.ПолучитьАтрибут("кОчиститьНачисл"+НомНач).Доступность(0);
		КонецЦикла;
	КонецЕсли; 
	Если (ДатаДок < Дата('01.08.14')) и (ВидНачисления = ОсновнаяЗП) Тогда
		Форма.ВоенныйСбор.Видимость(0);
		Форма.ВоенныйСборПоДругимВыплатам.Видимость(0);
	ИначеЕсли (ВидНачисления = ОсновнаяЗП) Тогда
		Форма.ВоенныйСбор.Видимость(1);  
		Форма.ВоенныйСборПоДругимВыплатам.Видимость(1);  
	КонецЕсли;
	Если (ДатаДок < Дата('01.01.17')) или (ВидНачисления <> Перечисление.ВидыНачисленияЗП.ОсновнаяЗП) Тогда
		Форма.ДоплДоМнЗП.Видимость(0);  
	Иначе
		Форма.ДоплДоМнЗП.Видимость(1);
	КонецЕсли;
	Если (ДатаДок < Дата('01.01.16')) и (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда
		Форма.ЕдиныйВзнос.Видимость(1);
		Форма.ЕСВПоДругимВыплатам.Видимость(1);
	ИначеЕсли (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда
		Форма.ЕдиныйВзнос.Видимость(0);  
		Форма.ЕСВПоДругимВыплатам.Видимость(0);  
	КонецЕсли;

	Возврат "";
КонецФункции

// ======================================
Процедура ИзмФирма()
	СтараяФирма = глВосстановитьЗначение(Вид(),"СтараяФирма");
	Если СтараяФирма <> Фирма Тогда
		// фирма изменилась
		Если КоличествоСтрок() > 0 Тогда
			Рез = Вопрос("Табличная часть будет очищена!","Да+Нет");
			Если Рез = "Да" Тогда
				УдалитьСтроки();
			ИначеЕсли ПустоеЗначение(СтараяФирма) = 0 Тогда
				// восстановим фирму, которая была выбрана раньше
				Фирма = СтараяФирма;
				глУстановитьНомер(Контекст);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 
// ======================================
Процедура ИзмПодразделение()
	Если Подразделение.Выбран() = 0 Тогда  
		Возврат;
	КонецЕсли;
	Если Подразделение.ТипПодразделения = Перечисление.ТипыПодразделений.Производственное Тогда
	    ВидЗатратСоцОтчисления = Константа.ВидЗатратСоцОтчислПроизв;
	ИначеЕсли Подразделение.ТипПодразделения = Перечисление.ТипыПодразделений.Обслуживающее Тогда
	    ВидЗатратСоцОтчисления = Константа.ВидЗатратСоцОтчислОбщепр;
	ИначеЕсли Подразделение.ТипПодразделения = Перечисление.ТипыПодразделений.Административное Тогда
	    ВидЗатратСоцОтчисления = Константа.ВидЗатратСоцОтчислАдминистр;
	Иначе
	    ВидЗатратСоцОтчисления = Константа.ВидЗатратСоцОтчислСбыт;
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура ИзмВидНачисления()
	УстВидНачисления();
КонецПроцедуры 
// ===============================
Процедура ИзмДней()
	КвоДнейНач = 0;
КонецПроцедуры
// ===============================
Процедура ИзмДатаДок()
    Если (ВидНачисления = ОсновнаяЗП) Тогда
		Форма.Индексация.Видимость(1);
	Иначе
		Форма.Индексация.Видимость(0);
	КонецЕсли;
	фОсн = ?(ВидНачисления = ОсновнаяЗП, 1, 0);
	Если ДатаДок < глДатаПереходаНаЕСВ Тогда
		Форма.Пенсионный.Видимость(фОсн);
		Форма.Безработица.Видимость(фОсн);
		Форма.СтрахНетрудосп.Видимость(фОсн);  
		Форма.ЕдиныйВзнос.Видимость(0); 
	Иначе
		Форма.ЕдиныйВзнос.Видимость(фОсн);  
		Форма.Пенсионный.Видимость(0);
		Форма.Безработица.Видимость(0);
		Форма.СтрахНетрудосп.Видимость(0);  
	КонецЕсли;
	Если (ДатаДок >= Дата('01.01.17')) и (ВидНачисления = ОсновнаяЗП) Тогда
		Форма.ДоплДоМнЗП.Видимость(1);
	Иначе
		Форма.ДоплДоМнЗП.Видимость(0);  
	КонецЕсли;
КонецПроцедуры


// ===============================
Процедура ПриВыбореЗакладки(Номер,Значение)
	Форма.ИспользоватьСлой("Общий,"+Значение,2);
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()  
	НачальнаяДатаДокумента = ДатаДок;
	глПроверкаДатыДок(Контекст,"Открытие");
	ПриЗаписиПерепроводить(1);
	
	// Если открыли только на просмотр, то надо кнопки сделать недоступными
	Если Форма.ТолькоПросмотр()=1 Тогда
		Форма.кОК.Доступность(0);
		Форма.кПровести.Доступность(0);
		Форма.кЗаполнить.Доступность(0);
		Форма.кРассчитать.Доступность(0);
		Форма.кФирма.Доступность(0);               		
		Форма.кОчиститьПодразделение.Доступность(0);               		
		Форма.кОчиститьВидДеятельности.Доступность(0);               		
		Форма.кОчиститьНачисл1.Доступность(0);               		
		Форма.кОчиститьНачисл2.Доступность(0);               		
		Форма.кОчиститьНачисл3.Доступность(0);               		
		//Форма.КнопкаПоУмолчанию("кЗакрыть");
	Иначе
		Форма.КнопкаПоУмолчанию("кОК");
	КонецЕсли;	

	Форма.ИспользоватьЗакладки(1);
	Форма.Закладки.ДобавитьЗначение("Основной","Основные");
	Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
	Форма.Закладки.ДобавитьЗначение("ПроизвольныеНачисления","Произвольные начисления");
	Форма.ИспользоватьСлой("Общий,Основной",2);
	
	КвоДнейНач = КолРабДнейНачало;   
	
	КвоДнейРаб = Дней;
	// доступность/видимость в зависимости от вида начисления
	УстДоступностьПоВидуНачисления = 1;
КонецПроцедуры

// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
		глУстановитьНомер(Контекст);
		Возврат;
	КонецЕсли;
	Фирма = глВосстановитьЗначение(,"БазФирма");
	глУстановитьНомер(Контекст);
	Дней = 22;
	Часов = 176; // т.е. 22 дня * 8 часов
	ВидНачисления = ОсновнаяЗП;
	НеРассчитан = 1;
	ВидЗатратЗарплата = глВосстановитьЗначение(Контекст,"ВидЗатратЗарплата");
	ВидЗатратПремии = глВосстановитьЗначение(Контекст,"ВидЗатратПремии");
	ВидЗатратОтпускные = глВосстановитьЗначение(Контекст,"ВидЗатратОтпускные");
	ВидЗатратБольничные = глВосстановитьЗначение(Контекст,"ВидЗатратБольничные");
	ВидЗатратПрочие = глВосстановитьЗначение(Контекст,"ВидЗатратПрочие");
	ВидЗатратИндексация = глВосстановитьЗначение(Контекст,"ВидЗатратИндексация");
	ВидЗатратСоцОтчисления = глВосстановитьЗначение(Контекст,"ВидЗатратСоцОтчисления");
	СчетБольнП = глВосстановитьЗначение(Контекст,"СчетБольнП",
				?(Константа.ИспользоватьСчетаРасходов=Класс9,СчетПоКоду("94.9"),СчетПоКоду("84")));
	СчетБольнФОТ = глВосстановитьЗначение(Контекст,"СчетБольнФОТ",
				?(Константа.ИспользоватьСчетаРасходов=Класс9,СчетПоКоду("94.9"),СчетПоКоду("84")));
	ВидЗатратБольнФОТ = глВосстановитьЗначение(Контекст,"ВидЗатратБольнФОТ");
	СчетДопБазаФОТ = глВосстановитьЗначение(Контекст,"СчетДопБазаФОТ",
				?(Константа.ИспользоватьСчетаРасходов=Класс9,СчетПоКоду("94.9"),СчетПоКоду("84")));
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()
	глПроверкаДатыДок(Контекст,"Запись");
	Если глКонтрольДатыДокумента(Контекст, НачальнаяДатаДокумента)=1 Тогда
		СтатусВозврата(0);
	КонецЕсли;
	Автор = глПользователь;
	глСохранитьЗначение(Контекст,"ВидЗатратСоцОтчисления", ВидЗатратСоцОтчисления);
	глСохранитьЗначение(Контекст,"ВидЗатратЗарплата", ВидЗатратЗарплата);
	глСохранитьЗначение(Контекст,"ВидЗатратПремии", ВидЗатратПремии);
	глСохранитьЗначение(Контекст,"ВидЗатратОтпускные", ВидЗатратОтпускные);
	глСохранитьЗначение(Контекст,"ВидЗатратБольничные", ВидЗатратБольничные);
	глСохранитьЗначение(Контекст,"ВидЗатратПрочие", ВидЗатратПрочие);
	глСохранитьЗначение(Контекст,"ВидЗатратИндексация", ВидЗатратИндексация);
	глСохранитьЗначение(Контекст,"СчетБольнП", СчетБольнП);
	глСохранитьЗначение(Контекст,"СчетБольнФОТ", СчетБольнФОТ);
	глСохранитьЗначение(Контекст,"СчетДопБазаФОТ", СчетДопБазаФОТ);
	глСохранитьЗначение(Контекст,"ВидЗатратБольнФОТ", ВидЗатратБольнФОТ);
	глПроверкаДатыДок(Контекст,"Запись");
	КолРабДнейНачало =  КвоДнейНач;
КонецПроцедуры

// ===============================
Процедура ВычКВыплате()
	КВыплате = Начислено - Удержано;
	Если (Начислено - НачисленоПоДругимВыплатам) >= Удержано Тогда
		КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам;
	ИначеЕсли НачисленоПоДругимВыплатам <> 0 Тогда
		//Вычитаем только если не покрыли все из основных начислений
		КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам - (Удержано-(Начислено-НачисленоПоДругимВыплатам));
	Иначе
		КВыплатеПоДругимВыплатам = 0;
	КонецЕсли;	
КонецПроцедуры //ВычКВыплате

// ===============================
Процедура ВычИндексация()
	
	Если Сотрудник.ТипСотрудника.Получить(КонМесяца(ДатаДок)) = 0 Тогда
		//По совместителю индексацию не делаем
		Индексация = 0;
		Возврат;
	КонецЕсли;	
	
	Если фПерваяИндексация=1  Тогда
		ДатаНачалаРасчетаИндексацииПоФирме = глПрочитатьДатуИзмененияДоходаДляИндексации(ДатаДок,"ПризнакИзмененияДоходаДляИндексации",Фирма);
		фПерваяИндексация = 0;
	КонецЕсли;	
	ДатаНачалаРасчетаИндексацииПоСотруднику = ДобавитьМесяц(глДатаНачалаРасчетаИндексации, -1);

	Если (ДатаДок < '01.12.2015') или (Сотрудник.Перемещение.Получить(КонМесяца(ДатаДок)) = 0) Тогда
		ДатаНачалаРасчетаИндексацииПоСотруднику = глПрочитатьДатуИзмененияДоходаДляИндексации(ДатаДок,"ПризнакИзмененияДоходаДляИндексации",Сотрудник);
	КонецЕсли;	
	ДатаНачалаРасчетаИндексации = Макс(ДатаНачалаРасчетаИндексацииПоСотруднику, ДатаНачалаРасчетаИндексацииПоФирме); 

	глКомментарий("Вычисление коэф. индексации для сотрудника "+ Сотрудник,3);
	КоэфИндексации = ПолучитьКоэффициентИндексации(ДатаНачалаРасчетаИндексации, НачМесяца(ДатаДок));
	
	//здесь будет расчет индексации
	БазаИндексации = Оклад + Тариф + Сдельно
		             + ?(Начисл1.Индексируется=Да, СуммаНачисл1, 0)
		             + ?(Начисл2.Индексируется=Да, СуммаНачисл2, 0)
		             + ?(Начисл3.Индексируется=Да, СуммаНачисл3, 0);
	
	ПрожМинимум = ноПрожМинимум.Предел.Получить(НачМесяца(ДатаДок));
	Если БазаИндексации > ПрожМинимум Тогда
		//База индексации ограничена прожиточным минимум
		БазаИндексации = ПрожМинимум;
	КонецЕсли;	
	
	Индексация = БазаИндексации*КоэфИндексации;
КонецПроцедуры	

// ===============================
Процедура ВычНачислено()
	Начислено = Оклад + Тариф + Сдельно + Премия + Больничные + 
				БольничныеЗаСчетПредприятия + Отпускные +
				ОблагаемаяМатПомощь + НеоблагаемаяМатПомощь;
				
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	Для НомНач = 1 по КвоНач Цикл
		Начислено = Начислено + ПолучитьАтрибут("СуммаНачисл"+НомНач);
	КонецЦикла;
	
	НачисленоПоДругимВыплатам = Больничные + БольничныеЗаСчетПредприятия + НеоблагаемаяМатПомощь;
	
	Индексация = 0;
	Если (Сотрудник.ТипСотрудника.Получить(КонМесяца(ДатаДок)) = 1) Тогда
		НеРассчитан = 1;
	Иначе
		НеРассчитан = 2;
		Индексация = 0;
	КонецЕсли;
	
	ВычКВыплате();
КонецПроцедуры

// ===============================
Процедура ВычДоплатаДоМинЗП(МинЗарплата)
	// пропорционально отработанному времени
	БазаМинЗП = Оклад + Тариф + Сдельно + Премия + Индексация + ФиксирИндексация
		      + ?(Начисл1.БазаМинЗП=Да, СуммаНачисл1, 0)
	          + ?(Начисл2.БазаМинЗП=Да, СуммаНачисл2, 0)
	          + ?(Начисл3.БазаМинЗП=Да, СуммаНачисл3, 0); 
			  
	Если (БазаМинЗП < МинЗарплата) и (Начислено<>0) Тогда
		МинЗППропорц = ?((ОтработаноДней < Дней) и (Дней <> 0), МинЗарплата*ОтработаноДней/Дней, МинЗарплата);
		
	    ДоплДоМнЗП = Макс(МинЗППропорц - БазаМинЗП,0);
	Иначе	
	    ДоплДоМнЗП = 0;
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура ВычВторичныеНачисления()
	Перем ноМинЗарплата;
	ВычНачислено();
	ВычИндексация();
	Если ДатаДок >= '01.01.17' Тогда
		Если глПолучитьНиО(ноМинЗарплата,"МинЗарплата","о минимальной зарплате!") = 0 Тогда
			Возврат;
		КонецЕсли;
		
		МинЗП = ноМинЗарплата.Предел.Получить(НачМесяца(ДатаДок));
		ВычДоплатаДоМинЗП(МинЗП);
	КонецЕсли;
	Начислено = Начислено + Индексация + ФиксирИндексация + ДоплДоМнЗП;
	КВыплате = Начислено - Удержано;
	Если (Начислено - НачисленоПоДругимВыплатам) >= Удержано Тогда
		КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам;
	ИначеЕсли НачисленоПоДругимВыплатам <> 0 Тогда
		//Вычитаем только если не покрыли все из основных начислений
		КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам - (Удержано-(Начислено-НачисленоПоДругимВыплатам));
	Иначе
		КВыплатеПоДругимВыплатам = 0;
	КонецЕсли;
	
	НеРассчитан = 2;
КонецПроцедуры

// ===============================
Процедура ВычСдельно()
	
	// рассчитаем сумму сдельных начислений
	Если ИспользоватьСчетаРасходов <> Класс9 Тогда
		КоррСч = "81";
	Иначе
		КоррСч = "23";
	КонецЕсли;

	НачПериода = НачМесяца(ДатаДок); 
	КонПериода = ?(Выбран()=1, СформироватьПозициюДокумента(ТекущийДокумент(),-1), КонМесяца(ДатаДок));

	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.Сотрудники, Сотрудник, 2);
	Ит.ИспользоватьСубконто(ВидыСубконто.МесяцНачисленияЗП);
	Ит.ВыполнитьЗапрос(НачПериода,КонПериода,"661",КоррСч,,2);
	
	Сдельно = Ит.КО();
	Ит = 0;
	
	Начислено = Начислено + Сдельно;
	
	НеРассчитан = 1;
КонецПроцедуры


// ===============================
Процедура ИзмНачисл(НомНач)
	Начисл = ПолучитьАтрибут("Начисл"+НомНач);
	
	Если Начисл.Выбран() = 1 Тогда
		УстановитьАтрибут("ВидЗатратНачисл"+НомНач, Начисл.ВидЗатрат);
	Иначе
		УстановитьАтрибут("ВидЗатратНачисл"+НомНач, 0);
		ВыбратьСтроки();
		Пока ПолучитьСтроку() = 1 Цикл
			Если ПолучитьАтрибут("СуммаНачисл"+НомНач) <> 0 Тогда
				УстановитьАтрибут("СуммаНачисл"+НомНач, 0);
				ВычНачислено();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры //ИзмНачисл

// ===============================
Процедура ОчиститьНачисл(НомНач)
	УстановитьАтрибут("Начисл"+НомНач, 0);
	ИзмНачисл(НомНач);
КонецПроцедуры //ИзмНачисл2

// ===============================
Процедура ИзмСотрудник()
	Если Сотрудник.Выбран() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс Тогда
		КВыплате = Сотрудник.Аванс;
	ИначеЕсли ВидНачисления = ОсновнаяЗП Тогда
		Если Дней <> 0 Тогда
			Оклад = Сотрудник.Оклад.Получить(КонМесяца(ДатаДок))*ОтработаноДней/Дней;
			ФиксирИндексация = Сотрудник.СуммаФиксирИндексации.Получить(КонМесяца(ДатаДок))*ОтработаноДней/Дней;
		Иначе
			Оклад = 0;
		КонецЕсли;
		Если Часов <> 0 Тогда
			Тариф = Сотрудник.Тариф.Получить(КонМесяца(ДатаДок))*ОтработаноЧасов;
		Иначе
			Тариф = 0;
		КонецЕсли;
		ВычНачислено();
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмОтработаноДней()
	ИзмСотрудник();         
КонецПроцедуры

// ===============================
Процедура ИзмОтработаноЧасов()
	ИзмСотрудник();         
КонецПроцедуры

// ===============================
Процедура ИзмНомерСтроки()
	ОтработаноДней = Дней;
	ИзмОтработаноДней();
	ОтработаноЧасов = Часов;
	ИзмОтработаноЧасов();
КонецПроцедуры
// ===============================
Процедура ИзмИндексация()
	Начислено = Оклад + Тариф + Сдельно + Премия + Больничные + 
				БольничныеЗаСчетПредприятия + Отпускные +
				ОблагаемаяМатПомощь + НеоблагаемаяМатПомощь + Индексация + ФиксирИндексация + ДоплДоМнЗП;
	КВыплате = Начислено - Удержано;
	Если (Начислено - НачисленоПоДругимВыплатам) >= Удержано Тогда
		КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам;
	ИначеЕсли НачисленоПоДругимВыплатам <> 0 Тогда
		//Вычитаем только если не покрыли все из основных начислений
		КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам - (Удержано-(Начислено-НачисленоПоДругимВыплатам));
	Иначе
		КВыплатеПоДругимВыплатам = 0;
	КонецЕсли;
	НеРассчитан = 2;
КонецПроцедуры

// ===============================
Процедура ВычУдержано()
	Удержано = Подоходный + ЕдиныйВзнос + Профсоюзный + ВоенныйСбор; 

	КВыплате = Начислено - Удержано;
	КВыплатеПоДругимВыплатам = НачисленоПоДругимВыплатам - ЕСВПоДругимВыплатам - НДФЛПоДругимВыплатам - ВоенныйСборПоДругимВыплатам;
КонецПроцедуры

// ===============================
Процедура Заполнить()
	Если Подразделение.Выбран() = 0 Тогда
	    Если Вопрос("Не выбрано подразделение! Заполнить по всем сотрудникам?","Да+Нет") = "Нет" Тогда
	        Возврат;
	    КонецЕсли;
	КонецЕсли;
	Если КоличествоСтрок()>0 Тогда
		Рез = Вопрос("Удалить строки?","Да+Нет+Отмена");
		Если Рез ="Да" Тогда
			УдалитьСтроки();
		ИначеЕсли Рез = "Отмена" Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Сотр = СоздатьОбъект("Справочник.Сотрудники");
	Сотр.ПорядокКодов();
	Сотр.ВыборГруппы(0);
	Сотр.ВыбратьЭлементы();
	Пока Сотр.ПолучитьЭлемент()=1 Цикл
		Если Подразделение.Выбран() = 1 Тогда
			Если Сотр.Подразделение <> Подразделение Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если (Сотр.ЭтоГруппа() = 0) и (Сотр.Фирма = Фирма) Тогда
			Если Сотр.ДатаУвольнения <> Дата(0) Тогда
				Если Сотр.ДатаУвольнения <= НачМесяца(ДатаДок) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если Сотр.ДатаПриема <> Дата(0) Тогда
				Если Сотр.ДатаПриема > КонМесяца(ДатаДок) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
				Если Сотр.ПометкаУдаления() = 1 Тогда
				Продолжить;
			КонецЕсли;	
			НоваяСтрока();
			ИзмНомерСтроки();
			Сотрудник = Сотр.ТекущийЭлемент();
			ИзмСотрудник();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// ===============================
Процедура ПриРедактированииНовойСтроки()
	ИзмНомерСтроки();
КонецПроцедуры

// ===============================
Функция НаименованиеНДФЛ()
	Возврат ?(Константа.ФормыНаУкраинском = Да,"Податок на доходи фіз. осіб","Налог на доходы физ. лиц");
КонецФункции

// ===============================
Процедура РассчитатьСтроку()
Перем Ит;
    
	Если НеРассчитан =1 Тогда
		//Не считать удержания пока не рассчитаны все начисления
		Сообщить("В строке "+НомерСтроки+" не начислена индексация! Удержания по строке не рассчитаны.");
		Возврат;
	КонецЕсли;
	//используется только для документов с 2011
	НДФЛПоДругимВыплатам = 0;
	ВоенныйСборПоДругимВыплатам = 0;
	
	Начислено = Оклад + Тариф + Сдельно + Премия + Больничные + 
				БольничныеЗаСчетПредприятия + Отпускные +
				ОблагаемаяМатПомощь + НеоблагаемаяМатПомощь + Индексация + ФиксирИндексация + ДоплДоМнЗП;
				
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	Для НомНач = 1 по КвоНач Цикл
		Начислено = Начислено + ПолучитьАтрибут("СуммаНачисл"+НомНач);
	КонецЦикла;
	
	// рассчитаем удержания
	//единый взнос 
	ОблагаемоеЕСВ = Оклад + Отпускные + ОблагаемаяМатПомощь + Тариф + Сдельно + Премия + Индексация + ФиксирИндексация + ДоплДоМнЗП;
	ОблЕСВБольн   = Больничные + БольничныеЗаСчетПредприятия;
	ОблагаемоеПроф = Оклад + Отпускные + ОблагаемаяМатПомощь
	+ Тариф + Сдельно + Премия+ Индексация + ФиксирИндексация + ДоплДоМнЗП;
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	Для НомНач = 1 по КвоНач Цикл
		ПроизвНач = ПолучитьАтрибут("Начисл"+НомНач);
		ОблагаемоеЕСВ  = ОблагаемоеЕСВ  + ?(ПроизвНач.ОблагаетсяЕСВ=Да, ПолучитьАтрибут("СуммаНачисл"+НомНач), 0);
		ОблагаемоеПроф = ОблагаемоеПроф + ?(ПроизвНач.ОблагаетсяПрофсоюзный=Да, ПолучитьАтрибут("СуммаНачисл"+НомНач), 0);
	КонецЦикла;
	// МаксБаза
	Если (МаксБазаЕСВ > 0) и (ОблагаемоеЕСВ + ОблЕСВБольн > МаксБазаЕСВ) Тогда  
		ОблагаемоеЕСВ = Мин(МаксБазаЕСВ, ОблагаемоеЕСВ);
		ОблЕСВБольн   = Мин(МаксБазаЕСВ - ОблагаемоеЕСВ, ОблЕСВБольн);
	КонецЕсли;
	
	Если Сотрудник.ЧленПрофсоюза = 1 Тогда
		Профсоюзный = ОблагаемоеПроф * стПрофсоюзный;   
	Иначе
		Профсоюзный = 0;
	КонецЕсли;
	// единый взнос 
	ЕдиныйВзносБол = ОблЕСВБольн * стЕСВБолн;
	ЕдиныйВзнос = ОблагаемоеЕСВ * стЕСВ + ЕдиныйВзносБол;
	
	//Берем военный сбор
	ОблагаемаяБазаВС = Оклад + Тариф + Сдельно + Премия 
					+ Отпускные + ОблагаемаяМатПомощь + Больничные
					+ БольничныеЗаСчетПредприятия + Индексация + ФиксирИндексация + ДоплДоМнЗП
					// приплюсуем произвольные начисления
					+ ?(Начисл1.ОблагаетсяНДФЛ=Да, СуммаНачисл1, 0)
					+ ?(Начисл2.ОблагаетсяНДФЛ=Да, СуммаНачисл2, 0)
					+ ?(Начисл3.ОблагаетсяНДФЛ=Да, СуммаНачисл3, 0);
	ОблагаемаяБазаВСПоДрВып  = Больничные + БольничныеЗаСчетПредприятия;
	ВоенныйСбор = ОблагаемаяБазаВС * ноВоенСбор.Ставка.Получить(КонецПериода);       
	ВоенныйСборПоДругимВыплатам = ОблагаемаяБазаВСПоДрВып * ноВоенСбор.Ставка.Получить(КонецПериода);       

	//Берем НДФЛ
	ОблагаемаяБазаБезВычетов = Оклад + Тариф + Сдельно + Премия 
	+ Отпускные + ОблагаемаяМатПомощь + Больничные
	+ БольничныеЗаСчетПредприятия + Индексация + ФиксирИндексация + ДоплДоМнЗП;
	// приплюсуем произвольные начисления
	ОблагаемаяБазаБезВычетов = ОблагаемаяБазаБезВычетов 
	+ ?(Начисл1.ОблагаетсяНДФЛ=Да, СуммаНачисл1, 0)
	+ ?(Начисл2.ОблагаетсяНДФЛ=Да, СуммаНачисл2, 0)
	+ ?(Начисл3.ОблагаетсяНДФЛ=Да, СуммаНачисл3, 0);
	
	
	//Определим порог льготы для сотрудника
	ПорогЛьготыНДФЛСотрудника = ПорогЛьготыНДФЛ * Макс(1, Сотрудник.КвоДетей.Получить(КонецПериода));
	
	
	//Какую льготу даем				
	Если ПорогЛьготыНДФЛСотрудника >= ОблагаемаяБазаБезВычетов Тогда
		ЛьготаНДФЛ = СуммаЛьготыНДФЛ * Сотрудник.КвоЛьгот.Получить(КонецПериода);
	Иначе
		//нет права на льготу
		ЛьготаНДФЛ = 0;
	КонецЕсли;
	Если ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс Тогда
		//при расчете аванса льготы не учитываем
		ЛьготаНДФЛ = 0;
	КонецЕсли;  
	
	//Определим вычеты из базы
	Вычеты =  ЕдиныйВзнос;
	
	//Сколько облагаем
	ОблагаемаяБаза = ОблагаемаяБазаБезВычетов - Вычеты;
	
	Если (Константа.МетодРасчетаНДФЛ = Перечисление.ДаНет.Нет) 
		или ((Сотрудник.Шахтер.Получить(КонМесяца(ДатаДок)) = 1) и (ДатаДок<='01.01.2015') ) Тогда
		//общая база
		ОблагаемаяБазаБол = Больничные + БольничныеЗаСчетПредприятия - ЕдиныйВзносБол;
		КоефБаз = ?(ОблагаемаяБаза<>0,ОблагаемаяБазаБол/ОблагаемаяБаза,0);
		
		//Учитываем льготу
		Если ЛьготаНДФЛ < ОблагаемаяБаза Тогда
			ОблагаемаяБаза = ОблагаемаяБаза - ЛьготаНДФЛ;
		Иначе
			ОблагаемаяБаза = 0;
		КонецЕсли;	
		//Налог по ставке   
		Если (Сотрудник.Шахтер.Получить(КонМесяца(ДатаДок)) = 1) и (ДатаДок<='01.01.2015') Тогда
			Подоходный = ОблагаемаяБаза*ноНДФЛШахт.Ставка.Получить(КонецПериода);	
			//для расчета НДФЛ на больничный
			ОблагаемаяБазаБол = Мин(ОблагаемаяБазаБол,ОблагаемаяБаза*КоефБаз);
			НДФЛПоДругимВыплатам = ОблагаемаяБазаБол*ноНДФЛШахт.Ставка.Получить(КонецПериода);
		Иначе	
			// с 2011 года по схеме
			ПределНДФЛ =  ноНДФЛ.Предел.Получить(КонецПериода);
			Подоходный = Мин(ОблагаемаяБаза,ПределНДФЛ)*ноНДФЛ.Ставка.Получить(КонецПериода) +
			Макс(ОблагаемаяБаза-ПределНДФЛ, 0)*ноНДФЛ2.Ставка.Получить(КонецПериода);
			//для расчета НДФЛ на больничный
			ОблагаемаяБазаБол = Мин(ОблагаемаяБазаБол,ОблагаемаяБаза*КоефБаз);
			НДФЛПоДругимВыплатам = ?(ОблагаемаяБаза<>0, Подоходный*ОблагаемаяБазаБол/ОблагаемаяБаза,0);
		КонецЕсли;
		ЕСВПоДругимВыплатам = ЕдиныйВзносБол;
	Иначе
		ПределНДФЛ =  ноНДФЛ.Предел.Получить(КонецПериода);
		ОблагаемаяБазаБол = 0;
		ОблагаемаяБазаБол17 = 0;
		ОблагаемаяБаза17 = 0; 
		//отдельные базы
		Если (ОблагаемаяБазаБезВычетов <= ПределНДФЛ) Тогда 
			//все по ставке 15%  
			ОблагаемаяБаза = ОблагаемаяБаза;
			//Уитываем льготу
			Если (ЛьготаНДФЛ > 0) Тогда
				ОблагаемаяБаза = ?(ЛьготаНДФЛ < ОблагаемаяБаза,ОблагаемаяБаза - ЛьготаНДФЛ,0);
			КонецЕсли;
			//для расчета НДФЛ на больничный
			ОблагаемаяБазаБол = Мин(Больничные + БольничныеЗаСчетПредприятия - ЕдиныйВзносБол,ОблагаемаяБаза);
		Иначе
			//посчитаем базы отдельно
			ОблагаемаяБазаБол = Больничные + БольничныеЗаСчетПредприятия;
			ОблагаемаяБазаОкл = ОблагаемаяБазаБезВычетов - ОблагаемаяБазаБол; 
			Если (ОблагаемаяБазаОкл <= ПределНДФЛ) Тогда
				//сумма больничного попадающего в предел 
				ОблБол = ПределНДФЛ - ОблагаемаяБазаОкл; 
				//ЕСВ на этот больничный
				ЕдВзносБол = ?(ОблБол < ОблЕСВБольн, ОблБол*стЕСВБолн, ЕдиныйВзносБол);
				//база 15%
				ОблагаемаяБаза = ПределНДФЛ - (ЕдиныйВзнос - ЕдиныйВзносБол) - ЕдВзносБол;
				ОблагаемаяБаза17 = ОблагаемаяБазаБол - ОблБол - (ЕдиныйВзносБол - ЕдВзносБол); 
				//для расчета НДФЛ на больничный
				ОблагаемаяБазаБол = ОблБол - ЕдВзносБол;
				ОблагаемаяБазаБол17 = ОблагаемаяБаза17;
			Иначе	
				//больничный в предел не попадает
				//ЕСВ на сумму предела
				ЕдВзнос = ?(ПределНДФЛ < ОблагаемоеЕСВ, ПределНДФЛ*стЕСВ, ЕдВзнос);
				//база 15%
				ОблагаемаяБаза = ПределНДФЛ - ЕдВзнос; 
				ОблагаемаяБаза17 = ОблагаемаяБазаОкл - ПределНДФЛ + ОблагаемаяБазаБол - ЕдиныйВзнос + ЕдВзнос; 
				//для расчета НДФЛ на больничный
				ОблагаемаяБазаБол17 = ОблагаемаяБазаБол - ЕдиныйВзносБол;
				ОблагаемаяБазаБол = 0;
			КонецЕсли;
		КонецЕсли;
		
		// с 2011 года по схеме
		Подоходный = ОблагаемаяБаза*ноНДФЛ.Ставка.Получить(КонецПериода) +
		ОблагаемаяБаза17*ноНДФЛ2.Ставка.Получить(КонецПериода);
		//для расчета НДФЛ на больничный
		НДФЛПоДругимВыплатам = ОблагаемаяБазаБол*ноНДФЛ.Ставка.Получить(КонецПериода) +
		ОблагаемаяБазаБол17*ноНДФЛ2.Ставка.Получить(КонецПериода);
		ЕСВПоДругимВыплатам = ЕдиныйВзносБол;
	КонецЕсли;	
	ВычУдержано();
	НеРассчитан = 0;
КонецПроцедуры

//Возвращает ставку рассчитанную пропорционально количеству рабочих дней в месяце
// ======================================
Функция ПолучитьСтавку(ИмяПараметра,стОргПеч)
	Перем Инд;       
	Инд = 0;
	Если стОргПеч = "Инд" Тогда
		Инд = 1;
	КонецЕсли;
	НиО = СоздатьОбъект("Справочник.ШкалаСтавок");
	Если НиО.НайтиПоКоду(ИмяПараметра) = 1 Тогда
		// есть такой налог
		ПерСтавка = СоздатьОбъект("Периодический");
		ПерСтавка.ИспользоватьОбъект("Ставка",НиО);
		ПерСтавка.ВыбратьЗначения(НачалоПериода+1, КонецПериода);
		Ставка = 0;
		СтавкаПред = НиО.Ставка.Получить(НачалоПериода);
		НачалоПериодаСтавки = НачалоПериода;
		
		Пока ПерСтавка.ПолучитьЗначение() = 1 Цикл
			Если (КвоДнейНач = 0) И (Инд = 0) Тогда
				Предупреждение("В связи с изменением ставки "+ НиО.Наименование + " в текущем месяце, введите количество рабочих дней до изменения ставки!");
				ВвестиЧисло(КвоДнейНач,"Кол-во раб.дней до изм.ставки",2,0,)
			КонецЕсли;
			РабДней = КвоДнейНач;      
			стОргПеч =  стОргПеч + НачалоПериодаСтавки + "-" + (ПерСтавка.ДатаЗнач-1) + " (" + РабДней +" дн.) " + СтавкаПред*100+"%, ";
			
			Ставка = Ставка + СтавкаПред * РабДней;
			СтавкаПред = ПерСтавка.Значение;
			НачалоПериодаСтавки = ПерСтавка.ДатаЗнач;
		КонецЦикла;
		Если КвоДнейРаб = 0 Тогда
			  КвоДнейРаб = ?(Дней <> 0, Дней, 22);
		КонецЕсли;
		РабДней = КвоДнейРаб - КвоДнейНач;        
		
		Если НачалоПериодаСтавки = НачалоПериода Тогда 
			//Ставка в течение месяца не менялась - значит историю не выводим
			стОргПеч = "" + СтавкаПред*100+" %";
			РабДней = КвоДнейРаб;     
		Иначе
			стОргПеч =  стОргПеч + НачалоПериодаСтавки + "-" + КонецПериода + " (" + РабДней +" дн.) " + СтавкаПред*100+"%";
		КонецЕсли;
				
		Ставка = Ставка + СтавкаПред * РабДней;
		РабДнейВсего = КвоДнейРаб;
		Ставка = Ставка / РабДнейВсего;
		Если (НачалоПериодаСтавки <> НачалоПериода) И (Инд = 0) Тогда 
				Сообщить("Сумма взноса "+ НиО.Наименование + " рассчитана пропорционально рабочим дням ");
				Сообщить(" в связи с изменением ставки в течение месяца: "+стОргПеч);
		КонецЕсли;
		
		Возврат Ставка;
	КонецЕсли;
	Возврат 0;
КонецФункции 

// ===============================
Процедура РассчитатьАванс()
	
	КонецПериода = КонМесяца(ДатаДок);
	ВыбратьСтроки();
	Пока ПолучитьСтроку()=1 Цикл
		Если Дней <> 0 Тогда
			Оклад = Сотрудник.Оклад.Получить(КонецПериода)*ОтработаноДней/Дней;
			Начислено = Оклад;  
		Иначе
			Оклад = 0;
			Начислено = 0;  
		КонецЕсли;
		Если Часов <> 0 Тогда
			Оклад = Оклад + Сотрудник.Тариф.Получить(КонецПериода)*ОтработаноЧасов;
			Начислено = Оклад;  
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры
// ===============================
Процедура Рассчитать()
	ТребуемоеДействие = 0;
	Если ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс Тогда
	Иначе	
		МенюРассчитать = СоздатьОбъект("СписокЗначений");
		МенюРассчитать.ДобавитьЗначение(5,"Сумма сдельной оплаты для текущего сотрудника");
		МенюРассчитать.ДобавитьЗначение(4,"Сумма сдельной оплаты для всех сотрудников");
		//МенюРассчитать.ДобавитьЗначение(3,"Сумма индексации для текущего сотрудника");
		//МенюРассчитать.ДобавитьЗначение(2,"Сумма индексации для всех сотрудников");
		//При наличии других вторичных начислений можно переименовать пункты меню
		МенюРассчитать.ДобавитьЗначение(3,"Вторичные начисления текущего сотрудника");
		МенюРассчитать.ДобавитьЗначение(2,"Вторичные начисления всех сотрудников");
		МенюРассчитать.ДобавитьЗначение(1,"Удержания текущего сотрудника");
		МенюРассчитать.ДобавитьЗначение(0,"Удержания всех сотрудников");
		Если МенюРассчитать.ВыбратьЗначение(ТребуемоеДействие,"Выберите тип расчета",2,0,1) = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	НиО = СоздатьОбъект("Справочник.ШкалаСтавок");
	КонецПериода = КонМесяца(ДатаДок);
	НачалоПериода = НачМесяца(ДатаДок);
	Спис = СоздатьОбъект("СписокЗначений");
	
	Если глПолучитьНиО(ноПрожМинимум,"ПрожМинТруд","о прожиточном минимуме!") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если глПолучитьНиО(ноЕСВСотр,"ЕСВ","о едином взносе с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноЕСВБольн,"ЕСВБольн","о едином взносе с сотрудника (больничный)!") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//Нужен НДФЛ
	Если глПолучитьНиО(ноНДФЛ,"НДФЛОсн","о налоге на доходы физ. лиц!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноНДФЛ2,"НДФЛ2Пред","о налоге на доходы физ. лиц (2 предел)!") = 0 Тогда
		Возврат;
	КонецЕсли;   
	Если глПолучитьНиО(ноНДФЛШахт,"НДФЛШахт","о налоге на доходы физ. лиц (шахтер)!") = 0 Тогда
		Возврат;
	КонецЕсли; 
	Если глПолучитьНиО(ноЛьготаНДФЛ,"ЛьготыНДФЛбаз","о льготах по налогу на доходы физ. лиц!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноВоенСбор,"ВоенныйСбор","о военном сборе с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	глПарсить(ноЛьготаНДФЛ.Родитель.Дополнительно.Получить(КонецПериода),Спис);
	//порог по льготе НДФЛ
	ПорогЛьготыНДФЛ = Число(Спис.Получить("Порог"));
	//коэффициент уменьшения льготы НДФЛ
	КоэфЛьготыНДФЛ = Число(Спис.Получить("Коэф.уменьшения"));
	Если КоэфЛьготыНДФЛ = 0 Тогда
		КоэфЛьготыНДФЛ = 1;
	КонецЕсли;	
	//сумма базовой льготы НДФЛ = Ставка*КоэфУменьшения*МинЗП
	СуммаЛьготыНДФЛ = ноЛьготаНДФЛ.Ставка.Получить(КонецПериода) * КоэфЛьготыНДФЛ * ноПрожМинимум.Предел.Получить(НачГода(ДатаДок));
	
	
	// получим данные для печати
	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить("Дата",КонецПериода);
	Расшифровка.Установить("НеоблагМин","");
	Расшифровка.Установить("СотрПрофсоюз","");
	глПолучитьДанные(Расшифровка);
	
	НМ = Расшифровка.Получить("НеоблагМин");
	стПрофсоюзный = Расшифровка.Получить("СотрПрофсоюз");   

	стБезрПеч = "";  
	Если (ТребуемоеДействие = 2) ИЛИ (ТребуемоеДействие = 3) Тогда   
		стБезрПеч = "Инд";  
	КонецЕсли;
	КвоДнейРаб = Дней;
	Если ТребуемоеДействие = 1 Тогда   
		КолРабДнейНачало = КвоДнейНач;
		КвоДнейРаб = ОтработаноДней;   
		КвоДнейНач = 0;
	КонецЕсли;

	стЕСВПеч = ""; стЕСВБолПеч = "";
	глПарсить(ноЕСВСотр.Родитель.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВ  = Число(Спис.Получить("Макс. база"));
	стЕСВ = ПолучитьСтавку("ЕСВ",стЕСВПеч);
	стЕСВБолн = ПолучитьСтавку("ЕСВБольн",стЕСВПеч);

	Если ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс Тогда
		РассчитатьАванс();
	КонецЕсли;	
	
	Если ТребуемоеДействие = 1 Тогда	    
		//удержания по строке
		РассчитатьСтроку();
	ИначеЕсли ТребуемоеДействие = 0 Тогда	    
		//удержание по всем
		ВыбратьСтроки();
		Пока ПолучитьСтроку()=1 Цикл
		 	РассчитатьСтроку();
		КонецЦикла;
		Ит = 0;
	ИначеЕсли ТребуемоеДействие = 3 Тогда	    
		//вторичные по строке
		фПерваяИндексация = 1;
		ВычВторичныеНачисления();
	ИначеЕсли ТребуемоеДействие = 2 Тогда	    
		//вторичные по всем
		фПерваяИндексация = 1;
		ВыбратьСтроки();
		Пока ПолучитьСтроку()=1 Цикл
			ВычВторичныеНачисления();
		КонецЦикла;
	ИначеЕсли ТребуемоеДействие = 5 Тогда	    
		//сдельно по строке
		ВычСдельно();
	ИначеЕсли ТребуемоеДействие = 4 Тогда	    
		//сдельно по всем
		Если ИспользоватьСчетаРасходов <> Класс9 Тогда
			КоррСч = "81";
		Иначе
			КоррСч = "23";
		КонецЕсли;

		НачПериода = НачМесяца(ДатаДок); 
		КонПериода = ?(Выбран()=1, СформироватьПозициюДокумента(ТекущийДокумент(),-1), КонМесяца(ДатаДок));
		
		спСотрудники = СоздатьОбъект("СписокЗначений");
		ВыгрузитьТабличнуюЧасть(спСотрудники,"Сотрудник");

		Ит = СоздатьОбъект("БухгалтерскиеИтоги");
		Ит.ИспользоватьРазделительУчета(Фирма);
		Ит.ИспользоватьСубконто(ВидыСубконто.Сотрудники,спСотрудники);
		Ит.ИспользоватьСубконто(ВидыСубконто.МесяцНачисленияЗП);
		Ит.ВыполнитьЗапрос(НачПериода,КонПериода,"661",КоррСч,,2);
		Ит.ВыбратьСубконто(1);
		
		ВыбратьСтроки();
		Пока ПолучитьСтроку()=1 Цикл
			СуммаСдельно = 0;
			Если Ит.ПолучитьСубконто(1,,Сотрудник) = 1 Тогда
			    Сдельно = Ит.КО();
			КонецЕсли;
		КонецЦикла;
		Ит = 0;
		НеРассчитан = 1;
	КонецЕсли;
	Если ТребуемоеДействие = 1 Тогда   
		КвоДнейНач = КолРабДнейНачало;
	КонецЕсли;
КонецПроцедуры

// ===============================
Функция ФорматПок(Чсл) Экспорт
	Возврат Формат(Чсл,"Ч-12.2");
КонецФункции                      

// ===============================
Функция ФорматЦел(Чсл) Экспорт
	Возврат Формат(Чсл,"Ч-6");
КонецФункции

// ===============================
Процедура ПолучитьДанныеИзЗапроса()
	Перем Стр;
	
	НачПериода = НачМесяца(ДатаДок);
	КонПериода = КонМесяца(ДатаДок);
	
	Если Константа.ПроводкиПоКассеТолькоОрдерами = Да Тогда
		// запрос по проведенным документам НачислениеЗП с видом выплаты Аванс
		ЗапрАванс = СоздатьОбъект("Запрос");
		ТекстЗапр = "//{{ЗАПРОС(ЗапрАванс)
		|Период С НачПериода по КонПериода;
		|ВидНачисления = Документ.НачислениеЗП.ВидНачисления;
		|Сот = Документ.НачислениеЗП.Сотрудник;
		|Фир = Документ.НачислениеЗП.Сотрудник.Фирма;
		|Аванс = Документ.НачислениеЗП.КВыплате;
		|Функция СуммаАванса = Сумма(Аванс);
		|Группировка Сот без групп;
		|Условие (Фир = Фирма);
		|Условие (ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс);
		|"//}}ЗАПРОС
		;
		// Если ошибка в запросе, то выход из процедуры
		Если ЗапрАванс.Выполнить(ТекстЗапр) = 0 Тогда
			Предупреждение("Не выполнился запрос по документам начисления аванса!");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТаблСотр = СоздатьОбъект("ТаблицаЗначений");
	ВыгрузитьТабличнуюЧасть(ТаблСотр,"Сотрудник,КВыплате");
	СписСотр = СоздатьОбъект("СписокЗначений");
	ТаблСотр.Выгрузить(СписСотр,,,"Сотрудник");
	
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.Сотрудники, СписСотр, 2);
	Ит.ИспользоватьСубконто(ВидыСубконто.МесяцНачисленияЗП);
	Ит.ВыполнитьЗапрос(НачПериода,КонПериода,"661;663",,,,"Проводка","С");
	
	ТаблСотр.НоваяКолонка("СальдоНач","Число",12,2);
	ТаблСотр.НоваяКолонка("ВыплПред","Число",12,2);
	ТаблСотр.НоваяКолонка("Аванс","Число",12,2);
	ТаблСотр.НоваяКолонка("ВыплТек","Число",12,2);	
	ТаблСотр.НоваяКолонка("КВыдаче","Число",12,2);
	ТаблСотр.НоваяКолонка("СальдоКон","Число",12,2);
		
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1) = 1 Цикл
		// сотрудник точно есть в таблице - мы по ней "фильтровали" запрос
		ТаблСотр.НайтиЗначение(Ит.Субконто(1),Стр,"Сотрудник");
		ТаблСотр.ПолучитьСтрокуПоНомеру(Стр);
		Стр = 0;
		ТаблСотр.СальдоНач = Ит.СНК() - Ит.СНД();
		Ит.ВыбратьСубконто(2);
		Пока Ит.ПолучитьСубконто(2) = 1 Цикл
			Дат = Ит.Субконто(2);
			Если ПустоеЗначение(Дат) = 1 Тогда
				// странно, но бывает
				Продолжить;
			КонецЕсли;
			Ит.ВыбратьПериоды();
			Пока Ит.ПолучитьПериод() = 1 Цикл
				Док = Ит.Операция.Документ; 
				Если Док = ТекущийДокумент() Тогда
					// движения средств по данной ведомости игнорируем
					Продолжить;
				КонецЕсли;
				Попытка 
					ВидВыпл = Док.ВидНачисления 
				Исключение 
					ВидВыпл = ОсновнаяЗП
				КонецПопытки;
				Если (Дат = НачПериода) И (ВидВыпл = Перечисление.ВидыНачисленияЗП.Аванс) Тогда
					// выплата аванса за текущий месяц
					ТаблСотр.Аванс = ТаблСотр.Аванс + Ит.ДО();
				ИначеЕсли Дат <> НачПериода Тогда
					// выплаты за предыдущие периоды
					ТаблСотр.ВыплПред = ТаблСотр.ВыплПред + Ит.ДО();
				Иначе
					// выплаты за текущий период
					ТаблСотр.ВыплТек = ТаблСотр.ВыплТек + Ит.ДО();
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если Константа.ПроводкиПоКассеТолькоОрдерами = Да Тогда
			Если ЗапрАванс.Получить(Ит.Субконто(1)) = 1 Тогда
				// увеличим сумму аванса
				ТаблСотр.Аванс = ТаблСотр.Аванс + ЗапрАванс.СуммаАванса;
				// уменьшим сумму выплат за текущий период, 
				// поскольку сумма аванса должна была там учесться
				ТаблСотр.ВыплТек = Макс(ТаблСотр.ВыплТек - ЗапрАванс.СуммаАванса, 0);
			КонецЕсли;
			ЗапрАванс.вНачалоВыборки();
		КонецЕсли;
		
		ТаблСотр.КВыплате = ТаблСотр.КВыплате - ТаблСотр.Аванс;
		ТаблСотр.КВыдаче = Макс(0, ТаблСотр.КВыплате+ТаблСотр.СальдоНач-ТаблСотр.ВыплПред);
		ТаблСотр.СальдоКон = ТаблСотр.КВыплате+ТаблСотр.СальдоНач-ТаблСотр.ВыплПред-ТаблСотр.ВыплТек;
	КонецЦикла;
	
КонецПроцедуры

// ===============================
Процедура РасчПлатВед() // печать расчетно-платежной ведомости
	Перем Стр;

	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	
	ПолучитьДанныеИзЗапроса();
	Таб.ПараметрыСтраницы(2); // ландшафт
	Таб.ПовторятьПриПечатиСтроки(20,20);
	Таб.ВывестиСекцию("Шапка|Секция1");
	Для НомНач = 1 по КвоНач Цикл
		Начисл = ПолучитьАтрибут("Начисл"+НомНач);
		Таб.ПрисоединитьСекцию("Шапка|Секция2");
	КонецЦикла;
	Таб.ПрисоединитьСекцию("Шапка|Секция3");
	Ном = 1;
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Месяц = ?((Больничные > 0) или (БольничныеЗаСчетПредприятия > 0), Формат(ДатаМесяц(ДатаДок),"Ч (0)2"), "-");
		ТаблСотр.НайтиЗначение(Сотрудник,Стр,"Сотрудник");
		ТаблСотр.ПолучитьСтрокуПоНомеру(Стр);
		Стр = 0;
		Таб.ВывестиСекцию("Сотрудник|Секция1");
		Для НомНач = 1 по КвоНач Цикл
			Начисл = ПолучитьАтрибут("Начисл"+НомНач);
			Таб.ПрисоединитьСекцию("Сотрудник|Секция2");
		КонецЦикла;
		Таб.ПрисоединитьСекцию("Сотрудник|Секция3");
		Ном = Ном + 1;
	КонецЦикла;
	Таб.ВывестиСекцию("Дно|Секция1");
	Для НомНач = 1 по КвоНач Цикл
		Начисл = ПолучитьАтрибут("Начисл"+НомНач);
		Таб.ПрисоединитьСекцию("Дно|Секция2");
	КонецЦикла;
	Таб.ПрисоединитьСекцию("Дно|Секция3");
	Таб.Показать("Расчетно-платежная ведомость","");
КонецПроцедуры         

// ===============================
Процедура ФормаП6(флС, Сотр) // печать П6
	Перем Стр, СотрТек;
	СотрТек = Сотр;
	Ном = 1;
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	ПолучитьДанныеИзЗапроса();
	Таб.ПараметрыСтраницы(1); // портрет
	ВыбратьСтроки();
	Первый =1;
	Пока ПолучитьСтроку() = 1 Цикл
		Если Первый = 0 Тогда
			Таб.НоваяСтраница();
		Иначе
			Первый = 0;
		КонецЕсли;                
		Если (флС = 1) И (Сотрудник <> СотрТек) Тогда         
			Продолжить;
		КонецЕсли;
		ТаблСотр.НайтиЗначение(Сотрудник,Стр,"Сотрудник");
		ТаблСотр.ПолучитьСтрокуПоНомеру(Стр);          
		ПериодОтч =  ПериодСтр(НачМесяца(ДатаДок), КонМесяца(ДатаДок));  
		Начисл = 0;
		Для НомНач = 1 по КвоНач Цикл
			Начисл = Начисл + ПолучитьАтрибут("СуммаНачисл"+НомНач);        
			Ном = Ном + 1;
		КонецЦикла;
		Стр = 0;
		Таб.ВывестиСекцию("Страница");
	КонецЦикла;
	Таб.Показать("Типовая форма № П-6","");
КонецПроцедуры

// ===============================
Процедура ФормаП7() // печать П7
	Перем Стр;
	Ном = 1;
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	ПолучитьДанныеИзЗапроса();
	Таб.ПараметрыСтраницы(1); // портрет
	ВыбратьСтроки();
	ПериодОтч =  ПериодСтр(НачМесяца(ДатаДок), КонМесяца(ДатаДок));
	Начисл = 0;
	Для НомНач = 1 по КвоНач Цикл
		Начисл = Начисл + Итог("СуммаНачисл"+НомНач);        
		Ном = Ном + 1;
	КонецЦикла;
	Таб.ВывестиСекцию("Страница");
	Таб.Показать("Типовая форма № П-7","");
КонецПроцедуры

// ===============================
Процедура ПлатВед(ТипФ)
	Перем Стр;
	ИтКВыдаче = Итог("КВыплате");
	Если ВидНачисления = ОсновнаяЗП Тогда
		ПолучитьДанныеИзЗапроса();
		ИтКВыдаче = ТаблСотр.Итог("КВыдаче");
	КонецЕсли;
	глУстПропись(Гривня,"У");
	ДатаВед = СтрЗаменить(ПериодСтр(НачМесяца(ДатаДок), КонМесяца(ДатаДок)),"р.","року");
	Таб.ПараметрыСтраницы(1); // портрет
	Таб.ПовторятьПриПечатиСтроки(32,36);
	Таб.ВывестиСекцию("Страница1");
	Если ТипФ = 7 Тогда
		Таб.НоваяСтраница();
	КонецЕсли;
	Таб.ВывестиСекцию("Шапка");
	ВыбратьСтроки();
	Ном = 1;
	Пока ПолучитьСтроку() = 1 Цикл
		КВыдаче = 0;
		Если ВидНачисления = ОсновнаяЗП Тогда
			// найти данные в таблице
			ТаблСотр.НайтиЗначение(Сотрудник,Стр,"Сотрудник");
			ТаблСотр.ПолучитьСтрокуПоНомеру(Стр);
			КВыдаче = ТаблСотр.КВыдаче;
			Стр = 0;
		Иначе
			КВыдаче = КВыплате;
		КонецЕсли;
		Таб.ВывестиСекцию("Сотрудник");
		Ном = Ном + 1;
	КонецЦикла;
	Таб.ВывестиСекцию("Дно");
	Таб.Показать("Платежная ведомость","");
КонецПроцедуры

// ===============================
Процедура РасчетныеЛистки()
	Перем Стр;

	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	
	КвоНаСтраницу = 2;
	ВвестиЧисло(КвоНаСтраницу,"Введите кол-во листков на страницу.",1,0);
	КвоНаСтаницу = ?(КвоНаСтраницу > 0, КвоНаСтраницу, 2);
	ПолучитьДанныеИзЗапроса();
	Таб.ПараметрыСтраницы(1); // портрет
	ВыбратьСтроки();
	Ном = 1;
	Пока ПолучитьСтроку() = 1 Цикл
		Если ДатаДок < глДатаПереходаНаЕСВ Тогда
			Таб.ВывестиСекцию("Основная1"); 
		ИначеЕсли ДатаДок < '01/01/2016' Тогда
			Таб.ВывестиСекцию("Основная11"); 
		Иначе
			Таб.ВывестиСекцию("Основная16"); 
		КонецЕсли;
		Для НомНач = 1 по КвоНач Цикл
			Начисл = ПолучитьАтрибут("Начисл"+НомНач);
			Таб.ВывестиСекцию("Основная2");
		КонецЦикла;
		Таб.ВывестиСекцию("Основная3");
		ТаблСотр.НайтиЗначение(Сотрудник,Стр,"Сотрудник");
		ТаблСотр.ПолучитьСтрокуПоНомеру(Стр);
		Стр = 0;
		Если ТаблСотр.СальдоНач <> 0 Тогда
			Таб.ВывестиСекцию("ДолгНач");
		КонецЕсли;
		ПолагаетсяКВыплате = Макс(0, ТаблСотр.КВыплате + ТаблСотр.Аванс + ТаблСотр.СальдоНач);
		Выплачено = ТаблСотр.ВыплПред + ТаблСотр.Аванс + ТаблСотр.ВыплТек;
		Таб.ВывестиСекцию("КВыплате");
		Если ТаблСотр.СальдоКон <> 0 Тогда
			Таб.ВывестиСекцию("ДолгКон");
		КонецЕсли;
		Если Ном < КоличествоСтрок() Тогда
			Если Ном%КвоНаСтраницу = 0 Тогда
				Таб.НоваяСтраница();
			Иначе
				Таб.ВывестиСекцию("Черта");
			КонецЕсли;
		КонецЕсли;
		Ном = Ном + 1;
	КонецЦикла;
	Таб.Показать("Расчетные листки","");
КонецПроцедуры

// ======================================
Процедура СводОтчислений()
	Перем ноПенсионный, ноПенсионныйИнв, ноПенсионныйСотр, ноПенсионныйСотр2, ноСтрахНетрудоспСотр2, ноБезработица; 
	Перем ноСтрахНетрудоспСотр;
	// 1 - Безработица, 2 - Соц.страх, 3 - Несчастный случай 
	Перем ноФонды[3], МаксБаза[3];
	Перем НачислЗатрБаза[3], НачислПрибБаза[3];
	Перем НачислИнвЗатрБаза[3], НачислИнвПрибБаза[3];
	Перем ИтНачислЗатрБаза[3], ИтНачислПрибБаза[3];
	Перем ИтНачислИнвЗатрБаза[3], ИтНачислИнвПрибБаза[3]; // эти суммы "включаются" в ИтНачислЗатрБаза и ИтНачислПрибБаза соответственно
	
	Таб.ПараметрыСтраницы(2); // ландшафт
	Таб.ПовторятьПриПечатиСтроки(9,9);
	КонецПериода = КонМесяца(ДатаДок);
	НачалоПериода = НачМесяца(ДатаДок);
	КвоДнейНач = КолРабДнейНачало;      
	КвоДнейРаб = Дней;             
	Если глПолучитьНиО(ноПенсионныйСотр,"Пенс1пред","об отчислениях в ПФ с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноПенсионныйСотр2,"Пенс2пред","об отчислениях в ПФ с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноБезработица,"СотрБезраб","об отчислениях в фонд. страх. от безработицы с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноПенсионный,"ФЗППенс","об отчислениях в ПФ с фонда заработной платы!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноПенсионныйИнв,"ФЗППенсИнв","об отчислениях в ПФ с фонда заработной платы(инвалиды)!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноСтрахНетрудоспСотр,"СотрНетрудосп1","об отчислениях в фонд страх. по временной нетрудоспособности с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноФонды[1],"ФЗПБезраб","об отчислениях в фонд страх. от безработицы с фонда заработной платы!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноФонды[2],"ФЗПСоцСтрах","об отчислениях в фонд социального страхования с фонда заработной платы!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноФонды[3],"ФЗПСоцСтрахНесч","об отчислениях в фонд страх. от несчастного случая с фонда заработной платы!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноСтрахНетрудоспСотр2,"СотрНетрудосп2","об отчислениях в фонд страх. по временной нетрудоспособности с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;

	стПенОргПеч		= "";
	стПенИнвОргПеч	= "";
	стБзрОргПеч		= "";
	стСоцОргПеч		= "";
	стНесчОргПеч	= "";
	
	// получим данные для печати
	Расшифровка = СоздатьОбъект( "СписокЗначений" );
	Расшифровка.Установить ("Дата",КонецПериода);
	Расшифровка.Установить("НеоблагМин","");
	глПолучитьДанные(Расшифровка);
	
	//Получаем ставки с историей изменений в течение месяца
	стПенОрг = ПолучитьСтавку("ФЗППенс",стПенОргПеч);
	стПенИнвОрг = ПолучитьСтавку("ФЗППенсИнв",стПенИнвОргПеч);
	стБзрОрг = ПолучитьСтавку("ФЗПБезраб",стБзрОргПеч);
	стСоцОрг = ПолучитьСтавку("ФЗПСоцСтрах",стСоцОргПеч);
	стНесчОрг = ПолучитьСтавку("ФЗПСоцСтрахНесч",стНесчОргПеч);
	НМ = Расшифровка.Получить("НеоблагМин");
		

	// определим максимальные базы, с которых взымаются отчисления в фонды
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноПенсионный.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаПенс = Число(Спис.Получить("Макс. база"));
	МаксБазаПенс = ?(МаксБазаПенс = 0, 999999999, МаксБазаПенс);
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноПенсионныйИнв.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаПенсИнв = Число(Спис.Получить("Макс. база"));
	МаксБазаПенсИнв = ?(МаксБазаПенсИнв = 0, 999999999, МаксБазаПенсИнв);
    
	Для Н=1 По 3 Цикл
		Спис = СоздатьОбъект("СписокЗначений");
		глПарсить(ноФонды[Н].Дополнительно.Получить(КонецПериода),Спис);
		МаксБаза[Н] = Число(Спис.Получить("Макс. база"));
		МаксБаза[Н] = ?(МаксБаза[Н] = 0, 999999999, МаксБаза[Н]);
    КонецЦикла;                    

	// отчисления в фонды с сотрудников разобьем по ставкам
	прПенс1Сотр = Окр(ноПенсионныйСотр.Предел.Получить(КонецПериода) * ноПенсионныйСотр.Ставка.Получить(КонецПериода),2);
	прСтрахНетрудосп1Сотр = ноСтрахНетрудоспСотр.Предел.Получить(КонецПериода) * ноСтрахНетрудоспСотр.Ставка.Получить(КонецПериода);
	
	Если ПустоеЗначение(Подразделение) = 1 Тогда
		ПодразделениеДляПечати = "";
	Иначе
		ПодразделениеДляПечати = ?(Константа.ФормыНаУкраинском = Да,"Підрозділ: ","Подразделение: ")+Подразделение.Наименование;
	КонецЕсли;	
	
	стПенс1 = ноПенсионныйСотр.Ставка.Получить(КонецПериода);
	стПенс2 = ноПенсионныйСотр2.Ставка.Получить(КонецПериода);
	стБезр  = ноБезработица.Ставка.Получить(КонецПериода);
	стНетр1 = ноСтрахНетрудоспСотр.Ставка.Получить(КонецПериода);
	стНетр2 = ноСтрахНетрудоспСотр2.Ставка.Получить(КонецПериода);
	// Выводим шапку для одной ставки в ПФ или для двух ставок.
	Если стПенс1 = стПенс2 Тогда   
		Таб.ВывестиСекцию("Шапка2");
	Иначе
		Таб.ВывестиСекцию("Шапка");
	КонецЕсли;	
	
	ИтНачислЗатр = 0;			ИтНачислПриб = 0;
	ИтНачислЗатрБазаПенс = 0;	ИтНачислПрибБазаПенс = 0;
	ИтНачислИнвЗатрБазаПенс = 0;ИтНачислИнвПрибБазаПенс = 0;
	ИтПенс1 = 0;				ИтПенс2 = 0;
	ИтСтрахНетрудосп1 = 0;		ИтСтрахНетрудосп2 = 0;
	ИтогСотрПенсЗатрат = 0;		ИтогСотрПенсПриб = 0;
	ИтогСотрБезрабЗатр = 0;		ИтогСотрБезрабПриб = 0;
	ИтогСотрСоцСтрахПриб = 0;	ИтогСотрСоцСтрахЗатр = 0;
	ИтогСотрСтрахНесчПриб = 0;	ИтогСотрСтрахНесчЗатр = 0;
	
	Если НачМесяца(ДатаДок)<'01.01.2003' Тогда
		фНеоблагМатПомВР = 1;
	Иначе
		фНеоблагМатПомВР = 0;
	КонецЕсли;	
	
	Если НачМесяца(ДатаДок)>'01.01.2004' Тогда
		фВключатьБольничныеВЗатраты = 1
	Иначе
		фВключатьБольничныеВЗатраты = 0
	КонецЕсли;	
	
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		НачислЗатр = Оклад+Отпускные+Индексация+ФиксирИндексация+БольничныеЗаСчетПредприятия+Тариф+Сдельно+Премия;
		Если фНеоблагМатПомВР = 1 Тогда
			НачислЗатр = НачислЗатр + НеоблагаемаяМатПомощь;
		КонецЕсли;
		Для НомНач = 1 по КвоНач Цикл
			НачислЗатр = НачислЗатр + ПолучитьАтрибут("СуммаНачисл"+НомНач);
		КонецЦикла;
		НачислПриб = ОблагаемаяМатПомощь;
		
		НачислЗатрБазаОбщ = Оклад+Отпускные+Индексация+ФиксирИндексация+Тариф+Сдельно+Премия;
		Для НомНач = 1 по КвоНач Цикл
			НачислЗатрБазаОбщ = НачислЗатрБазаОбщ + ПолучитьАтрибут("СуммаНачисл"+НомНач);
		КонецЦикла;
		НачислПрибБазаОбщ = ОблагаемаяМатПомощь;
		
		Если фВключатьБольничныеВЗатраты = 1 Тогда
			НачислЗатрБазаПенс = НачислЗатрБазаОбщ + Больничные + БольничныеЗаСчетПредприятия;
			НачислПрибБазаПенс = ОблагаемаяМатПомощь;
		Иначе
			НачислЗатрБазаПенс = НачислЗатрБазаОбщ;
			НачислПрибБазаПенс = ОблагаемаяМатПомощь + Больничные + БольничныеЗаСчетПредприятия;
		КонецЕсли;

		ЭтоИнвалид = Сотрудник.Инвалид.Получить(КонМесяца(ДатаДок));
		
		Если ЭтоИнвалид = 1 Тогда
			Если НачислЗатрБазаПенс+НачислПрибБазаПенс > МаксБазаПенсИнв Тогда
				Коэф = МаксБазаПенсИнв / (НачислЗатрБазаПенс + НачислПрибБазаПенс);
				НачислЗатрБазаПенс = Окр(Коэф*НачислЗатрБазаПенс,2);
				НачислПрибБазаПенс = МаксБазаПенсИнв - НачислЗатрБазаПенс;
			КонецЕсли;
		Иначе
			Если НачислЗатрБазаПенс+НачислПрибБазаПенс > МаксБазаПенс Тогда
				Коэф = МаксБазаПенс / (НачислЗатрБазаПенс + НачислПрибБазаПенс);
				НачислЗатрБазаПенс = Окр(Коэф*НачислЗатрБазаПенс,2);
				НачислПрибБазаПенс = МаксБазаПенс - НачислЗатрБазаПенс;
			КонецЕсли;
		КонецЕсли;
		
		НачислИнвЗатрБазаПенс = НачислЗатрБазаПенс * ЭтоИнвалид;
		НачислИнвПрибБазаПенс = НачислПрибБазаПенс * ЭтоИнвалид;
		
		
		Для Н=1 По 3 Цикл
			Если НачислЗатрБазаОбщ+НачислПрибБазаОбщ > МаксБаза[Н] Тогда
				Коэф = МаксБаза[Н] / (НачислЗатрБазаОбщ + НачислПрибБазаОбщ);
				НачислЗатрБаза[Н] = Окр(Коэф*НачислЗатрБазаОбщ,2);
				НачислПрибБаза[Н] = МаксБаза[Н] - НачислЗатрБаза[Н];
			Иначе
				НачислЗатрБаза[Н] = НачислЗатрБазаОбщ;
				НачислПрибБаза[Н] = НачислПрибБазаОбщ;
			КонецЕсли;
			НачислИнвЗатрБаза[Н] = НачислЗатрБаза[Н] * ЭтоИнвалид;
			НачислИнвПрибБаза[Н] = НачислПрибБаза[Н] * ЭтоИнвалид;
		КонецЦикла;                    
		
				
		// Пенсионный
		Если ДатаДок < '01.01.2007' Тогда
			Если Пенсионный <= прПенс1Сотр Тогда
				Пенс1 = Пенсионный;
				Пенс2 = 0;
			Иначе
				Пенс2 = Пенсионный;
				Пенс1 = 0;
			КонецЕсли;
		Иначе
			// Пенсионный по шкале
			Пенс1 = Мин(Пенсионный,прПенс1Сотр);
			Пенс2 = Пенсионный - Пенс1;
		КонецЕсли;
		
		ИтПенс1 = ИтПенс1 + Пенс1;
		ИтПенс2 = ИтПенс2 + Пенс2;
		
		// Соцстрах на случай нетрудоспособности
		Если СтрахНетрудосп <= Окр(прСтрахНетрудосп1Сотр,2) Тогда
			СтрахНетрудосп1 = СтрахНетрудосп;
			СтрахНетрудосп2 = 0;
		Иначе
			СтрахНетрудосп2 = СтрахНетрудосп;
			СтрахНетрудосп1 = 0;
		КонецЕсли;
		ИтСтрахНетрудосп1 = ИтСтрахНетрудосп1 + СтрахНетрудосп1;
		ИтСтрахНетрудосп2 = ИтСтрахНетрудосп2 + СтрахНетрудосп2;
		
		//8 и 9
		СотрПенсЗатрат = СтПенОрг*НачислЗатрБазаПенс;
		СотрПенсПриб   = СтПенОрг*НачислПрибБазаПенс;
		
		ИтогСотрПенсЗатрат = ИтогСотрПенсЗатрат + СотрПенсЗатрат;
		ИтогСотрПенсПриб   = ИтогСотрПенсПриб + СотрПенсПриб;
		
		// 12 и 13
		СотрБезрабЗатрат = СтБзрОрг*НачислЗатрБаза[1];
		СотрБезрабПриб   = СтБзрОрг*НачислПрибБаза[1];
		
		ИтогСотрБезрабЗатр = ИтогСотрБезрабЗатр + СотрБезрабЗатрат;
		ИтогСотрБезрабПриб = ИтогСотрБезрабПриб + СотрБезрабПриб;
		
		//15 и 16
		СотрСоцСтрахЗатр = СтСоцОрг*НачислЗатрБаза[2];
		СотрСоцСтрахПриб = СтСоцОрг*НачислПрибБаза[2];
		
		ИтогСотрСоцСтрахПриб = ИтогСотрСоцСтрахПриб + СотрСоцСтрахПриб;
		ИтогСотрСоцСтрахЗатр = ИтогСотрСоцСтрахЗатр + СотрСоцСтрахЗатр;
		
		СотрСтрахНесчЗатр = СтНесчОрг*НачислЗатрБаза[3];
		СотрСтрахНесчПриб = СтНесчОрг*НачислПрибБаза[3];
		
		ИтогСотрСтрахНесчПриб = ИтогСотрСтрахНесчПриб + СотрСтрахНесчПриб;
		ИтогСотрСтрахНесчЗатр = ИтогСотрСтрахНесчЗатр + СотрСтрахНесчЗатр;
		
		Если стПенс1 = стПенс2 Тогда   
			Таб.ВывестиСекцию("Сотрудник2");
		Иначе
			Таб.ВывестиСекцию("Сотрудник");
		КонецЕсли;
		
		ИтНачислЗатр = ИтНачислЗатр + НачислЗатр;
		ИтНачислПриб = ИтНачислПриб + НачислПриб;
		
		ИтНачислЗатрБазаПенс = ИтНачислЗатрБазаПенс + НачислЗатрБазаПенс;
		ИтНачислПрибБазаПенс = ИтНачислПрибБазаПенс + НачислПрибБазаПенс;
		
		ИтНачислИнвЗатрБазаПенс = ИтНачислИнвЗатрБазаПенс + НачислИнвЗатрБазаПенс;
		ИтНачислИнвПрибБазаПенс = ИтНачислИнвПрибБазаПенс + НачислИнвПрибБазаПенс; 
		
		Для Н=1 По 3 Цикл
			
			ИтНачислЗатрБаза[Н] = НачислЗатрБаза[Н] + ИтНачислЗатрБаза[Н];
			ИтНачислПрибБаза[Н] = НачислПрибБаза[Н] + ИтНачислПрибБаза[Н];
				
			ИтНачислИнвЗатрБаза[Н] = НачислИнвЗатрБаза[Н] + ИтНачислИнвЗатрБаза[Н];
			ИтНачислИнвПрибБаза[Н] = НачислИнвПрибБаза[Н] + ИтНачислИнвПрибБаза[Н]; 
		
		КонецЦикла;                    
		
	КонецЦикла;
	
	ИтПенЗатрОрг 	= СтПенОрг * (ИтНачислЗатрБазаПенс-ИтНачислИнвЗатрБазаПенс);
	ИтПенПрибОрг 	= СтПенОрг * (ИтНачислПрибБазаПенс-ИтНачислИнвПрибБазаПенс);
	ИтПенИнвЗатрОрг = СтПенИнвОрг * ИтНачислИнвЗатрБазаПенс;
	ИтПенИнвПрибОрг = СтПенИнвОрг * ИтНачислИнвПрибБазаПенс;
	ИтБзрЗатрОрг = СтБзрОрг * ИтНачислЗатрБаза[1];
	ИтБзрПрибОрг = СтБзрОрг * ИтНачислПрибБаза[1];
	ИтСоцЗатрОрг = СтСоцОрг * ИтНачислЗатрБаза[2];
	ИтСоцПрибОрг = СтСоцОрг * ИтНачислПрибБаза[2];
	ИтНесчЗатрОрг = СтНесчОрг * ИтНачислЗатрБаза[3];
	ИтНесчПрибОрг = СтНесчОрг * ИтНачислПрибБаза[3];
	Если стПенс1 = стПенс2 Тогда   
		Таб.ВывестиСекцию("Итоги2");
	Иначе
		Таб.ВывестиСекцию("Итоги");
	КонецЕСли;
	Таб.ВывестиСекцию("Дно");
	
	Таб.Показать("Свод отчислений в Фонды","");
КонецПроцедуры
// ======================================
Процедура СводОтчислений2011()
	Перем ноЕСВ, ноЕСВБол, ноФЗПЕСВ, ноФЗПЕСВИнв, ноПрожМинимум;
	
	Таб.ПараметрыСтраницы(2); // ландшафт
	Таб.ПовторятьПриПечатиСтроки(9,9);
	КонецПериода = КонМесяца(ДатаДок);
	НачалоПериода = НачМесяца(ДатаДок);
	КвоДнейНач = КолРабДнейНачало;      
	КвоДнейРаб = Дней;             
	Если глПолучитьНиО(ноЕСВ,	   "ЕСВ",      "о едином социальном взносе с сотрудника!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноЕСВБольн, "ЕСВБольн", "о едином социальном взносе с сотрудника (больничный)!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноФЗПЕСВ,   "ФЗПЕСВ",   "единый социальный взнос с фонда заработной платы!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноФЗПЕСВИнв,"ФЗПЕСВИнв","единый социальный взнос с фонда заработной платы!(инвалиды)") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноПрожМинимум,"ПрожМинТруд","о минимальной зарплате!") = 0 Тогда
		Возврат;
	КонецЕсли;
	ПрожМинимум = ноПрожМинимум.Предел.Получить(НачМесяца(ДатаДок));
	//коэффициент уменьшения базы ЕСВ ФОТ для фирмы
	КоэфУменЕСВФОТ = 1;
	Если (НачалоПериода>='01.01.2015')  и (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда  
		КоэфУменЕСВФОТ = Фирма.КоэфУменьшенияСтавкиЕСВФОТ.Получить(КонецПериода);
		КоэфУменЕСВФОТ = ?(КоэфУменЕСВФОТ = 0, 1, КоэфУменЕСВФОТ);
	КонецЕсли;

	стЕСВОргПеч		= "";
	стЕСВИнвОргПеч	= "";
	стЕСВБолОргПеч	= "";
	
	// получим данные для печати
	Расшифровка = СоздатьОбъект( "СписокЗначений" );
	Расшифровка.Установить ("Дата",КонецПериода);
	Расшифровка.Установить("НеоблагМин","");
	глПолучитьДанные(Расшифровка);
	
	//Получаем ставки с историей изменений в течение месяца
	стЕСВОрг = ПолучитьСтавку("ФЗПЕСВ",стЕСВОргПеч);
	стЕСВИнвОрг = ПолучитьСтавку("ФЗПЕСВИнв",стЕСВИнвОргПеч);
	стЕСВБолОрг = ПолучитьСтавку("ФЗПЕСВБольн",стЕСВБолОргПеч);
	стЕСВУмОргПеч		= СокрЛП(Строка(Окр(стЕСВОрг*КоэфУменЕСВФОТ*100,3)))+" %";
	стЕСВУмБолОргПеч	= СокрЛП(Строка(Окр(стЕСВБолОрг*КоэфУменЕСВФОТ*100,3)))+" %";

	// определим максимальные базы, с которых взымаются отчисления в фонды
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноФЗПЕСВ.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВ = Число(Спис.Получить("Макс. база"));
	МаксБазаЕСВ = ?(МаксБазаЕСВ = 0, 999999999, МаксБазаЕСВ);
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноФЗПЕСВИнв.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВИнв = Число(Спис.Получить("Макс. база"));
	МаксБазаЕСВИнв = ?(МаксБазаЕСВИнв = 0, 999999999, МаксБазаЕСВИнв);
    
	Если ПустоеЗначение(Подразделение) = 1 Тогда
		ПодразделениеДляПечати = "";
	Иначе
		ПодразделениеДляПечати = ?(Константа.ФормыНаУкраинском = Да,"Підрозділ: ","Подразделение: ")+Подразделение.Наименование;
	КонецЕсли;	
	
	стЕСВ = ноЕСВ.Ставка.Получить(КонецПериода);
	стЕСВБол = ноЕСВБольн.Ставка.Получить(КонецПериода);
	Таб.ВывестиСекцию("Шапка");
	
	ИтНачислЗатр = 0;				
	ИтНачислПриб = 0;
	ИтНачислЗатрБазаЕСВ = 0;		
	ИтНачислПрибБазаЕСВ = 0;
	ИтНачислИнвЗатрБазаЕСВ = 0;	
	ИтНачислИнвПрибБазаЕСВ = 0;
	ИтНачислБолЗатрБазаЕСВ = 0;		
	ИтНачислБолИнвалБазаЕСВ = 0;	
	ИтНачислЗатрБазаЕСВУм = 0;		
	ИтНачислПрибБазаЕСВУм = 0;
	ИтНачислИнвЗатрБазаЕСВУм = 0;	
	ИтНачислИнвПрибБазаЕСВУм = 0;
	ИтНачислБолБазаЕСВУм = 0;
	ИтЕСВ = 0;					 
	ИтПроцЕСВБол = 0;					 
	ИтБазаСотр = 0;
	ИтЕСВЗатрОрг = 0; ИтЕСВПрибОрг = 0;
	ИтЕСВИнвЗатрОрг = 0; ИтЕСВИнвПрибОрг = 0;
	ИтЕСВЗатрОргУм = 0; ИтЕСВПрибОргУм = 0;
	ИтЕСВБолЗатрОрг = 0; ИтЕСВБолИнвОрг = 0; ИтЕСВБолОргУм = 0;
	
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		ЕСВФОТЗатрОргУм=0; ЕСВФОТПрибОргУм=0; ЕСВФОТЗатрОрг=0; ЕСВФОТПрибОрг=0; ЕСВФОТБолОргУм=0; ЕСВФОТБолОрг=0;
		ЕСВФОТБолОргИнв = 0; ЕСВФОТЗатрОргИнв=0; ЕСВФОТПрибОргИн=0; ЕСВФОТРазнОрг=0; ЕСВФОТРазнБол=0;
		
		ЭтоИнвалид = Сотрудник.Инвалид.Получить(КонМесяца(ДатаДок));
		ТипСотр = Сотрудник.ТипСотрудника.Получить(КонМесяца(ДатаДок));
		фОснСот = ?((ЭтоИнвалид = 1) или (ТипСотр = 0), 0,1);
		КоэфСот = ?(ЭтоИнвалид = 1, 1,КоэфУменЕСВФОТ);
		
		Если (ТипСотр = 0) и (НачалоПериода<'01.03.2015') Тогда
			//не основной сотрудник январь-февраль 2015
			КоэфСот = 1;
		КонецЕсли;
		Если фОснСот = 1 Тогда//проверим полный месяц
			Если (Сотрудник.ДатаУвольнения >= НачМесяца(ДатаДок)) и (Сотрудник.ДатаУвольнения <= КонМесяца(ДатаДок)) Тогда 
				//уволен в текущем месяце
				фОснСот = 0;
			КонецЕсли;
			Если (Сотрудник.ДатаПриема <= КонМесяца(ДатаДок)) и (Сотрудник.ДатаПриема >= НачМесяца(ДатаДок)) Тогда
				//принят в текущем месяце
				фОснСот = 0;
			КонецЕсли;
		КонецЕсли;
		НачислЗатр = Оклад+Отпускные+Индексация+ФиксирИндексация+БольничныеЗаСчетПредприятия+Тариф+Сдельно+Премия;
		НачислЗатрБазаОбщ = Оклад+Отпускные+Индексация+ФиксирИндексация+Тариф+Сдельно+Премия;
		Для НомНач = 1 по КвоНач Цикл
			НачислЗатр = НачислЗатр + ПолучитьАтрибут("СуммаНачисл"+НомНач);
			НачислЗатрБазаОбщ = НачислЗатрБазаОбщ + ПолучитьАтрибут("СуммаНачисл"+НомНач);
		КонецЦикла;
		НачислПриб = ОблагаемаяМатПомощь;
		
		НачислЗатрБазаЕСВ = НачислЗатрБазаОбщ;
		НачислБолЗатрБазаЕСВ = Больничные + БольничныеЗаСчетПредприятия;
		НачислПрибБазаЕСВ = ОблагаемаяМатПомощь;

		Если ЭтоИнвалид = 1 Тогда
			Если НачислЗатрБазаЕСВ+НачислПрибБазаЕСВ > МаксБазаЕСВИнв Тогда
				Коэф = МаксБазаЕСВИнв / (НачислЗатрБазаЕСВ + НачислПрибБазаЕСВ);
				НачислЗатрБазаЕСВ = Окр(Коэф*НачислЗатрБазаЕСВ,2);
				НачислПрибБазаЕСВ = МаксБазаЕСВИнв - НачислЗатрБазаЕСВ; 
				НачислБолЗатрБазаЕСВ = 0; //больничный не попал в базу налогообложения
			ИначеЕсли НачислЗатрБазаЕСВ+НачислПрибБазаЕСВ+НачислБолЗатрБазаЕСВ > МаксБазаЕСВИнв Тогда
				НачислБолЗатрБазаЕСВ = Мин(МаксБазаЕСВИнв-НачислЗатрБазаЕСВ-НачислПрибБазаЕСВ,НачислБолЗатрБазаЕСВ);
			КонецЕсли;
		Иначе
			Если НачислЗатрБазаЕСВ+НачислПрибБазаЕСВ > МаксБазаЕСВ Тогда
				Коэф = МаксБазаЕСВ / (НачислЗатрБазаЕСВ + НачислПрибБазаЕСВ);
				НачислЗатрБазаЕСВ = Окр(Коэф*НачислЗатрБазаЕСВ,2);
				НачислПрибБазаЕСВ = МаксБазаЕСВ - НачислЗатрБазаЕСВ;
				НачислБолЗатрБазаЕСВ = 0; //больничный не попал в базу налогообложения
			ИначеЕсли НачислЗатрБазаЕСВ+НачислПрибБазаЕСВ+НачислБолЗатрБазаЕСВ >= МаксБазаЕСВ Тогда
				НачислБолЗатрБазаЕСВ = Мин(МаксБазаЕСВ-НачислЗатрБазаЕСВ-НачислПрибБазаЕСВ,НачислБолЗатрБазаЕСВ);
			КонецЕсли;
		КонецЕсли;
		
		//8
		СотрЕСВЗатрат = СтЕСВОрг*НачислЗатрБазаЕСВ;
		СотрЕСВПриб   = СтЕСВОрг*НачислПрибБазаЕСВ;
		
		База = НачислЗатрБазаЕСВ + НачислБолЗатрБазаЕСВ + НачислПрибБазаЕСВ + НачисленоВПрошломПериоде; 
		БазаСотр = НачислЗатрБазаЕСВ + НачислПрибБазаЕСВ; 
		БазаБолСотр = НачислБолЗатрБазаЕСВ;
		НачислРазнЕСВ = 0; НачислБолРазнЕСВ = 0;
		Если (НачалоПериода >= '01.01.2015') и (фОснСот=1) и (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда 
			//сравним базу налогообложения с минимальной ЗП 
			Если (База < ПрожМинимум) и (База>0) Тогда 
				Если (НачислЗатрБазаЕСВ + НачислПрибБазаЕСВ + НачисленоВПрошломПериоде) <> 0 Тогда
					НачислРазнЕСВ = ПрожМинимум - База; 
				Иначе 
					НачислБолРазнЕСВ = ПрожМинимум - База; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;                            
		
		НачислИнвЗатрБазаЕСВ = НачислЗатрБазаЕСВ * ЭтоИнвалид;
		НачислИнвПрибБазаЕСВ = НачислПрибБазаЕСВ * ЭтоИнвалид;

		//9
		ИтЕСВ = ИтЕСВ + ЕдиныйВзнос;
		//10
		ПроцЕСВБол = БазаБолСотр*СтЕСВБол;
		ИтПроцЕСВБол = ИтПроцЕСВБол + ПроцЕСВБол;
		ИтБазаСотр = ИтБазаСотр + БазаСотр + БазаБолСотр;
		
		Таб.ВывестиСекцию("Сотрудник");
		
		ИтНачислЗатр = ИтНачислЗатр + НачислЗатр;      
		ИтНачислПриб = ИтНачислПриб + НачислПриб;
		
		Если (НачалоПериода>='01.03.2015') и (КоэфСот<>1) Тогда
			ИтНачислБолБазаЕСВУм = ИтНачислБолБазаЕСВУм + НачислБолЗатрБазаЕСВ; 
		Иначе
			ИтНачислБолЗатрБазаЕСВ = ИтНачислБолЗатрБазаЕСВ + НачислБолЗатрБазаЕСВ;
		КонецЕсли;
		//для расчета ФОТ больничный для инвалидов с 01.12.2011  
		Если НачалоПериода>='01.12.2011' Тогда
			ИтНачислБолИнвалБазаЕСВ = ИтНачислБолИнвалБазаЕСВ + НачислБолЗатрБазаЕСВ* ЭтоИнвалид;
		КонецЕсли;
		
		Если КоэфСот<>1 Тогда
			ИтНачислЗатрБазаЕСВУм = ИтНачислЗатрБазаЕСВУм + НачислЗатрБазаЕСВ;		
			ИтНачислПрибБазаЕСВУм = ИтНачислПрибБазаЕСВУм + НачислПрибБазаЕСВ;
			//расчет ЕСВ ФОТ для сотрудника в разрезе начислений
			ЕСВФОТЗатрОргУм	= Окр(Окр(СтЕСВОрг * КоэфУменЕСВФОТ,5) * (НачислЗатрБазаЕСВ-Отпускные),2,1) + 
							  Окр(Окр(СтЕСВОрг * КоэфУменЕСВФОТ,5) * Отпускные,2,1);
			ЕСВФОТПрибОргУм	= Окр(Окр(СтЕСВОрг * КоэфУменЕСВФОТ,5) * НачислПрибБазаЕСВ,2,1);
		ИначеЕсли ЭтоИнвалид = 1 Тогда
			ИтНачислИнвЗатрБазаЕСВ = ИтНачислИнвЗатрБазаЕСВ + НачислИнвЗатрБазаЕСВ;
			ИтНачислИнвПрибБазаЕСВ = ИтНачислИнвПрибБазаЕСВ + НачислИнвПрибБазаЕСВ; 
			//расчет ЕСВ ФОТ для сотрудника в разрезе начислений
			ЕСВФОТЗатрОргИнв = Окр(СтЕСВИнвОрг * (НачислЗатрБазаЕСВ-Отпускные),2,1)+Окр(СтЕСВИнвОрг * Отпускные,2,1);
			ЕСВФОТПрибОргИн  = Окр(СтЕСВИнвОрг * НачислПрибБазаЕСВ,2,1);
		Иначе	
			ИтНачислЗатрБазаЕСВ = ИтНачислЗатрБазаЕСВ + НачислЗатрБазаЕСВ;
			ИтНачислПрибБазаЕСВ = ИтНачислПрибБазаЕСВ + НачислПрибБазаЕСВ;
			//расчет ЕСВ ФОТ для сотрудника в разрезе начислений
			ЕСВФОТЗатрОрг = Окр(СтЕСВОрг * (НачислЗатрБазаЕСВ-Отпускные),2,1)+Окр(СтЕСВОрг * Отпускные,2,1);
			ЕСВФОТПрибОрг = Окр(СтЕСВОрг * НачислПрибБазаЕСВ,2,1);
		КонецЕсли;
		Если (НачалоПериода>='01.03.2015') и (КоэфСот<>1) Тогда
			ИтНачислБолБазаЕСВУм = ИтНачислБолБазаЕСВУм + НачислБолЗатрБазаЕСВ; 
			ЕСВФОТБолОргУм = Окр(Окр(СтЕСВБолОрг * КоэфУменЕСВФОТ,5) * НачислБолЗатрБазаЕСВ,2,1);
		Иначе
			ИтНачислБолЗатрБазаЕСВ = ИтНачислБолЗатрБазаЕСВ + НачислБолЗатрБазаЕСВ;
			ЕСВФОТБолОрг = Окр(СтЕСВБолОрг * НачислБолЗатрБазаЕСВ,2,1);
		КонецЕсли;
		//добавим доначисление до минимума
		ЕСВФОТРазнОрг = Окр(СтЕСВОрг * НачислРазнЕСВ,2,1);
		ЕСВФОТРазнБол = Окр(СтЕСВБолОрг * НачислБолРазнЕСВ,2,1);
		ИтНачислЗатрБазаЕСВ = ИтНачислЗатрБазаЕСВ + НачислРазнЕСВ;
		ИтНачислБолЗатрБазаЕСВ = ИтНачислБолЗатрБазаЕСВ + НачислБолРазнЕСВ;
		
		//для расчета ФОТ больничный для инвалидов с 01.12.2011  
		Если (НачалоПериода>='01.12.2011') и (ЭтоИнвалид = 1) Тогда
			ИтНачислБолИнвалБазаЕСВ = ИтНачислБолИнвалБазаЕСВ + НачислБолЗатрБазаЕСВ;
			ЕСВФОТБолОргИнв = Окр(СтЕСВИнвОрг * НачислБолЗатрБазаЕСВ,2,1); 
			ЕСВФОТБолОрг = 0;
		КонецЕсли;
		
		ИтЕСВЗатрОрг 	= ИтЕСВЗатрОрг    + ЕСВФОТЗатрОрг + ЕСВФОТРазнОрг;
		ИтЕСВПрибОрг 	= ИтЕСВПрибОрг    + ЕСВФОТПрибОрг;
		ИтЕСВИнвЗатрОрг = ИтЕСВИнвЗатрОрг + ЕСВФОТЗатрОргИнв;
		ИтЕСВИнвПрибОрг = ИтЕСВИнвПрибОрг + ЕСВФОТПрибОргИн;
		ИтЕСВЗатрОргУм 	= ИтЕСВЗатрОргУм  + ЕСВФОТЗатрОргУм;
		ИтЕСВПрибОргУм 	= ИтЕСВПрибОргУм  + ЕСВФОТПрибОргУм;
		ИтЕСВБолЗатрОрг = ИтЕСВБолЗатрОрг + ЕСВФОТБолОрг + ЕСВФОТРазнБол;
		ИтЕСВБолИнвОрг  = ИтЕСВБолИнвОрг  + ЕСВФОТБолОргИнв;
		ИтЕСВБолОргУм 	= ИтЕСВБолОргУм   + ЕСВФОТБолОргУм;
	КонецЦикла;
	
	Таб.ПовторятьПриПечатиСтроки(9,9);
	Таб.ВывестиСекцию("Итоги");
	Таб.ВывестиСекцию("Дно");    
	
	Таб.Показать("Свод отчислений в Фонды","");
КонецПроцедуры
// ======================================
Процедура СводОтчислений2016()
	Перем ноФЗПЕСВ, ноФЗПЕСВИнв, ноМинЗарплата;
	
	Таб.ПараметрыСтраницы(2); // ландшафт
	Таб.ПовторятьПриПечатиСтроки(9,9);
	КонецПериода = КонМесяца(ДатаДок);
	НачалоПериода = НачМесяца(ДатаДок);
	КвоДнейНач = КолРабДнейНачало;      
	КвоДнейРаб = Дней;             
	Если глПолучитьНиО(ноФЗПЕСВ,   "ФЗПЕСВ",   "единый социальный взнос с фонда заработной платы!") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноФЗПЕСВИнв,"ФЗПЕСВИнв","единый социальный взнос с фонда заработной платы!(инвалиды)") = 0 Тогда
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноМинЗарплата,"МинЗарплата","о минимальной зарплате!") = 0 Тогда
		Возврат;
	КонецЕсли;
	ПрожМинимум = ноМинЗарплата.Предел.Получить(НачМесяца(ДатаДок));
	стЕСВОргПеч		= "";
	стЕСВИнвОргПеч	= "";
	
	//Получаем ставки с историей изменений в течение месяца
	стЕСВОрг = ПолучитьСтавку("ФЗПЕСВ",стЕСВОргПеч);
	стЕСВИнвОрг = ПолучитьСтавку("ФЗПЕСВИнв",стЕСВИнвОргПеч);

	// определим максимальные базы, с которых взымаются отчисления в фонды
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноФЗПЕСВ.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВ = Число(Спис.Получить("Макс. база"));
	МаксБазаЕСВ = ?(МаксБазаЕСВ = 0, 999999999, МаксБазаЕСВ);
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноФЗПЕСВИнв.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВИнв = Число(Спис.Получить("Макс. база"));
	МаксБазаЕСВИнв = ?(МаксБазаЕСВИнв = 0, 999999999, МаксБазаЕСВИнв);
    
	Если ПустоеЗначение(Подразделение) = 1 Тогда
		ПодразделениеДляПечати = "";
	Иначе
		ПодразделениеДляПечати = ?(Константа.ФормыНаУкраинском = Да,"Підрозділ: ","Подразделение: ")+Подразделение.Наименование;
	КонецЕсли;	
	
	Таб.ВывестиСекцию("Шапка");
	
	ИтНачислЗатр = 0;				
	ИтНачислПриб = 0;
	ИтНачислЗатрБазаЕСВ = 0;		
	ИтНачислПрибБазаЕСВ = 0;
	ИтНачислИнвЗатрБазаЕСВ = 0;	
	ИтНачислИнвПрибБазаЕСВ = 0;
	ИтНачислБолЗатрБазаЕСВ = 0;		
	ИтНачислБолИнвалБазаЕСВ = 0;	
	ИтНачислОтпБазаЕСВ = 0;	
	ИтНачислИнвОтпБазаЕСВ = 0;	
	ИтНачислРазнЕСВ = 0;		
	ИтЕСВЗатрОрг = 0; ИтЕСВПрибОрг = 0;
	ИтЕСВИнвЗатрОрг = 0; ИтЕСВИнвПрибОрг = 0;
	ИтЕСВБолЗатрОрг = 0; ИтЕСВБолИнвОрг = 0; 
	ИтЕСВОтпОрг = 0; ИтЕСВОтпИнвОрг = 0; ИтЕСВРазнОрг = 0;
	
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		ЕСВФОТЗатрОрг=0; ЕСВФОТПрибОрг=0; ЕСВФОТБолОрг=0; ЕСВФОТОтпОрг=0; ЕСВФОТОтпОргИнв = 0;
		ЕСВФОТБолОргИнв = 0; ЕСВФОТЗатрОргИнв=0; ЕСВФОТПрибОргИн=0; ЕСВФОТРазнОрг=0; 
		
		ЭтоИнвалид = Сотрудник.Инвалид.Получить(КонМесяца(ДатаДок));
		ТипСотр = Сотрудник.ТипСотрудника.Получить(КонМесяца(ДатаДок));
		фОснСот = ?((ЭтоИнвалид = 1) или (ТипСотр = 0), 0,1);
		
		Если фОснСот = 1 Тогда//проверим полный месяц
			Если (Сотрудник.ДатаУвольнения >= НачМесяца(ДатаДок)) и (Сотрудник.ДатаУвольнения < КонМесяца(ДатаДок)) Тогда 
				//уволен в текущем месяце
				фОснСот = 0;
			КонецЕсли;
			Если (Сотрудник.ДатаПриема <= КонМесяца(ДатаДок)) и (Сотрудник.ДатаПриема > НачМесяца(ДатаДок)) Тогда
				//принят в текущем месяце
				фОснСот = 0;
			КонецЕсли;
		КонецЕсли;
		НачислЗатр = Оклад+Отпускные+Индексация+ФиксирИндексация+БольничныеЗаСчетПредприятия+Тариф+Сдельно+Премия + ДоплДоМнЗП;
		НачислЗатрБазаОбщ = Оклад+Индексация+ФиксирИндексация+Тариф+Сдельно+Премия + ДоплДоМнЗП;
		Для НомНач = 1 по КвоНач Цикл
			НачислЗатр = НачислЗатр + ПолучитьАтрибут("СуммаНачисл"+НомНач);
			НачислЗатрБазаОбщ = НачислЗатрБазаОбщ + ПолучитьАтрибут("СуммаНачисл"+НомНач);
		КонецЦикла;
		НачислПриб = ОблагаемаяМатПомощь;
		НачислОтпБазаЕСВ = Отпускные;
	
		НачислЗатрБазаЕСВ = НачислЗатрБазаОбщ;
		НачислБолЗатрБазаЕСВ = Больничные + БольничныеЗаСчетПредприятия;
		НачислПрибБазаЕСВ = ОблагаемаяМатПомощь;

		Если ЭтоИнвалид = 1 Тогда  
			МаксБаза = МаксБазаЕСВИнв;
		Иначе
			МаксБаза = МаксБазаЕСВ;
		КонецЕсли;
		Если НачислЗатрБазаЕСВ+НачислПрибБазаЕСВ+НачислОтпБазаЕСВ > МаксБаза Тогда
			Коэф = МаксБаза / (НачислЗатрБазаЕСВ + НачислПрибБазаЕСВ + НачислОтпБазаЕСВ);
			НачислЗатрБазаЕСВ = Окр(Коэф*НачислЗатрБазаЕСВ,2);
			НачислОтпБазаЕСВ = Окр(Коэф*НачислОтпБазаЕСВ,2);
			НачислПрибБазаЕСВ = МаксБаза - НачислЗатрБазаЕСВ - НачислОтпБазаЕСВ; 
			НачислБолЗатрБазаЕСВ = 0; //больничный не попал в базу налогообложения
		ИначеЕсли НачислЗатрБазаЕСВ+НачислПрибБазаЕСВ+НачислБолЗатрБазаЕСВ+НачислОтпБазаЕСВ > МаксБаза Тогда
			НачислБолЗатрБазаЕСВ = Мин(МаксБаза-НачислЗатрБазаЕСВ-НачислПрибБазаЕСВ-НачислОтпБазаЕСВ,НачислБолЗатрБазаЕСВ);
		КонецЕсли;
		
		База = НачислЗатрБазаЕСВ + НачислОтпБазаЕСВ + НачислБолЗатрБазаЕСВ + НачислПрибБазаЕСВ + НачисленоВПрошломПериоде; 
		НачислРазнЕСВ = 0; 
		Если (фОснСот=1) и (ВидНачисления <> Перечисление.ВидыНачисленияЗП.Аванс) Тогда 
			//сравним базу налогообложения с минимальной ЗП 
			Если (База < ПрожМинимум) и (База>0) Тогда 
				НачислРазнЕСВ = ПрожМинимум - База; 
			КонецЕсли;
		КонецЕсли;                            
		
		НачислИнвЗатрБазаЕСВ = НачислЗатрБазаЕСВ * ЭтоИнвалид;
		НачислИнвПрибБазаЕСВ = НачислПрибБазаЕСВ * ЭтоИнвалид;
		НачислИнвОтпБазаЕСВ  = НачислОтпБазаЕСВ * ЭтоИнвалид;
		НачислЗатрБазаЕСВ = НачислЗатрБазаЕСВ - НачислИнвЗатрБазаЕСВ;
		НачислПрибБазаЕСВ = НачислПрибБазаЕСВ - НачислИнвПрибБазаЕСВ;
		НачислОтпБазаЕСВ  = НачислОтпБазаЕСВ  - НачислИнвОтпБазаЕСВ;

		Таб.ВывестиСекцию("Сотрудник");
		
		ИтНачислЗатр = ИтНачислЗатр + НачислЗатр;      
		ИтНачислПриб = ИтНачислПриб + НачислПриб;
		
		ИтНачислИнвЗатрБазаЕСВ = ИтНачислИнвЗатрБазаЕСВ + НачислИнвЗатрБазаЕСВ;
		ИтНачислИнвПрибБазаЕСВ = ИтНачислИнвПрибБазаЕСВ + НачислИнвПрибБазаЕСВ; 
		ИтНачислИнвОтпБазаЕСВ  = ИтНачислИнвОтпБазаЕСВ  + НачислИнвОтпБазаЕСВ; 
		ЕСВФОТЗатрОргИнв = Окр(СтЕСВИнвОрг * НачислИнвЗатрБазаЕСВ,2,1);
		ЕСВФОТОтпОргИнв  = Окр(СтЕСВИнвОрг * НачислИнвОтпБазаЕСВ,2,1);
		ЕСВФОТПрибОргИн  = Окр(СтЕСВИнвОрг * НачислИнвПрибБазаЕСВ,2,1);
		
		ИтНачислЗатрБазаЕСВ = ИтНачислЗатрБазаЕСВ + НачислЗатрБазаЕСВ;
		ИтНачислПрибБазаЕСВ = ИтНачислПрибБазаЕСВ + НачислПрибБазаЕСВ;
		ИтНачислОтпБазаЕСВ  = ИтНачислОтпБазаЕСВ  + НачислОтпБазаЕСВ; 
		ЕСВФОТЗатрОрг = Окр(СтЕСВОрг * НачислЗатрБазаЕСВ,2,1);
		ЕСВФОТОтпОрг  = Окр(СтЕСВОрг * НачислОтпБазаЕСВ,2,1);
		ЕСВФОТПрибОрг = Окр(СтЕСВОрг * НачислПрибБазаЕСВ,2,1);

		ИтНачислБолЗатрБазаЕСВ = ИтНачислБолЗатрБазаЕСВ + НачислБолЗатрБазаЕСВ;
		ЕСВФОТБолОрг = Окр(СтЕСВОрг * НачислБолЗатрБазаЕСВ,2,1);

		//добавим доначисление до минимума
		ИтНачислРазнЕСВ  = ИтНачислРазнЕСВ  + НачислРазнЕСВ; 
		ЕСВФОТРазнОрг = Окр(СтЕСВОрг * НачислРазнЕСВ,2,1);
		
		//для расчета ФОТ больничный для инвалидов  
		Если (ЭтоИнвалид = 1) Тогда
			ИтНачислБолИнвалБазаЕСВ = ИтНачислБолИнвалБазаЕСВ + НачислБолЗатрБазаЕСВ;
			ЕСВФОТБолОргИнв = Окр(СтЕСВИнвОрг * НачислБолЗатрБазаЕСВ,2,1); 
			ЕСВФОТБолОрг = 0;
		КонецЕсли;
		
		ИтЕСВЗатрОрг 	= ИтЕСВЗатрОрг    + ЕСВФОТЗатрОрг;
		ИтЕСВПрибОрг 	= ИтЕСВПрибОрг    + ЕСВФОТПрибОрг;
		ИтЕСВИнвЗатрОрг = ИтЕСВИнвЗатрОрг + ЕСВФОТЗатрОргИнв;
		ИтЕСВИнвПрибОрг = ИтЕСВИнвПрибОрг + ЕСВФОТПрибОргИн;
		ИтЕСВОтпОрг 	= ИтЕСВОтпОрг     + ЕСВФОТОтпОрг;
		ИтЕСВРазнОрг 	= ИтЕСВРазнОрг    + ЕСВФОТРазнОрг;
		ИтЕСВБолЗатрОрг = ИтЕСВБолЗатрОрг + ЕСВФОТБолОрг;
		ИтЕСВБолИнвОрг  = ИтЕСВБолИнвОрг  + ЕСВФОТБолОргИнв;
		ИтЕСВОтпИнвОрг  = ИтЕСВОтпИнвОрг  + ЕСВФОТОтпОргИнв;
	КонецЦикла;
	ИтогБазаОрг = ИтНачислЗатрБазаЕСВ+ИтНачислПрибБазаЕСВ+ИтНачислБолЗатрБазаЕСВ-ИтНачислБолИнвалБазаЕСВ+ИтНачислОтпБазаЕСВ;
	ИтогЕСВЗатрОрг = ИтЕСВЗатрОрг+ИтЕСВБолЗатрОрг+ИтЕСВОтпОрг;
	ИтогБазаИнв = ИтНачислИнвЗатрБазаЕСВ+ИтНачислИнвПрибБазаЕСВ+ИтНачислБолИнвалБазаЕСВ+ИтНачислИнвОтпБазаЕСВ;
	ИтогЕСВЗатрИнв = ИтЕСВИнвЗатрОрг+ИтЕСВБолИнвОрг+ИтЕСВОтпИнвОрг; 
		
	Таб.ПовторятьПриПечатиСтроки(9,9);
	Таб.ВывестиСекцию("Итоги");
	Таб.ВывестиСекцию("Дно");    
	
	Таб.Показать("Свод отчислений в Фонды","");
КонецПроцедуры
// ===============================
Процедура Печать()
	Перем ТипФормы;
	ТипыФорм = СоздатьОбъект("СписокЗначений");
	
	Если ВидНачисления = ОсновнаяЗП Тогда
		ТипыФорм.ДобавитьЗначение(1,"Расчетно-платежная ведомость");
		ТипыФорм.ДобавитьЗначение(2,"Расчетно-платежная ведомость(П6)");
		ТипыФорм.ДобавитьЗначение(3,"Расч-плат ведомость(П6) для сотрудника");
		ТипыФорм.ДобавитьЗначение(4,"Расчетные листки");
		ТипыФорм.ДобавитьЗначение(5,"Свод отчислений в фонды");
		ТипыФорм.ДобавитьЗначение(6,"Расчетно-платежная ведомость(П7)");
		ТипыФорм.ДобавитьЗначение(7,"Платежная ведомость");
		ТипыФорм.ДобавитьЗначение(8,"Платежная ведомость (1 стр)");
	Иначе	
		ТипыФорм.ДобавитьЗначение(1,"Расчетно-платежная ведомость");
		ТипыФорм.ДобавитьЗначение(2,"Расчетно-платежная ведомость(П6)");
		ТипыФорм.ДобавитьЗначение(5,"Свод отчислений в фонды");
		ТипыФорм.ДобавитьЗначение(7,"Платежная ведомость");
		ТипыФорм.ДобавитьЗначение(8,"Платежная ведомость (1 стр)");
	КонецЕсли;
	Если ТипыФорм.ВыбратьЗначение(ТипФормы,"Виберите тип формы",2,0,1) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ФИОПолностью = Константа.ФИОПолностью;
	
	глУстПропись(Гривня);
	ДатаВед = ПериодСтр(НачМесяца(ДатаДок), КонМесяца(ДатаДок));
	Директор = глФИО(Фирма.Руководитель.Получить(ДатаДок),1);
	ГлавБух = глФИО(Фирма.ГлавныйБухгалтер.Получить(ДатаДок),1);
	Организация = Фирма.ПолнНаименование;     
	ЕДРПОУ =  Фирма.ЕДРПОУ;
	Таб = СоздатьОбъект("Таблица");
	Таб.Опции(0,0,0,0);
	Таб.Защита(Константа.ФлагЗащитыТаблиц);
	Таб.ТолькоПросмотр(1);
	
	СуффиксТаблицы = ?(Константа.ФормыНаУкраинском = Да,"_Укр","");
	Если ТипФормы = 1 Тогда
		ПрефиксТаблицы = "РасчПлатВед";
		Если ДатаДок >= глДатаПереходаНаЕСВ Тогда
			ПрефиксТаблицы = ПрефиксТаблицы+"2011"; 
		КонецЕсли; 
	ИначеЕсли (ТипФормы = 7) или (ТипФормы = 8) Тогда
		ПрефиксТаблицы = "ПлатВед_2018";
		СуффиксТаблицы = "";
	ИначеЕсли ТипФормы = 4 Тогда
		ПрефиксТаблицы = "Листки";
	ИначеЕсли (ТипФормы = 2) ИЛИ (ТипФормы = 3) Тогда
		ПрефиксТаблицы = "П6";
		СуффиксТаблицы = "";
	ИначеЕсли ТипФормы = 6 Тогда
		ПрефиксТаблицы = "П7";
		СуффиксТаблицы = "";
	Иначе
		Если ДатаДок < глДатаПереходаНаЕСВ Тогда
			ПрефиксТаблицы = "Свод"; 
		ИначеЕсли ДатаДок < '01/01/2016' Тогда
			ПрефиксТаблицы = "Свод2011";
		Иначе	
			ПрефиксТаблицы = "Свод2016";
		КонецЕсли; 
		
	КонецЕсли;
	Таб.ИсходнаяТаблица(ПрефиксТаблицы+СуффиксТаблицы);
	
	Если ТипФормы = 1 Тогда
		РасчПлатВед(); // расчетно-платежная ведомость
	ИначеЕсли (ТипФормы = 7) или (ТипФормы = 8) Тогда
		ПлатВед(ТипФормы); // платежная ведомость
	ИначеЕсли ТипФормы = 4 Тогда
		РасчетныеЛистки(); // расчетный листок
	ИначеЕсли ТипФормы = 2 Тогда
		ФормаП6(0,); // П6             
	ИначеЕсли ТипФормы = 3 Тогда
		ФормаП6(1, Сотрудник); // П6
	ИначеЕсли ТипФормы = 6 Тогда
		ФормаП7(); // П7
	Иначе
		Если ДатаДок < глДатаПереходаНаЕСВ Тогда
			СводОтчислений(); // свод отчислений в фонды
		ИначеЕсли ДатаДок < '01/01/2016' Тогда
			СводОтчислений2011(); // свод отчислений в фонды
		Иначе
			СводОтчислений2016(); // свод отчислений в фонды
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры

// ======================================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр)
	Если Рекв = "Сотрудник" Тогда
		ФлагСтандОбр = 0;
		КонтФирмы = Фирма;
		ОткрытьФорму("Справочник.Сотрудники.ДляВыбора",КонтФирмы);
	КонецЕсли;
КонецПроцедуры 

// ===============================
// Инициализируем список действий по кнопке "Действия"
СписокДействий = глПолучитьСписокДействий("
	|ДвиженияДокумента,
	|ОткрытьВЖурнале");
