Перем НачалоПериода, КонецПериода, МесяцНачисленияЗП, ИспользоватьОбеспечениеОтпусков;

//единый взнос
Перем ноЕСВ, ноЕСВИнв, ноЕСВБол, ноЕСВБолСот, ноЕСВСот, ноВоенСбор,ноМинЗарплата;
Перем МаксБазаЕСВ, МаксБазаЕСВИнв, МаксБазаЕСВСот;
Перем стЕСВОрг, стЕСВИнвОрг, стЕСВБолОрг, стЕСВБол,ПрожМинимум;

Перем ноПрофсоюзныйСотр, ноСоцстрБольничн;
Перем ТаблЗатр, ТаблСотр, ТаблЗатр23, ТекСчетЗатрат;

Перем КвоНач,ИтКолСотр;

Перем Под, ВиД;

Перем Ит;

// ===============================
Функция ПроверкаШапки()
	глВсеВыбрано = 1;
	глПроверкаДатыДок(Контекст,"Проведение");
	глВыбранЛи(Фирма,"Фирма");
	глВыбранЛи(ВидНачисления,"Вид начисления");
	Если ВидНачисления = ОсновнаяЗП Тогда
		Если глПроверитьАналитикуПоЗатратам(Подразделение,ВидДеятельности,0,0) = 0 Тогда
			глВсеВыбрано = 0;
		КонецЕсли;
		глВыбранЛи(ВидЗатратСоцОтчисления,"Вид затрат по отчислениям на обязательное пенсионное страхование");
		глВыбранЛи(ВидЗатратЗарплата,"Вид затрат по зарплате");
		глВыбранЛи(ВидЗатратПремии,"Вид затрат по премиям");
		глВыбранЛи(ВидЗатратОтпускные,"Вид затрат по отпускным");
		глВыбранЛи(ВидЗатратБольничные,"Вид затрат по больничным");
		глВыбранЛи(ВидЗатратПрочие,"Вид затрат по прочим начислениям");
		глВыбранЛи(ВидЗатратИндексация,"Вид затрат по индексации");
		глВыбранЛи(СчетБольнП,"Счет для больничных за счет предприятия");
		глВыбранЛи(СчетБольнФОТ,"Счет для взносов ФОТ больничного");
		//глВыбранЛи(СчетДопБазаФОТ,"Счет для взносов ФОТ доп. базы");
		глВыбранЛи(ВидЗатратБольнФОТ,"Вид затрат для взносов ФОТ больничного"); 
		Если ИспользоватьСчетаРасходов <> Класс9 Тогда
			глВыбранЛи(ВидЗатратЗарплата.Счет,"Счет 8-го класса для вида затрат по зарплате");
			глВыбранЛи(ВидЗатратПремии.Счет,"Счет 8-го класса для вида затрат по премиям");
			глВыбранЛи(ВидЗатратОтпускные.Счет,"Счет 8-го класса для вида затрат по отпускным");
			глВыбранЛи(ВидЗатратБольничные.Счет,"Счет 8-го класса для вида затрат по больничным");
			глВыбранЛи(ВидЗатратПрочие.Счет,"Счет 8-го класса для вида затрат по прочим начислениям");
			глВыбранЛи(ВидЗатратБольнФОТ,"Счет 8-го класса для вида затрат для взносов ФОТ больничного"); 
		КонецЕсли;
		Для НомНач = 1 по КвоНач Цикл
			Начисл = ПолучитьАтрибут("Начисл"+НомНач);
			Если ПустоеЗначение(Начисл) = 0 Тогда
				ВидЗатрат = ПолучитьАтрибут("ВидЗатратНачисл"+НомНач);
				глВыбранЛи(ВидЗатрат,"Вид затрат для произвольного начисления "+НомНач+" ("+Начисл+")");
				Если ИспользоватьСчетаРасходов <> Класс9 Тогда
					глВыбранЛи(ВидЗатрат.Счет,"Счет 8-го класса для вида затрат по произвольному начислению "+НомНач+" ("+Начисл+")");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат глВсеВыбрано;
КонецФункции

// ===========================
Функция ПроверкаСтроки()
	глВсеВыбрано = 1;
	глВыбранЛи(Сотрудник,"Сотрудник",НомерСтроки);
	Если глВсеВыбрано = 1 Тогда
		Если Сотрудник.Фирма <> Фирма Тогда
			глКомментарий("Сотрудник " +Сотрудник+ " (строка "+НомерСтроки+") работает в другой фирме!",0,,"!");
			глВсеВыбрано = 0;
		КонецЕсли;
		ТекСчетЗатрат = Сотрудник.СчетЗатрат.Получить(КонМесяца(ДатаДок));
		Если ПустоеЗначение(ТекСчетЗатрат) = 1 Тогда
			Если ИспользоватьСчетаРасходов <> Класс8 Тогда
				// Счет затрат для сотрудника не задан.
				// Если используется только 9 класс счетов, или и 8 и 9 классы -
				// установим по умолчанию 91 счет
				глКомментарий("Для сотрудника "+Сотрудник+" в строке "+НомерСтроки+" не задан счет затрат. Используется 91 счет затрат.",1,,"I");
				ТекСчетЗатрат = СчетПоКоду("91");
				// Если используется только 8 класс счетов, тогда счет в проводку
				// будет подставлен из аналитики ВидЗатрат по этой проводке
				// в глоб. процедуре глПроводкаПоЗатратам()
			КонецЕсли;
		ИначеЕсли ИспользоватьСчетаРасходов = Класс8 Тогда
			Если Лев(ТекСчетЗатрат.Код, 1) = "9" Тогда
				глКомментарий("Для сотрудника "+Сотрудник+" в строке "+НомерСтроки+" задан счет затрат 9 класса!",0,,"!");
				глКомментарий("   Счета 9 класса не используются. Проверьте счет затрат у сотрудника и константу ""Использовать счета расходов"".",0,,"!");
				глВсеВыбрано = 0;
			ИначеЕсли Лев(ТекСчетЗатрат.Код, 1) = "8" Тогда
				глКомментарий("Для сотрудника "+Сотрудник+" в строке "+НомерСтроки+" задан счет затрат 8 класса!",0,,"!");
				глКомментарий("   Используются счета только 8 класса. В этом случае счет затрат в справочнике Сотрудники должен быть не заполнен. Проверьте счет затрат у сотрудника и константу ""Использовать счета расходов"".",0,,"!");
				глВсеВыбрано = 0;
			КонецЕсли;
		ИначеЕсли (Лев(ТекСчетЗатрат.Код, 1) = "8") и (ИспользоватьСчетаРасходов = Класс9) Тогда
			глКомментарий("Для сотрудника "+Сотрудник+" в строке "+НомерСтроки+" задан счет затрат 8 класса!",0,,"!");
			глКомментарий("   Счета 8 класса не используются. Проверьте счет затрат у сотрудника и константу ""Использовать счета расходов"".",0,,"!");
			глВсеВыбрано = 0;
		КонецЕсли;
	КонецЕсли;
    Возврат глВсеВыбрано;
КонецФункции

// ===============================
// разбиваем базу для отчисления в фонд между "из затрат" и "из прибыли"
Процедура РаспределитьМеждуЗатрИПриб(БазаЗатр,БазаПриб,БазаОтп,ИтогоЗатр,ИтогоПриб,ИтогоОтп,МаксБаза)
	Если БазаЗатр+БазаПриб > МаксБаза Тогда
	    // собственно и нужно распределить, разбиваем пропорционально
		Коэф = МаксБаза / (БазаЗатр + БазаПриб);
		ИтогоЗатр = Окр(Коэф*БазаЗатр,2);
		ИтогоОтп  = Окр(Коэф*БазаОтп,2);
		ИтогоПриб = МаксБаза - Окр(Коэф*БазаЗатр,2);
	Иначе
		ИтогоЗатр = БазаЗатр;
		ИтогоОтп  = БазаОтп;
		ИтогоПриб = БазаПриб;
	КонецЕсли;
КонецПроцедуры

// ===============================
// Назначение:
// 		разбиваем базу для отчисления в фонд между "из затрат" и "из прибыли"
//		а затем полученную базу "из затрат" распределяем между видами деятельности
//		и подразделениями
// Аргументы:
//		ВидОтчисления	- идентификатор колонки таблицы ТаблЗатр для данного отчисления
//		МаксБаза		- макс. база для данного отчисления
Процедура РаспределитьМеждуСтрокТаблицы(ВидОтчисления,МаксБаза)
Перем Затр, Приб, Отп;
	
	ОблагаемоеЗатр = ТаблСотр.Итог("НачисленоЗатр");
	ОблагаемоеОтп  = ТаблСотр.Итог("НачисленоОтп");
	ОблагаемоеПриб = ТаблСотр.Итог("НачисленоПриб");
	СумВыпл = Мин(ОблагаемоеЗатр+ОблагаемоеОтп+ОблагаемоеПриб, МаксБаза);
	
	РаспределитьМеждуЗатрИПриб(ОблагаемоеЗатр,ОблагаемоеПриб,ОблагаемоеОтп,Затр,Приб,Отп,МаксБаза);
	// базу из затрат распределим пропорционально между всеми строками таблицы
	// (т.е. между видами деятельности и подразделениями)
	ТаблСотр.ВыбратьСтроки();
	Пока ТаблСотр.ПолучитьСтроку() = 1 Цикл
		Если Затр = 0 Тогда
			ТаблСотр.БазаЗатр = 0;
		Иначе
			ТаблСотр.БазаЗатр = ТаблСотр.НачисленоЗатр * Затр / ОблагаемоеЗатр;
		КонецЕсли;
		Если Отп = 0 Тогда
			ТаблСотр.БазаОтп  = 0;
		Иначе
			ТаблСотр.БазаОтп = ТаблСотр.НачисленоОтп * Отп / ОблагаемоеОтп;	
		КонецЕсли;	
	КонецЦикла;
	ТаблСотр.ПолучитьСтрокуПоНомеру(1); // 1-я строка - по начислениям из документа,
	ТаблСотр.БазаПриб = Приб;			// начисления за счет прибыли есть только в
										// этой строке, это ОблагаемаяМатПомощь
	Если Затр <> ТаблСотр.Итог("БазаЗатр") Тогда
		// по затратам: если есть дельта - отнесем ее в первую строку
		ТаблСотр.БазаЗатр = ТаблСотр.БазаЗатр + (Затр - ТаблСотр.Итог("БазаЗатр"));
	КонецЕсли;
	Если Отп <> ТаблСотр.Итог("БазаОтп") Тогда
		// по отпускным: если есть дельта - отнесем ее в первую строку
		ТаблСотр.БазаОтп = ТаблСотр.БазаОтп + (Отп - ТаблСотр.Итог("БазаОтп"));
	КонецЕсли;	

	// перенесем полученные данные в общую таблицу по отчислениям в фонды
	ТаблСотр.ВыбратьСтроки();
	Пока ТаблСотр.ПолучитьСтроку() = 1 Цикл
		ТаблЗатр.НоваяСтрока();
		Если ТаблСотр.НомерСтроки = 1 Тогда
			// в 1-й строке таблицы содержатся суммы из документа (не сдельные начисления)
			// они относятся на счет затрат, указанный для сотрудника
			ТаблЗатр.СчетЗатрат = ТекСчетЗатрат;
		Иначе
			// все остальные строки таблицы - сдельные начисления
			// всегда относим на 23 счет
			ТаблЗатр.СчетЗатрат = СчетПоКоду("231");
		КонецЕсли;
		ТаблЗатр.ВидДеятельности = ТаблСотр.ВидДеятельности;
		ТаблЗатр.Подразделение = ТаблСотр.Подразделение;
		ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,ВидОтчисления+"Отп",ТаблСотр.БазаОтп);
		ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,ВидОтчисления+"Приб",ТаблСотр.БазаПриб); 
		ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,ВидОтчисления+"Затр",ТаблСотр.БазаЗатр);
		Если (ДатаДок >= '01.01.2015') и (ТаблСотр.флОсновн = 1) Тогда
			//сравним базу налогообложения с минимальной ЗП 
			БазаЕСВОбщ = ТаблСотр.БазаЗатр+ТаблСотр.БазаОтп+ТаблСотр.БазаПриб+ТаблСотр.НачисленоБол+ТаблСотр.НачВПрошл; 
			База       = ТаблСотр.БазаЗатр+ТаблСотр.БазаОтп+ТаблСотр.БазаПриб; 
			Если (БазаЕСВОбщ < ПрожМинимум) и (БазаЕСВОбщ>0) Тогда 
				Если База <> 0 Тогда
					ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,ВидОтчисления+"Разн",ПрожМинимум - БазаЕСВОбщ);
				Иначе 
					ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,ВидОтчисления+"РазнБол",ПрожМинимум - БазаЕСВОбщ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если (ДатаДок >= глДатаПереходаНаЕСВ) и (ТаблСотр.НомерСтроки = 1) Тогда
			// больничный просто переносим в пределах Макс   
			СумБольн = 	Мин(МаксБаза - СумВыпл,ТаблСотр.НачисленоБол);
			ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,ВидОтчисления+"Болн",СумБольн);
		КонецЕсли;	
		ТаблЗатр.УстановитьЗначение(ТаблЗатр.НомерСтроки,"флКоэф",ТаблСотр.флКоэф);
	КонецЦикла;
КонецПроцедуры //РаспределитьМеждуСтрокТаблицы()

// ===============================
Функция ПолучитьЭлементШкалыСтавок(Элемент,КодЭлемента,ВидЗатрат="",Сообщение)
	Если глПолучитьНиО(Элемент,КодЭлемента,Сообщение) = 0 Тогда
	    Возврат 0;
	КонецЕсли;
	Если ТипЗначенияСтр(ВидЗатрат) <> "Строка" Тогда
		// нужно прочитать из справочника ВидЗатрат
		Если (ПустоеЗначение(Элемент.ВидЗатрат) = 1) Тогда
			глКомментарий("В справочнике ""Шкала ставок налогов"" не заполнен вид затрат для "+Элемент+" (сведения "+Сообщение+")",0);
			Возврат 0;
		КонецЕсли;
		ВидЗатрат = Элемент.ВидЗатрат;
	КонецЕсли;
	Возврат 1;
КонецФункции //ПолучитьЭлементШкалыСтавок

// ===============================
Функция ПолучитьСтавку(ИмяПараметра)
	НиО = СоздатьОбъект("Справочник.ШкалаСтавок");
	Если НиО.НайтиПоКоду(ИмяПараметра) = 1 Тогда
		// есть такой налог
		ПерСтавка = СоздатьОбъект("Периодический");
		ПерСтавка.ИспользоватьОбъект("Ставка",НиО);
		ПерСтавка.ВыбратьЗначения(НачалоПериода+1, КонецПериода);
		Ставка = 0;
		СтавкаПред = НиО.Ставка.Получить(НачалоПериода);
		НачалоПериодаСтавки = НачалоПериода;     
		КвоДнейНач = КолРабДнейНачало;      
		КвоДнейРаб = Дней;             
		стОргПеч = "";
		Пока ПерСтавка.ПолучитьЗначение() = 1 Цикл
			РабДней = КвоДнейНач;      
			стОргПеч =  стОргПеч + НачалоПериодаСтавки + "-" + (ПерСтавка.ДатаЗнач-1) + " (" + РабДней +" дн.) " + СтавкаПред*100+"%, ";
			
			Ставка = Ставка + СтавкаПред * РабДней;
			СтавкаПред = ПерСтавка.Значение;
			НачалоПериодаСтавки = ПерСтавка.ДатаЗнач;
		КонецЦикла;
		Если КвоДнейРаб = 0 Тогда
			  КвоДнейРаб = ?(Дней <> 0, Дней, 22);
		КонецЕсли;
		РабДней = КвоДнейРаб - КвоДнейНач;        
		
		Если НачалоПериодаСтавки = НачалоПериода Тогда 
			//Ставка в течение месяца не менялась - значит историю не выводим
		    стОргПеч = "" + СтавкаПред*100+" %";
			РабДней = КвоДнейРаб;        
		Иначе
			стОргПеч =  стОргПеч + НачалоПериодаСтавки + "-" + КонецПериода + " (" + РабДней +" дн.) " + СтавкаПред*100+"%";
		КонецЕсли;
				
		Ставка = Ставка + СтавкаПред * РабДней;
		РабДнейВсего = КвоДнейРаб;
		Ставка = Ставка / РабДнейВсего;
		Если НачалоПериодаСтавки <> НачалоПериода Тогда 
				Сообщить("Сумма взноса "+ НиО.Наименование + " рассчитана пропорционально рабочим дням ");
				Сообщить(" в связи с изменением ставки в течение месяца: "+стОргПеч);
		КонецЕсли;
		Возврат Ставка;
	КонецЕсли;
	Возврат 0;
КонецФункции 

// ===============================
Процедура РассчитатьШапку()
	КонецПериода = КонМесяца(ДатаДок);
	НачалоПериода = НачМесяца(ДатаДок);  
	
	НиО = СоздатьОбъект("Справочник.ШкалаСтавок");
	
	Если ПолучитьЭлементШкалыСтавок(ноПрофсоюзныйСотр,"СотрПрофсоюз",,"об отчислениях в профсоюз с сотрудника!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если ПолучитьЭлементШкалыСтавок(ноСоцстрБольничн,"СоцстрБольничн",,"Оплата больничных за счет ФСС!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	//единый взнос   пока счет пенсионного, если измениться - исправить
	Если ПолучитьЭлементШкалыСтавок(ноЕСВСот,"ЕСВ",,"о едином социальном взносе с сотрудника!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если ПолучитьЭлементШкалыСтавок(ноЕСВБолСот,"ЕСВБольн",,"о едином социальном взносе с сотрудника(больничный)!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если ПолучитьЭлементШкалыСтавок(ноЕСВ,"ФЗПЕСВ",,"единый социальный взнос с фонда заработной платы!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если ПолучитьЭлементШкалыСтавок(ноЕСВИнв,"ФЗПЕСВИнв",,"единый социальный взнос с фонда заработной платы(инвалиды)!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если ПолучитьЭлементШкалыСтавок(ноЕСВБол,"ФЗПЕСВБольн",,"единый социальный взнос с суммы оплаты больничных!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если ПолучитьЭлементШкалыСтавок(ноВоенСбор,"ВоенныйСбор",,"военный сбор с сотрудника!") = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	Если глПолучитьНиО(ноМинЗарплата,"МинЗарплата","о прожиточном минимуме!") = 0 Тогда
		Возврат;
	КонецЕсли;
	// получаем средние значения ставок за месяц
	стЕСВОрг    = ПолучитьСтавку("ФЗПЕСВ");
	стЕСВИнвОрг = ПолучитьСтавку("ФЗПЕСВИнв");
	стЕСВБолОрг = ПолучитьСтавку("ФЗПЕСВБольн");
	стЕСВБол    = ПолучитьСтавку("ЕСВБольн");
	
	Спис = СоздатьОбъект("СписокЗначений");
	глПарсить(ноЕСВ.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВ = Число(Спис.Получить("Макс. база"));
	глПарсить(ноЕСВИнв.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВИнв = Число(Спис.Получить("Макс. база"));
	ноЕСВРод = ноЕСВСот.Родитель;
	глПарсить(ноЕСВРод.Дополнительно.Получить(КонецПериода),Спис);
	МаксБазаЕСВСот = Число(Спис.Получить("Макс. база"));
	
	МаксБазаЕСВ    = ?(МаксБазаЕСВ = 0, 999999999, МаксБазаЕСВ);
	МаксБазаЕСВСот = ?(МаксБазаЕСВСот = 0, 999999999, МаксБазаЕСВСот);
	МаксБазаЕСВИнв = ?(МаксБазаЕСВИнв = 0, 999999999, МаксБазаЕСВИнв);

	ПрожМинимум = ноМинЗарплата.Предел.Получить(НачМесяца(ДатаДок));
	
	ТаблЗатр = СоздатьОбъект("ТаблицаЗначений");
	ТаблЗатр.НоваяКолонка("СчетЗатрат","Счет");
	ТаблЗатр.НоваяКолонка("ВидДеятельности","Справочник.ВидыДеятельности");
	ТаблЗатр.НоваяКолонка("Подразделение","Справочник.Подразделения");
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВЗатр",   "Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВОтп",    "Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВИнвЗатр","Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВИнвОтп", "Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВПриб",   "Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВИнвПриб","Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВБолн",   "Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВИнвБолн","Число",12,2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВРазн",	 "Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ОблагаемоеЕСВРазнБол","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("флКоэф","Число",1,0);

	ТаблСотр = СоздатьОбъект("ТаблицаЗначений");
	ТаблСотр.НоваяКолонка("ВидДеятельности","Справочник.ВидыДеятельности");
	ТаблСотр.НоваяКолонка("Подразделение","Справочник.Подразделения");
	ТаблСотр.НоваяКолонка("НачисленоЗатр","Число",12,2);
	ТаблСотр.НоваяКолонка("НачисленоОтп","Число",12,2);
	ТаблСотр.НоваяКолонка("НачисленоПриб","Число",12,2);
	ТаблСотр.НоваяКолонка("БазаЗатр","Число",12,2);
	ТаблСотр.НоваяКолонка("БазаОтп","Число",12,2);
	ТаблСотр.НоваяКолонка("БазаПриб","Число",12,2);
	ТаблСотр.НоваяКолонка("НачисленоБол","Число",12,2);
	ТаблСотр.НоваяКолонка("НачисленоБолИнв","Число",12,2);
	ТаблСотр.НоваяКолонка("НачВПрошл","Число",12,2);
	ТаблСотр.НоваяКолонка("флОсновн","Число",1,0);
	ТаблСотр.НоваяКолонка("флКоэф","Число",1,0);
	
	ТаблЗатр23 = СоздатьОбъект("ТаблицаЗначений");
	ТаблЗатр23.НоваяКолонка("ВидДеятельности","Справочник.ВидыДеятельности");
	ТаблЗатр23.НоваяКолонка("Подразделение","Справочник.Подразделения");
	ТаблЗатр23.НоваяКолонка("ВидЗатрат","Справочник.ВидыЗатрат");
	ТаблЗатр23.НоваяКолонка("Сумма","Число",12,2);

	// суммы по сдельным начислениям
	НачПериода = НачМесяца(ДатаДок); 
	КонПериода = СформироватьПозициюДокумента(ТекущийДокумент(),-1);
	
	ИспользоватьОбеспечениеОтпусков = Константа.ИспользоватьОбеспечениеОтпусков.Получить(КонецПериода);
	
	Если ИспользоватьСчетаРасходов <> Класс9 Тогда
		КоррСч = "81";
	Иначе
		КоррСч = "23";
	КонецЕсли;
	
	спСотрудники = СоздатьОбъект("СписокЗначений");
	ВыгрузитьТабличнуюЧасть(спСотрудники,"Сотрудник");
		
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.Сотрудники, спСотрудники);
	Ит.ИспользоватьСубконто(ВидыСубконто.МесяцНачисленияЗП);
	Ит.ИспользоватьКорСубконто(ВидыСубконто.ВидыДеятельности);
	Ит.ИспользоватьКорСубконто(ВидыСубконто.Подразделения);
	Ит.ВыполнитьЗапрос(НачПериода,КонПериода,"661",КоррСч,,2);
КонецПроцедуры

// ===============================
Процедура РассчитатьСтроку()
	// Подразделение и ВидДеятельности берем из документа, 
	// а если они не указаны - из Сотрудника
	Под = ?(Подразделение.Выбран()=1, Подразделение, Сотрудник.Подразделение);
	ВиД = ?(ВидДеятельности.Выбран()=1, ВидДеятельности, Сотрудник.ВидДеятельности.Получить(ДатаДок)); 
	ТипСотр = Сотрудник.ТипСотрудника.Получить(ДатаДок);
	ЭтоИнвалид = Сотрудник.Инвалид.Получить(КонецПериода);
	флКоэф = 1;
	Если ((ТипСотр = 0)и(НачалоПериода<'01.03.2015')) или (ЭтоИнвалид = 1) Тогда 
		флКоэф = 0;
	КонецЕсли;	
	Если ТипСотр = 1  Тогда //проверим полный месяц
		Если (Сотрудник.ДатаУвольнения >= НачМесяца(ДатаДок)) и (Сотрудник.ДатаУвольнения < КонМесяца(ДатаДок)) Тогда 
			//уволен в текущем месяце
			ТипСотр = 0;
		КонецЕсли;
		Если (Сотрудник.ДатаПриема <= КонМесяца(ДатаДок)) и (Сотрудник.ДатаПриема > НачМесяца(ДатаДок)) Тогда
			//принят в текущем месяце
			ТипСотр = 0;
		КонецЕсли;
	КонецЕсли;
	
	ТаблСотр.УдалитьСтроки();
	// суммы по не сдельным начислениям, т.е. суммы из документа
	ТаблСотр.НоваяСтрока();
	ТаблСотр.ВидДеятельности = ВиД;
	ТаблСотр.Подразделение = Под;
	
	Если ИспользоватьОбеспечениеОтпусков = Да Тогда
		ТаблСотр.НачисленоЗатр = Оклад + Тариф + Премия + Индексация + ФиксирИндексация + ДоплДоМнЗП;
		ТаблСотр.НачисленоОтп = Отпускные;
	Иначе
		ТаблСотр.НачисленоЗатр = Оклад + Тариф + Премия + Отпускные + Индексация + ФиксирИндексация + ДоплДоМнЗП;
		ТаблСотр.НачисленоОтп = 0;
	КонецЕсли;	                                                     
	ТаблСотр.НачисленоБол = Больничные + БольничныеЗаСчетПредприятия;
	
	Для НомНач = 1 по КвоНач Цикл
		ТаблСотр.НачисленоЗатр = ТаблСотр.НачисленоЗатр + Получитьатрибут("СуммаНачисл"+НомНач);
	КонецЦикла;
	ТаблСотр.НачисленоПриб = ОблагаемаяМатПомощь;
	ТаблСотр.НачВПрошл     = НачисленоВПрошломПериоде;
	ТаблСотр.флОсновн = ?(ЭтоИнвалид = 1, 0, ТипСотр);
	ТаблСотр.флКоэф = ?(ЭтоИнвалид = 1, 0, флКоэф);
	
	// суммы по сдельным начислениям
	СуммаСдельных = 0;
	Если Ит.ПолучитьСубконто(1,,Сотрудник) = 1 Тогда
		СуммаСдельных = Ит.КО();
		Ит.ВыбратьКорСубконто(1);
		Пока Ит.ПолучитьКорСубконто(1) = 1 Цикл
			Ит.ВыбратьКорСубконто(2);
			Пока Ит.ПолучитьКорСубконто(2) = 1 Цикл
				ТаблСотр.НоваяСтрока();
				ТаблСотр.ВидДеятельности = Ит.КорСубконто(1);
				ТаблСотр.Подразделение = Ит.КорСубконто(2);
				ТаблСотр.НачисленоЗатр = Ит.КорКО();
				ТаблСотр.флОсновн = ?(ЭтоИнвалид = 1, 0, ТипСотр);
				ТаблСотр.флКоэф = флКоэф;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Если Сдельно <> СуммаСдельных Тогда
		глКомментарий("Сумма сдельных начислений не совпадает с указанной в документе для сотрудника "+Сотрудник+", строка "+НомерСтроки,0);
		глНеПроводить(Контекст);
	    Возврат;
	КонецЕсли;
	       
	// Распределим пропорционально между затратами и прибылью

	// в фонд ЕСВ от фонда з/п
	Если ЭтоИнвалид=1 Тогда
		РаспределитьМеждуСтрокТаблицы("ОблагаемоеЕСВИнв",МаксБазаЕСВИнв);
	Иначе
		РаспределитьМеждуСтрокТаблицы("ОблагаемоеЕСВ",МаксБазаЕСВ);
	КонецЕсли;

КонецПроцедуры

// ===============================
Процедура ПроводкиСтрока()
	Если ВидНачисления = ОсновнаяЗП Тогда
		// Начисления:
		
		// оклад, тариф
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661",Оклад+Тариф,"Начисление: оклад, тариф",, ВиД,Под,ВидЗатратЗарплата,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		
		// Премия
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661",Премия,"Начисление: премия",, ВиД,Под,ВидЗатратПремии,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		
		// Отпускные
		Если ИспользоватьОбеспечениеОтпусков = Да Тогда
			глПроводка(Контекст,"47.1","661",Отпускные,"Начисление: отпускные",, ВиД,Под,ВидЗатратОтпускные,
			Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		Иначе
			глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661",Отпускные,"Начисление: отпускные",, ВиД,Под,ВидЗатратОтпускные,
			Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		КонецЕсли;
		
		// Больничные из фонда соц страхования
		СчетФСС = ?(КонецПериода >= Константа.ДатаПереходаНаСчет378ФСС, СчетПоКоду("37.8"), СчетПоКоду("65.2"));
		глПроводка(Контекст,СчетФСС,"663",Больничные,"Начисление: больничные из фонда соц. страхования",, ноСоцстрБольничн,,,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		
		// Больничные за счет предприятия  
		глПроводкаПоЗатратам(Контекст,СчетБольнП,"663",БольничныеЗаСчетПредприятия,"Начисление: больничные за счет предприятия",, ВиД,Под,ВидЗатратБольничные,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		
		// Мат. помощь
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661",ОблагаемаяМатПомощь,"Начисление: мат. помощь",, ВиД,Под,ВидЗатратПрочие,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"663",НеоблагаемаяМатПомощь,"Начисление: мат. помощь",, ВиД,Под,ВидЗатратПрочие,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");   
		//налоговый учет
		глПровНУ(Контекст,ТекСчетЗатрат,,0,"Разн;Начисление: мат. помощь",, ВиД,Под,ВидЗатратПрочие,
		,,,,,"ЗП",-НеоблагаемаяМатПомощь);
		
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661",Индексация+ФиксирИндексация,"Начисление: индексация",, ВиД,Под,ВидЗатратИндексация,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661", ДоплДоМнЗП,"Начисление: допл. до минЗП",, ВиД,Под,ВидЗатратИндексация,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		
		// произвольные начисления
		Для НомНач = 1 по КвоНач Цикл
			Начисл = ПолучитьАтрибут("Начисл"+НомНач);
			Если ПустоеЗначение(Начисл) = 1 Тогда
				// произвольные начисления могут быть не выбраны
				Продолжить;
			КонецЕсли;
			ВидЗатрат = ПолучитьАтрибут("ВидЗатратНачисл"+НомНач);
			СумНач = ПолучитьАтрибут("СуммаНачисл"+НомНач);
			
			глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"661",СумНач,"Начисление: "+Начисл,, ВиД,Под,ВидЗатрат,
			Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		КонецЦикла;
		
		Если Лев(ТекСчетЗатрат.Код, 2) = "23" Тогда
			// запомним суммы проводок по 23 счету для дальнейшего 
			// формирования движений по регистру ПроизводственныеЗатраты
			
			Если (Оклад + Тариф) <> 0 Тогда
				// по окладу и тарифу
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ВиД;
				ТаблЗатр23.Подразделение = Под;
				ТаблЗатр23.ВидЗатрат = ВидЗатратЗарплата;
				ТаблЗатр23.Сумма = Оклад + Тариф;
			КонецЕсли;
			Если Премия <> 0 Тогда
				// по премиям
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ВиД;
				ТаблЗатр23.Подразделение = Под;
				ТаблЗатр23.ВидЗатрат = ВидЗатратПремии;
				ТаблЗатр23.Сумма = Премия;
			КонецЕсли;
			Если (Отпускные <> 0)И(ИспользоватьОбеспечениеОтпусков <> Да) Тогда
				// по отпускным
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ВиД;
				ТаблЗатр23.Подразделение = Под;
				ТаблЗатр23.ВидЗатрат = ВидЗатратОтпускные;
				ТаблЗатр23.Сумма = Отпускные;
			КонецЕсли;
			Если (БольничныеЗаСчетПредприятия <> 0) и (Лев(СчетБольнП, 2) <> "94") Тогда
				// по больничным                                     
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ВиД;
				ТаблЗатр23.Подразделение = Под;
				ТаблЗатр23.ВидЗатрат = ВидЗатратБольничные;
				ТаблЗатр23.Сумма = БольничныеЗаСчетПредприятия;
			КонецЕсли;
			Если (НеоблагаемаяМатПомощь + ОблагаемаяМатПомощь) <> 0 Тогда
				// по мат. помощи
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ВиД;
				ТаблЗатр23.Подразделение = Под;
				ТаблЗатр23.ВидЗатрат = ВидЗатратПрочие;
				ТаблЗатр23.Сумма = НеоблагаемаяМатПомощь + ОблагаемаяМатПомощь;
			КонецЕсли;
			Если (Индексация) <> 0 Тогда
				// по индексации
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ВиД;
				ТаблЗатр23.Подразделение = Под;
				ТаблЗатр23.ВидЗатрат = ВидЗатратПрочие;
				ТаблЗатр23.Сумма = Индексация+ФиксирИндексация + ДоплДоМнЗП;
			КонецЕсли;
			// по произвольным начислениям
			Для НомНач = 1 по КвоНач Цикл
				Начисл = ПолучитьАтрибут("Начисл"+НомНач);
				Если ПустоеЗначение(Начисл) = 1 Тогда
					// произвольные начисления могут быть не выбраны
					Продолжить;
				КонецЕсли;
				Если ПолучитьАтрибут("СуммаНачисл"+НомНач) <> 0 Тогда
					ТаблЗатр23.НоваяСтрока();
					ТаблЗатр23.ВидДеятельности = ВиД;
					ТаблЗатр23.Подразделение = Под;
					ТаблЗатр23.ВидЗатрат = ПолучитьАтрибут("ВидЗатратНачисл"+НомНач);
					ТаблЗатр23.Сумма = ПолучитьАтрибут("СуммаНачисл"+НомНач);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Удержания
		УжеУдержано = 0;
		// Эти удержания идут только с основных выплат
		глПроводка(Контекст,"661","65.1",ЕдиныйВзнос-ЕСВПоДругимВыплатам,"Удержание: ед.соц.взнос",, Сотрудник,МесяцНачисленияЗП,,
		ноЕСВСот,,, ,,"ЗП");
		глПроводка(Контекст,"663","65.1",ЕСВПоДругимВыплатам,"Удержание: ед.соц.взнос (болничные)",, Сотрудник,МесяцНачисленияЗП,,
		ноЕСВБолСот,,, ,,"ЗП");
		УжеУдержано = УжеУдержано + ЕдиныйВзнос;
		глПроводка(Контекст,"661","64.2.6",Профсоюзный,"Удержание: профсоюзный",, Сотрудник,МесяцНачисленияЗП,,
		ноПрофсоюзныйСотр,,, ,,"ЗП");
		УжеУдержано = УжеУдержано + Профсоюзный;
		глПроводка(Контекст,"661",ноВоенСбор.Счет,ВоенныйСбор-ВоенныйСборПоДругимВыплатам,"Удержание: военный сбор",, Сотрудник,МесяцНачисленияЗП,,
		ноВоенСбор,,, ,,"ЗП");
		глПроводка(Контекст,"663",ноВоенСбор.Счет,ВоенныйСборПоДругимВыплатам,"Удержание: военный сбор",, Сотрудник,МесяцНачисленияЗП,,
		ноВоенСбор,,, ,,"ЗП");
		УжеУдержано = УжеУдержано + ВоенныйСбор;
		
		Осталось = Макс(Начислено - НачисленоПоДругимВыплатам - УжеУдержано,0);
        
		глПроводка(Контекст,"661","64.1.1",Подоходный - НДФЛПоДругимВыплатам,"Удержание: НДФЛ",, Сотрудник,МесяцНачисленияЗП,,
		,,, ,,"ЗП");
		глПроводка(Контекст,"663","64.1.1",НДФЛПоДругимВыплатам,"Удержание: НДФЛ",, Сотрудник,МесяцНачисленияЗП,,
		,,, ,,"ЗП");
		
		//количество сотрудников для расчета коэфф.
		Если (Начислено+Индексация+ФиксирИндексация <> 0) и (Сотрудник.Инвалид.Получить(КонМесяца(ДатаДок)) = 0) Тогда 
			ИтКолСотр = ИтКолСотр + 1;
		КонецЕсли; 
	Иначе
		// внесение остатков
		глПроводка(Контекст,"00","661",ОсталосьВыплатить-ОсталосьВыплатитьПоДругимВыплатам,"Внесение остатков по зарплате",, ,,,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
		глПроводка(Контекст,"00","663",ОсталосьВыплатитьПоДругимВыплатам,"Внесение остатков по зарплате",, ,,,
		Сотрудник,МесяцНачисленияЗП,, ,,"ЗП");
	КонецЕсли;	
КонецПроцедуры

// ===============================
Процедура ПроводкиДно()

	ТаблЗатр.НоваяКолонка("ЕСВФОТ","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ЕСВФОТИнв","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ЕСВФОТОтп","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ЕСВФОТОтпИнв","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ЕСВФОТБол","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ЕСВФОТНал","Число", 10, 2);
	ТаблЗатр.НоваяКолонка("ЕСВФОТРаз","Число", 10, 2);

	//коэффициент уменьшения базы ЕСВ ФОТ для фирмы
	КоэфУменЕСВФОТ = 1;
	Если ДатаГод(НачалоПериода)=2015 Тогда  
		КоэфУменЕСВФОТ = Фирма.КоэфУменьшенияСтавкиЕСВФОТ.Получить(КонецПериода);
		КоэфУменЕСВФОТ = ?(КоэфУменЕСВФОТ = 0, 1, КоэфУменЕСВФОТ);
	КонецЕсли;
	ИтБазаЕСВФОТМесяц = 0;
	глСписокОшибокОкругления.УдалитьВсе();
	
	ТаблЗатр.ВыбратьСтроки();
	Пока ТаблЗатр.ПолучитьСтроку() = 1 Цикл
		КоэфСотр = 1;
		Если ТаблЗатр.флКоэф = 1 Тогда
			КоэфСотр = КоэфУменЕСВФОТ;
			//база ЕСВ ФОТ для рассчета коэфф
			ИтБазаЕСВФОТМесяц = ИтБазаЕСВФОТМесяц + ТаблЗатр.ОблагаемоеЕСВЗатр + ТаблЗатр.ОблагаемоеЕСВПриб + ТаблЗатр.ОблагаемоеЕСВОтп+
							ТаблЗатр.ОблагаемоеЕСВИнвЗатр+ТаблЗатр.ОблагаемоеЕСВИнвПриб+ТаблЗатр.ОблагаемоеЕСВИнвОтп+ТаблЗатр.ОблагаемоеЕСВРазн;
			Если (НачалоПериода>='01.03.2015') Тогда
				ИтБазаЕСВФОТМесяц = ИтБазаЕСВФОТМесяц + ТаблЗатр.ОблагаемоеЕСВБолн+ТаблЗатр.ОблагаемоеЕСВИнвБолн+ТаблЗатр.ОблагаемоеЕСВРазнБол;
			КонецЕсли; 
		КонецЕсли; 
		
		
		Если ПустоеЗначение(СчетДопБазаФОТ)=1 Тогда //счет не заполнен
			ЕСВОрг = Окр((ТаблЗатр.ОблагаемоеЕСВЗатр + ТаблЗатр.ОблагаемоеЕСВПриб) * Окр(СтЕСВОрг * КоэфСотр,5), 2,1) 
				+ Окр(ТаблЗатр.ОблагаемоеЕСВРазн * СтЕСВОрг, 2,1);  
			ЕСВОргРазн = 0;
		Иначе	
			ЕСВОрг = Окр((ТаблЗатр.ОблагаемоеЕСВЗатр + ТаблЗатр.ОблагаемоеЕСВПриб) * Окр(СтЕСВОрг * КоэфСотр,5), 2,1); 
			ЕСВОргРазн =  Окр(ТаблЗатр.ОблагаемоеЕСВРазн * СтЕСВОрг, 2,1);
		КонецЕсли; 
		ЕСВОргОтп = Окр(ТаблЗатр.ОблагаемоеЕСВОтп * Окр(СтЕСВОрг * КоэфСотр,5), 2,1);
		Если (НачалоПериода>='01.03.2015') и (КоэфСотр<>1) Тогда
			ЕСВБолОрг = Окр(ТаблЗатр.ОблагаемоеЕСВБолн * Окр(СтЕСВБолОрг * КоэфСотр,5), 2,1)+ Окр(ТаблЗатр.ОблагаемоеЕСВРазнБол * СтЕСВБолОрг, 2,1);
		Иначе	
			ЕСВБолОрг = Окр(ТаблЗатр.ОблагаемоеЕСВБолн * СтЕСВБолОрг, 2,1)+ Окр(ТаблЗатр.ОблагаемоеЕСВРазнБол * СтЕСВБолОрг, 2,1);
		КонецЕсли;
		
		ЕСВИнвОрг = Окр((ТаблЗатр.ОблагаемоеЕСВИнвЗатр + ТаблЗатр.ОблагаемоеЕСВИнвПриб) * СтЕСВИнвОрг, 2,1);
		ЕСВИнвОргОтп = Окр(ТаблЗатр.ОблагаемоеЕСВИнвОтп * СтЕСВИнвОрг, 2,1);
		Если НачалоПериода>='01.12.2011' Тогда 
			ЕСВБолИнвОрг = Окр(ТаблЗатр.ОблагаемоеЕСВИнвБолн * СтЕСВИнвОрг, 2,1); 
		Иначе
			ЕСВБолИнвОрг = Окр(ТаблЗатр.ОблагаемоеЕСВИнвБолн * СтЕСВБолОрг, 2,1); 
		КонецЕсли;
		
		//для налогового учета
		ЕСВОргНУ = Окр(ТаблЗатр.ОблагаемоеЕСВЗатр * Окр(СтЕСВОрг * КоэфСотр,5),    2,1)+ 
				   Окр(ТаблЗатр.ОблагаемоеЕСВИнвЗатр  * СтЕСВИнвОрг, 2,1)+
				   Окр(ТаблЗатр.ОблагаемоеЕСВРазн     * СтЕСВОрг, 2,1)+
				   Окр(ТаблЗатр.ОблагаемоеЕСВБолн     * СтЕСВБолОрг, 2,1)+
				   Окр(ТаблЗатр.ОблагаемоеЕСВРазнБол  * СтЕСВБолОрг, 2,1)+
				   Окр(ТаблЗатр.ОблагаемоеЕСВИнвБолн  * СтЕСВИнвОрг, 2,1)+
				   Окр(ТаблЗатр.ОблагаемоеЕСВОтп    * Окр(СтЕСВОрг * КоэфСотр,5),    2,1)+
		      	   Окр(ТаблЗатр.ОблагаемоеЕСВИнвОтп * СтЕСВИнвОрг, 2,1);
		
		ТаблЗатр.ЕСВФОТ   =ЕСВОрг;             
		ТаблЗатр.ЕСВФОТИнв=ЕСВИнвОрг;             
		ТаблЗатр.ЕСВФОТОтп=ЕСВОргОтп;             
		ТаблЗатр.ЕСВФОТОтпИнв=ЕСВИнвОргОтп;             
		ТаблЗатр.ЕСВФОТБол=ЕСВБолОрг + ЕСВБолИнвОрг;             
		ТаблЗатр.ЕСВФОТНал=ЕСВОргНУ;             
		ТаблЗатр.ЕСВФОТРаз=ЕСВОргРазн;             

		ТекСчетЗатрат = ТаблЗатр.СчетЗатрат;
		
		Если Лев(ТекСчетЗатрат.Код, 2) = "23" Тогда
			// запомним суммы проводок по 23 счету для дальнейшего 
			// формирования движений по регистру ПроизводственныеЗатраты
			
			Если (ЕСВОрг + ЕСВИнвОрг + ЕСВБолОрг) <> 0 Тогда
				// Единый соц. взнос (от фонда з/п) + Единый соц. взнос (инвалиды) + Единый соц. взнос (больничный)
				ТаблЗатр23.НоваяСтрока();
				ТаблЗатр23.ВидДеятельности = ТаблЗатр.ВидДеятельности;
				ТаблЗатр23.Подразделение = ТаблЗатр.Подразделение;
				ТаблЗатр23.ВидЗатрат = ВидЗатратСоцОтчисления; 
				Если (Лев(СчетБольнФОТ, 2) <> "94") Тогда
					ТаблЗатр23.Сумма = ЕСВОрг + ЕСВИнвОрг + ЕСВБолОрг+ЕСВБолИнвОрг;
				Иначе    
					ТаблЗатр23.Сумма = ЕСВОрг + ЕСВИнвОрг;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	БазаЕСВФОТМесяц = ИтБазаЕСВФОТМесяц;
	КоличествоСотр = ИтКолСотр;

	// свернем по счету, виду деятельности и подразделению
	ТаблЗатр.Свернуть("СчетЗатрат,ВидДеятельности,Подразделение,флКоэф","ЕСВФОТ,ЕСВФОТИнв,ЕСВФОТОтп,ЕСВФОТОтпИнв,ЕСВФОТБол,ЕСВФОТНал,ЕСВФОТРаз");
	ТаблЗатр.Сортировать("СчетЗатрат+");

	ТаблЗатр.ВыбратьСтроки();
	Пока ТаблЗатр.ПолучитьСтроку() = 1 Цикл
		
		ЕСВОбщБУ = ТаблЗатр.ЕСВФОТ + ТаблЗатр.ЕСВФОТОтп + ТаблЗатр.ЕСВФОТБол + ТаблЗатр.ЕСВФОТИнв + ТаблЗатр.ЕСВФОТОтпИнв+ТаблЗатр.ЕСВФОТРаз;
		
		ТекСчетЗатрат = ТаблЗатр.СчетЗатрат;
		
		// Единый соц. взнос (от фонда з/п)  
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"65.1",ТаблЗатр.ЕСВФОТ,"Единый соц. взнос (от фонда з/п)",, ТаблЗатр.ВидДеятельности,ТаблЗатр.Подразделение,ВидЗатратСоцОтчисления,
		ноЕСВ,,, ,,"ЗП");
		глПроводка(Контекст,"47.1","65.1",ТаблЗатр.ЕСВФОТОтп,"Единый соц. взнос (от фонда з/п)",, ТаблЗатр.ВидДеятельности,Подразделение,ВидЗатратСоцОтчисления,
		ноЕСВ,,, ,,"ЗП");
		СчетЗатРазн = ?(Константа.ИспользоватьСчетаРасходов=Класс9,ТекСчетЗатрат,СчетДопБазаФОТ);
		глПроводкаПоЗатратам(Контекст,СчетЗатРазн,"65.1",ТаблЗатр.ЕСВФОТРаз,"Единый соц. взнос (от фонда з/п)",, ТаблЗатр.ВидДеятельности,ТаблЗатр.Подразделение,ВидЗатратСоцОтчисления,
		ноЕСВ,,, ,,"ЗП");
		
		// Единый соц. взнос (инвалиды) (от фонда з/п)
		глПроводкаПоЗатратам(Контекст,ТекСчетЗатрат,"65.1",ТаблЗатр.ЕСВФОТИнв,"Единый соц. взнос (инвалиды) (от фонда з/п)",, ТаблЗатр.ВидДеятельности,ТаблЗатр.Подразделение,ВидЗатратСоцОтчисления,
		ноЕСВИнв,,, ,,"ЗП");
		глПроводка(Контекст,"47.1","65.1",ТаблЗатр.ЕСВФОТОтпИнв,"Единый соц. взнос (инвалиды) (от фонда з/п)",, ТаблЗатр.ВидДеятельности,Подразделение,ВидЗатратСоцОтчисления,
		ноЕСВИнв,,, ,,"ЗП");
		
		// Единый соц. взнос (больничный) (от фонда з/п) 
		СчетЗатБл = ?(Константа.ИспользоватьСчетаРасходов=Класс9,ТекСчетЗатрат,СчетБольнФОТ);
		глПроводкаПоЗатратам(Контекст,СчетЗатБл,"65.1",ТаблЗатр.ЕСВФОТБол,"Единый соц. взнос (больничный) (от фонда з/п)",, ТаблЗатр.ВидДеятельности,ТаблЗатр.Подразделение,ВидЗатратБольнФОТ,
		ноЕСВБол,,, ,,"ЗП");
		//налоговый учет
		глПровНУ(Контекст,ТекСчетЗатрат,,0,"Разн;Единый соц. взнос (от фонда з/п)",, ТаблЗатр.ВидДеятельности,ТаблЗатр.Подразделение,ВидЗатратСоцОтчисления,
		,,,,,"ЗП", ТаблЗатр.ЕСВФОТНал-ЕСВОбщБУ);
		
	КонецЦикла;
	
	// В регистре ПроизводственныеЗатраты отражаем суммы начислений и отчислений в фонды,
	// которые пошли на 23 счет с той же аналитикой
	ТаблЗатр23.Свернуть("ВидДеятельности,Подразделение,ВидЗатрат","Сумма");
	ТаблЗатр23.ВыбратьСтроки();
	Пока ТаблЗатр23.ПолучитьСтроку() = 1 Цикл
		Регистр.ПроизводственныеЗатраты.Фирма			= Фирма;
		Регистр.ПроизводственныеЗатраты.ВидДеятельности	= ТаблЗатр23.ВидДеятельности;
		Регистр.ПроизводственныеЗатраты.Подразделение	= ТаблЗатр23.Подразделение;
		Регистр.ПроизводственныеЗатраты.Продукция		= 0;
		Регистр.ПроизводственныеЗатраты.ВидЗатрат		= ТаблЗатр23.ВидЗатрат;
		Регистр.ПроизводственныеЗатраты.Заказ			= 0;
		Регистр.ПроизводственныеЗатраты.Материал		= 0;
		Регистр.ПроизводственныеЗатраты.Количество		= 0; // материалов нет
		Регистр.ПроизводственныеЗатраты.Сумма			= ТаблЗатр23.Сумма;
		Регистр.ПроизводственныеЗатраты.СуммаДав		= 0;
		Регистр.ПроизводственныеЗатраты.КодОперации		= ОтражениеЗатрат;
		Регистр.ПроизводственныеЗатраты.ДвижениеПриходВыполнить();
	КонецЦикла;
КонецПроцедуры

// ===============================
Функция ПолучитьКвоПроизвольныхНачислений()
Перем КвоНач;
	КвоНач = 0; 
	Пока глЕстьРеквизитШапки("Начисл"+(КвоНач+1), "НачислениеЗП") = Да Цикл
		КвоНач = КвоНач + 1;
	КонецЦикла;
	Возврат КвоНач;
КонецФункции //ПолучитьКвоПроизвольныхНачислений()

// ===============================
Процедура ОбработкаПроведения()
	глКомментарий("Начало",2,Контекст);

	МесяцНачисленияЗП = НачМесяца(ДатаДок);
	КвоНач = ПолучитьКвоПроизвольныхНачислений();
	
	Если ПроверкаШапки() = 0 Тогда
		глНеПроводить(Контекст);
		Возврат;
	КонецЕсли;
	
	Если ВидНачисления = Перечисление.ВидыНачисленияЗП.Аванс Тогда
		Операция.Содержание = "Начисление аванса за "+Формат(ДатаДок,"Д ММММГГГГ")+" "+Примечание;
		Операция.Записать();
		глКомментарий("Окончание",2,Контекст);
	    Возврат;
	КонецЕсли;
	
	Если ВидНачисления = ОсновнаяЗП Тогда
	    РассчитатьШапку();
	КонецЕсли;
	ИтКолСотр = 0;
	
	ВыбратьСтроки();
	Пока ПолучитьСтроку() = 1 Цикл
		Если ПроверкаСтроки() = 0 Тогда
			глНеПроводить(Контекст);
			Возврат;
		КонецЕсли;
		Если ВидНачисления = ОсновнаяЗП Тогда
			РассчитатьСтроку();
		КонецЕсли;
		ПроводкиСтрока();
	КонецЦикла;
	
	Если ВидНачисления = ОсновнаяЗП Тогда
		ПроводкиДно();
	КонецЕсли;
	
	Операция.СуммаОперации = Итог("КВыплате");
	Сод = ?(ВидНачисления = ОсновнаяЗП, "Расчет з/п за ", "Внесение остатков по з/п за ");
	Операция.Содержание = Сод+Формат(ДатаДок,"Д ММММГГГГ")+" "+Примечание;
	Операция.Записать();
	глКомментарий("Окончание",2,Контекст);
	Ит = 0;
КонецПроцедуры
