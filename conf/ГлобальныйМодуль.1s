			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),,,);
		КонецЕсли;
	ИначеЕсли ТекущаяГруппировка = 8 Тогда
		Если КоличествоГруппировок = 8 Тогда
			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(8)));
		ИначеЕсли КоличествоГруппировок = 9 Тогда
			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(8)),);
		ИначеЕсли КоличествоГруппировок = 10 Тогда
			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(8)),,);
		КонецЕсли;
	ИначеЕсли ТекущаяГруппировка = 9 Тогда
		Если КоличествоГруппировок = 9 Тогда
			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(8)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(9)));
		ИначеЕсли КоличествоГруппировок = 10 Тогда
			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(8)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(9)),);
		КонецЕсли;
	ИначеЕсли ТекущаяГруппировка = 10 Тогда
		Если КоличествоГруппировок = 10 Тогда
			ЗапросСПериодами.Получить(НачалоПериода,Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(1)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(2)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(3)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(4)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(5)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(6)),
			Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(7)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(8)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(9)),Запрос.ПолучитьАтрибут(СписокГруппировок.ПолучитьЗначение(10)));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры //

// ===============================
// глИзменениеПорядкаГрупп(Группировки,НаправлениеСдвига,НеподвижныхВКонце=0)
//
// Параметры:
//	Группировки		  = список группировок
//  НаправлениеСдвига = 	-1 - вниз
//							 1 - вверх
//  НеподвижныхВКонце = количество группировок в конце списка, которые не перемещаются
//
// Возвращаемое значение: 
//	Нет
//
// Вызывается из формул элементов диалога:
//  кнопки "вверх" и "вниз" рядом со списком группировок
//
// Описание:  
//	Процедура производит сдвиг текущей группировки в общем
// 	списке группировок на "НаправлениеСдвига" позиций
//
Процедура глИзменениеПорядкаГрупп(Группировки,НаправлениеСдвига,НеподвижныхВКонце=0) Экспорт
	Если Группировки.РазмерСписка()=0 Тогда
		Возврат;
	КонецЕсли;

	КвоСтр = Группировки.РазмерСписка();
	ТекСтр = Группировки.ТекущаяСтрока();



	Если ТекСтр > КвоСтр - НеподвижныхВКонце Тогда // последние не перемещаем
		Возврат;
	КонецЕсли;

	Если (ТекСтр = КвоСтр - НеподвижныхВКонце) И (НаправлениеСдвига = 1) Тогда // последние не перемещаем
		Возврат;
	КонецЕсли;
	Группировки.СдвинутьЗначение(НаправлениеСдвига, ТекСтр);
КонецПроцедуры // глИзменениеПорядкаГрупп()

// ===============================
// Процедура изменяет состояние отметок вывода таблицы группировок отчета
Процедура глПометкаТаблицыГруппировок(Группировки,Флаг) Экспорт
	
	Для индГруп = 1 По Группировки.РазмерСписка() Цикл
		Если Флаг = -1 Тогда
			Группировки.Пометка(индГруп, 1 - Группировки.Пометка(индГруп));
		Иначе
			Группировки.Пометка(индГруп, Флаг);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // глПометкаТаблицыГруппировок()

// ===============================
Процедура глПолучитьТаблицуПериодов(ТаблицаПериодов,ЗапросСПериодами,Периодичность) Экспорт
	// Таблица с периодами
	ТаблицаПериодов.НоваяКолонка("НачалоПериода");
	ТаблицаПериодов.НоваяКолонка("КонецПериода");
	ТаблицаПериодов.НоваяКолонка("РеалНачалоПериода");
	Пока ЗапросСПериодами.Группировка(1) = 1 Цикл
	    ТаблицаПериодов.НоваяСтрока();
		ТаблицаПериодов.НачалоПериода = ЗапросСПериодами.НачалоПериода();
		ТаблицаПериодов.КонецПериода = ЗапросСПериодами.КонецПериода();
		Если Периодичность="День" Тогда
			ТаблицаПериодов.РеалНачалоПериода = ТаблицаПериодов.НачалоПериода;
		ИначеЕсли Периодичность="Неделя" Тогда
			ТаблицаПериодов.РеалНачалоПериода = НачНедели(ТаблицаПериодов.НачалоПериода);
		ИначеЕсли Периодичность="Месяц" Тогда
			ТаблицаПериодов.РеалНачалоПериода = НачМесяца(ТаблицаПериодов.НачалоПериода);
		ИначеЕсли Периодичность="Квартал" Тогда
			ТаблицаПериодов.РеалНачалоПериода = НачКвартала(ТаблицаПериодов.НачалоПериода);
		ИначеЕсли Периодичность="Год" Тогда
			ТаблицаПериодов.РеалНачалоПериода = НачГода(ТаблицаПериодов.НачалоПериода);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры //глПолучитьТаблицуПериодов

// ===============================
// Выделяет уровни элементов справочника пробелами
Функция глСмещениеГруппы(Значение,фБезГрупп) Экспорт
	// При включенной оптимизации по скорости, печатаем названия групп справочников без смещения 
	Если глОптимизацияОтчетов = 1 Тогда
		Возврат "";
	КонецЕсли;

	Если фБезГрупп = 1 Тогда
		Возврат "";
	КонецЕсли;
	
	Если ПустоеЗначение(Значение) = 1 Тогда
		Возврат "";
	КонецЕсли;
               
	ТипЗначение = ТипЗначенияСтр(Значение);
	Если (ТипЗначение <> "Справочник") и (ТипЗначение <> "Счет") Тогда
		Возврат "";
	КонецЕсли;	
	
	Возврат Формат("","С"+(Значение.Уровень()-1)*2);
КонецФункции

// ===============================
// Выполняет округление до заданной точности, корректируя результат
// с учетом ошибок предыдущих округлений.
Функция глОкрКорр(Ключ, Значение, Точность) Экспорт
Перем Ошибка, Округл;
	
	Если Значение = 0 Тогда // алгоритм некорректен, если Значение = 0, Ошибка = -0.5
	    Возврат 0;
	КонецЕсли;
	Ошибка = Число(глСписокОшибокОкругления.Получить(Ключ));
	Округл = Окр(Значение + Ошибка, Точность);
	глСписокОшибокОкругления.Установить(Ключ, Ошибка + Значение - Округл);
	
	Возврат Округл;
КонецФункции

// ===============================
Процедура глОчиститьКлючОкр(Ключ) Экспорт
	глСписокОшибокОкругления.Установить(Ключ, 0);
КонецПроцедуры

// ===============================
Процедура глПодогнатьЦенаКоличество(Сумма, Цена, Кво, СпособПодгонки, ТчнСумма = 3, ТчнЦена = 5, ТчнКво = 5) Экспорт
	Если      СпособПодгонки = Перечисление.СпособыПодгонкиСумм.Цена           Тогда
    	// подберем с заданной точностью наиболее близкую цену
		Цена       = Окр(Сумма/?(ПустоеЗначение(Кво)=1, 1, Кво), ТчнЦена);

	ИначеЕсли СпособПодгонки = Перечисление.СпособыПодгонкиСумм.ЦенаКоличество Тогда
    	// подберем с заданной точностью наиболее близкую цену
    	Цена       = Окр(Сумма/?(ПустоеЗначение(Кво)=1, 1, Кво), ТчнЦена);

		// рассчитаем и сравним суммы
		СтараяСумма = Окр(Сумма,      ТчнСумма);
		НоваяСумма  = Окр(Цена * Кво, ТчнСумма);
		Если НоваяСумма = СтараяСумма Тогда
			// суммы совпали, подгонка окончена
			Возврат;
		КонецЕсли;
		
		// рассчитаем множитель количества
		МнКво = 1;
		Для Инд = 1 По ТчнКво Цикл
			МнКво = МнКво * 10;
		КонецЦикла;
		// рассчитаем множитель суммы
		МнСумма = 1;
		Для Инд = 0 По ТчнСумма Цикл
			МнСумма = МнСумма * 10;
		КонецЦикла;
		// подберем с заданной точностью наиболее близкое количество
		Если      НоваяСумма > Сумма Тогда
			// количество нужно уменьшить
			Кво = Цел(МнКво * (Сумма + 49/МнСумма) / Цена) / МнКво;
		ИначеЕсли НоваяСумма < Сумма Тогда
			// количество нужно увеличить
			Кво = Цел(МнКво * (Сумма - 50/МнСумма) / Цена) / МнКво;
		КонецЕсли;

	ИначеЕсли СпособПодгонки = Перечисление.СпособыПодгонкиСумм.Количество     Тогда
    	// подберем с заданной точностью наиболее близкое количество
    	Кво        = Окр(Сумма/?(ПустоеЗначение(Цена)=1, 1, Цена),ТчнКво);

	ИначеЕсли СпособПодгонки = Перечисление.СпособыПодгонкиСумм.КоличествоЦена Тогда
    	// подберем с заданной точностью наиболее близкое количество
    	Кво        = Окр(Сумма/?(ПустоеЗначение(Цена)=1, 1, Цена),ТчнКво);

		// рассчитаем и сравним суммы
		СтараяСумма = Окр(Сумма,      ТчнСумма);
		НоваяСумма  = Окр(Цена * Кво, ТчнСумма);
		Если НоваяСумма = СтараяСумма Тогда
			// суммы совпали, подгонка окончена
			Возврат;
		КонецЕсли;
		
		// рассчитаем множитель цены
		МнЦена = 1;
		Для Инд = 1 По ТчнЦена Цикл
			МнЦена = МнЦена * 10;
		КонецЦикла;
		// рассчитаем множитель суммы
		МнСумма = 1;
		Для Инд = 0 По ТчнСумма Цикл
			МнСумма = МнСумма * 10;
		КонецЦикла;
		// подберем с заданной точностью наиболее близкую цену
		Если      НоваяСумма > Сумма Тогда
			// количество нужно уменьшить
			Цена = Цел(МнЦена * (Сумма + 49/МнСумма) / Кво) / МнЦена;
		ИначеЕсли НоваяСумма < Сумма Тогда
			// количество нужно увеличить
			Цена = Цел(МнЦена * (Сумма - 50/МнСумма) / Кво) / МнЦена;
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

// ===============================
Функция глСчетВСчетЗА(Знач Счет) Экспорт
	Если ТипЗначенияСтр(Счет)="Счет" Тогда
		Счет = Счет.Код;
	КонецЕсли;
	Если Лев(Счет,2)="ЗА" Тогда
		Возврат Счет;
	КонецЕсли;
	Если Лев(Счет,2)="20" Тогда
		Счет = "20";
	КонецЕсли;
	
	Возврат глСчетаЗабалансовогоУчетаЗапасов.Получить(Счет);
КонецФункции

// ===============================
// Формирование проводки по забалансовому учету бухг. стоимости или
// по отклонению бухгалтерской стоимости от налоговой
// Конт			-	контекст документа
// Счет			- 	(Строка или Счет) счет учета ТМЦ (2хх или ЗАх)
// Субсчет		-	(Строка) последняя цифра в коде забалансового счета, "Б" или "О"
// ТМЦ			-	элемент спр. ТМЦ
// Сумма		-	сумма проводки; если отрицательная - проводка по Кт
// СубконтоВР   -	субконто вал. расходов из документа для автомат. определения необходимости проводок;
//				    если не указано - проводка формируется
Процедура глПровестиПоЗабалансовомуУчетуЗапасов(Конт, Знач Счет, Субсчет, Сумма, Знач ТМЦ=0, СубконтоВР=0, ЗаписыватьВТаблицу=0) Экспорт
	Перем	Позиция;
	
	Если	(Конт.Фирма.ПлательщикНалогаНаПрибыль.Получить(Конт.ДатаДок) = 0)
	Или		((СубконтоВР <> Константа.НиДоходНиРасход) И (СубконтоВР <> 0))
	Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗначенияСтр(Счет)="Счет" Тогда
		Счет = Счет.Код;
	КонецЕсли;
	
	Если      Счет = "2092" Тогда
	    ТМЦ = Константа.НалоговыйТЗРМатериалы;
	ИначеЕсли Счет = "289"  Тогда
	    ТМЦ = Константа.НалоговыйТЗРТовары;
	КонецЕсли;
	
	// определим счет
	Счет = глСчетВСчетЗА(Счет) + Субсчет;
	Счет = СчетПоКоду(Счет);
	Если ПустоеЗначение(Счет)=1 Тогда
		// не нужно учитывать на забалансе
		Возврат;
	КонецЕсли;
	
	
	// формируем проводку
	Если Сумма > 0 Тогда
		глПроводка(Конт,Счет,,Сумма,"",, ТМЦ,,,,,, ,,"ЗА",ЗаписыватьВТаблицу);
	ИначеЕсли Сумма < 0 Тогда
		глПроводка(Конт,,Счет,-Сумма,"",, ,,,ТМЦ,,, ,,"ЗА",ЗаписыватьВТаблицу);
	КонецЕсли;
КонецПроцедуры

// ===============================
// возвращает список доступных норм амортизации
Функция глСписокНормАмортизации(Конт) Экспорт
Перем Выб;
    Спр = СоздатьОбъект("Справочник.ШкалаСтавок");
	Спис = СоздатьОбъект("СписокЗначений");
    
	
	Попытка
		ГруппаОС = Конт.Группа;
	Исключение
		Попытка
			ГруппаОС = Конт.НеоборотныйАктив.Группа;
		Исключение
			ГруппаОС = 0;
		КонецПопытки;	
	КонецПопытки;	
	
	Если ГруппаОС > 0 Тогда
		Код = "АмортГр"+Строка(ГруппаОС);
	КонецЕсли;	
	
	Спр.НайтиПоКоду("ОС_НМА_МБП"); 
	Спр.ИспользоватьРодителя(Спр.ТекущийЭлемент());
	Спис.ДобавитьЗначение(Спр.ТекущийЭлемент());
	Спр.ВыбратьЭлементы(); 
	Пока Спр.ПолучитьЭлемент() = 1 Цикл 
		//Найдем и добавим в список все элементы с кодом АмортГрN*
	    Если Найти(Спр.ТекущийЭлемент().Код,Код) = 1 Тогда
			Спис.ДобавитьЗначение(Спр.ТекущийЭлемент());
		КонецЕсли;	
	КонецЦикла;
    
	Возврат Спис;
	
КонецФункции

// ===============================
// возвращает норму амортизации по умолчанию в зависимости от даты ввода
Функция глНормаАмортизацииПоДате(НА = 0, ДатаВвода = '01.01.80', Группа = 0) Экспорт
Перем Выб;
    Спр = СоздатьОбъект("Справочник.ШкалаСтавок");
    
	Если НА<>0 Тогда
		
		Если (НА.Производственное = 0) 
		     или ((НА.ВидНеоборотногоАктива = НМА) и (НА.УчитываетсяКакОСВНалогУчете = 0)) Тогда
			Возврат 0;
		КонецЕсли;
		
		ГруппаОС = Строка(НА.Группа);
		Если ПустоеЗначение(НА.ДатаВвода) = 0 Тогда
			ДатаВводаВЭкспл = НА.ДатаВвода;
		Иначе
			ДатаВводаВЭкспл = ДатаВвода;
		КонецЕсли;	
	Иначе
		ГруппаОС = Строка(Группа);
		ДатаВводаВЭкспл = ДатаВвода;
	КонецЕсли;	
	
	Код = "АмортГр"+ГруппаОС;
	Если ДатаВводаВЭкспл >='01.01.04' Тогда
		Код = Код+"-04";
	КонецЕсли;	

	Если Спр.НайтиПоКоду(Код)=1 Тогда
		Возврат Спр.ТекущийЭлемент();
	ИначеЕсли Спр.НайтиПоКоду("АмортГр"+ГруппаОС)=1 Тогда
		Возврат Спр.ТекущийЭлемент();
	Иначе	
		Возврат 0;
	КонецЕсли;	
	
КонецФункции

// ===============================
// возвращает 1 - использовать счет НДС, 0 - не использовать
Функция глИспользоватьСчетНДС(Конт) Экспорт
	Если Константа.ИспользоватьСпецСчетаПоНДС.Получить(Конт.ДатаДок) = Да Тогда   
		Возврат 1;
	КонецЕсли;

	Возврат 0;	
КонецФункции


// ===============================
// Используется в механизме расчета индексации
Функция глПрочитатьДатуИзмененияДоходаДляИндексации(НП, ИмяРеквизита, Объект = "") Экспорт

    РезДата = ДобавитьМесяц(глДатаНачалаРасчетаИндексации, -1);

	Если ПустоеЗначение(Объект) = 0 Тогда
		Пр = СоздатьОбъект("Периодический"); 
		Если ПустоеЗначение(Объект) = 1 Тогда
			Пр.ИспользоватьОбъект(ИмяРеквизита);  
		Иначе   
			Пр.ИспользоватьОбъект(ИмяРеквизита,Объект);  
		КонецЕсли;
		Пр.ОбратныйПорядок();
		Пр.ВыбратьЗначения();
		Пока Пр.ПолучитьЗначение() = 1 Цикл
			Если (Пр.ДатаЗнач <= НП) и (Пр.Значение <> 0) Тогда
				РезДата = НачМесяца(Пр.ДатаЗнач); 
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РезДата = Макс(ДобавитьМесяц(РезДата, 1), глДатаНачалаРасчетаИндексации); 
	
	Возврат РезДата;
КонецФункции

// ===============================        
Функция глПроверитьЛегальностьПолученияОбновления() Экспорт
	
	Если СокрЛП(Константа.НомерРелиза) <> Лев(Метаданные.Комментарий, 8) Тогда
		
		ПодтверждениеЛегитимности = ВосстановитьЗначение("ЛегальностьПолученияОбновления");
		Если ПодтверждениеЛегитимности = 1 Тогда
			СохранитьЗначение("ЛегальностьПолученияОбновления",0);			
			Возврат 1;
		КонецЕсли;
		
		ПодтверждениеЛегитимности = 0;
		ОткрытьФормуМодально("Обработка.ЛегальностьПолученияОбновлений",ПодтверждениеЛегитимности);
		Если ПодтверждениеЛегитимности = 2 Тогда
			СохранитьЗначение("НеЗапрашиватьПодтверждениеПриВыходе",1);
			ЗавершитьРаботуСистемы();
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	Возврат 1;
	
КонецФункции
