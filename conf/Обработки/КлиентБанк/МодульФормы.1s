//******************************************************************************
//	ТекстФайла(ИмяФайлаЗагрузки)
//
//	Параметры:
//
//	Описание:

Функция ТекстФайла(ИмяФайла)
	
	ЗагрРасчетныеСчета.УдалитьВсе(); ЗагрВидыДокументов.УдалитьВсе();
	//ТекстПараметрыЗагрузки=""; ТекстЗначенияЗагрузки=""; ТекстРасчСчетаЗагрузки="";

	Если ФС.СуществуетФайл(ИмяФайла)=0 Тогда
		Предупреждение("Указанный файл не существует!", 5);
		Возврат(ПолучитьПустоеЗначение());
	КонецЕсли;
	
    Выводить=0;	
	Текст=СоздатьОбъект("Текст");
    Если ТипОперации=1 Тогда
	Текст.КодоваяСтраница(КодировкаИмп);  
		Если ТипФорматаИмп=1 Тогда
		Выводить=1;
		КонецЕсли;
	Иначе   
		Если ТипФормата=1 Тогда
		Выводить=1;
		КонецЕсли;
	Текст.КодоваяСтраница(Кодировка);
	КонецЕсли;

	Если Выводить=1   Тогда
		Если Текст.КодоваяСтраница()=0 Тогда 
			Сообщить("Установлена кодировка - Windows.");
		Иначе
			Сообщить("Установлена кодировка - DOS.");
		КонецЕсли;
	КонецЕсли;
	
	Текст.Открыть(ИмяФайла); 
	
	Если Текст.КоличествоСтрок()<1 Тогда
		Предупреждение("Указанный файл обмена пуст!", 5);
		Возврат(ПолучитьПустоеЗначение());

	ИначеЕсли (СокрЛП(Текст.ПолучитьСтроку(1))<>"_1CClientBankExchange")
	и (ТипФорматаИмп = 1) и (ТипОперации=1) Тогда
		Предупреждение("Указанный файл не является файлом обмена!", 5);
		Возврат(ПолучитьПустоеЗначение());
	КонецЕсли;
	
	Возврат(Текст);

КонецФункции // ТекстФайла()

//******************************************************************************
// ===============================
// Функция ПолучитьДатуПоФСтроке(Знач ФСтр)
//  	возвращает значение типа Дата по форматной строке
// 	ФСтр - строка в формате "гггг-мм-дд"
// ===============================
Функция ПолучитьДатуПоФСтроке(Знач ФСтр)
Перем Поз, Год, Мес, Чсл;
	Если ПустаяСтрока(ФСтр) = 1 Тогда
	    Возврат Дата(0);
	КонецЕсли;
	// удаляем случайные пробелы                    
	СтрЗаменить(ФСтр," ","");
	// определяем год
	Поз = Найти(ФСтр,"-");
	Если Поз = 0 Тогда
		Возврат Дата(0);    
	КонецЕсли;
	Год = Число(Лев(ФСтр,Поз));
	ФСтр = Сред(ФСтр,Поз+1);
	// определяем месяц
	Поз = Найти(ФСтр,"-");
	Если Поз = 0 Тогда
		Возврат Дата(0);    
	КонецЕсли;
	Мес = Число(Лев(ФСтр,Поз));
	ФСтр = Сред(ФСтр,Поз+1);
	// определяем число
    Чсл = Число(ФСтр);
	// определяем дату
	Возврат Дата(Год,Мес,Чсл);
КонецФункции // ПолучитьДатуПоФСтроке

// ===============================
// Функция ПолучитьЧислоПоФСтроке(Знач ФСтр)
//  	возвращает значение типа Число по форматной строке
// 	ФСтр 		- строка в числовом формате
// 	СтрФормат	- формат числа
// 	Разделитель	- разделитель числа
// ===============================
Функция ПолучитьЧислоПоФСтроке(Знач ФСтр, СтрФормат, Разделитель = ".")
Перем Чсл;
	Если ПустаяСтрока(ФСтр) = 1 Тогда
	    Возврат 0;
	КонецЕсли;
	// заменяем разделитель на стандартный
	СтрЗаменить(ФСтр,Разделитель,".");
	Чсл = Число(ФСтр); 
	Если Чсл = 0 Тогда
		// неправильный формат числовой строки
	КонецЕсли;
	Попытка
		Возврат Число(Формат(Чсл,СтрФормат));
	Исключение      
		Сообщить("Не правильный формат для числового значения """+СтрФормат+"""");
		Возврат Чсл;
	КонецПопытки
КонецФункции // ПолучитьЧислоПоФСтроке

// ===============================
// Функция ФорматЗначение(Идентификатор,Значение,ФСтрока,ВидОбработки=0,НеПуст = 0)
//  	форматирует значение согласно правил форматирования,
// 		определяемых по идентификатору                                    
// 	Идентификатор 	- идентификатор реквизита файла обмена
// 	Значение		- значение реквизита
// 	ФСтрока			- отформатированное значение
// 	ВидОбработки	- способ обработки 
//						0: Значение	-> ФСтрока
//						1: Значение <- ФСтрока
// ===============================
Функция ФорматРеквизита(Идентификатор,Значение,ФСтрока,ВидОбработки)
	// проверка параметра идентификатор
	Если ПустаяСтрока(Идентификатор)  = 1 Тогда
	    Сообщить("Не заполнен идентификатор");
		Возврат 0;
	КонецЕсли;
	// определим формат реквизита
	СтрФормат = "";
	Поз = 0;
    Если тзРеквизитФО.НайтиЗначение(ВРег(Идентификатор),Поз,"Идентификатор")=0 Тогда
	    Сообщить("Неизвестное значение идентификатора: """+Идентификатор+"""");
		Возврат 0;
	КонецЕсли;
	СтрФормат = тзРеквизитФО.ПолучитьЗначение(Поз,?(ВидОбработки=0,"ВыгрФормат","ЗагрФормат"));

	Если СтрФормат = "Д" Тогда // гггг-мм-дд
		Если ВидОбработки = 0 Тогда // З->Ф
		    лЗнач = ?(ТипЗначенияСтр(Значение)="Дата",Значение,Дата(Значение));
			ФСтрока = ?(ПустоеЗначение(лЗнач)=1,"",""+ДатаГод(лЗнач)+"-"+Формат(ДатаМесяц(лЗнач),"Ч(0)2")+"-"+Формат(ДатаЧисло(лЗнач),"Ч(0)2"));
		Иначе // Ф->З
			Значение = ПолучитьДатуПоФСтроке(ФСтрока);
		КонецЕсли;

	ИначеЕсли СтрФормат = "В" Тогда // чч:мм:сс

	ИначеЕсли СтрФормат = "С" Тогда // строка
		Если ВидОбработки = 0 Тогда // З->Ф
			ФСтрока = ""+Значение;
		Иначе // Ф->З
			Значение = ФСтрока;
		КонецЕсли;

	ИначеЕсли Лев(СтрФормат,1) = "Ч" Тогда // число
		Если ВидОбработки = 0 Тогда // З->Ф
		    лЗнач = ?(ТипЗначенияСтр(Значение)="Число",Значение,Число(Значение));
			ФСтрока = ?(ПустоеЗначение(лЗнач)=1,"",Формат(лЗнач,СтрФормат));
		Иначе // Ф->З
			Значение = ПолучитьЧислоПоФСтроке(ФСтрока,СтрФормат,".");
		КонецЕсли;
	Иначе
	    Сообщить("Не определен формат идентификатора """+Идентификатор+"""");
		Возврат 0;
	КонецЕсли;
	Возврат 1;
КонецФункции // ФорматЗначение

// ===============================
// Функция ДобавитьРеквизит(Текст,Идентификатор,Значение)
//  	записывает значение идентификатора в формате файла обмена
// 	Текст 			- текст файла обмена
// 	Идентификатор	- идентификатор реквизита
// 	Значение		- значение реквизита
// ===============================
Функция ДобавитьРеквизит(Текст,Идентификатор,Значение)
Перем ФСтрока;
	ФорматРеквизита(Идентификатор,Значение,ФСтрока,0);
	Текст.ДобавитьСтроку(Идентификатор + " = "+ФСтрока);
КонецФункции // ДобавитьРеквизит

// ===============================
// Функция ДобавитьСлужРеквизит(Текст,Идентификатор)
//  	записывает служебный идентификатор в файла обмена
// 	Текст 			- текст файла обмена
// 	Идентификатор	- идентификатор служебного реквизита
// ===============================
Функция ДобавитьСлужРеквизит(Текст,Идентификатор)
	Текст.ДобавитьСтроку(Идентификатор);
КонецФункции // ДобавитьРеквизит 

