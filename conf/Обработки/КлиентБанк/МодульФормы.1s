//******************************************************* 
//*****Служебные функции для задания парамертов импорта
//*******************************************************   
// ===============================
Процедура ОбновитьИнфо()

    Инфо = "Учетные данные за период с "+ДатаНачалаЗаг+" по "+ДатаКонцаЗаг+": ";
	Для Инд = 1 По спРСчета.РазмерСписка() Цикл
		Если спРСчета.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;
    РСчет= спРСчета.ПолучитьЗначение(Инд);
	ОстНач = 0; ОстКон = 0;
	Приход = 0; Расход = 0;
	БухСчет=СчетПоКоду("311");
	Ит = СоздатьОбъект("БухгалтерскиеИтоги");
	Ит.ИспользоватьРазделительУчета(Фирма);
	Ит.ИспользоватьСубконто(ВидыСубконто.НашиДенежныеСчета, РСчет, 2);
	Ит.ВыполнитьЗапрос(ДатаНачалаЗаг,ДатаКонцаЗаг,БухСчет,,,,,"СВ");
	
	Если РСчет.Валюта = Гривня Тогда
		ОстНач = Ит.СНД();
		ОстКон = Ит.СКД(); 
		Приход = Ит.ДО();
		Расход = Ит.КО();  
 	КонецЕсли;
	    
		Инфо = Инфо + "Итого движения по р/сч. "+РСчет+" ("+СокрЛП(Строка(РСчет.НомерСчета))+"): ";
		Инфо = Инфо + " Остаток на начало = "+ОстНач+"; ";
		Инфо = Инфо + " Приход = "+Приход+"; "+" Расход = "+Расход+"; ";
		Инфо = Инфо + " Остаток на конец = "+ОстКон+"; ";
	КонецЦикла;	

КонецПроцедуры

