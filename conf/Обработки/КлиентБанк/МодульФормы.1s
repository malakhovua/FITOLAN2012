// ===============================   
Процедура ПриОткрытии()

	ЗаписатьФорматФайлаОбмена();  
	ПутьФайлаОбмена=КаталогПользователя()+"1c_to_kb.txt";
	ПутьФайлаИмпорта=КаталогПользователя()+"kb_to_1c.txt";
	сФайл = "";
	РасположениеФайла(КаталогУстановки,сФайл);
	
 	Если Метаданные.Документ("ДвиженияДенежныхСредств").Выбран() = 1 Тогда
		ТипДокБВ = "ДвиженияДенежныхСредств";  
		ТипСпрКонтрагенты = "Контрагенты"; 
		ТипКонфигурации = "Торговля";
		ТипРеквизитаОКПО = "ЕГРПОУ"; 
		Фирма=Константа.ОсновнаяФирма;
		Если Метаданные.Константа("ОсновнаяСтавкаНДС").Периодический = 1 Тогда
			КонстантаБазНДС = Константа.ОсновнаяСтавкаНДС.Получить(ТекущаяДата());
		Иначе
			КонстантаБазНДС = Константа.ОсновнаяСтавкаНДС;
		КонецЕсли; 
	ИначеЕсли Метаданные.Документ("БанковскаяВыписка").Выбран() = 1 Тогда 
		Если Метаданные.Справочник("Клиенты").Выбран() =1 Тогда
		    ТипСпрКонтрагенты = "Клиенты";         
			ТипКонфигурации = "Абт3";
			ТипРеквизитаОКПО = "ОКПО";
			Если Метаданные.Константа("БазНДС").Периодический = 1 Тогда
				КонстантаБазНДС = Константа.БазНДС.Получить(ТекущаяДата());
			Иначе
				КонстантаБазНДС = Константа.БазНДС;
			КонецЕсли;
		ИначеЕсли Метаданные.Константа("УчасткиУчета").Выбран() = 1 Тогда
			ТипСпрКонтрагенты = "Контрагенты"; 
			ТипКонфигурации = "КУК";
			ТипРеквизитаОКПО = "ЕДРПОУ";
			Если Метаданные.Константа("БазНДС").Периодический = 1 Тогда
				КонстантаБазНДС = Константа.БазНДС.Получить(ТекущаяДата());
			Иначе
				КонстантаБазНДС = Константа.БазНДС;
			КонецЕсли;
		ИначеЕсли Метаданные.Константа("МетодРасчетаСебестоимостиПродукции").Выбран() = 1 Тогда
			ТипСпрКонтрагенты = "Контрагенты"; 
			ТипКонфигурации = "ПУБ";
			ТипРеквизитаОКПО = "ЕДРПОУ";
			Если Метаданные.Константа("БазНДС").Периодический = 1 Тогда
				КонстантаБазНДС = Константа.БазНДС.Получить(ТекущаяДата());
			Иначе
				КонстантаБазНДС = Константа.БазНДС;
			КонецЕсли;
		Иначе
			ТипСпрКонтрагенты = "Контрагенты"; 
			ТипКонфигурации = "Укр";
			ТипРеквизитаОКПО = "ЕДРПОУ";
			Если Метаданные.Константа("БазНДС").Периодический = 1 Тогда
				КонстантаБазНДС = Константа.БазНДС.Получить(ТекущаяДата());
			Иначе
				КонстантаБазНДС = Константа.БазНДС;
			КонецЕсли;
		КонецЕсли;
		ТипДокБВ = "БанковскаяВыписка";
	Иначе
		Сообщить("В конфигурации не существует документа БанковскаяВыписка продолжение работы не возможно");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;

	Если Метаданные.Документ("ПлатежноеПоручение").Выбран() = 1 Тогда        
		ТипДокПП = "ПлатежноеПоручение";
	Иначе
		Сообщить("В конфигурации не существует документа ПлатежноеПоручение! Продолжение работы не возможно.");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;       
	
	ТаблицаВалют = ВосстановитьЗначение("Клиент_Банк_Валюты");
	Если ТипЗначенияСтр(ТаблицаВалют) = "ТаблицаЗначений" Тогда
	    ЕстьНастройкаВалют = 1;
	Иначе
		ЕстьНастройкаВалют = 0;
	КонецЕсли;

	Инфо = "";
    фИмпорт = 1;
	ТекущийСлой = "Начало";
	Форма.ИспользоватьСлой("Основной,Начало,Картинка",2);

	ТипОперации = 1; // импорт
	ИзмТипОперации();
	
	ТипФормата = 1; // Текстовый 
	ТипФорматаИмп =1;
	ТипКодировки = 1; // Windows
	ИзмТипКодировки();
    ТипКодировкиИмп = 1; // Windows
	ИзмТипКодировкиИмп();
	
	ИзмТипФормата();
	ИзмТипФорматаИмп();

	фСоздавать = 2; // Не очищать Выписки перед загрузкой
	ИзмСоздавать();
	ИзмТипИмпорта();
	
	
	НачДата = РабочаяДата();
	КонДата = РабочаяДата();

	ЕстьРазделительУчета = Метаданные.РазделительУчета.Выбран();
	
	Если ТипКонфигурации <> "Торговля" Тогда
	СчетДляПрихода = СчетПоКоду("36.1");
	СчетДляРасхода = СчетПоКоду("63.1");

	СчетДляПриходаВал = СчетПоКоду("36.2");
	СчетДляРасходаВал = СчетПоКоду("63.2");
	
	Фирма = Константа.БазФирма;
	Иначе
    Форма.СчетДляПрихода.Доступность(0);
    Форма.СчетДляРасхода.Доступность(0);
	КонецЕсли;
	// Заполняем список видов обрабатываемых документов
	спВидыДок.ДобавитьЗначение("ПлатежноеПоручение",			"Платежное поручение");
	спВидыДок.Пометка(1,1);
	Если ТипКонфигурации <> "Торговля" Тогда
	спВидыДок.ДобавитьЗначение("ПлатежноеТребованиеПоручение",	"Платежное требование-поручение");
	спВидыДок.Пометка(2,1); 
    КонецЕсли;
	//===== промежуточный список для загрузки из внешнего файла
тВыписка.НоваяКолонка("Номер","Строка",10,,"№ ПП",5,,); //Номер платежки
тВыписка.НоваяКолонка("ДокументИД",			"Строка",	,	,	"Идентификатор документа",13);
тВыписка.НоваяКолонка("ВидДокумента",		"Строка",	,	,	"Вид документа",20);
тВыписка.НоваяКолонка("Дата",				"Строка",		,	,	"Дата документа",12);

тВыписка.НоваяКолонка("Сумма",				"Число",	12, 2,	"Сумма платежа");
// Квитанция по платежному документу
//тВыписка.НоваяКолонка("КвитанцияДата",		"Дата",		,	,	"Дата формирования квитанции");
//тВыписка.НоваяКолонка("КвитанцияВремя",		"Строка",	8,	,	"Время формирования квитанции");
//тВыписка.НоваяКолонка("КвитанцияСодержание","Строка",	,	,	"Содержание квитанции");

тВыписка.НоваяКолонка("ПлательщикСчет",		"Число",	14,	,	"Номер р/с плательщика в его банке",14);	// Номер р/с плательщика в его банке
тВыписка.НоваяКолонка("ДатаСписано",		"Строка",		,	,"Дата списания средств с р/с",12);
// реквизиты плательщика																							   в случае непрямых расчетов:
тВыписка.НоваяКолонка("ПлательщикОКПО",		"Строка",	10,	,	"ОКПО плательщика",10);						// ОКПО плательщика
тВыписка.НоваяКолонка("Плательщик",			"Строка",	,	,	"Плательщик",15);							// Плательщик
тВыписка.НоваяКолонка("ПлательщикБанк",		"Строка",	,	,	"Банк плательщика",15);					// Банк плательщика
ТВыписка.ВидимостьКолонки("ПлательщикБанк",0,);

тВыписка.НоваяКолонка("ПлательщикМФО",		"Строка",	,	,	"МФО банка плательщика",10);				// МФО банка плательщика

тВыписка.НоваяКолонка("ПолучательСчет",		"Число",	14,	,	"Номер р/с получателя в его банке",14);	// Номер р/с получателя в его банке
тВыписка.НоваяКолонка("ДатаПоступило",		"Строка",		,	,"Дата поступления средств на р/с",12);

// реквизиты получателя (поставщика)
тВыписка.НоваяКолонка("ПолучательОКПО", 	"Строка",	10,	,	"ОКПО получателя",10);						// ОКПО получателя
тВыписка.НоваяКолонка("Получатель",			"Строка",	,	,	"Получатель",15);							// Получатель
тВыписка.НоваяКолонка("ПолучательБанк",		"Строка",	,	,	"Банк получателя",15);						// Банк получателя
ТВыписка.ВидимостьКолонки("ПолучательБанк",0,);
тВыписка.НоваяКолонка("ПолучательМФО",		"Строка",	10,	,	"МФО банка получателя",10);		// МФО банка получателя
// реквизиты платежа
тВыписка.НоваяКолонка("НазначениеПлатежа",		"Строка",	100,	,	"Назначение платежа",20);                         // "Почтой". "Телеграфом", "Электронно"
тВыписка.НоваяКолонка("КодВалюты",			"Строка",	, ,	"Код валюты",3); 
тВыписка.НоваяКолонка("СтатусДокумента",	"Строка",	, ,	"Статус документа",8);

	//Видимости
	Если (ТипКонфигурации = "Абт3") или (ТипКонфигурации = "Торговля") Тогда
		ТВыписка.ВидимостьКолонки("НомерПП",0,);
	Иначе
//		ТВыписка.ВидимостьКолонки("НомерПП",1,);
	КонецЕсли;
	
АтрибутыДокументов=СоздатьОбъект("СписокЗначений");
Для К=1 по тВыписка.КоличествоКолонок() Цикл
	Колонка=тВыписка.ПолучитьПараметрыКолонки(К);
	АтрибутыДокументов.ДобавитьЗначение(Колонка, Врег(Колонка));
КонецЦикла;

ВидыОпераций=СоздатьОбъект("СписокЗначений");
ВидыОпераций.Установить("Платежное поручение",				"01"); // 01 - Списано, зачислено по платежному поручению
ВидыОпераций.Установить("Платежное требование-поручение",	"02"); // 02 - Оплачено, зачислено по платежному требованию
ВидыОпераций.Установить("Прочее",						"03");     // 03 - Прочее

ЗагрРасчетныеСчета=СоздатьОбъект("СписокЗначений");
ЗагрВидыДокументов=СоздатьОбъект("СписокЗначений");
ЗагрДокументы=СоздатьОбъект("СписокЗначений");


КонецПроцедуры //ПриОткрытии  

// ===============================   
Процедура ПриЗакрытии()
	Если (ТекущийСлой = "Конец") Или (ТекущийСлой = "Ошибка") Тогда
	    Возврат;
	КонецЕсли;

	Если Вопрос("Закончить работу помощника?","Да+Нет") = "Нет" Тогда
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;  
	
КонецПроцедуры //ПриЗакрытии

// ===============================
Процедура ПриНачалеВыбораЗначения(Элемент, Продолжать)
	Если (Элемент="ПутьФайлаОбмена") или (Элемент="ПутьФайлаИмпорта") Тогда
		Файл = "";
		Выбор=ФС.ВыбратьФайл(0, Файл, КаталогУстановки, "Файл "+ТипОперацииСтр, 
				?(ТипФайлаСтр = "TXT","Текстовый файл (*.txt)|*.txt","Схема обмена XML (*.xml)|*.xml"), ТипФайлаСтр);
		Если Выбор=1 Тогда 
				Если Элемент="ПутьФайлаОбмена" Тогда
				ПутьФайлаОбмена = КаталогУстановки + Файл;
				Иначе
				ПутьФайлаИмпорта= КаталогУстановки + Файл;	
				КонецЕсли;	
		КонецЕсли;
	КонецЕсли; 
	
