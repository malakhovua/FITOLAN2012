//******************************************************************************
Процедура СоздатьРСчет(Слово, Спр) 
		
	Если (ТипКонфигурации <>"Торговля") Тогда
		Счета = СоздатьОбъект("Справочник.ДенежныеСчета");
		Счета.ИспользоватьВладельца(Спр.ТекущийЭлемент());
		Если Счета.НайтиПоРеквизиту("НомерСчета",СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет")),0) = 0 Тогда
Сообщить("Для контрагента "+СокрЛП(Строка(Спр.ТекущийЭлемент()))+" не найден р/счет - "+СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"))+"! Создается новый...","I");
			Счета.Новый();
			Счета.Владелец = Спр.ТекущийЭлемент();
			
			// Счета.Валюта = Гривня;
			КодВалюты = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки,"КодВалюты"));
			Если ((ПустоеЗначение(КодВалюты)=1) ИЛИ (КодВалюты = "980")) Тогда
				Счета.Валюта = Гривня;
			Иначе       
				СпрВалюты=СоздатьОбъект("Справочник.Валюты");   
				Если  СпрВалюты.НайтиПоКоду(КодВалюты) = 1 Тогда
					Счета.Валюта = СпрВалюты.ТекущийЭлемент();
				Иначе
					Сообщить("Не обнаружен валюта с кодом " + КодВалюты);
				КонецЕсли;	
			КонецЕсли;
			
			Счета.НомерСчета = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"));   
			Счета.Наименование = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"));
            Счета.ТипСчета=Перечисление.ТипыБезналичныхСчетов.Текущий;
			СпрБанк=СоздатьОбъект("Справочник.Банки");
			Если СпрБанк.НайтиПоКоду(СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"МФО")),0)=1 Тогда
				Счета.Банк=СпрБанк.ТекущийЭлемент();
			Иначе   
Сообщить("Для контрагента "+СокрЛП(Строка(Спр.ТекущийЭлемент()))+" не найден банк по коду МФО - "+СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"МФО"))+"! Создается новый...","I");
				СпрБанк.Новый();
				СпрБанк.Код=СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"МФО"));
				СпрБанк.Наименование=СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Банк"));
                СпрБанк.Записать(); 
				Счета.Банк=СпрБанк.ТекущийЭлемент();
			КонецЕсли;
			Счета.Записать();
		КонецЕсли;
	ИначеЕсли (ТипКонфигурации = "Торговля") Тогда
		Счета = СоздатьОбъект("Справочник.РасчетныеСчета");
		Счета.ИспользоватьВладельца(Спр.ТекущийЭлемент()); 
		Найден = 0;
		Если Метаданные.Справочник("РасчетныеСчета").Реквизит("БанкСчет").Сортировка = 1 Тогда
			Найден = Счета.НайтиПоРеквизиту("БанкСчет",СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет")),0);
		Иначе
			Счета.ВыбратьЭлементы();
			Пока Счета.ПолучитьЭлемент() = 1 Цикл
				Если Счета.БанкСчет = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет")) Тогда
				    Найден = 1;
					Прервать;
				КонецЕсли;    
			КонецЦикла;
		КонецЕсли;
		Если Найден = 0 Тогда
Сообщить("Для контрагента "+СокрЛП(Строка(Спр.ТекущийЭлемент()))+" не найден р/счет - "+СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"))+"! Создается новый...","I");
			Счета.Новый();
			Счета.Владелец = Спр.ТекущийЭлемент();
			Счета.БанкСчет = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"));
			Счета.Наименование = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"));
			Счета.БанкМФО = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"МФО"));
			Счета.БанкНазвание = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Банк"));
			Счета.Записать();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры //СоздатьРСчет(Спр)

//******************************************************************************

Функция НайтиОрганизацию(Слово, Вид)
	
	Объект=СоздатьОбъект("Справочник."+Вид);
	
	ИНН=СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"ОКПО"));
	Если ПустаяСтрока(ИНН)=0 Тогда 
		Найден=0;
		Если ТипКонфигурации <> "Торговля" Тогда 
			Если Объект.НайтиПоРеквизиту(ТипРеквизитаОКПО, ИНН, 1)=1 Тогда
		    Найден=1;
			КонецЕсли;              
		ИначеЕсли Вид = "Контрагенты" Тогда 
  			Если Объект.НайтиПоРеквизиту(ТипРеквизитаОКПО, ИНН, 1)=1 Тогда
		    Найден=1;
			КонецЕсли;              
		ИначеЕсли Вид = "Фирмы" Тогда
			Объект.ВыбратьЭлементы();
			Пока Объект.ПолучитьЭлемент()=1 Цикл
			   Элемент=Объект.ТекущийЭлемент();
				Если СокрЛП(Строка(Элемент.ЕГРПОУ))=СокрЛП(Строка(ИНН)) Тогда	
				     Найден=1; 
				Прервать;
				КонецЕсли;	 
			КонецЦикла;

		КонецЕсли;
		
		Если Найден=0 Тогда
		    Сообщить(Слово+": "+СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово))+ " по рекв. ЕДРПОУ= "+ИНН+ " не найден!. Контрагент либо отсутствует в справочнике, либо ЕДРПОУ указан неверно.","!");
			// Группа клиентов, не найденных в ИБ
			СпрНов = СоздатьОбъект("Справочник.Контрагенты");
			Если СпрНов.НайтиПоНаименованию("Новые (клиент-банк)",0,1) = 1 Тогда
				Группа = СпрНов.ТекущийЭлемент();
			Иначе
				СпрНов.НоваяГруппа();
				СпрНов.Наименование = "Новые (клиент-банк)";
				СпрНов.Записать();
				Группа = СпрНов.ТекущийЭлемент(); 
			КонецЕсли;       
		       
			Если Вид = "Контрагенты" Тогда
				Объект.Новый(); 
				Объект.Родитель = Группа; // Группа - новые клиенты
				Если (ТипКонфигурации = "Укр") или (ТипКонфигурации = "КУК") или (ТипКонфигурации = "ПУБ") Тогда
					Объект.ВидКонтрагента = Перечисление.ВидыКонтрагентов.Организация;
					Объект.ВидТорговли = Перечисление.ВидыТорговли.Предоплата;
					Если ТипКонфигурации <> "ПУБ" Тогда
						Объект.ВидВзаиморасчетов = Константа.БазВидВзаиморасчетов;
					КонецЕсли;
				ИначеЕсли ТипКонфигурации = "Торговля" Тогда
					Объект.ВидКонтрагента = Перечисление.ВидыКонтрагентов.Организация;
					Объект.ВалютаВзаиморасчетов = Константа.ВалютаВзаиморасчетов;
					Объект.ВалютаКредита = Константа.ОсновнаяВалюта;
					Объект.ВалютаКредитаПоставщика = Константа.ОсновнаяВалюта;
				КонецЕсли;
				Объект.Наименование = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово));
				Объект.ПолнНаименование = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово));
				Объект.УстановитьАтрибут(ТипРеквизитаОКПО,СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"ОКПО")));
				Объект.Записать(); 
				// Создадим рассчетный счет (если не найден)
				СоздатьРСчет(Слово, Объект.ТекущийЭлемент());
		 	    Сообщить("В справочник "+вид+" в папку Новые (клиент-банк) добавлен новый элемент: "+Объект.Наименование,"I");
	 		КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
  

	Возврат(Объект.ТекущийЭлемент());
	
КонецФункции // НайтиОрганизацию()

//******************************************************************************
//	НайтиРасчетныйСчет(Слово)
//
//	Параметры:
//
//	Возвращаемое значение:
//
//	Описание:

Функция НайтиРасчетныйСчет(Слово, Вид, Владелец=0)
	
	Объект=СоздатьОбъект("Справочник."+Вид); 
	Если ПустоеЗначение(Владелец)=0 Тогда
		Объект.ИспользоватьВладельца(Владелец); 
	КонецЕсли;
	Спр=СоздатьОбъект("Справочник."+Вид);
	
	Счет=СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, Слово+"Счет"));
	Если ПустоеЗначение(Число(Счет))=0 Тогда
    	Если ТипКонфигурации<>"Торговля" Тогда
			Если Вид="НашиДенежныеСчета" Тогда
			Объект.НайтиПоРеквизиту("НомерСчета", Счет,1);
			Иначе	
			Объект.НайтиПоРеквизиту("НомерСчета", Счет, ПустоеЗначение(Владелец));
			КонецЕсли;	
		Иначе    
            Если Вид="НашиДенежныеСчета" Тогда 
		   	Владелец=НайтиОрганизацию(Слово, "Фирмы");
			Иначе
		   	Владелец=НайтиОрганизацию(Слово, "Контрагенты");
   			КонецЕсли;
   			Спр.ИспользоватьВладельца(Владелец);
			Спр.ВыбратьЭлементы();
			Пока Спр.ПолучитьЭлемент()=1 Цикл
				Если СокрЛП(Строка(Спр.ТекущийЭлемент().БанкСчет))=СокрЛП(Строка(Счет)) Тогда	
                     	Если (Вид="НашиДенежныеСчета") Тогда
// 				    	    Если (Спр.ТекущийЭлемент().Валюта.код<>"980") Тогда
							КодВалюты = СокрЛП(тВыписка.ПолучитьЗначение(тВыписка.НомерСтроки, "КодВалюты"));
							Если ПустоеЗначение(КодВалюты) = 1 Тогда
								КодВалюты = "980";
							КонецЕсли;
//				    	    Если (Спр.ТекущийЭлемент().Валюта.код<>"980") Тогда
				    	    Если (Спр.ТекущийЭлемент().Валюта.код<>КодВалюты) Тогда
                                Сообщить("Для расч. счета "+СокрЛП(Строка(Счет))+" (фирма "+Владелец+")"+ " должна быть указана валюта с кодом = """ + КодВалюты + """!","!");
								Продолжить;
							КонецЕсли; 
					 	КонецЕсли; 
						Объект=Спр.ТекущийЭлемент();
					 Прервать;
				КонецЕсли;	 
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;

	Если (Объект.Выбран()=1) и (ТипЗначенияСтр(Владелец)="Справочник") Тогда 
		Владелец=Объект.Владелец;
	КонецЕсли;
	
 	Возврат(Объект.ТекущийЭлемент());
	
КонецФункции // НайтиРасчетныйСчет()
 
//******************************************************************************
//	НайтиЗначПеречисления()
//
//	Параметры:
//
//	Возвращаемое значение:
//
//	Описание:

Функция НайтиЗначПеречисления(Вид, Стр)
	
	Перечисл=Перечисление.ПолучитьАтрибут(Вид);
	Для К=1 по Перечисл.КоличествоЗначений() Цикл
		Значение=Перечисл.ЗначениеПоНомеру(К);

		Если Строка(Значение)=СокрЛП(Стр) Тогда Возврат(Значение); КонецЕсли;
	КонецЦикла;
	
	Возврат(ПолучитьПустоеЗначение("Перечисление.ВидыПлатежа"));
	
КонецФункции // НайтиЗначПеречисления()

//******************************************************************************
//	ИзменитьАтрибут(Объект, Имя, Значение)
//
//	Параметры:
//
//	Возвращаемое значение:
//
//	Описание:

Функция ИзменитьАтрибут(Объект, Имя, Значение)
	
	//Если ПустоеЗначение(Значение)=1 Тогда 
	//	Возврат(0); 
	//КонецЕсли;
//Сообщить("Имя = "+Имя);
//Сообщить("Объект = "+Объект);
//Сообщить("Значение = "+Значение);

	Атрибут=Объект.ПолучитьАтрибут(Имя);
	
	Если ТипЗначенияСтр(Значение)="Строка" Тогда
		Атрибут=СокрП(Атрибут); Значение=СокрП(Значение);
	КонецЕсли;

	Если Атрибут=Значение Тогда
		Возврат(0);
	КонецЕсли;

	Объект.УстановитьАтрибут(Имя, Значение);
	
	Если Объект.ТекущийДокумент().Выбран()=1 Тогда
		Стр=?(0<Объект.НомерСтроки, ", строка "+Объект.НомерСтроки, "");
		Сообщить("Изменен атрибут документа: "+Объект+Стр+": "+Имя+" = "+Значение, "!");
	КонецЕсли;

	Возврат(1);
	
КонецФункции // ИзменитьАтрибут()

//******************************************************************************
//	СнятьПометкуУдаления(Объект)
//
//	Параметры:
//
//	Описание:

Процедура СнятьПометкуУдаления(Объект)
	
	Попытка
		Если Объект.ПометкаУдаления()=1 Тогда
			Объект.СнятьПометкуУдаления();
			Сообщить("Отменено удаление документа: "+Объект, " ");
		КонецЕсли;
	
	Исключение
		Сообщить("Неудачная попытка отмены удаления: "+Объект+": "+ОписаниеОшибки(), "!!!");
	КонецПопытки;
	
КонецПроцедуры // СнятьПометкуУдаления()

//******************************************************************************
//	ЗаписатьДокумент(Объект, Стр)
//
//	Параметры:
//	Объект - справочник, документ, операция
//
//	Возвращаемое значение:
//	1 - в случае успешной попытки записи, 0 - иначе
//
//	Описание:
//	Делает попытку записать объект; в случае успеха - выводит сообщение
//	в случае неудачи - производит запись в файле записи ошибок

Процедура ЗаписатьДокумент(Объект)
	
	Попытка
		Если      Объект.ПометкаУдаления()=1 Тогда
			Объект.СнятьПометкуУдаления();
		ИначеЕсли Объект.Проведен()=1 Тогда
			Объект.СделатьНеПроведенным();
		КонецЕсли;
		
		Объект.Записать(); 
		Сообщить("Записан документ: "+Объект, " ");
	Исключение
		Сообщить("Неудачная попытка записи документа: "+Объект+": "+ОписаниеОшибки(), "!!!");
	КонецПопытки;
		
КонецПроцедуры // ЗаписатьДокумент() 



//******************************************************************************
//	ОбработатьВыписку(Документ, Счет, ДатаОперации, ПриходРасход, СтатусПроведен, НашПП)
//
//	Параметры:
//
//	Описание:

Процедура ОбработатьВыписку(Документ, Счет, ДатаОперации, ПриходРасход, СтатусПроведен, НашПП, Корреспондент)
	
Если ПустоеЗначение(Счет)=1 Тогда Возврат; КонецЕсли;
	
Док=СоздатьОбъект("Документ");

//============== обработка ПП выписанных в 1С
Если НашПП="Да" Тогда
	Если ТипКонфигурации="Укр" Тогда
		Если Документ.Заказ.Выбран()=1 Тогда 
		Док.ВыбратьПодчиненныеДокументы(ДатаНачалаЗаг,ДатаКонцаЗаг , Документ.Заказ);
		Иначе
		Док.ВыбратьДокументы(ДатаНачалаЗаг,ДатаКонцаЗаг);
		Сообщить("В документе "+Документ.Вид()+" "+Документ.НомерДок+" ("+Документ.ДатаДок+")"+" не указан Заказ! ", "!");
		КонецЕсли; 
	Иначе  
		Если (ТипКонфигурации="КУК") и (Документ.Вид()="ПлатежноеТребованиеПоручение") Тогда
		ДокументОснование=Документ.Заказ;
		Иначе     
		ДокументОснование=Документ.ДокументОснование;
		КонецЕсли;
	
		Если ДокументОснование.Выбран()=1 Тогда 
		Док.ВыбратьПодчиненныеДокументы(ДатаНачалаЗаг,ДатаКонцаЗаг , ДокументОснование);
		Иначе
		Док.ВыбратьДокументы(ДатаНачалаЗаг,ДатаКонцаЗаг);
		Сообщить("В документе "+Документ.Вид()+" "+Документ.НомерДок+" ("+Документ.ДатаДок+")"+" не указан Документ-основание! ", "!");
		КонецЕсли; 
	КонецЕсли; 
	
	Пока Док.ПолучитьДокумент()=1 Цикл
		Если (Док.Вид()<>"БанковскаяВыписка") и (ТипКонфигурации<>"Торговля")  Тогда Продолжить;
		ИначеЕсли (Док.Вид()<>"ДвиженияДенежныхСредств") и (ТипКонфигурации="Торговля") Тогда Продолжить; 
		ИначеЕсли Док.РСчет<>Счет Тогда Продолжить; 
		КонецЕсли;

		Замены=0;  
		ЗаказВыбран=0;
		Док.ВыбратьСтроки();
		Пока Док.ПолучитьСтроку()=1 Цикл 
			Если ТипКонфигурации="Укр" Тогда
				ЗаказВБ=Док.Заказ;
				ЗаказПП=Документ.Заказ;
				Если Документ.Заказ.Выбран()=1 Тогда
                	ЗаказВыбран=1;
				КонецЕсли;
			Иначе   
				ЗаказВБ=Док.ДокументОснование;
				Если (ТипКонфигурации="КУК") и (Документ.Вид()="ПлатежноеТребованиеПоручение") Тогда
				ЗаказПП=Документ.Заказ;
              	  Если Документ.Заказ.Выбран()=1 Тогда
                	ЗаказВыбран=1;
				  КонецЕсли;
				Иначе     
				ЗаказПП=Документ.ДокументОснование;
                	Если Документ.ДокументОснование.Выбран()=1 Тогда
                	ЗаказВыбран=1;
					КонецЕсли;
				КонецЕсли; 
			
			КонецЕсли;
			
	        Если ТипКонфигурации="Торговля" Тогда
						Если ПриходРасход = "Приход" Тогда
						АтрибутСум="Приход";
						Иначе  
						АтрибутСум="Расход";
						КонецЕсли;
			Иначе
						АтрибутСум="СуммаСНДС";
			КонецЕсли;
		
			Если (ЗаказВБ<>ЗаказПП) или (ЗаказВыбран=0) Тогда
//============== обработка входящих платежей
			ИначеЕсли Док.ДатаДок<>ДатаОперации Тогда
				Замены=Замены+ИзменитьАтрибут(Док, ?(ТипКонфигурации<>"Торговля","СуммаПлатежа",АтрибутСум), 0);
				Замены=Замены+ИзменитьАтрибут(Док, АтрибутСум, 0);
				Замены=Замены+?(ТипКонфигурации<>"Торговля",ИзменитьАтрибут(Док, "НДС", 0),0);
                Если ТипКонфигурации<>"Торговля" Тогда 
				Док.СуммаПлатежа=0;
                Док.СуммаСНДС=0;
				Док.НДС=0; 
				Иначе
				Док.Приход=0;
				Док.Расход=0;
				КонецЕсли;
			ИначеЕсли Док.ДатаДок=ДатаОперации Тогда
				Замены=Замены+ИзменитьАтрибут(Док, ?(ТипКонфигурации<>"Торговля","СуммаПлатежа",АтрибутСум),  ?(ТипКонфигурации<>"Торговля", Документ.СуммаПлатежа,Документ.СуммаСНДС));
				Замены=Замены+ИзменитьАтрибут(Док, АтрибутСум, Документ.СуммаСНДС);  
					Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
					Замены=Замены+?(ТипКонфигурации<>"Торговля",ИзменитьАтрибут(Док, "НДС",  0),0);
					Иначе
					Замены=Замены+?(ТипКонфигурации<>"Торговля",ИзменитьАтрибут(Док, "НДС",  Документ.НДС),0);
				КонецЕсли;
			    Если (СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))  Тогда
				Замены=Замены+ИзменитьАтрибут(Док, ?(ТипКонфигурации<>"Торговля","ВидНДС","СтавкаНДС"),  ?(ТипКонфигурации<>"Торговля", Документ.ВидНДС,Документ.СтавкаНДС));
				Иначе   
				Замены=Замены+?(ТипКонфигурации<>"Торговля",ИзменитьАтрибут(Док, "ВидНДС", Документ.ВидНДС),0);
				КонецЕсли;
				Если ТипКонфигурации<>"Торговля" Тогда 
					Док.СуммаПлатежа=Документ.СуммаПлатежа;
					Док.ВидНДС=Документ.ВидНДС;
   					Док.СуммаСНДС=Документ.СуммаСНДС;
					Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
					Док.НДС=Документ.НДС; 
					Иначе                     
					Док.НДС=0; 
					КонецЕсли;	
				Иначе
						Если ПриходРасход = "Приход" Тогда
						Док.Приход=Документ.СуммаСНДС;
						Иначе  
						Док.Расход=Документ.СуммаСНДС;
						КонецЕсли; 
					    Если (СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))  Тогда
   							    Док.СтавкаНДС=Документ.СтавкаНДС;
						КонецЕсли;
					Если (Док.Контрагент<>Документ.Контрагент)    Тогда  
					Док.Контрагент=Документ.Контрагент;
					Замены=Замены+1; 
						Если (СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))   Тогда  
						Сообщить("В строке №"+Док.НомерСтроки+ " док.: "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+") контрагент "+Док.Контрагент+" не соответствует основанию!", "!!");
						Сообщить("Укажите правильного контрагента вручную. Проверьте код ОКПО контрагента в документе-основании платежа!", "!!");
              			КонецЕсли;
					КонецЕсли;

				КонецЕсли;
			Если ЗаказВБ.Выбран()=1 Тогда 
				Если (ЗаказВБ.Контрагент<>Документ.Контрагент) и (СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))   Тогда  
					Сообщить("В строке №"+Док.НомерСтроки+ " док.: "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+") контрагент "+Документ.Контрагент+" не соответствует док.-основанию!", "!!");
					Сообщить("Укажите правильного контрагента вручную. Проверьте код ОКПО контрагента в документе-основании платежа!", "!!");
				КонецЕсли;
	        КонецЕсли;
			КонецЕсли;
			
		КонецЦикла; 
		
		Если Замены>0 Тогда
      	ЗаписатьДокумент(Док);
	  	КонецЕсли;
	КонецЦикла;
КонецЕсли;	
	
	Если ПустоеЗначение(ДатаОперации)=1 Тогда Возврат; КонецЕсли;
	Если НашПП="Да" Тогда
		Если (Документ.СуммаСНДС=0) Тогда Возврат; КонецЕсли;
	Иначе 
		Если (тВыписка.Сумма=0) Тогда Возврат; КонецЕсли;	
	КонецЕсли;	
	
	Если ТипКонфигурации="Укр" Тогда
	Гривня=Константа.ОсновнаяВалюта; 
	Иначе
	Гривня=Константа.БазоваяВалюта; 
	КонецЕсли;
	
	Если ТипКонфигурации<>"Торговля" Тогда
	Док=СоздатьОбъект("Документ.БанковскаяВыписка"); 
	Иначе
	Док=СоздатьОбъект("Документ.ДвиженияДенежныхСредств");            
	КонецЕсли;

	Док.ВыбратьДокументы(ДатаОперации, ДатаОперации);
	Пока Док.ПолучитьДокумент()=1 Цикл
		Если (Док.РСчет=Счет) и (Док.РСчет.Валюта=Гривня) Тогда 
		Сообщить("Найден документ: "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+")", " ");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Док.Выбран()=0 Тогда
		Док.Новый();
		Док.ДатаДок=ДатаОперации; 
		Док.РСчет=Счет;
//******************************************************************************
	Если ТипКонфигурации = "ПУБ" Тогда
		СчУчета = Док.РСчет.СчетУчета;
		Док.СчетУчета = СчУчета;
		Док.Валюта = Гривня;
		Док.Фирма =Фирма;
		//Установим префикс номера
			ПрефиксНомера = "";
			Если Док.Фирма.Выбран() = 1 Тогда
			    ПрефиксНомера = СокрЛП(Док.Фирма.Префикс);
			КонецЕсли;
			ПрефиксНомера = ПрефиксНомера + "-";
		    Док.УстановитьНовыйНомер(ПрефиксНомера);
//******************************************************************************
	ИначеЕсли ТипКонфигурации = "КУК" Тогда
		Док.ТипУчета = 1;
		Док.ФинУчет = 1;
	    СчУчета = Док.РСчет.СчетУчета;
		Док.СчетУчета = СчУчета;
		Док.Валюта = Гривня;
		Док.Фирма = Фирма;

		//Установим префикс номера
			ПрефиксНомера = "";
			Если Док.Фирма.Выбран() = 1 Тогда
			    ПрефиксНомера = СокрЛП(Док.Фирма.Префикс);
			КонецЕсли;
			ПрефиксНомера = ПрефиксНомера + "-";
		    Док.УстановитьНовыйНомер(ПрефиксНомера);
//******************************************************************************
	ИначеЕсли ТипКонфигурации = "Торговля" Тогда
		Док.ТипУчета = 1;
		Док.ФинУчет = 1;
		Док.Валюта = Гривня;
			Док.Фирма = Фирма;
//******************************************************************************
	ИначеЕсли ТипКонфигурации = "Укр" Тогда
	    СчУчета = Док.РСчет.СчетУчета;
		Док.СчетУчета = СчУчета;
			Док.Фирма = Фирма;
		//Установим префикс номера
			Если (Метаданные.РазделительУчета.Выбран()=1) и (Сокрлп(Док.Фирма.ПрефиксНомера)<>"") Тогда
				Док.УстановитьНовыйНомер(Сокрлп(Док.Фирма.ПрефиксНомера)+"-");
			КонецЕсли;
			
    КонецЕсли;
//******************************************************************************
	
		Сообщить("Создан документ: "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+")", " ");
	Иначе
	Попытка
		Если      Док.ПометкаУдаления()=1 Тогда
			Док.СнятьПометкуУдаления();
		ИначеЕсли Док.Проведен()=1 Тогда
			Док.СделатьНеПроведенным();
		КонецЕсли;
		Док.Записать(); 
	Исключение
	КонецПопытки;
	КонецЕсли;

	Если  НашПП="Да" Тогда
	Клиент=Документ.Контрагент; 
		Если ТипКонфигурации="Укр" Тогда
		Заказ=Документ.Заказ;           
		Иначе   
			Если (ТипКонфигурации="КУК") и (Документ.Вид()="ПлатежноеТребованиеПоручение") Тогда
            Заказ=Документ.Заказ;
			Иначе
			Заказ=Документ.ДокументОснование;           
			КонецЕсли;
		КонецЕсли;
	Иначе
    Заказ="";
	Клиент=НайтиОрганизацию( Корреспондент, "Контрагенты");
	КонецЕсли;
	
	УжеЕсть=0;
	Док.ВыбратьСтроки();
	Пока Док.ПолучитьСтроку()=1 Цикл 
		Если (ТипКонфигурации="ПУБ") или (ТипКонфигурации="КУК") Тогда
			ВБклиент=Док.Субконто1;
			ВБзаказ=Док.ДокументОснование; 
			СуммаПлатежа=Док.СуммаПлатежа;
		ИначеЕсли (ТипКонфигурации="Укр") Тогда   
			ВБзаказ=Док.Заказ; 
			ВБклиент=Док.Субконто;
			СуммаПлатежа=Док.СуммаПлатежа;
		ИначеЕсли (ТипКонфигурации="Торговля") Тогда   
			ВБзаказ=Док.ДокументОснование;
			ВБклиент=Док.Контрагент;
			Если ПриходРасход = "Приход" Тогда
				СуммаПлатежа=Док.Приход;
			Иначе  
				СуммаПлатежа=Док.Расход;
			КонецЕсли;	
		КонецЕсли;	

	Если (СокрЛП(Строка(СуммаПлатежа))=СокрЛП(Строка(тВыписка.Сумма))) и
    (СокрЛП(Строка(ВБклиент))=СокрЛП(Строка(Клиент))) и
	(СокрЛП(Строка(ВБзаказ))=СокрЛП(Строка(Заказ)))	Тогда
		
   		Если СтатусПроведен="Нет" Тогда
		Док.УдалитьСтроку();
		Сообщить("По док. "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+")"+" в сртоке - "+Док.НомерСтроки+" соотв. платежнжный док. не имеет статус ПРОВЕДЕН. Строка будет удалена!", "!!");
		Иначе 
		УжеЕсть=1;	
		КонецЕсли;
	КонецЕсли;	
	Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
	   Если (СокрЛП(Строка(СуммаПлатежа))=СокрЛП(Строка(тВыписка.Сумма))) Тогда
	   	Если СтатусПроведен="Нет" Тогда
		Док.УдалитьСтроку();
		Сообщить("По док. "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+")"+" в сртоке - "+Док.НомерСтроки+" соотв. платежнжный док. не имеет статус ПРОВЕДЕН. Строка будет удалена!", "!!");
		Иначе 
		УжеЕсть=1;	
		КонецЕсли;
       КонецЕсли;	
	КонецЕсли;

	КонецЦикла;  
//Если  (УжеЕсть=0)  Тогда
Если  (УжеЕсть=0) и (СтатусПроведен="Да")  Тогда
		Док.НоваяСтрока();
	    Если НашПП="Да" Тогда
		Сообщить("В документ: "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+")"+" добавлена новая строка по док. "+Документ.Вид()+" "+Документ.НомерДок+" ("+Документ.ДатаДок+")", " ");
		Иначе     
		Сообщить("В документ: "+Док.Вид()+" "+Док.НомерДок+" ("+Док.ДатаДок+")"+" добавлена новая строка.", " ");
		КонецЕсли;
//=== Секция заполнения строки ВБ =====================
//=== Конфигурация Бух =====================
		Если ТипКонфигурации = "Укр" Тогда
			Если ПриходРасход = "Приход" Тогда
				Док.ПриходРасход = Перечисление.ПлюсМинус.Плюс;
				Док.НазначитьТип("ВидПриходаРасхода", "Перечисление.ВидыПриходаДенег");
				Док.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации;
				Док.ДоходИздержка = Перечисление.ПлюсМинусНичего.Плюс;
                Док.Счет=СчетДляПрихода;
			Иначе // Расход
				Док.ПриходРасход = Перечисление.ПлюсМинус.Минус;
				Док.НазначитьТип("ВидПриходаРасхода", "Перечисление.ВидыРасходаДенег");
				Док.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности;
				Док.ДоходИздержка = Перечисление.ПлюсМинусНичего.Минус;
                Док.Счет=СчетДляРасхода;
			КонецЕсли; 

			Док.НомерДокумента = тВыписка.Номер;
 			Если Клиент = "" Тогда
			Док.Субконто = 0;
			ИначеЕсли ТипЗначенияСтр(Клиент) = "Справочник" Тогда  
			Док.НазначитьТип("Субконто",ТипЗначенияСтр(Клиент));
			Док.Субконто = Клиент.ТекущийЭлемент();
			Иначе
			Док.НазначитьТип("Субконто",ТипЗначенияСтр(Клиент));
			Док.Субконто = Клиент;
			КонецЕсли;
			Док.НазначитьТип("Заказ","Документ");
			Если НашПП="Да" Тогда
			Док.ВидНДС = Документ.ВидНДС;
  			Док.СуммаСНДС = Документ.СуммаСНДС;
  			Док.НДС = Документ.НДС; 
  			Док.СуммаПлатежа = Документ.СуммаПлатежа; 
			Док.Заказ = Документ.Заказ;
  			Иначе                        
			Док.ВидНДС = Константа.БазНДС;
			Док.СуммаПлатежа = тВыписка.Сумма;
			Док.НДС = (тВыписка.Сумма)*Док.ВидНДС.Ставка.Получить(Док.ДатаДок)/(1+Док.ВидНДС.Ставка.Получить(Док.ДатаДок));
		    Док.СуммаСНДС = ?(Константа.ИспользоватьСпецСчетаПоНДС.Получить(Док.ДатаДок)=Перечисление.ДаНет.Нет,Док.СуммаПлатежа ,Док.СуммаПлатежа +Док.НДС );
			КонецЕсли;
			Док.УказанаОтгрузка = Перечисление.ДаНет.Нет;
			Док.ОперационнаяКР = Перечисление.ДаНет.Да;
			Док.Содержание = тВыписка.НазначениеПлатежа; 
		Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
		Док.Счет=СчетПоКоду("311",); 
		Док.НДС =0;    
		Док.ДоходИздержка = Перечисление.ПлюсМинусНичего.Ничего;
		Док.НазначитьТип("Заказ","Справочник.НашиДенежныеСчета");
		Док.СуммаПлатежа = тВыписка.Сумма;
		Док.СуммаСНДС = тВыписка.Сумма;   
		Док.Субконто= НайтиРасчетныйСчет("Получатель", "НашиДенежныеСчета");
		КонецЕсли;	
			
//=== Конфигурация ТИС =====================
		ИначеЕсли ТипКонфигурации = "Торговля" Тогда
			Если ПриходРасход = "Приход" Тогда
				Док.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление;
				Док.Приход = тВыписка.Сумма;
			Иначе // Расход
				Док.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание;
				Док.Расход = тВыписка.Сумма;
			КонецЕсли;
			Док.ВидОперации = Перечисление.ВидыОплаты.Оплата;
			Док.РежимОплаты = Перечисление.РежимыОплаты.КонкретныйДоговор;
	
			Если НашПП="Да" Тогда  
			Док.Договор = Документ.Договор;   
			Док.ДокументОснование = Документ.ДокументОснование;
			Док.СтавкаНДС = Документ.СтавкаНДС;  
			Иначе      
			Док.СтавкаНДС = Константа.ОсновнаяСтавкаНДС;  
			КонецЕсли;
			Док.Контрагент = Клиент.ТекущийЭлемент();
			Док.Содержание = тВыписка.НазначениеПлатежа; 
		Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
            Док.СтавкаНДС =Перечисление.ЗначенияНДС.безНДС;
			Док.ВидОперации = Перечисление.ВидыОплаты.Корректировка;
		КонецЕсли;	

//=== Конфигурация КУК =====================
		ИначеЕсли ТипКонфигурации = "КУК" Тогда
			Если ПриходРасход = "Приход" Тогда
				Док.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление;
				Док.НазначитьТип("ВидПриходаРасхода", "Перечисление.ВидыПриходаДенег");
				Док.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации;
                Док.Счет=СчетДляПрихода;
			Иначе // Расход
				Док.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание;
				Док.НазначитьТип("ВидПриходаРасхода", "Перечисление.ВидыРасходаДенег");
				Док.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности;
                Док.Счет=СчетДляРасхода;
			КонецЕсли;
			Док.НомерДокумента = тВыписка.Номер;
			Для инд = 1 По Док.Счет.КоличествоСубконто() Цикл
				Док.НазначитьТип("Субконто"+инд, Док.Счет.ВидСубконто(инд).ТипСубконто(),);
			КонецЦикла;

			Док.ВидОплаты = Перечисление.ВидыОплаты.Оплата;
			Док.УказанаОтгрузка = Перечисление.ДаНет.Нет;
			Док.ОперационнаяКР = Перечисление.ДаНет.Да;
			Док.Содержание = тВыписка.НазначениеПлатежа;
			Док.РежимОплаты = Перечисление.РежимыОплаты.КонкретныйДоговор;

			Если ПустоеЗначение(Клиент) = 1 Тогда
				Док.Субконто1 = 0;
			ИначеЕсли ТипЗначенияСтр(Клиент) = "Справочник" Тогда
				Док.НазначитьТип("Субконто1",ТипЗначенияСтр(Клиент));
				Док.Субконто1 = Клиент.ТекущийЭлемент();
			Иначе
				Док.НазначитьТип("Субконто1",ТипЗначенияСтр(Клиент));
				Док.Субконто1 = Клиент;
			КонецЕсли;

			Если НашПП="Да" Тогда
			Док.ВидНДС = Документ.ВидНДС;
  			Док.СуммаСНДС = Документ.СуммаСНДС;
  			Док.НДС = Документ.НДС; 
  			Док.СуммаПлатежа = Документ.СуммаПлатежа; 
			Док.Субконто2 = Документ.Заказ;
		//	Док.ДокументОснование = Документ.ДокументОснование;
			Участки = Константа.УчасткиУчета.Получить(ДатаОперации);
				Если (Участки = Перечисление.УчасткиУчета.БухгалтерияТорговля) или (Участки = Перечисление.УчасткиУчета.БухгалтерияТорговляРасчет) Тогда
					Если (ТипКонфигурации="КУК") и (Документ.Вид()="ПлатежноеТребованиеПоручение") Тогда
    		        Док.ДокументОснование=Документ.Заказ;
                    Иначе
					Док.ДокументОснование = Документ.ДокументОснование;
                    КонецЕсли;
				Иначе
					Док.ДокументЗаказ = ?(ТипЗначенияСтр(Док.Субконто2) = "Документ", Док.Субконто2, 0);
				КонецЕсли;                   
  			Иначе                        
			Док.ВидНДС = Константа.БазНДС;
			Док.СуммаПлатежа = тВыписка.Сумма;
			Док.НДС = (тВыписка.Сумма)*Док.ВидНДС.Ставка.Получить(Док.ДатаДок)/(1+Док.ВидНДС.Ставка.Получить(Док.ДатаДок));
		    Док.СуммаСНДС = ?(Константа.ИспользоватьСпецСчетаПоНДС.Получить(Док.ДатаДок)=Перечисление.ДаНет.Нет,Док.СуммаПлатежа ,Док.СуммаПлатежа +Док.НДС );

		КонецЕсли; 
		Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
		Док.Счет=СчетПоКоду("311",); 
		Док.НДС =0;    
		Док.НазначитьТип("Субконто1","Справочник.НашиДенежныеСчета");
		Док.СуммаПлатежа = тВыписка.Сумма;
		Док.СуммаСНДС = тВыписка.Сумма;   
		Док.Субконто1= НайтиРасчетныйСчет("Получатель", "НашиДенежныеСчета");
		КонецЕсли;	

//=== Конфигурация ПУБ =====================
		ИначеЕсли ТипКонфигурации = "ПУБ" Тогда
			Если ПриходРасход = "Приход" Тогда
				Док.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Поступление;
				Док.НазначитьТип("ВидПриходаРасхода", "Перечисление.ВидыПриходаДенег");
				Док.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации;
                Док.Счет=СчетДляПрихода;
			Иначе // Расход
				Док.ВидДвижения = Перечисление.ВидыДвиженийПоРасчетномуСчету.Списание;
				Док.НазначитьТип("ВидПриходаРасхода", "Перечисление.ВидыРасходаДенег");
				Док.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности;
                Док.Счет=СчетДляРасхода;
			КонецЕсли;
			Док.НомерДокумента = тВыписка.Номер;
			Для инд = 1 По Док.Счет.КоличествоСубконто() Цикл
				Док.НазначитьТип("Субконто"+инд, Док.Счет.ВидСубконто(инд).ТипСубконто(),);
			КонецЦикла;
			Док.ВидОплаты = Перечисление.ВидыОплаты.Оплата;
//			Док.УказанаОтгрузка = Перечисление.ДаНет.Нет;
			Док.ОперационнаяКР = Перечисление.ДаНет.Да;
			Док.Содержание = тВыписка.НазначениеПлатежа;
			Док.РежимОплаты = Перечисление.РежимыОплаты.ПоСчету;

			Если ПустоеЗначение(Клиент) = 1 Тогда
				Док.Субконто1 = 0;
			ИначеЕсли ТипЗначенияСтр(Клиент) = "Справочник" Тогда
				Док.НазначитьТип("Субконто1",ТипЗначенияСтр(Клиент));
				Док.Субконто1 = Клиент.ТекущийЭлемент();
			Иначе
				Док.НазначитьТип("Субконто1",ТипЗначенияСтр(Клиент));
				Док.Субконто1 = Клиент;
			КонецЕсли;
			Если НашПП="Да" Тогда
			Док.Счет= Документ.Счет;
			Док.ВидНДС = Документ.ВидНДС;
  			Док.СуммаСНДС = Документ.СуммаСНДС;
  			Док.НДС = Документ.НДС; 
  			Док.СуммаПлатежа = Документ.СуммаПлатежа; 
			Док.ДокументДоговор = Документ.Договор;
			Док.ДокументОснование = Документ.ДокументОснование;
			Док.Субконто2= Документ.Договор;
  			Иначе                        
			Док.ВидНДС = Константа.БазНДС;
			Док.СуммаПлатежа = тВыписка.Сумма;
			Док.НДС = (тВыписка.Сумма)*Док.ВидНДС.Ставка.Получить(Док.ДатаДок)/(1+Док.ВидНДС.Ставка.Получить(Док.ДатаДок));
		    Док.СуммаСНДС = ?(Константа.ИспользоватьСпецСчетаПоНДС.Получить(Док.ДатаДок)=Перечисление.ДаНет.Нет,Док.СуммаПлатежа ,Док.СуммаПлатежа +Док.НДС );
        	КонецЕсли;
			Док.ДокументДоговор = ?(ТипЗначенияСтр(Док.Субконто2) = "Документ", Док.Субконто2, 0);
		Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
		Док.Счет=СчетПоКоду("311",); 
		Док.НДС =0;    
		Док.НазначитьТип("Субконто1","Справочник.НашиДенежныеСчета");
		Док.СуммаПлатежа = тВыписка.Сумма;
		Док.СуммаСНДС = тВыписка.Сумма;   
		Док.Субконто1= НайтиРасчетныйСчет("Получатель", "НашиДенежныеСчета");
		КонецЕсли;	

		КонецЕсли;
//=== Конец секции заполнения строки ВБ =====================
	
ИначеЕсли (СтатусПроведен="Нет") Тогда
Сообщить("Документ "+Документ.Вид()+" "+Документ.НомерДок+" ("+Документ.ДатаДок+")"+" не имеет статус ПРОВЕДЕН . Строка выписки не добавлена!", "!!");
КонецЕсли;
	   Док.Записать();
       Сообщить("Записан документ: "+Док, " ");
	 БезОшибок = 1;
КонецПроцедуры // ОбработатьВыписку()
//******************************************************************************
//	ЗагрузитьПлатежныйДокумент()
//
//	Параметры:
//
//	Возвращаемое значение:
//
//	Описание:

Функция ЗагрузитьПлатежныйДокумент()
  	
ВидДокумента=Врег(СокрЛП(тВыписка.ВидДокумента));
Если ВидДокумента= "ПЛАТЕЖНОЕ ПОРУЧЕНИЕ" Тогда 
	ВидДокумента="ПлатежноеПоручение";
	Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(тВыписка.ПлательщикСчет))=1 Тогда
    НайтиОрганизацию("Получатель", "Контрагенты");
	ПлательщикСчет=НайтиРасчетныйСчет("Плательщик", "НашиДенежныеСчета");
	ПолучательСчет=НайтиРасчетныйСчет("Получатель", ?(ТипКонфигурации<>"Торговля","ДенежныеСчета","РасчетныеСчета"));         
	НашПП="Да";
	ИначеЕсли ЗагрРасчетныеСчета.Принадлежит(СокрЛП(тВыписка.ПолучательСчет))=1 Тогда
    НайтиОрганизацию("Плательщик", "Контрагенты");
	ПлательщикСчет=НайтиРасчетныйСчет("Плательщик", ?(ТипКонфигурации<>"Торговля","ДенежныеСчета","РасчетныеСчета"));
	ПолучательСчет=НайтиРасчетныйСчет("Получатель", "НашиДенежныеСчета");
    НашПП="Нет";
	Иначе 
	Сообщить("По документу - "+ВидДокумента+" №"+тВыписка.ДокументИД+" р/сч. Плательщика и Покупателя не входит в список загруженных счетов. Платежный документ не обрабатывается!","!"); 
    Возврат(ПолучитьПустоеЗначение("Документ"));
	КонецЕсли;
ИначеЕсли  ВидДокумента= "ПЛАТЕЖНОЕ ТРЕБОВАНИЕ-ПОРУЧЕНИЕ" Тогда
	ВидДокумента="ПлатежноеТребованиеПоручение";
	Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(тВыписка.ПолучательСчет))=1 Тогда
    НайтиОрганизацию("Плательщик", "Контрагенты");
	ПлательщикСчет=НайтиРасчетныйСчет("Плательщик", ?(ТипКонфигурации<>"Торговля","ДенежныеСчета","РасчетныеСчета"));
	ПолучательСчет=НайтиРасчетныйСчет("Получатель", "НашиДенежныеСчета");
	НашПП="Да";
	ИначеЕсли ЗагрРасчетныеСчета.Принадлежит(СокрЛП(тВыписка.ПлательщикСчет))=1 Тогда
    НайтиОрганизацию("Получатель", "Контрагенты");
	ПлательщикСчет=НайтиРасчетныйСчет("Плательщик", "НашиДенежныеСчета");
	ПолучательСчет=НайтиРасчетныйСчет("Получатель", ?(ТипКонфигурации<>"Торговля","ДенежныеСчета","РасчетныеСчета"));         
    НашПП="Нет";
	Иначе 
	Сообщить("По документу - "+ВидДокумента+" №"+тВыписка.ДокументИД+" р/сч. Плательщика и Покупателя не входит в список загруженных счетов. Платежный документ не обрабатывается!","!"); 
	Возврат(ПолучитьПустоеЗначение("Документ"));
	КонецЕсли;
КонецЕсли;	

	Если  (ПлательщикСчет.Выбран()=1) и (ВидДокумента="ПлатежноеПоручение")  Тогда
		Если НашПП="Да" Тогда
		РасчетныйСчет=ПлательщикСчет;
		Корреспондент="Получатель"; 
		Иначе
		РасчетныйСчет=ПолучательСчет;
		Корреспондент="Плательщик"; 
		КонецЕсли;
		ДатаВып=?(СокрЛП(тВыписка.ДатаСписано)="",ПолучитьДатуПоФСтроке(тВыписка.Дата),ПолучитьДатуПоФСтроке(тВыписка.ДатаСписано));
	ИначеЕсли (ПолучательСчет.Выбран()=1) и (ВидДокумента="ПлатежноеТребованиеПоручение")  Тогда
		Если НашПП="Да" Тогда
		РасчетныйСчет=ПолучательСчет;
		Корреспондент="Плательщик"; 
		Иначе
		РасчетныйСчет=ПлательщикСчет;
		Корреспондент="Получатель"; 
		КонецЕсли;
		ДатаВып=?(СокрЛП(тВыписка.ДатаПоступило)="",ПолучитьДатуПоФСтроке(тВыписка.Дата),ПолучитьДатуПоФСтроке(тВыписка.ДатаПоступило));
	Иначе
		Возврат(ПолучитьПустоеЗначение("Документ"));
	КонецЕсли;

Если НашПП="Да" Тогда	
	Объект=СоздатьОбъект("Документ."+ВидДокумента);
	Если Объект.НайтиПоНомеру(тВыписка.ДокументИД, ПолучитьДатуПоФСтроке(тВыписка.Дата))=0 Тогда
	Сообщить("Платежный документ " +ВидДокумента+" "+тВыписка.ДокументИД+" от "+ПолучитьДатуПоФСтроке(тВыписка.Дата)+ " не найден. Создается новый!","!");
	Объект.Новый();
	Объект.Контрагент=НайтиОрганизацию(Корреспондент, "Контрагенты");
		Если (ТипКонфигурации <> "Торговля") Тогда
			
		Если ((ПустоеЗначение(тВыписка.КодВалюты)=1) ИЛИ (тВыписка.КодВалюты = "980")) Тогда
		Объект.Счет=?(ВидДокумента="ПлатежноеПоручение",СчетДляРасхода,		СчетДляПрихода);
		Иначе                                                             	
		Объект.Счет=?(ВидДокумента="ПлатежноеПоручение",СчетДляРасходаВал,	СчетДляПриходаВал);
		КонецЕсли;
		
		Если СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО) Тогда
		Объект.Счет=СчетПоКоду("311",);
		КонецЕсли;	
		Объект.ВидНДС=Константа.БазНДС;
			Если (ТипКонфигурации <> "ПУБ") Тогда
				Если (Объект.Контрагент.ВидВзаиморасчетов = Перечисление.ВидыВзаиморасчетов.ПоДоговорам)  Тогда
				Объект.Заказ = Объект.Контрагент.БазДоговор;
			    КонецЕсли;
			КонецЕсли;
		Иначе
		Объект.СтавкаНДС=Константа.ОсновнаяСтавкаНДС;
		КонецЕсли;
		Если ВидДокумента="ПлатежноеПоручение" Тогда
		Объект.Номер=Число(СокрЛП(тВыписка.Номер));
		КонецЕсли;
		Объект.Фирма=Фирма;
		Объект.НомерДок=тВыписка.ДокументИД;
 	ИначеЕсли ТипКонфигурации<>"Торговля" Тогда
        Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(Объект.РСчет.НомерСчета))=1 Тогда
			СнятьПометкуУдаления(Объект); 
		Иначе 
			Сообщить("Р/счет= "+СокрЛП(Объект.РСчет.НомерСчета)+" док. " +ВидДокумента+" "+тВыписка.ДокументИД+" от "+ПолучитьДатуПоФСтроке(тВыписка.Дата)+ " не найден в списке загружаемых р/с. Не обрабатывается!","!");
    		Возврат 0;
		КонецЕсли; 
 	ИначеЕсли ТипКонфигурации="Торговля" Тогда
        Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(Объект.РСчет.БанкСчет))=1 Тогда
			СнятьПометкуУдаления(Объект); 
		Иначе 
			Сообщить("Р/счет= "+СокрЛП(Объект.РСчет.БанкСчет)+" док. " +ВидДокумента+" "+тВыписка.ДокументИД+" от "+ПолучитьДатуПоФСтроке(тВыписка.Дата)+ " не найден в списке загружаемых р/с. Не обрабатывается!","!");
   			 Возврат 0;
		КонецЕсли; 
	КонецЕсли;

	Замены=0;
	// дата документа
	Замены=Замены+ИзменитьАтрибут(Объект, "ДатаДок", ПолучитьДатуПоФСтроке(тВыписка.Дата));
    Объект.ДатаДок=ПолучитьДатуПоФСтроке(тВыписка.Дата);
	// банковский счет
	Замены=Замены+ИзменитьАтрибут(Объект, "РСчет", РасчетныйСчет);
                    
    Если (((ТипКонфигурации = "КУК") ИЛИ (ТипКонфигурации = "ПУБ") ИЛИ (ТипКонфигурации = "Торговля")) И (ВидДокумента="ПлатежноеПоручение")) Тогда
		Объект.Валюта = Объект.РСчет.Валюта;
	КонецЕсли;
    Если (((ТипКонфигурации = "КУК") ИЛИ (ТипКонфигурации = "ПУБ") ИЛИ (ТипКонфигурации = "Торговля")) И (ВидДокумента="ПлатежноеПоручение")) Тогда
    	Объект.АвтоПодстСуммыНДС = Перечисление.ПодстановкаСуммыНДС.СуммаНДС;
	КонецЕсли;
	
	// сумма документа
	Замены=Замены+ИзменитьАтрибут(Объект, ?(ТипКонфигурации<>"Торговля","СуммаПлатежа","СуммаСНДС"), тВыписка.Сумма);
    Если ТипКонфигурации<>"Торговля" Тогда
	    Объект.СуммаПлатежа=тВыписка.Сумма;  
		Если Константа.ИспользоватьСпецСчетаПоНДС.Получить(ПолучитьДатуПоФСтроке(тВыписка.Дата)) = Перечисление.ДаНет.Нет Тогда
		Объект.СуммаСНДС = Объект.СуммаПлатежа;
		Объект.НДС = Объект.СуммаСНДС*Объект.ВидНДС.Ставка.Получить(ПолучитьДатуПоФСтроке(тВыписка.Дата))/(1+Объект.ВидНДС.Ставка.Получить(ПолучитьДатуПоФСтроке(тВыписка.Дата)));
		Иначе 
		Объект.НДС = Объект.СуммаПлатежа*Объект.ВидНДС.Ставка.Получить(ПолучитьДатуПоФСтроке(тВыписка.Дата));
		Объект.СуммаСНДС = Объект.СуммаПлатежа+Объект.НДС;
		КонецЕсли;	
	Иначе   
		Если (Объект.СтавкаНДС=Перечисление.ЗначенияНДС.ОсновнаяСтавкаНДС) и
		(СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))  Тогда
			ПроцНДС=20;
		ИначеЕсли (Объект.СтавкаНДС=Перечисление.ЗначенияНДС.СтавкаНДС7) и
		(СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))  Тогда
			ПроцНДС=7;
		Иначе
			ПроцНДС=0;
		КонецЕсли; 
		НДС = Объект.СуммаСНДС*ПроцНДС/(100+ПроцНДС);
	КонецЕсли;
	
	// контрагент и его расчетный счет
	Объект.Контрагент=НайтиОрганизацию(Корреспондент, "Контрагенты");
	Замены=Замены+ИзменитьАтрибут(Объект, "Контрагент", НайтиОрганизацию(Корреспондент, "Контрагенты"));

	Замены=Замены+ИзменитьАтрибут(Объект, ?(ТипКонфигурации<>"Торговля","РСчетКонтрагента","СчетКонтрагента"), НайтиРасчетныйСчет(Корреспондент, ?(ТипКонфигурации<>"Торговля","ДенежныеСчета","РасчетныеСчета"),Объект.Контрагент));
    Если ТипКонфигурации<>"Торговля" Тогда
	Объект.РСчетКонтрагента=НайтиРасчетныйСчет(Корреспондент, ?(ТипКонфигурации<>"Торговля","ДенежныеСчета","РасчетныеСчета"),Объект.Контрагент);
    КонецЕсли;
	// строка содержания
	Замены=Замены+ИзменитьАтрибут(Объект, "Содержание", тВыписка.НазначениеПлатежа);
	Объект.Содержание=СокрЛП(тВыписка.НазначениеПлатежа);

	// срок акцепта
	
	ЗаписатьДокумент(Объект);
	Проведен="Нет";
	Если (Врег(СокрЛП(тВыписка.СтатусДокумента))="ПРОВЕДЕН") Тогда
	Проведен="Да";
	Объект.Провести(); 
	ИначеЕсли (Врег(СокрЛП(тВыписка.СтатусДокумента))="ОТВЕРГНУТ") Тогда
	Проведен="Нет";
	Сообщить("Статус документа -"+ВидДокумента+" №"+тВыписка.ДокументИД+" = "+Врег(СокрЛП(тВыписка.СтатусДокумента))+". Документ будет помечен на удаление!","!" ); 	
	Объект.Удалить(0); 
	Иначе
	Сообщить("Статус документа -"+ВидДокумента+" №"+тВыписка.ДокументИД+" = "+?(Врег(СокрЛП(тВыписка.СтатусДокумента))="В ОЖИДАНИИ",Врег(СокрЛП(тВыписка.СтатусДокумента)),"Не определен")+". Документ записан без проведения!","!" ); 	
	КонецЕсли;
КонецЕсли;

Если (ВидДокумента= "ПлатежноеПоручение") и (НашПП="Да") Тогда
ПриходРасход = "Расход"; 
ИначеЕсли (ВидДокумента= "ПлатежноеПоручение") и (НашПП="Нет") Тогда
ПриходРасход = "Приход";
Проведен="Да";
ИначеЕсли  (ВидДокумента= "ПлатежноеТребованиеПоручение") и (НашПП="Да") Тогда 
ПриходРасход = "Приход"; 
ИначеЕсли  (ВидДокумента= "ПлатежноеТребованиеПоручение") и (НашПП="Нет") Тогда 
ПриходРасход = "Расход"; 
Проведен="Да";
КонецЕсли;  

Если ТипКонфигурации<>"Торговля"  Тогда
ОбработатьВыписку(Объект, РасчетныйСчет, ДатаВып, ПриходРасход, Проведен, НашПП, Корреспондент);			
ИначеЕсли (ТипКонфигурации="Торговля") и (СокрЛП(тВыписка.ПлательщикОКПО)<>СокрЛП(тВыписка.ПолучательОКПО))  Тогда
ОбработатьВыписку(Объект, РасчетныйСчет, ДатаВып, ПриходРасход, Проведен, НашПП, Корреспондент);			
ИначеЕсли (ТипКонфигурации="Торговля") и (СокрЛП(тВыписка.ПлательщикОКПО)=СокрЛП(тВыписка.ПолучательОКПО))  Тогда	
ОбработатьВыписку(Объект, РасчетныйСчет, ДатаВып, ПриходРасход, Проведен, НашПП, Корреспондент);			
ОбработатьВыписку(0,НайтиРасчетныйСчет("Получатель", "НашиДенежныеСчета",Объект.Контрагент), ДатаВып, "Приход", "Да", "Нет", "Плательщик");			

КонецЕсли;  

Если НашПП="Да" Тогда
Возврат(Объект.ТекущийДокумент()); 
Иначе Возврат(0); КонецЕсли;

КонецФункции // ЗагрузитьПлатежныйДокумент()


//******************************************************************************
//	УдалитьДокумент(Объект)
//
//	Параметры:
//
//	Описание:

Процедура УдалитьДокумент(Объект)
	
	Попытка
		Если Объект.ПометкаУдаления()=0 Тогда
			Объект.Удалить(0);
			Сообщить("Помечен на удаление документ: "+Объект, " ");
		КонецЕсли;
	
	Исключение
		Сообщить("Неудачная попытка удаления документа: "+Объект+": "+ОписаниеОшибки(), "!!!");
	КонецПопытки;
	
КонецПроцедуры // УдалитьДокумент()
//******************************************************************************
//	СделатьНеПроведенным(Объект)
//
//	Параметры:
//
//	Описание:

Процедура СделатьНеПроведенным(Объект)
	
	Объект=СоздатьОбъект("Документ."+Объект);
	Объект.ВыбратьДокументы(ДатаНачалаЗаг, ДатаКонцаЗаг);
	Пока Объект.ПолучитьДокумент()=1 Цикл
        Если ТипКонфигурации<>"Торговля" Тогда
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(Объект.РСчет.НомерСчета))=1 Тогда
			//Объект.СделатьНеПроведенным(); 
			УдалитьДокумент(Объект);
		    КонецЕсли;
		Иначе
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(Объект.РСчет.БанкСчет))=1 Тогда
				//Объект.СделатьНеПроведенным(); 
			УдалитьДокумент(Объект);
			КонецЕсли;	
        КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры // СделатьНеПроведенным()


//******************************************************************************
//	УдалитьСтроки(Объект)
//
//	Параметры:
//
//	Описание:

Процедура УдалитьСтроки(Объект)
	
	Объект=СоздатьОбъект("Документ."+Объект);
	Объект.ВыбратьДокументы(ДатаНачалаЗаг, ДатаКонцаЗаг);
	Пока Объект.ПолучитьДокумент()=1 Цикл
        Если ТипКонфигурации<>"Торговля" Тогда
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(Объект.РСчет.НомерСчета))=1 Тогда
		    Объект.СделатьНеПроведенным(); 
			  Объект.УдалитьСтроки(); 
			  Объект.Записать();
		    КонецЕсли;
		Иначе
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(Объект.РСчет.БанкСчет))=1 Тогда
			Объект.СделатьНеПроведенным(); 
			Объект.УдалитьСтроки();
			Объект.Записать();
			КонецЕсли;	
        КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры // УдалитьСтроки()


//******************************************************************************
//	ЗагрузитьТаблицуДокументов()
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьТаблицуДокументов()
Сообщить("________________________________________________________________________________");
Сообщить("ЗАГРУЗКА ТАБЛИЦЫ ДАННЫХ ИЗ ВНЕШНЕГО ФАЙЛА УСПЕШНО ЗАВЕРШЕНА!");             
Сообщить("Все платежные документы за период с "+ДатаНачалаЗаг+" по "+ДатаКонцаЗаг+" будут сделаны непроведенными и заполнены согласно импортируемых данных!","I");
	Для Инд = 1 По спВидыДок.РазмерСписка() Цикл
		Если спВидыДок.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли; 
		ВидДокСтр="";
		ВидДок = спВидыДок.ПолучитьЗначение(Инд,ВидДокСтр); 
		СделатьНеПроведенным(ВидДок);
	КонецЦикла;
    
	Если  фСоздавать=1 Тогда
	Если Вопрос("Установлен признак 'Перед заполнением удалить строки'. Удалить строки перед заполнением Банковских выписок?","Да+Нет") = "Нет" Тогда
	Иначе
			Сообщить("Табличные части всех Банковских выписок за период с "+ДатаНачалаЗаг+" по "+ДатаКонцаЗаг+" будут очищены и заполнены согласно импортируемых данных!","!");
			Если ТипКонфигурации<>"Торговля" Тогда
			УдалитьСтроки("БанковскаяВыписка");   
			Иначе 
			УдалитьСтроки("ДвиженияДенежныхСредств");
			КонецЕсли;
	КонецЕсли;
	КонецЕсли;
 //   Сообщить("Все Выписки банка за период с "+ДатаНачалаЗаг+" по "+ДатаКонцаЗаг+" будут сделаны непроведенными и заполнены согласно импортируемых данных!");
//	СделатьНеПроведенным("БанковскаяВыписка");
	ЗагрДокументы.УдалитьВсе();
	
	тВыписка.ВыбратьСтроки();
	Пока тВыписка.ПолучитьСтроку()=1 Цикл  
Сообщить("________________________________________________________________________________");
Сообщить("ОБРАБОТКА ТАБЛИЦЫ ДАННЫХ: всего строк - "+тВыписка.КоличествоСтрок()+", обрабатывается строка №"+тВыписка.НомерСтроки+" ("+" док. " +СокрЛП(тВыписка.ВидДокумента)+" "+СокрЛП(тВыписка.ДокументИД)+" от "+ПолучитьДатуПоФСтроке(тВыписка.Дата)+" ).","I");

		тВыписка.НазначениеПлатежа=СтрЗаменить(тВыписка.НазначениеПлатежа, "?", "і");
        Документ=ЗагрузитьПлатежныйДокумент();
			Если ПустоеЗначение(Документ)=1 Тогда
				Продолжить;
			КонецЕсли;
		
	//	Если 0=ЗагрДокументы.НайтиЗначение(Документ) Тогда
	//		ЗагрДокументы.ДобавитьЗначение(Документ);
	//	КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ЗагрузитьТаблицуДокументов()


//******************************************************************************
//	ОшибкаЗагрузкиТекста(Ном, СтрТекста, СтрОшибки)
//
//	Параметры:
//
//	Описание:

Процедура ОшибкаЗагрузкиТекста(Ном, СтрТекста, СтрОшибки)
	
	Стр="Ошибка: ";
	Если 0<Ном Тогда Стр=Стр+"строка "+Ном+", "; КонецЕсли;
	Если ПустаяСтрока(СтрТекста)=0 Тогда Стр=Стр+""""+СтрТекста+""", "; КонецЕсли;
	
	Сообщить(Стр+СтрОшибки, "!!");
	
КонецПроцедуры // ОшибкаЗагрузкиТекста()

