// ***********************************************


// --------- управление видимостью и доступностью

// ===============================   
// Функция УстДоступность()
// 		управляет видимостью и доступностью реквизитов диалога
// ===============================   
Функция УстДоступность()
	// -------------- все слои
	// кнопка "Назад"
	Дост = ?((ТекущийСлой="Начало") Или (ТекущийСлой="Конец"),0,1);
	Форма.кНазад.Доступность(Дост);
	// кнопка "Вперед"
	Дост = ?(ТекущийСлой="Ошибка",0,1);
	Форма.кВперед.Доступность(Дост);
	Если ТекущийСлой="Конец" Тогда
		Заголовок = "В начало";
	ИначеЕсли ТекущийСлой="ЭкспортШаг2" Тогда
		Заголовок = "Экспорт";
	Иначе
		Заголовок = "Далее";
	КонецЕсли;
	Форма.кВперед.Заголовок("&"+Заголовок+" >");
	// кнопка "Отмена"
	Если ТекущийСлой="Конец" Тогда
		Заголовок = "Готово"
	Иначе
		Заголовок = "Отмена"
	КонецЕсли;
	Форма.кОтмена.Заголовок("&"+Заголовок);
	
	// -------------- по слоям
	Если ТекущийСлой = "Начало" Тогда  
		Если ТипКонфигурации <> "Торговля" Тогда
		Форма.тФирма.Видимость(ЕстьРазделительУчета);
		Форма. Фирма.Видимость(ЕстьРазделительУчета);
		КонецЕсли;

	ИначеЕсли ТекущийСлой = "Шаг1" Тогда
		Дост = ?(спРСчета.РазмерСписка()<2,0,1);
	    Форма.кПомВсеРСчета.Доступность(Дост);
	    Форма.кСняВсеРСчета.Доступность(Дост);
	    Форма.кИнвВсеРСчета.Доступность(Дост);
		Дост = ?(спВидыДок.РазмерСписка()<2,0,1);
	    Форма.кПомВсеВидыДок.Доступность(Дост);
	    Форма.кСняВсеВидыДок.Доступность(Дост);
	    Форма.кИнвВсеВидыДок.Доступность(Дост);
	КонецЕсли;
КонецФункции //УстДоступность      


// --------- выдача сообщений,зависимых от контекста

// ===============================   
// Функция ПодсказкаДляПользователя()
// 		формирует подсказку о порядке нажатия кнопок
// ===============================   
Функция ПодсказкаДляПользователя()
	Если ТекущийСлой = "Начало" Тогда                    
		НазвКнопки = "Далее";
	ИначеЕсли ТекущийСлой = "Шаг1" Тогда 
		НазвКнопки = "Далее";
	ИначеЕсли ТекущийСлой = "ЭкспортШаг2" Тогда 
		НазвКнопки = "Экспорт";
	ИначеЕсли ТекущийСлой = "ИмпортШаг2" Тогда 
		НазвКнопки = "Далее";
	ИначеЕсли ТекущийСлой = "ИмпортШаг3" Тогда 
		НазвКнопки = "Далее";
	ИначеЕсли ТекущийСлой = "ИмпортШаг4" Тогда 
		НазвКнопки = "Далее";

	ИначеЕсли ТекущийСлой = "Ошибка" Тогда 
		НазвКнопки = "Отмена";
	ИначеЕсли ТекущийСлой = "Конец" Тогда 
		НазвКнопки = "Готово";
	КонецЕсли;
	Возврат "Для продолжения нажмите кнопку """ + НазвКнопки + """";
КонецФункции //ПодсказкаДляПользователя

// ===============================   
// Функция ИнформацияДляПользователя()
// 		формирует информацию о текущих дейсвиях на форме
// ===============================   
Функция ИнформацияДляПользователя()
	Если ТекущийСлой = "Начало" Тогда   
		Возврат "Выбор режима обработки";
	ИначеЕсли ТекущийСлой = "Шаг1" Тогда 
		Возврат "Укажите виды документов и расчетные счета, по которым предстоит выполнить " + ТипОперацииСтр + " информации";
	ИначеЕсли ТекущийСлой = "ЭкспортШаг2" Тогда 
		Возврат "Укажите интервал выгрузки платежных документов, размещение файла выгрузки, его кодировку и пр.";
	ИначеЕсли ТекущийСлой = "ИмпортШаг2" Тогда 
		Возврат "Укажите парамеры импорта";
	ИначеЕсли ТекущийСлой = "ИмпортШаг3" Тогда 
		Возврат "Укажите парамеры импорта";
	ИначеЕсли ТекущийСлой = "ИмпортШаг4" Тогда 
		Возврат "Нажмите кнопку Импорт и загрузите данные из внешнего файла.";

	ИначеЕсли ТекущийСлой = "Ошибка" Тогда 
		Возврат "Обработка окончена";
	ИначеЕсли ТекущийСлой = "Конец" Тогда 
		Возврат "Обработка окончена";
	КонецЕсли;
КонецФункции //ИнформацияДляПользователя


// --------- обработка нажатий на кнопки

// ===============================   
// Процедура ГрупповаяПометка(Режим,Список)
// 		управляет пометкой всех элементов списка Список
// 		Режим: 	1 - установить, 
//				2 - убрать, 
//				3 - инвертировать
// ===============================   
Процедура ГрупповаяПометка(Режим,ТабСпис)
	НомерСтроки = 1;
	Если ТипЗначенияСтр(ТабСпис) = "ТаблицаЗначений" Тогда
		ТабСпис.ВыбратьСтроки();
		
		Пока ТабСпис.ПолучитьСтроку()>0 Цикл
			Если Режим=1 Тогда //пометка
				ТабСпис.фВкл = 2;
				
			ИначеЕсли Режим=2 Тогда //убрать пометку
				ТабСпис.фВкл = 1;
				
			ИначеЕсли Режим=3 Тогда //инвертировать
				Если ТабСпис.фВкл=1 Тогда
					ТабСпис.фВкл = 2;
				Иначе
					ТабСпис.фВкл = 1;
				КонецЕсли;                           
			КонецЕсли;
			
		КонецЦикла;
	ИначеЕсли  ТипЗначенияСтр(ТабСпис) = "СписокЗначений" Тогда
		Для Ном = 1 По ТабСпис.РазмерСписка() Цикл
			Если Режим=1 Тогда //пометка
				ТабСпис.Пометка(Ном,1);
				
			ИначеЕсли Режим=2 Тогда //убрать пометку
				ТабСпис.Пометка(Ном,0);
				
			ИначеЕсли Режим=3 Тогда //инвертировать
				Если ТабСпис.Пометка(Ном) = 0 Тогда
					ТабСпис.Пометка(Ном,1);
				Иначе
					ТабСпис.Пометка(Ном,0);
				КонецЕсли;                           
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Форма.Обновить();
КонецПроцедуры //ГрупповаяПометка 

// ===============================   
// Процедура ИзмТипФормата()
// 		формирует название формата
// ===============================   
Процедура ИзмТипФормата()
	ТипФайлаСтр = ?(ТипФормата = 1,"TXT","XML");
	ПутьФайлаОбмена=КаталогПользователя()+?(ТипФормата = 1,"1c_to_kb.","1c_to_cb.")+?(ТипФормата = 1,"TXT","XML");
	Если ТекущийСлой = "ЭкспортШаг2" Тогда 
    Форма.ТипКодировки.Доступность(?(ТипФормата = 1,1,0));
    Форма.ТипКодировкиДос.Доступность(?(ТипФормата = 1,1,0));
	КонецЕсли;
КонецПроцедуры //ИзмТипФормата 

Процедура ИзмТипФорматаИмп() 
	ТипФайлаСтр = ?(ТипФорматаИмп = 1,"TXT","XML"); 
	ПутьФайлаИмпорта=КаталогПользователя()+?(ТипФорматаИмп = 1,"kb_to_1c.","cb_to_1c.")+?(ТипФорматаИмп = 1,"TXT","XML");
	Если ТекущийСлой = "ИмпортШаг2" Тогда  
   	
	Форма.ТипКодировкиИмп.Доступность(?(ТипФорматаИмп = 1,1,0));
    Форма.ТипКодировкиИмпДос.Доступность(?(ТипФорматаИмп = 1,1,0));
	КонецЕсли;	
КонецПроцедуры

// ===============================   
// Процедура Вперед()
// 		обрабатывает нажатие на кнопку "Далее"
// ===============================   
Процедура Вперед()
	Если ПроверитьРеквизиты() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ТекущийСлой = "Начало" Тогда   
		ТекущийСлой = "Шаг1";
		Форма.ИспользоватьСлой("Основной,Шаг1,Картинка"+ТипОперацииСтр,2); 
		//ЗаполнитьСписокРСчетов();
		Если ТипОперацииСтр = "импорт" Тогда  
			ЗаполнитьСписокРСчетов(0);
		Иначе
			ЗаполнитьСписокРСчетов(1);
		КонецЕсли;
		//ВосстановитьЗначенияФорматов(); //SPO: может и не нужна вовсе, надо проверить
	ИначеЕсли ТекущийСлой = "Шаг1" Тогда // импорт
		//СохранитьЗначенияФорматов(); //SPO: может и не нужна вовсе, надо проверить
		Если ТипОперацииСтр = "импорт" Тогда  
			ТекущийСлой = "ИмпортШаг2"; 
			Форма.ИспользоватьСлой("Основной,ИмпортШаг2,КартинкаИмпорт",2);
		    ИзмТипФорматаИмп();
		Иначе
			ТекущийСлой = "ЭкспортШаг2";
			Форма.ИспользоватьСлой("Основной,ЭкспортШаг2,КартинкаЭкспорт",2); 
            ИзмТипФормата();
		КонецЕсли;
	ИначеЕсли ТекущийСлой = "ЭкспортШаг2" Тогда 
		Если Вопрос("Осуществить экспорт платежных документов?","Да+Нет") = "Нет" Тогда
			Возврат;
		КонецЕсли;
		Если ТипФайлаСтр = "TXT" Тогда
			БезОшибок = Экспорт_Файла_TXT();
		Иначе
			БезОшибок = Экспорт_Файла_XML(); // SPO это заглушка, реальное значение определиться при экспорте
		КонецЕсли;
		Если БезОшибок = 1 Тогда
			ТекущийСлой = "Конец";
			Форма.ИспользоватьСлой("Основной,Конец,Картинка",2);
		Иначе
			ТекущийСлой = "Ошибка";
			Форма.ИспользоватьСлой("Основной,Ошибка,КартинкаЭкспорт",2);
		КонецЕсли;
	ИначеЕсли ТекущийСлой = "ИмпортШаг2" Тогда 
		///*Если ТипФайлаСтр = "TXT" Тогда 
			Если ФС.СуществуетФайл(ПутьФайлаИмпорта)=1 Тогда	
				БезОшибок = 0;
				ТекущийСлой = "ИмпортШаг3";
				Форма.ИспользоватьСлой("Основной,ИмпортШаг3,КартинкаИмпорт",2);
			Иначе 
				Сообщить("Указанный файл не существует! Укажите файл и повторите попытку.","!");
				БезОшибок = 0;
				ТекущийСлой = "ИмпортШаг2"; 
				ИзмТипФорматаИмп();
				Форма.ИспользоватьСлой("Основной,ИмпортШаг2,КартинкаИмпорт",2);
			КонецЕсли; 

		///*Иначе 
			///*Сообщить("Импорт в xml-формате на данный момент не реализован. ","!");
			///*БезОшибок = 0;
			///*ТекущийСлой = "Ошибка";
			///*Форма.ИспользоватьСлой("Основной,Ошибка,КартинкаИмпорт",2);
		///*КонецЕсли;
    		//		БезОшибок = 0; // SPO это заглушка, реальное значение определиться при экспорте


	ИначеЕсли  ТекущийСлой  = "ИмпортШаг3" Тогда
		тВыписка.УдалитьСтроки();	
		Форма.ИспользоватьСлой("Основной,ИмпортШаг4",2); 
		ТекущийСлой = "ИмпортШаг4";
		Создан = 0;
		
	ИначеЕсли ТекущийСлой  = "ИмпортШаг4" Тогда
		Если тВыписка.КоличествоСтрок()=0 Тогда
		Сообщить("Список загружаемых платежных документов пуст!","!!!");
		БезОшибок = 0;
		КонецЕсли;
		Если БезОшибок = 1 Тогда
			ТекущийСлой = "Конец";
			Форма.ИспользоватьСлой("Основной,Конец,Картинка",2);
		Иначе
			ТекущийСлой = "Ошибка";
			Форма.ИспользоватьСлой("Основной,Ошибка,КартинкаИмпорт",2);
		КонецЕсли;
	ИначеЕсли ТекущийСлой = "Конец" Тогда 
		ТекущийСлой = "Начало";
		Форма.ИспользоватьСлой("Основной,Начало,Картинка",2);
	КонецЕсли;
КонецПроцедуры //Вперед 

// ===============================
// Процедура Назад()
//		обрабатывает нажатие на кнопку "Назад"
// ===============================
Процедура Назад() 
	Если ТекущийСлой  = "Шаг1" Тогда
		//СохранитьЗначенияФорматов(); //SPO: может и не нужна вовсе, надо проверить
		ТекущийСлой = "Начало"; 
		Форма.ИспользоватьСлой("Основной,Начало,Картинка",2);
	ИначеЕсли ТекущийСлой  = "ЭкспортШаг2" Тогда   
		ТекущийСлой = "Шаг1"; 
		Форма.ИспользоватьСлой("Основной,Шаг1,КартинкаЭкспорт",2); 
	ИначеЕсли ТекущийСлой  = "ЭкспортШаг3" Тогда   
		ТекущийСлой = "Шаг2"; 
		Форма.ИспользоватьСлой("Основной,Шаг1,КартинкаЭкспорт",2); 
	ИначеЕсли ТекущийСлой  = "ЭкспортШаг4" Тогда   
		ТекущийСлой = "Шаг3"; 
		Форма.ИспользоватьСлой("Основной,Шаг1,КартинкаЭкспорт",2); 
		
	ИначеЕсли ТекущийСлой  = "ИмпортШаг2" Тогда   
		ТекущийСлой = "Шаг1"; 
		Форма.ИспользоватьСлой("Основной,Шаг1,КартинкаИмпорт",2); 
	ИначеЕсли (ТекущийСлой  = "Конец") и (ТипОперации = 1) Тогда 
		Форма.ИспользоватьСлой("Основной,Шаг1",2);
		ТекущийСлой = "Шаг1";
		Создан=0;
		Форма.Вперед.Доступность(1);
	ИначеЕсли ТекущийСлой  = "ИмпортШаг4" Тогда  
		Форма.ИспользоватьСлой("Основной,ИмпортШаг3,КартинкаИмпорт",2); 
		ТекущийСлой = "ИмпортШаг3";	
	ИначеЕсли ТекущийСлой  = "ИмпортШаг3" Тогда  
		Форма.ИспользоватьСлой("Основной,ИмпортШаг2,КартинкаИмпорт",2); 
		ТекущийСлой = "ИмпортШаг2"; 
//*		Если ТипКонфигурации = "Торговля" Тогда
//*		    Назад();
//*		КонецЕсли;	
		ИзмТипФорматаИмп();
		
	ИначеЕсли ТекущийСлой  = "Конец" Тогда 
//*		Если ТипОперацииСтр = "импорт" Тогда
//*			ТекущийСлой = "ИмпортШаг2"; 
//*			Форма.ИспользоватьСлой("Основной,ИмпортШаг2,КартинкаИмпорт",2); 
//*			Иначе
//*//*			ТекущийСлой = "ЭкспортШаг2"; 
//*//*			Форма.ИспользоватьСлой("Основной,ЭкспортШаг2,КартинкаИмпорт",2); 
//*		КонецЕсли;   
		Форма.ИспользоватьСлой("Основной,Шаг1",2);
		ТекущийСлой = "Шаг1";
		Создан=0;
		Форма.Вперед.Доступность(1);
		
	ИначеЕсли ТекущийСлой  = "Ошибка" Тогда 
//*		Если ТипОперацииСтр = "импорт" Тогда
//*			ТекущийСлой = "ИмпортШаг4"; 
//*			Форма.ИспользоватьСлой("Основной,ИмпортШаг4,КартинкаИмпорт",2); 
//*		Иначе
//*			ТекущийСлой = "ЭкспортШаг2"; 
//*			Форма.ИспользоватьСлой("Основной,ЭкспортШаг2,КартинкаИмпорт",2); 
//*		КонецЕсли;

		Форма.ИспользоватьСлой("Основной,Шаг1,Картинка",2);
		ТекущийСлой = "Шаг1";
		Создан=0;
	КонецЕсли;
КонецПроцедуры //Назад 

