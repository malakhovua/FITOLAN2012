КонецПроцедуры //ПриНачалеВыбораЗначения

//===============================
Процедура Просмотр()   
   Если	(ТипФормата <> 1) и (ТипОперации <> 1) Тогда
        ЗапуститьПриложение("notepad.exe """+ПутьФайлаОбмена+"""");
	ИначеЕсли  (ТипФорматаИмп <> 1) и (ТипОперации = 1) Тогда  
        ЗапуститьПриложение("notepad.exe """+ПутьФайлаИмпорта+"""");
	Иначе
	Если ТипОперации=1 Тогда
		Текст=ТекстФайла(ПутьФайлаИмпорта);
		Иначе	
		Текст=ТекстФайла(ПутьФайлаОбмена);
		КонецЕсли;
			Если ТипЗначенияСтр(Текст)="Текст" Тогда 
				Если ТипОперации=1 Тогда 
				Текст.КодоваяСтраница(КодировкаИмп);
				Текст.Показать("Просмотр файла импорта:", ПутьФайлаИмпорта);
				Иначе  
				Текст.КодоваяСтраница(Кодировка);
				Текст.Показать("Просмотр файла экспорта:", ПутьФайлаОбмена);
				КонецЕсли;
   			КонецЕсли;
       КонецЕсли;
   		КонецПроцедуры //Просмотр
	
	

