//******************************************************************************
//	ЗагрузитьСтрокуЗаголовкаXML(Имя, Значение)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСтрокуЗаголовкаXML(Имя, Значение)
	
	Имя=Врег(СокрЛП(Имя)); 
	Если Имя="ВЕРСИЯФОРМАТА" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Версия формата файла:");
	ИначеЕсли Имя="КОДИРОВКА" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Кодировка файла:");
	ИначеЕсли Имя="ОТПРАВИТЕЛЬ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Программа-экспортер:");
	ИначеЕсли Имя="ПОЛУЧАТЕЛЬ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Программа-импортер:");
	ИначеЕсли Имя="ДАТАСОЗДАНИЯ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Дата создания файла:");
	ИначеЕсли Имя="ВРЕМЯСОЗДАНИЯ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Время создания файла:");

	ИначеЕсли Имя="ДАТАНАЧАЛА" Тогда
		ДатаНачалаЗаг=ПолучитьДатуПоФСтроке(Значение);
//		ДобавитьПараметрЗагрузки(Значение, "Начало интервала:");
			
	ИначеЕсли Имя="ДАТАКОНЦА" Тогда
		ДатаКонцаЗаг=ПолучитьДатуПоФСтроке(Значение);
//		ДобавитьПараметрЗагрузки(Значение, "Конец интервала:");

	ИначеЕсли Имя="РАСЧСЧЕТ" Тогда
		Значение=СокрЛП(Значение);
		ЗагрРасчетныеСчета.Установить(Значение, Значение);
//		ТекстРасчСчетаЗагрузки=ТекстРасчСчетаЗагрузки+Значение+РазделительСтрок;
	ИначеЕсли Имя="САЛЬДО" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Сальдо:");


	ИначеЕсли Имя="ДОКУМЕНТ" Тогда
		Значение=Врег(СокрЛП(Значение)); 
		Если      Значение="ПЛАТЕЖНОЕ ПОРУЧЕНИЕ" 			Тогда ВидДокумента="ПлатежноеПоручение";
		ИначеЕсли Значение="ПЛАТЕЖНОЕ ТРЕБОВАНИЕ-ПОРУЧЕНИЕ"	Тогда ВидДокумента="ПлатежноеТребованиеПоручение";
		Иначе                                                     ВидДокумента="";
			ОшибкаЗагрузкиТекста("", "", "неверный вид документа: """+Значение+"""");
		КонецЕсли;
		Если ПустаяСтрока(ВидДокумента)=0 Тогда
			ЗагрВидыДокументов.Установить(ВидДокумента, ВидДокумента);
		КонецЕсли;
	
	Иначе
		ОшибкаЗагрузкиТекста("", "", "неверный идентификатор: """+Имя+"""");
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьСтрокуЗаголовкаXML()

//******************************************************************************
//	ЗагрузитьСтрокуЗаголовка(Стр)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСтрокуЗаголовка(Стр, Ном)
	
	Равно=Найти(Стр, "=");
	Имя=Врег(СокрЛП(Лев(Стр, Равно-1))); Значение=Сред(Стр, Равно+1);

	Если Равно=0 Тогда
		ОшибкаЗагрузкиТекста(Ном, Стр, "не найден символ ""=""");

	ИначеЕсли Имя="ВЕРСИЯФОРМАТА" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Версия формата файла:");
	ИначеЕсли Имя="КОДИРОВКА" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Кодировка файла:");
	ИначеЕсли Имя="ОТПРАВИТЕЛЬ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Программа-экспортер:");
	ИначеЕсли Имя="ПОЛУЧАТЕЛЬ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Программа-импортер:");
	ИначеЕсли Имя="ДАТАСОЗДАНИЯ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Дата создания файла:");
	ИначеЕсли Имя="ВРЕМЯСОЗДАНИЯ" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Время создания файла:");

	ИначеЕсли Имя="ДАТАНАЧАЛА" Тогда
		ДатаНачалаЗаг=ПолучитьДатуПоФСтроке(Значение);
//		ДобавитьПараметрЗагрузки(Значение, "Начало интервала:");
			
	ИначеЕсли Имя="ДАТАКОНЦА" Тогда
		ДатаКонцаЗаг=ПолучитьДатуПоФСтроке(Значение);
//		ДобавитьПараметрЗагрузки(Значение, "Конец интервала:");

	ИначеЕсли Имя="РАСЧСЧЕТ" Тогда
		Значение=СокрЛП(Значение);
		ЗагрРасчетныеСчета.Установить(Значение, Значение);
//		ТекстРасчСчетаЗагрузки=ТекстРасчСчетаЗагрузки+Значение+РазделительСтрок;
	ИначеЕсли Имя="САЛЬДО" Тогда
//		ДобавитьПараметрЗагрузки(Значение, "Сальдо:");


ИначеЕсли Имя="ДОКУМЕНТ" Тогда
		Значение=Врег(СокрЛП(Значение)); 
		Если      Значение="ПЛАТЕЖНОЕ ПОРУЧЕНИЕ" 			Тогда ВидДокумента="ПлатежноеПоручение";
		ИначеЕсли Значение="ПЛАТЕЖНОЕ ТРЕБОВАНИЕ-ПОРУЧЕНИЕ"	Тогда ВидДокумента="ПлатежноеТребованиеПоручение";
		Иначе                                                     ВидДокумента="";
			ОшибкаЗагрузкиТекста(Ном, Стр, "неверный вид документа: """+Значение+"""");
		КонецЕсли;
		Если ПустаяСтрока(ВидДокумента)=0 Тогда
			ЗагрВидыДокументов.Установить(ВидДокумента, ВидДокумента);
		КонецЕсли;
	
	Иначе
		ОшибкаЗагрузкиТекста(Ном, Стр, "неверный идентификатор: """+Имя+"""");
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьСтрокуЗаголовка()
//******************************************************************************
//	ЗагрузитьСтрокуДокументаXML(Имя, Значение)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСтрокуДокументаXML(Имя, Значение)
	
	Перем Тип, Длина;
	
	Имя=Врег(СокрЛП(Имя)); 
	Колонка=АтрибутыДокументов.Получить(Имя);

	Если ПустоеЗначение(Колонка)=0 Тогда
		тВыписка.ПолучитьПараметрыКолонки(Колонка, Тип, Длина);
		Если      Тип="Число" Тогда	Значение=Число(СокрЛП(Значение));
		ИначеЕсли Тип="Дата"  Тогда Значение=Дата(СокрЛП(Значение));
		ИначеЕсли Длина<>0    Тогда Значение=СокрЛП(Значение);
		КонецЕсли;

		НомерСтроки=тВыписка.НомерСтроки;
		тВыписка.УстановитьЗначение(НомерСтроки, Колонка, Значение);
	
	Иначе
		ОшибкаЗагрузкиТекста("", "", "неверный идентификатор: """+Имя+"""");
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьСтрокуДокументаXML()

//******************************************************************************
//	ЗагрузитьСтрокуДокумента(Стр, Ном)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСтрокуДокумента(Стр, Ном)
	
	Перем Тип, Длина;
	
	Равно=Найти(Стр, "=");
	Имя=Врег(СокрЛП(Лев(Стр, Равно-1))); Значение=Сред(Стр, Равно+1);
	Колонка=АтрибутыДокументов.Получить(Имя);

	Если Равно=0 Тогда
		ОшибкаЗагрузкиТекста(Ном, Стр, "не найден символ ""=""");

	ИначеЕсли ПустоеЗначение(Колонка)=0 Тогда
		тВыписка.ПолучитьПараметрыКолонки(Колонка, Тип, Длина);
		Если      Тип="Число" Тогда	Значение=Число(СокрЛП(Значение));
		ИначеЕсли Тип="Дата"  Тогда Значение=Дата(СокрЛП(Значение));
		ИначеЕсли Длина<>0    Тогда Значение=СокрЛП(Значение);
		КонецЕсли;

		НомерСтроки=тВыписка.НомерСтроки;
		тВыписка.УстановитьЗначение(НомерСтроки, Колонка, Значение);
	
	Иначе
		ОшибкаЗагрузкиТекста(Ном, Стр, "неверный идентификатор: """+Имя+"""");
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьСтрокуДокумента()

//******************************************************************************
//	ЗагрузитьСекциюДокумента(Текст, К)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСекциюДокумента(Текст, К)
	
	тВыписка.НоваяСтрока();
	
//	Для К=К+1 по Текст.КоличествоСтрок() Цикл СекцияДокумент
	Для К=К по Текст.КоличествоСтрок() Цикл
		Состояние("Обработка: строка "+К);
		Стр=Текст.ПолучитьСтроку(К);
//Сообщить("Загружается секция документа - "+Стр);			
		
		Если ПустоеЗначение(Стр)=1 Тогда 
			Продолжить;
		ИначеЕсли Врег(Лев(СокрЛП(Стр), 5))="КОНЕЦ" Тогда 
			Прервать; 
		ИначеЕсли Врег(Лев(СокрЛП(Стр), 14))="СЕКЦИЯДОКУМЕНТ" Тогда 
            Продолжить;
		КонецЕсли;
		ЗагрузитьСтрокуДокумента(Стр, К);
	КонецЦикла;

//**	ВидДокумента=ВидыОпераций.Получить(тВыписка.ВидОплаты);
//*	Если ПустоеЗначение(ВидДокумента)=0 Тогда
//*		тВыписка.СекцияДокумент=ВидДокумента;
//*	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьСекциюДокумента()
//******************************************************************************
//	ЗагрузитьСекциюРасчСчетаXML(Имя, Значение)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСекциюРасчСчетаXML(Имя, Значение) 
	
	
КонецПроцедуры // ЗагрузитьСекциюРасчСчетаXML()

//******************************************************************************
//	ЗагрузитьСекциюРасчСчета(Текст, К)
//
//	Параметры:
//
//	Описание:

Процедура ЗагрузитьСекциюРасчСчета(Текст, К)
	
	Для К=К+1 по Текст.КоличествоСтрок() Цикл
		Состояние("Обработка: строка "+К);
		Стр=Текст.ПолучитьСтроку(К);
		Сообщить("Загружается данные секции расчетного счета - "+Стр);

	   	Если ПустоеЗначение(Стр)=1 Тогда 
			Продолжить;
		ИначеЕсли Врег(Лев(СокрЛП(Стр), 5))="КОНЕЦ" Тогда 
			Прервать; 
		КонецЕсли;

//		ЗагрузитьСтрокуРасчСчета(Стр, К);
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьСекциюРасчСчета()

//******************************************************************************
//	ЗагрузитьТекст()
//
//	Параметры:
//
//	Описание:

// ===============================   
// Функция Импорт_Файла_TXT() 
//		производит загрузку информации о платежах из текстового файла
// ===============================
Функция Импорт_Файла_TXT()  
	тВыписка.УдалитьСтроки();
	Текст=ТекстФайла(ПутьФайлаИмпорта);
	Текст.КодоваяСтраница(КодировкаИмп);

	ИнфоСекцияДок=0;
	Если ПустоеЗначение(Текст)=1 Тогда Возврат 0; КонецЕсли;
	Стр=Текст.ПолучитьСтроку(1);
	Если СокрЛП(Стр)<>"_1CClientBankExchange" Тогда
	Сообщить("Установлен неверный внутренний признак файла обмена. Обработка импорта не произведена!","!");			
    БезОшибок = 0;
	Возврат 0; 
    Иначе
	Сообщить("Внутренний признак файла обмена: "+Стр);			
	КонецЕсли;	
		
	Для К=2 по Текст.КоличествоСтрок() Цикл
		Состояние("Обработка: строка "+К);
		Стр=Текст.ПолучитьСтроку(К);
		
		Если ПустаяСтрока(Стр)=1 Тогда
			Продолжить;
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 10)="КОНЕЦФАЙЛА" Тогда
			Сообщить("Секции платежных документов загружены.");			
        	 Прервать; 
		
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 14)="СЕКЦИЯДОКУМЕНТ" Тогда
			Если ИнфоСекцияДок=0 Тогда
        	Сообщить("Загружаются секции платежных документов...");			
			ИнфоСекцияДок=1;	
			КонецЕсли;
			ЗагрузитьСекциюДокумента(Текст, К);
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 14)="СЕКЦИЯРАСЧСЧЕТ" Тогда 
        //Сообщить("Загружается секция расчетного счета - "+Текст);			
			ЗагрузитьСекциюРасчСчета(Текст, К);
		Иначе
		Сообщить("Загружается строка заголовка - "+Стр);			
			ЗагрузитьСтрокуЗаголовка(Стр, К);
		Равно=Найти(Стр, "=");
		Имя=Врег(СокрЛП(Лев(Стр, Равно-1))); Значение=Сред(Стр, Равно+1);

	//	Если (СокрЛП(Имя)="ПОЛУЧАТЕЛЬ")  Тогда
    //   		Если (СокрЛП(Значение)<>"1С:Предприятие") Тогда
	//		Сообщить("Неверно указан реквизит файла импорта - Получатель. Обработка прекращена!", "!");			
    //        БезОшибок = 0;
	//		Прервать;
    //        КонецЕсли;
	//	ИначеЕсли (СокрЛП(Имя)="ОТПРАВИТЕЛЬ")  Тогда
    //   		Если  (СокрЛП(Значение)<>"Клиент-Банк") Тогда
	//		Сообщить("Неверно указан реквизит файла импорта - Отправитель. Обработка прекращена!", "!");			
    //        БезОшибок = 0;
	//		Прервать;
	//		КонецЕсли; 
	//	КонецЕсли; 
	
	КонецЕсли;
	КонецЦикла;
	ЕстьСч=0;	
	Для Инд = 1 По спРСчета.РазмерСписка() Цикл
		Если спРСчета.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;
		Если ТипКонфигурации<>"Торговля" Тогда
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(спРСчета.ПолучитьЗначение(Инд).НомерСчета))=1 Тогда
	        ЕстьСч=1;
			КонецЕсли;
		Иначе     
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(спРСчета.ПолучитьЗначение(Инд).БанкСчет))=1 Тогда
	        ЕстьСч=1;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
    	Если ЕстьСч=0 Тогда
			Предупреждение("В файле импорта нет данных по расч. счетам указанным на Шаге №1. Обработка прекращена!", "!");			
             БезОшибок = 0;
			Возврат 0;
		КонецЕсли;
			

		
	Если тВыписка.КоличествоСтрок()>0 Тогда
    	ЗагрузитьТаблицуДокументов();

		Сообщить("________________________________________________________________________________");
		Сообщить("ИМПОРТ ПЛАТЕЖНЫХ ДОКУМЕНТОВ УСПЕШНО ВЫПОЛНЕН!");			
	Иначе 
		Сообщить("________________________________________________________________________________");
		Сообщить("Список Платежных документов для загрузки пуст!","!");			
         БезОшибок = 0;
	КонецЕсли;	
    //ОбновитьИнфо();
	
	Возврат 1;

КонецФункции // Импорт_Файла_TXT 

// ===============================   
// Функция Импорт_Файла_XML() 
//		производит загрузку информации о платежах из XML-файла
// ===============================
Функция Импорт_Файла_XML()
Если ЗагрузитьВнешнююКомпоненту(КаталогИБ() + "v7plus.dll") <> 1 Тогда
	Если ЗагрузитьВнешнююКомпоненту(КаталогИБ() + "ExtForms\" + "v7plus.dll") <> 1 Тогда		
		Если ЗагрузитьВнешнююКомпоненту(КаталогПрограммы() + "v7plus.dll") <> 1 Тогда
			Предупреждение("Компонента v7plus.dll не найдена!");
		КонецЕсли;	
	КонецЕсли;
КонецЕсли;    	
	тВыписка.УдалитьСтроки(); 
	ИнфоСекцияДок=0;
	Если ФС.СуществуетФайл(ПутьФайлаИмпорта) = 0 Тогда
	    Сообщить("Файл "+ ПутьФайлаИмпорта+ " не найден!","!");
		Возврат 0;
	КонецЕсли;

	Анализатор = СоздатьОбъект("AddIn.XMLParser");
	гДокДанных = Анализатор.СоздатьДокумент();
	
    Попытка
		гДокДанных.Загрузить(ПутьФайлаИмпорта);
	Исключение
		Сообщить("Операция не вполнена: "+ ОписаниеОшибки());
		Сообщить("Возможно файл "+ПутьФайлаИмпорта+" поврежден");
		Возврат 0;
	КонецПопытки;
	
	УзелУр1 = гДокДанных.ЭлементДокумента;
	КвоОбработано = 0;
	СообщитьПризнак = 1;
	Для Инд1 = 1 по УзелУр1.КоличествоПодчиненных() Цикл 
	
	Если СокрЛП(УзелУр1.Наименование)<>"_1CClientBankExchange" Тогда
	Сообщить("Установлен неверный внутренний признак файла обмена. Обработка импорта не произведена!","!");			
    БезОшибок = 0;
	Возврат 0; 
    ИначеЕсли СообщитьПризнак <> 1 Тогда
	Сообщить("Внутренний признак файла обмена: "+УзелУр1.Наименование);
	СообщитьПризнак = 0;
	КонецЕсли;	

		УзелУр2 = УзелУр1.ПолучитьПодчиненныйПоНомеру(Инд1);
			
			
			Если Лев(Врег(СокрЛП(УзелУр2.Наименование)), 14)="СЕКЦИЯРАСЧСЧЕТ" Тогда 
				Для Инд2 = 1 по УзелУр2.КоличествоПодчиненных() Цикл
					УзелУр3 = УзелУр2.ПолучитьПодчиненныйПоНомеру(Инд2); 
        			Сообщить("Загружается секция расчетного счета - "+УзелУр3.Наименование+ " = "+УзелУр3.Значение);			
					ЗагрузитьСекциюРасчСчетаXML(УзелУр3.Наименование, УзелУр3.Значение);
				КонецЦикла;

			ИначеЕсли Лев(Врег(СокрЛП(УзелУр2.Наименование)), 14)="СЕКЦИЯДОКУМЕНТ" Тогда
		
				Если ИнфоСекцияДок=0 Тогда
        			Сообщить("Загружаются секции платежных документов...");			
					ИнфоСекцияДок=1;	
				КонецЕсли;             
				
			
				тВыписка.НоваяСтрока();
				
				ВидДокумента = УзелУр2.ПолучитьАтрибут("Вид");
				Если ПустаяСтрока(ВидДокумента) = 1 Тогда
					ВидДокумента = "Платежное поручение";	
				КонецЕсли;
				НомерСтроки=тВыписка.НомерСтроки;
				тВыписка.УстановитьЗначение(НомерСтроки, "ВидДокумента", ВидДокумента);
				
				Для Инд2 = 1 по УзелУр2.КоличествоПодчиненных() Цикл
					УзелУр3 = УзелУр2.ПолучитьПодчиненныйПоНомеру(Инд2); 
					ЗагрузитьСтрокуДокументаXML(УзелУр3.Наименование, УзелУр3.Значение);
				КонецЦикла;
				
			Иначе 
				Сообщить("Загружается строка заголовка - "+УзелУр2.Наименование+ " = "+УзелУр2.Значение);			
				ЗагрузитьСтрокуЗаголовкаXML(УзелУр2.Наименование, УзелУр2.Значение);
			КонецЕсли;	
	КонецЦикла;	 
	Сообщить("Секции платежных документов загружены.");			

	ЕстьСч=0;	
	Для Инд = 1 По спРСчета.РазмерСписка() Цикл
		Если спРСчета.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;
		Если ТипКонфигурации<>"Торговля" Тогда
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(спРСчета.ПолучитьЗначение(Инд).НомерСчета))=1 Тогда
	        ЕстьСч=1;
			КонецЕсли;
		Иначе     
			Если ЗагрРасчетныеСчета.Принадлежит(СокрЛП(спРСчета.ПолучитьЗначение(Инд).БанкСчет))=1 Тогда
	        ЕстьСч=1;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
    	Если ЕстьСч=0 Тогда
			Предупреждение("В файле импорта нет данных по расч. счетам указанным на Шаге №1. Обработка прекращена!", "!");			
             БезОшибок = 0;
			Возврат 0;
		КонецЕсли;
			

		
	Если тВыписка.КоличествоСтрок()>0 Тогда
    	ЗагрузитьТаблицуДокументов();

		Сообщить("________________________________________________________________________________");
		Сообщить("ИМПОРТ ПЛАТЕЖНЫХ ДОКУМЕНТОВ УСПЕШНО ВЫПОЛНЕН!");			
	Иначе 
		Сообщить("________________________________________________________________________________");
		Сообщить("Список Платежных документов для загрузки пуст!","!");			
         БезОшибок = 0;
	КонецЕсли;	
    //ОбновитьИнфо();
	
	Возврат 1;

КонецФункции // Импорт_Файла_XML 


// ===============================   
// Функция Экспорт_Файла_TXT() 
//		производит запись информации о платежных документах в текстовый файл
// ===============================
Функция Экспорт_Файла_TXT() 
	Текст = СоздатьОбъект("Текст");             
	Текст.КодоваяСтраница(Кодировка);

	// -------- общие сведения ----
	ДобавитьСлужРеквизит(Текст,"_1CClientBankExchange");
	ДобавитьРеквизит(Текст,"ВерсияФормата",	"1.00");
	ДобавитьРеквизит(Текст,"Кодировка",		?(Кодировка=0,"Windows","DOS"));
	ДобавитьРеквизит(Текст,"Отправитель",	"1С:Предприятие");
	ДобавитьРеквизит(Текст,"Получатель",	"Клиент-Банк");
	ДобавитьРеквизит(Текст,"ДатаСоздания",	РабочаяДата());
	//ДобавитьРеквизит(Текст,"ВремяСоздания",		"");

	// -------- условия отбора
	ДобавитьРеквизит(Текст,"ДатаНачала",НачДата);
	ДобавитьРеквизит(Текст,"ДатаКонца",	КонДата);
	Для Инд = 1 По спРСчета.РазмерСписка() Цикл
		Если спРСчета.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;
		Если ТипКонфигурации <> "Торговля" Тогда
		ДобавитьРеквизит(Текст,"РасчСчет",спРСчета.ПолучитьЗначение(Инд).НомерСчета);
		Иначе
		ДобавитьРеквизит(Текст,"РасчСчет",спРСчета.ПолучитьЗначение(Инд).БанкСчет);
		КонецЕсли;
	КонецЦикла;
// SPO: здесь нужна корректировка
	ДобавитьРеквизит(Текст,"Сальдо",0);

	// -------- остатки по расчетному счету
	// отсутствуют для 1С -> КБ
	
	// -------- документы 
	// обработка документов
	Для Инд = 1 По спВидыДок.РазмерСписка() Цикл  
		Если спВидыДок.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;

		ВидДокСтр = "";
		ВидДок = спВидыДок.ПолучитьЗначение(Инд,ВидДокСтр);
		ДокПлат = СоздатьОбъект("Документ."+ВидДок);
		ДокПлат.ВыбратьДокументы(НачДата,КонДата);
		Пока ДокПлат.ПолучитьДокумент() = 1 Цикл
			Если ДокПлат.Проведен() = 0 Тогда // непроведенные не обрабатываем
			    Продолжить;
			КонецЕсли;

			ДокРСчет 			= ДокПлат.РСчет;
			ДокФирма 			= ДокПлат.Фирма;
			ДокКонтрагент 		= ДокПлат.Контрагент;
            Если ТипКонфигурации<>"Торговля" Тогда
			ДокРСчетКонтрагента = ДокПлат.РСчетКонтрагента;
			Иначе     
			ДокРСчетКонтрагента = ДокПлат.СчетКонтрагента;
			Конецесли;
			
			Если ДокРСчет.Валюта.Код <> "980" Тогда // валюта документа не гривня
			    Продолжить;
			КонецЕсли;

			Если спРСчета.Пометка(спРСчета.НайтиЗначение(ДокРСчет)) = 0 Тогда // счет не помечен
			    Продолжить;
			КонецЕсли;

			// -------- шапка плат. документа
			//ДобавитьРеквизит(Текст,"СекцияДокумент",	ВидДокСтр);
			ДобавитьСлужРеквизит(Текст,"СекцияДокумент");
			ДобавитьРеквизит(Текст,"ВидДокумента",  	ВидДокСтр);
			// SPO: здесь проблемы с Платежным требованием-поручением
			Попытка
				ДобавитьРеквизит(Текст,"Номер",				ДокПлат.Номер);
			Исключение
				ДобавитьРеквизит(Текст,"Номер",				"нет номера");
			КонецПопытки;
			ДобавитьРеквизит(Текст,"Дата",				ДокПлат.ДатаДок);
			ДобавитьРеквизит(Текст,"ДокументИД",		ДокПлат.НомерДок);
			ДобавитьРеквизит(Текст,"Сумма",				ДокПлат.СуммаСНДС);
			ДобавитьРеквизит(Текст,"КодВалюты",			ДокРСчет.Валюта.Код);
		
			// -------- реквизиты плательщика
			Если ДокПлат.Вид() = "ПлатежноеПоручение" Тогда  
	           Если ТипКонфигурации<>"Торговля" Тогда
				ДобавитьРеквизит(Текст,"ПлательщикСчет",	ДокРСчет.НомерСчета);
				ДобавитьРеквизит(Текст,"ПлательщикБанк",	ДокРСчет.Банк);
				ДобавитьРеквизит(Текст,"ПлательщикМФО",		ДокРСчет.Банк.Код);
				ДобавитьРеквизит(Текст,"ПлательщикОКПО",	ДокФирма.ЕДРПОУ);
				ДобавитьРеквизит(Текст,"Плательщик",		ДокФирма.ПолнНаименование);
				Иначе
				ДобавитьРеквизит(Текст,"ПлательщикСчет",	ДокРСчет.БанкСчет);
				ДобавитьРеквизит(Текст,"ПлательщикБанк",	ДокРСчет.БанкНазвание);
				ДобавитьРеквизит(Текст,"ПлательщикМФО",		ДокРСчет.БанкМФО);
				ДобавитьРеквизит(Текст,"ПлательщикОКПО",	ДокФирма.ЕГРПОУ); 
				ДобавитьРеквизит(Текст,"Плательщик",		ДокФирма.ОфициальноеНаименование.Получить(ДокПлат.ДатаДок));
  				КонецЕсли;
			ИначеЕсли ДокПлат.Вид() = "ПлатежноеТребованиеПоручение" Тогда
				ДобавитьРеквизит(Текст,"ПлательщикСчет",	ДокРСчетКонтрагента.НомерСчета);
				ДобавитьРеквизит(Текст,"Плательщик",		ДокКонтрагент.ПолнНаименование);
				ДобавитьРеквизит(Текст,"ПлательщикОКПО",	ДокКонтрагент.ЕДРПОУ);
				ДобавитьРеквизит(Текст,"ПлательщикБанк",	ДокРСчетКонтрагента.Банк);
				ДобавитьРеквизит(Текст,"ПлательщикМФО",		ДокРСчетКонтрагента.Банк.Код);
			КонецЕсли;
		
			// -------- реквизиты получателя
			Если ДокПлат.Вид() = "ПлатежноеПоручение" Тогда
				ДобавитьРеквизит(Текст,"Получатель",		ДокКонтрагент.ПолнНаименование);
	           Если ТипКонфигурации<>"Торговля" Тогда
				ДобавитьРеквизит(Текст,"ПолучательСчет",	ДокРСчетКонтрагента.НомерСчета);
				ДобавитьРеквизит(Текст,"ПолучательОКПО",	ДокКонтрагент.ЕДРПОУ);
				ДобавитьРеквизит(Текст,"ПолучательБанк",	ДокРСчетКонтрагента.Банк);
				ДобавитьРеквизит(Текст,"ПолучательМФО",		ДокРСчетКонтрагента.Банк.Код);
				Иначе
				ДобавитьРеквизит(Текст,"ПолучательСчет",	ДокРСчетКонтрагента.БанкСчет);
				ДобавитьРеквизит(Текст,"ПолучательОКПО",	ДокКонтрагент.ЕГРПОУ);
				ДобавитьРеквизит(Текст,"ПолучательБанк",	ДокРСчетКонтрагента.БанкНазвание);
				ДобавитьРеквизит(Текст,"ПолучательМФО",		ДокРСчетКонтрагента.БанкМФО);
				КонецЕсли;
			
			ИначеЕсли ДокПлат.Вид() = "ПлатежноеТребованиеПоручение" Тогда
				ДобавитьРеквизит(Текст,"ПолучательСчет",	ДокРСчет.НомерСчета);
				ДобавитьРеквизит(Текст,"Получатель",		ДокФирма.ПолнНаименование);
				ДобавитьРеквизит(Текст,"ПолучательОКПО",	ДокФирма.ЕДРПОУ);
				ДобавитьРеквизит(Текст,"ПолучательБанк",	ДокРСчет.Банк);
				ДобавитьРеквизит(Текст,"ПолучательМФО",		ДокРСчет.Банк.Код);
			КонецЕсли;
		
			// -------- реквизиты платежа
			Содержание = СтрЗаменить(Лев(СокрЛП(ДокПлат.Содержание),160),РазделительСтрок," ")+ РазделительСтрок;
			ДобавитьРеквизит(Текст,"НазначениеПлатежа",	Содержание);
			
			// -------- служ. реквизиты
			ДобавитьСлужРеквизит(Текст,"КонецДокумента");
		КонецЦикла;
	КонецЦикла;

	ДобавитьСлужРеквизит(Текст,"КонецФайла");

	Попытка
		Текст.Записать(ПутьФайлаОбмена);
		Возврат 1;
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции //Экспорт_Файла_TXT

//===========================================
// устанавливает пометки выгрузки в таблице тбСхемыXML
Процедура  ОпределитьСписокВыгружаемыхСхем();
	тбСхемыXML.ВыбратьСтроки();
	Пока тбСхемыXML.ПолучитьСтроку() = 1 Цикл
		//по-умолчанию выгружаем все приложения
		тбСхемыXML.фВыгрузка = 1;
	КонецЦикла;
КонецПроцедуры	
// ===============================   
// Функция Экспорт_Файла_XML() 
//		производит запись информации о платежных документах в XML-файл
// ===============================
Функция Экспорт_Файла_XML() 
    // экспорт 
	Перем спДанныеОтчета, спПараметры;  
	
	тбСхемыXML = СоздатьОбъект("ТаблицаЗначений");
	тбСхемыXML.НоваяКолонка("ИмяСхемы","Строка",8,,"Имя файла-схемы");
	тбСхемыXML.НоваяКолонка("ПрефиксСхемы","Строка");
	тбСхемыXML.НоваяКолонка("ПредставлениеСхемы","Строка", 80,," Наименование регл. отчета");
	тбСхемыXML.НоваяКолонка("фВыгрузка","Число", 1,0,"Выгружать?", 8);
	
	тбСхемыXML.НоваяСтрока();
	тбСхемыXML.ИмяСхемы = "1C_to_CB"; 
	тбСхемыXML.ПрефиксСхемы = "1С-КБ";
	тбСхемыXML.ПредставлениеСхемы ="Экспорт 1С-КБ"; 
	
	//Создадим список параметров для передачи их в обработку выгрузки
	спПараметры = СоздатьОбъект("СписокЗначений");
	спДанныеОтчета = СоздатьОбъект("СписокЗначений");

	спПараметры.ДобавитьЗначение("ЭкспортXML", "Команда"); //Операция

	ОпределитьСписокВыгружаемыхСхем();
	спПараметры.ДобавитьЗначение(тбСхемыXML, "Схемы");	//Схемы (правила) выгрузки. Определеяются ГНАУ
	
	//в список нужно "вручную" добавить данные множественной части 
	//Если ДополнитьСписокСохранения(спДанныеОтчета, 0) = 0 Тогда
	//	Возврат 0;
	//КонецЕсли;
	//========== основной шаблон 
    //**спДанныеОтчета.ДобавитьЗначение(Ном, "R02G01I");
	// -------- общие сведения ----
	спДанныеОтчета.ДобавитьЗначение(Строка(ПутьФайлаОбмена),"ПутьФайлаОбмена");
	спДанныеОтчета.ДобавитьЗначение(Строка("1.00"),"ВерсияФормата");
	спДанныеОтчета.ДобавитьЗначение(Строка("1С:Предприятие"),"Отправитель");
	спДанныеОтчета.ДобавитьЗначение(Строка("Клиент-Банк"),"Получатель");
	спДанныеОтчета.ДобавитьЗначение(Строка(""+ДатаГод(РабочаяДата())+"-"+Формат(ДатаМесяц(РабочаяДата()),"Ч(0)2")+"-"+Формат(ДатаЧисло(РабочаяДата()),"Ч(0)2")),"ДатаСоздания");
//	спДанныеОтчета.ДобавитьЗначение(Строка(""),"ВремяСоздания");

	//ДобавитьРеквизит(Текст,"ВремяСоздания",		"");

	// -------- условия отбора  
	
	спДанныеОтчета.ДобавитьЗначение(Строка(""+ДатаГод(НачДата)+"-"+Формат(ДатаМесяц(НачДата),"Ч(0)2")+"-"+Формат(ДатаЧисло(НачДата),"Ч(0)2")),"ДатаНачала");
	спДанныеОтчета.ДобавитьЗначение(Строка(""+ДатаГод(КонДата)+"-"+Формат(ДатаМесяц(КонДата),"Ч(0)2")+"-"+Формат(ДатаЧисло(КонДата),"Ч(0)2")),"ДатаКонца");
	Для Инд = 1 По спРСчета.РазмерСписка() Цикл
		Если спРСчета.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;
		Если ТипКонфигурации <> "Торговля" Тогда 
		спДанныеОтчета.ДобавитьЗначение(Число(спРСчета.ПолучитьЗначение(Инд).НомерСчета),"РасчСчет");
		Иначе                
		спДанныеОтчета.ДобавитьЗначение(Число(спРСчета.ПолучитьЗначение(Инд).БанкСчет),"РасчСчет");
		КонецЕсли;
	КонецЦикла;
// SPO: здесь нужна корректировка 
	спДанныеОтчета.ДобавитьЗначение(Число(0),"Сальдо");
	// -------- остатки по расчетному счету
	// отсутствуют для 1С -> КБ
	
	// -------- документы 
	// обработка документов
	КвоДокументовКВыгрузке = 0;

	Для Инд = 1 По спВидыДок.РазмерСписка() Цикл  
		Если спВидыДок.Пометка(Инд) = 0 Тогда // не отмечен 
		    Продолжить;
		КонецЕсли;

		ВидДокСтр = "";
		ВидДок = спВидыДок.ПолучитьЗначение(Инд,ВидДокСтр);
		ДокПлат = СоздатьОбъект("Документ."+ВидДок);
		ДокПлат.ВыбратьДокументы(НачДата,КонДата);
		Пока ДокПлат.ПолучитьДокумент() = 1 Цикл
			Если ДокПлат.Проведен() = 0 Тогда // непроведенные не обрабатываем
			    Продолжить;
			КонецЕсли;

			ДокРСчет 			= ДокПлат.РСчет;
			ДокФирма 			= ДокПлат.Фирма;
			ДокКонтрагент 		= ДокПлат.Контрагент;
            Если ТипКонфигурации<>"Торговля" Тогда
			ДокРСчетКонтрагента = ДокПлат.РСчетКонтрагента;
			Иначе     
			ДокРСчетКонтрагента = ДокПлат.СчетКонтрагента;
			Конецесли;
			
			Если ДокРСчет.Валюта.Код <> "980" Тогда // валюта документа не гривня
			    Продолжить;
			КонецЕсли;

			Если спРСчета.Пометка(спРСчета.НайтиЗначение(ДокРСчет)) = 0 Тогда // счет не помечен
			    Продолжить;
			КонецЕсли;

			// -------- шапка плат. документа
			//ДобавитьРеквизит(Текст,"СекцияДокумент",	ВидДокСтр);
			спДанныеОтчета.ДобавитьЗначение(Строка("СекцияДокумент"),"СекцияДокумент");
			спДанныеОтчета.ДобавитьЗначение(Строка(ВидДокСтр),"ВидДокумента");
			// SPO: здесь проблемы с Платежным требованием-поручением
			Попытка
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокПлат.Номер),"Номер");
			Исключение
				спДанныеОтчета.ДобавитьЗначение(Строка("нет номера"),"Номер");
			КонецПопытки;
			спДанныеОтчета.ДобавитьЗначение(Строка(""+ДатаГод(ДокПлат.ДатаДок)+"-"+Формат(ДатаМесяц(ДокПлат.ДатаДок),"Ч(0)2")+"-"+Формат(ДатаЧисло(ДокПлат.ДатаДок),"Ч(0)2")),"Дата");
			спДанныеОтчета.ДобавитьЗначение(Строка(ДокПлат.НомерДок),"ДокументИД");
			спДанныеОтчета.ДобавитьЗначение(Число(ДокПлат.СуммаСНДС),"Сумма");
			спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчет.Валюта.Код),"КодВалюты");
		
			// -------- реквизиты плательщика
			Если ДокПлат.Вид() = "ПлатежноеПоручение" Тогда  
	           Если ТипКонфигурации<>"Торговля" Тогда
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчет.НомерСчета),"ПлательщикСчет");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчет.Банк),"ПлательщикБанк");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчет.Банк.Код),"ПлательщикМФО");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокФирма.ЕДРПОУ),"ПлательщикОКПО");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокФирма.ПолнНаименование),"Плательщик");
				Иначе
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчет.БанкСчет),"ПлательщикСчет");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчет.БанкНазвание),"ПлательщикБанк");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчет.БанкМФО),"ПлательщикМФО");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокФирма.ЕГРПОУ),"ПлательщикОКПО"); 
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокФирма.ОфициальноеНаименование.Получить(ДокПлат.ДатаДок)),"Плательщик");
  				КонецЕсли;
			ИначеЕсли ДокПлат.Вид() = "ПлатежноеТребованиеПоручение" Тогда
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчетКонтрагента.НомерСчета),"ПлательщикСчет");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокКонтрагент.ПолнНаименование),"Плательщик");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокКонтрагент.ЕДРПОУ),"ПлательщикОКПО");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчетКонтрагента.Банк),"ПлательщикБанк");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчетКонтрагента.Банк.Код),"ПлательщикМФО");
			КонецЕсли;
		
			// -------- реквизиты получателя
			Если ДокПлат.Вид() = "ПлатежноеПоручение" Тогда
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокКонтрагент.ПолнНаименование),"Получатель");
	           Если ТипКонфигурации<>"Торговля" Тогда
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчетКонтрагента.НомерСчета),"ПолучательСчет");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокКонтрагент.ЕДРПОУ),"ПолучательОКПО");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчетКонтрагента.Банк),"ПолучательБанк");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчетКонтрагента.Банк.Код),"ПолучательМФО");
				Иначе
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчетКонтрагента.БанкСчет),"ПолучательСчет");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокКонтрагент.ЕГРПОУ),"ПолучательОКПО");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчетКонтрагента.БанкНазвание),"ПолучательБанк");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчетКонтрагента.БанкМФО),"ПолучательМФО");
				КонецЕсли;
			
			ИначеЕсли ДокПлат.Вид() = "ПлатежноеТребованиеПоручение" Тогда
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчет.НомерСчета),"ПолучательСчет");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокФирма.ПолнНаименование),"Получатель");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокФирма.ЕДРПОУ),"ПолучательОКПО");
				спДанныеОтчета.ДобавитьЗначение(Строка(ДокРСчет.Банк),"ПолучательБанк");
				спДанныеОтчета.ДобавитьЗначение(Число(ДокРСчет.Банк.Код),"ПолучательМФО");
			КонецЕсли;
		
			// -------- реквизиты платежа
			Содержание = СтрЗаменить(Лев(СокрЛП(ДокПлат.Содержание),160),РазделительСтрок," ")+ РазделительСтрок;
			спДанныеОтчета.ДобавитьЗначение(Строка(Содержание),"НазначениеПлатежа");
			спДанныеОтчета.ДобавитьЗначение(Строка("КонецДокумента"),"КонецДокумента");

			КвоДокументовКВыгрузке = КвоДокументовКВыгрузке + 1;
		КонецЦикла;
	КонецЦикла;
    
	спПараметры.ДобавитьЗначение(спДанныеОтчета,"Данные"); //собственно данные отчета
	спПараметры.ДобавитьЗначение(КаталогДанныхФирмы, "КаталогДанныхФирмы"); //каталог для сохранения выгрузки
	Если КвоДокументовКВыгрузке > 0  Тогда
		КаталогОтчета=КаталогИБ()+"ExtForms\";
		ОткрытьФормуМодально("Отчет",спПараметры,КаталогОтчета+"xmlExprt.ert");
	    Возврат 1;
	Иначе	    
		Предупреждение("Нет данных для выгрузки");
	    Возврат 0;
	КонецЕсли;
КонецФункции //Экспорт_Файла_XML

// ===============================   
// Процедура ДобавитьРеквизитФО()
// 		записывает реквизит файла обмена в таблицу реквизитов
// ===============================
Процедура ДобавитьРеквизитФО(Идентификатор,ВыгрФормат,ЗагрФормат)
	тзРеквизитФО.НоваяСтрока();
	тзРеквизитФО.Идентификатор	= ВРег(Идентификатор);
	тзРеквизитФО.ВыгрФормат		= ВыгрФормат;
	тзРеквизитФО.ЗагрФормат		= ЗагрФормат;
КонецПроцедуры

// ===============================   
// Процедура ЗаписатьФорматФайлаОбмена()
// 		заполняется таблица реквизитов файла обмена
// ===============================
Процедура ЗаписатьФорматФайлаОбмена()
	тзРеквизитФО = СоздатьОбъект("ТаблицаЗначений");    
	тзРеквизитФО.НоваяКолонка("Идентификатор",	"Строка");
	тзРеквизитФО.НоваяКолонка("ВыгрФормат",		"Строка");
	тзРеквизитФО.НоваяКолонка("ЗагрФормат",		"Строка");

	// -------- общие сведения ----
	ДобавитьРеквизитФО("ВерсияФормата",		"С",	"С");
	ДобавитьРеквизитФО("Кодировка",			"С",	"С");
	ДобавитьРеквизитФО("Отправитель",		"С",	"С");
	ДобавитьРеквизитФО("Получатель",		"С",	"С");
	ДобавитьРеквизитФО("ДатаСоздания",		"Д",	"Д");
	ДобавитьРеквизитФО("ВремяСоздания",		"В",	"В");
	// -------- условия отбора ----
	ДобавитьРеквизитФО("ДатаНачала",		"Д",	"Д");
	ДобавитьРеквизитФО("ДатаКонца",			"Д",	"Д");
	ДобавитьРеквизитФО("РасчСчет",			"Ч14",	"Ч(0)14");
	ДобавитьРеквизитФО("Сальдо",			"Ч14.2","Ч12.2");
	// -------- остатки по расчетному счету ----
//	ДобавитьРеквизитФО("ДатаНачала",		"Д",	0,0,	"С",	1,1);
//	ДобавитьРеквизитФО("ДатаКонца",			"Д",	0,0,	"С",	1,0);
	ДобавитьРеквизитФО("РасчСчетОрг",		"Ч14",	"Ч(0)14");
	ДобавитьРеквизитФО("НачальныйОстаток",	"Ч14.2","Ч14.2");
	ДобавитьРеквизитФО("ВсегоПоступило",	"Ч14.2","Ч14.2");
	ДобавитьРеквизитФО("ВсегоСписано",		"Ч14.2","Ч14.2");
	ДобавитьРеквизитФО("КонечныйОстаток",	"Ч14.2","Ч14.2");
	// -------- шапка плат. документа ----
	ДобавитьРеквизитФО("СекцияДокумент",	"С",	"С");
	ДобавитьРеквизитФО("ВидДокумента", 		"С",	"С");
	ДобавитьРеквизитФО("Номер",				"С",	"С");
	ДобавитьРеквизитФО("Дата",				"Д",	"Д");
	ДобавитьРеквизитФО("ДокументИД",		"С",	"С");
	ДобавитьРеквизитФО("Сумма",				"Ч14.2","Ч14.2");
	ДобавитьРеквизитФО("КодВалюты",			"С",	"С");
	ДобавитьРеквизитФО("СтатусДокумента",	"С",	"С");
	// -------- реквизиты плательщика ----
	ДобавитьРеквизитФО("ПлательщикСчет",	"Ч14",	"Ч(0)14");
	ДобавитьРеквизитФО("ДатаСписано",		"Д",	"Д");
	ДобавитьРеквизитФО("Плательщик",		"С",	"С");
	ДобавитьРеквизитФО("ПлательщикОКПО",	"Ч10",	"Ч(0)10");
	ДобавитьРеквизитФО("ПлательщикБанк",	"С",	"С");
	ДобавитьРеквизитФО("ПлательщикМФО",		"Ч6",	"Ч(0)6");
	// -------- реквизиты получателя ----
	ДобавитьРеквизитФО("ПолучательСчет",	"Ч14",	"Ч(0)14");
	ДобавитьРеквизитФО("ДатаПоступило",		"Д",	"Д");
	ДобавитьРеквизитФО("Получатель",		"С",	"С");
	ДобавитьРеквизитФО("ПолучательОКПО",	"Ч10",	"Ч(0)10");
	ДобавитьРеквизитФО("ПолучательБанк",	"С",	"С");
	ДобавитьРеквизитФО("ПолучательМФО",		"Ч6",	"Ч(0)6");
	// -------- реквизиты платежа ----
	ДобавитьРеквизитФО("НазначениеПлатежа",	"С",	"С");
КонецПроцедуры //ЗаписатьФорматФайлаОбмена


