Функция КоличествоРабочихСтрокВВыписке()
	тВыписка.ВыбратьСтроки();
	Пока тВыписка.ПолучитьСтроку() = 1 Цикл
		Если тВыписка.фВкл = 2 Тогда
			Возврат 1;
		КонецЕсли;
	КонецЦикла; 
	Возврат 0;
КонецФункции //КоличествоРабочихСтрокВВыписке  


