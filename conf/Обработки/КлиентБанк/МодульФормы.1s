// ===============================   
// Процедура ИзмПериод()
// 		проверяет, что реквизиты НачДата и КонДата образуют временной интервал
// ===============================   
Процедура ИзмПериод()
	Если ПустоеЗначение(НачДата) = 1 Тогда
	    Возврат;
	КонецЕсли;
	Если ПустоеЗначение(КонДата) = 1 Тогда
	    Возврат;
	КонецЕсли;
	НачДата = Мин(НачДата,КонДата);
	КонДата = Макс(НачДата,КонДата);
КонецПроцедуры //ИзмПериод


