// Процедура ИзмТипОперации()
// 		формирует название операции
// ===============================   
Процедура ИзмТипОперации()
	ТипОперацииСтр = ?(ТипОперации = 1,"импорт","экспорт");
   
	Если ТипОперации=1 Тогда
	ПутьФайлаИмпорта=КаталогПользователя()+"kb_to_1c.txt";
	Иначе	
	ПутьФайлаОбмена=КаталогПользователя()+"1c_to_kb.txt";
	КонецЕсли;
	
КонецПроцедуры //ИзмТипОперации 


