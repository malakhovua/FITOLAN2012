// ***********************************************

// ===============================   
// Процедура ЗаполнитьСписокСчетов()
// 		заполняется список расчетных счетов спРСчета по выбранной фирме
// ===============================   
Процедура ЗаполнитьСписокРСчетов(ИмпортЭкспорт = 0) 
	спРСчета.УдалитьВсе();
	спрРСчета = СоздатьОбъект("Справочник.НашиДенежныеСчета");
	Если ПустоеЗначение(Фирма) = 0 Тогда
		спрРСчета.ИспользоватьВладельца(Фирма);
	КонецЕсли;      

	спрРСчета.ВыбратьЭлементы();
	Пока спрРСчета.ПолучитьЭлемент() = 1 Цикл
		ТекРСчет = спрРСчета.ТекущийЭлемент();
		Если ТекРСчет.ЭтоГруппа() = 1 Тогда
			Продолжить;
		КонецЕсли;
		Если ИмпортЭкспорт = 1 Тогда
			Если ТекРСчет.Валюта <> Гривня Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		Если ТекРСчет.БезНал = 0 Тогда
			Продолжить;
		КонецЕсли; 
		Если спРСчета.НайтиЗначение(ТекРСчет) = 0 Тогда 
			Если ТипКонфигурации <> "Торговля" Тогда
			ПредставлениеРСчета = "№: " + СокрЛП(ТекРСчет.НомерСчета) + ", банк " + СокрЛП(ТекРСчет.Банк) + ", МФО " + ТекРСчет.Банк.Код;
			спРСчета.ДобавитьЗначение(ТекРСчет,ПредставлениеРСчета);
			Иначе 
			ПредставлениеРСчета = "№: " + СокрЛП(ТекРСчет.БанкСчет) + ", банк " + СокрЛП(ТекРСчет.БанкНазвание) + ", МФО " + ТекРСчет.БанкМФО;
			спРСчета.ДобавитьЗначение(ТекРСчет,ПредставлениеРСчета);
			
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;     
	
	Если спРСчета.РазмерСписка() = 1 Тогда //если счет один, то его и выбираем по умолчанию
	    спРСчета.Пометка(1,1);
	КонецЕсли;
КонецПроцедуры //ЗаполнитьСписокРСчетов

// ===============================   
// Функция ПроверитьВыборВСписке(Список)
// 		проверяет, помечен ли хоть один из элементов списка Список
// ===============================   
Функция ПроверитьВыборВСписке(Список)     
	Если Список.РазмерСписка() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Для Ном = 1 По Список.РазмерСписка() Цикл
		Если Список.Пометка(Ном) = 1 Тогда
			Возврат 1;
		КонецЕсли;	
	КонецЦикла;	   
	Возврат 0;
КонецФункции //ПроверитьВыборВСписке

// ===============================   
// Функция ПроверитьРеквизиты()
// 		проверяет возможность перехода к выполнению очередного шага
// ===============================   
Функция ПроверитьРеквизиты()
	Если ТекущийСлой = "Начало" Тогда   
		Если (ЕстьРазделительУчета = 1) или (ТипКонфигурации = "Торговля") Тогда
			Если ПустоеЗначение(Фирма) = 1 Тогда
				Предупреждение("Не выбрана фирма");
				Возврат 0;
			КонецЕсли;
		КонецЕсли;  
	ИначеЕсли ТекущийСлой = "Шаг1" Тогда 
		Если ПроверитьВыборВСписке(спВидыДок) = 0 Тогда
			Предупреждение("Не выбран ни один вид документа!");
			Возврат 0;
		КонецЕсли;
		Если ПроверитьВыборВСписке(спРСчета) = 0 Тогда
			Предупреждение("Не выбран ни один расчетный счет!");
			Возврат 0;
		КонецЕсли;
	ИначеЕсли ТекущийСлой = "ЭкспортШаг2" Тогда 
		Если ПустоеЗначение(НачДата) = 1 Тогда
			Предупреждение("Не выбрана дата начала периода!");
			Возврат 0;
		КонецЕсли;
		Если ПустоеЗначение(КонДата) = 1 Тогда
			Предупреждение("Не выбрана дата окончания периода!");
			Возврат 0;
		КонецЕсли;
		Если ПустоеЗначение(ПутьФайлаОбмена) = 1 Тогда
			Предупреждение("Не указан файл экспорта!");
			Возврат 0;
		КонецЕсли;
	ИначеЕсли ТекущийСлой = "ИмпортШаг2" Тогда
	ИначеЕсли ТекущийСлой = "ИмпортШаг3" Тогда
	ИначеЕсли ТекущийСлой = "ИмпортШаг4" Тогда
//*		Если КоличествоРабочихСтрокВВыписке() = 0 Тогда
//*			Предупреждение("Нет ни одной строки для загрузки в выписки банка");
//*			Возврат 0;
//*		КонецЕсли; 
		
	ИначеЕсли ТекущийСлой = "Конец" Тогда 
	КонецЕсли;
	Возврат 1;
КонецФункции //Проверки 



// ***********************************************
