Перем СтрокаИТС,ИмяФайла,Адрес, АдресAuth, АдресGet;
Перем Соединение,Инфо;
//*****************************************************************************
//	ОчиститьКаталог(Знач Каталог)
//
//	Параметры:  Каталог - наименование очищаемого каталога
//
//	Описание:  Рекурсивная процедура. Осуществляет полную очистку указанного каталога 
Процедура ОчиститьКаталог(Знач Каталог)
	Перем Размер,Атр,ВС,ВД,ВЗ,Расш;
	Перем СписокФайлов, СписокКаталогов;
	
	СписокФайлов	= СоздатьОбъект("СписокЗначений");
	СписокКаталогов	= СоздатьОбъект("СписокЗначений");
	
	// получим имя первого файла
	ФГ=СоздатьОбъект("ФС");
	Файл = ФГ.НайтиПервыйФайл(Каталог + "\*.*");
	Пока ПустаяСтрока(Файл) = 0 Цикл
		Если (Файл <> "..") И (Файл <> ".") Тогда
			ПолноеИмя	= Каталог + "\" + Файл;
			ФГ.АтрибутыФайла(ПолноеИмя, Размер, Атр, ВС, ВД, ВЗ, Расш);
			Если Сред(Атр, 4, 1) = "1" Тогда
				СписокКаталогов.ДобавитьЗначение(ПолноеИмя);
			Иначе
				СписокФайлов.ДобавитьЗначение(ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
		Файл	= ФГ.НайтиСледующийФайл();
	КонецЦикла;
	
	// очистить текущий каталог
	Для Индекс = 1 По СписокФайлов.РазмерСписка() Цикл
		ФС.УдалитьФайл(СписокФайлов.ПолучитьЗначение(Индекс));
	КонецЦикла;

	// если есть еще каталоги, то надо их очистить
	Для Индекс = 1 По СписокКаталогов.РазмерСписка() Цикл
		ОчиститьКаталог(СписокКаталогов.ПолучитьЗначение(Индекс));
	КонецЦикла;
КонецПроцедуры
//*****************************************************************************
//	Добавить(Имя)
//
//	Параметры:  Имя - имя файла с обновлением регламентированных отчетов
//
//	Описание:  Осуществляет распаковку файла и установку новых регламентированных отчетов
Процедура Добавить(Имя)
	Перем ИсхКаталог;
	Перем Каталог, Стр;
	Номер = 0;
	Если Лев(КаталогИБ(), 2)="\\" Тогда
		ВремКаталог = КаталогВременныхФайлов()+"temp.grp\";
	Иначе
		ВремКаталог = КаталогИБ()+"ExtForms\temp.grp\";
	КонецЕсли;
	Если ФС.СуществуетФайл(ВремКаталог+Имя)=0 Тогда
		Возврат; // регламентированные отчеты с сайта не получены
	КонецЕсли;
	Т = СоздатьОбъект("Текст");
	Т.Открыть(ВремКаталог+Имя);
	Стр = Т.ПолучитьСтроку(1); 
	Если (Лев(Стр,6)="Неверн")ИЛИ(Лев(Стр,6)="Ошибка")ИЛИ(Найти(Стр,"font")<>0) Тогда
	    Сообщить("Ошибка в параметрах доступа к ресурсу! Возможно, право на доступ устарело.");
		Возврат;
	КонецЕсли;
	Каталог = КаталогИБ()+"ExtForms\"+Лев(Имя, СтрДлина(Имя)-4)+".grp";
    НовыйКаталог = 0;
    Если ФС.СуществуетФайл(Каталог) = 1 Тогда
    	А = Вопрос("Данная группа отчетов уже существует."+РазделительСтрок+
    	           "Заменить на новые?", 3);
        Если А = 2 Тогда
        	Возврат;
        КонецЕсли;
		Если А = 7 Тогда
        	Если СтрДлина(Имя) = 11 Тогда
        		Каталог = Лев(Каталог, СтрДлина(Каталог)-5);
        	Иначе
        		Каталог = Лев(Каталог, СтрДлина(Каталог)-4);
            КонецЕсли;
        	Номер = 1;
        	Пока ФС.СуществуетФайл(Каталог+Номер+".grp") = 1 Цикл
        	    Номер = Номер+1;
        	КонецЦикла;
        	Каталог = Каталог+Номер+".grp";
        	НовыйКаталог = 1;
		КонецЕсли;
	Иначе
		НовыйКаталог = 1;
    КонецЕсли;
	ТекКаталог = ФС.ТекКаталог();
	ФС.УстТекКаталог(ВремКаталог); 
	Если КомандаСистемы(""""+ВремКаталог+Имя+"""") <> 0 Тогда
		ФС.УдалитьФайл(ВремКаталог+Имя);
		ФС.УстТекКаталог(ТекКаталог);
	 	ОчиститьКаталог(ВремКаталог);
		ФС.УдалитьКаталог(ВремКаталог);
		Возврат;
	КонецЕсли;
	Если НовыйКаталог = 1 Тогда
		ФС.СоздатьКаталог(Каталог);
	КонецЕсли; 

	ФС.УдалитьФайл(ВремКаталог+Имя);    
    Каталог = Каталог+"\";
	ФГ=СоздатьОбъект("ФС");
	Файл = ФГ.НайтиПервыйФайл(ВремКаталог+"*.*");
	Пока ПустаяСтрока(Файл) = 0 Цикл
		Если (Файл <> "..") И (Файл <> ".") Тогда
	    	ФГ.КопироватьФайл(ВремКаталог+Файл, Каталог+Файл, 0);
	    	ФГ.УдалитьФайл(ВремКаталог+Файл);
		КонецЕсли;
		Файл = ФГ.НайтиСледующийФайл();
	КонецЦикла;
	ФГ = "";
	
	//Перенесем еще подкаталог со схемами
	Если НовыйКаталог = 1 Тогда
		ФС.СоздатьКаталог(Каталог+"XSD");
	КонецЕсли; 
	ФГ=СоздатьОбъект("ФС");
	Файл = ФГ.НайтиПервыйФайл(ВремКаталог+"XSD\*.*");
	Пока ПустаяСтрока(Файл) = 0 Цикл
		Если (Файл <> "..") И (Файл <> ".") Тогда
	    	ФГ.КопироватьФайл(ВремКаталог+"XSD\"+Файл, Каталог+"XSD\"+Файл, 0);
	    	ФГ.УдалитьФайл(ВремКаталог+"XSD\"+Файл);
		КонецЕсли;
		Файл = ФГ.НайтиСледующийФайл();
	КонецЦикла;
	ФГ = "";
    ФС.УдалитьКаталог(ВремКаталог+"XSD\"); 
	
	Если Номер <> 0 Тогда
		Файл=Каталог+"\RpList.txt";
		Если ФС.СуществуетФайл(Файл) = 1 Тогда
			Текст=СоздатьОбъект("Текст");
			Текст.Открыть(Файл);
			Текст.ЗаменитьСтроку(1, Текст.ПолучитьСтроку(1)+" ("+Номер+")");
			Текст.Записать(Файл);
		КонецЕсли;
	КонецЕсли;
	ФС.УстТекКаталог(ТекКаталог);
	ФС.УдалитьКаталог(ВремКаталог); 
	Если ПустоеЗначение(Форма.Параметр)=0 Тогда
		Если ТипЗначенияСтр(Форма.Параметр)="СписокЗначений" Тогда
			Форма.Параметр.ДобавитьЗначение(Каталог,"Каталог");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
//*****************************************************************************
//	Загрузить(ИмяФайлаВерсий)
//
//	Параметр:  ИмяФайлаВерсий - строка с именем получаемого ресурса (Ver.id)
//
//	Описание:  формирование имени "самого свежего" файла с комплектом регламентированных отчетов 
Функция Загрузить(ИмяФайлаВерсий)
	Стр = "";
	Попытка                    
		Соединение.ПолучитьКакСтроку(Адрес+ВРег(ИмяФайлаВерсий), Стр);
	Исключение 
		Возврат "";
	КонецПопытки;
	Возврат "Rp"+Лев(Стр,4)+".exe";
КонецФункции

//*****************************************************************************
//	ПолучитьФайл(ИмяФайла)
//
//	Параметры:  ИмяФайла - строка с именем файла обновления регламентированных отчетов
//				имя файла формируется в запросе при вызове обработки из обработки РегламентированныеОтчеты
//				или формируется его по содержимому файла Ver.id, получаемого с сайта фирмы  
//
//	Описание:  Осуществляет обмен информацией с сервером, получает файл отчетов
Функция ПолучитьФайл(ИмяФайла) 
	Перем АдресКлюча,Ответ;
	// проверка наличия диска ИТС
	Делт = КодСимв("Z")-КодСимв("A")+1;
	СтрокаИТС = Инфо.ПроверитьИмяФайла("1");
	Если ПустоеЗначение(СтрокаИТС)=1 Тогда
		Сообщить("Вставьте диск ИТС в дисковод и повторите операцию");
		Возврат 0;
	КонецЕсли;
	ИТС = (КодСимв(Сред(СтрокаИТС,2,1))+Делт-КодСимв(Лев(СтрокаИТС,1)))%Делт;
	
	// КаталогФайла - каталог размещения архива регламентированных отчетов
	Если глИдентификаторКонфигурации()="UBUOUSL" Тогда 
		КаталогФайла = "Reports/U77Comp";      	 // для комплексной конфигурации
	ИначеЕсли глИдентификаторКонфигурации()="URCLKTK" Тогда
		КаталогФайла = "Reports/U77ZiK";      	 // для зарплаты
	ИначеЕсли глИдентификаторКонфигурации()="UBUTK" Тогда
		КаталогФайла = "Reports/U77UaP";      	 // для бухгалтерии
	ИначеЕсли глИдентификаторКонфигурации()="UManf" Тогда 
		КаталогФайла = "Reports/U77Manf";      	 // для производства
	КонецЕсли;
	
	Попытка 
		Если ПустоеЗначение(ИмяФайла)=1 Тогда
			// Получить САМЫЙ СВЕЖИЙ архив
			// определение имени архива (получаем по Ver.id)
			Если глИдентификаторКонфигурации()="UBUOUSL" Тогда 
				КатНомераВерсии = "ITSRepV/Reports/U77Comp/Ver.id";      	 // для комплексной конфигурации
			ИначеЕсли глИдентификаторКонфигурации()="URCLKTK" Тогда
				КатНомераВерсии = "ITSRepV/Reports/U77ZiK/Ver.id";      	 // для зарплаты
			ИначеЕсли глИдентификаторКонфигурации()="UBUTK" Тогда
				КатНомераВерсии = "ITSRepV/Reports/U77UaP/Ver.id";      	 // для бухгалтерии
			ИначеЕсли глИдентификаторКонфигурации()="UManf" Тогда
				КатНомераВерсии = "ITSRepV/Reports/U77Manf/Ver.id";      	 // для производства
			КонецЕсли;
			ИмяФайла = Загрузить(КатНомераВерсии);     // Получить имя файла с регл. отчетов 
		КонецЕсли; 
		
		Соединение.ПолучитьКакСтроку(АдресAuth,АдресКлюча);
		
		Если ТипЗначенияСтр(АдресКлюча)="Число"  Тогда
		    АдресКлюча = Строка(АдресКлюча); 
		КонецЕсли;
		Если ПустаяСтрока(ИмяФайла)=1  Тогда
			Сообщить("Нет обновления регламентированных отчетов");
			Возврат 0;
		КонецЕсли;
		Если СокрЛП(АдресКлюча)="" Тогда
			Сообщить("Доступ закрыт!");
			Форма.Закрыть();
			Возврат 0;
		КонецЕсли;
		Если Лев(КаталогИБ(), 2)="\\" Тогда
			ВремКаталог = КаталогВременныхФайлов()+"temp.grp";
		Иначе
			ВремКаталог = КаталогИБ()+"ExtForms\temp.grp";
		КонецЕсли;
		Если ФС.СуществуетФайл(ВремКаталог)=0 Тогда 
			ФС.СоздатьКаталог(ВремКаталог);
		КонецЕсли;
		ВремКаталог = ВремКаталог+"\";
		Ключ = Инфо.ПроверитьИмяФайла(АдресКлюча);                                              	
		Соединение.ПолучитьКакФайл(АдресGet+"?addr="+АдресКлюча+"&d="+Ключ+"&its="+ИТС+"&file="+ВРег(ИмяФайла)+"&dir="+ВРег(КаталогФайла),ВремКаталог+ИмяФайла);
		Возврат 1;
	Исключение 
		Сообщить("Неудачная попытка соединения.");
		Возврат 0;
	КонецПопытки;
КонецФункции  //  ПолучитьФайл
//*****************************************************************************
//	УстановитьКомпоненту()
//
//	Описание:  Осуществляет загрузку внешней компоненты V7Plus.dll
Функция УстановитьКомпоненту()
	Если ЗагрузитьВнешнююКомпоненту(КаталогИБ()+"ExtForms\v7plus.dll")=0 Тогда
		Если ЗагрузитьВнешнююКомпоненту("v7plus.dll")=0 Тогда
			Сообщить("Не удалось обнаружить компоненту V7Plus.dll!"); 
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	Попытка
		Соединение = СоздатьОбъект("Addin.V7HttpReader");
		Инфо = СоздатьОбъект("AddIn.V7SysInfo");
	Исключение 
		Сообщить("Не удалось создать объекты Addin.V7HttpReader или AddIn.V7SysInfo!"); 
		Возврат 0;
	КонецПопытки; 
	Возврат 1;
КонецФункции  // УстановитьКомпоненту
//*****************************************************************************
Процедура ПриОткрытии() // Предопределенная
	ИмяФайла = "";
	// Если обработка запускается из обработки РегламентированныеОтчеты,
	// то в передаваемом контексте содержится имя обновляемого комплекта 
	Если ПустоеЗначение(Форма.Параметр)=0 Тогда
		Если ТипЗначенияСтр(Форма.Параметр)="СписокЗначений" Тогда
			ИмяФайла = Форма.Параметр.Получить("ИмяФайла");
		КонецЕсли;
	КонецЕсли; 
	
	Если УстановитьКомпоненту()=1 Тогда
		Если ПолучитьФайл(ИмяФайла)=1 Тогда  
			Добавить(ИмяФайла);
		КонецЕсли; 
	КонецЕсли;
    СтатусВозврата(0);
КонецПроцедуры  // ПриОткрытии
//*****************************************************************************
Адрес		= "http://downloads.1c.eu/ipp/";   
АдресAuth 	= "http://downloads.1c.eu/auth.jsp"; 
АдресGet	= "http://downloads.1c.eu/get.jsp";

