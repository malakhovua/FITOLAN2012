Перем  НДС_20, НДС_0, НДС_безНДС, НДС_7;

// ===============================
// Назначение: определяет признак розничной продажи конечному потребителю
// Аргументы:	КонечныйПотребитель -  признак продажи в розницу конечному потребителю из документа
//				Док - документ продажи в розницу
// Возвращает: 	1 - продажа конечному потребителю
//				0 - продажа не конечному потрбителю
Функция ЭтоКонечныйПотребитель(КонечныйПотребитель,Док)
	Если (ПустоеЗначение(КонечныйПотребитель) = 1) 
	И (Док.Вид() = "ОтчетКА") Тогда
		Возврат 1;
	Иначе
		Возврат КонечныйПотребитель;
	КонецЕсли;    
КонецФункции //ЭтоКонечныйПотребитель 

// ===============================
Процедура НайтиНН(ДатаВозврата, ВидНДС, НайденнаяНН)
	
	НН = СоздатьОбъект("Документ.НалоговаяНакладная");
	НН.ВыбратьДокументы(ДатаВозврата, ДатаВозврата);
	Пока НН.ПолучитьДокумент() = 1 Цикл
		Если (НН.ПометкаУдаления() = 1) или (НН.ИтоговаяРозница = 0) Тогда
			Продолжить	
		КонецЕсли;
		ТекНН = НН.ТекущийДокумент();
		Если НН.ВидНДС = ВидНДС Тогда
			НайденнаяНН = ТекНН;
		ИначеЕсли (НН.ВидНДС = НДС_20) и (ВидНДС = НДС_0) 
		          и (НН.ЕстьНулевыеСтавкиНДС = 1) Тогда
			НайденнаяНН = ТекНН;
		КонецЕсли;
		Если (НайденнаяНН = ТекНН) и (НН.Проведен() = 1) Тогда
			Прервать
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ===============================
Функция ЗаполнитьШапкуПриложения(Пр2, ДатаВозврата, ВидНДС)
	
	НайденнаяНН = 0;
	НайтиНН(ДатаВозврата, ВидНДС, НайденнаяНН);
	Если НайденнаяНН = 0 Тогда
		глКомментарий("Не найдена итоговая налоговая накладная по рознице за день """ 
		               + ДатаВозврата + " с видом НДС """ + ВидНДС +"""." + РазделительСтрок
		               + "Приложение 2 к налоговой накладной не сформировано");
		Возврат 0
	КонецЕсли;
	Пр2.Фирма = Фирма;
	Пр2.ДатаДок = ДатаЗапроса;
	глУстановитьНомер(Пр2);
	Пр2.Автор = глПользователь;
	Пр2.Выписал = глВосстановитьЗначение(,"БазВыписалНН");
	Пр2.Валюта = Гривня;
	Пр2.ВидНДС = ВидНДС;
	Пр2.Контрагент = НайденнаяНН.Контрагент;
	Пр2.ДокументОснование = НайденнаяНН.ДокументОснование;
	Пр2.УсловиеПродажи = НайденнаяНН.УсловиеПродажи;
	Пр2.Контрагент = НайденнаяНН.Контрагент;
	Пр2.НалоговаяНакладная = НайденнаяНН;
	Пр2.ФормаРасчетов = НайденнаяНН.ФормаРасчетов;
	Пр2.ИтоговоеРозница = 1;
	Возврат 1

КонецФункции

// ===============================
Процедура ЗаполнитьШапку(НН)
	
	НН.Фирма = Фирма;
	НН.ДатаДок = ДатаЗапроса;
	глУстановитьНомер(НН);
	НН.ВидТорговли = Перечисление.ВидыТорговли.Нал;
	НН.Автор = глПользователь;
	НН.Выписал = глВосстановитьЗначение(,"БазВыписалНН");
	НН.ЧтоПродаем = Перечисление.ЧтоПродаем.ТМЦ;
	НН.Валюта = Гривня;
	НН.Курс = 1;
	НН.ИтоговаяРозница = 1;
	НН.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине;
	НН.Оставляем = 1;
	НН.ТипПричины = "(11)Выписана по ежедневным итогам операций";
	СпособПодгонки = Перечисление.СпособыПодгонкиСумм.НеПодгонять;
	
КонецПроцедуры	

//*******************************************
Процедура Выполнить()
	
	Если глПолучитьНиО(НДС_20,"НДС20","о ставке НДС 20%") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если глПолучитьНиО(НДС_7,"НДС7","о ставке НДС 7%") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если глПолучитьНиО(НДС_0,"НДС0","о ставке НДС 0%") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если глПолучитьНиО(НДС_безНДС,"БезНДС","о ставке НДС ""Без НДС""") = 0 Тогда
		Возврат;
	КонецЕсли;
    
	Предоплата = Перечисление.ВидыТорговли.Предоплата;
	Розн = СоздатьОбъект("Запрос");
	ТекстЗапр = 	"//{{ЗАПРОС(Розн)
		|Период с ДатаЗапроса по ДатаЗапроса;
		|ОбрабатыватьДокументы Проведенные;
		|Док 				= Документ.РасходнаяРозничная.ТекущийДокумент, 		   Документ.ОтчетКА.ТекущийДокумент, Документ.ВозвратРозница.ТекущийДокумент;
		|Дат 				= Документ.РасходнаяРозничная.ТекущийДокумент.ДатаДок, Документ.ОтчетКА.ТекущийДокумент.ДатаДок, Документ.ВозвратРозница.ТекущийДокумент.ДатаДок;
		|Фрм 				= Документ.РасходнаяРозничная.Фирма, 				   Документ.ОтчетКА.Фирма, Документ.ВозвратРозница.Фирма;
		|ВидНДСРозн			= Документ.РасходнаяРозничная.ВидНДС, 				   Документ.ОтчетКА.ВидНДС, Документ.ВозвратРозница.ВидНДС;
		|Скидка				= Документ.РасходнаяРозничная.Скидка, Документ.ВозвратРозница.Скидка;
		|ДатаВозврата = Документ.ВозвратРозница.ДокПродажи.ДатаДок;
		|КонечныйПотребитель= Документ.РасходнаяРозничная.КонечныйПотребитель, Документ.ВозвратРозница.КонечныйПотребитель;
		|ВидТорговли		= Документ.РасходнаяРозничная.ВидТорговли, Документ.ВозвратРозница.ВидТорговли;	
		|ДокБазаНДС_БезНДС	= Документ.РасходнаяРозничная.БазаНДС1, Документ.ОтчетКА.БазаНДС1;
		|ДокБазаНДС_0		= Документ.РасходнаяРозничная.БазаНДС2, Документ.ОтчетКА.БазаНДС2;
		|ДокБазаНДС_20		= Документ.РасходнаяРозничная.БазаНДС3, Документ.ОтчетКА.БазаНДС3;
		|ДокБазаНДС_7		= Документ.РасходнаяРозничная.БазаНДС4, Документ.ОтчетКА.БазаНДС4;
		|ДокВозвратБазаНДС_БезНДС	= Документ.ВозвратРозница.БазаНДС1;
		|ДокВозвратБазаНДС_0		= Документ.ВозвратРозница.БазаНДС2;
		|ДокВозвратБазаНДС_20		= Документ.ВозвратРозница.БазаНДС3;
		|ДокВозвратБазаНДС_7		= Документ.ВозвратРозница.БазаНДС4;
		|ДокНДС_БезНДС		= Документ.РасходнаяРозничная.НДС1, Документ.ОтчетКА.НДС1;
		|ДокНДС_0			= Документ.РасходнаяРозничная.НДС2,	Документ.ОтчетКА.НДС2;
		|ДокНДС_20			= Документ.РасходнаяРозничная.НДС3,	Документ.ОтчетКА.НДС3;
		|ДокНДС_7			= Документ.РасходнаяРозничная.НДС3,	Документ.ОтчетКА.НДС4;
		|ДокВозвратНДС_БезНДС	= Документ.ВозвратРозница.НДС1;
		|ДокВозвратНДС_0		= Документ.ВозвратРозница.НДС2;
		|ДокВозвратНДС_20		= Документ.ВозвратРозница.НДС3;
		|ДокВозвратНДС_7		= Документ.ВозвратРозница.НДС4;
		|Функция БазаНДС_БезНДС 	= Сумма(ДокБазаНДС_БезНДС) 	Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция БазаНДС_0 			= Сумма(ДокБазаНДС_0) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция БазаНДС_20 		= Сумма(ДокБазаНДС_20) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1); 
		|Функция БазаНДС_7 		= Сумма(ДокБазаНДС_7) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1); 
		|Функция ВозвратБазаНДС_БезНДС 	= Сумма(ДокВозвратБазаНДС_БезНДС) 	Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратБазаНДС_0 		= Сумма(ДокВозвратБазаНДС_0) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратБазаНДС_20 		= Сумма(ДокВозвратБазаНДС_20) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратБазаНДС_7 		= Сумма(ДокВозвратБазаНДС_7) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция НДС_БезНДС 		= Сумма(ДокНДС_БезНДС) 	Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция НДС_0	 			= Сумма(ДокНДС_0) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция НДС_20 			= Сумма(ДокНДС_20) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция НДС_7 			= Сумма(ДокНДС_7) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратНДС_БезНДС 		= Сумма(ДокВозвратНДС_БезНДС) 	Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратНДС_0	 		= Сумма(ДокВозвратНДС_0) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратНДС_20 			= Сумма(ДокВозвратНДС_20) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Функция ВозвратНДС_7 			= Сумма(ДокВозвратНДС_7) 		Когда (ЭтоКонечныйПотребитель(КонечныйПотребитель,Док) = 1);
		|Группировка ДатаВозврата;
		|Условие(Фрм = Фирма);
		|Условие(ВидТорговли <> Предоплата);
		|"//}}ЗАПРОС
		;
    
	Если Розн.Выполнить(ТекстЗапр)=0 Тогда
		Предупреждение("Не выполнился запрос по розничным накладным!");
		Возврат;
	КонецЕсли;
	
	Табл = СоздатьОбъект ("ТаблицаЗначений");
	Розн.Выгрузить(Табл);
	Табл.ВыбратьСтроку(ТекстЗапр);
	
	Ставка_0_Отработана = 0;
		
	Пока Розн.Группировка("ДатаВозврата") = 1 Цикл 
		
		Если ПустоеЗначение(Розн.ДатаВозврата) = 1 Тогда
			
			Если Розн.БазаНДС_20 > 0 Тогда
				НН = СоздатьОбъект("Документ.НалоговаяНакладная");
				НН.Новый();
				
				ЗаполнитьШапку(НН);
				НН.ВидНДС = ОсновнаяСтавкаНДС;
				
				НН.НоваяСтрока();
				НН.ТМЦ = Константа.НоменклатураДляННПоРознице;
				НН.Кво = 1;
				глУстановкаБазЕд(НН,НН.ТМЦ);
				НН.НулеваяСтавкаНДС = Нет;
				НН.СуммаСНДС = Розн.БазаНДС_20;
				НН.НДС = Розн.НДС_20;
				НН.СуммаБезНДС = НН.СуммаСНДС-НН.НДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
					НН.СуммаБезСкидки = НН.СуммаСНДС;
				Иначе
					НН.СуммаБезСкидки = НН.СуммаСНДС/ (1 + НН.ВидНДС.Ставка.Получить(ДатаЗапроса));
				КонецЕсли;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				
				НН.СуммаНДС = НН.НДС;
				НН.БазаНДС  = НН.СуммаБезНДС;
				
				Если (ОднаНакладнаяПо20_0 = 1) и (Розн.БазаНДС_0 > 0)  Тогда 
					
					НН.ЕстьНулевыеСтавкиНДС = 1;		
					
					НН.НоваяСтрока();
					НН.ТМЦ = Константа.НоменклатураДляННПоРознице;
					НН.Кво = 1;
					глУстановкаБазЕд(НН,НН.ТМЦ);
					НН.НулеваяСтавкаНДС = Да;
					НН.СуммаСНДС = Розн.БазаНДС_0;
					НН.НДС = Розн.НДС_0;
					НН.СуммаБезНДС = НН.СуммаСНДС-НН.НДС;
					НН.ЦенаБезНДС = НН.СуммаБезНДС;
					НН.ЦенаСНДС = НН.СуммаСНДС;
					Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
						НН.СуммаБезСкидки = НН.СуммаСНДС;
					Иначе
						НН.СуммаБезСкидки = НН.СуммаСНДС/ (1 + НН.ВидНДС.Ставка.Получить(ДатаЗапроса));
					КонецЕсли;
					
					НН.ЦенаСНДС = НН.СуммаСНДС;
					НН.ЦенаБезНДС = НН.СуммаБезНДС;
					
					НН.СуммаНДС = НН.НДС;
					НН.БазаНДС0  = НН.СуммаБезНДС;
					
					Ставка_0_Отработана = 1;
				КонецЕсли;	
				НН.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(НН.ТекущийДокумент());
				
				глКомментарий("Сформирована налоговая накладная по ставке НДС 20%" 
				+ ?(Ставка_0_Отработана = 1, " и 0%", ""));	
				
			Иначе
				
				глКомментарий("По ставке НДС 20% розничных продаж не было");
				
			КонецЕсли;	

			Если Розн.БазаНДС_7 > 0 Тогда
				НН = СоздатьОбъект("Документ.НалоговаяНакладная");
				НН.Новый();
				
				ЗаполнитьШапку(НН);
				НН.ВидНДС = СтавкаНДС7;
				
				НН.НоваяСтрока();
				НН.ТМЦ = Константа.НоменклатураДляННПоРознице;
				НН.Кво = 1;
				глУстановкаБазЕд(НН,НН.ТМЦ);
				НН.НулеваяСтавкаНДС = Нет;
				НН.СуммаСНДС = Розн.БазаНДС_7;
				НН.НДС = Розн.НДС_7;
				НН.СуммаБезНДС = НН.СуммаСНДС-НН.НДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
					НН.СуммаБезСкидки = НН.СуммаСНДС;
				Иначе
					НН.СуммаБезСкидки = НН.СуммаСНДС/ (1 + НН.ВидНДС.Ставка.Получить(ДатаЗапроса));
				КонецЕсли;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				
				НН.СуммаНДС = НН.НДС;
				НН.БазаНДС  = НН.СуммаБезНДС;
				
				НН.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(НН.ТекущийДокумент());
				
				глКомментарий("Сформирована налоговая накладная по ставке НДС 7%");	
				
			Иначе
				
				глКомментарий("По ставке НДС 7% розничных продаж не было");
				
			КонецЕсли;	
			
			Если (Розн.БазаНДС_0 > 0) и (Ставка_0_Отработана = 0) Тогда
				НН = СоздатьОбъект("Документ.НалоговаяНакладная");
				НН.Новый();
				
				ЗаполнитьШапку(НН);
				НН.ВидНДС = ЛьготнаяСтавкаНДС;
				
				НН.НоваяСтрока();
				НН.ТМЦ = Константа.НоменклатураДляННПоРознице;
				НН.Кво = 1;
				глУстановкаБазЕд(НН,НН.ТМЦ);
				НН.НулеваяСтавкаНДС = Нет;
				НН.СуммаСНДС = Розн.БазаНДС_0;
				НН.НДС = Розн.НДС_0;
				НН.СуммаБезНДС = НН.СуммаСНДС-НН.НДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
					НН.СуммаБезСкидки = НН.СуммаСНДС;
				Иначе
					НН.СуммаБезСкидки = НН.СуммаСНДС/ (1 + НН.ВидНДС.Ставка.Получить(ДатаЗапроса));
				КонецЕсли;
				
				НН.ЦенаСНДС = НН.СуммаСНДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				
				НН.СуммаНДС = НН.НДС;
				НН.БазаНДС0  = НН.СуммаБезНДС;
				
				НН.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(НН.ТекущийДокумент());
				
				глКомментарий("Сформирована налоговая накладная по ставке НДС 0%");
				
			Иначе
				
				глКомментарий("По ставке НДС 0% розничных продаж не было");
				
			КонецЕсли;	
			
			Если Розн.БазаНДС_БезНДС > 0 Тогда
				НН = СоздатьОбъект("Документ.НалоговаяНакладная");
				НН.Новый();
				
				ЗаполнитьШапку(НН);
				НН.ВидНДС = БезНДС;
				
				НН.НоваяСтрока();
				НН.ТМЦ = Константа.НоменклатураДляННПоРознице;
				НН.Кво = 1;
				глУстановкаБазЕд(НН,НН.ТМЦ);
				НН.СуммаСНДС = Розн.БазаНДС_БезНДС;
				НН.НДС = Розн.НДС_БезНДС;
				НН.СуммаБезНДС = НН.СуммаСНДС-НН.НДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
					НН.СуммаБезСкидки = НН.СуммаСНДС;
				Иначе
					НН.СуммаБезСкидки = НН.СуммаСНДС/ (1 + НН.ВидНДС.Ставка.Получить(ДатаЗапроса));
				КонецЕсли;
				НН.ЦенаСНДС = НН.СуммаСНДС;
				НН.ЦенаБезНДС = НН.СуммаБезНДС;
				
				НН.СуммаНДС = НН.НДС;
				НН.БазаНДС  = НН.СуммаБезНДС;
				
				НН.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(НН.ТекущийДокумент());
				
				глКомментарий("Сформирована налоговая накладная по ставке НДС ""Без НДС""");
				
			Иначе
				
				глКомментарий("По ставке НДС ""Без НДС"" розничных продаж не было");
				
			КонецЕсли;	
			
		Иначе
			// формируем Приложения 2
			Если Розн.ВозвратБазаНДС_20 > 0 Тогда
				
				Пр2 = СоздатьОбъект("Документ.Приложение2");
				Пр2.Новый();
				
				Если ЗаполнитьШапкуПриложения(Пр2, Розн.ДатаВозврата, НДС_20) = 0 Тогда
					Продолжить
				КонецЕсли;
				
				Пр2.НоваяСтрока();
				Пр2.ТМЦ = Константа.НоменклатураДляННПоРознице;
				Пр2.Кво = 1;
				глУстановкаБазЕд(Пр2,Пр2.ТМЦ);
				Пр2.ИзмСуммыБезНДС = - (Розн.ВозвратБазаНДС_20 - Розн.ВозвратНДС_20);
				Пр2.ИзмНДС = - Розн.ВозвратНДС_20;
				Пр2.ИзмСуммыСНДС = -Розн.ВозвратБазаНДС_20;
				Пр2.ЦенаБезНДС = -Пр2.ИзмСуммыБезНДС;
				Пр2.ЦенаСНДС = -Пр2.ИзмСуммыСНДС;
				
				Пр2.Причина = "Возврат товара";
				
				Пр2.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(Пр2.ТекущийДокумент());
				
				глКомментарий("Сформировано приложение 2 по ставке НДС 20%");
				
			Иначе
				
				глКомментарий("По ставке НДС 20% возвратов не было");	
				
			КонецЕсли;
			
			Если Розн.ВозвратБазаНДС_7 > 0 Тогда
				
				Пр2 = СоздатьОбъект("Документ.Приложение2");
				Пр2.Новый();
				
				Если ЗаполнитьШапкуПриложения(Пр2, Розн.ДатаВозврата, НДС_7) = 0 Тогда
					Продолжить
				КонецЕсли;
				
				Пр2.НоваяСтрока();
				Пр2.ТМЦ = Константа.НоменклатураДляННПоРознице;
				Пр2.Кво = 1;
				глУстановкаБазЕд(Пр2,Пр2.ТМЦ);
				Пр2.ИзмСуммыБезНДС = - (Розн.ВозвратБазаНДС_7 - Розн.ВозвратНДС_7);
				Пр2.ИзмНДС = - Розн.ВозвратНДС_7;
				Пр2.ИзмСуммыСНДС = -Розн.ВозвратБазаНДС_7;
				Пр2.ЦенаБезНДС = -Пр2.ИзмСуммыБезНДС;
				Пр2.ЦенаСНДС = -Пр2.ИзмСуммыСНДС;
				
				Пр2.Причина = "Возврат товара";
				
				Пр2.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(Пр2.ТекущийДокумент());
				
				глКомментарий("Сформировано приложение 2 по ставке НДС 7%");
				
			Иначе
				
				глКомментарий("По ставке НДС 7% возвратов не было");	
				
			КонецЕсли;

			Если Розн.ВозвратБазаНДС_0 > 0 Тогда  
				
				Пр2 = СоздатьОбъект("Документ.Приложение2");
				Пр2.Новый();
				
				Если ЗаполнитьШапкуПриложения(Пр2, Розн.ДатаВозврата, НДС_0) = 0 Тогда
					Продолжить
				КонецЕсли;
				
				Пр2.НоваяСтрока();
				Пр2.ТМЦ = Константа.НоменклатураДляННПоРознице;
				Пр2.Кво = 1;
				глУстановкаБазЕд(Пр2,Пр2.ТМЦ);
				Пр2.ИзмСуммыБезНДС = - (Розн.ВозвратБазаНДС_0 - Розн.ВозвратНДС_0);
				Пр2.ИзмНДС = - Розн.ВозвратНДС_0;
				Пр2.ИзмСуммыСНДС = - Розн.ВозвратБазаНДС_0;
				Пр2.ЦенаБезНДС = -Пр2.ИзмСуммыБезНДС;
				Пр2.ЦенаСНДС = -Пр2.ИзмСуммыСНДС;
				
				Пр2.Причина = "Возврат товара";
				
				Пр2.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(Пр2.ТекущийДокумент());
				
				глКомментарий("Сформировано приложение 2 по ставке НДС 0%");
				
			Иначе
				
				глКомментарий("По ставке НДС 0% возвратов не было");	
				
			КонецЕсли;
			
			Если Розн.ВозвратБазаНДС_БезНДС > 0 Тогда
				
				Пр2 = СоздатьОбъект("Документ.Приложение2");
				Пр2.Новый();
				
				Если ЗаполнитьШапкуПриложения(Пр2, Розн.ДатаВозврата, НДС_0) = 0 Тогда
					Продолжить
				КонецЕсли;
				
				Пр2.НоваяСтрока();
				Пр2.ТМЦ = Константа.НоменклатураДляННПоРознице;
				Пр2.Кво = 1;
				глУстановкаБазЕд(Пр2,Пр2.ТМЦ);
				Пр2.ИзмСуммыБезНДС = - (Розн.ВозвратБазаНДС_БезНДС + Розн.ВозвратНДС_БезНДС);
				Пр2.ИзмНДС = -Розн.ВозвратНДС_БезНДС;
				Пр2.ИзмСуммыСНДС = -Розн.ВозвратБазаНДС_БезНДС;
				Пр2.ЦенаБезНДС = -Пр2.ИзмСуммыБезНДС;
				Пр2.ЦенаСНДС = -Пр2.ИзмСуммыСНДС;
				
				Пр2.Причина = "Возврат товара";
				
				Пр2.Записать();
				// откроем форму документа, не проводя его
				ОткрытьФорму(Пр2.ТекущийДокумент());
				
				глКомментарий("Сформировано приложение 2 по ставке НДС ""Без НДС""");
				
			Иначе
				
				глКомментарий("По ставке НДС ""Без НДС"" возвратов не было");
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// ===============================
Процедура ПриОткрытии()
	
	Фирма = глВосстановитьЗначение(,"БазФирма");
	Если Метаданные.РазделительУчета.Выбран() = 0 Тогда
		Форма.Фирма.Видимость(0);
		Форма.тФирма.Видимость(0);
	КонецЕсли;

	ДатаЗапроса = РабочаяДата();
		
КонецПроцедуры