		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00024") = 0 Тогда
		Спр.Новый();
