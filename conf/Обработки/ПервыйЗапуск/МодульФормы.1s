		Спр.ПолнНаименование = "Частичная отгрузка товара";
		Спр.ВидТМЦ = Перечисление.ВидыТМЦ.Товар;
		Спр.Счет = СчетПоКоду("28.1");
		Спр.Родитель = ТекущийРодитель;
		Спр.ВидДеятельности = БазВидДеятельности;
		Спр.СтавкаНДС = БазСтавкаНДС;
