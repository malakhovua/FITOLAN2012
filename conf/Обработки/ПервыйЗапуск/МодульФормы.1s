КонецПроцедуры

// ===============================
Процедура ЗаполнитьНазначенияПлатежей()
	СпрНП = СоздатьОбъект("Справочник.НазначенияПлатежей");
		
	Имя = "Уплата налогов";
	Если СпрНП.НайтиПоНаименованию(Имя,0,1) = 0 Тогда
		СпрНП.Новый();
		СпрНП.Наименование = Имя;
		СпрНП.ПолнНаименование = "*;101;[Фирма.ЕДРПОУ];[ВидНалога.Содержание];;;";
		СпрНП.Шаблон = 1;
		СпрНП.Записать();
	КонецЕсли;
	
	Имя = "Уплата налогов (старый формат)";
	Если СпрНП.НайтиПоНаименованию(Имя,0,1) = 0 Тогда
		СпрНП.Новый();
		СпрНП.Наименование = Имя;
		СпрНП.ПолнНаименование = "+;[Фирма.НалоговаяИнспекция.Получить(ДатаДок).Код];101; ; ; ;[Формат(КонМесяца(ДобавитьМесяц(ДатаДок,-1)),""ДДДММГГГГ"")]; ;[ВидНалога.Содержание]";
		СпрНП.Шаблон = 1;
		СпрНП.Записать();
	КонецЕсли;
КонецПроцедуры

//========================================
Процедура ЗаполнитьСтатьиНалоговыхДеклараций()
	Перем Обл;
	Перем ПолныйКод, КодРодителя, Код, Наим, Гр;
	
	СпрСтНД = СоздатьОбъект("Справочник.СтатьиНалоговыхДеклараций");
	
	Таб=СоздатьОбъект("Таблица");
	Таб.ИсходнаяТаблица("СтатьиДекларации"); //Берем структуру добавляемых элементов из таблицы
	Таб.Вывести();
    	
	Сч=2;
	Пока Сч>0 Цикл
		Обл=Таб.Область(Сч,1);
		Код=Обл.Текст;
		Обл=Таб.Область(Сч,2);
		Наим=Обл.Текст;
		Обл=Таб.Область(Сч,3);
		Гр=Обл.Текст;
		
		Если Код="" Тогда
			Прервать;//дошли до конца таблицы
		КонецЕсли;	
        
		ПолныйКод=Код;
		РазделитьКод(Код, КодРодителя);
		
		СпрСтНД.НайтиПоКоду(КодРодителя);
		ТекущийРодитель = СпрСтНД.ТекущийЭлемент();
		
		Если СпрСтНД.НайтиПоКоду(ПолныйКод) = 0 Тогда
			Если Гр="г" тогда
				СпрСтНД.НоваяГруппа(); //это группа
			Иначе
				СпрСтНД.Новый();       //это просто элемент
			КонецЕсли;
			СпрСтНД.Код = Код;
			СпрСтНД.Наименование = Наим;
			Если КодРодителя<>0 Тогда //если это не верхний в иерархии
				СпрСтНД.Родитель = ТекущийРодитель;
			КонецЕсли;	
			СпрСтНД.Записать();
		КонецЕсли;	
		
		Сч=Сч+1;
	КонецЦикла;
    	
КонецПроцедуры

//========================================
Процедура ЗаполнитьКонстанты()
	Состояние("Заполняются константы..."); 
	
	ЗаполнитьСправочникиДляКонстант();
	
	СпрВал = СоздатьОбъект("Справочник.Валюты");
	СпрТМЦ = СоздатьОбъект("Справочник.ТМЦ");
	СпрНиО = СоздатьОбъект("Справочник.ШкалаСтавок");
	СпрВЗ = СоздатьОбъект("Справочник.ВидыЗатрат");
	СпрВД = СоздатьОбъект("Справочник.ВидыДеятельности");
	СпрФир = СоздатьОбъект("Справочник.Фирмы");
	СпрГФП = СоздатьОбъект("Справочник.ГрафикиФормированияПартий");
	
	
	Константа.НомерРелиза = Лев(Метаданные.Константа("НомерРелиза").Комментарий,8);
	Константа.ВыдаватьСообщения = 1;
	Константа.ФлагЗащитыТаблиц = 1;
	Константа.ФормыНаУкраинском = Да;
	Константа.ДатаНачалаРаботы = НачГода(РабочаяДата());
	Константа.ДатаЗапретаРедактирования = Дата(1980,1,1);
	
	Константа.ЗапрашиватьКоличество = Да;
	Константа.ПроводкиПоКассеТолькоОрдерами = Да;
	                  
	СпрЕД = СоздатьОбъект("Справочник.КлассификаторЕдИзм");
	Если СпрЕД.НайтиПоНаименованию("шт") = 1 Тогда
		Константа.БазЕдиница = СпрЕД.ТекущийЭлемент();
	КонецЕсли;  
	Если СпрЕД.НайтиПоНаименованию("кг") = 1 Тогда
		Константа.ЕдиницаВеса = СпрЕД.ТекущийЭлемент();
	КонецЕсли;
	Если СпрТМЦ.НайтиПоКоду("00013") = 1 Тогда
	    Константа.АвансовыйПлатеж = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрТМЦ.НайтиПоКоду("00014") = 1 Тогда
	    Константа.ЧастичнаяОтгрузка = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли; 
	Если СпрТМЦ.НайтиПоКоду("00015") = 1 Тогда
	    Константа.ТоварыВАссортименте = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли; 
	Если СпрТМЦ.НайтиПоКоду("00015") = 1 Тогда
	    Константа.НоменклатураДляННПоРознице = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли; 
	Если СпрТМЦ.НайтиПоКоду("00016") = 1 Тогда
	    Константа.КурсоваяРазница = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли;

	Константа.ВыделятьАвансы = Да;
	ИспользоватьСчетаРасходов = Класс89;
	
	Если СпрВД.НайтиПоКоду(1) = 1 Тогда
		Константа.БазВидДеятельности = СпрВД.ТекущийЭлемент();
	КонецЕсли;

    Если СпрФир.НайтиПоКоду("00000") = 1 Тогда
		Константа.БазФирма = СпрФир.ТекущийЭлемент();
	КонецЕсли;
	
	Если СпрНиО.НайтиПоКоду("НДС20") = 1 Тогда
	    Константа.БазНДС = СпрНиО.ТекущийЭлемент();
	КонецЕсли;
	
	Если СпрВал.НайтиПоКоду("980") = 1 Тогда
	    Константа.БазоваяВалюта = СпрВал.ТекущийЭлемент();
	КонецЕсли;
	
	Константа.ПроверятьДублиСтрок = Да;
	Константа.РазрешитьОтрицОстатки = Нет;
	Константа.РезервироватьТоварНаСегодня = Нет;
	Константа.РезервироватьТолькоСвободныйТовар = Нет;
	Константа.ПоказыватьОстаткиТМЦ = Да;
	Константа.ИспользоватьСкидку = Да;
	Константа.ИспользоватьСписокКорректныхПроводок = Да;
	Константа.НДСПоВходящимНН = Нет;
	
	Если СпрТМЦ.НайтиПоКоду("00011") = 1 Тогда
	    Константа.ТМЦБланкиСтрогойОтчетности = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрТМЦ.НайтиПоКоду("00012") = 1 Тогда
	    Константа.СлужебныйТМЦ = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрТМЦ.НайтиПоКоду("00017") = 1 Тогда
	    Константа.НалоговыйТЗРМатериалы = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрТМЦ.НайтиПоКоду("00018") = 1 Тогда
	    Константа.НалоговыйТЗРТовары = СпрТМЦ.ТекущийЭлемент();
	КонецЕсли;
    
	Если СпрВЗ.НайтиПоКоду("00016") = 1 Тогда
	    Константа.ВидЗатратОперКР = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00020") = 1 Тогда
	    Константа.ВидЗатратНеоперКР = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00071") = 1 Тогда
		Константа.ВидЗатратСебестРеалВалюты = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00011") = 1 Тогда
		Константа.ВидЗатратСебестРеалПроизвЗапасов = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00012") = 1 Тогда
		Константа.ВидЗатратСебестРеалПокупныхЗапасов = СпрВЗ.ТекущийЭлемент();
		Константа.ВидЗатратВозврат = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	
	Константа.ОсновнойВидТорговли = Перечисление.ВидыТорговли.Кредит;
	Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаБезНДС;
	Константа.ЦеныВНакладных = Перечисление.ВариантыОтображенияЦенВНакладных.ОбеЦены;
	Константа.ОсновнаяДатаНачалаОтчета = НачГода(РабочаяДата());
	Константа.ПодставлятьОсновнойДоговор = Нет;
	Константа.РазрешитьПревышениеКредита = Нет;
	Константа.РазрешитьПродаватьРезерв = Нет;
	
	Константа.РассчитыватьЗарплатуВКонфигурации = 1;
	Константа.ОтражатьТЗРвОборотах = 1;
	Константа.ОтражатьКурсовуюРазницуВОборотах = 1;
	Константа.ОтражатьФактСебестВОборотах = 2;
	Если СпрВЗ.НайтиПоКоду("00297") = 1 Тогда
		Константа.ВидЗатратСоцОтчислАдминистр = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00043") = 1 Тогда
		Константа.ВидЗатратСоцОтчислСбыт = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00298") = 1 Тогда
		Константа.ВидЗатратСоцОтчислОбщепр = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	Если СпрВЗ.НайтиПоКоду("00299") = 1 Тогда
		Константа.ВидЗатратСоцОтчислПроизв = СпрВЗ.ТекущийЭлемент();
	КонецЕсли;
	
	Константа.СпособПриходованияПродукции = Перечисление.СпособыПриходованияПродукции.ПоПлановойСебестоимости;
	Константа.МетодРасчетаСебестоимостиПродукции.Установить(Константа.ДатаНачалаРаботы,Перечисление.МетодыРасчетаСебестоимости.ПоСреднему);
	Константа.МетодРасчетаСебестоимостиПроизводственныхЗапасов.Установить(Константа.ДатаНачалаРаботы,Перечисление.МетодыРасчетаСебестоимости.ПоСреднему);
	Константа.МетодРасчетаСебестоимостиТоваров.Установить(Константа.ДатаНачалаРаботы,Перечисление.МетодыРасчетаСебестоимости.ПоСреднему);
	
	Константа.ФИОПолностью = Нет;
	
	Константа.ИспользоватьОбеспечениеОтпусков.Установить('01.01.1980', Нет);
	
	Константа.ИспользоватьСпецСчетаПоНДС.Установить('01.01.80',Нет);
	Константа.ИспользоватьВозвратНДСВРознице.Установить('01.01.80',Нет);
	
	Константа.ОтдельныеППДляСпецСчетовПоНДС = 1;
	
	Константа.ОСУчитываемыеКакЗапасыСписыватьПриВводе = Да;
    Константа.ДатаПоследнегоОбновленияВалют = ТекущаяДата() - 30;
	
	СпрГФП.ВыбратьЭлементы();
	ЕстьГрафик = 0;
	Пока СпрГФП.ПолучитьЭлемент() = 1 Цикл
		Если СпрГФП.ЭтоГруппа() = 1 Тогда
			Продолжить
		КонецЕсли;
		Если СпрГФП.ЧастотаФормированияПартий = Перечисление.СпособыФормированияПартий.Ежемесячно Тогда
			ЕстьГрафик = 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьГрафик = 0 Тогда
		// нет подходящего графика
		СпрГФП.Новый();
		СпрГФП.Наименование = "Ежемесячно";
		СпрГФП.ЧастотаФормированияПартий = Перечисление.СпособыФормированияПартий.Ежемесячно;
		СпрГФП.Записать();
	КонецЕсли;
	Константа.БазГрафикФормированияПартий = СпрГФП.ТекущийЭлемент();
	Константа.ПустаяЯчейкаНалДок = "Х";
	Константа.МетодРасчетаНДФЛ = Нет;
	Константа.ВидНомДоговНН = 1;
	Константа.ЗапретПроведенияДоАпреля2011 = Нет;
	Константа.ДатаПереходаНаСчет378ФСС = '01.07.11';
	Константа.АмортизацияБУизНУ = Нет;
	Константа.НераспредПостОПЗвНУ = Нет;
	Константа.ДатаННДек2011 = '16.12.11';
	Константа.ПечататьДатыВННСРазд = Нет;
	Константа.НеДополнНаимНомГТДВНН = Нет;
	Константа.ДатаНачалаПереоценкиВалютыВПределахСуммыОперации = '01.10.2013';;
	Константа.ПечататьННПоФормеНаДатуДокумента = Нет;

	Константа.ПорогИндексацииПомесячно = Да;
	
КонецПроцедуры
                               
// ===============================
Процедура ПриОткрытии(ФлагЧтенияНастройки)
	
	НачатьТранзакцию();
	
	// значение параметра формы:
	// 1 - открываем при первом запуске из глобального модуля
	// 0 - открываем "вручную" из списка обработок
	
	ОшибкаЗаполнения = 0;
	ЗаполнитьПланСчетов();
	
	Если Число(Форма.Параметр) = 1 Тогда
		Константа.НомерРелиза = Лев(Метаданные.Константа("НомерРелиза").Комментарий,8);
		
		ЗаполнитьСтатьиКалькуляции(); 

		ЗаполнитьСтатьиНалоговыхДеклараций();  
		
		ЗаполнитьВидыЗатрат(); 
		
		ЗаполнитьВидыДеятельности();

		ЗаполнитьНалоговыеИнспекции();

		ЗаполнитьШкалаСтавок();
		
		ЗаполнитьСловарь();
		
		ЗаполнитьЕдиницы();
		
		ЗаполнитьНазначенияПлатежей();
		
		ЗаполнитьКонстанты(); 
		
	КонецЕсли;
	
	Если ОшибкаЗаполнения>0 Тогда
		// при заполнении произошла ошибка, отменим все сделанные изменения
		глКомментарий("Не удалось выполнить первоначальное заполнение справочников!!!",0);
		ОтменитьТранзакцию();     
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;	
	
	СтатусВозврата(0);
КонецПроцедуры
