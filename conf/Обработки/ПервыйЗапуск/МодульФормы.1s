		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/4");
		//Винагорода за консультаційні, інформаційні, аудиторські та інші послуги
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00025") = 0 Тогда
		Спр.Новый();
		Спр.Код = "00025";
		Спр.Наименование = "Затраты на связь";
		Спр.ПолнНаименование = "Затраты на связь";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/5");
		//Витрати на оплату послуг зв'язку
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00026") = 0 Тогда
		Спр.Новый();
		Спр.Код = "00026";
		Спр.Наименование = "Урегулирование споров в судах";
		Спр.ПолнНаименование = "Расходы на урегулирование споров в судах";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/7");
		//Витрати на врегулювання спорів у судах
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00027") = 0 Тогда
		Спр.Новый();
		Спр.Код = "00027";
		Спр.Наименование = "Услуги банков";
		Спр.ПолнНаименование = "Услуги банков";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/8");
		//Плата за розрахунково-касове обслуговування та інші послуги банків
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00028") = 0 Тогда
		Спр.Новый();
		Спр.Код = "00028";
		Спр.Наименование = "Затраты на страхование";
		Спр.ПолнНаименование = "Затраты на страхование";
		Спр.Счет = СчетПоКоду("824");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/9");
		//Витрати на страхування
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00031") = 0 Тогда
		Спр.Новый();
		Спр.Код = "00031";
		Спр.Наименование = "Прочие общехоз. затраты";
		Спр.ПолнНаименование = "Прочие общехозяйственные затраты";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/12");
		//Інші витрати загальногосподарського призначення
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("00004") = 0 Тогда
		Спр.НоваяГруппа();
		Спр.Код = "00004";
		Спр.Наименование = "Затраты на сбыт";
		Спр.Родитель = Спр.ТекущийЭлемент();
		Спр.Записать();
	КонецЕсли;
	ТекущийРодитель = Спр.ТекущийЭлемент();
	Если Спр.НайтиПоКоду("00040") = 0 Тогда
		Спр.Новый();
		Спр.Код = "00040";
