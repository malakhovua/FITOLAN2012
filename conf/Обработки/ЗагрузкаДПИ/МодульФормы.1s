//---------------------------------
Процедура ИзменитьФайл(Рекв)
	ИмяФайла="";
	Путь=Рекв;
	Пока СтрДлина(Путь) > 0 Цикл
		Символ = Сред(Путь, СтрДлина(Путь), 1);
		Если Символ = "\" Тогда
			Прервать
		Иначе
			ИмяФайла= Символ + ИмяФайла;
			Путь=Лев(Путь, СтрДлина(Путь)-1);
		КонецЕсли;
	КонецЦикла;
	ФС.ВыбратьФайл(0,ИмяФайла, Путь, "Укажите файл, содержащий список ДПІ");
	Рекв = Путь + ИмяФайла;
КонецПроцедуры

//---------------------------------
Процедура Сформировать()

	Если ФС.СуществуетФайл(ФайлСписокДПИ) = 0 Тогда
	    глКомментарий("Файл "+ ФайлСписокДПИ+ " не найден!", 0,,"!");
		Возврат;
	КонецЕсли;

	СпрНИ = СоздатьОбъект("Справочник.НалоговыеИнспекции");

	Анализатор = СоздатьОбъект("AddIn.XMLParser");
	гДокДанных = Анализатор.СоздатьДокумент();
	
    Попытка
		гДокДанных.Загрузить(ФайлСписокДПИ);
	Исключение
		Сообщить("Операция не вполнена: "+ ОписаниеОшибки());
		Сообщить("Возможно файл "+ФайлСписокДПИ+" поврежден");
		Возврат
	КонецПопытки;
	
	УзелУр1 = гДокДанных.ЭлементДокумента;
	КвоОбработано = 0;
	Для Инд1 = 1 по УзелУр1.КоличествоПодчиненных() Цикл
		// УзелУр2 - это регионы
		УзелУр2 = УзелУр1.ПолучитьПодчиненныйПоНомеру(Инд1);
		КодРегиона = "";
		ИмяРегиона = "";
		Для Инд2 = 1 по УзелУр2.КоличествоПодчиненных() Цикл
			// УзелУр3 - это реквизиты регионов
			УзелУр3 = УзелУр2.ПолучитьПодчиненныйПоНомеру(Инд2);
			Если УзелУр3.Наименование = "C_REG" Тогда
				КодРегиона = УзелУр3.Значение;
				Если СтрДлина(КодРегиона) = 1 Тогда
					//дополним до 2 символов
					КодРегиона = "0"+КодРегиона;
				КонецЕсли;
			ИначеЕсли УзелУр3.Наименование = "NAME_REG" Тогда
				ИмяРегиона = УзелУр3.Значение;
				Состояние("Загружается область: " + ИмяРегиона);
    		ИначеЕсли УзелУр3.Наименование = "SET_STI" Тогда
				// список налоговых
				// создадим (или найдем) группу - регион для записи подчиненных
				Если СпрНИ.НайтиПоКоду(КодРегиона) = 0 Тогда
					СпрНИ.НоваяГруппа();
   					СпрНИ.Наименование = ИмяРегиона;
					СпрНИ.Код = КодРегиона;
					СпрНИ.Записать();
				ИначеЕсли НеОбновлять = 0 Тогда
					СпрНИ.Наименование = ИмяРегиона;
					СпрНИ.Записать();
				КонецЕсли;
				
				РодительДляНИ = СпрНИ.ТекущийЭлемент();
				Для Инд3 = 1 по УзелУр3.КоличествоПодчиненных() Цикл
					// УзелУр4 - это налоговые
					УзелУр4 = УзелУр3.ПолучитьПодчиненныйПоНомеру(Инд3);
					КодРайона = "";
					ИмяРайона = "";
					КодДПИ = "";
					ИмяДПИ = "";
					ТипДПИ = "";
					Для Инд4 = 1 по УзелУр4.КоличествоПодчиненных() Цикл
						// УзелУр5 - это реквизиты налоговой
						УзелУр5 = УзелУр4.ПолучитьПодчиненныйПоНомеру(Инд4);
						Если УзелУр5.Наименование = "C_STI" Тогда
							// код ДПИ
							КодДПИ = Строка(УзелУр5.Значение);
							Если СтрДлина(КодДПИ) = 3 Тогда
								//дополним до 4 символов
								КодДПИ = "0"+КодДПИ;
							КонецЕсли;
						ИначеЕсли УзелУр5.Наименование = "T_STI" Тогда
							// тип ДПИ
							ТипДПИ = УзелУр5.Значение;
						ИначеЕсли УзелУр5.Наименование = "NAME_STI" Тогда
							// имя ДПИ
							ИмяДПИ = УзелУр5.Значение;
						ИначеЕсли УзелУр5.Наименование = "C_RAJ" Тогда
							// код района
							КодРайона = Строка(УзелУр5.Значение);
							Если СтрДлина(КодРайона) = 1 Тогда
								//дополним до 2 символов
								КодРайона = "0"+КодРайона;
							КонецЕсли;
						ИначеЕсли УзелУр5.Наименование = "NAME_RAJ" Тогда
							// имя района
							ИмяРайона = УзелУр5.Значение;
						КонецЕсли;
					КонецЦикла;
					//Найдем или создадим новую ДПИ
					Если СпрНИ.НайтиПоРеквизиту("КодДляПоиска", КодДПИ+КодРайона, 1) = 0 Тогда
						СпрНИ.Новый();
						СпрНИ.Код = КодДПИ;
						СпрНИ.КодАдмРайона = КодРайона;
						СпрНИ.КодДляПоиска = КодДПИ+КодРайона;
					ИначеЕсли НеОбновлять = 1 Тогда
					    Продолжить
					КонецЕсли;
					СпрНИ.Наименование = ИмяДПИ;
					СпрНИ.НаименованиеАдмРайона = ИмяРайона;
					СпрНИ.ТипДПИ = ТипДПИ;
					СпрНИ.Родитель = РодительДляНИ;
					СпрНИ.Записать();
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

//---------------------------------
Процедура ПриОткрытии()
    ФайлСписокДПИ = КаталогИБ()+"ExtForms\str_sti.xml";

	Если ТипЗначенияСтр(Форма.Параметр)<>"СписокЗначений" Тогда
		Возврат;
	КонецЕсли;
	
	СтатусВозврата(0);//форму открывать не будем
	спРасшифровка = Форма.Параметр;
	НеОбновлять = спРасшифровка.Получить("НеОбновлять");
	ФайлСписокДПИ = спРасшифровка.Получить("ФайлСписокДПИ");
	
	Сформировать()
КонецПроцедуры

Если ЗагрузитьВнешнююКомпоненту(КаталогИБ() + "v7plus.dll") <> 1 Тогда
	Если ЗагрузитьВнешнююКомпоненту(КаталогИБ() + "ExtForms\" + "v7plus.dll") <> 1 Тогда		
		Если ЗагрузитьВнешнююКомпоненту(КаталогПрограммы() + "v7plus.dll") <> 1 Тогда
			Предупреждение("Компонента v7plus.dll не найдена!");
		КонецЕсли;	
	КонецЕсли;
КонецЕсли;    
