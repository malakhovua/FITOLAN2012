//========================================
Процедура ЗаполнитьСтатьиДоходов()
	СпрСтНД = СоздатьОбъект("Справочник.СтатьиНалоговыхДеклараций");
	      
	СпрСтНД.НайтиПоКоду(1); 
	РодительНК = СпрСтНД.ТекущийЭлемент();
	СпрСтНД.ИспользоватьРодителя(РодительНК);

	Если СпрСтНД.НайтиПоКоду("1/10") = 0 Тогда
		СпрСтНД.Новый();
		СпрСтНД.Код = 10;
		СпрСтНД.Родитель = РодительНК;
		СпрСтНД.Наименование = "(02) Доход операційної діятельності (реалізація товарів, робіт, послуг)";
		СпрСтНД.Записать();
	КонецЕсли;   
	
	Если СпрСтНД.НайтиПоКоду("1/3") = 0 Тогда
		СпрСтНД.НоваяГруппа();
		СпрСтНД.Код = 3;
		СпрСтНД.Родитель = РодительНК;
		СпрСтНД.Наименование = "(ІД) Інші доходи";
		СпрСтНД.Записать();
	КонецЕсли;
	текРодитель = СпрСтНД.ТекущийЭлемент();
		Если СпрСтНД.НайтиПоКоду("1/3/1") = 0 Тогда
			СпрСтНД.Новый();
			СпрСтНД.Код = 1;
			СпрСтНД.Родитель = текРодитель;
			СпрСтНД.Наименование = "(ІД.1) Дивіденти отримані";
			СпрСтНД.Записать();
		КонецЕсли;    	
		Если СпрСтНД.НайтиПоКоду("1/3/2") = 0 Тогда
			СпрСтНД.Новый();
			СпрСтНД.Код = 2;
