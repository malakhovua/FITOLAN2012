//========================================
Процедура ЗаполнитьКодЕдИзм()

	СпрЕдИзм = СоздатьОбъект("Справочник.КлассификаторЕдИзм");
	СпрЕдИзм.ВыбратьЭлементы(0);  
	Сообщить("Выполняется заполнение кодов единиц измерения в справочнике ""Единицы измерения"".");

	Пока СпрЕдИзм.ПолучитьЭлемент() = 1 Цикл  
		Элем = СпрЕдИзм.ТекущийЭлемент();
			// пытаемся определить код единицы по классификатору
		КодЕдИзмерения = "";
		НовЕд = Элем.Наименование;
		Если (СокрЛП(НовЕд) = "шт") или (СокрЛП(НовЕд) = "шт.") Тогда
			КодЕдИзмерения = "2009";	
		ИначеЕсли (СокрЛП(НовЕд) = "кг") или (СокрЛП(НовЕд) = "кг.") Тогда
			КодЕдИзмерения = "0301";	
		ИначеЕсли (СокрЛП(НовЕд) = "м") или (СокрЛП(НовЕд) = "м.") или (СокрЛП(НовЕд) = "метр") Тогда
			КодЕдИзмерения = "0101";	
		ИначеЕсли (СокрЛП(НовЕд) = "л") или (СокрЛП(НовЕд) = "л.") или (СокрЛП(НовЕд) = "литр") Тогда
			КодЕдИзмерения = "0138";	
		ИначеЕсли (СокрЛП(НовЕд) = "комплект") или (СокрЛП(НовЕд) = "компл.") или (СокрЛП(НовЕд) = "компл")  Тогда
			КодЕдИзмерения = "2938";	
		ИначеЕсли (СокрЛП(НовЕд) = "ящик") или (СокрЛП(НовЕд) = "ящ.") или (СокрЛП(НовЕд) = "ящ") Тогда
			КодЕдИзмерения = "2075";	
		ИначеЕсли (СокрЛП(НовЕд) = "тонна") или (СокрЛП(НовЕд) = "т.") или (СокрЛП(НовЕд) = "т") Тогда
			КодЕдИзмерения = "0306";	
		ИначеЕсли (СокрЛП(НовЕд) = "упаковка") или (СокрЛП(НовЕд) = "пак.") или (СокрЛП(НовЕд) = "уп.") или 
			(СокрЛП(НовЕд) = "пак") или (СокрЛП(НовЕд) = "пакунок") Тогда
			КодЕдИзмерения = "2110";	
		ИначеЕсли (СокрЛП(НовЕд) = "пачка") или (СокрЛП(НовЕд) = "пач.") или (СокрЛП(НовЕд) = "пач") Тогда
			КодЕдИзмерения = "2112";	
		ИначеЕсли (СокрЛП(НовЕд) = "блок") Тогда
			КодЕдИзмерения = "2907";	
		ИначеЕсли (СокрЛП(НовЕд) = "коробка") или (СокрЛП(НовЕд) = "кор.") или (СокрЛП(НовЕд) = "кор") Тогда
			КодЕдИзмерения = "2052";	
		ИначеЕсли (СокрЛП(НовЕд) = "км") или (СокрЛП(НовЕд) = "км.") Тогда
			КодЕдИзмерения = "0102";	
		ИначеЕсли (СокрЛП(НовЕд) = "м.кв") или (СокрЛП(НовЕд) = "м.кв.") Тогда
			КодЕдИзмерения = "0123";	
		ИначеЕсли (СокрЛП(НовЕд) = "м.куб") или (СокрЛП(НовЕд) = "м.куб.") Тогда
			КодЕдИзмерения = "0134";	
		ИначеЕсли (СокрЛП(НовЕд) = "пог. м") или (СокрЛП(НовЕд) = "пог. м.") или (СокрЛП(НовЕд) = "пог.м") или 
				(СокрЛП(НовЕд) = "м.п.") или (СокрЛП(НовЕд) = "м.п") Тогда
			КодЕдИзмерения = "2702";	
		ИначеЕсли (СокрЛП(НовЕд) = "грн") Тогда
			КодЕдИзмерения = "2454";	
		ИначеЕсли (СокрЛП(НовЕд) = "рул") или (СокрЛП(НовЕд) = "рул.") или (СокрЛП(НовЕд) = "рулон") Тогда
			КодЕдИзмерения = "2116";	
		ИначеЕсли (СокрЛП(НовЕд) = "час") или (СокрЛП(НовЕд) = "ч.") или (СокрЛП(НовЕд) = "ч") или 
			(СокрЛП(НовЕд) = "год.") или (СокрЛП(НовЕд) = "год") Тогда
			КодЕдИзмерения = "0175";	
		ИначеЕсли (Врег(СокрЛП(НовЕд)) = "КВ/Ч") или (Врег(СокрЛП(НовЕд)) = "КВ/Ч.") или (Врег(СокрЛП(НовЕд)) = "КВТ*ГОД") или 
			(Врег(СокрЛП(НовЕд))= "КВТ*Г") или (Врег(СокрЛП(НовЕд)) = "КВТ/ГОД") или (Врег(СокрЛП(НовЕд)) = "КВТ/Г") Тогда
			КодЕдИзмерения = "0415";	
		КонецЕсли;
		СпрЕдИзм.КодЕдИзмерения = КодЕдИзмерения;
		СпрЕдИзм.КодЕдИзмерения = КодЕдИзмерения;
		СпрЕдИзм.Записать();
    КонецЦикла;
   	
КонецПроцедуры
//========================================
Процедура ЗаполнитьВидыЗатрат()
	Состояние("Заполняется справочник виды затрат...");
	Спр = СоздатьОбъект("Справочник.ВидыЗатрат");
	СпрСК = СоздатьОбъект("Справочник.СтатьиКалькуляции");
	СпрСтНД = СоздатьОбъект("Справочник.СтатьиНалоговыхДеклараций");
	
	ТекущийРодитель = 0;
	Если Спр.НайтиПоКоду("10000") = 0 Тогда  
		Спр.НоваяГруппа();
		Спр.Код = "10000";
	КонецЕсли; 
	Спр.Наименование = "Статьи затрат по налогу на прибыль"; 
	Спр.Записать();             
	
	РодительНК = Спр.ТекущийЭлемент();
	Спр.ИспользоватьРодителя(РодительНК);
	Если Спр.НайтиПоКоду("10001",1) = 0 Тогда  
		Спр.НоваяГруппа();
		Спр.Код = 10001;
		Спр.Наименование = "Прочие операционные затраты"; 
		Спр.Родитель = РодительНК;
		Спр.Записать();
	КонецЕсли;  
	ТекущийРодитель = Спр.ТекущийЭлемент();
	Если Спр.НайтиПоКоду("10011",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10011;
		Спр.Наименование = "Себест. реализов. продукции";
		Спр.ПолнНаименование = "Себестоимость реализованной продукции (работ, услуг) ";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/5/1");
		//Собівартість реалізованої продукції, робіт, послуг власного виробництва     
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10012",1) = 0 Тогда 
		Спр.Новый();
		Спр.Код = 10012;
		Спр.Наименование = "Себест.реализов.покупных запасов";
		Спр.ПолнНаименование = "Себестоимость реализованных покупных запасов ";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/5/2");
		//Собівартість реалізованих покупних запасів     
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду(10071,1) = 0 Тогда 
		Спр.Новый();
		Спр.Код = "10071";
		Спр.Наименование = "Себест.реализов.валюты";
		Спр.ПолнНаименование = "Себестоимость реализованной валюты";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 0;
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10002",1) = 0 Тогда
		Спр.НоваяГруппа();
		Спр.Код = 10002;
		Спр.Наименование = "Административные затраты";
		Спр.Родитель = РодительНК;
		Спр.Записать();
	КонецЕсли;  
	ТекущийРодитель = Спр.ТекущийЭлемент();
	Если Спр.НайтиПоКоду("10021",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10021;
		Спр.Наименование = "Общие корпоративные затраты";
		Спр.ПолнНаименование = "Общие корпоративные затраты";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;  
		СпрСтНД.НайтиПоКоду("1/62/1");
		//Загальні корпоративні витрати
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10022",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10022;
		Спр.Наименование = "Командировки и содержание аппарата";
		Спр.ПолнНаименование = "Затраты на служебные командировки и содержание аппарата";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;  
		СпрСтНД.НайтиПоКоду("1/62/2");
		//Витрати на службові відрядження й утримання апарату
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10023",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10023;
		Спр.Наименование = "Содержание общехоз. ОС, НМА и пр.";
		Спр.ПолнНаименование = "Содержание общехозяйственных ОС, НМА, прочих необоротных активов";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСК.НайтиПоНаименованию("Расходы на содержание оборудования",0,1);
		Спр.СтатьяКалькуляции = СпрСК.ТекущийЭлемент();
		СпрСтНД.НайтиПоКоду("1/62/3");
		//Витрати на утримання осн.засобів, інших необ.мат. активів загальногосп. вик-ня
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10024",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10024;
		Спр.Наименование = "Косульт., информац. и др.услуги";
		Спр.ПолнНаименование = "Косультационные, информационные, аудиторские и др.услуги";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/4");
		//Винагорода за консультаційні, інформаційні, аудиторські та інші послуги
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10025",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10025;
		Спр.Наименование = "Затраты на связь";
		Спр.ПолнНаименование = "Затраты на связь";
		Спр.Счет = СчетПоКоду("84");
		Спр.Постоянный = 2;
		СпрСтНД.НайтиПоКоду("1/62/5");
		//Витрати на оплату послуг зв'язку
		Спр.СтатьяНалоговойДекларации = СпрСтНД.ТекущийЭлемент();
		Спр.Родитель = ТекущийРодитель;
		Спр.Записать();
	КонецЕсли;
	Если Спр.НайтиПоКоду("10026",1) = 0 Тогда
		Спр.Новый();
		Спр.Код = 10026;
		Спр.Наименование = "Урегулирование споров в судах";
