Процедура РазделениеСчета684()
	Перем	Опер, Док, Сч1, Сч2, Таб;
	
	// заменим проводки со счетом 684 на 6841
	Состояние("Выполнение изменений в учете гудвила");
	
	Сч1 = СчетПоКоду("684");
	Сч2 = СчетПоКоду("6841");
	
	Если (ПустоеЗначение(Сч1)=1) Или (ПустоеЗначение(Сч1)=2) Тогда
		Возврат; // странно...
	КонецЕсли;
	
	Таб = СоздатьОбъект("ТаблицаЗначений");
	Таб.НоваяКолонка("Док");
	
	Док = СоздатьОбъект("Документ");
	
	Опер = СоздатьОбъект("Операция");
	Опер.ВыбратьОперацииСПроводками(,,Сч1);
	Пока Опер.ПолучитьПроводку()=1 Цикл
		Док.НайтиДокумент(Опер.Документ); // без такой "развязки" Таб будет содержать кучу ссылок на последний документ
				
		Таб.НоваяСтрока();
		Таб.Док = Док.ТекущийДокумент();
	КонецЦикла;
	
	Таб.Свернуть("Док",""); // список документов, в которых есть движения по сч.684
	
	Таб.ВыбратьСтроки();
	Пока Таб.ПолучитьСтроку()=1 Цикл
		Опер.НайтиОперацию(Таб.Док);
		Опер.ВыбратьПроводки();
		Пока Опер.ПолучитьПроводку()=1 Цикл
			// должны исправиться и сложные проводки, и "фокусы" типа Дт684 - Кт684
			Если Опер.Дебет.Счет=Сч1 Тогда
				Опер.Дебет.Счет = Сч2;
			КонецЕсли;
			Если Опер.Кредит.Счет=Сч1 Тогда
				Опер.Кредит.Счет = Сч2
			КонецЕсли;
		КонецЦикла;
		Опер.Записать();
		глЗаписьЖурналаРегистрации(Комментарий, 2, 9, Опер.Документ, 2);
	КонецЦикла;
КонецПроцедуры

// ======================================
Процедура ОбновлениеКапитальныхИнвестиций()
	Перем	Опер, Док, Док1;
	Перем   Сч152, Сч1522, Сч153, Сч1532, Сч154, Сч1542;
	Перем   Таб, фЗаписывать;
	
	// заменим проводки со счетом 152 на 1522, 153 на 1532, 154 на 1542
	Состояние("Выполнение изменений в капитальных инвестициях");
	
	Сч152 = СчетПоКоду("152");
	Сч1522 = СчетПоКоду("15.2.2");

	Сч153 = СчетПоКоду("153");
	Сч1532 = СчетПоКоду("15.3.2");

	Сч154 = СчетПоКоду("154");
	Сч1542 = СчетПоКоду("15.4.2");
	
	
	Если 	 (ПустоеЗначение(Сч152)=1) Или (ПустоеЗначение(Сч1522)=1)
		 Или (ПустоеЗначение(Сч153)=1) Или (ПустоеЗначение(Сч1532)=1)
		 Или (ПустоеЗначение(Сч154)=1) Или (ПустоеЗначение(Сч1542)=1) Тогда
		Возврат; // странно...
	КонецЕсли;
	
	Таб = СоздатьОбъект("ТаблицаЗначений");
	Таб.НоваяКолонка("Док");
	
	Док = СоздатьОбъект("Документ");
	Док1= СоздатьОбъект("Документ");
	
	Опер = СоздатьОбъект("Операция");
	Опер.ВыбратьОперацииСПроводками(,,СчетПоКоду("15"));
	Пока Опер.ПолучитьПроводку()=1 Цикл
		Док.НайтиДокумент(Опер.Документ);
		
		Если Док1.ТекущийДокумент() = Док.ТекущийДокумент() Тогда
			//этот документ уже попал в таблицу
			Продолжить
		КонецЕсли;
		Док1.НайтиДокумент(Док);
		
		Таб.НоваяСтрока();
		Таб.Док = Док.ТекущийДокумент();
	КонецЦикла;
	
	Таб.ВыбратьСтроки();
	Пока Таб.ПолучитьСтроку()=1 Цикл
		Опер.НайтиОперацию(Таб.Док);
		Опер.ВыбратьПроводки();
		Пока Опер.ПолучитьПроводку()=1 Цикл
			Если Опер.Дебет.Счет=Сч152 Тогда
				Опер.Дебет.Счет = Сч1522;
			ИначеЕсли Опер.Дебет.Счет=Сч153 Тогда
				Опер.Дебет.Счет = Сч1532;
			ИначеЕсли Опер.Дебет.Счет=Сч154 Тогда
				Опер.Дебет.Счет = Сч1542;
			КонецЕсли;
			Если Опер.Кредит.Счет=Сч152 Тогда
				Опер.Кредит.Счет = Сч1522;
			ИначеЕсли Опер.Кредит.Счет=Сч153 Тогда
				Опер.Кредит.Счет = Сч1532;
			ИначеЕсли Опер.Кредит.Счет=Сч154 Тогда
				Опер.Кредит.Счет = Сч1542;
			КонецЕсли;
		КонецЦикла;
		Опер.Записать();
		глЗаписьЖурналаРегистрации(Комментарий, 2, 9, Опер.Документ, 2);
	КонецЦикла;
	
	//обновим счета учета в спр. Инвестиции
	Спр=СоздатьОбъект("Справочник.Инвестиции");
	Спр.ВыбратьЭлементы();
	Пока Спр.ПолучитьЭлемент()=1 Цикл
		Если Спр.ЭтоГруппа() = 1 Тогда
			Продолжить
		КонецЕсли;
	
		Попытка
			Если Спр.Счет=Сч152 Тогда
				Спр.Счет = Сч1522;
				Спр.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 1, 2, Спр.ТекущийЭлемент(), 2);
			ИначеЕсли Спр.Счет=Сч153 Тогда
				Спр.Счет = Сч1532;
				Спр.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 1, 2, Спр.ТекущийЭлемент(), 2);
			ИначеЕсли Спр.Счет=Сч154 Тогда
				Спр.Счет = Сч1542;
				Спр.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 1, 2, Спр.ТекущийЭлемент(), 2);
			КонецЕсли;
		Исключение
			//Если не удалось - справочник заблокирован, выдать сообщение и продолжить
			Сообщить(ОписаниеОшибки(),"!!!");
		КонецПопытки;
	КонецЦикла;
	
	//обновим счета учета в спр. ТМЦ
	Спр=СоздатьОбъект("Справочник.ТМЦ");
	Спр.ВыбратьЭлементы();
	Пока Спр.ПолучитьЭлемент()=1 Цикл
		Если Спр.ЭтоГруппа() = 1 Тогда
			Продолжить
		КонецЕсли;
	
		Попытка
