				ИЛИ (Док.СчетПоставщика = СчетПоКоду("3772")) ИЛИ (Док.СчетПоставщика = СчетПоКоду("3774"))) Тогда
				Док.РегистрПоставщика = Перечисление.ВидыКлиентов.Поставщик;
