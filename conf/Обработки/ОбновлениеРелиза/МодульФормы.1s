			СпрНО.Записать();
			глЗаписьЖурналаРегистрации(Комментарий, 1, 1, СпрНО.ТекущийЭлемент(), 2);
			СпрНО.Ставка.Установить('01.01.2004', 0.1);
			СпрНО.Дополнительно.Установить('01.01.2003', "Пообъектно=0;");
		КонецЕсли;
		Если СпрНО.НайтиПоКоду("АмортГр3-04") = 0 Тогда
			СпрНО.Новый();  
			СпрНО.Код = "АмортГр3-04";
			СпрНО.Наименование="С 01.01.2004, группа 3, амортизация";
			СпрНО.Родитель = Гр1;
			СпрНО.Записать();
			глЗаписьЖурналаРегистрации(Комментарий, 1, 1, СпрНО.ТекущийЭлемент(), 2);
			СпрНО.Ставка.Установить('01.01.2004', 0.06);
			СпрНО.Дополнительно.Установить('01.01.2003', "Пообъектно=0;");
		КонецЕсли;
		
		//Новый реквизит НормаАмортизацииПоНалоговомуМетоду
		Спр = СоздатьОбъект("Справочник.НеоборотныеАктивы");
		Спр.ВыбратьЭлементы();
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			Если Спр.МетодРасчетаИзноса.Получить(ТекущаяДата()) = Перечисление.МетодыРасчетаИзноса.Налоговый Тогда
				ДатаВвода = Спр.ДатаВвода;
				ДатаВвода = ?(ПустоеЗначение(ДатаВвода) = 1, '01.01.2004', ДатаВвода);
				Спр.НормаАмортизацииПоНалоговомуМетоду.Установить('01.01.1980', глНормаАмортизацииПоДате(, ДатаВвода, Спр.Группа));
			КонецЕсли;	
		КонецЦикла;	
		
		//Заполним новые реквизиты в документах старыми нормами
		Док=СоздатьОбъект("Документ.ВводВЭксплуатацию");
		Док.ВыбратьДокументы();
		Пока Док.ПолучитьДокумент()>0 Цикл
			Док.ВыбратьСтроки();
			Пока Док.ПолучитьСтроку() = 1 Цикл
			    Если (Док.НеоборотныйАктив.Производственное = 1) и (Док.НеоборотныйАктив.ВидНеоборотногоАктива <> НМА) Тогда
					Док.НалоговаяНормаАмортизации = глНормаАмортизацииПоДате(,, Док.НеоборотныйАктив.Группа);
				КонецЕсли;	
			КонецЦикла;	
			Попытка
				Док.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент(), 2);
			Исключение
				//Если не удалось - документ заблокирован, выдать сообщение и продолжить
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЦикла;
		
		Док=СоздатьОбъект("Документ.МодернизацияНеоборАктивов");
		Док.ВыбратьДокументы();
		Пока Док.ПолучитьДокумент()>0 Цикл
		    Если (Док.НеоборотныйАктив.Производственное = 1) и (Док.НеоборотныйАктив.ВидНеоборотногоАктива <> НМА) Тогда
				Док.НалоговаяНормаАмортизации = глНормаАмортизацииПоДате(,, Док.НеоборотныйАктив.Группа);
			КонецЕсли;	
			Попытка
				Док.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент(), 2);
			Исключение
				//Если не удалось - документ заблокирован, выдать сообщение и продолжить
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЦикла;
		
		Док=СоздатьОбъект("Документ.ЛиквидацияНеоборАктивов");
		Док.ВыбратьДокументы();
		Пока Док.ПолучитьДокумент()>0 Цикл
			Док.ВыбратьСтроки();
			Пока Док.ПолучитьСтроку() = 1 Цикл
			    Если (Док.НеоборотныйАктив.Производственное = 1) и (Док.НеоборотныйАктив.ВидНеоборотногоАктива <> НМА) Тогда
					Док.НалоговаяНормаАмортизации = глНормаАмортизацииПоДате(,, Док.НеоборотныйАктив.Группа);
				КонецЕсли;	
			КонецЦикла;	
			Попытка
				Док.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент(), 2);
			Исключение
				//Если не удалось - документ заблокирован, выдать сообщение и продолжить
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЦикла;
		
		//Заполним во всех проводках по ОС норму амортизации
		ПоследнийДок=0;
		Опер=СоздатьОбъект("Операция");
		Опер.ВыбратьОперацииСПроводками( ,,"ОС");
		Пока Опер.ПолучитьПроводку()>0 Цикл
	    	Если Опер.Документ=ПоследнийДок Тогда  //Если в документе несколько проводок по ОС, то достаточно пройти один раз
				Продолжить;
			КонецЕсли;
			ПоследнийДок=Опер.Документ;
			Опер1=СоздатьОбъект("Операция");
			Опер1.НайтиОперацию(Опер.Документ);
		    Опер1.ВыбратьПроводки();
			Пока Опер1.ПолучитьПроводку()>0 Цикл
				Если Лев(Опер1.Дебет.Счет.Код,2) = "ОС" Тогда
					Группа = Прав(Опер1.Дебет.Счет.Код,1);
					Если Группа<>"М" Тогда
						Опер1.Дебет.ШкалаСтавок = глНормаАмортизацииПоДате(,, Группа);
					КонецЕсли;	
				КонецЕсли;
				Если Лев(Опер1.Кредит.Счет.Код,2) = "ОС" Тогда
					Группа = Прав(Опер1.Кредит.Счет.Код,1);
					Если Группа<>"М" Тогда
						Опер1.Кредит.ШкалаСтавок = глНормаАмортизацииПоДате(,, Группа);
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;	
				
			Попытка
				Опер1.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 2, 9, Опер1.Документ, 2);
			Исключение
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЦикла;
		
		// пропишем значение нового реквизита
		СпрВиН = СоздатьОбъект("Справочник.ВидыНачислений");
		СпрВиН.ВыбратьЭлементы();
		Пока СпрВиН.ПолучитьЭлемент() = 1 Цикл
			СпрВиН.Индексируется = Нет;
			СпрВиН.Записать();
			глЗаписьЖурналаРегистрации(Комментарий, 1, 2, СпрВиН.ТекущийЭлемент(), 2);
		КонецЦикла;
		
		//В старых документах заполним новый реквизит СуммаПлатежа
		Для ИндДок = 1 По Метаданные.Документ() Цикл
			Для ИндРекв = 1 По Метаданные.Документ(ИндДок).РеквизитШапки() Цикл
				Если Метаданные.Документ(ИндДок).РеквизитШапки(ИндРекв).Идентификатор = "СуммаПлатежа" Тогда
					Док=СоздатьОбъект("Документ."+Метаданные.Документ(ИндДок).Идентификатор);
					Док.ВыбратьДокументы();
					Пока Док.ПолучитьДокумент()>0 Цикл
						Если глИспользоватьСчетНДС(Док) = 0 Тогда
							Док.СуммаПлатежа = Док.СуммаСНДС;
						Иначе
							Док.СуммаПлатежа = Док.СуммаСНДС - Док.НДС;
						КонецЕсли;
						Док.Записать();
						глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент(), 2);
					КонецЦикла;	
				КонецЕсли;	
			КонецЦикла;
			Для ИндРекв = 1 По Метаданные.Документ(ИндДок).РеквизитТабличнойЧасти() Цикл
				Если Метаданные.Документ(ИндДок).РеквизитТабличнойЧасти(ИндРекв).Идентификатор = "СуммаПлатежа" Тогда
					Док=СоздатьОбъект("Документ."+Метаданные.Документ(ИндДок).Идентификатор);
					Док.ВыбратьДокументы();
					Пока Док.ПолучитьДокумент()>0 Цикл
						Док.ВыбратьСтроки();
						Пока Док.ПолучитьСтроку() >0 Цикл
							Если глИспользоватьСчетНДС(Док) = 0 Тогда
								Док.СуммаПлатежа = Док.СуммаСНДС;
							Иначе
								Док.СуммаПлатежа = Док.СуммаСНДС - Док.НДС;
							КонецЕсли;	
						КонецЦикла;	
						Док.Записать();
						глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент(), 2);
					КонецЦикла;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;

		// добавляем в таблицу описание для релиза
		ТаблицаНепуста = 1;
		Таб.ВывестиСекцию(Номер);
		
	ИначеЕсли Номер = 770008 Тогда

		//Заполним новый справочник "Налоговые инспекции"
		спПараметры = СоздатьОбъект("СписокЗначений");
		спПараметры.ДобавитьЗначение(0,"НеОбновлять");
		спПараметры.ДобавитьЗначение(ФайлСписокДПИ,"ФайлСписокДПИ");
		ОткрытьФорму("Обработка.ЗагрузкаДПИ", спПараметры);
		спПараметры = "";
		                 
		//Для существующих элементов справочников Фирмы и Сотрудники 
		//создадим элементы спр. НалоговыеИнспекции, куда перенесем имеющиеся данные.
		СпрДПИ = СоздатьОбъект("Справочник.НалоговыеИнспекции");
		СпрФирмы = СоздатьОбъект("Справочник.Фирмы");
		СпрФирмы.ВыбратьЭлементы();
		Пока СпрФирмы.ПолучитьЭлемент() = 1 Цикл
			СпрДПИ.ВыбратьЭлементы();
			фНайден = 0;
			Пока СпрДПИ.ПолучитьЭлемент() = 1  Цикл
				Если СпрДПИ.ПометкаУдаления() = 1  Тогда
					Продолжить
				КонецЕсли;
				
				Если СокрЛП(СпрДПИ.ЕДРПОУ) = СокрЛП(СпрФирмы.КодНалоговойИнспекции) Тогда
					фНайден = 1;
					Прервать
				КонецЕсли;
			КонецЦикла;
            Если фНайден = 0 Тогда
				СпрДПИ.Новый();
				//дополним нулями слева код налоговой инспекции
				СпрДПИ.Код = Прав("0000" + СокрЛП(СпрФирмы.ТерриториальныйКодНалоговойИнспекции), 4);
				//нет возможности установить правильный код
				СпрДПИ.КодАдмРайона = "00";
				СпрДПИ.КодДляПоиска = СпрДПИ.Код + "00";
				СпрДПИ.Наименование = "ДПІ в " + СпрФирмы.ОтделНалоговойИнспекции;
				СпрДПИ.ЕДРПОУ = СпрФирмы.КодНалоговойИнспекции;
				СпрДПИ.НаименованиеАдмРайона = СпрФирмы.ОтделНалоговойИнспекции;
				СпрДПИ.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 1, 2, СпрДПИ.ТекущийЭлемент(), 2);
			КонецЕсли;
			СпрФирмы.НалоговаяИнспекция.Установить('01.01.1980', СпрДПИ.ТекущийЭлемент()) 
		КонецЦикла;
		СпрФирмы = 0;
		
		СпрСотр = СоздатьОбъект("Справочник.Сотрудники");
		СпрСотр.ВыбратьЭлементы();
		Пока СпрСотр.ПолучитьЭлемент() = 1 Цикл
			Если СпрСотр.ЭтоГруппа() = 1 Тогда
				Продолжить
			КонецЕсли;
			
			НазвДПИ = СпрСотр.НазвНалогИнсп;
			АдресДПИ = СпрСотр.АдресНалогИнсп;
			Если ПустаяСтрока(НазвДПИ+АдресДПИ) = 1 Тогда
				//если не заполнен ни один из реквизитов - создавать новый элемент спр. Налоговые инспекции незачем
				Продолжить
			КонецЕсли;
            
			//чтобы не плодить множество элементов справочника попытаемся найти среди уже записанных элементов.
			СпрДПИ.ВыбратьЭлементы();
			фНайден = 0;
			Пока СпрДПИ.ПолучитьЭлемент() = 1  Цикл
				Если СпрДПИ.ПометкаУдаления() = 1  Тогда
					Продолжить
				КонецЕсли;

				Если СокрЛП(НРег(СпрДПИ.Наименование)) = СокрЛП(НРег(НазвДПИ)) Тогда
					фНайден = 1;
					Прервать
				КонецЕсли;
			КонецЦикла;
            Если фНайден = 0 Тогда
				СпрДПИ.Новый();
				СпрДПИ.Код = "0000";//нет возможности установить правильный код
				СпрДПИ.КодАдмРайона = "00";
				СпрДПИ.КодДляПоиска = "000000";
				СпрДПИ.Наименование =  НазвДПИ;
				СпрДПИ.Адрес = АдресДПИ;
				СпрДПИ.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 1, 1, СпрДПИ.ТекущийЭлемент(), 2);
			КонецЕсли;
			СпрСотр.НалоговаяИнспекция = СпрДПИ.ТекущийЭлемент();
			СпрСотр.Записать();
		КонецЦикла;
		СпрСотр = 0;
		СпрДПИ = 0;
        
		//в назначениях платежа имелись ссылки на уже неиспользуемый реквизит спр. Фирмы
		СпрНП = СоздатьОбъект("Справочник.НазначенияПлатежей");
        СпрНП.ВыбратьЭлементы();
		Пока СпрНП.ПолучитьЭлемент() = 1 Цикл
			Если СпрНП.ЭтоГруппа() = 1 Тогда
			    Продолжить;
			КонецЕсли;
			Если СпрНП.Шаблон = 0 Тогда
			    Продолжить;
			КонецЕсли;
			Если Найти(СпрНП.ПолнНаименование,"ТерриториальныйКодНалоговойИнспекции") > 0 Тогда
			     СпрНП.ПолнНаименование = СтрЗаменить(СпрНП.ПолнНаименование, "ТерриториальныйКодНалоговойИнспекции", "НалоговаяИнспекция.Получить(ДатаДок).Код"); 
				 СпрНП.Записать();
				 глЗаписьЖурналаРегистрации(Комментарий, 1, 2, СпрНП.ТекущийЭлемент(), 2);
			КонецЕсли;
		КонецЦикла;

		// спецсчета по НДС не приняли
		Константа.ИспользоватьСпецСчетаПоНДС.Установить('01.05.04',Нет);
		Константа.ОтдельныеППДляСпецСчетовПоНДС = 0;
			
		// заполним новые реквизиты в документах старыми нормами
		Док=СоздатьОбъект("Документ.ВводОстатковНеоборАктивов");
		Док.ВыбратьДокументы();
		Пока Док.ПолучитьДокумент()>0 Цикл
		    Если (Док.Производственные = 1) и (Док.ВидНеоборотныхАктивов <> НМА) Тогда
				Док.НалоговаяНормаАмортизацииДок = глНормаАмортизацииПоДате(,, Док.Группа);
			КонецЕсли;	
			Док.ВыбратьСтроки();
			Пока Док.ПолучитьСтроку() = 1 Цикл
				Док.НалоговаяНормаАмортизации = Док.НалоговаяНормаАмортизацииДок;
			КонецЦикла;	
			Попытка
				Док.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент(), 2);
			Исключение
				//Если не удалось - документ заблокирован, выдать сообщение и продолжить
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЦикла;

		//Заполним во всех проводках по ОС норму амортизации
		ПоследнийДок=0;
		Опер=СоздатьОбъект("Операция");
		Опер.ВыбратьОперацииСПроводками( ,,"ОС");
		Пока Опер.ПолучитьПроводку()>0 Цикл
			Если Опер.Документ.Вид() <> "ВводОстатковНеоборАктивов" Тогда //Будут обрабатываться только документы данного вида
				Продолжить;
			КонецЕсли;
			Если Опер.Документ=ПоследнийДок Тогда  //Если в документе несколько проводок по ОС, то достаточно пройти один раз
				Продолжить;
			КонецЕсли;
			ПоследнийДок=Опер.Документ;
			Опер1=СоздатьОбъект("Операция");
			Опер1.НайтиОперацию(Опер.Документ);
			Опер1.ВыбратьПроводки();
			Пока Опер1.ПолучитьПроводку()>0 Цикл
				Если Лев(Опер1.Дебет.Счет.Код,2) = "ОС" Тогда
					Группа = Прав(Опер1.Дебет.Счет.Код,1);
					Если Группа<>"М" Тогда
						Если ПустоеЗначение(Опер1.Дебет.ШкалаСтавок) = 1 Тогда // Только для пустого cубконто
							Опер1.Дебет.ШкалаСтавок = глНормаАмортизацииПоДате(,, Группа);
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
				Если Лев(Опер1.Кредит.Счет.Код,2) = "ОС" Тогда
					Группа = Прав(Опер1.Кредит.Счет.Код,1);
					Если Группа<>"М" Тогда
						Если ПустоеЗначение(Опер1.Кредит.ШкалаСтавок) = 1 Тогда // Только для пустого cубконто
							Опер1.Кредит.ШкалаСтавок = глНормаАмортизацииПоДате(,, Группа);
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;	
			
			Попытка
				Опер1.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 2, 9, Опер1.Документ, 2);
			Исключение
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЦикла;
		
		// заполним реквизит табличной части ВидНДССтроки по реквизиту шапки ВидНДС
		Док = СоздатьОбъект("Документ.ПерезачетБартер");   
