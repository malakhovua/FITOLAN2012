//========================================
Процедура УстановитьВидОперацииНалоговыхНакладных()
	СписокФирмКонтрагентов = СоздатьОбъект("СписокЗначений");
	СпрКонтрагенты = СоздатьОбъект("Справочник.Контрагенты");
	Спр = СоздатьОбъект("Справочник.Фирмы");
	Спр.ВыбратьЭлементы();
	Пока Спр.ПолучитьЭлемент() = 1 Цикл
		Контрагент = 0;
		Если СпрКонтрагенты.НайтиПоРеквизиту("ЕДРПОУ", Спр.ЕДРПОУ, 1) = 1 Тогда
			Контрагент = СпрКонтрагенты.ТекущийЭлемент();
		ИначеЕсли  СпрКонтрагенты.НайтиПоНаименованию(Строка(Спр), 0) = 1 Тогда
			Контрагент = СпрКонтрагенты.ТекущийЭлемент();
		КонецЕсли;
		Если Контрагент <> 0 Тогда
			СписокФирмКонтрагентов.Установить(ЗначениеВСтрокуВнутр(Спр.ТекущийЭлемент()), Контрагент);
		КонецЕсли;
	КонецЦикла;
	НН = СоздатьОбъект("Документ.НалоговаяНакладная");
	НН.ВыбратьДокументы();
	Пока НН.ПолучитьДокумент() = 1 Цикл
		НН.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РеализацияВУкраине;
		Если НН.Валюта <> Константа.БазоваяВалюта Тогда
			НН.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт;
		ИначеЕсли НН.Контрагент = СписокФирмКонтрагентов.Получить(ЗначениеВСтрокуВнутр(НН.Фирма)) Тогда
			НН.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.УсловнаяПродажа;
		ИначеЕсли ПустоеЗначение(НН.РодительскийДокумент) = 0 Тогда
			РодДок = НН.РодительскийДокумент;
			ВидДока = РодДок.Вид();
			Если ВидДока = "ЛиквидацияНеоборАктивов" Тогда
				Если (РодДок.ВидЛиквидации = Перечисление.ВидыЛиквидацииНеоборАктивов.Списание) И
		             (РодДок.ТипСписания = Перечисление.ТипыСписанияНеоборАктивов.ПоРешениюНалогоплательщикаИлиКМУ) Тогда
					НН.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.УсловнаяПродажа;
				КонецЕсли;
			ИначеЕсли ВидДока = "СписаниеТМЦ" Тогда
				НН.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.УсловнаяПродажа;
			КонецЕсли;
		КонецЕсли;
		Попытка
			НН.Записать();
			глЗаписьЖурналаРегистрации(Комментарий, 2, 2, НН.ТекущийДокумент());
		Исключение
			//Если не удалось - документ заблокирован, выдать сообщение и продолжить
			Сообщить(ОписаниеОшибки(),"!!!");
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// ======================================
Процедура ЗаполнитьМестоХраненияВЭксплуатацииВводаВЭксплуатацию()
	Док = СоздатьОбъект("Документ.ВводВЭксплуатацию");
	Док.ВыбратьДокументы();
	Пока Док.ПолучитьДокумент() = 1 Цикл
		Док.МестоХраненияВЭксплуатации = Док.МестоХранения;
		Попытка
			Док.Записать();
			глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент());
		Исключение
			//Если не удалось - документ заблокирован, выдать сообщение и продолжить
			Сообщить(ОписаниеОшибки(),"!!!");
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// ======================================
Процедура УстановитьРасчетныеСчетаРеализационныхДокументов(ВидДокумента)
	Если ВидДокумента = "ЛиквидацияНеоборАктивов" Тогда
		ЭтоЛиквидация = 1;
		НеИскатьВПроводках = Константа.ПроводкиПоКассеТолькоОрдерами;
	Иначе
		ЭтоЛиквидация = 0;
	КонецЕсли;
	Док = СоздатьОбъект("Документ." + ВидДокумента);
	Док.ВыбратьДокументы();
	Пока Док.ПолучитьДокумент() = 1 Цикл
		Если ЭтоЛиквидация = 1 Тогда
			Если Док.ВидЛиквидации <> Перечисление.ВидыЛиквидацииНеоборАктивов.Реализация Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Док.ВидТорговли = Перечисление.ВидыТорговли.Нал Тогда
			Если ЭтоЛиквидация = 1 Тогда
				Если НеИскатьВПроводках = Нет Тогда
					Опер = Док.Операция;
					Опер.ВыбратьПроводки();
					Пока Опер.ПолучитьПроводку() = 1 Цикл
						Касса = Опер.Дебет.Субконто(ВидыСубконто.НашиДенежныеСчета);
						Если ПустоеЗначение(Касса) = 0 Тогда
							Док.Касса = Касса;
							Прервать
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если Док.Касса.Выбран() = 0 Тогда
					Док.Касса = глПолучитьКассу(Док.Фирма,Док.Валюта);
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			Док.Касса = глПолучитьРСчет(Док.Фирма,Док.Валюта);
		КонецЕсли;
		Попытка
			Док.Записать();
			глЗаписьЖурналаРегистрации(Комментарий, 2, 2, Док.ТекущийДокумент());
		Исключение
			//Если не удалось - документ заблокирован, выдать сообщение и продолжить
			Сообщить(ОписаниеОшибки(),"!!!");
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры
// ======================================
Функция ПоказатьИнструкцию()
	Т=СоздатьОбъект("Таблица");
	Т.ИсходнаяТаблица("Инструкция"); 
	Т.ПолучитьСекцию("Инструкция"); 
	Т.ВывестиСекцию("Инструкция"); 
	Т.Опции(0,0,1,0,,);
	Т.Защита(1);
	Т.ТолькоПросмотр();
	Т.Показать();
КонецФункции
// ======================================
Процедура ЗаполнитьВидСклада()
	Спр = СоздатьОбъект("Справочник.МестаХранения");;
	Спр.ВыбратьЭлементы();
	Пока Спр.ПолучитьЭлемент() = 1 Цикл
		Если Спр.Тип = Перечисление.ТипыМестХранения.МОЛ Тогда
			Спр.ВидСклада = Перечисление.ВидыСкладов.Оптовый;
			Попытка
				Спр.Записать();
				глЗаписьЖурналаРегистрации(Комментарий, 1, 2, Спр.ТекущийЭлемент(), 2);
			Исключение
				//Если не удалось - элемент заблокирован, выдать сообщение и продолжить
				Сообщить(ОписаниеОшибки(),"!!!");
			КонецПопытки;
		КонецЕсли;;
	КонецЦикла;
КонецПроцедуры

// ======================================
Процедура ЗаполнитьМаксимальныеБазы(Код, СпрНиО, ОшибкаВоВремяОбновления)
	Если СпрНиО.НайтиПоКоду(Код) = 1 Тогда            
		СпрНиО.Дополнительно.Установить('01.01.07', "Макс. база=7875;"); 
		СпрНиО.Дополнительно.Установить('01.04.07', "Макс. база=8025;"); 
		СпрНиО.Дополнительно.Установить('01.10.07', "Макс. база=8220;"); 
	Иначе
		глКомментарий("В справочнике ""Налоги и отчисления"" не найден элемент с кодом """ + Код + """.",0,,"!");
		ОшибкаВоВремяОбновления = 1;
	КонецЕсли;
КонецПроцедуры

