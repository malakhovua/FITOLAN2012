Перем Комментарий;
//---------------------------------
Процедура ИзменитьФайл(Рекв)
	ИмяФайла="";
	Путь=Рекв;
	Пока СтрДлина(Путь) > 0 Цикл
		Символ = Сред(Путь, СтрДлина(Путь), 1);
		Если Символ = "\" Тогда
			Прервать
		Иначе
			ИмяФайла= Символ + ИмяФайла;
			Путь=Лев(Путь, СтрДлина(Путь)-1);
		КонецЕсли;
	КонецЦикла;
	ФС.ВыбратьФайл(0,ИмяФайла, Путь, "Укажите файл, содержащий список банков");
	Рекв = Путь + ИмяФайла;
КонецПроцедуры
//---------------------------------
Функция ПреобрСтроку(Стр) 
	Стр = СокрЛП(СтрЗаменить(Стр,"ў","і"));
	Стр = СтрЗаменить(Стр, "ї","є"); 
	Стр = СтрЗаменить(Стр, "Ї","Є"); 
	Стр = СтрЗаменить(Стр, "•","ї"); 
	Стр = СтрЗаменить(Стр, "Ў","І"); 
	Стр = СтрЗаменить(Стр, "°","Ї"); 
	Возврат Стр;
КонецФункции
//---------------------------------
Процедура Сформировать()

	Если ФС.СуществуетФайл(ФайлСписокБанков) = 0 Тогда
	    глКомментарий("Файл "+ ФайлСписокБанков+ " не найден!", 0,,"!");
		Возврат;
	КонецЕсли;
	Если (Вопрос("Загрузка может занять продолжительное время. Продолжить?","Да+Нет") = "Нет") Тогда
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;
	Сообщить("Начало загрузки.");

	СпрБанк = СоздатьОбъект("Справочник.Банки");
	СпрБанк.ПорядокКодов();
	СпрБанк.ВыбратьЭлементы();  

	дбфБанк = СоздатьОбъект("XBase");
	
    Попытка
		дбфБанк.ОткрытьФайл(ФайлСписокБанков);
	Исключение
		Сообщить("Операция не выполнена: "+ ОписаниеОшибки());
		Сообщить("Возможно файл "+ФайлСписокБанков+" поврежден");
		Возврат
	КонецПопытки;   
	
	тбНовые = СоздатьОбъект("ТаблицаЗначений");
	тбНовые.НоваяКолонка("Код"); 
	тбНовые.НоваяКолонка("Наим");
	тбНовые.НоваяКолонка("Адрес");
	тбНовые.НоваяКолонка("ЕГРПОУ");
	
	дбфБанк.ДобавитьИндекс("IDXMFO","MFO",0,0,"");
	дбфБанк.СоздатьИндексныйФайл(КаталогВременныхФайлов()+"Rcukru.cdx");
	дбфБанк.ТекущийИндекс("IDXMFO");  
	
	Если дбфБанк.Первая() = 0 Тогда
		Сообщить("Файл " + ФайлСписокБанков + " пуст.");
	    Возврат;
	КонецЕсли; 
	флФайл = 0;
	флСпр = 0;
	ИмяБанка = "";
	
	Пока 1 = 1 Цикл  
		
		Если (флСпр = 0) и (флФайл = 0) Тогда
			
			МФО_ = дбфБанк.MFO;
			МФО_Спр = Число(спрБанк.Код);
			Если МФО_Спр = МФО_ Тогда   
				Если НеОбновлять = 0 Тогда
					спрБанк.Наименование = ПреобрСтроку(дбфБанк.NB); 
					Адрес = ПреобрСтроку(дбфБанк.TNP) +" "+ ПреобрСтроку(дбфБанк.NP) +", "+ ПреобрСтроку(дбфБанк.ADRESS);
					спрБанк.Адрес 		 = Адрес;
					спрБанк.ЕГРПОУ 		 = дбфБанк.IKOD;
					спрБанк.Записать();
				КонецЕсли;
				Если дбфБанк.Следующая() = 0 Тогда
					флФайл = 1;
				КонецЕсли;	
				Если СпрБанк.ПолучитьЭлемент() = 0 Тогда
					флСпр = 1;
				КонецЕсли;	
				ИмяБанка = спрБанк.Наименование;
			Иначе
				Если МФО_Спр < МФО_ Тогда	
					//в справочнике лишний
					Если НеОбновлять = 0 Тогда
						спрБанк.Примечание = "НЕ ДІЮЧИЙ";
						спрБанк.Записать();
					КонецЕсли;
					Если СпрБанк.ПолучитьЭлемент() = 0 Тогда
						флСпр = 1;
					КонецЕсли;	
					ИмяБанка = спрБанк.Наименование;
				Иначе
					//нет в справочнике, добавим 
					тбНовые.НоваяСтрока();
					тбНовые.Код    = МФО_;
					тбНовые.Наим   = ПреобрСтроку(дбфБанк.NB);
					Адрес = ПреобрСтроку(дбфБанк.TNP) +" "+ ПреобрСтроку(дбфБанк.NP) +", "+ ПреобрСтроку(дбфБанк.ADRESS);
					тбНовые.Адрес  = Адрес;
					тбНовые.ЕГРПОУ = дбфБанк.IKOD; 
					Если дбфБанк.Следующая() = 0 Тогда
						флФайл = 1;
					КонецЕсли;	
					ИмяБанка = тбНовые.Наим;
					
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли флФайл = 1 Тогда  //файл уже закончился, остались не действующие банки
			//в справочнике лишний
			Если НеОбновлять = 0 Тогда
				спрБанк.Примечание = "НЕ ДІЮЧИЙ";
				спрБанк.Записать();
			Иначе
				Прервать; //если нельзя менять, нет смысла проверять дальше
			КонецЕсли;
			Если СпрБанк.ПолучитьЭлемент() = 0 Тогда
				Прервать;
			КонецЕсли;
			ИмяБанка = спрБанк.Наименование;
		ИначеЕсли флСпр = 1 Тогда  //справочник уже закончился, остались новые банки
			тбНовые.НоваяСтрока();
			тбНовые.Код    = дбфБанк.MFO;
			тбНовые.Наим   = ПреобрСтроку(дбфБанк.NB);
			Адрес = ПреобрСтроку(дбфБанк.TNP) +" "+ ПреобрСтроку(дбфБанк.NP) +", "+ ПреобрСтроку(дбфБанк.ADRESS);
			тбНовые.Адрес  = Адрес;
			тбНовые.ЕГРПОУ = дбфБанк.IKOD; 
			ИмяБанка = тбНовые.Наим;
			Если дбфБанк.Следующая() = 0 Тогда
				Прервать;
			КонецЕсли;	
		КонецЕсли;  
		Если (флСпр = 1) и (флФайл = 1) Тогда
			Прервать;
		КонецЕсли;
		Состояние("Загружается банк: " + ИмяБанка);

    КонецЦикла;
   	
   	
	тбНовые.ВыбратьСтроки();
	Пока тбНовые.ПолучитьСтроку() = 1 Цикл
		спрБанк.Новый();
		спрБанк.Код    		 = тбНовые.Код;
		спрБанк.Наименование = тбНовые.Наим; 
		спрБанк.Адрес 		 = тбНовые.Адрес;
		спрБанк.ЕГРПОУ 		 = тбНовые.ЕГРПОУ;
		спрБанк.Записать();
	КонецЦикла;

	Сообщить("Загрузка окончена.");
КонецПроцедуры

//---------------------------------
Процедура ПриОткрытии()
	Комментарий = "Загрузка справочника банков";
    ФайлСписокБанков = КаталогИБ()+"Rcukru.dbf";

	Если ТипЗначенияСтр(Форма.Параметр)<>"СписокЗначений" Тогда
		Возврат;
	КонецЕсли;
	
	спРасшифровка = Форма.Параметр;
	НеОбновлять = спРасшифровка.Получить("НеОбновлять");
	ФайлСписокБанков = спРасшифровка.Получить("ФайлСписокБанков");
	
	СтатусВозврата(0);//форму открывать не будем
	Сформировать()
КонецПроцедуры

