Перем Соединение;
Перем ПутьФайлаОбработки,ИмяФайлаОбработки;
Перем Комментарий; 
Перем Интернет, ИТС, НомерВызова; 
//******************************************************************************
//  ДоступностьЗагрузки()
//
//	Описание:  Осуществляет проверку возможности загрузки курсов валют 
//             Если есть помеченные строки, возвращает 1, если нет - 0
Функция ДоступностьЗагрузки()
	Д=0;
	Для Н=1 По СписокВалют.РазмерСписка() Цикл  
		Д=Д+СписокВалют.Пометка(Н);
		Если Д=1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Д;
КонецФункции  // ДоступностьЗагрузки      
//******************************************************************************
//	ВыделитьПодСтроку(ИсхСтр)
//
//	Параметры:  ИсхСтр - исходная строка
//
//	Описание:  Выделяет подстроку из строки и возвращает ее
Функция ВыделитьПодСтроку(ИсхСтр)
	Перем Стр;
    Поз=Найти(ИсхСтр,СимволТабуляции);
	Если Поз>0 Тогда
		Стр=Лев(ИсхСтр,Поз-1);
		ИсхСтр=Сред(ИсхСтр,Поз+1);
	Иначе
		Стр=ИсхСтр;
		ИсхСтр="";
	КонецЕсли;
	Возврат Стр;
КонецФункции   //  ВыделитьПодСтроку    
//******************************************************************************
//  ОткрытьСправочник()
//
//	Описание:  Осуществляет открытие справочника валют
Процедура ОткрытьСправочник()
	Перем Конт;
	ОткрытьФорму("Справочник.Валюты",Конт);
	Конт.АктивизироватьОбъект(СписокВалют.ПолучитьЗначение(СписокВалют.ТекущаяСтрока()));
КонецПроцедуры  // ОткрытьСправочник
//******************************************************************************
//	Установить(Режим="") 
//
//	Параметры: Режим - строка, режим работы: "Все" - отметить все строки
//					   "Сброс" - снять отметку всех строк
//					   "" - инвертировать отметку всех строк
//
//	Описание: Устанавливает, снимает или инвертирует отметки выбора строк 
Процедура Установить(Режим="") 
	Для Н=1 По СписокВалют.РазмерСписка() Цикл
		Если Режим="Все" Тогда
			СписокВалют.Пометка(Н,1);
		ИначеЕсли Режим="Сброс" Тогда
			СписокВалют.Пометка(Н,0); 
		Иначе
			СписокВалют.Пометка(Н,?(СписокВалют.Пометка(Н)=1,0,1)); 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры  //  Установить
//******************************************************************************
//	ОбновитьСписокВалют()
//
//	Описание:  Обновляет список валют (значения курсов и даты курсов)
Процедура ОбновитьСписокВалют()     
	Для Н=1 По СписокВалют.РазмерСписка() Цикл  
		Если СписокВалют.Пометка(Н)=1 Тогда
			СписокВалют.УстановитьЗначение(Н,СписокВалют.ПолучитьЗначение(Н),);
			Курсы=СоздатьОбъект("Периодический");    
			Курсы.ИспользоватьОбъект("Курс",СписокВалют.ПолучитьЗначение(Н)); 
			Курсы.ОбратныйПорядок();
			Если Курсы.ВыбратьЗначения()=1 Тогда    
				Курсы.ПолучитьЗначение();
				ДатаЗнач = Курсы.ДатаЗнач; 
			Иначе 
				ДатаЗнач = 0;       
			КонецЕсли;
			СписокВалют.УстановитьЗначение(Н,СписокВалют.ПолучитьЗначение(Н),"     "+СокрЛП(СписокВалют.ПолучитьЗначение(Н).Наименование)+";     на: "+Строка(ДатаЗнач)+"  =  "+Формат(Курсы.Значение,"Ч10.4")); 
			СписокВалют.Пометка(Н,1);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры   //  ОбновитьСписокВалют                                             
//******************************************************************************
//	Загрузить()
//
//	Описание:  Осуществляет загрузку курсов валют с сервера finance.ua
Функция Загрузить(ФоновыйРежим = 0)
	Перем Адрес1,Адрес2,Адрес,ТМП;

	ФоновыйРежим = Форма.Параметр;	
	Если ДоступностьЗагрузки()=0 Тогда
		Сообщение = "Необходимо указать валюты, "+РазделительСтрок+"по которым требуется получить курсы!";
		Если ФоновыйРежим = 1 Тогда 
			Сообщить(Сообщение, "!");
		Иначе
			Предупреждение(Сообщение);
		КонецЕсли;
		Возврат 0;
	КонецЕсли;
	Ошибка = 0;
	Если Результат = 1 Тогда
			глКомментарий("Загрузка курсов валют начата.", 3); 
	КонецЕсли;
	// Загрузка из Интернет
	Если (ИсточникЗагрузки = Интернет) ИЛИ (ФоновыйРежим=1) Тогда
		Адрес1 = "http://fin.1c.ua/1c/cb/";  // в интервале
		Адрес2 = "http://fin.1c.ua/1c/";     // по 1 дате
		Если (НачДата=КонДата) ИЛИ (КодДоступа="") Тогда  // по 1 дате
			Адрес = Адрес2;
			ТМП = "/"+ДатаГод(КонДата)+"/"+Формат(ДатаМесяц(КонДата),"Ч(0)2.0")+"/"+Формат(ДатаЧисло(КонДата),"Ч(0)2.0");
		Иначе    // в интервале
			Адрес = Адрес1;
			ТМП = "";
		КонецЕсли;
		Валюта=СоздатьОбъект("Справочник.Валюты");
		Стр = "";
		Для Н=1 По СписокВалют.РазмерСписка() Цикл 
			Если СписокВалют.Пометка(Н)=0 Тогда
				Продолжить;
			КонецЕсли;    
			ВалютаТМП = СписокВалют.ПолучитьЗначение(Н);
			Если Результат=1 Тогда
				глКомментарий("Загрузка курсов валюты: "+ВалютаТМП, 3); 
			КонецЕсли;
			Попытка
				Код = ?(КодДоступа<>"", "?"+СокрЛП(КодДоступа), "");
				Соединение.ПолучитьКакСтроку(Адрес+Прав(ВалютаТМП.Код,3)+ТМП+".tsv"+Код, Стр);
			Исключение
				Если Найти(Соединение.СтрокаСостоянияОтвета, "402") <> 0 Тогда
					глКомментарий("Неудачная попытка соединения по валюте """ + ВалютаТМП +""". Ключ заблокирован администратором или просрочен! ",0,,"!");	
					глКомментарий("Обратитесь в службу технической поддержки для выяснения причины блокировки или оплаты нового периода. ",0,,"!");	
				ИначеЕсли Найти(Соединение.СтрокаСостоянияОтвета, "403") <> 0 Тогда
				    глКомментарий("Неудачная попытка соединения по валюте """ + ВалютаТМП +""". Ключ не найден!  ",0,,"!");	
					глКомментарий("Проверьте правильность ключа или обратитесь в службу технической поддержки. ",0,,"!");	
				ИначеЕсли Найти(Соединение.СтрокаСостоянияОтвета, "404") <> 0 Тогда 
					
				ИначеЕсли Найти(Соединение.СтрокаСостоянияОтвета, "500") <> 0 Тогда
					глКомментарий("Неудачная попытка соединения по валюте """ + ВалютаТМП +""". Произошла серьёзная ошибка на сервере!  ",0,,"!");
					глКомментарий("Попробуйте загрузить курсы позже или обратитесь в службу технической поддержки. ",0,,"!");	
				Иначе
					глКомментарий("Неудачная попытка соединения по валюте """ + ВалютаТМП +""". Возможно неправильно указан "+
							  "диапазон дат, или неверно заданы коды валют в справочнике.",0,,"!");
				КонецЕсли;
				глКомментарий("Курсы по валюте """ + ВалютаТМП +""" не загружены.",0,,"!");
				Ошибка = 1;
				Продолжить;
			КонецПопытки; 
	
			Текст=СоздатьОбъект("Текст"); 
			Текст.ДобавитьСтроку(Стр);   
			
			Курсы=СоздатьОбъект("Периодический");
			Курсы.ИспользоватьОбъект("Курс",ВалютаТМП);
			Кратности=СоздатьОбъект("Периодический");
			Кратности.ИспользоватьОбъект("Кратность",ВалютаТМП);
			                          
			НачальныйКурс=0;
			НачальнаяКратность=0;
			НачальнаяДатаКурса=Дата(0);
			Для Инд=1 По Текст.КоличествоСтрок() Цикл
			   	Стр=Текст.ПолучитьСтроку(Инд);
			   	Если (Стр="")ИЛИ(Найти(Стр,СимволТабуляции)=0) Тогда
			   		Продолжить;
			   	КонецЕсли;
			   	Если НачДата=КонДата Тогда  
			   		ДатаКурса=КонДата;
			   	Иначе 
				   	ДатаКурсаСтр=ВыделитьПодСтроку(Стр);
				   	ДатаКурса=Дата(Лев(ДатаКурсаСтр,4),Сред(ДатаКурсаСтр,5,2),Сред(ДатаКурсаСтр,7,2));
			   	КонецЕсли;
			   	Кратность=Число(ВыделитьПодСтроку(Стр));
			   	Курс=Число(ВыделитьПодСтроку(Стр));
			   	
			   	Если ДатаКурса>КонДата Тогда
			   		Прервать;
			   	КонецЕсли;
			   	
			   	Если ДатаКурса<НачДата Тогда  //Запоминание курса на начало интервала
			   		Продолжить;
			   	КонецЕсли;
			   	
				Курсы.ВыбратьЗначения(ДатаКурса,ДатаКурса);
				Курсы.ПолучитьЗначение();
				Кратности.ВыбратьЗначения(ДатаКурса,ДатаКурса);
				Кратности.ПолучитьЗначение();
				Если (Курс<>Курсы.Значение) или (Кратность<>ВалютаТМП.Кратность.Получить(ДатаКурса)) Тогда
					Курсы.ДатаЗнач=ДатаКурса;
					Курсы.Значение=Курс;
					Курсы.Записать();
					глЗаписьЖурналаРегистрации(Комментарий + "Дата: " + ДатаКурса + "Знач.: " + Курс, 1, 7, ВалютаТМП);
					Кратности.ДатаЗнач=ДатаКурса;
					Кратности.Значение=Кратность;
					Если ВалютаТМП.Кратность.Получить(ДатаКурса)<>Кратность Тогда
						Кратности.Записать();
						глЗаписьЖурналаРегистрации(Комментарий + "Дата: " + ДатаКурса + "Знач.: " + Кратность, 1, 7, ВалютаТМП);
					КонецЕсли;
					Если Результат=1 Тогда
						глКомментарий(Строка(ДатаКурса) + СимволТабуляции + Курс + СимволТабуляции+СимволТабуляции + Кратность,2,,"I");
					КонецЕсли;
				КонецЕсли;
				Если Результат=1 Тогда
					Состояние("Загрузка курса на "+ДатаКурса+" - "+Курс);
				КонецЕсли;
			КонецЦикла;                           
		КонецЦикла;
	// Загрузка с диска ИТС
	ИначеЕсли (ИсточникЗагрузки = ИТС) Тогда
        Если (КонДата > КонМесяца(ДобавитьМесяц(ТекущаяДата(), -1))) ИЛИ (НачДата < НачГода(ДобавитьМесяц(ТекущаяДата(),-12))) Тогда
        	глКомментарий("С диска ИТС можно загрузить курсы с начала предыдущего года до конца предыдущего месяца!",0,,"!");	
			ошибка = 1;
			Возврат 0;
		КонецЕсли;
		Если СокрЛП(CDROM)="" Тогда
			глКомментарий("Не указана буква привода с диском ИТС!",0,,"!");	
			ошибка = 1;
			Возврат 0;	
		КонецЕсли;
		Валюта=СоздатьОбъект("Справочник.Валюты");
		Стр = "";
		Для Н=1 По СписокВалют.РазмерСписка() Цикл 
			Если СписокВалют.Пометка(Н)=0 Тогда
				Продолжить;
			КонецЕсли;    
			ВалютаТМП = СписокВалют.ПолучитьЗначение(Н);
			Если Результат=1 Тогда
				глКомментарий("Загрузка курсов валюты: "+ВалютаТМП, 3); 
			КонецЕсли;
			Попытка
				Текст = СоздатьОбъект("Текст");
				Текст.Открыть(CDROM+":\1CIts\EXE\Finance\"+Прав(ВалютаТМП.Код,3)+".tsv");
			Исключение
				глКомментарий("Курсы по валюте """ + ВалютаТМП +""" не загружены.",0,,"!");
				Ошибка = 1;
				Продолжить;
			КонецПопытки;  
			
			Курсы=СоздатьОбъект("Периодический");
			Курсы.ИспользоватьОбъект("Курс",ВалютаТМП);
			Кратности=СоздатьОбъект("Периодический");
			Кратности.ИспользоватьОбъект("Кратность",ВалютаТМП);
			                          
			НачальныйКурс=0;
			НачальнаяКратность=0;
			НачальнаяДатаКурса=Дата(0);
			Для Инд=1 По Текст.КоличествоСтрок() Цикл
			   	Стр=Текст.ПолучитьСтроку(Инд);
			   	Если (Стр="")ИЛИ(Найти(Стр,СимволТабуляции)=0) Тогда
			   		Продолжить;
			   	КонецЕсли; 
			   	
				ДатаКурсаСтр=ВыделитьПодСтроку(Стр);
				ДатаКурса=Дата(Лев(ДатаКурсаСтр,4),Сред(ДатаКурсаСтр,5,2),Сред(ДатаКурсаСтр,7,2));

			   	Кратность=Число(ВыделитьПодСтроку(Стр));
			   	Курс=Число(ВыделитьПодСтроку(Стр));
			   	
			   	Если ДатаКурса>КонДата Тогда
			   		Прервать;
			   	КонецЕсли;
			   	
			   	Если ДатаКурса<НачДата Тогда  //Запоминание курса на начало интервала
			   		Продолжить;
			   	КонецЕсли;
			   	
				Курсы.ВыбратьЗначения(ДатаКурса,ДатаКурса);
				Курсы.ПолучитьЗначение();
				Кратности.ВыбратьЗначения(ДатаКурса,ДатаКурса);
				Кратности.ПолучитьЗначение();
				Если (Курс<>Курсы.Значение) или (Кратность<>ВалютаТМП.Кратность.Получить(ДатаКурса)) Тогда
					Курсы.ДатаЗнач=ДатаКурса;
					Курсы.Значение=Курс;
					Курсы.Записать();
					глЗаписьЖурналаРегистрации(Комментарий + "Дата: " + ДатаКурса + "Знач.: " + Курс, 1, 7, ВалютаТМП);
					Кратности.ДатаЗнач=ДатаКурса;
					Кратности.Значение=Кратность;
					Если ВалютаТМП.Кратность.Получить(ДатаКурса)<>Кратность Тогда
						Кратности.Записать();
						глЗаписьЖурналаРегистрации(Комментарий + "Дата: " + ДатаКурса + "Знач.: " + Кратность, 1, 7, ВалютаТМП);
					КонецЕсли;
					Если Результат=1 Тогда
						глКомментарий(Строка(ДатаКурса) + СимволТабуляции + Курс + СимволТабуляции+СимволТабуляции + Кратность,2,,"I");
					КонецЕсли;
				КонецЕсли;
				Если Результат=1 Тогда
					Состояние("Загрузка курса на "+ДатаКурса+" - "+Курс);
				КонецЕсли;
			КонецЦикла;                           
		КонецЦикла;
	КонецЕсли;
	Сообщение = "Загрузка курсов закончена!";
	Если ФоновыйРежим = 1 Тогда
		Если Результат = 1 Тогда
			глКомментарий(Сообщение,3);
		КонецЕсли;
	Иначе
		Предупреждение(Сообщение,3);
		ОбновитьСписокВалют();
	КонецЕсли;
	Если Ошибка = 0 Тогда
		Попытка
			Константа.ДатаПоследнегоОбновленияВалют = ТекущаяДата();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат 1;
КонецФункции   //  Загрузить                                             
//******************************************************************************
//	ЗагрузитьСписокВалют()
//
//	Описание:  Осуществляет загрузку списка валют при открытии формы
Процедура ЗагрузитьСписокВалют()
	Курсы=СоздатьОбъект("Периодический");    
	Валюта=СоздатьОбъект("Справочник.Валюты");
	Валюта.ВыбратьЭлементы(); 
	Пока Валюта.ПолучитьЭлемент()=1 Цикл
		Если (Прав(Валюта.Код,3)="001")ИЛИ(Прав(Валюта.Код,3)="000")ИЛИ(Сокрлп(Валюта.Код)="0")ИЛИ(Прав(Валюта.Код,3)="980") Тогда
			Продолжить;
		КонецЕсли;
		ВалютаТМП = Валюта.ТекущийЭлемент();
		Курсы.ИспользоватьОбъект("Курс", ВалютаТМП); 
		Курсы.ОбратныйПорядок();
		Если Курсы.ВыбратьЗначения()=1 Тогда    
			Курсы.ПолучитьЗначение();
			ДатаЗнач = Курсы.ДатаЗнач; 
		Иначе 
			ДатаЗнач = 0;       
		КонецЕсли;
		Представление = "     "+СокрЛП(Валюта.Наименование)+";     на: "+Строка(ДатаЗнач)+"  =  "+Формат(Курсы.Значение,"Ч10.4");
		Н = СписокВалют.НайтиЗначение(ВалютаТМП);
		Если Н = 0 Тогда
			СписокВалют.ДобавитьЗначение(ВалютаТМП, Представление);
		Иначе
			СписокВалют.УстановитьЗначение(Н, ВалютаТМП, Представление);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры  // ЗагрузитьСписокВалют
//******************************************************************************
//	УстановитьКомпоненту()
//
//	Описание:  Осуществляет загрузку внешней компоненты V7Plus.dll
Функция УстановитьКомпоненту()
	РасположениеФайла(ПутьФайлаОбработки,ИмяФайлаОбработки);
	Если ЗагрузитьВнешнююКомпоненту(ПутьФайлаОбработки+"v7plus.dll")=0 Тогда
		Если ЗагрузитьВнешнююКомпоненту(КаталогИБ()+"ExtForms\v7plus.dll")=0 Тогда
			Если ЗагрузитьВнешнююКомпоненту("v7plus.dll")=0 Тогда
				глКомментарий("Не удалось обнаружить компоненту V7Plus.dll!",0,,"!"); 
				Возврат 0;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Попытка
		Соединение = СоздатьОбъект("Addin.V7HttpReader") ;
	Исключение 
		глКомментарий("Не удалось создать объект Addin.V7HttpReader!",0,,"!");
		Возврат 0;
	КонецПопытки; 
	Возврат 1;
КонецФункции  // УстановитьКомпоненту
//-------------------------------- 
Процедура УстановитьНачальнуюВидимость()
	Форма.НадписьТекДата.Видимость(0);
	Форма.РамкаCDROM.Видимость(0);
	Форма.CDROM.Видимость(0);
КонецПроцедуры
//--------------------------------
Процедура ИсточникПриИзменении()
	Если (ИсточникЗагрузки = Интернет) И ((СокрЛП(КодДоступа) = "") ИЛИ (СтрДлина(СокрЛП(КодДоступа)) < 32)) Тогда
		Форма.НадписьС.Видимость(0);
		Форма.НачДата.Видимость(0);
		Форма.НадписьПо.Видимость(0);
		Форма.КонДата.Видимость(0);
		Форма.ВыбПериода.Видимость(0);
		
		Форма.НадписьТекДата.Видимость(1);
		
		НачДата = ТекущаяДата();
		КонДата = НачДата;
		
	ИначеЕсли ((ИсточникЗагрузки = Интернет) И (СтрДлина(СокрЛП(КодДоступа)) = 32)) ИЛИ (ИсточникЗагрузки = ИТС) Тогда 
		Форма.НадписьС.Видимость(1);
		Форма.НачДата.Видимость(1);
		Форма.НадписьПо.Видимость(1);
		Форма.КонДата.Видимость(1);
		Форма.ВыбПериода.Видимость(1);
		
		Форма.НадписьТекДата.Видимость(0);
	КонецЕсли;
	
	Если (ИсточникЗагрузки = ИТС) Тогда  
		Форма.РамкаCDROM.Видимость(1);
		Форма.CDROM.Видимость(1); 
		
		Форма.КодДоступа.Видимость(0);
		Форма.РамкаКодДоступа.Видимость(0);
	Иначе
		Форма.РамкаCDROM.Видимость(0);
		Форма.CDROM.Видимость(0); 
		
		Форма.КодДоступа.Видимость(1);
		Форма.РамкаКодДоступа.Видимость(1);
	КонецЕсли;
	
КонецПроцедуры //ИсточникПриИзменении
//--------------------------------  
Процедура ОткрытьСайт() 
	ЗапуститьПриложение("http://1c.finance.ua"); 
КонецПроцедуры 
//--------------------------------  
Процедура КонтрольВремени() 
	НомерВызова = НомерВызова + 1;
	Если НомерВызова = 5 Тогда  
		Загрузить(1);
		ОткрытьСайт(); 
		Форма.Закрыть();
	КонецЕсли;   
КонецПроцедуры 
//--------------------------------
Процедура ПриОткрытии()  // Предопределенная
	Комментарий = "Получение курсов валют.";
	ФоновыйРежим = Форма.Параметр;
	Попытка
		НачДата = Константа.ДатаПоследнегоОбновленияВалют;
	Исключение
		НачДата=ТекущаяДата()-30;
	КонецПопытки;
	Результат=ВосстановитьЗначение("РезультатЗагрузкаВалют");
	Результат = ?(ПустоеЗначение(Результат)=1,1,Результат);
	Если НачДата >= ТекущаяДата() Тогда
		КонДата = НачДата;
		Если ФоновыйРежим = 1 Тогда
			Если Результат = 1 Тогда
				глКомментарий("Курсы валют сегодня (" + ТекущаяДата() + ") уже загружались.", 0);
			КонецЕсли;
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
	Иначе
		КонДата=ТекущаяДата();
	КонецЕсли;
	
	Если УстановитьКомпоненту()=0 Тогда
	    СтатусВозврата(0);
	КонецЕсли;
	
	Если Метаданные.Справочник("Валюты").Выбран()=0 Тогда
		глКомментарий("Не существует справочника ""Валюты""",0,,"!");
		СтатусВозврата(0);
	Иначе
		Если Метаданные.Справочник("Валюты").Реквизит("Курс").Выбран()=0 Тогда
			глКомментарий("Не существует реквизит ""Курс"" справочника ""Валюты""",0,,"!");
			СтатусВозврата(0);
		КонецЕсли;
		
		Если Метаданные.Справочник("Валюты").Реквизит("Кратность").Выбран()=0 Тогда
			глКомментарий("Не существует реквизит ""Кратность"" справочника ""Валюты""",0,,"!");
			СтатусВозврата(0);
		КонецЕсли;
	КонецЕсли;

	Если СтатусВозврата() = 0 Тогда
		глКомментарий("Загрузка валют невозможна!",0,,"!");
		Возврат;
	КонецЕсли;
	
	ВосстановитьЗначение("СписокВалютЗагрузкаВалют", СписокВалют);
	ЗагрузитьСписокВалют(); 
	Если ФоновыйРежим = 1 Тогда 
	    Форма.ИспользоватьСлой("Ожидание");
		НомерВызова = 1;
		Форма.ОбработкаОжидания("КонтрольВремени",5);  
	Иначе
	
		ВосстановитьЗначение("КодДоступа", КодДоступа);
		ВосстановитьЗначение("CDROM", CDROM);
		
		Интернет = 1;
		ИТС		 = 2; 	
		
		ИсточникЗагрузки = 1;
		Форма.ИспользоватьСлой("Основной");
		УстановитьНачальнуюВидимость();
		ИсточникПриИзменении();
	КонецЕсли;
	
КонецПроцедуры // ПриОткрытии
//--------------------------------
Процедура ПриЗакрытии()  // Предопределенная
	СохранитьЗначение("РезультатЗагрузкаВалют", Результат);
	СохранитьЗначение("СписокВалютЗагрузкаВалют", СписокВалют);
	СохранитьЗначение("КодДоступа", КодДоступа);
	СохранитьЗначение("CDROM", CDROM);
КонецПроцедуры // ПриЗакрытии
//--------------------------------