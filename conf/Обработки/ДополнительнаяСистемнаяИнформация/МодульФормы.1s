Перем Конт;

//******************************************************************************
// ПолучитьСписок()
// Формирует список значений из строки произвольных символов, разделенных запятыми.
//
// СписокЗначений - список значений, в который добавляются полученые значения
// СтрокаСРазделителями - строка, из которой формируем значения
Процедура ПолучитьСписок(СписокЗначений,СтрокаСРазделителями)
	Перем Позиция;           
	
	Пока ПустаяСтрока(СтрокаСРазделителями) = 0 Цикл
		Позиция = Найти(СтрокаСРазделителями, ",");                     
		СписокЗначений.ДобавитьЗначение(Лев(СтрокаСРазделителями,Позиция-1));
		СтрокаСРазделителями = Сред(СтрокаСРазделителями,Позиция+1);	
	КонецЦикла;	     	
КонецПроцедуры // ПолучитьСписок

	
//******************************************************************************
//	Сформировать()
//
//	Описание: Формирует сведения об организации, ответственных лицах, телефонах и факсах, которые
//            которые выбираются из информационной базы  
Процедура Сформировать()
	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить( "Контекст", Контекст );
	Расшифровка.Установить( "Дата", ТекущаяДата());
	Расшифровка.Установить( "ПолнНаименование", "" );
	Расшифровка.Установить( "Руководитель", "" );
	Расшифровка.Установить( "ГлавныйБухгалтер", "" );
	Расшифровка.Установить( "Телефоны", "" );
	Расшифровка.Установить( "Факсы", "" );
	глПолучитьДанные(Расшифровка);
	_Организация = СоздатьОбъект("СписокЗначений");
	_Организация.ДобавитьЗначение(Расшифровка.Получить("ПолнНаименование"));
	Конт.Установить("Организация",_Организация);
	_ФИО = СоздатьОбъект("СписокЗначений");
	Если ПустоеЗначение(Расшифровка.Получить("Руководитель")) = 0 Тогда
		_ФИО.ДобавитьЗначение(Строка(Расшифровка.Получить("Руководитель")));
	КонецЕсли;	
	Если ПустоеЗначение(Расшифровка.Получить("ГлавныйБухгалтер")) = 0 Тогда
		_ФИО.ДобавитьЗначение(Строка(Расшифровка.Получить("ГлавныйБухгалтер")));
	КонецЕсли;	
	Конт.Установить("ФИО",_ФИО);
	_Телефон = СоздатьОбъект("СписокЗначений"); 	
	ПолучитьСписок(_Телефон,Расшифровка.Получить("Телефоны")+",");
	Конт.Установить("Телефоны",_Телефон);
	_Факс = СоздатьОбъект("СписокЗначений");
	ПолучитьСписок(_Факс,Расшифровка.Получить("Факсы")+",");
	Конт.Установить("Факс",_Факс);
КонецПроцедуры // Сформировать
//-----------------------
Процедура ПриОткрытии() // Предопределенная
	Если ПустоеЗначение(Форма.Параметр)=1 Тогда
	    СтатусВозврата(0);
		Возврат;
	Иначе
		Конт = Форма.Параметр;
	КонецЕсли;
	Сформировать();
	СтатусВозврата(0);
КонецПроцедуры  //  ПриОткрытии
