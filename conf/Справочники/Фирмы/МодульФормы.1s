Перем тЕДРПОУ, КоличСотр;
Перем дСтараяДатаНачаларасчетаИндексации;


//// Модуль формы элемента справочника Фирмы
// ===============================
Процедура ИсторияЗначений()
	глРедактироватьИсториюЗначений(Контекст, "",
	"История периодических реквизитов (" + ТекущийЭлемент() + ")", 1, 0);
КонецПроцедуры //ИсторияЗначений

// ===============================
Процедура ПриВводеАдреса(ВидАдр)
	ТекАдрес = ПолучитьАтрибут(ВидАдр);
	ОткрытьФормуМодально("Обработка.ВводАдреса",ТекАдрес);
	УстановитьАтрибут(ВидАдр,ТекАдрес);
	Если (ВидАдр = "ЮридическийАдрес") и (ПустоеЗначение(СокрЛП(ФизическийАдрес)) = 1) Тогда
		ФизическийАдрес = ЮридическийАдрес;
	ИначеЕсли (ВидАдр = "ФизическийАдрес") и  (ПустоеЗначение(СокрЛП(ЮридическийАдрес)) = 1) Тогда
		ЮридическийАдрес = ФизическийАдрес;
	КонецЕсли;	
КонецПроцедуры

// ===============================
Функция УстДоступность()
	Закл = Форма.Закладки.ПолучитьЗначение(Форма.Закладки.ТекущаяСтрока());
	Если Закл = "Основной" Тогда
		Форма.рПаспортныеДанные.Доступность(ЧастноеЛицо);
		Форма.ДокНомер.Доступность(ЧастноеЛицо);
		Форма.ДокСерия.Доступность(ЧастноеЛицо);
		Форма.ДокКемВыдан.Доступность(ЧастноеЛицо);
		Форма.ДокДатаВыдачи.Доступность(ЧастноеЛицо);
		Форма.тДокНомер.Доступность(ЧастноеЛицо);
		Форма.тДокСерия.Доступность(ЧастноеЛицо);
		Форма.тДокКемВыдан.Доступность(ЧастноеЛицо);
		Форма.тДокДатаВыдачи.Доступность(ЧастноеЛицо);
		Форма.ДокНомер.Доступность(ЧастноеЛицо);
		Форма.ДокСерия.Доступность(ЧастноеЛицо);
		Форма.ДокКемВыдан.Доступность(ЧастноеЛицо);
		Форма.ДокДатаВыдачи.Доступность(ЧастноеЛицо);
		Если (ГруппаЕдиногоНалога = 1) или (ГруппаЕдиногоНалога = 2) Тогда
			Форма.ПлательщикНДС.Видимость(0);
		Иначе	
			Форма.ПлательщикНДС.Видимость(1);
		КонецЕсли;
	КонецЕсли;     
	Форма.кнСотрудники.Доступность(Выбран());
	Форма.кнСчета.Доступность(Выбран());
	Возврат "";
КонецФункции

// ===============================
Процедура ИзмНаименование()
	Если ПустаяСтрока(ПолнНаименование) = 1 Тогда
		ПолнНаименование = Наименование;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмЧастноеЛицо()
	Если ЧастноеЛицо = 0 Тогда
		ДокСерия = "";
		ДокНомер = "";
		ДокДатаВыдачи = 0;
		ДокКемВыдан = "";
		тЕДРПОУ = "По ЕДРПОУ:"
	Иначе
		тЕДРПОУ = "По ДРФО:"
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура УстОсновной()
	//Форма.Расчетчик.Видимость(Константа.ИспользоватьРасчетчиков * глПоказыватьРасчетчиков);
	//Форма.тРасчетчик.Видимость(Константа.ИспользоватьРасчетчиков * глПоказыватьРасчетчиков);
КонецПроцедуры

// ===============================
Функция ПроверкаПриЗаписи()
	Если ПустаяСтрока(Префикс) = 1 Тогда
		Предупреждение("Для фирмы необходимо указать префикс номера документа!");
		Возврат 0;
	КонецЕсли;
	Если Выбран() = 1 Тогда
		СпрФирмы = СоздатьОбъект("Справочник.Фирмы");
		СпрФирмы.НайтиЭлемент(ТекущийЭлемент());
		Если СпрФирмы.Префикс <> Префикс Тогда
			Если Вопрос("Вы уверены, что хотите изменить префикс номера документа?","Да+Нет") = "Нет" Тогда
				Возврат 0;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если глЗаписьПериодическихРеквизитов(Контекст) = 0 Тогда
		Возврат 0;
	КонецЕсли;   
	Возврат 1;
КонецФункции

// ===============================
Процедура СохранитьДатаБазыИндекса()   
	Если (ПустоеЗначение(ДатаБазыИндекса) = 1) Или (дСтараяДатаНачаларасчетаИндексации = ДатаБазыИндекса) Тогда
		Возврат; 
	КонецЕсли;
	
	Если Выбран() = 0 Тогда
	    Записать();
	КонецЕсли;
	
	Спр = СоздатьОбъект("Справочник.Фирмы");
	Спр.НайтиЭлемент(ТекущийЭлемент());
	Спр.ПризнакИзмененияДоходаДляИндексации.Установить(НачМесяца(ДатаБазыИндекса),1);
	Спр = "";
КонецПроцедуры

// ===============================
Процедура ПриЗаписи()              
	Если ПроверкаПриЗаписи() = 0 Тогда
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;
	//дата для расчета даты базы коеффициента инфляции
	СохранитьДатаБазыИндекса();
	глПодключитьМенеджерЗвит1С(0, ПустоеЗначение(ДатаНачалаИспользованияЗвит1С))
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()
	СохранениеПериодическихРеквизитов(2,"*");
	// установим закладки формы
	Форма.ИспользоватьЗакладки(1);
	Форма.Закладки.ДобавитьЗначение("Основной","Основные сведения");
	Форма.Закладки.ДобавитьЗначение("Регистрация","Регистрация и коды");
	Форма.Закладки.ДобавитьЗначение("ДополнительныеСведения","Дополнительно");
	Форма.Закладки.ДобавитьЗначение("Зарплата","Зарплата");
	Форма.ИспользоватьСлой("Основной, Общий",2);
	РС.ИспользоватьВладельца(ТекущийЭлемент());
	ВС.ИспользоватьВладельца(ТекущийЭлемент());
	
	Если ЧастноеЛицо = 0 Тогда
		тЕДРПОУ = "По ЕДРПОУ:"
	Иначе
		тЕДРПОУ = "По ДРФО:"
	КонецЕсли;
	
	Если Выбран() = 1 Тогда 
		ДатаБазыИндекса = глПрочитатьДатуИзмененияДоходаДляИндексации(ТекущаяДата(),"ПризнакИзмененияДоходаДляИндексации",ТекущийЭлемент());
		ДатаБазыИндекса = ДобавитьМесяц(ДатаБазыИндекса, -1);
	КонецЕсли;
	дСтараяДатаНачаларасчетаИндексации = ДатаБазыИндекса;
	Если ПустоеЗначение(ДатаПер) = 1 Тогда
		ДатаПер = ТекущаяДата();
	КонецЕсли;
КонецПроцедуры
                   
// ===============================
Процедура ПриЗакрытии()
КонецПроцедуры
	
// ===============================
Процедура ПриВыбореЗакладки(Ном,Значен);
	Форма.ИспользоватьСлой(Значен+", Общий",2);
КонецПроцедуры  

// ===============================
Процедура ВводНового(ПризнакКопирования) 
	Если ПризнакКопирования = 1 Тогда
		//Очищаем реквизиты подчиненных справочников
		Руководитель = 0;
		Кассир = 0;
		ГлавныйБухгалтер = 0;
		ПредседательПрофкома = 0;
		РС = 0;
		ВС = 0;
		

	КонецЕсли;
КонецПроцедуры

// ======================================
Процедура ПриНачалеВыбораЗначения(Рекв, ФлагСтандОбр)
	Если Форма.МодальныйРежим()=1 Тогда
		Возврат;
	КонецЕсли;
	Если (Рекв="Руководитель") или (Рекв="ГлавныйБухгалтер") или (Рекв="Кассир") или (Рекв="ПредседательПрофкома") Тогда
		ФлагСтандОбр = 0;
		Если Выбран() = 0 Тогда
			Если Вопрос("Элемент справочника сначала нужно записать. Сделать это?","Да+Нет") = "Да" Тогда
				Если ПроверкаПриЗаписи() = 1 Тогда
					Записать();
					ОткрытьФорму("Справочник.Сотрудники.ДляВыбора",ТекущийЭлемент());
				КонецЕсли;	
			КонецЕсли;
		Иначе
			ОткрытьФорму("Справочник.Сотрудники.ДляВыбора",ТекущийЭлемент());
		КонецЕсли;		
	ИначеЕсли (Рекв = "РС") или (Рекв = "ВС") Тогда
		ФлагСтандОбр = 0;
		Если Выбран() = 0 Тогда
			Если Вопрос("Элемент справочника сначала нужно записать. Сделать это?","Да+Нет") = "Да" Тогда
				Если ПроверкаПриЗаписи() = 1 Тогда
					Записать();
					ОткрытьФорму("Справочник.НашиДенежныеСчета.ФормаСписка",ТекущийЭлемент());
				КонецЕсли;	
			КонецЕсли;
		Иначе
			ОткрытьФорму("Справочник.НашиДенежныеСчета.ФормаСписка",ТекущийЭлемент());
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры 

// ======================================
Процедура ОбработкаВыбораЗначения(Значение, Рекв, Флаг)
	Если (Рекв="Руководитель") или (Рекв="ГлавныйБухгалтер") или (Рекв="Кассир") или (Рекв="ПредседательПрофкома") Тогда
		Если Значение.Фирма<>ТекущийЭлемент() Тогда
			Предупреждение("Можно выбирать только тех сотрудников, которые работают в этой фирме");
			Флаг = 0;
		КонецЕсли;
	ИначеЕсли (Рекв = "РС") или (Рекв = "ВС") Тогда
		Если Значение.Владелец <> ТекущийЭлемент() Тогда
			Предупреждение("Можно выбирать только расчетные счета этой фирмы!");
			Флаг = 0;
		ИначеЕсли Значение.БезНал = 0 Тогда
			Предупреждение("Можно выбирать только безналичные расчетные счета!");
			Флаг = 0;
		КонецЕсли;
	ИначеЕсли Рекв="ОсновнойСклад" Тогда
		Если Значение.ВидСклада <> Перечисление.ВидыСкладов.Оптовый Тогда
			Предупреждение("Можно выбирать место хранения только с видом склада: ""Склад (оптовый)""!");
			Флаг = 0;
		КонецЕсли;
	ИначеЕсли Рекв="ОсновнойМагазин" Тогда
		Если Значение.ВидСклада <> Перечисление.ВидыСкладов.Розничный Тогда
			Предупреждение("Можно выбирать место хранения только с видом склада: ""Магазин (розничный)""!");
			Флаг = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИзмЕДРПОУ()
	Если ЧастноеЛицо = 0 Тогда
		Если СтрДлина(СокрЛП(ЕДРПОУ)) > 8 Тогда
		    глКомментарий("Для организаций длина кода ЕДРПОУ не должна превышать 8 символов. Проверьте код ЕДРПОУ.",1);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры //ИзмЕДРПОУ
// ===============================
Функция ИзмКоэф()
	КоэфУменьшенияСтавкиЕСВФОТ =?(БазаЕСВФОТМесяц<>0,БазаЕСВФОТПрошлГод/БазаЕСВФОТМесяц, 1);
	Если КоэфУменьшенияСтавкиЕСВФОТ < 0.4 Тогда
	     КоэфУменьшенияСтавкиЕСВФОТ = 0.4;
	ИначеЕсли КоэфУменьшенияСтавкиЕСВФОТ > 1 Тогда	 
	     КоэфУменьшенияСтавкиЕСВФОТ = 1;
	КонецЕсли;
	Возврат 1;
КонецФункции
// ===============================
Функция РассчитатьМесяц(ДатаКон = "")    
	прПрошлГода = 1;
	Если ДатаКон = "" Тогда 
		//текущий расчетный период
		прПрошлГода = 0;
		ДатаКон = ДатаПер;
	КонецЕсли;
	СпрФирмы = СоздатьОбъект("Справочник.Фирмы");
	СпрФирмы.НайтиЭлемент(ТекущийЭлемент()); 
	ВыбраннаяФирма=СпрФирмы.ТекущийЭлемент(); 
	Если ДатаКон<='01.03.2015' Тогда  
		//2014 
		Дата1 = НачМесяца(ДатаКон);
		Дата2 = КонМесяца(ДатаКон);
		ноФЗПЕСВ = ""; ноФЗПЕСВИнв ="";
		Если глПолучитьНиО(ноФЗПЕСВ,   "ФЗПЕСВ",   "единый социальный взнос с фонда заработной платы!") = 0 Тогда
			Возврат 0;
		КонецЕсли;
		Спис = СоздатьОбъект("СписокЗначений");
		глПарсить(ноФЗПЕСВ.Дополнительно.Получить(Дата2),Спис);
		МаксБазаЕСВ = Число(Спис.Получить("Макс. база"));
		МаксБазаЕСВ = ?(МаксБазаЕСВ = 0, 999999999, МаксБазаЕСВ);
		
		ЗапрЗП = СоздатьОбъект("Запрос");  
		ТекстЗапроса = "";
		ТекстЗапроса = 
		"//{{ЗАПРОС(ЗапрЗП)
		|Период с Дата1 по Дата2; 
		|";
		ТекстЗапроса = ТекстЗапроса +"			
		|Фирма = Документ.НачислениеЗП.Фирма;
		|ВидНачисления = Документ.НачислениеЗП.ВидНачисления;
		|Оклад = Документ.НачислениеЗП.Оклад;
		|Тариф = Документ.НачислениеЗП.Тариф; 
		|Сдельно = Документ.НачислениеЗП.Сдельно;
		|Премия = Документ.НачислениеЗП.Премия;
		|ОблМатПомощь = Документ.НачислениеЗП.ОблагаемаяМатПомощь;
		|Отпуск  = Документ.НачислениеЗП.Отпускные;
		|Индексац = Документ.НачислениеЗП.Индексация;
		|ФиксИндек = Документ.НачислениеЗП.ФиксирИндексация;
		|БольнПредпр = Документ.НачислениеЗП.БольничныеЗаСчетПредприятия;
		|Больничн = Документ.НачислениеЗП.Больничные;
		|СуммаНачисл1 = Документ.НачислениеЗП.СуммаНачисл1;
		|СуммаНачисл2 = Документ.НачислениеЗП.СуммаНачисл2;
		|СуммаНачисл3 = Документ.НачислениеЗП.СуммаНачисл3;
		|Сотрудник  = Документ.НачислениеЗП.Сотрудник;
		|ТипСотр  = Документ.НачислениеЗП.Сотрудник.ТипСотрудника;
		|Инвалид  = Документ.НачислениеЗП.Сотрудник.Инвалид;
		|Функция БазаЕСВМес = Сумма(Оклад+ОблМатПомощь+Тариф+Отпуск+Индексац+ФиксИндек+Сдельно+Премия+СуммаНачисл1+СуммаНачисл2+СуммаНачисл3+Больничн+БольнПредпр);
		|Группировка Сотрудник без групп;
		|Условие(Фирма = ВыбраннаяФирма);
		|Условие(ВидНачисления = ОсновнаяЗП);
		|Условие(Инвалид = 0);
		|"//}}ЗАПРОС
		;
		// Если ошибка в запросе, то выход из процедуры
		Если ЗапрЗП.Выполнить(ТекстЗапроса) = 0 Тогда
			Сообщить("Не выполнился запрос по документам начисления ЗП!","!");
			Возврат 0;
		КонецЕсли;
		БазаЕСВМесяц = 0; КоличСотр=0;
		Пока ЗапрЗП.Группировка("Сотрудник") = 1 Цикл
			БазаЕСВМес = ?(ЗапрЗП.БазаЕСВМес>МаксБазаЕСВ, МаксБазаЕСВ,ЗапрЗП.БазаЕСВМес);
			БазаЕСВМесяц = БазаЕСВМесяц + БазаЕСВМес;
			КоличСотр = КоличСотр + ?(БазаЕСВМес<>0,1,0);
		КонецЦикла;
		Если прПрошлГода=1 Тогда 
			Возврат БазаЕСВМесяц;
		Иначе	
			БазаЕСВФОТМесяц = ?(КоличСотр=0,0,БазаЕСВМесяц/КоличСотр);
			ИзмКоэф();
		КонецЕсли;
	Иначе	
		Вед = СоздатьОбъект("Документ.НачислениеЗП");
		Вед.ВыбратьДокументы(НачМесяца(ДатаКон),КонМесяца(ДатаКон));
		БазаЕСВМесяц = 0; КоличСотр=0;
		Пока Вед.ПолучитьДокумент() = 1 Цикл
			Если (Вед.ПометкаУдаления() = 1) Или (Вед.ВидНачисления <> ОсновнаяЗП) или (Вед.Проведен() = 0) Тогда
			    Продолжить;
			КонецЕсли; 
			БазаЕСВМесяц = БазаЕСВМесяц + Вед.БазаЕСВФОТМесяц;
			КоличСотр    = КоличСотр + Вед.КоличествоСотр;
		КонецЦикла;
		Если прПрошлГода=1 Тогда 
			Возврат БазаЕСВМесяц;
		Иначе	
			БазаЕСВФОТМесяц = ?(КоличСотр=0,0,БазаЕСВМесяц/КоличСотр);
			ИзмКоэф();
		КонецЕсли;
	КонецЕсли;

КонецФункции
// ===============================
Функция РассчитатьПрошлГод()
	ДатаПериода = НачГода(ДобавитьМесяц(ДатаПер,-12));
	БазаГод = 0; КолМес = 0;  КоличСотрГод = 0;
	Для сч = 1 по 12 Цикл 
		БазаМес = РассчитатьМесяц(ДатаПериода);
		БазаГод = БазаГод + БазаМес; 
		ДатаПериода = ДобавитьМесяц(ДатаПериода,1);  
		КолМес = КолМес + ?(БазаМес>0,1,0);
		КоличСотрГод = КоличСотрГод + КоличСотр;
	КонецЦикла;
	КолЗастрахПрошлГод = Окр(?(КолМес<>0,КоличСотрГод/КолМес,1),0);
	БазаЕСВФОТПрошлГод = ?((КолМес<>0)и(КолЗастрахПрошлГод<>0),БазаГод/КолМес/КолЗастрахПрошлГод,0);
	ИзмКоэф();
	Возврат 1;
КонецФункции
