// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
	    Возврат;
	КонецЕсли;
	Наименование = "Основной";
	Безнал = 1;
	Валюта = Гривня;
	СчетУчета = СчетПоКоду("31.1");
	ТипСчета = Перечисление.ТипыБезналичныхСчетов.Текущий;
КонецПроцедуры
                  
// ===============================
Процедура УстСчетУчета()
	Если Валюта = Гривня Тогда
	    Если Безнал=0 Тогда
		    СчетУчета = СчетПоКоду("30.1");
		ИначеЕсли ТипСчета = Перечисление.ТипыБезналичныхСчетов.Текущий Тогда
			СчетУчета = СчетПоКоду("31.1");
		Иначе
			СчетУчета = СчетПоКоду("31.3");
		КонецЕсли;	
	Иначе
		Если Безнал=0 Тогда
		    СчетУчета = СчетПоКоду("30.2");
		ИначеЕсли ТипСчета = Перечисление.ТипыБезналичныхСчетов.Текущий Тогда
			СчетУчета = СчетПоКоду("31.2");
		Иначе
			СчетУчета = СчетПоКоду("31.4");
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры                   
                   
// ===============================
Процедура ИзмБезНал()	
	УстСчетУчета();
	Если (БезНал = 1) и (ПустоеЗначение(ТипСчета) = 1) Тогда
		ТипСчета = Перечисление.ТипыБезналичныхСчетов.Текущий;
	КонецЕсли;
КонецПроцедуры                   	
                   
// ===============================
Процедура ИзмТипУчета()	
	Если ТипСчета <> Перечисление.ТипыБезналичныхСчетов.Текущий Тогда
		СпецСчетНДС = 0;
	КонецЕсли;
	УстСчетУчета();
КонецПроцедуры                   	

// ===============================
Процедура ИзмСпецСчетНДС()
	Если СпецСчетНДС.ТипСчета <> Перечисление.ТипыБезналичныхСчетов.СпецСчетНДС Тогда
		Предупреждение("Выбранный счет не является счетом НДС!");
		Возврат;
	КонецЕсли;
	Если СпецСчетНДС.Владелец <> Владелец Тогда
		Предупреждение("Выбранный счет НДС принадлежит другой фирме!");
	КонецЕсли;
	УстСчетУчета();
КонецПроцедуры
	
// ===============================
Процедура ИзмВалюта()
	Если Валюта.Выбран() = 0 Тогда
	    Возврат;
	КонецЕсли;          
	УстСчетУчета();
КонецПроцедуры

// ===============================
Процедура ПриОткрытии()
	Форма.Валюта.ВыполнятьФормулуТолькоПриИзменении(1);
КонецПроцедуры

// ===============================
Функция УстДоступность()
	Если (Безнал = 0) Тогда
		Форма.НомерЛистаКассовойКниги.Видимость(1);
		Форма.тНомерЛистаКассовойКниги.Видимость(1);
		Форма.ргНомерЛистаКассовойКниги.Видимость(1);
	Иначе
		Форма.НомерЛистаКассовойКниги.Видимость(0);
		Форма.тНомерЛистаКассовойКниги.Видимость(0);
		Форма.ргНомерЛистаКассовойКниги.Видимость(0);
	КонецЕсли;     

	Если БезНал = 1 Тогда
		НовоеНаименование = СтрЗаменить(Наименование,"Касса основная","Основной");
	Иначе
		НовоеНаименование = СтрЗаменить(Наименование,"Основной","Касса основная")
	КонецЕсли;
	
	Если НовоеНаименование <> Наименование Тогда
		Наименование = НовоеНаименование;
	КонецЕсли;
	
	Форма.ТипСчета.Видимость(Безнал);
	Форма.тТипСчета.Видимость(Безнал);
	Форма.СпецСчетНДС.Видимость(Безнал);
	Форма.тСпецСчетНДС.Видимость(Безнал);
	Если ТипСчета = Перечисление.ТипыБезналичныхСчетов.Текущий Тогда
		Форма.СпецСчетНДС.Доступность(1);
	Иначе
		Форма.СпецСчетНДС.Доступность(0);
	КонецЕсли;
	
    Возврат "";
КонецФункции

// ===============================
Процедура ПриЗаписи()
	Если Безнал=0 Тогда
		Если глЗаписьПериодическихРеквизитов(Контекст) = 0 Тогда
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
		ТипСчета = 0;
		СпецСчетНДС = 0;
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ПриНачалеВыбораЗначения(Рекв,ФлагСтандОбр)
	Если Рекв="СпецСчетНДС" Тогда
		СпецСчетНДС.ИспользоватьВладельца(Владелец);
	КонецЕсли;
КонецПроцедуры
