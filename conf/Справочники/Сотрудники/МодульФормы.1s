Перем НачФирма, дСтараяДатаНачаларасчетаИндексации;

// ===============================
// Индексация
// ===============================
Процедура СоздатьТбИндексИнфляции(НП, ПорогИндексации)
	Перем ноИндексИнфляции;

	спДоп = СоздатьОбъект("СписокЗначений");
	глПолучитьНиО(ноИндексИнфляции, "ИндексИнфл", "о индексе инфляции");
	глПарсить(ноИндексИнфляции.Дополнительно.Получить(НП),спДоп);
	ПорогИндексации = Число(спДоп.Получить("ПорогИндексации"));
	
	глТбИндексИнфляции = СоздатьОбъект("ТаблицаЗначений");
	глТбИндексИнфляции.НоваяКолонка("Месяц","Дата");
	глТбИндексИнфляции.НоваяКолонка("Коэф","Число",7,4);
	глТбИндексИнфляции.НоваяКолонка("Контролька","Число",1,0);
	
	Периодический = СоздатьОбъект("Периодический");
	Периодический.ИспользоватьОбъект("Ставка",ноИндексИнфляции); 
	Периодический.ВыбратьЗначения();
	Пока Периодический.ПолучитьЗначение() = 1 Цикл
		глТбИндексИнфляции.НоваяСтрока();
		глТбИндексИнфляции.Месяц = НачМесяца(Периодический.ДатаЗнач);
		глТбИндексИнфляции.Коэф = Периодический.Значение;
		глТбИндексИнфляции.Контролька = 1;
	КонецЦикла; 
КонецПроцедуры

// =============================== 
// проверить корректно ли заполнен периодический реквизит
Процедура ПроверитьТбИндексИнфляции(знач НачМесяц = '01.03.03', ОкПериода)
	Если ПустоеЗначение(НачМесяц) = 1  Тогда
		НачМесяц = глДатаНачалаРасчетаИндексации;
	КонецЕсли;           
	тб = СоздатьОбъект("ТаблицаЗначений");
	глТбИндексИнфляции.Выгрузить(тб);
	тб.Свернуть("Месяц","Контролька");
	тб.Сортировать("Месяц");
	
	ОкПериодаДляПроверки = НачМесяца( ДобавитьМесяц(ОкПериода,-2) );
	тб.ВыбратьСтроки();    
	Пока тб.ПолучитьСтроку() = 1 Цикл  
		Если НачМесяц > тб.Месяц Тогда 
			Продолжить;
		КонецЕсли;
		Если НачМесяц > ОкПериодаДляПроверки Тогда   
			Прервать;
		КонецЕсли;
		Если (тб.Месяц <= НачМесяца(ОкПериода)) Тогда 
			Пока (тб.Месяц <> НачМесяц) и (НачМесяц  <= ОкПериодаДляПроверки) Цикл
				глКомментарий("За " + Формат(НачМесяц,"ДММММГГ") + " нет информации об индексе инфляции",0);
				НачМесяц = ДобавитьМесяц(НачМесяц, 1);
			КонецЦикла;
			Если тб.Контролька > 1 Тогда
				глКомментарий("За " + Формат(НачМесяц,"ДММММГГ") + " обнаружено " + тб.Контролька + " знач. индекса инфляции",0);
			КонецЕсли;
		КонецЕсли; 
		НачМесяц = ДобавитьМесяц(НачМесяц, 1);
	КонецЦикла; 
	
	КонПериода = НачМесяца(ДобавитьМесяц(ОкПериода,-2));

	Если НачМесяц < КонПериода Тогда
		глКомментарий("За период " + ПериодСтр(НачМесяца(НачМесяц),КонМесяца(КонПериода)) + " нет информации об индексе инфляции",0);
	КонецЕсли;
	
	Пока НачМесяц = КонПериода Цикл
		глКомментарий("За " + Формат(НачМесяц,"ДММММГГ") + " нет информации об индексе инфляции",0);
		НачМесяц = ДобавитьМесяц(НачМесяц, 1);
	КонецЦикла;
	
	тб = "";
КонецПроцедуры
                                           
//=====================================
//ОкПериода  - дата на которую делается расчет
Функция ПолучитьКоэффициентИндексации(знач НачПериода, знач ОкПериода)
	Перем ПорогИндексации;  
	
	Если ОкПериода < НачПериода Тогда
	    Возврат 0;
	КонецЕсли;
	
	Коэф = 1; 
	ТекКоэф = 1; //для перемножения коэф до достижения порога индексации  
	
	СоздатьТбИндексИнфляции(НачПериода, ПорогИндексации);
	ПроверитьТбИндексИнфляции(НачПериода, ОкПериода);
	                                   
	НачПериода = НачМесяца(НачПериода); 
	НачИнд = "";
	глТбИндексИнфляции.НайтиЗначение(НачПериода, НачИнд,"Месяц");  
	ОкПериода = НачМесяца(ДобавитьМесяц(ОкПериода, -2)); 
	КонИнд = "";                 

	глТбИндексИнфляции.НайтиЗначение(ОкПериода, КонИнд,"Месяц");  
	Если (НачИнд > 0) и (КонИнд > 0) Тогда
		Для Инд = НачИнд По КонИнд Цикл  
			глТбИндексИнфляции.ПолучитьСтрокуПоНомеру(Инд); 
			ТекКоэф = ТекКоэф * глТбИндексИнфляции.Коэф;
			глКомментарий("---За "+ глТбИндексИнфляции.Месяц + " Текущий коэф = " + ТекКоэф,3);
			Если ТекКоэф > ПорогИндексации Тогда
				Коэф = Коэф * Окр(ТекКоэф, 3); 
				ТекКоэф = 1;
			КонецЕсли;  
			глКомментарий("За "+ глТбИндексИнфляции.Месяц + " Коэф = "+ Окр(Коэф,3),3);
		КонецЦикла;
	КонецЕсли;
	
	Сообщить("Для сотрудника " + Наименование + " итоговый коэффициент индексации равен "+Окр(Коэф,3));
	
	Возврат Окр(Коэф,3) - 1;
КонецФункции
// ===============================
Функция ВычИндексация(БазаИндексации, ДатаИнд)   
	Перем ноПрожМинимум;
	Если глПолучитьНиО(ноПрожМинимум,"ПрожМинТруд","о минимальной зарплате!") = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ДатаНачалаРасчетаИндексацииПоФирме = глПрочитатьДатуИзмененияДоходаДляИндексации(ДатаИнд-1,"ПризнакИзмененияДоходаДляИндексации",Фирма);
	ДатаНачалаРасчетаИндексацииПоСотруднику = ДобавитьМесяц(глДатаНачалаРасчетаИндексации, -1);

	Если (ДатаИнд-1 < '01.12.2015') или (ТекущийЭлемент().Перемещение.Получить(КонМесяца(ДатаИнд)) = 0) Тогда
		ДатаНачалаРасчетаИндексацииПоСотруднику = глПрочитатьДатуИзмененияДоходаДляИндексации(ДатаИнд-1,"ПризнакИзмененияДоходаДляИндексации",ТекущийЭлемент());
	КонецЕсли;	
	ДатаНачалаРасчетаИндексации = Макс(ДатаНачалаРасчетаИндексацииПоСотруднику, ДатаНачалаРасчетаИндексацииПоФирме); 

	глКомментарий("Вычисление коэф. индексации для сотрудника "+ Наименование,3);
	КоэфИндексации = ПолучитьКоэффициентИндексации(ДатаНачалаРасчетаИндексации, ДатаИнд);
	
	//здесь будет расчет индексации
	ПрожМинимум = ноПрожМинимум.Предел.Получить(ДатаИнд);
	Если БазаИндексации > ПрожМинимум Тогда
		//База индексации ограничена прожиточным минимум
		БазаИндексации = ПрожМинимум;
	КонецЕсли;	
	
	Возврат БазаИндексации*КоэфИндексации;
КонецФункции	
// ===============================
Функция РассчитатьИнд()    
	Если ТекущийЭлемент().ТипСотрудника.Получить(КонМесяца(ДатаБазыИндекса)) = 0 Тогда
		//По совместителю индексацию не делаем
		Возврат 0;
	КонецЕсли;	
	ДатаИнд = НачМесяца(ДатаБазыИндекса-1);
	ОкладИнд = ТекущийЭлемент().Оклад.Получить(КонМесяца(ДатаИнд)); 
	ТарифИнд = ТекущийЭлемент().Тариф.Получить(КонМесяца(ДатаИнд))*176;

	БазаИнд = ОкладИнд + ТарифИнд;
	БазаИндНов = Оклад + Тариф*176;     //+ Сдельно
	Если ОкладИнд >= БазаИндНов  Тогда    
		//Фиксированная индексация не меняется
	Иначе	
		ИндексацияСтар = ВычИндексация(БазаИнд, ДатаБазыИндекса);   
		Если (ОкладИнд + ТарифИнд + ИндексацияСтар + СуммаФиксирИндексации < БазаИндНов) Тогда   
			 СуммаФиксирИндексации = 0;
		ИначеЕсли (ОкладИнд + ТарифИнд + ИндексацияСтар > БазаИндНов) Тогда	
			 СуммаФиксирИндексации = СуммаФиксирИндексации + ОкладИнд + ТарифИнд + ИндексацияСтар - БазаИндНов;
		КонецЕсли;
	КонецЕсли;
	Возврат 0;
КонецФункции 
// ===============================
Процедура ИзмФИО()
	Если ПустаяСтрока(Фамилия) = 0 Тогда
	    Наименование = глФИО(СокрЛП(Фамилия) + " " + СокрЛП(Имя) + " " + СокрЛП(Отчество), 1);
	КонецЕсли;
КонецПроцедуры

// ===============================
Процедура ИсторияЗначений()
	глРедактироватьИсториюЗначений(Контекст, "",
	"История периодических реквизитов (" + ТекущийЭлемент() + ")", 1, 0);
КонецПроцедуры //ИсторияЗначений

// ======================================
Функция УстДоступность()
	Если (ПустоеЗначение(Фирма) <> 1) и (Фирма = НачФирма) Тогда
	    Форма.Фирма.Доступность(0);
	КонецЕсли;
	Возврат "";
КонецФункции

// ======================================
Процедура ИзмФирма()
	Если Фирма.Выбран() = 1 Тогда
		УстановитьНовыйКод(СокрЛП(Фирма.Префикс)+"-");
	КонецЕсли;
КонецПроцедуры 
                    
// ======================================
Процедура ИзмСчетЗатрат()
	Если СчетЗатрат.Выбран() = 1 Тогда
		Если ИспользоватьСчетаРасходов = Класс8 Тогда
			Если (СчетЗатрат <> СчетПоКоду("231")) и (СчетЗатрат <> СчетПоКоду("24")) Тогда
		   		Предупреждение("Если используется только 8-й класс счетов, счет затрат не должен указываться или же может быть указан счет ""231"" либо счет ""24""!");
			СчетЗатрат = глВосстановитьЗначение("Сотрудники","СчетЗатрат");
			КонецЕсли;
		ИначеЕсли глПроверитьСчетЗатрат(СчетЗатрат,1)=0 Тогда
			СчетЗатрат = глВосстановитьЗначение("Сотрудники","СчетЗатрат");
		КонецЕсли;	
	КонецЕсли;
	глСохранитьЗначение("Сотрудники","СчетЗатрат", СчетЗатрат);
КонецПроцедуры 

// ======================================
Процедура ИзмДатаПриема()
	Если Выбран() = 0 Тогда
		ДатаБазыИндекса = ДобавитьМесяц(ДатаПриема,-1);
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура ИзмДолжность()
	Если ПустоеЗначение(НаименованиеПоКП)=1 Тогда
		НаименованиеПоКП = Должность;
	КонецЕсли;
КонецПроцедуры
// ===============================
Процедура СохранитьДатаБазыИндекса()   
	Если (ПустоеЗначение(ДатаБазыИндекса) = 1) Или (дСтараяДатаНачаларасчетаИндексации = ДатаБазыИндекса) Тогда
		Возврат; 
	КонецЕсли;
	
	Если Выбран() = 0 Тогда
		Записать();
	КонецЕсли;
	
	Спр = СоздатьОбъект("Справочник.Сотрудники");
	Спр.НайтиЭлемент(ТекущийЭлемент());
	Спр.ПризнакИзмененияДоходаДляИндексации.Установить(НачМесяца(ДатаБазыИндекса),1);

	Спр.Перемещение.Установить(Макс(ТекущаяДата(),НачМесяца(ДатаБазыИндекса)),0);
	Спр = "";
КонецПроцедуры


// ===============================
Процедура ВводНового(ПризнакКопирования)
	Если ПризнакКопирования = 1 Тогда
	    Возврат;
	КонецЕсли;
	ИспользоватьДату('01.01.1980');
	ТипСотрудника = 1; // основной
	Фирма = глВосстановитьЗначение(,"БазФирма");
	СчетЗатрат = глВосстановитьЗначение("Сотрудники","СчетЗатрат");
	ИзмФирма();
	ВидДеятельности = глВосстановитьЗначение(,"БазВидДеятельности");
КонецПроцедуры //ВводНового

// ===============================
Процедура ПриОткрытии()     
	СохранениеПериодическихРеквизитов(2, "*");
	глСохранитьЗначение("Сотрудники","СчетЗатрат", СчетЗатрат);
	
	Форма.ИспользоватьЗакладки(1);
	Форма.Закладки.ДобавитьЗначение("Основной","Общие");
	Форма.Закладки.ДобавитьЗначение("Зарплата","Данные по з/п");
	Форма.Закладки.ДобавитьЗначение("Паспорт","Паспортные, налоговые данные");
	Форма.ИспользоватьСлой("Основной, Общий",2);
	
	Активизировать("Фамилия",0);
	Если Выбран() = 1 Тогда
		НачФирма = Фирма;
	КонецЕсли; 
	
	Если Выбран() = 1 Тогда 
		ДатаБазыИндекса = глПрочитатьДатуИзмененияДоходаДляИндексации(ТекущаяДата(),"ПризнакИзмененияДоходаДляИндексации",ТекущийЭлемент());
		ДатаБазыИндекса = ДобавитьМесяц(ДатаБазыИндекса, -1);
	КонецЕсли;
	дСтараяДатаНачаларасчетаИндексации = ДатаБазыИндекса;
КонецПроцедуры

// ===============================
Процедура ПриВыбореЗакладки(Ном,Значение);
	Форма.ИспользоватьСлой("Общий,"+Значение,2);
КонецПроцедуры 

// ===============================
Процедура ПриЗаписи()
	Если (глЗаписьПериодическихРеквизитов(Контекст) = 0)  Тогда
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;
	Если СчетЗатрат.Выбран() = 1  Тогда                    
		Если (ИспользоватьСчетаРасходов = Класс8) Тогда
			Если (СчетЗатрат <> СчетПоКоду("231")) и (СчетЗатрат <> СчетПоКоду("24")) Тогда
		   		глКомментарий("Если используется только 8-й класс счетов, счет затрат не должен указываться или же может быть указан счет ""231"" либо счет ""24""!",0,,"!");
		   		СтатусВозврата(0);
				Возврат;
			КонецЕсли;
		ИначеЕсли глПроверитьСчетЗатрат(СчетЗатрат,2)=0 Тогда
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;	
	ИначеЕсли ИспользоватьСчетаРасходов <> Класс8 Тогда
	    глКомментарий("Не выбран счет затрат!",0,,"!");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;
	глСохранитьЗначение("Сотрудники","СчетЗатрат",СчетЗатрат);
	
	//дата для расчета даты базы коеффициента инфляции
	СохранитьДатаБазыИндекса();
КонецПроцедуры //ПриЗаписи
