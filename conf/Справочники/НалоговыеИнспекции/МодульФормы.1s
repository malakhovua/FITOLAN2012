Процедура ПриЗаписи()
   	Если СтрДлина(СокрЛП(Код)) < 4 Тогда
		Предупреждение("Код ГНИ должен состоять из четырех символов!");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;

	Если СтрДлина(СокрЛП(КодАдмРайона)) < 2 Тогда
		Предупреждение("Код адм. района должен состоять из двух символов!");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;

	//Заполним реквизит, используемый для поиска элемента
	КодДляПоиска = Код + КодАдмРайона;
КонецПроцедуры