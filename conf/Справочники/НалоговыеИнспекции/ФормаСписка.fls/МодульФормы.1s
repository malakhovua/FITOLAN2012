//----------------------------------------
Процедура ЗагрузитьДПИ()
  	ОткрытьФорму("Обработка.ЗагрузкаДПИ");  
КонецПроцедуры

//----------------------------------------
Функция УстДоступность()
	//возможность Переопределения сслок имеет смысл только после обновления релиза?
	//когда в корне справочника имеются вновь созданные налоговые инспекции.
	//при нормальной работе, налоговые инспекции должны располагаться в группах-регионнах
	Форма.кнПереопределитьСсылки.Видимость(0);			
	Если (ИерархическийСписок() = 1) И (ТекущийЭлемент().ЭтоГруппа() = 0) Тогда
        Если ПустоеЗначение(ТекущийЭлемент().Родитель) = 1 Тогда
        	Форма.кнПереопределитьСсылки.Видимость(1);			
		КонецЕсли;
	КонецЕсли;
	Возврат ""
КонецФункции


//----------------------------------------
Процедура ВыполнитьПереопределениеСсылок(Старый, Новый)
	//переопределим все ссылки в спр. Фирмы и Сотрудники на новую ДПИ.
	//И заполним недостающие реквизиты
	НачатьТранзакцию();
	Попытка
		//поищем в Фирмах
		Спр=СоздатьОбъект("Справочник.Фирмы");
		ДПИ=СоздатьОбъект("Периодический");
		Спр.ВыбратьЭлементы();
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			ДПИ.ИспользоватьОбъект("НалоговаяИнспекция", Спр.ТекущийЭлемент());
			ДПИ.ВыбратьЗначения();
			Пока ДПИ.ПолучитьЗначение() = 1 Цикл
				Если ДПИ.Значение = Старый Тогда
					ДПИ.Значение = Новый.ТекущийЭлемент();
					ДПИ.Записать()
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ДПИ = 0;
		
		//поищем в Сотрудниках
		Спр=СоздатьОбъект("Справочник.Сотрудники");
		Спр.ВыбратьЭлементы();
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			Если Спр.НалоговаяИнспекция = Старый Тогда
				Спр.НалоговаяИнспекция = Новый.ТекущийЭлемент();
				Спр.Записать()
			КонецЕсли;
		КонецЦикла;
		
		//Дозаполним реквизиты нового элемента
		Спр=СоздатьОбъект("Справочник.НалоговыеИнспекции");
		Спр.НайтиЭлемент(Новый.ТекущийЭлемент());
		Если ПустоеЗначение(Старый.ЕДРПОУ) = 0 Тогда
			Спр.ЕДРПОУ = Старый.ЕДРПОУ	
		КонецЕсли;
		Если ПустоеЗначение(Старый.Адрес) = 0 Тогда
			Спр.Адрес = Старый.Адрес	
		КонецЕсли;
		Спр.Записать();
		
		//пометим старый элемент на удаление
		Спр.НайтиЭлемент(Старый.ТекущийЭлемент());
		Спр.Удалить(0);
		Спр.Записать();
		
		Спр = 0;
	Исключение
		//какой-то из объектов возможно заблокирован
		Сообщить("Операция не выполнена! " + РазделительСтрок+ОписаниеОшибки());
		ОтменитьТранзакцию();
		Возврат
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
	Предупреждение("Операция выполнена успешно!");
КонецПроцедуры

//----------------------------------------
Процедура ПереопределитьСсылки()
	ОткрытьПодбор("Справочник.НалоговыеИнспекции","ФормаВыбора",,1)   
КонецПроцедуры    

//----------------------------------------
Процедура ОбработкаПодбора(Элемент, Конт)
	Если (ПустоеЗначение(Элемент) = 0) Тогда
		Если ПустоеЗначение(Элемент.Родитель) = 1 Тогда
			Предупреждение("Неверный выбор! Операция не выполнена!");
			Возврат
		КонецЕсли; 
	КонецЕсли;		
	
	Конт.Форма.Закрыть();
	ВыполнитьПереопределениеСсылок(ТекущийЭлемент(),Элемент)
КонецПроцедуры