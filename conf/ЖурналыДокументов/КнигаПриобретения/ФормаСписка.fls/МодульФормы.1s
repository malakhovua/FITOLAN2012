// ======================================
Процедура ПриОткрытии()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
КонецПроцедуры 

// ===============================
Функция ТребуетРегистрации()
	Если ТекущийДокумент.Выбран()=1 Тогда
		Возврат ?(ТекущийДокумент.ТребуетПровВклВЕдРеестрНН=1,2,0)
	КонецЕсли;
КонецФункции

// ===============================
Процедура ЭкспортЗКП()
	Если ТекущийДокумент.Выбран()=0 Тогда
		Возврат;
	КонецЕсли;  
	
	спВариантЭкспорта = СоздатьОбъект("СписокЗначений");
	спВариантЭкспорта.ДобавитьЗначение("Отправить запрос и проверить состояние регистрации в ""FREDO Звіт""");
	
	Результат = ПолучитьПустоеЗначение();
	Если спВариантЭкспорта.ВыбратьЗначение(Результат, , , , 1) <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	// Выведем причины невозможности использования FREDO Звіт, в случае если менеджер не инициализирован
	Если глПодключитьМенеджерЗвит1С() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если глМенеджерЗвит1С.Получить("АктуальныйРелизРегОтчетов") < "12q1002" Тогда
		Предупреждение("Для отправки запроса и проверки состояние регистрации в ""FREDO Звіт""
		               |необходимо установить комплект регламентированных отчетов за I квартал 2012(2) или позже");
		Возврат;
	КонецЕсли;

	глРасшифровка = СоздатьОбъект("СписокЗначений");
	глРасшифровка.Установить("ТекущийДокумент", ТекущийДокумент);
	глРасшифровка.Установить("ИспользоватьОтчет_ЭкспортНалоговойНакладной", 1); 
	глВыполнитьКомандуЗвит1С("ВыгрузитьДокумент", глРасшифровка);
	
КонецПроцедуры    

// ===============================
Процедура ИмпортЗКП()
	
	СтатусВозврата(0);
		
	// Выведем причины невозможности использования FREDO Звіт, в случае если менеджер не инициализирован
	Если глПодключитьМенеджерЗвит1С() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если глМенеджерЗвит1С.Получить("АктуальныйРелизРегОтчетов") < "15q3001" Тогда 
		Предупреждение("Для загрузки входящих налоговых накладных и расчетов корректировки из ""FREDO Звіт""
		               |необходимо установить комплект регламентированных отчетов за III квартал 2015 (1) или позже");
		Возврат;
	КонецЕсли;

	глВыполнитьКомандуЗвит1С("ОткрытьФормуЗагрузкиВходящихНалоговыхДокументов");
	
КонецПроцедуры


