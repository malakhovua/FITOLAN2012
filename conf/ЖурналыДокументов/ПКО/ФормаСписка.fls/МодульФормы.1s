Процедура ПриОткрытии()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	УстановитьОтбор("ПриходныйКассовый");
КонецПроцедуры                             

Процедура ОбрВыбКасса()
	УстановитьОтбор("ПриходныйКассовый_Рсчет",ВыбКасса);
КонецПроцедуры 
               

Процедура УдВыбКасса()
	УстановитьОтбор("ПриходныйКассовый");
	ВыбКасса = "";
КонецПроцедуры 


кФирма = Константа.БазФирма;




