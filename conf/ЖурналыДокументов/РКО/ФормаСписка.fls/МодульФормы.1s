Процедура ПриОткрытии()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	УстановитьОтбор("РасходныйКассовый");
КонецПроцедуры                             

Процедура ОбрВыбКасса()
	УстановитьОтбор("РасходныйКассовый_Рсчет",ВыбКасса);
КонецПроцедуры 
               

Процедура УдВыбКасса()
	УстановитьОтбор("РасходныйКассовый");
	ВыбКасса = "";
КонецПроцедуры 


кФирма = Константа.БазФирма;




