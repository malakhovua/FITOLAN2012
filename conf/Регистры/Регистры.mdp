				Тип: Документ
			}
			КредДокумент: 
			{
				Комментарий: "Документ по кредиту"
				Синоним: "Кред. док-т"
				Тип: Документ
			}
			Валюта: 
			{
				Комментарий: "Валюта долга"
				Тип: Справочник
				Агрегатный тип: Справочник.Валюты
			}
		}
		Ресурсы: 
		{
