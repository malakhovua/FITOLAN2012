Перем Т;
Перем Обновить;
Перем Расшифровка;
Перем ПредставлениеРУ;
Перем СчетКурсовыхРазниц; 

// ===============================
Функция РасшифровкаОбновить(Обновить)
	Расшифровка.Установить("Обновить", Обновить);
	Возврат Расшифровка;
КонецФункции

// ===============================
Процедура ДобавитьОбороты(ТЗ, ТекВалюта, ВалПриход, Приход, ВалРасход, Расход)
	Перем Стр;
	ТЗ.НайтиЗначение(ТекВалюта, Стр, "Валюта");
	Если Стр = 0 Тогда
		ТЗ.НоваяСтрока();
		ТЗ.Валюта = ТекВалюта;
		ТЗ.ВалОстаток = 0;
		ТЗ.Остаток = 0;
		ТЗ.ВалПриход = ВалПриход; 
		ТЗ.Приход = Приход;
		ТЗ.ВалРасход = ВалРасход;
		ТЗ.Расход = Расход;
		ТЗ.ПриходКР = 0;
		ТЗ.РасходКР = 0;
	Иначе
		ТЗ.ПолучитьСтрокуПоНомеру(Стр);
		ТЗ.ВалПриход = ТЗ.ВалПриход+ВалПриход; 
		ТЗ.Приход = ТЗ.Приход+Приход;
		ТЗ.ВалРасход = ТЗ.ВалРасход+ВалРасход;
		ТЗ.Расход = ТЗ.Расход+Расход;
	КонецЕсли;    
КонецПроцедуры

// ===============================
Процедура ДобавитьДокументы(ТДП, ТДР)
	ТДП.УдалитьСтроки();
	ТДР.УдалитьСтроки();

	Запр = СоздатьОбъект("Запрос");

	ТекстЗапр = "//{{ЗАПРОС(Запр)
	|Период с НачДата по КонДата;
	|ОбрабатыватьДокументы Проведенные;
	|КО = Документ.ПриходныйКассовый.ТекущийДокумент,Документ.РасходныйКассовый.ТекущийДокумент;
	|Фрм = Документ.ПриходныйКассовый.Фирма, Документ.РасходныйКассовый.Фирма;
	|Вал = Документ.ПриходныйКассовый.РСчет.Валюта, Документ.РасходныйКассовый.РСчет.Валюта;
	|Счет = Документ.ПриходныйКассовый.Счет, Документ.РасходныйКассовый.Счет;
	|Сумма = Документ.ПриходныйКассовый.СуммаВал,Документ.РасходныйКассовый.СуммаВал;	
	|Условие (Фрм=Фирма);
	|Условие (Вал=Валюта);
	|Группировка КО упорядочить по КО.ДатаДок;
	|";//}}ЗАПРОС  

	Если Запр.Выполнить(ТекстЗапр) = 0 Тогда
		Предупреждение("Не выполнился запрос по кассовым документам!");
		Возврат;
	КонецЕсли;
	Пока Запр.Группировка("КО") = 1 Цикл
		Док = Запр.КО;
		Если Касса.Выбран()=1 Тогда  
			Если Касса <> Док.РСчет Тогда
				ПРодолжить;
			КонецЕсли;    
		КонецЕсли;
		Если Док.Вид() = "ПриходныйКассовый" Тогда
			ТДП.НоваяСтрока();
			ТДП.Документ = Док;
			ТДП.Приход = Запр.Сумма;
			ТДП.КоррСчет = Запр.Счет;
		Иначе
			ТДР.НоваяСтрока();
			ТДР.Документ = Док;
			ТДР.Расход = Запр.Сумма;
			ТДР.КоррСчет = Запр.Счет;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// ===============================
Процедура Сформировать(ПечФорма = "")
	Перем ДатаЛиста;
	
	Если глПроверкаИнтервалаОтчета(НачДата,КонДата) = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	Если ПустоеЗначение(ПечФорма) = 1 Тогда
		ПечФорма = спФормы.ПолучитьЗначение(спФормы.ТекущаяСтрока());
	КонецЕсли;   
	
	глУстПропись(Гривня,"У");
	
	Если Обновить = 2 Тогда
	    СтрокаДействийФормы = "#Закрыть";
	КонецЕсли;

	Если (ТипЗначенияСтр(Т) <> "Таблица") Или (Обновить = 0) Тогда
	   	Т = СоздатьОбъект("Таблица");
	Иначе
	 	Т.Очистить();
	КонецЕсли;
	Если (ПечФорма = "ПриходКО3") или (ПечФорма = "РасходКО3") Тогда
		Т.ИсходнаяТаблица("Таблица"); 
	Иначе      
		Т.ИсходнаяТаблица("ТаблицаКО3а"); 
	КонецЕсли;    
	
	Если ПустоеЗначение(Фирма) = 1 Тогда
		Предупреждение("Не заполнен реквизит Фирма. Отчет не сформирован.");
		Возврат;
	КонецЕсли;   
	
	Дата1 = НачДата;

	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить("Отчет", "ЖурналРегистрКассовыхДок");
	Расшифровка.Установить("Фирма", Фирма);
	Расшифровка.Установить("НачДата", Дата1);
	Расшифровка.Установить("КонДата", КонДата);
	Расшифровка.Установить("Валюта", Валюта);
	Расшифровка.Установить("Касса", Касса);
	Расшифровка.Установить("Форма", ПечФорма);
	Т.ВывестиСекцию("Обновить");
	
	ТДП = СоздатьОбъект("ТаблицаЗначений");
	ТДП.НоваяКолонка("Документ","Документ");
	ТДП.НоваяКолонка("КоррСчет","Счет");
	ТДП.НоваяКолонка("Приход","Число",12,2);
	ТДР = СоздатьОбъект("ТаблицаЗначений");
	ТДР.НоваяКолонка("Документ","Документ");
	ТДР.НоваяКолонка("КоррСчет","Счет");
	ТДР.НоваяКолонка("Расход","Число",12,2);
	
	ДобавитьДокументы(ТДП,ТДР);
	// Свернем таблицу с тем чтобы исключить дубли строк,
	// затем отсортируем таблицу по дате документов
	ТДП.Свернуть("Документ,КоррСчет", "Приход");
	ТДП.Сортировать("Документ", 1);
	ТДР.Свернуть("Документ,КоррСчет", "Расход");
	ТДР.Сортировать("Документ", 1);
	
	БылиОшибки = 0;
		
	//КоличествоПриходныхДокументов = 0;
	//КоличествоРасходныхДокументов = 0;
	НомСтр = 2;
	
	Если ПечФорма = "ПриходКО3" Тогда
		Если ВывестиТитул = 1 Тогда      
			Год = ДатаГод(НачДата);
			Т.ВывестиСекцию("Титул");
			Т.НоваяСтраница();
			Т.ПовторятьПриПечатиСтроки(11,14); 
		Иначе
			Т.ПовторятьПриПечатиСтроки(1,4); 
		КонецЕсли;  
		
		Т.ВывестиСекцию("Шапка"); 
		
		ТДП.ВыбратьСтроки();
		СуммаЗП  = ""; ВсегоЗП = "";   
		ВсегоПод = 0;  
		Пока ТДП.ПолучитьСтроку() = 1 Цикл
			Док = ТДП.Документ;   
			ДатаДок = Док.ДатаДок;
			Если Док.Вид() = "ПриходныйКассовый" Тогда
				НомерДок   = Док.НомерПО;   
				Примечание = Док.Примечание;
				Если (ТДП.КоррСчет = СчетПоКоду("3721")) или (ТДП.КоррСчет = СчетПоКоду("3722")) Тогда
					СуммаПод = ТДП.Приход; 
					СуммаПр  = 0; 
				Иначе
					СуммаПр  = ТДП.Приход;
					СуммаПод = 0;
				КонецЕсли;   
			Иначе
				Если Константа.ПроводкиПоКассеТолькоОрдерами = Да Тогда
					глКомментарий("Для документа " + Док + " нет ссылки на кассовый ордер!",0,,"!");
				КонецЕсли;    
				НомерДок   = Док.НомерДок;
				Примечание = "";
				СуммаПр  = ТДП.Приход;
				СуммаПод = 0;
			КонецЕсли;   
			ВсегоПод = ВсегоПод + СуммаПод + СуммаПр;
			СуммаПодотчет = Формат(СуммаПод+СуммаПр,"Ч-15.2"); 
			
			Т.ВывестиСекцию("Строка");    
		КонецЦикла;	  
		ВсегоПодотчет = Формат(ВсегоПод,"Ч-15.2");
		Т.ВывестиСекцию("Итоги");    
		
	ИначеЕсли ПечФорма = "РасходКО3" Тогда
		Если ВывестиТитул = 1 Тогда      
			Год = ДатаГод(НачДата);
			Т.ВывестиСекцию("Титул");
			Т.НоваяСтраница();
			Т.ПовторятьПриПечатиСтроки(11,14); 
		Иначе
			Т.ПовторятьПриПечатиСтроки(1,4); 
		КонецЕсли;  
		
		Т.ВывестиСекцию("Шапка"); 
		
		ТДР.ВыбратьСтроки();
		ВсегоЗрП = 0; ВсегоПод = 0; ВсегоПр = 0;
		Пока ТДР.ПолучитьСтроку() = 1 Цикл
			Док = ТДР.Документ;   
			ДатаДок = Док.ДатаДок;
			Если Док.Вид() = "РасходныйКассовый" Тогда
				НомерДок = Док.НомерРО;   
				Примечание = Док.Примечание;
				Если (ТДР.КоррСчет = СчетПоКоду("661")) или (ТДР.КоррСчет = СчетПоКоду("663")) Тогда
					СуммаЗрП = ТДР.Расход; 
					СуммаПр  = 0; 
					СуммаПод = 0;
				ИначеЕсли (ТДР.КоррСчет = СчетПоКоду("3721")) или (ТДР.КоррСчет = СчетПоКоду("3722")) Тогда
					СуммаПод = ТДР.Расход;
					СуммаПр  = 0;
					СуммаЗрП = 0; 
				Иначе	
					СуммаПр  = ТДР.Расход;
					СуммаПод = 0;
					СуммаЗрП = 0; 
				КонецЕсли;   
			Иначе
				Если Константа.ПроводкиПоКассеТолькоОрдерами = Да Тогда
					глКомментарий("Для документа " + Док + " нет ссылки на кассовый ордер!",0,,"!");
				КонецЕсли;    
				НомерДок = Док.НомерДок; 
				Примечание = "";
				Если (Док.Вид() = "НачислениеЗП") или (Док.Вид() = "ВыплатаЗП") Тогда   
					СуммаЗрП = ТДР.Расход; 
					СуммаПр  = 0; 
					СуммаПод = 0;
				Иначе
					СуммаПр  = ТДР.Расход;
					СуммаПод = 0;
					СуммаЗрП = 0; 
				КонецЕсли;
			КонецЕсли;   
			ВсегоПод = ВсегоПод + СуммаПод + СуммаПр;
			ВсегоЗрП   = ВсегоЗрП   + СуммаЗрП;  
			СуммаПодотчет = Формат(СуммаПод+СуммаПр,"Ч-15.2"); 
			СуммаЗП = Формат(СуммаЗрП,"Ч-15.2"); 
			
			Т.ВывестиСекцию("Строка");    
			НомСтр = НомСтр+1;
		КонецЦикла;	  
		ВсегоПодотчет = Формат(ВсегоПод,"Ч-15.2");
		ВсегоЗП   = Формат(ВсегоЗрП,"Ч-15.2");  
		Т.ВывестиСекцию("Итоги");  
	Иначе
		Если ВывестиТитул = 1 Тогда      
			Год = ДатаГод(НачДата);
			Т.ВывестиСекцию("Титул");
			Т.НоваяСтраница();
			Т.ПовторятьПриПечатиСтроки(11,14); 
		Иначе
			Т.ПовторятьПриПечатиСтроки(1,4); 
		КонецЕсли;  
		НомСтр = 1;
		
		Т.ВывестиСекцию("Шапка"); 
		
		ТДП.ВыбратьСтроки();
		ТДР.ВыбратьСтроки();
		СуммаПрих = 0; СуммаРасх = 0;   
		флПродолжить = 1; флПриход = 1; флРасход = 1;
		Пока флПродолжить = 1 Цикл
			Если ТДП.ПолучитьСтроку() = 1 Тогда
				ДокП = ТДП.Документ;   
				ДатаДокП = ДокП.ДатаДок;
				Если ДокП.Вид() = "ПриходныйКассовый" Тогда
					НомерДокП = ДокП.НомерПО;   
					ПримечаниеП = ДокП.Примечание;
					СуммаПрих = ТДП.Приход; 
				Иначе
					Если Константа.ПроводкиПоКассеТолькоОрдерами = Да Тогда
						глКомментарий("Для документа " + ДокП + " нет ссылки на кассовый ордер!",0,,"!");
					КонецЕсли;    
					НомерДокП = ДокП.НомерДок; 
					ПримечаниеП = "";
					СуммаПрих = ТДП.Приход; 
				КонецЕсли;  
				СуммаП = Формат(СуммаПрих,"Ч-15.2"); 
			Иначе       
				ДокП = "";   
				ДатаДокП = "";
				НомерДокП = "";   
				ПримечаниеП = "";
				СуммаП = ""; 
				флПриход = 0;
			КонецЕсли;
			
			Если ТДР.ПолучитьСтроку() = 1 Тогда
				ДокР = ТДР.Документ;   
				ДатаДокР = ДокР.ДатаДок;
				Если ДокР.Вид() = "РасходныйКассовый" Тогда
					НомерДокР = ДокР.НомерРО;   
					ПримечаниеР = ДокР.Примечание;
					СуммаРасх = ТДР.Расход; 
				Иначе
					Если Константа.ПроводкиПоКассеТолькоОрдерами = Да Тогда
						глКомментарий("Для документа " + ДокР + " нет ссылки на кассовый ордер!",0,,"!");
					КонецЕсли;    
					НомерДокР = ДокР.НомерДок;
					ПримечаниеР = "";
					Если (ДокР.Вид() = "НачислениеЗП") или (ДокР.Вид() = "ВыплатаЗП") Тогда   
						ПримечаниеР = "Виплата заробітної плати";
					КонецЕсли;    
					СуммаРасх = ТДР.Расход; 
				КонецЕсли;   
				СуммаР = Формат(СуммаРасх,"Ч-15.2"); 
			Иначе
				ДокР = "";   
				ДатаДокР = "";
				НомерДокР = "";   
				ПримечаниеР = "";
				СуммаР = "";  
				флрасход = 0;
			КонецЕсли;
						
			Если (флПриход = 0) и (флРасход = 0) Тогда
				 флПродолжить = 0;      
			Иначе	 
				Т.ВывестиСекцию("Строка");   
				НомСтр = НомСтр+1;
			КонецЕсли;
		КонецЦикла;	  
		
	КонецЕсли;   

	Т.ТолькоПросмотр(1);
	Т.Опции(0, 0, 1, 0);
	Т.ОбластьПечати(2);
	Если НачДата = КонДата Тогда
		Т.Показать("Касса ("+Формат(НачДата,"ДДММГГГГ")+") ("+Фирма+")", "","");
	Иначе
		Т.Показать("Касса ("+Формат(НачДата,"ДДММГГГГ")+"-"+Формат(КонДата,"ДДММГГГГ")+") ("+Фирма+")", "","");
	КонецЕсли;
КонецПроцедуры

              
// ===============================
Процедура ПриОткрытии()
	Фирма = глВосстановитьЗначение(,"БазФирма");
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);     

	спФормы.ДобавитьЗначение("ПриходКО3", "Журнал приходных ордеров КО-3");
	спФормы.ДобавитьЗначение("РасходКО3", "Журнал расходных ордеров КО-3");
	спФормы.ДобавитьЗначение("КО3А", "Журнал приходных/расходных ордеров КО-3А");
		
	Если глФлагРасшифровки = 1 Тогда
		Обновить = глОбновить;
		РУ = глРасшифровка.Получить("Фирма");
		Если ПустоеЗначение(РУ) = 0 Тогда
			Фирма = РУ;
		КонецЕсли;
		Если Обновить <> 0 Тогда
			НачДата = глРасшифровка.Получить("НачДата");
			КонДата = глРасшифровка.Получить("КонДата");
			Валюта = глРасшифровка.Получить("Валюта");
			Касса = глРасшифровка.Получить("Касса");
		   	ПечФорма = глРасшифровка.Получить("Форма");
			Инд = спФормы.НайтиЗначение(ПечФорма);
		   	Если Инд <> 0 Тогда
		   	    спФормы.ТекущаяСтрока(Инд);
		   	КонецЕсли;
			Т = глТаблица;
		КонецЕсли;
		Если Обновить <> 2 Тогда
			Сформировать(ПечФорма);
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
	Иначе
		Обновить = 0;
		НачДата = РабочаяДата();
		КонДата = РабочаяДата();
		Валюта = Гривня;
		Касса = глПолучитьКассу(Фирма,Валюта);
		ПечФорма = глВосстановитьЗначение("Отчет.ЖурналРегистрКассовыхДок.Форма","ПечФорма","ПриходКО3");
		Инд = спФормы.НайтиЗначение(ПечФорма);
	   	Если Инд <> 0 Тогда
	   	    спФормы.ТекущаяСтрока(Инд);
	   	КонецЕсли;
	КонецЕсли;
	Форма.Фирма.ВыполнятьФормулуТолькоПриИзменении(1);
	Форма.Касса.ВыполнятьФормулуТолькоПриИзменении(1);
	Форма.Касса.ВыборГруппы(0);       
	
КонецПроцедуры

// ======================================
Процедура ИзмКасса()
	Если ПустоеЗначение(Касса) = 1 Тогда
		Возврат;
	КонецЕсли;
	Если Касса.Владелец <> Фирма Тогда
		глКомментарий("Выбранная касса принадлежит другой фирме",0,,"!");
		Касса = 0;
		Возврат;
	КонецЕсли;
	Если Касса.Валюта <> Гривня Тогда
	    Предупреждение("Отчет предназначен только для кассовых операций в национальной валюте!");
		Касса = глПолучитьКассу(Фирма,Гривня);
	КонецЕсли; 
	Валюта = Касса.Валюта;
КонецПроцедуры

// ======================================
Процедура ИзмФирма()
	Если ПустоеЗначение(Фирма) = 1 Тогда
		Возврат;
	КонецЕсли;
	Если ПустоеЗначение(Валюта) = 0 Тогда
		Касса = глПолучитьКассу(Фирма,Валюта);
		ИзмКасса();
	КонецЕсли;
КонецПроцедуры 

//============================
Процедура ПриЗакрытии()
	Зрп = 0;
	глФлагРасшифровки = 0;
	глСохранитьЗначение("Отчет.ЖурналРегистрКассовыхДок.Форма","ПечФорма",спФормы.ПолучитьЗначение(спФормы.ТекущаяСтрока()));
КонецПроцедуры     


