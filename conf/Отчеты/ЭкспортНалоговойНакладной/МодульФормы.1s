Перем ДатаОтчета, Фирма, стрДокумент;
Перем ИмяДок, НомерДокумента, ВидДокумента;
Перем ПечататьДатыСРазделителями, НеДополнятьНазваниеНомеромГТД; 
Перем ЛьготаКод, Сводная,ТипПричиныИнд;
Перем мМенеджерЗвит1С;

Процедура Экспортировать() Далее

//===========================================   
Процедура ИзмОбычная()  
	Если рОбычная = 2 Тогда
		Если ДатаОтчета >= '10.01.2011' Тогда
			ИмяДок = "Налоговая накладная № " + Строка(стрДокумент.НомерДок)+ " от " + Строка(ДатаОтчета) + " (тип причины невыдачи = 01)";
		Иначе
	 		ИмяДок = "Налоговая накладная № " + Строка(стрДокумент.НомерДок)+ "/ЗЦ от " + Строка(ДатаОтчета);
		КонецЕсли;
 	Иначе
		ИмяДок = "Налоговая накладная № " + Строка(стрДокумент.НомерДок)+ " от " + Строка(ДатаОтчета);
	КонецЕсли;
КонецПроцедуры

// ===============================                                     
// Заполняет необходимые значения параметров для XML отчета
// по строке
Процедура ЗаполнитьРеквизитыСтроки(спДанные, Ст[], НомСтр, НомНачКол, ФорматНомСтр = "Ч(0)4")
	
	
	Для Н=НомНачКол По 14 Цикл
		
		Если Н = 1 Тогда
			Окончание = "D";  
			Н1 = 2;
		ИначеЕсли (Н =2) или (Н = 3) или (Н = 5) Тогда
			Окончание = "S";    
			Н1 = Н + 1;
			Если Н = 5 Тогда
				Н1 = 5;
			КонецЕсли;
		ИначеЕсли (Н =13) Тогда
			Окончание = "";    
			Н1 = 4;
		ИначеЕсли (Н =12) Тогда
			Окончание = "";    
			Н1 = 109;
		ИначеЕсли (Н =14) Тогда // номер колонки для кода единиц
			Окончание = "S";    
			Н1 = "105_2";
		Иначе
			Окончание = ""; 
			Если Н = 4 Тогда
				Н1 = 5
			Иначе
				Н1 = Н;
			КонецЕсли;
		КонецЕсли;
		
		Значение = Ст[Н];
		
		спДанные.ДобавитьЗначение(Значение,  "R" + Формат(НомСтр, ФорматНомСтр) + "G" + Н1 + Окончание);

	КонецЦикла;
	
КонецПроцедуры
//=========================================== 
//c 2016
Процедура ЗаполнениеСтрокТЧ(НомСтр,спДанные,НаимТМЦ,КодУКТВЭД,ЕдИзм,КодЕдИзм,Кво,ЦенаБезНДС,
							Ставка,Льгота="",СуммаБезНДС,ПрИмп,буфКодДКПП,КодСХ,ФорматНомСтр = "Ч(0)4")

 	СтрНомерПоз=Формат(НомСтр,ФорматНомСтр);
	спДанные.ДобавитьЗначение(НаимТМЦ,    "R" + СтрНомерПоз + "G3S");
	спДанные.ДобавитьЗначение(КодУКТВЭД,  "R" + СтрНомерПоз + "G4");
	спДанные.ДобавитьЗначение(ЕдИзм,      "R" + СтрНомерПоз + "G4S");
	спДанные.ДобавитьЗначение(КодЕдИзм,   "R" + СтрНомерПоз + "G105_2S");
	спДанные.ДобавитьЗначение(Кво,        "R" + СтрНомерПоз + "G5");
	спДанные.ДобавитьЗначение(ЦенаБезНДС, "R" + СтрНомерПоз + "G6");
	спДанные.ДобавитьЗначение(Ставка,     "R" + СтрНомерПоз + "G008");
	спДанные.ДобавитьЗначение(Льгота,     "R" + СтрНомерПоз + "G009");
	спДанные.ДобавитьЗначение(СуммаБезНДС,"R" + СтрНомерПоз + "G010");
	Если ДатаОтчета >= '01/03/2017' Тогда
		спДанные.ДобавитьЗначение(ПрИмп,	 "R" + СтрНомерПоз + "G32");
		спДанные.ДобавитьЗначение(буфКодДКПП,"R" + СтрНомерПоз + "G33");
		спДанные.ДобавитьЗначение(КодСХ,	 "R" + СтрНомерПоз + "G011");
	КонецЕсли;
КонецПроцедуры  
// ===============================                                     
// Заполняет необходимые значения параметров для XML отчета
// по строке  (Приложение 2)
Процедура ЗаполнитьСтрокуПриложения(спДанные, Ст[], НомСтр, НомНачКол = 1, НомКонКол = 15, ФорматНомСтр = "Ч(0)4")
	
	
	Для Н=НомНачКол По НомКонКол Цикл
		
		Н1 = Н;
		Если Н = 1 Тогда
			Окончание = "D";  
		ИначеЕсли Н < 5 Тогда
			Окончание = "S";    
		ИначеЕсли (Н =13) Тогда
			Окончание = "";    
			Н1 = 4;
		ИначеЕсли (Н =12) Тогда
			Окончание = "";    
			Н1 = 111;
		ИначеЕсли (Н =14) Тогда // номер колонки для кода единиц
			Окончание = "S";    
			Н1 = "105_2";
		Иначе
			Окончание = ""; 
		КонецЕсли;
		
		Значение = Ст[Н];
		
		спДанные.ДобавитьЗначение(Значение,  "R" + Формат(НомСтр, ФорматНомСтр) + "G" + Н1 + Окончание);
	
	КонецЦикла;
	
КонецПроцедуры
//=========================================== 
//c 2016
Процедура ЗаполнениеСтрокТЧПрил(НомСтр,спДанные,НомСтрНН,Причина,НаимТМЦ,КодУКТВЭД,ЕдИзм,КодЕдИзм,
							ИзмКво,ЦенаБезНДС,ИзмЦены,Кво,Ставка,Льгота="",
							СуммаБезНДС,ПрИмп,КодДЛПП,КодСХ,ФорматНомСтр = "Ч(0)4")

 	СтрНомерПоз=Формат(НомСтр,ФорматНомСтр);
	спДанные.ДобавитьЗначение(НомСтрНН,   "R" + СтрНомерПоз + "G001");
	спДанные.ДобавитьЗначение(Причина,    "R" + СтрНомерПоз + "G2S");
	спДанные.ДобавитьЗначение(НаимТМЦ,    "R" + СтрНомерПоз + "G3S");
	спДанные.ДобавитьЗначение(КодУКТВЭД,  "R" + СтрНомерПоз + "G4");
	спДанные.ДобавитьЗначение(ЕдИзм,      "R" + СтрНомерПоз + "G4S");
	спДанные.ДобавитьЗначение(КодЕдИзм,   "R" + СтрНомерПоз + "G105_2S");
	спДанные.ДобавитьЗначение(ИзмКво, 	  "R" + СтрНомерПоз + "G5");
	спДанные.ДобавитьЗначение(ЦенаБезНДС, "R" + СтрНомерПоз + "G6");
	спДанные.ДобавитьЗначение(ИзмЦены,    "R" + СтрНомерПоз + "G7");
	спДанные.ДобавитьЗначение(Кво,        "R" + СтрНомерПоз + "G8");
	спДанные.ДобавитьЗначение(Ставка,     "R" + СтрНомерПоз + "G008");
	спДанные.ДобавитьЗначение(Льгота,     "R" + СтрНомерПоз + "G009");
	спДанные.ДобавитьЗначение(СуммаБезНДС,"R" + СтрНомерПоз + "G010");
	Если ДатаОтчета >= '01/03/2017' Тогда
		спДанные.ДобавитьЗначение(ПрИмп,  "R" + СтрНомерПоз + "G32");  
		спДанные.ДобавитьЗначение(КодДЛПП,"R" + СтрНомерПоз + "G33");  
		спДанные.ДобавитьЗначение(КодСХ,  "R" + СтрНомерПоз + "G011"); 
	КонецЕсли
КонецПроцедуры  
// ===============================                                     
Процедура ЗаполнитьРеквизиты()
	
	Фирма.ИспользоватьДату(ДатаОтчета);
	НалоговаяИнспекция = Фирма.НалоговаяИнспекция;	
	Если ПустоеЗначение(НалоговаяИнспекция) = 0 Тогда
		C_RAJ = СокрЛП(НалоговаяИнспекция.КодАдмРайона);  //Код административного района инспекции
		C_REG = СокрЛП(НалоговаяИнспекция.Родитель.Код);  //Код области инспекции 
		C_STI = СокрЛП(НалоговаяИнспекция.Код);  //Код  инспекции      
	Иначе
		Сообщить("Для фирмы " + Фирма.ПолнНаименование +" не заполнен реквизит Налоговая инспекция!", "!");     
	КонецЕсли;
	Если ПустоеЗначение(Фирма.ЕДРПОУ) = 0 Тогда
		TIN = Фирма.ЕДРПОУ;    
	Иначе
		Сообщить("Для фирмы " + Фирма.ПолнНаименование +" не заполнен код ЕДРПОУ!", "!");     
	КонецЕсли;

	ГодОтчета = ДатаГод(ДатаОтчета);
	PERIOD_YEAR = ГодОтчета;// Год отчета  

	МесяцОтчета = ДатаМесяц(ДатаОтчета);
	PERIOD_TYPE =1;           // Месяц
	PERIOD_MONTH = МесяцОтчета;// Месяц отчета

	C_DOC_TYPE = 0;//номер исправленного документа.
	               //Для первого подающегося документа  = 0   
	C_DOC_CNT = НомерДокумента;   //номер документа в периоде/номер налоговой накладной.
	C_DOC_STAN = 1;  //состояние документа, 1 - отчетный документ
    D_FILL = РабочаяДата();
	
КонецПроцедуры     
// ===============================                                     
// Заполняет необходимые значения параметров для XML отчета
// по шапке
Процедура ВыгрузитьРеквизиты2016(спДанные)
	
	спОшибкиВыгрузки = СоздатьОбъект("СписокЗначений");      
	
	// Данные реквизиты важны только при выгрузке в XML
	Если ПустоеЗначение(мМенеджерЗвит1С) = 1 Тогда
		Если ПустоеЗначение(C_RAJ) = 0 Тогда
			спДанные.ДобавитьЗначение(C_RAJ, "C_RAJ");  //Код административного района инспекции
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код административного района налоговой инспекции");
		КонецЕсли;
		Если ПустоеЗначение(C_REG) = 0 Тогда
			спДанные.ДобавитьЗначение(C_REG, "C_REG");  //Код области инспекции 
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код области налоговой инспекции");
		КонецЕсли;
		Если ПустоеЗначение(C_STI) = 0 Тогда
			спДанные.ДобавитьЗначение(C_STI, "C_STI");  //Код  инспекции 
			спДанные.ДобавитьЗначение(C_STI, "C_STI_ORIG");  //Код  инспекции 
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код налоговой инспекции");
		КонецЕсли;
	КонецЕсли;
	спДанные.ДобавитьЗначение(PERIOD_YEAR, "PERIOD_YEAR");// Год отчета
	спДанные.ДобавитьЗначение(PERIOD_MONTH, "PERIOD_MONTH");// Месяц отчета
	спДанные.ДобавитьЗначение(PERIOD_TYPE, "PERIOD_TYPE"); // Месяц

	спДанные.ДобавитьЗначение(C_DOC_TYPE, "C_DOC_TYPE");//номер исправленного документа.
	                                           			//Для первого подающегося документа  = 0   
	спДанные.ДобавитьЗначение(C_DOC_CNT, "C_DOC_CNT"); //номер документа в периоде.
	спДанные.ДобавитьЗначение(C_DOC_STAN, "C_DOC_STAN");//состояние документа, 1 - отчетный документ   
	спДанные.ДобавитьЗначение(D_FILL, "D_FILL");  //дата формирования
	спДанные.ДобавитьЗначение(TIN, "TIN");
	
	спДанные.ДобавитьЗначение(ДатаОтчета, "HFILL");  //дата документа

	Контрагент = стрДокумент.Контрагент;
	ФирмаПолнНаименование = Фирма.ПолнНаименование;
	ФирмаНалогНомер = СокрЛП(Фирма.ИНН);
	
	КонтрагентПолнНаименование = Контрагент.ПолнНаименование;        
	КонтрагентНалогНомер = СокрЛП(Контрагент.ИНН);
	КонтрагентКодФил = СокрЛП(Контрагент.КодФилиала);
	КонтрагентЕДРПОУ = СокрЛП(Контрагент.ЕДРПОУ);
	
	HNUM = Прав("      "+НомерДокумента,7); 
	Если ПустоеЗначение(HNUM) = 0 Тогда
		спДанные.ДобавитьЗначение(HNUM, "HNUM");  //номер документа
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Номер налоговой накладной ");
	КонецЕсли;
	
	Если ВидДокумента = "НалоговаяНакладная" Тогда
        Оставляем = стрДокумент.Оставляем;
		ТипПричиныИнд = ?(Оставляем = 1,Число(Сред(стрДокумент.ТипПричины,2,2)),0);
		ВидОпер = стрДокумент.ВидОперации;
		КорГрафы5 = стрДокумент.КорГрафы5;
		Графа5 = стрДокумент.Графа5;
	Иначе   //Приложение2  
        Оставляем = стрДокумент.НалоговаяНакладная.Оставляем;
		ТипПричиныИнд = ?(Оставляем = 1,Число(Сред(стрДокумент.НалоговаяНакладная.ТипПричины,2,2)),0);
		ВидОпер = стрДокумент.НалоговаяНакладная.ВидОперации;
		КорГрафы5 = стрДокумент.НалоговаяНакладная.КорГрафы5;
		Графа5 = стрДокумент.НалоговаяНакладная.Графа5;
	КонецЕсли;
		
	Сводная = 0;  
	Если (ВидОпер = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
		//тип причины: 14
		ФирмаПолнНаименование = СокрЛП(?(КорГрафы5 = 1,Графа5,Контрагент.ПолнНаименование))+ ", " + СокрЛП(Контрагент.Регион);        
		ФирмаНалогНомер = "500000000000";
		КонтрагентПолнНаименование = Фирма.ПолнНаименование;
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 12) Тогда
		//Дипломатическое представительство, тип причины 12 
		КонтрагентНалогНомер = "200000000000";
		
	ИначеЕсли (ТипПричиныИнд = 2) или (ТипПричиныИнд = 11) или (ТипПричиныИнд = 1) Тогда
		//тип причины: 02, 11
		КонтрагентПолнНаименование = "Неплатник";
		КонтрагентНалогНомер = "100000000000";
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 7) Тогда
		//тип причины: 07, Экспорт
		КонтрагентПолнНаименование = СокрЛП(КонтрагентПолнНаименование) + ", " + СокрЛП(Контрагент.Регион);
		КонтрагентНалогНомер = "300000000000";
		
	ИначеЕсли (ТипПричиныИнд = 10) Тогда
		//тип причины: 10
		КонтрагентНалогНомер = ?(ДатаОтчета >= '01/03/2017',"600000000000","400000000000");
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 15) Тогда
		//тип причины: 15
		КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд = 4) или (ТипПричиныИнд = 8) или (ТипПричиныИнд = 9) или (ТипПричиныИнд = 13) Тогда
		//тип причины: 04, 08, 09, 13  Зведена
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентНалогНомер = "600000000000";
		Сводная = 1;  
		КонтрагентКодФил = "";
		
	ИначеЕсли (ТипПричиныИнд > 2) Тогда
		//тип причины: 03, 05, 06
		КонтрагентНалогНомер = "400000000000";
		КонтрагентПолнНаименование = ФирмаПолнНаименование;
		КонтрагентКодФил = "";
		
	Иначе
		КонтрагентКодФил = ?(ПустоеЗначение(Контрагент.ИНН)=1, "", КонтрагентКодФил);
		КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, "100000000000",  Прав("           " + СокрЛП(Контрагент.ИНН),12));
	КонецЕсли;
			
	//данные по фирме
	Если ПустоеЗначение(ФирмаПолнНаименование) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(ФирмаПолнНаименование), "HNAMESEL"); //Полное наименование продавца
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Полное наименование фирмы для налоговых документов ");
	КонецЕсли;
	Если ПустоеЗначение(ФирмаНалогНомер) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(ФирмаНалогНомер),	"HKSEL");  //Индивидуальный налоговый номер
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Индивидуальный налоговый номер для фирмы");
	КонецЕсли;
	//данные контрагента
	Если ПустоеЗначение(КонтрагентПолнНаименование) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(КонтрагентПолнНаименование), "HNAMEBUY"); //Полное наименование продавца
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Полное наименование контрагента для налоговых документов ");
	КонецЕсли;
	Если ПустоеЗначение(КонтрагентНалогНомер) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(КонтрагентНалогНомер),	"HKBUY");  //Индивидуальный налоговый номер
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Индивидуальный налоговый номер для контрагента");
	КонецЕсли;
	Если (КонтрагентКодФил <> "0") и (ПустоеЗначение(КонтрагентКодФил)=0) Тогда
		спДанные.ДобавитьЗначение(СокрЛП(КонтрагентКодФил), "HFBUY");//код филиала контрагента
	КонецЕсли;
	спДанные.ДобавитьЗначение(СокрЛП(КонтрагентЕДРПОУ), "EDR_POK");//ЕДРПОУ контрагента 
	
	//HORIG1 - ОстаетсяУПродавца = Оставляем
	Если (ПустоеЗначение(Оставляем) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0) Тогда
		спДанные.ДобавитьЗначение(СокрЛП(Оставляем), "HORIG1");
	КонецЕсли;                                         
	//HTYPR
	Если (Оставляем = 1) и ((ПустоеЗначение(ТипПричиныИнд) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)) Тогда
		спДанные.ДобавитьЗначение(Формат(ТипПричиныИнд,"Ч(0)2"), "HTYPR"); 
	КонецЕсли;                                         
	
	Если ПустоеЗначение(СтрДокумент.Выписал) = 0 Тогда
		ПечВыписал = Сред(СтрДокумент.Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(СтрДокумент.Выписал.Отчество) = 1,"",Сред(СтрДокумент.Выписал.Отчество,1,1))
		+ "." + " " + Сокрлп(СтрДокумент.Выписал.Фамилия);
		спДанные.ДобавитьЗначение(ПечВыписал, "HBOS");  
	  	СотрИНН = СтрДокумент.Выписал.ИНН; 
		Если ПустоеЗначение(СотрИНН) = 0 Тогда
			спДанные.ДобавитьЗначение(СотрИНН, "HKBOS");  
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код ИНН ответственного");
		КонецЕсли;
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Кто выписал накладную");
	КонецЕсли;

	Если ВидДокумента = "НалоговаяНакладная" Тогда
			
		СпецРежимНалогообложения = стрДокумент.СпецРежимНалогообложения;
		СпецРежимНалогообложения = ?(стрДокумент.СоглашениеОРазделеПродукции = 1,5,СпецРежимНалогообложения);

		Итоговая = стрДокумент.Итоговая; 

		
	Иначе //Приложение 2
			
		Если стрДокумент.РегистрируетсяВЕРННПокупателем = 1 Тогда
			спДанные.ДобавитьЗначение(0, "HERPN0");     //РегистрируетсяВЕРННПродавцом  
			спДанные.ДобавитьЗначение(1, "HERPN");     //РегистрируетсяВЕРННПокупателем  
		Иначе	
			спДанные.ДобавитьЗначение(1, "HERPN0");     //РегистрируетсяВЕРННПродавцом  
			спДанные.ДобавитьЗначение(0, "HERPN");     //РегистрируетсяВЕРННПокупателем  
		КонецЕсли;
		
		НомерНН = глНомерБезПрефикса(стрДокумент.НалоговаяНакладная.НомерДок);
		ДатаНН  = стрДокумент.НалоговаяНакладная.ДатаДок;
		
		спДанные.ДобавитьЗначение(ДатаНН, "HPODFILL"); //дата налоговой накладной
		спДанные.ДобавитьЗначение(НомерНН,"HPODNUM" ); //номер налоговой накладной 

		СпецРежимНалогообложения = стрДокумент.НалоговаяНакладная.СпецРежимНалогообложения;
		СпецРежимНалогообложения = ?(стрДокумент.НалоговаяНакладная.СоглашениеОРазделеПродукции = 1,5,СпецРежимНалогообложения);
		спДанные.ДобавитьЗначение(СпецРежимНалогообложения,"HPODNUM1" ); //Спец режим налогообложения 
		спДанные.ДобавитьЗначение("", "HPODNUM2");				
			
		Итоговая = стрДокумент.НалоговаяНакладная.Итоговая;  
	КонецЕсли;

	спДанные.ДобавитьЗначение(СпецРежимНалогообложения, "HNUM1");
	спДанные.ДобавитьЗначение("", "HNUM2");				

	//H03 - Сводная
	Если Итоговая = 1 Тогда	
		спДанные.ДобавитьЗначение(Итоговая, "H03");
	Иначе
		спДанные.ДобавитьЗначение(Сводная, "H03");
	КонецЕсли;

	//R03G10S - Без НДС
	ПечОсвоб = ?(Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС", "Без ПДВ","");
	Если (ПустоеЗначение(ПечОсвоб) = 0) Тогда
		спДанные.ДобавитьЗначение(СокрЛП(ПечОсвоб), "R03G10S");
	КонецЕсли;                                         

	Если ПустоеЗначение(спОшибкиВыгрузки) = 0 Тогда      
		Сообщить("Не заполнены следующие реквизиты:", "!");     
		
		Для Нсч=1 По спОшибкиВыгрузки.РазмерСписка() Цикл
			Сообщить(спОшибкиВыгрузки.ПолучитьЗначение(Нсч) + ";", "!");     
		КонецЦикла;
		Сообщить("Выгрузка невозможна!", "!");     
		спДанные = "";
	КонецЕсли;

КонецПроцедуры

//============================
// Заполняет необходимые значения параметров для XML отчета
// по шапке
Процедура ВыгрузитьРеквизиты(спДанные)
	
	спОшибкиВыгрузки = СоздатьОбъект("СписокЗначений");      
	// Данные реквизиты важны только при выгрузке в XML
	Если ПустоеЗначение(мМенеджерЗвит1С) = 1 Тогда
		Если ПустоеЗначение(C_RAJ) = 0 Тогда
			спДанные.ДобавитьЗначение(C_RAJ, "C_RAJ");  //Код административного района инспекции
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код административного района налоговой инспекции");
		КонецЕсли;
		Если ПустоеЗначение(C_REG) = 0 Тогда
			спДанные.ДобавитьЗначение(C_REG, "C_REG");  //Код области инспекции 
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код области налоговой инспекции");
		КонецЕсли;
		Если ПустоеЗначение(C_STI) = 0 Тогда
			спДанные.ДобавитьЗначение(C_STI, "C_STI");  //Код  инспекции 
			
			Если ДатаОтчета >= '10.01.2011'  Тогда
				спДанные.ДобавитьЗначение(C_STI, "C_STI_ORIG");  //Код  инспекции 
			КонецЕсли;	
			
		Иначе
			спОшибкиВыгрузки.ДобавитьЗначение("Код налоговой инспекции");
		КонецЕсли;
	КонецЕсли;
	спДанные.ДобавитьЗначение(PERIOD_YEAR, "PERIOD_YEAR");// Год отчета
	спДанные.ДобавитьЗначение(PERIOD_MONTH, "PERIOD_MONTH");// Месяц отчета
	спДанные.ДобавитьЗначение(PERIOD_TYPE, "PERIOD_TYPE"); // Месяц

	спДанные.ДобавитьЗначение(C_DOC_TYPE, "C_DOC_TYPE");//номер исправленного документа.
	                                           //Для первого подающегося документа  = 0   
	спДанные.ДобавитьЗначение(C_DOC_CNT, "C_DOC_CNT"); //номер документа в периоде.
	спДанные.ДобавитьЗначение(C_DOC_STAN, "C_DOC_STAN");//состояние документа, 1 - отчетный документ   
	спДанные.ДобавитьЗначение(D_FILL, "D_FILL");  //дата формирования
	спДанные.ДобавитьЗначение(TIN, "TIN");
	
	Если (ДатаОтчета < '01.01.2015') Тогда
		Если ДатаОтчета >= '01.03.2014'  Тогда  
			Если стрДокумент.ЭлектронныйДокумент = 1 Тогда
				спДанные.ДобавитьЗначение(1, "HEL");     //Электронный документ  
				спДанные.ДобавитьЗначение(0, "HORIG");     //копия/оригинал, 1 - оригинал  
			Иначе	
				спДанные.ДобавитьЗначение(1, "HORIG");     //копия/оригинал, 1 - оригинал  
				спДанные.ДобавитьЗначение(0, "HEL");     //Электронный документ  
			КонецЕсли;
			Если ДатаОтчета >= '01.12.2014'  Тогда  
				спДанные.ДобавитьЗначение(0, "HCOPY");     //копия  
			КонецЕсли;
		ИначеЕсли ДатаОтчета >= '10.01.2011'  Тогда
			спДанные.ДобавитьЗначение(1, "HORIG");     //копия/оригинал, 1 - оригинал  
		Иначе
			спДанные.ДобавитьЗначение(1, "HCOPY");     //копия/оригинал, 1 - оригинал  
		КонецЕсли;	
	КонецЕсли;	
	спДанные.ДобавитьЗначение(ДатаОтчета, "HFILL");  //дата документа

	
	Контрагент = стрДокумент.Контрагент;
	ФирмаПолнНаименование = Фирма.ПолнНаименование;
	ФирмаАдрес = глАдресСтрокой(Фирма.ЮридическийАдрес,,1);
	ФирмаТел = Фирма.Телефоны;
	Если Найти(ФирмаТел,",") <> 0 Тогда
		ФирмаТел = Лев(ФирмаТел,Найти(ФирмаТел,",")-1);
	ИначеЕсли Найти(ФирмаТел,";") <> 0 Тогда	
		ФирмаТел = Лев(ФирмаТел,Найти(ФирмаТел,";")-1);  
	КонецЕсли;
	ФирмаТел = СтрЗаменить(ФирмаТел,"-","");
	ФирмаТел = СтрЗаменить(ФирмаТел," ","");
	ФирмаТел = СтрЗаменить(ФирмаТел,")","");
	ФирмаТел = СтрЗаменить(ФирмаТел,"(","");
	ФирмаТелефоны = СокрЛП(ФирмаТел);
	
	ФирмаНалогНомер = Фирма.ИНН;
	ФирмаНомСвид = Фирма.НомерСвидетельства; 
	
	КонтрагентПолнНаименование = Контрагент.ПолнНаименование;        
	Если  Контрагент.ВидКонтрагента =  Перечисление.ВидыКонтрагентов.ЧастноеЛицо Тогда
		КонтрагентАдрес = глАдресСтрокой(Контрагент.ФизическийАдрес,,1);
	Иначе
		КонтрагентАдрес = глАдресСтрокой(Контрагент.ЮридическийАдрес,,1);
	КонецЕсли;
	Если Найти(Контрагент.Телефоны,",") <> 0 Тогда
		КонтрТел = Лев(Контрагент.Телефоны,Найти(Контрагент.Телефоны,",")-1);
	ИначеЕсли Найти(Контрагент.Телефоны,";") <> 0 Тогда	
		КонтрТел = Лев(Контрагент.Телефоны,Найти(Контрагент.Телефоны,";")-1);  
	Иначе	
		КонтрТел = Контрагент.Телефоны;  
	КонецЕсли;
	КонтрТел = СтрЗаменить(КонтрТел,"-","");
	КонтрТел = СтрЗаменить(КонтрТел," ","");
	КонтрТел = СтрЗаменить(КонтрТел,")","");
	КонтрТел = СтрЗаменить(КонтрТел,"(","");
	КонтрагентТелефоны = СокрЛП(КонтрТел);
	КонтрагентНалогНомер = Контрагент.ИНН;
	КонтрагентНомСвид = Контрагент.НомерСвидетельства;
	КонтрагентЕДРПОУ = СокрЛП(Контрагент.ЕДРПОУ);
	КонтрагентКодФил = СокрЛП(Контрагент.КодФилиала);

	ПустойИНН = ?(ДатаОтчета >= '01/03/2014',"400000000000","0");
	Если ВидДокумента = "НалоговаяНакладная" Тогда
		Если ДатаОтчета >= '10.01.2011'  Тогда
			HNUM = Прав("      "+НомерДокумента,7); 
		Иначе
			Если рОбычная = 2 Тогда  
				HNUM = СокрЛП(Строка(НомерДокумента))+ "/ЗЦ";
			Иначе
				HNUM = СокрЛП(Строка(НомерДокумента)); 
			КонецЕсли;
		КонецЕсли;	
		Если (ДатаОтчета >= '01.01.2015') Тогда
			Если стрДокумент.СоглашениеОРазделеПродукции = 1 Тогда
				спДанные.ДобавитьЗначение(1, "H01");     //СоглашениеОРазделеПродукции  
			Иначе	
				спДанные.ДобавитьЗначение(0, "H01");     //СоглашениеОРазделеПродукции  
			КонецЕсли;
		КонецЕсли;	
		
		ТипПричиныИнд = Число(СРЕД(СОКРЛП(стрДокумент.ТипПричины),2,2))-1;
		Если стрДокумент.Оставляем = 0 Тогда
			ТипПричиныИнд = 0;			
		КонецЕсли;
		
		Если (ДатаОтчета < '01/12/2014')  Тогда 
			Если стрДокумент.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента Тогда
				ФирмаПолнНаименование = Контрагент.ПолнНаименование;
				ФирмаАдрес = КонтрагентАдрес;
				ФирмаТелефоны = КонтрагентТелефоны;
				ФирмаНомСвид    = "0";
				Если ДатаОтчета >= Константа.ДатаННДек2011 Тогда
					Если стрДокумент.УслугиДляНеХозДеят = 1 Тогда
						ФирмаНалогНомер = "200000000000";
					Иначе	
						ФирмаНалогНомер = "300000000000";
					КонецЕсли;
				КонецЕсли;
				КонтрагентПолнНаименование = Фирма.ПолнНаименование;
				КонтрагентАдрес = глАдресСтрокой(Фирма.ЮридическийАдрес,,1);
				КонтрагентТелефоны = СокрЛП(ФирмаТел);
				КонтрагентНалогНомер = Фирма.ИНН;
				КонтрагентНомСвид = Фирма.НомерСвидетельства;
			Иначе
	
				КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,СокрЛП(Контрагент.ИНН));
				КонтрагентНомСвид = СокрЛП(Контрагент.НомерСвидетельства);
				
				Если ДатаОтчета >= '10.01.2011'  Тогда
					Если (ТипПричиныИнд < 7) и (ТипПричиныИнд > 0) Тогда
						//тип причины: 02, 03, 07, 04, 05, 06
						КонтрагентНалогНомер = ПустойИНН;
						КонтрагентНомСвид    = "0";
					КонецЕсли;        
				КонецЕсли;        
			КонецЕсли;        
		Иначе
			Если (стрДокумент.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
				ФирмаПолнНаименование = ?(стрДокумент.КорГрафы5 = 1,стрДокумент.Графа5,Контрагент.ПолнНаименование);        
				ФирмаАдрес = СокрЛП(Контрагент.Регион);;
				ФирмаТелефоны = "         ";
				Если стрДокумент.УслугиДляНеХозДеят = 1 Тогда
					ФирмаНалогНомер = "200000000000";
				Иначе	
					ФирмаНалогНомер = ?(ДатаОтчета >= '01/01/2015', "500000000000", "300000000000");
				КонецЕсли;
				КолСтр = 1;
				КонтрагентПолнНаименование = Фирма.ПолнНаименование;
				КонтрагентАдрес = Фирма.ЮридическийАдрес;
				КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
				КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
	
			ИначеЕсли (стрДокумент.ДипломатПредст = 1) Тогда
			 	//Дипломатическое представительство
				КонтрагентПолнНаименование = ФирмаПолнНаименование;
				КонтрагентНалогНомер = ПустойИНН;
				КонтрагентАдрес = ФирмаАдрес;
				КонтрагентТелефоны = "         ";
		
			ИначеЕсли (ТипПричиныИнд = 1) или (ТипПричиныИнд = 10) Тогда
			 	//тип причины: 02, 11
				КонтрагентПолнНаименование = "Неплатник";
				КонтрагентНалогНомер = ?(ДатаОтчета >= '01/01/2015', "100000000000", ПустойИНН);
				КонтрагентАдрес = "";
				КонтрагентТелефоны = "         ";
			
			ИначеЕсли (ТипПричиныИнд = 6) Тогда
			 	//тип причины: 07, Экспорт
				КонтрагентНалогНомер = "300000000000";
				КонтрагентАдрес = СокрЛП(Контрагент.Регион);
				КонтрагентТелефоны = "         ";
		
			ИначеЕсли (рОбычная = 2) Тогда
				КонтрагентПолнНаименование = ФирмаПолнНаименование;
				КонтрагентАдрес = ФирмаАдрес;
				КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
				КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12); 
				
			ИначеЕсли (ТипПричиныИнд > 1) Тогда
			 	//тип причины: 03, 04, 05, 06, 08, 09, 10, 13
				КонтрагентНалогНомер = ПустойИНН;
				КонтрагентПолнНаименование = ФирмаПолнНаименование;
				КонтрагентАдрес = ФирмаАдрес;
				КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
		
			Иначе
				КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,  Прав("           " + СокрЛП(Контрагент.ИНН),12));
				Если (ПустоеЗначение(Контрагент.ИНН)=1) Тогда 
					//данные покупателя не заполняем
					КонтрагентАдрес = "";
					КонтрагентТелефоны = "         ";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе   //Приложение2  
		Если (ДатаОтчета >= '01.01.2015') Тогда
			Если стрДокумент.НалоговаяНакладная.СоглашениеОРазделеПродукции = 1 Тогда
				спДанные.ДобавитьЗначение(1, "H01");     //СоглашениеОРазделеПродукции  
			Иначе	
				спДанные.ДобавитьЗначение(0, "H01");     //СоглашениеОРазделеПродукции  
			КонецЕсли;
		КонецЕсли;	
		Если (ДатаОтчета < '01/12/2014')  Тогда 
			Если ДатаОтчета >= '10.01.2011'  Тогда
				HNUM = Прав("      "+НомерДокумента,7); 
				КонтрагентНалогНомер = ?((ПустоеЗначение(Контрагент.ИНН)=1) ИЛИ ((стрДокумент.НалоговаяНакладная.Оставляем = 1) И (Сред(стрДокумент.НалоговаяНакладная.ТипПричины, 2, 2) = "02")),  ПустойИНН, Прав("           " + СокрЛП(Контрагент.ИНН),12));
				КонтрагентНомСвид = ?((ПустоеЗначение(Контрагент.НомерСвидетельства)=1) ИЛИ ((стрДокумент.НалоговаяНакладная.Оставляем = 1) И (Сред(стрДокумент.НалоговаяНакладная.ТипПричины, 2, 2) = "02")),  "        0", Контрагент.НомерСвидетельства);
			Иначе	
				HNUM = СокрЛП(Строка(НомерДокумента)) + "/" + глНомерБезПрефикса(стрДокумент.НалоговаяНакладная.НомерДок);
			КонецЕсли;	
		Иначе	
			HNUM = Прав("      "+НомерДокумента,7); 
			ТипПричиныИнд = ?(стрДокумент.НалоговаяНакладная.Оставляем = 1,Число(Сред(стрДокумент.НалоговаяНакладная.ТипПричины,2,2))-1,0);
			Если (стрДокумент.НалоговаяНакладная.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.РаботыОтНерезидента) Тогда 
				ФирмаПолнНаименование = ?(стрДокумент.НалоговаяНакладная.КорГрафы5 = 1,стрДокумент.НалоговаяНакладная.Графа5,Контрагент.ПолнНаименование);        
				ФирмаАдрес = СокрЛП(Контрагент.Регион);;
				КонтрагентТелефоны = "         ";
				Если стрДокумент.НалоговаяНакладная.УслугиДляНеХозДеят = 1 Тогда
					ФирмаНалогНомер = "200000000000";
				Иначе	
					ФирмаНалогНомер = ?(ДатаОтчета >= '01/01/2015', "500000000000", "300000000000");
				КонецЕсли;
				КолСтр = 1;
				КонтрагентПолнНаименование = Фирма.ПолнНаименование;
				КонтрагентАдрес = Фирма.ЮридическийАдрес;
				КонтрагентНалогНомер = Прав("           " + СокрЛП(Фирма.ИНН),12);
				КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
	
			ИначеЕсли (стрДокумент.НалоговаяНакладная.ДипломатПредст = 1) Тогда
			 	//Дипломатическое представительство
				КонтрагентПолнНаименование = ФирмаПолнНаименование;
				КонтрагентНалогНомер = ПустойИНН;
				КонтрагентАдрес = ФирмаАдрес;
				КонтрагентТелефоны = "         ";
		
			ИначеЕсли (ТипПричиныИнд = 1) или (ТипПричиныИнд = 10) Тогда
			 	//тип причины: 02, 11
				КонтрагентПолнНаименование = "Неплатник";
				КонтрагентНалогНомер = ?(ДатаОтчета >= '01/01/2015', "100000000000", ПустойИНН);
				КонтрагентАдрес = "";
				КонтрагентТелефоны = "         ";
			
			ИначеЕсли (ТипПричиныИнд = 6) Тогда
			 	//тип причины: 07, Экспорт
				КонтрагентНалогНомер = "300000000000";
				КонтрагентАдрес = СокрЛП(Контрагент.Регион);
				КонтрагентТелефоны = "         ";
		
			ИначеЕсли (ТипПричиныИнд > 1) Тогда
			 	//тип причины: 03, 04, 05, 06, 08, 09, 10, 13
				КонтрагентНалогНомер = ПустойИНН;
				КонтрагентПолнНаименование = ФирмаПолнНаименование;
				КонтрагентАдрес = ФирмаАдрес;
				КонтрагентТелефоны = Прав("         " + СокрЛП(ФирмаТел),10);
		
			Иначе
				КонтрагентНалогНомер = ?(ПустоеЗначение(Контрагент.ИНН)=1, ПустойИНН,  Прав("           " + СокрЛП(Контрагент.ИНН),12));
				Если (ПустоеЗначение(Контрагент.ИНН)=1) Тогда 
					//данные покупателя не заполняем
					КонтрагентАдрес = "";
					КонтрагентТелефоны = "         ";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	Если ПустоеЗначение(HNUM) = 0 Тогда
		спДанные.ДобавитьЗначение(HNUM, "HNUM");  //номер документа
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Номер налоговой накладной ");
	КонецЕсли;
	//данные по фирме
	Если ПустоеЗначение(ФирмаПолнНаименование) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(ФирмаПолнНаименование), "HNAMESEL"); //Полное наименование продавца
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Полное наименование фирмы для налоговых документов ");
	КонецЕсли;
	Если ПустоеЗначение(ФирмаНалогНомер) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(ФирмаНалогНомер),	"HKSEL");  //Индивидуальный налоговый номер
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Индивидуальный налоговый номер для фирмы");
	КонецЕсли;
	спДанные.ДобавитьЗначение(СокрЛП(ФирмаАдрес), "HLOCSEL");//Адрес  
	спДанные.ДобавитьЗначение(СокрЛП(ФирмаТелефоны), "HTELSEL");//Адрес  
	Если (ПустоеЗначение(ФирмаНомСвид) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
		спДанные.ДобавитьЗначение(СокрЛП(ФирмаНомСвид), "HNSPDVSEL");//Номер свидетельства плательщика НДС
	КонецЕсли;
	//данные контрагента
	Если ПустоеЗначение(КонтрагентПолнНаименование) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(КонтрагентПолнНаименование), "HNAMEBUY"); //Полное наименование продавца
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Полное наименование контрагента для налоговых документов ");
	КонецЕсли;
	Если ПустоеЗначение(КонтрагентНалогНомер) = 0 Тогда
		спДанные.ДобавитьЗначение(СокрЛП(КонтрагентНалогНомер),	"HKBUY");  //Индивидуальный налоговый номер
	Иначе
		спОшибкиВыгрузки.ДобавитьЗначение("Индивидуальный налоговый номер для контрагента");
	КонецЕсли;
	спДанные.ДобавитьЗначение(СокрЛП(КонтрагентАдрес), "HLOCBUY");//Адрес  
	спДанные.ДобавитьЗначение(СокрЛП(КонтрагентТелефоны), "HTELBUY");//Адрес  
	спДанные.ДобавитьЗначение(СокрЛП(КонтрагентНомСвид), "HNSPDVBUY");//Номер свидетельства плательщика НДС
	спДанные.ДобавитьЗначение(СокрЛП(КонтрагентЕДРПОУ), "EDR_POK");//ЕДРПОУ контрагента
	Если (КонтрагентКодФил <> "0") и (ПустоеЗначение(КонтрагентКодФил)=0) Тогда
		спДанные.ДобавитьЗначение(СокрЛП(КонтрагентКодФил), "DEPT_POK");//код филиала контрагента
	КонецЕсли;
	
	Если ВидДокумента = "НалоговаяНакладная" Тогда
		Если ДатаОтчета >= '10.01.2011'  Тогда
			Если ПустоеЗначение(СтрДокумент.ВидДоговора) = 0 Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.ВидДоговора), "H01G1S");
			КонецЕсли;                                         
			//H01G2D - ТекДатаДоговора
			Если (ПустоеЗначение(СтрДокумент.ДатаДог) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
				спДанные.ДобавитьЗначение(СтрДокумент.ДатаДог, "H01G2D");
			КонецЕсли;                                         
			//H01G3S - ТекНомерДоговора
			Если (ПустоеЗначение(СтрДокумент.НомДог) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.НомДог), "H01G3S");
			КонецЕсли;                                         
			
			Если (ДатаОтчета < '01.01.2015') Тогда
				//HERPN - ВключенаВЕдиныйРеестрНалоговыхНакладных = ЕРНН
				Если ДатаОтчета >= '01.03.2014'  Тогда  
					Если (((ПустоеЗначение(СтрДокумент.ТребуетВклВЕдРеестрНН) = 0) или (ПустоеЗначение(СтрДокумент.ЕРНН) = 0)) и (рОбычная = 1)) ИЛИ 
						(ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
						трВкл = ?((СтрДокумент.ТребуетВклВЕдРеестрНН = 1) или (СтрДокумент.ЕРНН = 1),1,0);
						спДанные.ДобавитьЗначение(СокрЛП(трВкл), "HERPN");
					КонецЕсли;                                         
				Иначе
					Если ((ПустоеЗначение(СтрДокумент.ЕРНН) = 0) и (рОбычная = 1)) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
						спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.ЕРНН), "HERPN");
					КонецЕсли;                                         
				КонецЕсли;                                         
			КонецЕсли;                                         
			//HORIG1 - ОстаетсяУПродавца = Оставляем
			Если (ПустоеЗначение(СтрДокумент.Оставляем) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.Оставляем), "HORIG1");
			КонецЕсли;                                         

			//HTYPR
			ТипПричиныПеч = "";
			Если (рОбычная = 2) и (ДатаОтчета < '01.01.2015') Тогда
				ТипПричиныПеч = "01";
			Иначе
				Если СтрДокумент.Оставляем = 1 Тогда
					ТипПричиныПеч = СРЕД(СОКРЛП(СтрДокумент.ТипПричины),2,2);
				КонецЕсли;
			КонецЕсли;
			
			Если (ПустоеЗначение(ТипПричиныПеч) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
				спДанные.ДобавитьЗначение(ТипПричиныПеч, "HTYPR");
			Иначе
				//спОшибкиВыгрузки.ДобавитьЗначение("Тип причины");
			КонецЕсли;                                         
			
			спДанные.ДобавитьЗначение(СтрДокумент.СпецРежимНалогообложения, "HNUM1");
			
			спДанные.ДобавитьЗначение("", "HNUM2");				
			
			Если ПустоеЗначение(СтрДокумент.ФормаРасчетов) = 0 Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.ФормаРасчетов),  "H02G1S");  
			КонецЕсли;
			Если ПустоеЗначение(СтрДокумент.Выписал) = 0 Тогда
				ПечВыписал = Сред(СтрДокумент.Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(СтрДокумент.Выписал.Отчество) = 1,"",Сред(СтрДокумент.Выписал.Отчество,1,1))
				+ "." + " " + Сокрлп(СтрДокумент.Выписал.Фамилия);
				ПечВыписал = ?(ДатаОтчета >= '01.03.2014', ПечВыписал, глФИО (СтрДокумент.Выписал,1)); 
				спДанные.ДобавитьЗначение(ПечВыписал, "H10G1S");  
			Иначе
				спОшибкиВыгрузки.ДобавитьЗначение("Кто выписал накладную");
			КонецЕсли;
		Иначе //СТАРЫЕ НН
			спДанные.ДобавитьЗначение(стрДокумент.ПометкаОбОсобенностяхЗаполнения, "HORIGS");    //пометка про особенности заполнения  
			Если ПустоеЗначение(СтрДокумент.УсловиеПродажи) = 0 Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.УсловиеПродажи), "H01G1S"); 
			Иначе
				спОшибкиВыгрузки.ДобавитьЗначение("Условие поставки");
			КонецЕсли;
			Если ПустоеЗначение(СтрДокумент.ФормаРасчетов) = 0 Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.ФормаРасчетов),  "H02G1S");  
			Иначе
				спОшибкиВыгрузки.ДобавитьЗначение("Форма проведенных расчетов");
			КонецЕсли;
			Если ПустоеЗначение(СтрДокумент.Выписал) = 0 Тогда
				спДанные.ДобавитьЗначение(глФИО (СтрДокумент.Выписал,1),      "H10G1S");  
			Иначе
				спОшибкиВыгрузки.ДобавитьЗначение("Кто выписал накладную");
			КонецЕсли;
		КонецЕсли;	
	Иначе //П2
		НомерНН = глНомерБезПрефикса(стрДокумент.НалоговаяНакладная.НомерДок);
		ДатаНН  = стрДокумент.НалоговаяНакладная.ДатаДок;
		
		спДанные.ДобавитьЗначение(ДатаНН, "HPODFILL"); //дата налоговой накладной
		спДанные.ДобавитьЗначение(НомерНН,"HPODNUM" ); //номер налоговой накладной 
		Если ДатаОтчета >= '10.01.2011'  Тогда
			Если (ДатаОтчета < '01.01.2015') Тогда
			//HERPN - ВключенаВЕдиныйРеестрНалоговыхНакладных = ЕРНН
				Если ДатаОтчета >= '01.03.2014'  Тогда  
					Если (((ПустоеЗначение(СтрДокумент.ТребуетВклВЕдРеестрНН) = 0) или (ПустоеЗначение(СтрДокумент.ЕРНН) = 0)) и (рОбычная = 1)) ИЛИ 
						(ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
						трВкл = ?((СтрДокумент.ТребуетВклВЕдРеестрНН = 1) или (СтрДокумент.ЕРНН = 1),1,0);
						спДанные.ДобавитьЗначение(СокрЛП(трВкл), "HERPN");
					КонецЕсли;                                         
				Иначе
					Если ((ПустоеЗначение(СтрДокумент.ЕРНН) = 0) и (рОбычная = 1)) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0)  Тогда
						спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.ЕРНН), "HERPN");
					КонецЕсли;                                         
				КонецЕсли;                                         
  			Иначе //2015
				Если стрДокумент.РегистрируетсяВЕРННПокупателем = 1 Тогда
					спДанные.ДобавитьЗначение(1, "HERPN");     //РегистрируетсяВЕРННПокупателем  
				Иначе	
					спДанные.ДобавитьЗначение(0, "HERPN");     //РегистрируетсяВЕРННПокупателем  
				КонецЕсли;
			КонецЕсли; 

			//HORIG1 - ОстаетсяУПродавца = Оставляем
			Если (ПустоеЗначение(СтрДокумент.НалоговаяНакладная.Оставляем) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0) Тогда
				спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.НалоговаяНакладная.Оставляем), "HORIG1");
			КонецЕсли;                                         
			//HTYPR
			ТипПричиныПеч = "";
			Если рОбычная = 2 Тогда
				ТипПричиныПеч = "01";
			Иначе
				Если СтрДокумент.НалоговаяНакладная.Оставляем = 1 Тогда
					ТипПричиныПеч = СРЕД(СОКРЛП(СтрДокумент.НалоговаяНакладная.ТипПричины),2,2);
				КонецЕсли;
			КонецЕсли;
			
			Если (ПустоеЗначение(ТипПричиныПеч) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0) Тогда
				спДанные.ДобавитьЗначение(ТипПричиныПеч, "HTYPR");
			КонецЕсли;                                         
			
			спДанные.ДобавитьЗначение(стрДокумент.СпецРежимНалогообложения, "HNUM1");
			спДанные.ДобавитьЗначение("", "HNUM2");				

			НомерДог = стрДокумент.НалоговаяНакладная.НомДог;
			ДатаДог = стрДокумент.НалоговаяНакладная.ДатаДог;
			СпецРежимНалогообложения = стрДокумент.НалоговаяНакладная.СпецРежимНалогообложения;
			
			спДанные.ДобавитьЗначение(ДатаДог, "H01G1D"); //дата договора
			спДанные.ДобавитьЗначение(НомерДог,"H01G2S" ); //номер договора 
			спДанные.ДобавитьЗначение(СпецРежимНалогообложения,"HPODNUM1" ); //Спец режим налогообложения 
			спДанные.ДобавитьЗначение("", "HPODNUM2");				
			
		Иначе //старые П2	
			Если стрДокумент.Договор.Вид() = "Договор" Тогда       
				НомерДог = стрДокумент.Договор.НомерДоговора;
				ДатаДог = стрДокумент.Договор.ДатаДок;
				спДанные.ДобавитьЗначение(ДатаДог, "H01G1D"); //дата договора
				спДанные.ДобавитьЗначение(НомерДог,"H01G2S" ); //номер договора 
			КонецЕсли;
		КонецЕсли;	
		спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.ФормаРасчетов), "H03G1S");//форма расчетов  
		спДанные.ДобавитьЗначение(ДатаНН,    "H04G1D");//дата оплаты 

		спДанные.ДобавитьЗначение(ДатаОтчета,"H10G1D");//дата корректировки  
		ПечВыписал = Сред(СтрДокумент.Выписал.Имя,1,1) + ". " + ?(ПустоеЗначение(СтрДокумент.Выписал.Отчество) = 1,"",Сред(СтрДокумент.Выписал.Отчество,1,1))
		+ "." + " " + Сокрлп(СтрДокумент.Выписал.Фамилия);
		ПечВыписал = ?(ДатаОтчета >= '01.03.2014', ПечВыписал, глФИО (СтрДокумент.Выписал,1)); 
		спДанные.ДобавитьЗначение(ПечВыписал, "H10G2S");  
		
		Если ДатаОтчета >= '10.01.2011'  Тогда
			ВидДоговораНН  = стрДокумент.НалоговаяНакладная.ВидДоговора;
			ДатаДогНН  = стрДокумент.НалоговаяНакладная.ДатаДог;
			НомДогНН  = стрДокумент.НалоговаяНакладная.НомДог;

			спДанные.ДобавитьЗначение(СокрЛП(ВидДоговораНН),"H02G1S");//вид договора НН
			
			// H02G2D
			Если (ПустоеЗначение(ДатаДогНН) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0) Тогда
				спДанные.ДобавитьЗначение(ДатаДогНН, "H02G2D"); // дата договора
			КонецЕсли;                                         
			// H02G3S 
			Если (ПустоеЗначение(НомДогНН) = 0) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С)=0) Тогда
				спДанные.ДобавитьЗначение(СокрЛП(НомДогНН), "H02G3S"); // номер договора
			КонецЕсли;                                         

		Иначе

			спДанные.ДобавитьЗначение(СокрЛП(СтрДокумент.УсловиеПродажи),"H02G1S");//условие продажи 
			
			спДанные.ДобавитьЗначение(ДатаОтчета,"H11G1D");//дата документа  
			спДанные.ДобавитьЗначение(НомерДокумента,               "H11G2S");//номер документа  
			спДанные.ДобавитьЗначение(ДатаНН,    "H12G1D");//дата налоговой накладной
			спДанные.ДобавитьЗначение(НомерНН,   "H12G2S");//номер налоговой накладной 
		КонецЕсли;	
		
	КонецЕсли;

	Если ПустоеЗначение(спОшибкиВыгрузки) = 0 Тогда      
		Сообщить("Не заполнены следующие реквизиты:", "!");     
		
		Для Нсч=1 По спОшибкиВыгрузки.РазмерСписка() Цикл
			Сообщить(спОшибкиВыгрузки.ПолучитьЗначение(Нсч) + ";", "!");     
		КонецЦикла;
		Сообщить("Выгрузка невозможна!", "!");     
		спДанные = "";
	КонецЕсли;

КонецПроцедуры

//============================
Функция ПолучитьЛьготу(ТекТМЦ = "",ЛьготаНДС, КодЛьготы)
	Если ПустоеЗначение(ЛьготаНДС) = 0 Тогда
		Льгота = ЛьготаНДС.Наименование;
		ЛьготаКод = КодЛьготы;
	ИначеЕсли ТекТМЦ.Вид() = "ТМЦ" Тогда   
		Льгота = ТекТМЦ.ЛьготаНДС.Наименование;
		ЛьготаКод = ТекТМЦ.КодЛьготы;
	КонецЕсли;  
	Если ПустоеЗначение(ЛьготаКод) = 1 Тогда
		ЛьготаКод = "99999999";
	КонецЕсли;
	
	Поз = Найти(Льгота, "(");
	Если Поз>0 Тогда
		Льгота = Лев(Льгота, Поз-1)
	КонецЕсли;
	
	Возврат Льгота;		
КонецФункции
// ===============================
Функция СуммаДляЭкспорта(Сумма)
	Если стрДокумент.Валюта = Гривня  Тогда
		СуммаЭксп = СокрЛ(Формат(Сумма,"Ч17.2."));
	Иначе
		СуммаЭксп = СокрЛ(Формат(глПересчет(Сумма,стрДокумент.Валюта,Гривня,стрДокумент.Курс,ДатаОтчета),"Ч17.2."));
	КонецЕсли;
	Возврат СуммаЭксп
КонецФункции

// ===============================
Процедура ЗаполнитьСкидкуНадбавку(Сумма, Скидка, Надбавка)
	Если Сумма < 0 Тогда
		Надбавка = Надбавка - Сумма;
	Иначе
		Скидка = Скидка + Сумма;
	КонецЕсли;
КонецПроцедуры  
// ===============================
Функция ДатаДляПечати(ДатаД)
	Возврат Формат(ДатаЧисло(ДатаД),"Ч(0)2")+Формат(ДатаМесяц(ДатаД),"Ч(0)2")+Строка(ДатаГод(ДатаД))
КонецФункции
// ===============================                                     
Процедура СформироватьПриложение2016(спДанные = "")
	
	КодНДС = СокрЛП(стрДокумент.ВидНДС.Код);
	ПечСтавка = "";
	ИтогПоЛьготам = "";
	СоглОРазделеПродукции = стрДокумент.НалоговаяНакладная.СоглашениеОРазделеПродукции; 
	ТекстДополненияГр3 = ?(СоглОРазделеПродукции = 1," розподіл сум податкового кредиту за багатосторонньою угодою про розподіл продукції","");
	Если (Сводная = 0) и (СоглОРазделеПродукции = 0) Тогда
		Если (КодНДС = "БезНДС") Тогда	
			ПечСтавка = "903";
		ИначеЕсли (КодНДС = "НДС20") Тогда	
			ПечСтавка = "20";
		ИначеЕсли (КодНДС = "НДС7") Тогда	
			ПечСтавка = "7";
		ИначеЕсли (КодНДС = "НДС0") Тогда	
			ПечСтавка = ?(ТипПричиныИнд = 7,"901","902");
		КонецЕсли;	
	КонецЕсли;	
	Валюта     = стрДокумент.Валюта;
	Курс       = стрДокумент.Курс;  
	Дата_курса = стрДокумент.Дата_курса;

	//итоги
	ПечИтогНДС = глПересчет(стрДокумент.Итог("ИзмНДС"),Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса);
	ПечИтогБезНДС = 0; ПечИтогБезНДС03 = 0; ПечИтогБезНДС02 = 0;
	ПечИтогБезНДС02 = 0; ПечИтогБезНДС20 = 0; ПечИтогНДС20 = 0; 
	ПечИтогБезНДС7 = 0; ПечИтогНДС7 = 0; ПечИтогБезНДС01 = 0;  
	Если СоглОРазделеПродукции = 0 Тогда
		ИтогСуммаБезНДС = глПересчет(стрДокумент.Итог("ИзмСуммыБезНДС"),Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса);
		ПечИтогБезНДС = ИтогСуммаБезНДС;
		Если (КодНДС = "БезНДС") и (Сводная = 0) Тогда	
			ПечИтогБезНДС03 = ПечИтогБезНДС;
		ИначеЕсли (КодНДС = "НДС20") Тогда	
			ПечИтогБезНДС20 = ПечИтогБезНДС;
			ПечИтогНДС20 = ПечИтогНДС;
		ИначеЕсли (КодНДС = "НДС7") Тогда	
			ПечИтогБезНДС7 = ПечИтогБезНДС;
			ПечИтогНДС7 = ПечИтогНДС;
		ИначеЕсли (КодНДС = "НДС0") и (Сводная = 0) Тогда
			Если ТипПричиныИнд = 7 Тогда
				ПечИтогБезНДС01 = ПечИтогБезНДС;
			Иначе	
				ПечИтогБезНДС02 = ПечИтогБезНДС;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	спДанные.ДобавитьЗначение(ПечИтогНДС,      "R001G03");
	спДанные.ДобавитьЗначение(ПечИтогНДС20,    "R02G9");
	спДанные.ДобавитьЗначение(ПечИтогНДС7,     "R02G111");
	спДанные.ДобавитьЗначение(ПечИтогБезНДС20, "R01G9");
	спДанные.ДобавитьЗначение(ПечИтогБезНДС7,  "R01G111");
	спДанные.ДобавитьЗначение(ПечИтогБезНДС01, "R006G03");
	спДанные.ДобавитьЗначение(ПечИтогБезНДС02, "R007G03");
	спДанные.ДобавитьЗначение(ПечИтогБезНДС03, "R01G11");

	КоэфБезНДС = 100/(100 + глПроцентНДС(стрДокумент.ВидНДС,ДатаОтчета));
	глОчиститьКлючОкр("ИзмСуммыБезНДС");
	глОчиститьКлючОкр("ИзмНДС");

	// В FREDO Звіт выгружаются все значения
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	стрДокумент.ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	ТаблТМЦ.ВыбратьСтроки();      
	Ном = 1; 
	
	Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
		
		ТекстГТД = "";
		Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
			//по умолчанию дополняем текст ГТД  
			Если ПечататьДатыСРазделителями = Да Тогда
				ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
			Иначе //по умолчанию без разделителей
				ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
			КонецЕсли; 
			ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
		КонецЕсли;
		Если (Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС") Тогда	
			СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ, стрДокумент.НалоговаяНакладная.ЛьготаНДС, стрДокумент.НалоговаяНакладная.КодЛьготы);
			Если ЛьготаКод = "99999999" Тогда
				Если ИтогПоЛьготам = "" Тогда
					ИтогПоЛьготам = СтатьяЛьготы;
				ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
					ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		ПечЕдИзм = Строка(ТаблТМЦ.Ед.Единица);

		КодДляНН = СокрЛП(ТаблТМЦ.КодУКТВЭД.Код);
		ВидКода = ТаблТМЦ.КодУКТВЭД.Вид;
		Ст4 = ?(ВидКода <> Перечисление.ВидыКодовДляНН.Услуга,СтрЗаменить(КодДляНН,".",""),""); 
		Ст42 = ?(ВидКода = Перечисление.ВидыКодовДляНН.ИмпортированныйТовар,1,0); 
		Ст43 = ?(ВидКода = Перечисление.ВидыКодовДляНН.Услуга,КодДляНН,"");
		Ст14 = ?(стрДокумент.НалоговаяНакладная.СпецРежимНалогообложения = 2, СокрЛП(ТаблТМЦ.КодВидаСХ), "");
		Ст5 = ?(ТаблТМЦ.ТМЦ.Вид()="ТМЦ",ПечЕдИзм,"шт");
		Ст5 = ?(Сводная = 1,"грн",Ст5);
		Ст6 = ?(ТаблТМЦ.ТМЦ.Вид()="ТМЦ",ТаблТМЦ.Ед.Единица.КодЕдИзмерения,"2009");
		Ст6 = ?(Сводная = 1,"",Ст6);
		Если СоглОРазделеПродукции = 0 Тогда
			Если Сводная = 1 Тогда
				ЛьготаКод = ""; ИтогПоЛьготам = "";
			Иначе	
				Если ТаблТМЦ.ИзмКво <> 0 Тогда
					ТекКво = ТаблТМЦ.ИзмКво;
					Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда       
						ТекЦенаБезНДС = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС;
					Иначе
						ТекЦенаБезНДС = ТаблТМЦ.ЦенаБезНДС;
					КонецЕсли;                  
				Иначе
					ТекКво = ТаблТМЦ.Кво;
					ТекЦенаБезНДС = ТаблТМЦ.ИзмЦены;
				КонецЕсли;  
				ЦенаБезНДСГрн	  = Окр(глПересчет(ТекЦенаБезНДС, Валюта,Курс,Гривня,ДатаОтчета,Дата_курса),3);
				// рассчитываем суммы с учетом накопленных погрешностей округления
				ИзмСуммыБезНДСГрн = глОкрКорр("ИзмСуммыБезНДС",глПересчет(ТаблТМЦ.ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),3);
				ИзмНДСГрн         = глОкрКорр("ИзмНДС",        глПересчет(ТаблТМЦ.ИзмНДС,        Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),3);
				
				// подберем цену и количество по указанному в шапке способу
				глПодогнатьЦенаКоличество(ИзмСуммыБезНДСГрн, ЦенаБезНДСГрн, ТекКво, стрДокумент.СпособПодгонки);

				КвоТМЦ = ТаблТМЦ.Кво;
				Ст7=0; Ст8=0; Ст9=0;ст10=0;
				Если ТаблТМЦ.ИзмКво<>0 Тогда
					Ст7 = ТекКво;
					Ст8 = ЦенаБезНДСГрн;
				Иначе
					Ст9 = ЦенаБезНДСГрн; 
					Ст10 = КвоТМЦ;
				КонецЕсли;  
			КонецЕсли;  
			Ст13 = Формат(глПересчет(ТаблТМЦ.ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),"Ч12.2");
		Иначе //СоглашениеОРазделеПродукции = 1	
			ЛьготаКод = ""; ИтогПоЛьготам = ""; 
			Ст5 = ""; Ст6 = ""; Ст4 = "";
		КонецЕсли;
		ЗаполнениеСтрокТЧПрил(Ном,спДанные,
			ТаблТМЦ.НомерСтрокиНН,   
			СокрЛП(ТаблТМЦ.Причина), 
			СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование) + ТекстГТД,
			Ст4, //КодУКТВЭД
			Ст5, //ед.изм
			Ст6, //код ед.изм
			Ст7, //изм. количества
			Ст8, //цена
			Ст9, //изм. цены
			Ст10, //кол-во
			ПечСтавка,
			ЛьготаКод,
			Ст13,//база НДС
			Ст42,//Импорт
			Ст43,//Код услуги
			Ст14);// Код СХ
		Ном = Ном + 1;
	КонецЦикла;
	
	Если Ном > 9998 Тогда
		Сообщить("Для экспорта в электронный вид документ должен содержать не более 9999 строк."
		"В данном документе ограничение превышено. Отчет не пройдет проверку по схеме.",
		"!");
	КонецЕсли;
	
КонецПроцедуры
// ===============================                                     
Процедура СформироватьПриложение2011(спДанные = "")
	Перем Ст[14], Валюта,Курс,Дата_курса;  
	
	// В FREDO Звіт выгружаются все значения
	Если ПустоеЗначение(мМенеджерЗвит1С) = 0 Тогда
		Для Н = 1 По 13 Цикл
			Ст[Н] = 0;
		КонецЦикла;
	КонецЕсли;
	 
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	стрДокумент.ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	КодНДС = СокрЛП(стрДокумент.ВидНДС.Код);
	Ном = 1;
	
	КоэфБезНДС = 100/(100 + глПроцентНДС(стрДокумент.ВидНДС,ДатаОтчета));
	глОчиститьКлючОкр("ИзмСуммыБезНДС");
	глОчиститьКлючОкр("ИзмНДС");

	Валюта     = стрДокумент.Валюта;
	Курс       = стрДокумент.Курс;  
	Дата_курса = стрДокумент.Дата_курса;
	ТаблТМЦ.ВыбратьСтроки();      
	
	Итог9 = 0; Итог10 = 0; Итог11 = 0; Итог12 = 0;
	
	Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
		Ст[1] = ДатаОтчета;
		Ст[2] = ТаблТМЦ.Причина;
		Ст[13] = СокрЛП(СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",""));

		ТекстГТД = "";
		Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
			//дополняем текст ГТД  
			Если ПечататьДатыСРазделителями = Да Тогда
				ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
			Иначе //по умолчанию без разделителей
				ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
			КонецЕсли; 
			ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
		КонецЕсли;
		Ст[3] = СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование) + ТекстГТД;
		
		Ст[4] = ?(ТаблТМЦ.ТМЦ.Вид()="ТМЦ",ТаблТМЦ.Ед.Единица,?(ДатаОтчета >= '01/01/2015',"шт",ТаблТМЦ.ТМЦ.БазЕдиница));
		Ст[14] = ?(ТаблТМЦ.ТМЦ.Вид()="ТМЦ",ТаблТМЦ.Ед.Единица.КодЕдИзмерения,"2009");
		Для Н = 5 По 11 Цикл
			Ст[Н] = 0;
		КонецЦикла;                    
		
		Если ТаблТМЦ.ИзмКво <> 0 Тогда
			ТекКво = ТаблТМЦ.ИзмКво;
			Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда       
				ТекЦенаБезНДС = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС;
			Иначе
				ТекЦенаБезНДС = ТаблТМЦ.ЦенаБезНДС;
			КонецЕсли;                  
		Иначе
			ТекКво = ТаблТМЦ.Кво;
			ТекЦенаБезНДС = ТаблТМЦ.ИзмЦены;
		КонецЕсли;  
		ЦенаБезНДСГрн	  = Окр(глПересчет(ТекЦенаБезНДС, Валюта,Курс,Гривня,ДатаОтчета,Дата_курса),3);
		// рассчитываем суммы с учетом накопленных погрешностей округления
		ИзмСуммыБезНДСГрн = глОкрКорр("ИзмСуммыБезНДС",глПересчет(ТаблТМЦ.ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),3);
		ИзмНДСГрн         = глОкрКорр("ИзмНДС",        глПересчет(ТаблТМЦ.ИзмНДС,        Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),3);
		
		// подберем цену и количество по указанному в шапке способу
		глПодогнатьЦенаКоличество(ИзмСуммыБезНДСГрн, ЦенаБезНДСГрн, ТекКво, стрДокумент.СпособПодгонки);
		
		//в схеме количество - числовое, нельзя вывести "услуга"
		КвоТМЦ = ТаблТМЦ.Кво;
		Если ТаблТМЦ.ИзмКво<>0 Тогда
			Ст[5] = ТекКво;
			Ст[6] = ЦенаБезНДСГрн;
		Иначе
			Ст[7] = ЦенаБезНДСГрн; 
			Ст[8] = КвоТМЦ;
		КонецЕсли;  
		ИзмСуммыБезНДС = ТаблТМЦ.ИзмСуммыБезНДС;
		Если КодНДС = "НДС20" Тогда
			Ст[9]  = ИзмСуммыБезНДСГрн;
			Итог9 = Итог9 + ИзмСуммыБезНДСГрн; 
		ИначеЕсли (КодНДС = "НДС0") Тогда
			Ст[10] = ИзмСуммыБезНДСГрн;
			Итог10 = Итог10 + ИзмСуммыБезНДСГрн ; 
		ИначеЕсли (КодНДС = "НДС7")Тогда 
			Если ДатаОтчета < '01.03.2014' Тогда
				Ст[10] = ИзмСуммыБезНДСГрн;
				Итог10 = Итог10 + ИзмСуммыБезНДСГрн ; 
			Иначе	
				Ст[12] = ИзмСуммыБезНДСГрн;
				Итог12 = Итог12 + ИзмСуммыБезНДСГрн ; 
			КонецЕсли;
		ИначеЕсли КодНДС = "БезНДС" Тогда
			Ст[11] = ИзмСуммыБезНДСГрн;
			Итог11 = Итог11 + ИзмСуммыБезНДСГрн; 
		КонецЕсли;
		
		ЗаполнитьСтрокуПриложения(спДанные, Ст, Ном, 1, 14);
		Если (ПустоеЗначение(мМенеджерЗвит1С) = 0) Тогда 
			//Для Звит дополнительный показатель 
			RGRATE = "";
			Если КодНДС = "НДС20" Тогда
				RGRATE= "20%";
			ИначеЕсли КодНДС = "НДС7" Тогда
				RGRATE= "7%";
			ИначеЕсли КодНДС = "НДС0" Тогда
				RGRATE= "0%";
			ИначеЕсли КодНДС = "БезНДС" Тогда
				RGRATE= "б/пдв";
			//ИначеЕсли ТекущийСтолбец = 9 Тогда
			//	RGRATE= "експ.";
			КонецЕсли;
			спДанные.ДобавитьЗначение(RGRATE,  "RGRATE" + Формат(Ном, "Ч(0)4"));
		КонецЕсли;	
		Ном = Ном + 1;
	КонецЦикла;
               
	Ст[9] = Итог9;
	Ст[10] = Итог10;
	Ст[11] = Итог11;
	Ст[12] = Итог12;
	
	ЗаполнитьСтрокуПриложения(спДанные, Ст, 1, 9, 12, "Ч(0)2");      
	
	Если КодНДС = "НДС7" Тогда
		Итог109_ = стрДокумент.ИзмСуммыНДС;  
		Итог9_ = 0;
	Иначе
		Итог9_ = стрДокумент.ИзмСуммыНДС; 
		Итог109_ = 0;
	КонецЕсли;
	
	Ст[9] = Итог9_;
	Ст[12] = Итог109_;
	
	ЗаполнитьСтрокуПриложения(спДанные, Ст, 2, 9, 12, "Ч(0)2");      
	
КонецПроцедуры

// ===============================                                     
Процедура СформироватьПриложение(спДанные = "")
Перем Ст[15], Валюта,Курс,Дата_курса;  
	
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	стрДокумент.ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	КодНДС = СокрЛП(стрДокумент.ВидНДС.Код);
	Ном = 1;
	
	КоэфБезНДС = 100/(100 + глПроцентНДС(стрДокумент.ВидНДС,ДатаОтчета));
	глОчиститьКлючОкр("ИзмСуммыБезНДС");
	глОчиститьКлючОкр("ИзмНДС");

	Валюта     = стрДокумент.Валюта;
	Курс       = стрДокумент.Курс;  
	Дата_курса = стрДокумент.Дата_курса;
	ТаблТМЦ.ВыбратьСтроки();      
	Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
		Ст[1] = ДатаОтчета;
		Ст[2] = ТаблТМЦ.Причина;
		Ст[3] = ТаблТМЦ.ТМЦ.ПолнНаименование;
		Ст[4] = ?(ТаблТМЦ.ТМЦ.Вид()="ТМЦ",ТаблТМЦ.Ед,ТаблТМЦ.ТМЦ.БазЕдиница);
		Для Н = 5 По 15 Цикл
			Ст[Н] = 0;
		КонецЦикла;                    
		
		Если ТаблТМЦ.ИзмКво <> 0 Тогда
			ТекКво = ТаблТМЦ.ИзмКво;
			Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда       
				ТекЦенаБезНДС = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС;
			Иначе
				ТекЦенаБезНДС = ТаблТМЦ.ЦенаБезНДС;
			КонецЕсли;                  
		Иначе
			ТекКво = ТаблТМЦ.Кво;
			ТекЦенаБезНДС = ТаблТМЦ.ИзмЦены;
		КонецЕсли;  
		ЦенаБезНДСГрн	  = Окр(глПересчет(ТекЦенаБезНДС, Валюта,Курс,Гривня,ДатаОтчета,Дата_курса),3);
		// рассчитываем суммы с учетом накопленных погрешностей округления
		ИзмСуммыБезНДСГрн = глОкрКорр("ИзмСуммыБезНДС",глПересчет(ТаблТМЦ.ИзмСуммыБезНДС,Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),3);
		ИзмНДСГрн         = глОкрКорр("ИзмНДС",        глПересчет(ТаблТМЦ.ИзмНДС,        Валюта,Курс,Гривня,ДатаОтчета,Дата_Курса),3);
		
		// подберем цену и количество по указанному в шапке способу
		глПодогнатьЦенаКоличество(ИзмСуммыБезНДСГрн, ЦенаБезНДСГрн, ТекКво, стрДокумент.СпособПодгонки);
		
		//в схеме количество - числовое, нельзя вывести "услуга"
		КвоТМЦ = ТаблТМЦ.Кво; 
		Если ТаблТМЦ.ИзмКво<>0 Тогда
			Ст[5] = ТекКво;
			Ст[6] = ЦенаБезНДСГрн;
		Иначе
			Ст[7] = ЦенаБезНДСГрн; 
			Ст[8] = КвоТМЦ;
		КонецЕсли;  
		ИзмСуммыБезНДС = ТаблТМЦ.ИзмСуммыБезНДС;
		Если КодНДС = "НДС20" Тогда
			Ст[9]  = ИзмСуммыБезНДСГрн;
		ИначеЕсли КодНДС = "НДС0" Тогда
			Ст[10] = ИзмСуммыБезНДСГрн;
		ИначеЕсли КодНДС = "БезНДС" Тогда
			Ст[11] = ИзмСуммыБезНДСГрн;
		КонецЕсли;
		Если (КодНДС = "НДС20") и (ИзмСуммыБезНДС<0) Тогда
			Ст[12] = ИзмНДСГрн;
			Ст[13] = ИзмНДСГрн;
		ИначеЕсли (КодНДС = "НДС20") и (ИзмСуммыБезНДС>0) Тогда
			Ст[14] = ИзмНДСГрн;
			Ст[15] = ИзмНДСГрн;
		КонецЕсли;
		
		ЗаполнитьСтрокуПриложения(спДанные, Ст, Ном);
		Ном = Ном + 1;
	КонецЦикла;

КонецПроцедуры
                       
// ===============================
Процедура Сформировать2016(спДанные = "")

	КодНДС = СокрЛП(стрДокумент.ВидНДС.Код);
	ПечСтавка = "";
	СоглОРазделеПродукции = стрДокумент.СоглашениеОРазделеПродукции; 
	ТекстДополненияГр3 = ?(СоглОРазделеПродукции = 1," розподіл сум податкового кредиту за багатосторонньою угодою про розподіл продукції","");
	Если (Сводная = 0) и (СоглОРазделеПродукции = 0) Тогда
		Если (КодНДС = "БезНДС") Тогда	
			ПечСтавка = "903";
		ИначеЕсли (КодНДС = "НДС20") Тогда	
			ПечСтавка = "20";
		ИначеЕсли (КодНДС = "НДС7") Тогда	
			ПечСтавка = "7";
		ИначеЕсли (КодНДС = "НДС0") Тогда	
			ПечСтавка = ?(ТипПричиныИнд = 7,"901","902");
		КонецЕсли;	
	КонецЕсли;	
	
	ЕстьНулевыеСтавкиНДС = стрДокумент.ЕстьНулевыеСтавкиНДС;
	
	ДопКолонка = ?(ЕстьНулевыеСтавкиНДС = 1, "НулеваяСтавкаНДС,","");
	КоэфБезНДС = 100/(100 + глПроцентНДС(стрДокумент.ВидНДС,ДатаОтчета));
    
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	стрДокумент.ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	
	Если рОбычная = 1 Тогда
		//Обычная налоговая накладная	

		ТаблТМЦ.Свернуть(ДопКолонка + "ТМЦ,"+
	  			?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
	  			",Ед,Коэффициент,ОперДата,КодУКТВЭД,НомерГТД,КодВидаСХ","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");

		//итоги 
		ИтогНДС = стрДокумент.Итог("НДС");
		ПечИтогНДС = ?(ИтогНДС <> 0,СуммаДляЭкспорта(ИтогНДС),0);
		спДанные.ДобавитьЗначение(СуммаДляЭкспорта(стрДокумент.Итог("СуммаСНДС")),  "R04G11");
		Если стрДокумент.СуммаВозвратнойТары <> 0 Тогда
			спДанные.ДобавитьЗначение(СуммаДляЭкспорта(стрДокумент.СуммаВозвратнойТары),  "R02G11");
		КонецЕсли;	
		ИтогБезНДС =  стрДокумент.Итог("СуммаБезНДС");
		ПечИтогБезНДС =  ?(ИтогБезНДС<>0, СуммаДляЭкспорта(ИтогБезНДС),0);
		R01G10 = 0; R01G8 = 0; R01G9 = 0;
		R01G7 = 0; R03G7 = 0; R01G109 = 0; R03G109 = 0; 
		Если СоглОРазделеПродукции = 0 Тогда
			Если (КодНДС = "БезНДС") Тогда	
				R01G10 = ПечИтогБезНДС;
				ПечИтогНДС = 0;
			ИначеЕсли (КодНДС = "НДС20") Тогда	
				СуммаНДС0 = стрДокумент.Итог("БазаНДС0");
				Если СуммаНДС0 <> 0 Тогда
					Если ТипПричиныИнд = 7 Тогда
						R01G9 = СокрЛ(Формат(СуммаНДС0,"Ч17.2."));
					Иначе	
						R01G8 = СокрЛ(Формат(СуммаНДС0,"Ч17.2."));
					КонецЕсли;
				КонецЕсли;
				R01G7 = СокрЛ(Формат(глПересчет(ИтогБезНДС,стрДокумент.Валюта,Гривня,стрДокумент.Курс,ДатаОтчета) - стрДокумент.Итог("БазаНДС0"),"Ч17.2."));
				R03G7 = ПечИтогНДС;
			ИначеЕсли (КодНДС = "НДС7") Тогда	
				R01G109 = ПечИтогБезНДС;
				R03G109 = ПечИтогНДС;
			ИначеЕсли (КодНДС = "НДС0") Тогда
				Если ТипПричиныИнд = 7 Тогда
					R01G9 = ПечИтогБезНДС;
				Иначе	
					R01G8 = ПечИтогБезНДС;
				КонецЕсли;
				ПечИтогНДС = 0;
			КонецЕсли;	
		КонецЕсли;	
		спДанные.ДобавитьЗначение(ПечИтогНДС,  "R03G11");
		спДанные.ДобавитьЗначение(R01G10, "R01G10");
		спДанные.ДобавитьЗначение(R01G8, "R01G8");
		спДанные.ДобавитьЗначение(R01G9, "R01G9");
		спДанные.ДобавитьЗначение(R01G7, "R01G7");
		спДанные.ДобавитьЗначение(R03G7, "R03G7");
		спДанные.ДобавитьЗначение(R01G109, "R01G109");
		спДанные.ДобавитьЗначение(R03G109, "R03G109");
		
		ИтогПоЛьготам = "";
		          
		Ном = 1;
		ПечСтавка1 = ПечСтавка;
		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если (Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС") Тогда	
				СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ, стрДокумент.ЛьготаНДС, стрДокумент.КодЛьготы);
				Если ЛьготаКод = "99999999" Тогда
					Если ИтогПоЛьготам = "" Тогда
						ИтогПоЛьготам = СтатьяЛьготы;
					ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
						ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
			    //дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			
			Если ТаблТМЦ.Скидка<>0 Тогда
				ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезНДС;
				ТекЦенаБезНДС     = ТаблТМЦ.СуммаБезНДС/ (ТаблТМЦ.Кво*ТаблТМЦ.Коэффициент);
			Иначе
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда 
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезСкидки*?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
						ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * ?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
					Иначе
						ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезСкидки*КоэфБезНДС;
						ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС; 
					КонецЕсли;
				Иначе
					ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезНДС;
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
				КонецЕсли;
			КонецЕсли;

			ЕдИзм = ""; ПечЦенаБезНДС = 0; КодЕдИзм = ""; 
			ПечСуммаБезНДС = 0; ПечКво = 0;

			КодДляНН = СокрЛП(ТаблТМЦ.КодУКТВЭД.Код);
			ВидКода = ТаблТМЦ.КодУКТВЭД.Вид;
			буфКодУКТВЭД = ?(ВидКода <> Перечисление.ВидыКодовДляНН.Услуга,СтрЗаменить(КодДляНН,".",""),""); 
			ПрИмп = ?(ВидКода = Перечисление.ВидыКодовДляНН.ИмпортированныйТовар,1,0); 
			буфКодДКПП = ?(ВидКода = Перечисление.ВидыКодовДляНН.Услуга,КодДляНН,"");
			КодСХ = ?(стрДокумент.СпецРежимНалогообложения = 2, СокрЛП(ТаблТМЦ.КодВидаСХ), "");
			Если СоглОРазделеПродукции = 0 Тогда
				Если Сводная = 1 Тогда
					ЕдИзм = "грн";
					ПечСуммаБезНДС = ТаблТМЦ.СуммаБезНДС;
					ЛьготаКод = ""; ИтогПоЛьготам = "";
				Иначе	
					ПечКво = ТаблТМЦ.Кво;
					ПечЦенаБезНДС = ТекЦенаБезНДС;
					Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда 
						ЕдИзм = Строка(ТаблТМЦ.Ед.Единица);
						КодЕдИзм = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
					Иначе
						ЕдИзм = "шт";
						КодЕдИзм = "2009";
					КонецЕсли;
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда 
							Если ТипПричиныИнд = 7 Тогда
								ПечСтавка = "901";
							Иначе	
								ПечСтавка = "902";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					ПечСуммаБезНДС = ТекСуммаБезСкидки;
				КонецЕсли; 
			Иначе //СоглашениеОРазделеПродукции = 1	
				ЛьготаКод = ""; ИтогПоЛьготам = "";
			КонецЕсли;

			ЗаполнениеСтрокТЧ(Ном,спДанные,
					СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование)+ТекстГТД+ТекстДополненияГр3, //наименование ТМЦ
					буфКодУКТВЭД,
					ЕдИзм,
					КодЕдИзм,
					ПечКво,
					СуммаДляЭкспорта(ПечЦенаБезНДС),
					ПечСтавка,
					ЛьготаКод,
					СуммаДляЭкспорта(ПечСуммаБезНДС),
					ПрИмп,
					буфКодДКПП,
					КодСХ);
		
			Ном = Ном + 1;
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда   //вернем ставку
				ПечСтавка = ПечСтавка1;
			КонецЕсли;
			Если (ТаблТМЦ.СуммаБезНДС < 0) Тогда
				Предупреждение("В строке " + (Ном-1) + " табличной части отрицательная сумма. Документ не пройдет проверку по схеме.");
			КонецЕсли;
		КонецЦикла;	
		
	Иначе //рОбычная = 0
		//налоговая накладная на превышение цен
		
		Если ДатаОтчета >= '01/03/2017' Тогда
			ТекстДополненияГр3 = " (" + СокрЛП(стрДокумент.ТекстДоп);
		Иначе	
			ТекстДополненияГр3 = " (" + СокрЛП(стрДокумент.ТекстДоп) + " в податковій накладній №" + СокрЛП(стрДокумент.НомерОсновнойНН);
			ТекстДополненияГр3 = ТекстДополненияГр3 + ?((стрДокумент.ОЦВключаетПроценты=1) и (стрДокумент.Итог("СуммаБезНДС") <> 0),", сума процентів, нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
		КонецЕсли;	
		
		ИтогСуммаБезНДС = стрДокумент.Итог("СуммаПревышения"); 
		ИтогНДС = СуммаДляЭкспорта(стрДокумент.Итог("НДСПревышения"));
		спДанные.ДобавитьЗначение(СуммаДляЭкспорта(ИтогСуммаБезНДС + стрДокумент.Итог("НДСПревышения")),  "R04G11");
		Если стрДокумент.СуммаВозвратнойТары <> 0 Тогда
			спДанные.ДобавитьЗначение(СуммаДляЭкспорта(стрДокумент.СуммаВозвратнойТары),  "R02G11");
		КонецЕсли;	
		спДанные.ДобавитьЗначение(ИтогНДС,  "R03G11");
		R01G7 = 0; R03G7 = 0; R01G109 = 0; R03G109 = 0; 
		Если СоглОРазделеПродукции = 0 Тогда
			Если (КодНДС = "НДС20") Тогда	
				R01G7 = СуммаДляЭкспорта(ИтогСуммаБезНДС);
				R03G7 = ИтогНДС;
			ИначеЕсли (КодНДС = "НДС7") Тогда	
				R01G109 = СуммаДляЭкспорта(ИтогСуммаБезНДС);
				R03G109 = ИтогНДС;
			КонецЕсли;	
		КонецЕсли;	
		спДанные.ДобавитьЗначение(R01G7, "R01G7");
		спДанные.ДобавитьЗначение(R03G7, "R03G7");
		спДанные.ДобавитьЗначение(R01G109, "R01G109");
		спДанные.ДобавитьЗначение(R03G109, "R03G109");

		Ном = 1;
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
			    //по умолчанию дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			Если ТаблТМЦ.СуммаПревышения > 0 Тогда
				ЕдИзм = ""; ПечЦенаБезНДС = 0; КодЕдИзм = ""; ПечСуммаБезНДС = 0;  ПечКво = 0;
				Если СоглОРазделеПродукции = 0 Тогда
					буфКодУКТВЭД = ?(ДатаОтчета >= '01/03/2017',"",СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",""));
					Если Сводная = 1 Тогда
						ЕдИзм = "грн";
					Иначе	
						ПечКво = ТаблТМЦ.Кво;
						Если ДатаОтчета < '01/03/2017' Тогда
							Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
								ЕдИзм = Строка(ТаблТМЦ.Ед.Единица);
								КодЕдИзм = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
							Иначе
								ЕдИзм = "шт";
								КодЕдИзм = "2009";
							КонецЕсли;	
						КонецЕсли;
						ПечЦенаБезНДС = ?((ТаблТМЦ.Кво=0), "", СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения/ТаблТМЦ.Кво));
					КонецЕсли;
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда 
							Если ТипПричиныИнд = 7 Тогда
								ПечСтавка = "901";
							Иначе	
								ПечСтавка = "902";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					ПечСуммаБезНДС = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
				Иначе //СоглашениеОРазделеПродукции = 1	
					ЛьготаКод = ""; ИтогПоЛьготам = "";
				КонецЕсли;

				ЗаполнениеСтрокТЧ(Ном,спДанные,
					СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование)+ТекстГТД+ТекстДополненияГр3, //наименование ТМЦ
					буфКодУКТВЭД,
					ЕдИзм,
					КодЕдИзм,
					ПечКво,
					ПечЦенаБезНДС,
					ПечСтавка,
					"",
					ПечСуммаБезНДС,
					"",//ПрИмп,
					"",//буфКодДКПП,
					"");//КодСХ 	
		

				Ном = Ном + 1;
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда   //вернем ставку
					ПечСтавка = ПечСтавка1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	спДанные.Установить("R003G10S", ИтогПоЛьготам);			
    
	Если Ном > 9998 Тогда
		Сообщить("Для экспорта в электронный вид документ должен содержать не более 9999 строк."
		"В данном документе ограничение превышено. Отчет не пройдет проверку по схеме.",
		"!");
	КонецЕсли;
	
КонецПроцедуры
//============================
Процедура Сформировать2011(спДанные = "")
	Перем СтрЦенаБезНДС, ОбщСуммаБезСкидки, ОбщСуммаБезТранс, ОбщВозвТара,
	      ОбщИтогСуммаБезНДС, ОбщИтогНДС, ОбщВсего, Ст[14];
    
	// В FREDO Звіт выгружаются все значения
	Если ПустоеЗначение(мМенеджерЗвит1С)=0 Тогда
		Для Н = 1 По 14 Цикл
			Ст[Н] = 0;
		КонецЦикла;
	КонецЕсли;
	 
	Если Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС" Тогда
		ТекущийСтолбец = 10
	ИначеЕсли Сокрлп(стрДокумент.ВидНДС.Код) = "НДС0" Тогда
		Если стрДокумент.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			ТекущийСтолбец = 9
		Иначе
			ТекущийСтолбец = 8
		КонецЕсли;
	ИначеЕсли (Сокрлп(стрДокумент.ВидНДС.Код) = "НДС7") и (ДатаОтчета >= '01.12.2014') Тогда
		ТекущийСтолбец = 12;
	ИначеЕсли (Сокрлп(стрДокумент.ВидНДС.Код) = "НДС7") Тогда
		ТекущийСтолбец = 8;
	Иначе
		ТекущийСтолбец = 7;
		Если стрДокумент.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			НулевойСтолбец = 9
		Иначе
			НулевойСтолбец = 8
		КонецЕсли;
	КонецЕсли;
	    
	ЕстьНулевыеСтавкиНДС = стрДокумент.ЕстьНулевыеСтавкиНДС;
	
	ДопКолонка = ?(ЕстьНулевыеСтавкиНДС = 1, "НулеваяСтавкаНДС,","");
    
	КоэфБезНДС = 100/(100 + глПроцентНДС(стрДокумент.ВидНДС,ДатаОтчета));
	
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	стрДокумент.ВыгрузитьТабличнуюЧасть(ТаблТМЦ);

	Если рОбычная = 1 Тогда
		//Обычная налоговая накладная	
		ТаблТМЦ.Свернуть(ДопКолонка + "ТМЦ,"+
	  			?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
	  			",Ед,Коэффициент,ОперДата,КодУКТВЭД,НомерГТД","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");
  			

		СуммаБезСкидки0 = 0;
		СуммаБезСкидки20 = 0;
		ИтогПоЛьготам = "";
		
		Ном = 1;  
		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если (Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС") Тогда	
				СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ, стрДокумент.ЛьготаНДС,"");
				
				Если ИтогПоЛьготам = "" Тогда
					ИтогПоЛьготам = СтатьяЛьготы;
				ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
					ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
				КонецЕсли;	
			КонецЕсли;	
			Если стрДокумент.Итоговая=1 Тогда
				Ст[1] = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаОтчета);
			Иначе
				Ст[1] = ДатаОтчета;
			КонецЕсли;
			       

			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
			    //по умолчанию дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			
			Ст[2] = СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование)+ТекстГТД;

			Ст[13] = СокрЛП(СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",""));
			Ст[4] = ТаблТМЦ.Кво; 
			Ст[5] = "-";  
			Если (ТаблТМЦ.ТМЦ.Вид() = "ТМЦ")и(ДатаОтчета >= '01/03/2014') Тогда
				Если ТаблТМЦ.ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Услуга Тогда
					Ст[4] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, 0, ТаблТМЦ.Кво); 
					Ст[5] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, ТаблТМЦ.ТМЦ.КвоДляНН, "-");  
				КонецЕсли;
			КонецЕсли;
			Ст[11] = 0;
			            
			Если ТаблТМЦ.Скидка<>0 Тогда
				ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезНДС;
				ТекЦенаБезНДС     = ТаблТМЦ.СуммаБезНДС/ (ТаблТМЦ.Кво*ТаблТМЦ.Коэффициент);
			Иначе
				Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда 
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезСкидки*?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
						ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * ?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
					Иначе
						ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезСкидки*КоэфБезНДС;
						ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС; 
					КонецЕсли;
				Иначе
					ТекСуммаБезСкидки = ТаблТМЦ.СуммаБезСкидки;
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
				КонецЕсли;
			КонецЕсли;
			
			Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
				Ст[3] = ТаблТМЦ.Ед.Единица;
				Ст[14] = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
				Ст[6] = СуммаДляЭкспорта(ТекЦенаБезНДС);
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
						Ст[ТекущийСтолбец] = 0;
						Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						Ст[НулевойСтолбец] = 0;
						
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
				Иначе
					Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
					
					СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
				КонецЕсли;
				ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
				Ном = Ном + 1;
				//"РазделI2"
			Иначе
				Ст[3] = ?(ДатаОтчета >= '01/01/2015', "шт", ТаблТМЦ.ТМЦ.БазЕдиница);
				Ст[14] = "2009";
				Ст[6] = СуммаДляЭкспорта(ТекЦенаБезНДС);
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
						Ст[ТекущийСтолбец] = 0;
						Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						Ст[НулевойСтолбец] = 0; 
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
				Иначе
					Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки); 
					СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
				КонецЕсли;
				ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
				Ном = Ном + 1;
				//"РазделI2"
			КонецЕсли;
			Если (ТекЦенаБезНДС < 0) Тогда
				Предупреждение("В строке " + (Ном-1) + " табличной части отрицательная сумма. Документ не пройдет проверку по схеме.");
			КонецЕсли;
			Если (ПустоеЗначение(мМенеджерЗвит1С) = 0) Тогда 
				//Для Звит дополнительный показатель 
				RGRATE = "";
				Если ТекущийСтолбец = 7 Тогда
				    RGRATE= "20%";
				ИначеЕсли ТекущийСтолбец = 12 Тогда
				    RGRATE= "7%";
				ИначеЕсли ТекущийСтолбец = 8 Тогда
				    RGRATE= "0%";
				ИначеЕсли ТекущийСтолбец = 10 Тогда
				    RGRATE= "б/пдв";
				ИначеЕсли ТекущийСтолбец = 9 Тогда
				    RGRATE= "експ.";
				КонецЕсли;
				спДанные.ДобавитьЗначение(RGRATE,  "RGRATE" + Формат(Ном-1, "Ч(0)4"));
			КонецЕсли;	
		КонецЦикла;
		
		СуммаБезТранс = СуммаБезСкидки20 + СуммаБезСкидки0;
		ОбщСуммаБезТранс = СуммаДляЭкспорта(СуммаБезТранс);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаБезТранс - СуммаБезСкидки0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаБезСкидки0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщСуммаБезТранс;
		КонецЕсли;
		//"РазделIВсего"
		Ст[11] = ОбщСуммаБезТранс;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 1, 7, "Ч(0)2");      
		
		ОбщВозвТара = СуммаДляЭкспорта(стрДокумент.СуммаВозвратнойТары);
		//"ВозврТара"
		Ст[11] = ОбщВозвТара;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 2, 11, "Ч(0)2");
		
		Если ПустоеЗначение(мМенеджерЗвит1С)=0 Тогда
			// Для FREDO Звіт очистка должна выполняться нулями (число)
			Для Н = 1 По 12 Цикл
				Ст[Н] = 0;
			КонецЦикла;
		Иначе
			Для Н = 1 По 12 Цикл
				Ст[Н] = "";
			КонецЦикла;
		КонецЕсли;
		
		ИтогСуммаБезНДС = стрДокумент.Итог("СуммаБезНДС");
		ОбщИтогСуммаБезНДС = СуммаДляЭкспорта(ИтогСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			ИтогСуммаБезНДС0 = СуммаБезСкидки0;
		КонецЕсли;
		
		ОбщИтогНДС = СуммаДляЭкспорта(стрДокумент.Итог("НДС"));
		R03G10S = "";
		Если (ПустоеЗначение(мМенеджерЗвит1С) = 0) И (СокрЛП(стрДокумент.ВидНДС.Код) = "НДС0") Тогда
			// Для FREDO Звіт как в печатной форме
			// согласно п.11 порядка заполнения НН
			Ст[8] = "0.00";
			Ст[9] = "0.00";
		ИначеЕсли Сокрлп(стрДокумент.ВидНДС.Код) = "НДС7" Тогда
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
		ИначеЕсли ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
			Ст[НулевойСтолбец] = 0;
		ИначеЕсли Найти("8,9", ТекущийСтолбец) > 0 Тогда
			Ст[ТекущийСтолбец] = 0;
		ИначеЕсли (ТекущийСтолбец = 10) и ((ДатаОтчета < '01.12.2014')или(ДатаОтчета >= '01.01.2015')) Тогда
			R03G10S = "Без ПДВ";
		Иначе
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
		КонецЕсли;
		//"НДС"
		Ст[11] = ОбщИтогНДС;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 3, 7, "Ч(0)2");
		
		ИтогСуммаСНДС = стрДокумент.Итог("СуммаСНДС");
		ОбщВсего = СуммаДляЭкспорта(ИтогСуммаСНДС + стрДокумент.СуммаВозвратнойТары);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаСНДС);
		КонецЕсли;
		//"ОбщаяСумма"
		Ст[11] = ОбщВсего;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 4, 7, "Ч(0)2");
		
	Иначе //рОбычная = 0
		//налоговая накладная на превышение цен
		
		ИтогПоЛьготам = "";
		
		Если (ДатаОтчета >= '01/01/2015') Тогда  
			ТекстДополненияГр3 = " (" + СокрЛП(стрДокумент.ТекстДоп) + " в податковій накладній №" + СокрЛП(стрДокумент.НомерОсновнойНН);
			ТекстДополненияГр3 = ТекстДополненияГр3 + ?((стрДокумент.ОЦВключаетПроценты=1) и (стрДокумент.Итог("СуммаБезНДС") <> 0),", сума процентів, нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
		Иначе		
			ТекстДополненияГр3 = " (перевищення звичайної ціни над фактичною за товарами, послугами, указаними в податковій накладній №"+ Строка(НомерДокумента);
			ТекстДополненияГр3 = ТекстДополненияГр3 + ?(стрДокумент.ОЦВключаетПроценты=1,", сума процентів нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");
		КонецЕсли;
		
		СуммаПревышения0 = 0;
		ТрансСуммаБезНДС = 0;
		ТрансСуммаБезНДС0 = 0;

		Для Н = 1 По 12 Цикл
			Ст[Н] = 0;
		КонецЦикла;                    
		
		ном=1;	        		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если стрДокумент.Итоговая=1 Тогда
				Ст[1] = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаОтчета);
			Иначе
				Ст[1] = ДатаОтчета;
			КонецЕсли;
			ТекстГТД = "";
			Если (НеДополнятьНазваниеНомеромГТД <> Да) и (ПустоеЗначение(ТаблТМЦ.НомерГТД) = 0) Тогда 
			    //по умолчанию дополняем текст ГТД  
				Если ПечататьДатыСРазделителями = Да Тогда
					ДатаГ = ТаблТМЦ.НомерГТД.ДатаГТД;
				Иначе //по умолчанию без разделителей
					ДатаГ = ДатаДляПечати(ТаблТМЦ.НомерГТД.ДатаГТД);
				КонецЕсли; 
				ТекстГТД = ". ВМД №: " + ТаблТМЦ.НомерГТД + ", ВМД дата: " + ДатаГ;  
			КонецЕсли;
			
			Ст[2] = СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование) + ТекстГТД + ТекстДополненияГр3;
			Ст[13] = СокрЛП(СтрЗаменить(ТаблТМЦ.КодУКТВЭД,".",""));
			Ст[4] = ТаблТМЦ.Кво; 
			Ст[5] = "-";  
			Если (ТаблТМЦ.ТМЦ.Вид() = "ТМЦ")и(ДатаОтчета >= '01/03/2014') Тогда
				Если ТаблТМЦ.ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Услуга Тогда
					Ст[4] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, 0, ТаблТМЦ.Кво); 
					Ст[5] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, ТаблТМЦ.ТМЦ.КвоДляНН, "-");  
				КонецЕсли;
			КонецЕсли;
			Ст[6]  = ?((ДатаОтчета < '01/01/2015')или(ТаблТМЦ.Кво=0), "", СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения/ТаблТМЦ.Кво));; 
			Ст[11] = 0;
			Если ТаблТМЦ.СуммаПревышения > 0 Тогда
				Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
					Ст[3]  = ТаблТМЦ.Ед.Единица;
					Ст[14] = ТаблТМЦ.Ед.Единица.КодЕдИзмерения;
					ПечЦенаБезНДС = "";
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = 0;
							Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
							СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
							Ст[НулевойСтолбец] = 0;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения)
					КонецЕсли;
					//"РазделI2"
					ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
					Ном = Ном + 1;
				Иначе
					Ст[3] = ?(ДатаОтчета >= '01/01/2015', "шт", ТаблТМЦ.ТМЦ.БазЕдиница);
					Ст[14] = "2009";
					ПечЦенаБезНДС = "";
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = 0;
							Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
							СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
							Ст[НулевойСтолбец] = 0;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения)
					КонецЕсли;
					//"РазделI2"
					ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
					Ном = Ном + 1;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		СуммаБезТранс = стрДокумент.Итог("СуммаПревышения") - ТрансСуммаБезНДС;
		ОбщСуммаБезТранс = СуммаДляЭкспорта(СуммаБезТранс);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаБезТранс - СуммаПревышения0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаПревышения0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщСуммаБезТранс;
		КонецЕсли;
		//"РазделIВсего"
		Ст[11] = ОбщСуммаБезТранс;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 1, 7, "Ч(0)2");

		ОбщВозвТара = 0;
		//"ВозврТара"
		Ст[11] = ОбщВозвТара;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 2, 11, "Ч(0)2");
			
		Если ПустоеЗначение(мМенеджерЗвит1С)=0 Тогда
			// Для FREDO Звіт очистка должна выполняться нулями (число)
			Для Н = 1 По 12 Цикл
				Ст[Н] = 0;
			КонецЦикла;
		Иначе
			Для Н = 1 По 12 Цикл
				Ст[Н] = "";
			КонецЦикла;
		КонецЕсли;
		
		ИтогСуммаБезНДС = стрДокумент.Итог("СуммаПревышения");
		ОбщИтогСуммаБезНДС = СуммаДляЭкспорта(ИтогСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			ИтогСуммаБезНДС0 = СуммаПревышения0;
		КонецЕсли;
		
		ИтогНДС = стрДокумент.Итог("НДСПревышения");
		ОбщИтогНДС = СуммаДляЭкспорта(ИтогНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
			Ст[НулевойСтолбец] = 0;
		Иначе
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
		КонецЕсли;
		//"НДС"
		Ст[11] = ОбщИтогНДС;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 3, 7, "Ч(0)2");
			
		ИтогСуммаСНДС = ИтогСуммаБезНДС + ИтогНДС;
		ОбщВсего = СуммаДляЭкспорта(ИтогСуммаСНДС);
		Если (ПустоеЗначение(мМенеджерЗвит1С) = 0) И (СокрЛП(стрДокумент.ВидНДС.Код) = "НДС0") Тогда
			// Для FREDO Звіт как в печатной форме
			// согласно п.11 порядка заполнения НН
			Ст[8] = 0;
			Ст[9] = 0;
		ИначеЕсли ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС0);
		ИначеЕсли (ТекущийСтолбец = 10) Тогда
			R03G10S = "Без ПДВ";
		Иначе
			Ст[ТекущийСтолбец] = ОбщВсего;
		КонецЕсли;
		//"ОбщаяСумма"
		Ст[11] = ОбщВсего;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 4, 7, "Ч(0)2");
		
	КонецЕсли;	
	
	спДанные.Установить("R003G10S", ИтогПоЛьготам);			
	спДанные.Установить("R03G10S", R03G10S);			
    
	Если Ном > 9998 Тогда
		Сообщить("Для экспорта в электронный вид документ должен содержать не более 9999 строк."
		"В данном документе ограничение превышено. Отчет не пройдет проверку по схеме.",
		"!");
	КонецЕсли;
	
КонецПроцедуры

// ===============================                                     
Процедура Сформировать(спДанные = "")
Перем СтрЦенаБезНДС, ОбщСуммаБезСкидки, ОбщСуммаБезТранс, ОбщСуммаТранс, ОбщВозвТара;
Перем ОбщСуммаНадбавки, ОбщСуммаСкидки, ОбщИтогСуммаБезНДС, ОбщИтогНДС; 
Перем ОбщВсего, Ст[11];  
	
	Если Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС" Тогда
		ТекущийСтолбец = 10
	ИначеЕсли Сокрлп(стрДокумент.ВидНДС.Код) = "НДС0" Тогда
		Если стрДокумент.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			ТекущийСтолбец = 9
		Иначе
			ТекущийСтолбец = 8
		КонецЕсли;
	Иначе
		ТекущийСтолбец = 7;
		Если стрДокумент.ВидОперации = Перечисление.ВидыОперацийНалоговойНакладной.Экспорт Тогда
			НулевойСтолбец = 9
		Иначе
			НулевойСтолбец = 8
		КонецЕсли;
	КонецЕсли;
	ЕстьНулевыеСтавкиНДС = стрДокумент.ЕстьНулевыеСтавкиНДС;
	
	ДопКолонка = ?(ЕстьНулевыеСтавкиНДС = 1, "НулеваяСтавкаНДС,","");
	КоэфБезНДС = 100/(100 + глПроцентНДС(стрДокумент.ВидНДС,ДатаОтчета));
    
	ТаблТМЦ = СоздатьОбъект("ТаблицаЗначений");
	стрДокумент.ВыгрузитьТабличнуюЧасть(ТаблТМЦ);
	
	Если рОбычная = 1 Тогда
		//Обычная налоговая накладная	
		ТаблТМЦ.Свернуть(ДопКолонка + "ТМЦ,"+
				?(Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС,"ЦенаСНДС","ЦенаБезНДС")+
				",Ед,Коэффициент,ОперДата","Кво,СуммаБезСкидки,Скидка,СуммаБезНДС,НДС,СуммаСНДС");
		
		СуммаБезСкидки0 = 0;
		СуммаНадбавки = 0;
		СуммаСкидки = 0;
		СуммаНадбавки0 = 0;
		СуммаСкидки0 = 0;
		ТрансСуммаБезНДС = 0;
		ТрансСуммаБезНДС0 = 0;
		ИтогПоЛьготам = "";   
		Ном = 1;
			
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если (Сокрлп(стрДокумент.ВидНДС.Код) = "БезНДС") Тогда	
				СтатьяЛьготы = ПолучитьЛьготу(ТаблТМЦ.ТМЦ, стрДокумент.ЛьготаНДС,"");
				
				Если ИтогПоЛьготам = "" Тогда
					ИтогПоЛьготам = СтатьяЛьготы;
				ИначеЕсли Найти(ИтогПоЛьготам, СтатьяЛьготы) = 0 Тогда
					ИтогПоЛьготам = СокрЛП(ИтогПоЛьготам) + ", " + СтатьяЛьготы;
				КонецЕсли;	
			КонецЕсли;	
			Если стрДокумент.Итоговая=1 Тогда
				Ст[1] = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаОтчета);
			Иначе
				Ст[1] = ДатаОтчета;
			КонецЕсли;           
			Ст[2] = СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование);
			Ст[3] = ТаблТМЦ.Ед; 
			Если ТаблТМЦ.ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Услуга Тогда
				Ст[4] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, 0, ТаблТМЦ.Кво); 
				Ст[5] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, ТаблТМЦ.ТМЦ.КвоДляНН, "-");  
			Иначе
				Ст[4] = ТаблТМЦ.Кво; 
				Ст[5] = "-";  
			КонецЕсли;
			
			Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда 
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки*?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС),ТаблТМЦ.СуммаБезНДС);
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * ?(ТаблТМЦ.НулеваяСтавкаНДС = Да, 1, КоэфБезНДС);
				Иначе
					ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки*КоэфБезНДС,ТаблТМЦ.СуммаБезНДС);
					ТекЦенаБезНДС     = ТаблТМЦ.ЦенаСНДС * КоэфБезНДС; 
				КонецЕсли;
			Иначе
				ТекСуммаБезСкидки = ?(ТаблТМЦ.Скидка<>0,ТаблТМЦ.СуммаБезСкидки,ТаблТМЦ.СуммаБезНДС);
				ТекЦенаБезНДС     = ТаблТМЦ.ЦенаБезНДС;
			КонецЕсли;
			Ст[11] = 0;

			Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
				Если ТаблТМЦ.ТМЦ.Транспорт = 0 Тогда
					Ст[3] = ТаблТМЦ.Ед;
					Ст[6] = СуммаДляЭкспорта(ТекЦенаБезНДС);
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = 0;
							Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
							ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки0, СуммаНадбавки0);
							СуммаБезСкидки0 = СуммаБезСкидки0 + ТаблТМЦ.СуммаБезСкидки;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
							Ст[НулевойСтолбец] = 0;
							
							СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
					ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки, СуммаНадбавки);
					ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
					Ном = Ном + 1;
				Иначе
					ТрансСуммаБезНДС = ТрансСуммаБезНДС + ТаблТМЦ.СуммаБезСкидки; 
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							ТрансСуммаБезНДС0 = ТрансСуммаБезНДС0 + ТаблТМЦ.СуммаБезНДС; 
							ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки0, СуммаНадбавки0);
						КонецЕсли;
					Иначе
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
					ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки, СуммаНадбавки);
				КонецЕсли;
			Иначе
				Ст[3] = ТаблТМЦ.ТМЦ.БазЕдиница;
				Ст[6] =СуммаДляЭкспорта(ТекЦенаБезНДС);
				Если ЕстьНулевыеСтавкиНДС = 1 Тогда
					Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
						Ст[ТекущийСтолбец] = 0;
						Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки0, СуммаНадбавки0);
						СуммаБезСкидки0 = СуммаБезСкидки0 + ТекСуммаБезСкидки;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
						Ст[НулевойСтолбец] = 0;
						СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
					КонецЕсли;
				Иначе
					Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТекСуммаБезСкидки);
					СуммаБезСкидки20 = СуммаБезСкидки20 + ТекСуммаБезСкидки;
				КонецЕсли;
				ЗаполнитьСкидкуНадбавку(ТаблТМЦ.Скидка, СуммаСкидки, СуммаНадбавки);
				ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
				Ном = Ном + 1;
			КонецЕсли; 
		КонецЦикла;
		
		//итоги по разделу I	
		СуммаБезТранс = СуммаБезСкидки20  + СуммаБезСкидки0- ТрансСуммаБезНДС;
		ОбщСуммаБезТранс = СуммаДляЭкспорта(СуммаБезТранс);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаБезТранс - СуммаБезСкидки0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаБезСкидки0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщСуммаБезТранс;
		КонецЕсли;
		Ст[11] = ОбщСуммаБезТранс;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 1000, 7);      

		//Товаро-транспортные затраты, раздел II
		ОбщСуммаТранс = СуммаДляЭкспорта(ТрансСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТрансСуммаБезНДС - ТрансСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТрансСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщСуммаТранс;
		КонецЕсли;
		Ст[11] = ОбщСуммаТранс;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 2000, 7);      
		
		//Возвратная тара, раздел III
		Ст[11] = СуммаДляЭкспорта(стрДокумент.СуммаВозвратнойТары);
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 3000, 11);      
		
		Для Н = 1 По 11 Цикл
			Ст[Н] = 0;
		КонецЦикла;
		
		//Предоставлено покупателю, раздел IV
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			ОбщСуммаНадбавки = СуммаДляЭкспорта((СуммаНадбавки - СуммаНадбавки0) * КоэфБезНДС + СуммаНадбавки0);
			ОбщСуммаСкидки   = СуммаДляЭкспорта((СуммаСкидки - СуммаСкидки0) * КоэфБезНДС + СуммаСкидки0);
		Иначе			
			ОбщСуммаНадбавки = СуммаДляЭкспорта(СуммаНадбавки + СуммаНадбавки0);
			ОбщСуммаСкидки   = СуммаДляЭкспорта(СуммаСкидки + СуммаСкидки0);
		КонецЕсли;

		//надбавка
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта((СуммаНадбавки - СуммаНадбавки0) * КоэфБезНДС);
				Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаНадбавки0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаНадбавки * КоэфБезНДС);
			КонецЕсли;   
		Иначе
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаНадбавки - СуммаНадбавки0);
				Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаНадбавки0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаНадбавки);
			КонецЕсли;	
		КонецЕсли;	
		Ст[11] = ОбщСуммаНадбавки;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 4100, 7);

		//скидка
		Если Константа.ОсновнаяЦена = Перечисление.ВидыЦенВДокументах.ЦенаСНДС Тогда
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта((СуммаСкидки - СуммаСкидки0) * КоэфБезНДС);
				Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаСкидки0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаСкидки * КоэфБезНДС);
			КонецЕсли;
		Иначе
			Если ЕстьНулевыеСтавкиНДС = 1 Тогда
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаСкидки - СуммаСкидки0);
				Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаСкидки0);
			Иначе
				Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаСкидки);
			КонецЕсли;	
		КонецЕсли;	
		Ст[11] = ОбщСуммаСкидки;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 4200, 7);
		
		//Всего по разделам I_II_IV, раздел V
		ИтогСуммаБезНДС = стрДокумент.Итог("СуммаБезНДС");
		ОбщИтогСуммаБезНДС = СуммаДляЭкспорта(ИтогСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			ИтогСуммаБезНДС0 = СуммаБезСкидки0 + ТрансСуммаБезНДС0 + СуммаНадбавки0 - СуммаСкидки0;
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщИтогСуммаБезНДС;
		КонецЕсли;   
		Ст[11] =ОбщИтогСуммаБезНДС;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 5000, 7);

		//НДС 
		ОбщИтогНДС = СуммаДляЭкспорта(стрДокумент.Итог("НДС"));
		
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
			Ст[НулевойСтолбец] = 0;
		ИначеЕсли Найти("8,9", ТекущийСтолбец) > 0 Тогда
			Ст[ТекущийСтолбец] = 0;
		ИначеЕсли ТекущийСтолбец = 10 Тогда   
			//в схеме для физ.лица этот показатель - символьный, для юр.лица - числовой. 
			//Ст[ТекущийСтолбец] = "Без ПДВ " + ИтогПоЛьготам;
			Ст[ТекущийСтолбец] = 0;
		Иначе
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
		КонецЕсли;
		Ст[11] = ОбщИтогНДС;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 5100, 7);

		//Общая сумма с НДС, раздел VII
		ИтогСуммаСНДС = стрДокумент.Итог("СуммаСНДС");
		Всего = СуммаДляЭкспорта(ИтогСуммаСНДС + стрДокумент.СуммаВозвратнойТары);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаСНДС);
		КонецЕсли;
		Ст[11] = Всего;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 6000, 7);
	Иначе
		//налоговая накладная на превышение цен
		ИтогПоЛьготам = "";
		
		ТекстДополненияГр3 = " (перевищення звичайної ціни над фактичною за товарами, послугами, указаними в податковій накладній №"+ НомерДокумента;
		ТекстДополненияГр3 = ТекстДополненияГр3 + ?(стрДокумент.ОЦВключаетПроценты=1,", сума процентів нарахованих або таких, що мають бути нараховані на суму номіналу процентного векселя)",")");

		СуммаПревышения0 = 0;
		ТрансСуммаБезНДС = 0;
		ТрансСуммаБезНДС0 = 0;
		Ном = 1;
		
		Для Н = 1 По 11 Цикл
			Ст[Н] = 0;
		КонецЦикла;                    
		
		ТаблТМЦ.ВыбратьСтроки();
		Пока ТаблТМЦ.ПолучитьСтроку() > 0 Цикл
			Если стрДокумент.Итоговая=1 Тогда
				Ст[1] = ?(ПустоеЗначение(ТаблТМЦ.ОперДата)=0, ТаблТМЦ.ОперДата, ДатаОтчета);
			Иначе
				Ст[1] = ДатаОтчета;
			КонецЕсли;
			Ст[2] = СокрЛП(ТаблТМЦ.ТМЦ.ПолнНаименование) + ТекстДополненияГр3;
			Если ТаблТМЦ.ТМЦ.ВидТМЦ = Перечисление.ВидыТМЦ.Услуга Тогда
				Ст[4] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, 0, ТаблТМЦ.Кво); 
				Ст[5] = ?(ПустоеЗначение(ТаблТМЦ.ТМЦ.КвоДляНН) = 0, ТаблТМЦ.ТМЦ.КвоДляНН, "-");  
			Иначе
				Ст[4] = ТаблТМЦ.Кво; 
				Ст[5] = "-";  
			КонецЕсли;
			Ст[6]  = "0.0000"; 
			Ст[11] = 0;
			Если ТаблТМЦ.СуммаПревышения > 0 Тогда
				Если ТаблТМЦ.ТМЦ.Вид() = "ТМЦ" Тогда
					Если ТаблТМЦ.ТМЦ.Транспорт = 0 Тогда
						Ст[3] = ТаблТМЦ.Ед;
						Если ЕстьНулевыеСтавкиНДС = 1 Тогда
							Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
								Ст[ТекущийСтолбец] = 0;
								Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
								СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
							Иначе
								Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
								Ст[НулевойСтолбец] = 0;
							КонецЕсли;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения)
						КонецЕсли;
						ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
						Ном = Ном + 1;
					Иначе
						ТрансСуммаБезНДС = ТрансСуммаБезНДС + ТаблТМЦ.СуммаПревышения; 
						Если ЕстьНулевыеСтавкиНДС = 1 Тогда
							Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
								ТрансСуммаБезНДС0 = ТрансСуммаБезНДС0 + ТаблТМЦ.СуммаПревышения; 
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				Иначе
					Ст[3] = ТаблТМЦ.ТМЦ.БазЕдиница;
					Если ЕстьНулевыеСтавкиНДС = 1 Тогда
						Если ТаблТМЦ.НулеваяСтавкаНДС = Да Тогда
							Ст[ТекущийСтолбец] = 0;
							Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
							СуммаПревышения0 = СуммаПревышения0 + ТаблТМЦ.СуммаПревышения;
						Иначе
							Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения);
							Ст[НулевойСтолбец] = 0;
						КонецЕсли;
					Иначе
						Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТаблТМЦ.СуммаПревышения)
					КонецЕсли;
					ЗаполнитьРеквизитыСтроки(спДанные, Ст, Ном, 1);      
					Ном = Ном + 1;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
			
		//итоги по разделу I	
		СуммаБезТранс =  стрДокумент.Итог("СуммаПревышения") - ТрансСуммаБезНДС;
		ОбщСуммаБезТранс = СуммаДляЭкспорта(СуммаБезТранс);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(СуммаБезТранс - СуммаПревышения0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(СуммаПревышения0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщСуммаБезТранс;
		КонецЕсли;
		Ст[11] = ОбщСуммаБезТранс;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 1000, 7);      
		
		//Товаро-транспортные затраты, раздел II
		ОбщСуммаТранс = СуммаДляЭкспорта(ТрансСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ТрансСуммаБезНДС - ТрансСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ТрансСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщСуммаТранс;
		КонецЕсли;
		Ст[11] = ОбщСуммаТранс;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 2000, 7);      
		
		Для Н = 1 По 11 Цикл
			Ст[Н] = "";
		КонецЦикла;
		
		//Всего по разделам I_II_IV, раздел V
		ИтогСуммаБезНДС =  стрДокумент.Итог("СуммаПревышения");
		ОбщИтогСуммаБезНДС = СуммаДляЭкспорта(ИтогСуммаБезНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			ИтогСуммаБезНДС0 = СуммаПревышения0 + ТрансСуммаБезНДС0;
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = ОбщИтогСуммаБезНДС;
		КонецЕсли;
		Ст[11] =ОбщИтогСуммаБезНДС;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 5000, 7);
		
		//НДС
		ИтогНДС =  стрДокумент.Итог("НДСПревышения");
		ОбщИтогНДС = СуммаДляЭкспорта(ИтогНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
			Ст[НулевойСтолбец] = 0;
		Иначе
			Ст[ТекущийСтолбец] = ОбщИтогНДС;
		КонецЕсли;
		Ст[11] = ОбщИтогНДС;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 5100, 7);
		
		//Общая сумма с НДС, раздел VII
		ИтогСуммаСНДС = ИтогСуммаБезНДС + ИтогНДС;
		Всего = СуммаДляЭкспорта(ИтогСуммаСНДС);
		Если ЕстьНулевыеСтавкиНДС = 1 Тогда
			Ст[ТекущийСтолбец] = СуммаДляЭкспорта(ИтогСуммаСНДС - ИтогСуммаБезНДС0);
			Ст[НулевойСтолбец] = СуммаДляЭкспорта(ИтогСуммаБезНДС0);
		Иначе
			Ст[ТекущийСтолбец] = Всего;
		КонецЕсли;
		Ст[11] = Всего;
		ЗаполнитьРеквизитыСтроки(спДанные, Ст, 6000, 7);
	
	КонецЕсли;	
    
КонецПроцедуры

//===========================================
Функция СоздатьТаблицуСоСхемамиВыгрузки()
	
	ПоследняяАктуальная = 0;
	Если ПустоеЗначение(мМенеджерЗвит1С) = 0 Тогда
		Если ПустоеЗначение(мМенеджерЗвит1С.Получить("ПоследняяАктуальная")) = 0 Тогда
			ПоследняяАктуальная = мМенеджерЗвит1С.Получить("ПоследняяАктуальная");
		КонецЕсли;
	КонецЕсли;
	
	тбСхемыXML = СоздатьОбъект("ТаблицаЗначений");
	тбСхемыXML.НоваяКолонка("ИмяСхемы","Строка",8,,"Имя файла-схемы");
	тбСхемыXML.НоваяКолонка("ПрефиксСхемы","Строка");
	тбСхемыXML.НоваяКолонка("ПредставлениеСхемы","Строка", 80,," Наименование регл. отчета");
	тбСхемыXML.НоваяКолонка("фВыгрузка","Число", 1,0,"Выгружать?", 8);
		
	тбСхемыXML.НоваяСтрока();
	Если ВидДокумента = "НалоговаяНакладная" Тогда    
		Если Фирма.ЧастноеЛицо = 1 Тогда
            Если (ДатаОтчета >= '01/03/2017') ИЛИ (ПоследняяАктуальная = 1)  или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016'))  Тогда
				тбСхемыXML.ИмяСхемы = "F1201009";
            ИначеЕсли (ДатаОтчета >= '01/04/2016') Тогда
				тбСхемыXML.ИмяСхемы = "F1201008";
            ИначеЕсли (ДатаОтчета >= '01/01/2015') Тогда
				тбСхемыXML.ИмяСхемы = "F1201007";
            ИначеЕсли (ДатаОтчета >= '01/12/2014') Тогда
				тбСхемыXML.ИмяСхемы = "F1201006";
            ИначеЕсли (ДатаОтчета >= '01/03/2014') Тогда
				тбСхемыXML.ИмяСхемы = "F1201005";
			ИначеЕсли (ДатаОтчета >= Константа.ДатаННДек2011) Тогда				
				тбСхемыXML.ИмяСхемы = "F1201004";
			ИначеЕсли ДатаОтчета >= '10.01.2011'  Тогда
				тбСхемыXML.ИмяСхемы = "F1201003";
			Иначе
				тбСхемыXML.ИмяСхемы = "F1201002";
			КонецЕсли;	
		Иначе	
            Если (ДатаОтчета >= '01/03/2017') ИЛИ (ПоследняяАктуальная = 1)  или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016'))  Тогда
				тбСхемыXML.ИмяСхемы = "J1201009";
            ИначеЕсли (ДатаОтчета >= '01/04/2016') Тогда
				тбСхемыXML.ИмяСхемы = "J1201008";
            ИначеЕсли (ДатаОтчета >= '01/01/2015') Тогда
				тбСхемыXML.ИмяСхемы = "J1201007";
            ИначеЕсли (ДатаОтчета >= '01/12/2014') Тогда
				тбСхемыXML.ИмяСхемы = "J1201006";
			ИначеЕсли (ДатаОтчета >= '01/03/2014') Тогда
				тбСхемыXML.ИмяСхемы = "J1201005";
            ИначеЕсли (ДатаОтчета >= Константа.ДатаННДек2011) Тогда
				тбСхемыXML.ИмяСхемы = "J1201004";
			ИначеЕсли ДатаОтчета >= '10.01.2011'  Тогда
				тбСхемыXML.ИмяСхемы = "J1201003";
			Иначе
				тбСхемыXML.ИмяСхемы = "J1201002";
			КонецЕсли;	
		КонецЕсли;
		тбСхемыXML.ПредставлениеСхемы = "Налоговая накладная";
	Иначе
		Если (Фирма.ЧастноеЛицо = 1) и ((ДатаОтчета >= Константа.ДатаННДек2011) ИЛИ (ПоследняяАктуальная = 1)) Тогда
            Если (ДатаОтчета >= '01/03/2017') ИЛИ (ПоследняяАктуальная = 1)  или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016'))  Тогда
				тбСхемыXML.ИмяСхемы = "F1201209";
            ИначеЕсли (ДатаОтчета >= '01/04/2016') Тогда
				тбСхемыXML.ИмяСхемы = "F1201208";
            ИначеЕсли (ДатаОтчета >= '01/01/2015') Тогда
				тбСхемыXML.ИмяСхемы = "F1201207";
            ИначеЕсли (ДатаОтчета >= '01/12/2014') Тогда
				тбСхемыXML.ИмяСхемы = "F1201206"; 
			ИначеЕсли (ДатаОтчета >= '01/03/2014') Тогда
				тбСхемыXML.ИмяСхемы = "F1201205"; 
			Иначе
				тбСхемыXML.ИмяСхемы = "F1201204"; 
			КонецЕсли;
        ИначеЕсли (ДатаОтчета >= '01/03/2017') ИЛИ (ПоследняяАктуальная = 1)  или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016'))  Тогда
			тбСхемыXML.ИмяСхемы = "J1201209";
		ИначеЕсли (ДатаОтчета >= '01/04/2016') Тогда
			тбСхемыXML.ИмяСхемы = "J1201208";
		ИначеЕсли (ДатаОтчета >= '01/01/2015') Тогда
			тбСхемыXML.ИмяСхемы = "J1201207";
		ИначеЕсли (ДатаОтчета >= '01/12/2014') Тогда
			тбСхемыXML.ИмяСхемы = "J1201206";
		ИначеЕсли (ДатаОтчета >= '01/03/2014') Тогда
			тбСхемыXML.ИмяСхемы = "J1201205";
		ИначеЕсли (ДатаОтчета >= Константа.ДатаННДек2011) Тогда
			тбСхемыXML.ИмяСхемы = "J1201204";
		ИначеЕсли ДатаОтчета >= '10.01.2011'  Тогда
			тбСхемыXML.ИмяСхемы = "J1201203";
		Иначе
			тбСхемыXML.ИмяСхемы = "J1201202";
		КонецЕсли;	
		тбСхемыXML.ПредставлениеСхемы = "Приложение 2";
	КонецЕсли;
	тбСхемыXML.ПрефиксСхемы       = "";
	тбСхемыXML.фВыгрузка          = 1;

	Возврат тбСхемыXML;
	
КонецФункции

// ===============================
Процедура ПриОткрытии()

	Если ТипЗначенияСтр(Форма.Параметр)<>"СписокЗначений" Тогда
		СтатусВозврата(0);
		Предупреждение("Этот отчет используется другими отчетами и не может использоваться самостоятельно");
		Возврат;
	КонецЕсли;   

	Команда = Форма.Параметр.Получить("Команда"); 
		
	// Это команда от FREDO Звіт
	Если Лев(Команда, 6) = "Звит1С" Тогда
		мМенеджерЗвит1С = Форма.Параметр;
		
		Если (Команда = "Звит1С_СформироватьТаблицуСоСхемамиВыгрузкиВЗвит1С")
		 ИЛИ (Команда = "Звит1С_ЗапросДанных") Тогда
 			// Заполнение произойдет далее
			мМенеджерЗвит1С.Установить("Результат", ПолучитьПустоеЗначение());
 			
		Иначе
			// Неизвестная команда FREDO Звіт
			мМенеджерЗвит1С.Установить("Результат", ПолучитьПустоеЗначение());						
			СтатусВозврата(0);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Форма.ИспользоватьЗакладки(1);
	
	Если (глФлагРасшифровки = 1) ИЛИ (ПустоеЗначение(мМенеджерЗвит1С) = 0) Тогда
		// данные из расшифровки
		Если (ПустоеЗначение(мМенеджерЗвит1С) = 0) Тогда
			стрДокумент	= мМенеджерЗвит1С.Получить("ТекущийДокумент");
		Иначе
			стрДокумент	= глРасшифровка.Получить("ТекущийДокумент"); 
		КонецЕсли;
		ВидДокумента = стрДокумент.Вид();  
		Если ВидДокумента = "НалоговаяНакладная" Тогда
			ИмяДок = "Налоговая накладная № " + Строка(стрДокумент.НомерДок)+ " от " + Строка(стрДокумент.ДатаДок);
			Если (стрДокумент.ПродажаНижеОЦ=1) Тогда
				Если (стрДокумент.ДатаДок >= '01/01/2015') Тогда  
					Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
					Форма.ИспользоватьСлой("Общий,Дополнительный",2);
				ИначеЕсли (стрДокумент.ДатаДок >= '01/12/2014') Тогда	
					Форма.Закладки.ДобавитьЗначение("Основной","Основные");
					Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
					Форма.ИспользоватьСлой("Общий,Основной",2);
				КонецЕсли;
			Иначе
				Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
				Форма.ИспользоватьСлой("Общий,Дополнительный",2);
			КонецЕсли;
			рОбычная = ?((стрДокумент.ДатаДок >= '01/01/2015')и(стрДокумент.ПродажаНижеОЦ=1),2,1);
		ИначеЕсли ВидДокумента = "Приложение2" Тогда
			ИмяДок = "Приложение 2 № " + Строка(стрДокумент.НомерДок)+ " от " + Строка(стрДокумент.ДатаДок);
			Форма.Закладки.ДобавитьЗначение("Дополнительный","Дополнительно");
			Форма.ИспользоватьСлой("Общий,Дополнительный",2);
			рОбычная = 1;
		Иначе
			СтатусВозврата(0);
			Предупреждение("Этот отчет не используется для экспорта документа Приложение 1");
			Возврат;
		КонецЕсли;
	Иначе	
		СтатусВозврата(0);
		Предупреждение("Этот отчет используется другими отчетами и не может использоваться самостоятельно");
		Возврат;
	Конецесли;
	
	Фирма = СтрДокумент.Фирма;
	ДатаОтчета = стрДокумент.ДатаДок;
	НомерДокумента = глНомерБезПрефикса(стрДокумент.НомерДок);
	Форма.тНаПревыш.Видимость(рОбычная-1);
	
	ЗаполнитьРеквизиты();   
	
	Если ПустоеЗначение(мМенеджерЗвит1С) = 0 Тогда
		
		Если Команда = "Звит1С_СформироватьТаблицуСоСхемамиВыгрузкиВЗвит1С" Тогда
			тбСхемыXML = СоздатьТаблицуСоСхемамиВыгрузки();
			мМенеджерЗвит1С.Установить("Результат", тбСхемыXML);			
		
		ИначеЕсли Команда = "Звит1С_ЗапросДанных" Тогда
			// "Результат" устанавливаниется в функции Экспортировать(...)
			Экспортировать();
		КонецЕсли;
		
		СтатусВозврата(0);
		
	КонецЕсли;

КонецПроцедуры 

// ===============================
Процедура ПриВыбореЗакладки(Номер,Значение)
	Форма.ИспользоватьСлой("Общий,"+Значение,2);
КонецПроцедуры
// ===============================
Процедура Экспортировать()
	спДанные = СоздатьОбъект("СписокЗначений");
	
	//Необходимо найти внешнюю обработку для экспорта в XML
	Если ПустоеЗначение(мМенеджерЗвит1С) = 1 Тогда
		Каталог = КаталогИБ()+"ExtForms\";
		ТекДата    = ТекущаяДата();
		ТекКвартал = ДатаМесяц(КонКвартала(ТекДата))/3;
		ТекГод     = ДатаГод(ТекДата) - 2000;
		ОбработкаНайдена = 0;
		Пока ТекГод >= 6 Цикл
			Пока ТекКвартал >= 1 Цикл
				Если (ТекГод = 6) и (ТекКвартал = 3) Тогда
					Прервать;
				КонецЕсли;
				ИмяФайлаОбработки = Каталог + "Rp" + Формат(ТекГод, "Ч(0)2") 
				+ "q" + ТекКвартал + ".grp\xmlExprt.ert";
				Если ФС.СуществуетФайл(ИмяФайлаОбработки) = 1  Тогда
					ОбработкаНайдена = 1;
					Прервать
				КонецЕсли;
				ТекКвартал  = ТекКвартал - 1;
			КонецЦикла;
			Если ОбработкаНайдена = 1 Тогда
				Прервать
			КонецЕсли;
			ТекКвартал = 4;
			ТекГод     = ТекГод - 1;
		КонецЦикла;
		
		Если ОбработкаНайдена = 0 Тогда
			Сообщить("Для выполнения экспорта в электронный вид необходимы регламентированные отчеты"
			         "версии не ранее 4-го квартала 2009 года, а они не найдены в каталоге ""ExtForms"","
			         "или там отсутствует обработка ""xmlExprt.ert.""", "!");
			Сообщить("Экспорт в электронный вид невозможен!", "!!!");	 
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	Если (ДатаОтчета >= '01.04.2016') или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016'))  Тогда
		ВыгрузитьРеквизиты2016(спДанные);   
	Иначе	
		ВыгрузитьРеквизиты(спДанные);   
	КонецЕсли;
	Если ПустоеЗначение(спДанные) = 1 Тогда
	    // ошибка при выгрузке
		Возврат;
	КонецЕсли;

	НеДополнятьНазваниеНомеромГТД = Да; 
	Если ДатаОтчета >= '01/03/2014' Тогда
		ПечататьДатыСРазделителями = Нет;
	ИначеЕсли ДатаОтчета >= Константа.ДатаННДек2011 Тогда
		ПечататьДатыСРазделителями = Константа.ПечататьДатыВННСРазд;
		НеДополнятьНазваниеНомеромГТД = Константа.НеДополнНаимНомГТДВНН; 
	Иначе	
		ПечататьДатыСРазделителями = Да;
	КонецЕсли;
	Если ВидДокумента = "НалоговаяНакладная" Тогда
		Если (ДатаОтчета >= '01.04.2016') или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016')) Тогда
			Сформировать2016(спДанные);
		ИначеЕсли ДатаОтчета >= '10.01.2011'  Тогда
			Сформировать2011(спДанные);
		Иначе
			Сформировать(спДанные);
		КонецЕсли;	
	Иначе	   
		Если (ДатаОтчета >= '01.04.2016') или ((Константа.ПечататьННПоФормеНаДатуДокумента = Нет) и (РабочаяДата()>='01.04.2016')) Тогда
			СформироватьПриложение2016(спДанные);
		ИначеЕсли ДатаОтчета >= '10.01.2011'  Тогда
			СформироватьПриложение2011(спДанные);
		Иначе
			СформироватьПриложение(спДанные);
		КонецЕсли;	
	КонецЕсли;
	
	СписокЭкспорта = СоздатьОбъект("СписокЗначений");
	СписокЭкспорта.ДобавитьЗначение("ЭкспортXML", "Команда");
	СписокЭкспорта.ДобавитьЗначение(спДанные,     "Данные");
	КаталогДанныхФирмы = Фирма.Наименование;
	СписокЭкспорта.ДобавитьЗначение(КаталогДанныхФирмы, "КаталогДанныхФирмы");
	
		
	Если ПустоеЗначение(мМенеджерЗвит1С) = 1 Тогда
		тбСхемыXML = СоздатьТаблицуСоСхемамиВыгрузки();
			
		СписокЭкспорта.ДобавитьЗначение(тбСхемыXML, "Схемы");
		ОткрытьФорму("Отчет", СписокЭкспорта, ИмяФайлаОбработки);
	Иначе
		мМенеджерЗвит1С.Установить("Результат", спДанные);
	КонецЕсли;
	//Иначе
	//	Сообщить("Для экспорта в электронный вид отчет должен содержать не более 9999 строк."
	//			"В данном отчете ограничение превышено."
	//			"Сформируйте несколько отчетов с интервальным разбиением по периоду."
	//			"При экспорте в электронный вид, в форме обработки, которая открывается для экспорта,"
	//			"присвойте отчетам порядковые номера в поле ""Номер документа в периоде""",
	//			"!");
	//КонецЕсли;
КонецПроцедуры


