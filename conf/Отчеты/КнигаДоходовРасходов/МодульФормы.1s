// ===============================
// ПРОЦЕДУРЫ И ФУНКЦИИ, ВЫЗЫВАЕМЫЕ ИЗ ФОРМУЛ ЭЛЕМЕНТОВ ДИАЛОГА
// ===============================

// ===============================
Процедура Сформировать2012()

	ГруппаЕН = Фирма.ГруппаЕдиногоНалога;

	Таб = СоздатьОбъект("Таблица");
	Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда
		Таб.ИсходнаяТаблица("Таблица3");
	Иначе	
		Таб.ИсходнаяТаблица("Таблица12");
	КонецЕсли;
	Таб.ВывестиСекцию("Шапка");
	Таб.НоваяСтраница();
	
	Если ПоВсемРС = 1 Тогда //выбираем все счета
		Спр = СоздатьОбъект("Справочник.НашиДенежныеСчета");
		Спр.ВыбратьЭлементы(); 
	Иначе
		РС = РСчет;
	КонецЕсли;
	
	Таб.ВывестиСекцию("ШапкаДоход");
	
	тбДок = СоздатьОбъект("ТаблицаЗначений");
	тбДок.НоваяКолонка("Док","Документ");
	тбДок.НоваяКолонка("ДатаДок","Дата");
	тбДок.НоваяКолонка("Ст2","Число",12,2);
	тбДок.НоваяКолонка("Ст3","Число",12,2);
	тбДок.НоваяКолонка("Ст5","Число",12,2);
	тбДок.НоваяКолонка("Ст6","Число",12,2);
	тбДок.НоваяКолонка("Ст9","Число",12,2);

	Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда
		тбДокРасх = СоздатьОбъект("ТаблицаЗначений");
		тбДокРасх.НоваяКолонка("Док","Документ");
		тбДокРасх.НоваяКолонка("ДатаДок","Дата");
		тбДокРасх.НоваяКолонка("Ст3","Число",12,2);
		тбДокРасх.НоваяКолонка("Ст4","Число",12,2);
		тбДокРасх.НоваяКолонка("Ст5","Число",12,2);
		тбДокРасх.НоваяКолонка("Ст6","Число",12,2);
	КонецЕсли;
	
	// банковские выписки за интервал	
	БВ = СоздатьОбъект("Документ.БанковскаяВыписка");
	БВ.ВыбратьДокументы(Дата1,Дата2);
	Пока БВ.ПолучитьДокумент() = 1 Цикл
		Если БВ.Фирма = Фирма Тогда
			Если (БВ.Проведен() = 0) или (БВ.ПометкаУдаления() = 1) Тогда
			    Продолжить;
			КонецЕсли;
			Если (ПоВсемРС = 0) и (БВ.РСчет <> РСчет) Тогда
			    Продолжить;
			КонецЕсли;
			
			БВ.ВыбратьСтроки();
			Пока БВ.ПолучитьСтроку() = 1 Цикл
				тбДок.НоваяСтрока();
				
				Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда
					СуммаОпер = БВ.СуммаСНДС-БВ.НДС;
				Иначе
					СуммаОпер = БВ.СуммаСНДС;
				КонецЕсли;	
				Если (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации) Тогда
				    тбДок.Ст2 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
				ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.ВозвратВыручкиОтРеализации) Тогда
				    тбДок.Ст3 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
				ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.БезоплатноПолученныеТовары) Тогда
				    тбДок.Ст5 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
				ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ПросроченнаяЗадолженность) Тогда
				    тбДок.Ст6 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
				ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ДоходНеУказанСвидет) Тогда
				    тбДок.Ст9 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
				Иначе
					тбДок.УдалитьСтроку();  
					
					Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда //расходы
						тбДокРасх.НоваяСтрока();
						Если (БВ.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности) Тогда
						    тбДокРасх.Ст3 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
						ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.НаОплатуТруда) Тогда
						    тбДокРасх.Ст4 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
						ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.ЕСВ) Тогда
						    тбДокРасх.Ст5 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
						ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.ПрочийРасход) Тогда
						    тбДокРасх.Ст6 = глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
						ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВозвратОплатыОтПоставщика) Тогда 
							//сторно
						    тбДокРасх.Ст3 = - глПересчет(СуммаОпер, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
						Иначе
							тбДокРасх.УдалитьСтроку();
							Продолжить;
						КонецЕсли;
						тбДокРасх.Док = БВ.ТекущийДокумент();
						тбДокРасх.ДатаДок = БВ.ДатаДок;
					КонецЕсли;  
					
					Продолжить;
				КонецЕсли;
				тбДок.Док = БВ.ТекущийДокумент();
				тбДок.ДатаДок = БВ.ДатаДок;

				                      
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; // банковская выписка
	БВ = 0;

	// приходные ордера за интервал	
	ПКО = СоздатьОбъект("Документ.ПриходныйКассовый");
	ПКО.ВыбратьДокументы(Дата1,Дата2);
	Пока ПКО.ПолучитьДокумент() = 1 Цикл
		Если ПКО.Фирма = Фирма Тогда
			Если (ПКО.Проведен() = 0) или (ПКО.ПометкаУдаления() = 1) Тогда
			    Продолжить;
			КонецЕсли;
			Если (ПоВсемРС = 0) и (ПКО.РСчет <> РСчет) Тогда
			    Продолжить;
			КонецЕсли;
			
			тбДок.НоваяСтрока();
			
			Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда
				СуммаОпер = ПКО.СуммаВал-ПКО.НДС;
			Иначе
				СуммаОпер = ПКО.СуммаВал;
			КонецЕсли;	
			
			Если (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации) Тогда
			    тбДок.Ст2 = глПересчет(СуммаОпер, ПКО.РСчет.Валюта, Гривня, ПКО.ДатаДок);
			ИначеЕсли (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.БезоплатноПолученныеТовары) Тогда
				тбДок.Ст5 = глПересчет(СуммаОпер, ПКО.Рсчет.Валюта, Гривня, ПКО.ДатаДок);
			ИначеЕсли (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ПросроченнаяЗадолженность) Тогда
				тбДок.Ст6 = глПересчет(СуммаОпер, ПКО.Рсчет.Валюта, Гривня, ПКО.ДатаДок);
			ИначеЕсли (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ДоходНеУказанСвидет) Тогда
				тбДок.Ст9 = глПересчет(СуммаОпер, ПКО.Рсчет.Валюта, Гривня, ПКО.ДатаДок);
			Иначе
				Если (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ВозвратОплатыОтПоставщика) и ((ГруппаЕН = 3) или (ГруппаЕН = 5)) Тогда 
					//сторно
					тбДокРасх.НоваяСтрока();
					тбДокРасх.Ст3 = - глПересчет(СуммаОпер, ПКО.Рсчет.Валюта, Гривня, ПКО.ДатаДок);
					тбДокРасх.Док = ПКО.ТекущийДокумент();
					тбДокРасх.ДатаДок = ПКО.ДатаДок;
				КонецЕсли;
				тбДок.УдалитьСтроку();
				Продолжить;
			КонецЕсли;
			тбДок.Док = ПКО.ТекущийДокумент();
			тбДок.ДатаДок = ПКО.ДатаДок;
			
		КонецЕсли;
	КонецЦикла; // ПКО
	ПКО = 0;
	
	// расходные ордера за интервал	
	РКО = СоздатьОбъект("Документ.РасходныйКассовый");
	РКО.ВыбратьДокументы(Дата1,Дата2);
	Пока РКО.ПолучитьДокумент() = 1 Цикл
		Если РКО.Фирма = Фирма Тогда
			Если (РКО.Проведен() = 0) или (РКО.ПометкаУдаления() = 1) Тогда
			    Продолжить;
			КонецЕсли;
			Если (ПоВсемРС = 0) и (РКО.РСчет <> РСчет) Тогда
			    Продолжить;
			КонецЕсли; 
			
			Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда
				СуммаОпер = РКО.СуммаВал-РКО.НДС;
			Иначе
				СуммаОпер = РКО.СуммаВал;
			КонецЕсли;	
			
			Если (РКО.ВидРасходаДенег = Перечисление.ВидыРасходаДенег.ВозвратВыручкиОтРеализации) Тогда
				тбДок.НоваяСтрока();
			    тбДок.Ст3 = глПересчет(СуммаОпер, РКО.РСчет.Валюта, Гривня, РКО.ДатаДок);
				тбДок.Док = РКО.ТекущийДокумент();
				тбДок.ДатаДок = РКО.ДатаДок;   
			Иначе
				Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда //расходы
					тбДокРасх.НоваяСтрока();
					Если (РКО.ВидРасходаДенег = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности) Тогда
						тбДокРасх.Ст3 = глПересчет(СуммаОпер, РКО.Рсчет.Валюта, Гривня, РКО.ДатаДок);
					ИначеЕсли (РКО.ВидРасходаДенег = Перечисление.ВидыРасходаДенег.НаОплатуТруда) Тогда
						тбДокРасх.Ст4 = глПересчет(СуммаОпер, РКО.Рсчет.Валюта, Гривня, РКО.ДатаДок);
					ИначеЕсли (РКО.ВидРасходаДенег = Перечисление.ВидыРасходаДенег.ЕСВ) Тогда
						тбДокРасх.Ст5 = глПересчет(СуммаОпер, РКО.Рсчет.Валюта, Гривня, РКО.ДатаДок);
					ИначеЕсли (РКО.ВидРасходаДенег = Перечисление.ВидыРасходаДенег.ПрочийРасход) Тогда
						тбДокРасх.Ст6 = глПересчет(СуммаОпер, РКО.Рсчет.Валюта, Гривня, РКО.ДатаДок);
					Иначе
						тбДок.УдалитьСтроку();
						Продолжить;
					КонецЕсли;
					тбДокРасх.Док = РКО.ТекущийДокумент();
					тбДокРасх.ДатаДок = РКО.ДатаДок;
				КонецЕсли;
			КонецЕсли;
			
			
		КонецЕсли;
	КонецЦикла; // РКО
	РКО = 0;
	
	Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда //расходы
		Если Константа.ПроводкиПоКассеТолькоОрдерами = Нет Тогда
			// расходные ордера за интервал	
			ВЗ = СоздатьОбъект("Документ.ВыплатаЗП");
			ВЗ.ВыбратьДокументы(Дата1,Дата2);
			Пока ВЗ.ПолучитьДокумент() = 1 Цикл
				Если ВЗ.Фирма = Фирма Тогда
					Если (ВЗ.Проведен() = 0) или (ВЗ.ПометкаУдаления() = 1) Тогда
						Продолжить;
					КонецЕсли;
					Если (ПоВсемРС = 0) и (ВЗ.Касса <> РСчет) Тогда
						Продолжить;
					КонецЕсли;
					
					тбДокРасх.НоваяСтрока();
					тбДокРасх.Ст4 = ВЗ.Итог("Сумма");
					
					тбДокРасх.Док = ВЗ.ТекущийДокумент();
					тбДокРасх.ДатаДок = ВЗ.ДатаДок;
				КонецЕсли;
			КонецЦикла; // ВЗ
			ВЗ = 0;
		КонецЕсли;
	КонецЕсли;
	
	ИСт2 = 0; Ист3 = 0; ИСт4 = 0;
	ИСт5 = 0; Ист6 = 0; ИСт7 = 0; ИСт9 = 0;
	// теперь выведем накопленную информацию, свернув ее по дате 
	тбДок.Свернуть("ДатаДок","Ст2,Ст3,Ст5,Ст6,Ст9");
	тбДок.Сортировать("+ДатаДок");
	тбДок.ВыбратьСтроки();                       
	Пока тбДок.ПолучитьСтроку() = 1 Цикл 
		Ст4 = тбДок.Ст2-тбДок.Ст3;
		Ст7 = Ст4+тбДок.Ст5+тбДок.Ст6;
		Таб.ВывестиСекцию("СтрокаДоход");
		ИСт2 = ИСт2 + тбДок.Ст2;
		ИСт3 = ИСт3 + тбДок.Ст3;
		ИСт4 = ИСт4 + Ст4;
		ИСт5 = ИСт5 + тбДок.Ст5;
		ИСт6 = ИСт6 + тбДок.Ст6;
		ИСт7 = ИСт7 + Ст7;
		ИСт9 = ИСт9 + тбДок.Ст9;
	КонецЦикла;
	тбДок = 0;
	
	Таб.ВывестиСекцию("Дно");
	
	Если (ГруппаЕН = 3) или (ГруппаЕН = 5) Тогда //расходы
		Таб.НоваяСтраница();
		Таб.ВывестиСекцию("ШапкаРасход"); 
		
		тбДокРасх.Свернуть("ДатаДок,Ст2","Ст3,Ст4,Ст5,Ст6");
		тбДокРасх.Сортировать("+ДатаДок");
		тбДокРасх.ВыбратьСтроки(); 
		
		Ист3 = 0; ИСт4 = 0; ИСт5 = 0; ИСт6 = 0; ИСт7 = 0;
		Пока тбДокРасх.ПолучитьСтроку() = 1 Цикл 
			Ст7 = тбДокРасх.Ст3+тбДокРасх.Ст4+тбДокРасх.Ст5+тбДокРасх.Ст6;
			Таб.ВывестиСекцию("СтрокаРасход");
			ИСт3 = ИСт3 + тбДокРасх.Ст3;
			ИСт4 = ИСт4 + тбДокРасх.Ст4;
			ИСт5 = ИСт5 + тбДокРасх.Ст5;
			ИСт6 = ИСт6 + тбДокРасх.Ст6;
			ИСт7 = ИСт7 + Ст7;
		КонецЦикла;
		тбДокРасх = 0;
		Таб.ВывестиСекцию("ИтогРасход");
	КонецЕсли;

	Таб.ТолькоПросмотр(1);
	Таб.Показать("ПЕЧАТЬ: Книга доходов и расходов","");

КонецПроцедуры

// ===============================
Процедура ИзмПоВсемРС()
	Если ПоВсемРС = 1 Тогда
		РСчет = 0;
		Форма.РСчет.Доступность(0);
	Иначе
		РСчет = Фирма.РС;
		Форма.РСчет.Доступность(1);
	КонецЕсли;
КонецПроцедуры 

// ===============================
Процедура Сформировать()
	Если Фирма.Выбран() = 0 Тогда
		глКомментарий("Не выбрана фирма",0,,"!");
		Возврат;
	КонецЕсли;
	                    
	Если глПроверкаИнтервалаОтчета(Дата1,Дата2,1) = 0 Тогда
	    Возврат;
	КонецЕсли;

	Фирма.ИспользоватьДату(Дата2);

	Если Дата1 >= '01.01.12' Тогда 
		Сформировать2012();
		Возврат;
	КонецЕсли; 
	
	ПК = Фирма.ЕДРПОУ;
	
	ПКД1 = Сред(ПК, 1, 1); 
	ПКД2 = Сред(ПК, 2, 1); 
	ПКД3 = Сред(ПК, 3, 1); 
	ПКД4 = Сред(ПК, 4, 1); 
	ПКД5 = Сред(ПК, 5, 1); 
	ПКД6 = Сред(ПК, 6, 1); 
	ПКД7 = Сред(ПК, 7, 1); 
	ПКД8 = Сред(ПК, 8, 1); 
	
	Таб = СоздатьОбъект("Таблица");
	Таб.ПовторятьПриПечатиСтроки(27,27);
	Таб.ВывестиСекцию("Шапка");
	
	Если ПоВсемРС = 1 Тогда //выбираем все счета
		Спр = СоздатьОбъект("Справочник.НашиДенежныеСчета");
		Спр.ИспользоватьВладельца(Фирма);
		Спр.ВыбратьЭлементы(); 
		Пока Спр.ПолучитьЭлемент() = 1 Цикл 
			Если Спр.ЭтоГруппа() = 0 Тогда
				Если Спр.БезНал = 1 Тогда
					РС = Спр;
					Таб.ВывестиСекцию("Счет");
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
	Иначе
		Если РСчет.Выбран() = 0 Тогда
			глКомментарий("Не выбран расчетный счет",0,,"!");
			Возврат;
		КонецЕсли;
		РС = РСчет;
		Таб.ВывестиСекцию("Счет");
	КонецЕсли;
	
	Таб.ВывестиСекцию("ШапкаТаблицы");
	
	тбДок = СоздатьОбъект("ТаблицаЗначений");
	тбДок.НоваяКолонка("ДатаДок","Дата");
	тбДок.НоваяКолонка("Док");
	тбДок.НоваяКолонка("НомерДокумента","Число",10,0);
	тбДок.НоваяКолонка("НомерДокументаСтр","Строка");
	тбДок.НоваяКолонка("Ст3","Число",12,2);
	тбДок.НоваяКолонка("Ст4","Число",12,2);
	тбДок.НоваяКолонка("Ст5","Число",12,2);
	тбДок.НоваяКолонка("Ст6","Число",12,2);
	тбДок.НоваяКолонка("Ст7","Число",12,2);
	
	ИСт3 = 0;
	ИСт4 = 0;
	ИСт5 = 0;
	ИСт6 = 0;
	ИСт7 = 0;
	
	// банковские выписки за интервал	
	БВ = СоздатьОбъект("Документ.БанковскаяВыписка");
	БВ.ВыбратьДокументы(Дата1,Дата2);
	Пока БВ.ПолучитьДокумент() = 1 Цикл
		Если БВ.Фирма = Фирма Тогда
			Если (БВ.Проведен() = 0) или (БВ.ПометкаУдаления() = 1) Тогда
			    Продолжить;
			КонецЕсли;
			Если (ПоВсемРС = 0) и (БВ.РСчет <> РСчет) Тогда
			    Продолжить;
			КонецЕсли;
			
			БВ.ВыбратьСтроки();
			Пока БВ.ПолучитьСтроку() = 1 Цикл
				тбДок.НоваяСтрока();
				
				Если БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации Тогда
				    тбДок.Ст3 = глПересчет(БВ.СуммаСНДС, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
					ИСт3 = ИСт3 + тбДок.Ст3;
				ИначеЕсли БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализацииОС Тогда
				    тбДок.Ст4 = глПересчет(БВ.СуммаСНДС, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
					ИСт4 = ИСт4 + тбДок.Ст4;
				ИначеЕсли (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтПрочейРеализации)
						 ИЛИ (БВ.ВидПриходаРасхода = Перечисление.ВидыПриходаДенег.ВыручкаОтПрочейРеализацииНеВкл) Тогда				    тбДок.Ст5 = глПересчет(БВ.СуммаСНДС, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
					ИСт5 = ИСт5 + тбДок.Ст5;
				ИначеЕсли БВ.ВидПриходаРасхода = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности Тогда
				    тбДок.Ст7 = глПересчет(БВ.СуммаСНДС, БВ.Рсчет.Валюта, Гривня, БВ.ДатаДок);
					ИСт7 = ИСт7 + тбДок.Ст7;
				Иначе
					тбДок.УдалитьСтроку();
					Продолжить;
				КонецЕсли;
				тбДок.Ст6 = тбДок.Ст3 + тбДок.Ст4 + тбДок.Ст5;
				ИСт6 = ИСт6 + тбДок.Ст6;
				                      
				тбДок.Док = БВ.ТекущийДокумент();
				тбДок.ДатаДок = БВ.ДатаДок;
				тбДок.НомерДокумента = Число(БВ.НомерДокумента);
				тбДок.НомерДокументаСтр = "ПД "+Формат(БВ.ДатаДок,"ДДММГГГГ")+", № "+БВ.НомерДокумента;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; // банковская выписка
	БВ = 0;

	// приходные ордера за интервал	
	ПКО = СоздатьОбъект("Документ.ПриходныйКассовый");
	ПКО.ВыбратьДокументы(Дата1,Дата2);
	Пока ПКО.ПолучитьДокумент() = 1 Цикл
		Если ПКО.Фирма = Фирма Тогда
			Если (ПКО.Проведен() = 0) или (ПКО.ПометкаУдаления() = 1) Тогда
			    Продолжить;
			КонецЕсли;
			Если (ПоВсемРС = 0) и (ПКО.РСчет <> РСчет) Тогда
			    Продолжить;
			КонецЕсли;
			
			тбДок.НоваяСтрока();
			
			Если ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализации Тогда
			    тбДок.Ст3 = глПересчет(ПКО.СуммаВал, ПКО.РСчет.Валюта, Гривня, ПКО.ДатаДок);
				ИСт3 = ИСт3 + тбДок.Ст3;
			ИначеЕсли ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ВыручкаОтРеализацииОС Тогда
			    тбДок.Ст4 = глПересчет(ПКО.СуммаВал, ПКО.РСчет.Валюта, Гривня, ПКО.ДатаДок);
				ИСт4 = ИСт4 + тбДок.Ст4;
			ИначеЕсли (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ВыручкаОтПрочейРеализации)
				Или (ПКО.ВидПриходаДенег = Перечисление.ВидыПриходаДенег.ВыручкаОтПрочейРеализацииНеВкл) Тогда			    тбДок.Ст5 = глПересчет(ПКО.СуммаВал, ПКО.РСчет.Валюта, Гривня, ПКО.ДатаДок);
				ИСт5 = ИСт5 + тбДок.Ст5;
			Иначе
				тбДок.УдалитьСтроку();
				Продолжить;
			КонецЕсли;
			тбДок.Ст6 = тбДок.Ст3 + тбДок.Ст4 + тбДок.Ст5;
			ИСт6 = ИСт6 + тбДок.Ст6;
			                                                    
			тбДок.Док = ПКО.ТекущийДокумент();
			тбДок.ДатаДок = ПКО.ДатаДок;
			тбДок.НомерДокумента = ПКО.НомерПО;
			тбДок.НомерДокументаСтр = "ПКО "+Формат(ПКО.ДатаДок,"ДДММГГГГ")+", № "+ПКО.НомерПО;
		КонецЕсли;
	КонецЦикла; // ПКО
	ПКО = 0;
	
	// расходные ордера за интервал	
	РКО = СоздатьОбъект("Документ.РасходныйКассовый");
	РКО.ВыбратьДокументы(Дата1,Дата2);
	Пока РКО.ПолучитьДокумент() = 1 Цикл
		Если РКО.Фирма = Фирма Тогда
			Если (РКО.Проведен() = 0) или (РКО.ПометкаУдаления() = 1) Тогда
			    Продолжить;
			КонецЕсли;
			Если (ПоВсемРС = 0) и (РКО.РСчет <> РСчет) Тогда
			    Продолжить;
			КонецЕсли;
			
			Если РКО.ВидРасходаДенег = Перечисление.ВидыРасходаДенег.НаВедениеХозДеятельности Тогда
				тбДок.НоваяСтрока();
			    тбДок.Ст7 = глПересчет(РКО.СуммаВал, РКО.РСчет.Валюта, Гривня, РКО.ДатаДок);
				ИСт7 = ИСт7 + тбДок.Ст7;
			Иначе
				Продолжить;
			КонецЕсли;
			                        
			тбДок.Док = РКО.ТекущийДокумент();
			тбДок.ДатаДок = РКО.ДатаДок;
			тбДок.НомерДокумента = РКО.НомерРО;
			тбДок.НомерДокументаСтр = "РКО "+Формат(РКО.ДатаДок,"ДДММГГГГ")+", № "+РКО.НомерРО;
		КонецЕсли;
	КонецЦикла; // РКО
	РКО = 0;

	Если Константа.ПроводкиПоКассеТолькоОрдерами = Нет Тогда
		// расходные ордера за интервал	
		ВЗ = СоздатьОбъект("Документ.ВыплатаЗП");
		ВЗ.ВыбратьДокументы(Дата1,Дата2);
		Пока ВЗ.ПолучитьДокумент() = 1 Цикл
			Если ВЗ.Фирма = Фирма Тогда
				Если (ВЗ.Проведен() = 0) или (ВЗ.ПометкаУдаления() = 1) Тогда
					Продолжить;
				КонецЕсли;
				Если (ПоВсемРС = 0) и (ВЗ.Касса <> РСчет) Тогда
					Продолжить;
				КонецЕсли;
				
				тбДок.НоваяСтрока();
				тбДок.Ст7 = ВЗ.Итог("Сумма");
				ИСт7 = ИСт7 + тбДок.Ст7;
				
				тбДок.Док = ВЗ.ТекущийДокумент();
				тбДок.ДатаДок = ВЗ.ДатаДок;
				Номер = глНомерБезПрефикса(ВЗ.НомерДок);
				тбДок.НомерДокумента = Номер;
				тбДок.НомерДокументаСтр = "ВЗ "+Формат(ВЗ.ДатаДок,"ДДММГГГГ")+", № "+Номер;
			КонецЕсли;
		КонецЦикла; // ВЗ
		ВЗ = 0;
	КонецЕсли;
	
	// теперь выведем накопленную информацию, отсортировав ее по дате и номеру документа
	Ном = ПервыйНом;
	
	тбДок.Сортировать("+ДатаДок,НомерДокумента");
	тбДок.ВыбратьСтроки();                       
	Пока тбДок.ПолучитьСтроку() = 1 Цикл
		Таб.ВывестиСекцию("Строка");
		Ном = Ном+1;
	КонецЦикла;
	тбДок = 0;
	
	Таб.ВывестиСекцию("Дно");
	Таб.Опции(0,0,,,"ПарамПечатиУпрКнигаДоходовРасходов","РазмОкнаУпрКнигаДоходовРасходов");
	Таб.ТолькоПросмотр(1);
	Таб.Показать("ПЕЧАТЬ: Книга доходов и расходов ("+ПериодСтр(Дата1,Дата2)+", "+Фирма+")", "");
	
	глСохранитьЗначение("КнигаДоходовРасходов","ПервыйНом",Ном);
КонецПроцедуры

// ======================================
Процедура ИзмДата()
	Если Дата1 >= '01.01.12' Тогда
		Форма.ПервыйНом.Видимость(0);
		Форма.тПерНом.Видимость(0); 
	Иначе	
		Форма.ПервыйНом.Видимость(1);
		Форма.тПерНом.Видимость(1); 
	КонецЕсли; 
	Если (Дата1 < '01.01.12') и (Дата2 >= '01.01.12') Тогда
		 //не верно задан период. с 01.01.12 используется новая форма, старая не действует
		 Дата2 = '31.12.11';
	КонецЕсли;
	Если (Дата1 >= '01.01.12') и (Дата2 < '01.01.12') Тогда
		 //не верно задан период. с 01.01.12 используется новая форма, старая не действует
		Дата2 = РабочаяДата();
	КонецЕсли;
КонецПроцедуры 

// ===============================
// ПРЕДОПРЕДЕЛЕННЫЕ ПРОЦЕДУРЫ
// ===============================

// ===============================
Процедура ПриОткрытии()
	Форма.кПравоваяПоддержка.Видимость(глВидимостьПравовойПоддержки);
	Фирма = глВосстановитьЗначение(,"БазФирма");
	Если Метаданные.РазделительУчета.Выбран() = 0 Тогда
		Форма.Фирма.Видимость(0);
		Форма.тФирма.Видимость(0);
	КонецЕсли;
	РСчет.ВыборГруппы(0);
	РСчет = Фирма.РС;
	ПоВсемРС = 0;
	
	Дата1 = РабочаяДата();
	Дата2 = РабочаяДата();
	ПервыйНом = Макс(Число(глВосстановитьЗначение("КнигаДоходовРасходов","ПервыйНом")),1);
	ИзмДата();
КонецПроцедуры

